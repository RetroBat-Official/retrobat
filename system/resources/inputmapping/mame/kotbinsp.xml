        <mapping type="standard" name="JOY_up OR JOY_lsup" />
      </button>
      <button type="P1_JOYSTICK_DOWN" tag=":KEYB0" mask="4" defvalue="4" x="30" y="60" color="Blue" function="P1_JOYSTICK_DOWN">
