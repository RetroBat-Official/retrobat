      <button type="P1_JOYSTICK_LEFT" tag=":KEYB0" mask="8" defvalue="8" x="30" y="60" color="Blue" function="P1_JOYSTICK_LEFT">
        <mapping type="standard" name="JOY_left OR JOY_lsleft" />
      </button>
      <button type="P1_JOYSTICK_RIGHT" tag=":KEYB0" mask="16" defvalue="16" x="30" y="60" color="Blue" function="P1_JOYSTICK_RIGHT">
        <mapping type="standard" name="JOY_right OR JOY_lsright" />
