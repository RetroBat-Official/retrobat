      </button>
      <button type="P1_HANAFUDA_YES" tag=":KEYB1" mask="8" defvalue="8" x="30" y="60" color="Blue" function="P1_HANAFUDA_YES">
        <mapping type="standard" name="JOY_south" />
      </button>
      <button type="P1_HANAFUDA_NO" tag=":KEYB1" mask="16" defvalue="16" x="30" y="60" color="Blue" function="P1_HANAFUDA_NO">
