<?xml version="1.0" encoding="utf-8"?>
<game name="winrun91" rom="winrun91">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_PEDAL" tag=":AN1" mask="255" defvalue="128" x="30" y="60" color="Blue" function="P1_PEDAL">
        <mapping type="standard" name="JOY_r2" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_PADDLE" tag=":AN2" mask="255" defvalue="128" x="30" y="60" color="Blue" function="P1_PADDLE">
        <mapping type="standard" name="JOY_leftstickx" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_PEDAL2" tag=":AN3" mask="255" defvalue="128" x="30" y="60" color="Blue" function="P1_PEDAL2">
        <mapping type="standard" name="JOY_l2" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_JOYSTICK_DOWN" tag=":MCUH" mask="8" defvalue="8" x="30" y="60" color="Blue" function="P1_JOYSTICK_DOWN">
        <mapping type="standard" name="JOY_l1 OR JOY_east" />
      </button>
      <button type="P1_JOYSTICK_UP" tag=":MCUH" mask="32" defvalue="32" x="30" y="60" color="Blue" function="P1_JOYSTICK_UP">
        <mapping type="standard" name="JOY_west OR JOY_r1" />
      </button>
    </layout>
  </layouts>
</game>
