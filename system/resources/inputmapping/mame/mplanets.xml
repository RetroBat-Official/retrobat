<?xml version="1.0" encoding="utf-8"?>
<game name="mplanets" rom="mplanets">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_JOYSTICK_UP" tag=":IN4" mask="1" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_UP">
        <mapping type="standard" name="JOY_up OR JOY_lsup" />
      </button>
      <button type="P1_JOYSTICK_RIGHT" tag=":IN4" mask="2" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_RIGHT">
        <mapping type="standard" name="JOY_right OR JOY_lsright" />
      </button>
      <button type="P1_JOYSTICK_DOWN" tag=":IN4" mask="4" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_DOWN">
        <mapping type="standard" name="JOY_down OR JOY_lsdown" />
      </button>
      <button type="P1_JOYSTICK_LEFT" tag=":IN4" mask="8" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_LEFT">
        <mapping type="standard" name="JOY_left OR JOY_lsleft" />
      </button>
      <button type="P1_BUTTON1" tag=":IN4" mask="16" defvalue="0" x="30" y="60" color="Blue" function="P1_BUTTON1">
        <mapping type="standard" name="JOY_west OR JOY_r1" />
      </button>
      <button type="P1_BUTTON2" tag=":IN4" mask="128" defvalue="0" x="30" y="60" color="Blue" function="P1_BUTTON2">
        <mapping type="standard" name="JOY_south OR JOY_l1" />
      </button>
      <button type="P1_DIAL" tag=":TRACKY" mask="255" defvalue="0" x="30" y="60" color="Blue" function="P1_DIAL">
        <mapping type="standard" name="JOY_rightstickx" />
        <mapping type="increment" name="JOY_r2trigger" />
        <mapping type="decrement" name="JOY_l2trigger" />
      </button>
    </layout>
  </layouts>
</game>
