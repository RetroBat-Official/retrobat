<?xml version="1.0" encoding="utf-8"?>
<game name="sidebs2j" rom="sidebs2j">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_PADDLE" tag=":AN.0" mask="255" defvalue="128" x="30" y="60" color="Blue" function="P1_PADDLE">
        <mapping type="standard" name="JOY_leftstickx" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_PEDAL" tag=":AN.1" mask="255" defvalue="0" x="30" y="60" color="Blue" function="P1_PEDAL">
        <mapping type="standard" name="JOY_r2" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_PEDAL2" tag=":AN.2" mask="255" defvalue="0" x="30" y="60" color="Blue" function="P1_PEDAL2">
        <mapping type="standard" name="JOY_l2" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_JOYSTICK_DOWN" tag=":BUTTONS" mask="1" defvalue="1" x="30" y="60" color="Blue" function="P1_JOYSTICK_DOWN">
        <mapping type="standard" name="JOY_r1 OR JOY_west" />
      </button>
      <button type="P1_JOYSTICK_UP" tag=":BUTTONS" mask="2" defvalue="2" x="30" y="60" color="Blue" function="P1_JOYSTICK_UP">
        <mapping type="standard" name="JOY_l1 OR JOY_south" />
      </button>
      <button type="P1_BUTTON3" tag=":UNUSED" mask="1" defvalue="1" x="30" y="60" color="Blue" function="P1_BUTTON3">
        <mapping type="standard" name="JOY_north" />
      </button>
    </layout>
  </layouts>
</game>
