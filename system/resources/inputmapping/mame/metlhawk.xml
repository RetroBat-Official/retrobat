        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_AD_STICK_X" tag=":AN6" mask="255" defvalue="128" x="30" y="60" color="Blue" function="P1_AD_STICK_X">
        <mapping type="standard" name="JOY_leftstickx" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_AD_STICK_Z" tag=":AN7" mask="255" defvalue="128" x="30" y="60" color="Blue" function="P1_AD_STICK_Z">
        <mapping type="standard" name="JOY_rightsticky_reverse" />
