<?xml version="1.0" encoding="utf-8"?>
<game name="swa" rom="swa">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_BUTTON1" tag=":IN.1" mask="1" defvalue="1" x="30" y="60" color="Blue" function="P1_BUTTON1">
        <mapping type="standard" name="JOY_r2trigger OR JOY_west" />
      </button>
      <button type="P1_BUTTON2" tag=":IN.1" mask="2" defvalue="2" x="30" y="60" color="Blue" function="P1_BUTTON2">
        <mapping type="standard" name="JOY_l2trigger OR JOY_south" />
      </button>
      <button type="P2_BUTTON1" tag=":IN.1" mask="4" defvalue="4" x="30" y="60" color="Blue" function="P2_BUTTON1">
        <mapping type="standard" name="JOY_west OR MOUSE_BUTTON1" />
      </button>
      <button type="P2_BUTTON2" tag=":IN.1" mask="8" defvalue="8" x="30" y="60" color="Blue" function="P2_BUTTON2">
        <mapping type="standard" name="JOY_south OR MOUSE_BUTTON2" />
      </button>
      <button type="P1_BUTTON3" tag=":IN.1" mask="16" defvalue="16" x="30" y="60" color="Blue" function="P1_BUTTON3">
        <mapping type="standard" name="JOY_north" />
      </button>
      <button type="P1_AD_STICK_X" tag=":STICK1X" mask="255" defvalue="127" x="30" y="60" color="Blue" function="P1_AD_STICK_X">
        <mapping type="standard" name="JOY_leftstickx" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_AD_STICK_Y" tag=":STICK1Y" mask="255" defvalue="127" x="30" y="60" color="Blue" function="P1_AD_STICK_Y">
        <mapping type="standard" name="JOY_leftsticky_reverse" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P2_AD_STICK_X" tag=":STICK2X" mask="255" defvalue="127" x="30" y="60" color="Blue" function="P2_AD_STICK_X">
        <mapping type="standard" name="JOY_leftstickx OR MOUSE_XAXIS" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P2_AD_STICK_Y" tag=":STICK2Y" mask="255" defvalue="127" x="30" y="60" color="Blue" function="P2_AD_STICK_Y">
        <mapping type="standard" name="JOY_leftsticky_reverse OR MOUSE_YAXIS_reverse" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_PEDAL" tag=":THROTTLE" mask="255" defvalue="127" x="30" y="60" color="Blue" function="P1_PEDAL">
        <mapping type="standard" name="JOY_rightsticky_reverse" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
    </layout>
  </layouts>
</game>
