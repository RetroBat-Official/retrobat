<?xml version="1.0" encoding="utf-8"?>
<game name="snakepit" rom="snakepit">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_TRACKBALL_Y" tag=":AN2" mask="255" defvalue="0" x="30" y="60" color="Blue" function="P1_TRACKBALL_Y">
        <mapping type="standard" name="JOY_leftsticky" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_TRACKBALL_X" tag=":AN3" mask="255" defvalue="0" x="30" y="60" color="Blue" function="P1_TRACKBALL_X">
        <mapping type="standard" name="JOY_leftstickx" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_JOYSTICKLEFT_UP" tag=":IN0" mask="1" defvalue="1" x="30" y="60" color="Blue" function="P1_JOYSTICKLEFT_UP">
        <mapping type="standard" name="JOY_rsup" />
      </button>
      <button type="P1_JOYSTICKLEFT_DOWN" tag=":IN0" mask="2" defvalue="2" x="30" y="60" color="Blue" function="P1_JOYSTICKLEFT_DOWN">
        <mapping type="standard" name="JOY_rsdown" />
      </button>
      <button type="P1_JOYSTICKLEFT_RIGHT" tag=":IN0" mask="4" defvalue="4" x="30" y="60" color="Blue" function="P1_JOYSTICKLEFT_RIGHT">
        <mapping type="standard" name="JOY_rsright" />
      </button>
      <button type="P1_JOYSTICKLEFT_LEFT" tag=":IN0" mask="8" defvalue="8" x="30" y="60" color="Blue" function="P1_JOYSTICKLEFT_LEFT">
        <mapping type="standard" name="JOY_rsleft" />
      </button>
      <button type="P1_BUTTON1" tag=":IN1" mask="4" defvalue="4" x="30" y="60" color="Blue" function="P1_BUTTON1">
        <mapping type="standard" name="JOY_r1 OR JOY_south" />
      </button>
    </layout>
  </layouts>
</game>
