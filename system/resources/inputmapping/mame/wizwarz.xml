      </button>
      <button type="P1_JOYSTICK_RIGHT" tag=":IN4" mask="4" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_RIGHT">
        <mapping type="standard" name="JOY_rsright" />
      </button>
      <button type="P1_JOYSTICK_DOWN" tag=":IN4" mask="8" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_DOWN">
        <mapping type="standard" name="JOY_rsdown" />
      </button>
      <button type="P1_BUTTON1" tag=":IN4" mask="32" defvalue="0" x="30" y="60" color="Blue" function="P1_BUTTON1">
