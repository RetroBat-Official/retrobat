<?xml version="1.0" encoding="utf-8"?>
<game name="speedrcr" rom="speedrcr">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_PEDAL" tag=":ACCEL" mask="255" defvalue="0" x="30" y="60" color="Blue" function="P1_PEDAL">
        <mapping type="standard" name="JOY_r2" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_BUTTON7" tag=":IN2" mask="16" defvalue="16" x="30" y="60" color="Blue" function="P1_BUTTON7">
        <mapping type="standard" name="JOY_east" />
      </button>
      <button type="P1_BUTTON5" tag=":IN2" mask="32" defvalue="32" x="30" y="60" color="Blue" function="P1_BUTTON5">
        <mapping type="standard" name="JOY_west" />
      </button>
      <button type="P1_BUTTON6" tag=":IN2" mask="64" defvalue="64" x="30" y="60" color="Blue" function="P1_BUTTON6">
        <mapping type="standard" name="JOY_north" />
      </button>
      <button type="P1_BUTTON3" tag=":IN2" mask="128" defvalue="128" x="30" y="60" color="Blue" function="P1_BUTTON3">
        <mapping type="standard" name="JOY_south OR JOY_start" />
      </button>
      <button type="P1_PADDLE" tag=":WHEEL" mask="255" defvalue="128" x="30" y="60" color="Blue" function="P1_PADDLE">
        <mapping type="standard" name="JOY_leftstickx" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
    </layout>
  </layouts>
</game>
