<?xml version="1.0" encoding="utf-8"?>
<game name="upscope" rom="upscope">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_BUTTON1" tag=":IO0" mask="2" defvalue="2" x="30" y="60" color="Blue" function="P1_BUTTON1">
        <mapping type="standard" name="JOY_south" />
      </button>
      <button type="P1_JOYSTICK_DOWN" tag=":IO0" mask="16" defvalue="16" x="30" y="60" color="Blue" function="P1_JOYSTICK_DOWN">
        <mapping type="standard" name="JOY_down OR JOY_lsdown" />
      </button>
      <button type="P1_JOYSTICK_UP" tag=":IO0" mask="32" defvalue="32" x="30" y="60" color="Blue" function="P1_JOYSTICK_UP">
        <mapping type="standard" name="JOY_up OR JOY_lsup" />
      </button>
      <button type="P1_PADDLE" tag=":POT1DAT" mask="255" defvalue="128" x="30" y="60" color="Blue" function="P1_PADDLE">
        <mapping type="standard" name="JOY_leftstickx" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
    </layout>
  </layouts>
</game>
