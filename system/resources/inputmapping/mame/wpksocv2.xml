<?xml version="1.0" encoding="utf-8"?>
<game name="wpksocv2" rom="wpksocv2">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_PEDAL" tag=":INPUTS" mask="15" defvalue="0" x="30" y="60" color="Blue" function="P1_PEDAL">
        <mapping type="standard" name="JOY_r2" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_JOYSTICK_UP" tag=":INPUTS" mask="256" defvalue="256" x="30" y="60" color="Blue" function="P1_JOYSTICK_UP">
        <mapping type="standard" name="JOY_up OR JOY_lsup" />
      </button>
      <button type="P1_JOYSTICK_DOWN" tag=":INPUTS" mask="512" defvalue="512" x="30" y="60" color="Blue" function="P1_JOYSTICK_DOWN">
        <mapping type="standard" name="JOY_down OR JOY_lsdown" />
      </button>
      <button type="P1_JOYSTICK_LEFT" tag=":INPUTS" mask="1024" defvalue="1024" x="30" y="60" color="Blue" function="P1_JOYSTICK_LEFT">
        <mapping type="standard" name="JOY_left OR JOY_lsleft" />
      </button>
      <button type="P1_JOYSTICK_RIGHT" tag=":INPUTS" mask="2048" defvalue="2048" x="30" y="60" color="Blue" function="P1_JOYSTICK_RIGHT">
        <mapping type="standard" name="JOY_right OR JOY_lsright" />
      </button>
    </layout>
  </layouts>
</game>
