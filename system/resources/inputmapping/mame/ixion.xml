<?xml version="1.0" encoding="utf-8"?>
<game name="ixion" rom="ixion">
  <layouts>
    <layout type="default" joystickcolor="Black">
      <button type="P1_DIAL" tag=":DIAL.0" mask="255" defvalue="0" x="30" y="60" color="Blue" function="P1_DIAL">
        <mapping type="standard" name="JOY_rightstickx" />
        <mapping type="increment" name="NONE" />
        <mapping type="decrement" name="NONE" />
      </button>
      <button type="P1_JOYSTICK_RIGHT" tag=":SW01" mask="1" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_RIGHT">
        <mapping type="standard" name="JOY_right OR JOY_lsright" />
      </button>
      <button type="P1_JOYSTICK_LEFT" tag=":SW01" mask="2" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_LEFT">
        <mapping type="standard" name="JOY_left OR JOY_lsleft" />
      </button>
      <button type="P1_JOYSTICK_UP" tag=":SW01" mask="4" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_UP">
        <mapping type="standard" name="JOY_up OR JOY_lsup" />
      </button>
      <button type="P1_JOYSTICK_DOWN" tag=":SW01" mask="8" defvalue="0" x="30" y="60" color="Blue" function="P1_JOYSTICK_DOWN">
        <mapping type="standard" name="JOY_down OR JOY_lsdown" />
      </button>
      <button type="P1_BUTTON1" tag=":SW01" mask="16" defvalue="0" x="30" y="60" color="Blue" function="P1_BUTTON1">
        <mapping type="standard" name="JOY_south OR JOY_r2trigger" />
      </button>
    </layout>
  </layouts>
</game>
