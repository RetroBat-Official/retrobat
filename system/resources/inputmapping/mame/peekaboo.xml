      </button>
      <button type="P1_BUTTON4" tag=":SYSTEM" mask="8192" defvalue="8192" x="30" y="60" color="Blue" function="P1_BUTTON4">
        <mapping type="standard" name="JOY_north" />
      </button>
    </layout>
  </layouts>
</game>
