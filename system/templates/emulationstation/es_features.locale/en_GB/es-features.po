msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Choose the colour palette."

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Choose which colour palette is going to be used."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Colour palette for original Game Boy games."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Colour temperature of the arcade monitor."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Colours of WonderSwan (mono) games. WS palettes mimic the original screens."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Copy the colour buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Define the button combo to hold to toggle dualshock controller between analogue and digital mode."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Define the colour palette, Old NTSC reproduces the old ugly japanese TV colours."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Define the connected device that emulates an Analogue Directional Stick."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Define the type of monitor, will change colours."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Define which analogue stick controls the mouse pointer."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Device plugged into the Apple II game port. The analogue stick gives progressive paddle movement, the d-pad only goes fully left or right."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Disable dithering and use the full 8 bits per channel colour information."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Disable the analogue plunger (right stick) and the analogue nudge (left stick)."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Disable this option to centre the IR pointer when the stick is released."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Disabling this feature will reduce colour depth."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emulate the behaviour of older engines, required by some older mods and demos."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Emulates PS3 multisampling layout. Can fix some visual artefacts in some games."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Enable if the wheel is pushed away from centre instead of toward it."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Enable this if the controller does not have analogue triggers."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Enabled by default. Disables dithering and forces 24-bit colour output."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Fixes shadow and depth artefacts in some games."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Force GBC software that alters behaviour when run on GBA."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Force how textures are sampled. Nearest neighbour keeps pixels sharp, linear smooths them."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the centre when released."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "If Off, disables the dithering pattern the PSX applies to combat colour banding."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Ignore analogue stick movement below this threshold."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Improves colour depth."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initialises colour render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initialises depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Invert the gamepad right analogue stick's vertical axis."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Leave this ON by default to enable CPU JIT Optimisations."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Maps the triggers to the analogue stick vertical axis. Useful for Gran Turismo and other racing games."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Matches colours to how they look on real hardware."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "May cause artefacts in some games."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "More accurate behaviour but may cause lower performance. ON by default."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Mouse: games such as Elansar or Defender of the Crown. Analogue stick: BattleSphere, also select it in the game options."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Move the mouse with an analogue stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Move with the left analogue stick as well as the D-pad. On by default."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colours, side by side is for VR headsets and 3D displays."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Overclock or underclock the emulated main CPU. Can help stabilise the framerate, but breaks some games."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Prevents some artefacts but can result in hard edges."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronisation, so it has a huge performance impact."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Reduce analogue controls speed, some games require low values to be playable."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Render gouraud shading at full precision to reduce colour banding in 3D games."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Renders in 24-bit colours and removes dithering."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Scales X coordinates relative to the centre of the screen. Lower this if shots land too far from the crosshair on the edges."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Select which colour filter to apply."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Set licence mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behaviour)."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Sets the deadzone of the Gamepad analogue sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Sets the deadzone of the Gamepad analogue sticks."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Sets the deadzone of the Gamepad analogue triggers."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Sets the deadzone of the analogue sticks. Only used with the 'Gamepad Modern' controller type."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Sets the sensitivity of the analogue sticks."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Simulate effects specific to the PowerVR2 GPU and analogue video signals."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simulate the colours of the Game Boy Color LCD screen."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Skip the long steering motor initialisation at boot. Select the revision of your game."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Skip the steering motor initialisation at boot."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Speed of the analogue-stick mouse."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Spring the wheel back to centre while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Steering axis deadzone, for pads or non self-centring wheels."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Supersample framebuffer effects, can introduce artefacts."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Switch this on to use dpad instead of left analogue stick."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "The game region must match the Wii Menu region, otherwise the game will not be recognised."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "The right analogue stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Threshold at which analogue stick movement counts as a digital direction."

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analogue stick by default."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Use Analogue stick as D-PAD."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Use Left analogue stick instead of D-PAD for controls."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Use a predefined colour palette instead of the one computed by the emulator."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Use analogue stick instead of dpad."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Use buttons instead of an analogue axis for the wheel."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Use left analogue stick in addition to dpad."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Use left analogue stick instead of D-PAD."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Use this only if the analogue stick is drifting."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Use this option when using a pad recognised as keyboard (ipac, etc.)."
