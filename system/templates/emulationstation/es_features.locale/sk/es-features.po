# FEATURES - DESCRIPTIONS
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' je skutočná rýchlosť mechaniky. 'Turbo' načíta takmer okamžite, ale niekoľko hier to zistí a odmietne sa spustiť."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' je skutočná rýchlosť mechaniky. 'Turbo' odstráni emuláciu otáčania disku a načíta takmer okamžite, ale niekoľko hier to zistí a odmietne sa spustiť."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "'Accurate' zodpovedá hardvéru, ale na obrazovkách ukladania/načítania môže výrazne znížiť snímkovú frekvenciu. Zmeňte iba vtedy, ak je menu pomalé."

msgctxt "game_options"
msgid "'Auto' defaults to the most compatible version for the model."
msgstr "'Auto' predvolene vyberie najkompatibilnejšiu verziu pre daný model."

msgctxt "game_options"
msgid "'Auto' is the default floppy speed (300RPM). 'Turbo' removes disk rotation emulation."
msgstr "'Auto' je predvolená rýchlosť diskety (300RPM). 'Turbo' odstráni emuláciu otáčania disku."

msgctxt "game_options"
msgid "'Auto' will controls the half-screen fix detection on texture shuffling."
msgstr "'Auto' riadi detekciu opravy polovice obrazovky pri premiešavaní textúr."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "'Compatible' vyhovuje takmer každej hre. 'Cycle exact' je najpresnejší, ale vyžaduje rýchle PC. 'Fast' odomkne rýchlosť CPU a môže pokaziť hry citlivé na časovanie."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "'Double' poskytuje čistý moderný obraz. Režimy so scanlines napodobňujú vzhľad CRT monitora."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "'Dual Stick' priradí joystick hráča 2 na pravú analógovú páčku hráča 1, 'Swap Ports' opraví prehodenie portov pre 'Wizard of Wor'."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "'Exact' je najvernejšia emulácia Paula. Znížte iba vtedy, ak zvuk na pomalom PC seká."

msgctxt "game_options"
msgid "'Games Express' is needed for several unlicensed games."
msgstr "'Games Express' je potrebný pre niekoľko nelicencovaných hier."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "'Joystick' je klasická 2-tlačidlová páka, ktorej rozumie každá hra. 'CD32 pad' pridáva farebné tlačidlá a na CD32 sa vyberie automaticky."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "'ZAPNUTÉ' odovzdá jadru všetky udalosti fyzickej klávesnice. 'VYPNUTÉ' zabráni tlačidlám RetroPad generovať udalosti klávesnice."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "'PREDDEFINOVANÉ SÚBORY' použije konfiguračné súbory z priečinka 'cfg' emulátora, 'DYNAMICKÉ' vygeneruje konfiguráciu podľa profilu vybraného v pokročilých nastaveniach 'OVLÁDANIE'."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "'Safe' opraví chyby textúr v niektorých hrách za cenu veľkej straty výkonu."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "Možnosť 'Templates' skopíruje súbory z priečinka 'emulators\m2emulator\templatescfg' namiesto dynamickej automatickej konfigurácie."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "'Triple-buffer' a 'match emulated content' sú dostupné iba s video ovládačom Vulkan."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "'Turbo' odstráni emuláciu oneskorenia vyhľadávania."

msgctxt "game_options"
msgid "'Weave' should only be used with 1x scaling factor and CRT shaders."
msgstr "'Weave' by sa mal používať iba so škálovacím faktorom 1x a CRT shadermi."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "'XINPUT' vynúti použitie API XInput pre kompatibilné ovládače."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "'directx11' je predvolený a funguje takmer na všetkom hardvéri. 'vulkan' môže byť rýchlejší na novších GPU. Niektoré jadrá libretro vynútia vlastný ovládač."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8MB Fast RAM (CD32FR). Predvolene vypnuté, ako na pôvodnej CD32."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "0 je najnižšia kvalita, oneskorenie a záťaž CPU, 10 je najvyššia kvalita, oneskorenie a záťaž CPU."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "S modernými ovládačmi sa odporúča 130-140%."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 bitov odstráni farebné pásikovanie v tmavých oblastiach a prechodoch. HDR vyžaduje HDR displej s HDR povoleným v RetroArch, inak sa jadro vráti na 24 bitov."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x zodpovedá skutočnej mechanike. Vyššie rýchlosti skrátia načítanie, ale môžu pokaziť hry."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "Nainštalovaná rozširujúca karta RAM 32k."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "Predvolene 4/3, ako arkádový monitor. Rámček sa zobrazuje iba v 4/3. 16/9 rozšíri 3D pohľad."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Niekoľko hier potrebuje túto možnosť vypnutú."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Vyžaduje niekoľko hier. Stojí približne 10% výkonu."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Niekoľko veľmi skorých hier potrebuje na správne zobrazenie čip CTIA."

msgctxt "game_options"
msgid "A shadows and colors fix needed for some games such as Tony Hawk Proving Ground."
msgstr "Oprava tieňov a farieb potrebná pre niektoré hry, napríklad Tony Hawk Proving Ground."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII priradí klávesnicu podľa znakov, ktoré tlačí. Original reprodukuje presnú klávesnicu emulovaného stroja, potrebné pre niekoľko programov."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "AUTO (odporúčané) nechá jadro určiť súbor NAND podľa regiónu hry."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO zobrazí zameriavač pri mierení myšou a skryje ho so skutočnou svetelnou pištoľou."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO prepne na DSi iba pre exkluzívne hry DSi. Pre DSiWare vynúťte DSI."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "AUTOMATICKY vyberie rozšírenie podľa veľkosti programu. Dá sa vynútiť značkami v názve súboru, napríklad (8k) alebo [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMATICKY: Vita3K sám načíta potrebné moduly firmvéru (odporúčané). NASTAVENIA EMULÁTORA: ponechať moduly vybrané v rozhraní Vita3K."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Nad 60 fps sa snímky interpolujú medzi aktualizáciami hry. AUTO sa riadi obnovovacou frekvenciou displeja."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Presná emulácia framebuffera, veľmi pomalá, ale niektoré hry ju vyžadujú."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Byť hráčom 1 a hostovať hru."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Akcia druhého tlačidla ovládača: medzerník (napr. Xenon 2) alebo joystick hore (skok v plošinovkách)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Aktivovať pomoc pri mierení."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Aktivovať automatické ukladanie a nastaviť interval medzi uloženiami."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "Aktivujte pri použití WiiZapper na prehodenie spúšte a tlačidla nabíjania."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Prispôsobiť herný pohľad širokouhlým obrazovkám."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Pridať prázdny disk 2HD na uloženia/používateľa do zoznamu ovládania diskov."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Pridá kontaktné tiene, vyžaduje hardvérový renderer."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Prispôsobiť rýchlosť ukazovateľa myši podľa citlivosti analógovej páčky."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "Upraví výstupné farby tak, aby napodobňovali obrazovku pôvodnej konzoly."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Nastaviť vertikálny stred ukazovateľa Wiimote."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Upraví hlasitosť hudobnej stopy."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Upraví hlasitosť zvukových efektov."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Pokročilá zvuková knižnica, ktorú používa mnoho hier. Zakážte iba vtedy, ak hra padá alebo má problémy so zvukom."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Mierenie gyroskopom ovládača (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Umožní ADAM zapisovať na disky a dátové balíky. Zápisy idú do pracovnej kópie v priečinku saves, pôvodný súbor sa nikdy nezmení. Vyžaduje reštart jadra."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Povoliť ovládače DirectInput (bežné USB gamepady, arkádové páky). Vypnite iba vtedy, ak sa ovládač zistí dvakrát."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Povoliť ovládače XInput (gamepady Xbox a wrappery). Vypnite iba vtedy, ak sa ovládač zistí dvakrát."

msgctxt "game_options"
msgid "Allow bilinear scaling on scanout."
msgstr "Povoliť bilineárne škálovanie na výstupe."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Umožní správnu emuláciu opakovania textúr, ale za cenu výkonu."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Umožní hrám podporujúcim rôzne rozlíšenia vykresľovať v konkrétnom rozlíšení."

msgctxt "game_options"
msgid "Allow gamma dither."
msgstr "Povoliť dithering gammy."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Povoliť natívnu podporu HID pre DualShock 4, DualSense a Switch Pro. Vypnite na návrat k DirectInput."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Umožní súčasne stlačiť vľavo a vpravo alebo hore a dole. V niektorých hrách môže spôsobiť chyby pohybu."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Umožní súčasne stlačiť protichodné smery."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Umožní niektorým hrám s 30fps bežať na 60fps."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Povolí konštanty načítania textúr a vrcholov s neplatným typom, dá sa použiť na obídenie chýb načítania v niektorých hrách."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Umožní premenlivú obnovovaciu frekvenciu na displejoch, ktoré ju podporujú. Na displejoch bez VRR môže v niektorých prípadoch dochádzať k trhaniu obrazu."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Umožní približovať a odďaľovať mapu kolieskom myši, ako v Enhanced Editions."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Umožní vytvoriť vlastné priradenie pre arkádovú páku podľa súboru 'arcade_sticks.json'."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Umožní používať vstupy myši, aj keď typ zariadenia nie je nastavený na 'RetroKeyboard/Mouse'."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Vložiť aj ďalšiu disketu do mechaniky 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Vždy dekomprimovať archívy, aj keby ich dokan mohol pripojiť ako písmeno jednotky."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Vždy zobrazovať názvy predmetov na zemi."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Model Amiga na emuláciu. Každý potrebuje vlastnú Kickstart ROM v priečinku bios."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Model Amiga na emuláciu. Prejaví sa po reštarte jadra. Každý model potrebuje zodpovedajúcu Kickstart ROM v priečinku bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Port Amigy, do ktorého je zapojená pištoľ. Port 2 je správny takmer pre každý stroj; iba A1000 číta pero na porte 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Množstvo Chip RAM. Niektoré neskoršie hry potrebujú 1 MB. Prekročenie toho, čo model podporuje, môže pokaziť kompatibilitu."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "Množstvo použitej RAM."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Veľkosť malých pohybov ukazovateľa, ktoré sa majú ignorovať."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Pridané vibrácie, ktoré sa zosilňujú pri zatáčaní."

msgctxt "game_options"
msgid "Anti-aliased fetch filter, smooth polygons edges."
msgstr "Vyhladzujúci filter načítania, vyhladí hrany polygónov."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Úroveň vyhladzovania hrán."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Metóda a úroveň vyhladzovania hrán."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Model Apple II na emuláciu. Zmena reštartuje stroj."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Model Apple II na emuláciu. Modely PAL bežia na 50Hz a sú to tie, pre ktoré boli písané európske dema. Zmena reštartuje stroj."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Použije sa na obrázok zameriavača, užitočné na rozlíšenie hráčov."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Použije mocninovú krivku na hodnoty riadenia, utlmí malé pohyby."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Platí pre osi leteckého joysticku a plynu v After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Platí pre pedále plynu a brzdy v závodných hrách."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Použiť Gouraudovo tieňovanie namiesto plochého, iba s OpenGL."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Použiť CRT filter (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Použiť hnedastý chromatický filter."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "Použiť video filter poskytnutý jadrom."

msgctxt "game_options"
msgid "Apply a video filter to mimic various signals."
msgstr "Použiť video filter napodobňujúci rôzne signály."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Použiť video filter na výstupný obraz."

msgctxt "game_options"
msgid "Apply an audio filter. 'Gaussian' reproduce the bass-heavy sound of the original hardware."
msgstr "Použiť zvukový filter. 'Gaussian' reprodukuje basový zvuk pôvodného hardvéru."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Použiť zvukový filter. Upraví interpoláciu zvuku."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Použiť filter špecifický pre jadro napodobňujúci vykresľovanie starých signálov."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Použiť opravu pre niektoré hry."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Použiť región uvedený vyššie, aj keď hra deklaruje vlastný."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Približne napodobňuje analógový výstupný stupeň konzoly: odstráni jednosmernú zložku a zjemní vysoké frekvencie."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Vzhľad arkádového monitora."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Vzhľad arkádového monitora: scanlines, tieňová maska a žiara."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Pomer strán poskytnutý jadrom, použije sa, keď je POMER STRÁN HRY na AUTO."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Pomer strán nastavený v systémových nastaveniach konzoly."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Klávesnica Atari: F2, F4 a F8 ostanú hre, stavy a snímky obrazovky potom používajú AltGr+K, AltGr+L a AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Pokúsiť sa škálovať v natívnom rozlíšení."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Prah zvukového buffera pre manuálne preskakovanie snímok."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Zvuk poskytuje najnižšie oneskorenie. Video je plynulejšie, keď je obnovovacia frekvencia obrazovky blízka frekvencii konzoly."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Frekvencia zvukového výstupu."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (predvolené) sa riadi obnovovacou frekvenciou obrazovky s interpoláciou pohybu. Original a násobky 57.524 Hz vyžadujú obrazovku G-SYNC / FreeSync a vertikálnu synchronizáciu."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Automaticky centrovať os mierenia. Užitočné pri hraní hier so streľbou na gamepade namiesto svetelnej pištole."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Rýchlosť automatickej streľby. Rýchlejšie nie je vždy lepšie: niektoré hry ignorujú príliš rýchle vstupy."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: ľavé útok, spodné skok, pravé špeciál, horné útok 2, L1/R1 útok 3/4. OpenBOR standalone: rovnaké tlačidlá ako samostatný emulátor OpenBOR."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automaticky použije XInput, keď sú všetky ovládače zariadenia XInput, inak DirectInput."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automaticky: spustiť z pevného disku, keď má hra pevný disk a nemá disketu."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automaticky: zobrazí sa iba vtedy, keď hra nemá vlastný zameriavač."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Automaticky použiť vylepšenia hry, ak existujú v databáze jadra (LOD, vzdialenosť vykresľovania, preskočenie FMV)."

msgctxt "game_options"
msgid "Automatically decrease frame delay temporarily to prevent frame drops. Turn off if this worsens audio/video stuttering."
msgstr "Automaticky dočasne znížiť oneskorenie snímky, aby sa predišlo výpadkom snímok. Vypnite, ak to zhorší sekanie zvuku/videa."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Automaticky zrýchliť hru FDS počas načítania disku."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Automaticky načítať patche proti prekladaniu pri spustení hry."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Automaticky načítať širokouhlé patche pri spustení hry."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Automaticky načíta a použije cheaty pri spustení hry."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Automaticky odstráni čierne okraje okolo obrazu Amigy, aby obraz vyplnil väčšiu časť obrazovky."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Automaticky otočiť obraz pre vertikálne hry."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Automaticky prepínať Port0 a Port1 podľa aktivity vstupu."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Automaticky otočiť disk na druhú stranu, keď o to hra požiada."

msgctxt "game_options"
msgid "Avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Zabrániť medzerám medzi pixelmi pri škálovaní. Opraví text Wild Arms a duchov v SoulCalibur."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "Jazyk BIOSu môže ovplyvniť jazyk niektorých hier."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Rámčeky sa zobrazujú iba v 4/3."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "Odporúča sa bilaterálne CAS, ale zníži výkon; CAS je menej agresívne a jemnejšie."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Úroveň čiernej obrazu. Predvolene 50%, podľa arkádového záznamu: nižšie je tmavšie, vyššie jasnejšie."

msgctxt "game_options"
msgid "Blend pixel together when in hires mode. Higher values will blur the picture more."
msgstr "Miešať pixely v režime hires. Vyššie hodnoty obraz viac rozmažú."

msgctxt "game_options"
msgid "Blend pixels from multiple successive frames to simulate LCD ghosting."
msgstr "Miešať pixely z viacerých po sebe idúcich snímok na simuláciu dosvitu LCD."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "Zmiešané vykreslí priehľadné polygóny plynulým miešaním namiesto arkádovej šachovnice. Iba Model 1 a Model 2, renderery Vulkan a OpenGL."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Rozmazať emulovaný obraz."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "Rozmaže susedné pixely pre efekty priesvitnosti."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "Rozmaže susedné pixely na simuláciu rozlíšenia SDTV, niektoré hry to môžu vyžadovať na emuláciu priehľadnosti."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Zrýchliť emuláciu počas zavádzania."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Spustiť priamo do menu BIOS DS, vyžaduje externý bios."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Spustiť na obrazovku zadávania kódov Game Genie. Vyžaduje 'gamegenie.nes' v priečinku bios. Vyžaduje reštart."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Spustiť do menu BIOS konzoly."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Spustiť so skutočným BIOSom Jaguar a jeho úvodnou animáciou. Vyžadujú niektoré hry."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Prerušiť do ladiaceho nástroja hostiteľa (alebo spadnúť bez ladiaceho nástroja) pri neimplementovanej inštrukcii PowerPC."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "Zobraziť menu systémovej ROM pri spustení arkádových systémov."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Vysielať spätnú väzbu vstupu na TCP port 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Zostaviť shadery do cache pred spustením hry."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Kombinácia tlačidiel na prepínanie medzi TV a GamePad, používa ju iba rozloženie obrazoviek PREPÍNATEĽNÉ."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Rozloženie tlačidiel jadra, rovnaké pre všetky hry. Ponechajte na AUTO, aby sa použilo priradenie RetroBat pre každú hru a ROZLOŽENIE OVLÁDAČA."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Tlačidlo na potvrdenie v systémových dialógoch a v hrách, ktoré sa riadia systémovým nastavením. KRUH je japonská konvencia."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Predvolene sa spustí Hellfire, keď názov hry obsahuje hellfire, inak Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Predvolene RetroBat nastaví toľko hráčov, koľko je pripojených ovládačov; použite na prepísanie."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Predvolene RetroBat generuje vlastný konfiguračný súbor; povoľte túto možnosť na použitie vlastného súboru nastavení hry z priečinka 'emulators\ssf\Setting'."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Predvolene sa druhý gamepad použije, keď je pripojený druhý ovládač."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Predvolene hrdinu pohybuje každý ovládač. Povoľte, ak iný pripojený ovládač ruší pohyb."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "Predvolene zinc priradí pohyb na ľavú páčku, táto možnosť prepne na D-pad."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Predvolene RPCS3 vyžaduje guncon v porte hráča 3, použite na jeho vynútenie v porte 1."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Predvolene RetroBat zahodí súbory možností špecifických pre jadro."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Predvolene RetroBat synchronizuje nainštalované hry s priečinkom roms."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "Predvolene sa kalibrácia robí stredným tlačidlom myši, toto nastavenie umožní nastaviť iné tlačidlo na kalibračný výstrel."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Predvolene sa zmeny uložia na disk, 'ZAHODIŤ' neuloží žiadne zmeny."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Predvolene sa na trasenie používa spúšť, povoľte na simuláciu mávnutia."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Obísť mipmapping a vždy použiť najostrejšiu úroveň textúry. Lepšia kvalita obrazu, niekoľko hier má s tým problémy s vykresľovaním."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "Konfigurácia CD32. Vyžaduje Kickstart CD32 aj jeho rozšírenú ROM v priečinku bios."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "KLASICKÉ je pôvodný softvérový renderer. POLYMOST a POLYMER používajú OpenGL a podporujú HD balíky."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "Fyzická veľkosť RAM CPC v kB."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "Takt CPU. Auto použije takt modelu alebo databázu hier. Niektorým hrám (SSF2, Alltynex) prospeje rýchlejší CPU."

msgctxt "game_options"
msgid "CPU frequency multiplier. Applies only with Cycle-exact."
msgstr "Násobič frekvencie CPU. Platí iba s presnosťou cyklov."

msgctxt "game_options"
msgid "Cache custom textures to system RAM on startup."
msgstr "Uložiť vlastné textúry do systémovej RAM pri spustení."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Rýchlosť kamery pravou analógovou páčkou alebo myšou."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Môže neočakávane ovplyvniť výkon."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Dá sa použiť na vypnutie kontroly md5 BIOSu pri použití upraveného biosu."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "Dá sa použiť na zvýšenie snímkovej frekvencie, ale v niektorých hrách môže pokaziť rýchlosť."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Dá sa použiť na zlepšenie výkonu 3D vykresľovania v niektorých hrách."

msgctxt "game_options"
msgid "Can be used to simulate colors of particular displays."
msgstr "Dá sa použiť na simuláciu farieb konkrétnych displejov."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Môže byť užitočné pre Gran Turismo, spúšte sa priradia na iné tlačidlá."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Môže byť užitočné pre Gran Turismo, spúšte sa priradia na pravú analógovú páčku."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Môže byť užitočné pre Metal Gear na simuláciu citlivosti na tlak."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Môže pomôcť niektorým hrám."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Môže spôsobiť rôzne chyby."

msgctxt "game_options"
msgid "Can fix bad memory access error with some games."
msgstr "Môže opraviť chybu nesprávneho prístupu do pamäte v niektorých hrách."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Môže opraviť nezarovnané 2D obrázky, napríklad výber postavy v mario kart."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Môže opraviť niektoré chyby, ktoré sa vyskytovali aj na pôvodnom hardvéri."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Môže opraviť niektoré hry pri nenatívnom rozlíšení zaokrúhlením 2D hrán."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Môže opraviť niektoré problémy s ovládačmi XBOX."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Môže zlepšiť presnosť za cenu malej straty výkonu."

msgctxt "game_options"
msgid "Can improve framerate or cause timing error."
msgstr "Môže zvýšiť snímkovú frekvenciu alebo spôsobiť chyby časovania."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Môže zlepšiť výkon na výkonnejších GPU s rezervou. Funguje iba s rendererom Vulkan."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Môže zvýšiť výkon na niektorých slabších systémoch."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Môže zvýšiť výkon s výkonnou GPU."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Dá sa použiť iba vtedy, ak je ovládač kompatibilný s ovládaním pohybom."

msgctxt "game_options"
msgid "Can reduce input latency, but will inscrease CPU requirements."
msgstr "Môže znížiť oneskorenie vstupu, ale zvýši nároky na CPU."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Môže znížiť zasekávanie pri kompilácii shaderov, ale môže aj vytvoriť artefakty."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Môže znížiť oneskorenie alebo odstrániť spodnú čiaru na wii za cenu grafických problémov."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Obmedziť snímkovú frekvenciu na pôvodných 35 fps."

msgctxt "game_options"
msgid "Certain games require an external cartridge to run."
msgstr "Niektoré hry vyžadujú na spustenie externú kazetu."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Prepnúť ovládanie D-padom medzi joystickom a myšou."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Zmeniť pomer strán spodnej obrazovky."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "Zmeniť pomer strán hornej obrazovky."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Zmeniť cestu pre dekomprimované hry (predvolene '\roms\.uncompressed')."

msgctxt "game_options"
msgid "Change the emulated audio chip model."
msgstr "Zmeniť model emulovaného zvukového čipu."

msgctxt "game_options"
msgid "Change the renderer used by the core."
msgstr "Zmeniť renderer, ktorý používa jadro."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Zmeniť renderer, ktorý používa jadro. Hry so svetelnou pištoľou fungujú iba so SOFTVÉROVÉ."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Zmeniť citlivosť analógovej páčky."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Zmeniť citlivosť myši."

msgctxt "game_options"
msgid "Change this only if multiple GPU are used by your system."
msgstr "Zmeňte iba vtedy, ak váš systém používa viac GPU."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Zmeňte toto nastavenie podľa ovládania hry: vľavo od znaku / je pôvodné tlačidlo hry pre plyn a brzdu, vpravo pre radenie."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Zmeňte toto nastavenie podľa ovládania hry."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Zmeňte toto nastavenie pri nestabilných hrách. Čím vyššia hodnota, tým lepšiu stabilitu môže poskytnúť. 200μs a 400μs sú zvyčajne vhodné pre väčšinu hier."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Mení rozdelenie vlákien emulátora medzi jadrá CPU. Plánovače RPCS3 môžu pomôcť na CPU s viacerými klastrami CCX/CCD alebo s SMT, ale operačný systém je na väčšine strojov najbezpečnejší."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Mení spôsob zobrazenia pištolí v Rambo."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Mení zvukový čip, úvodnú obrazovku TMSS a niekoľko zvláštností hardvéru."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Čip generátora znakov. Automaticky vyberie ten, ktorý zodpovedá vybranému stroju."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "Cheaty musia byť v priečinku \bios\pcsx2\cheats."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "Cheaty musia byť v priečinku 'cheats\mame'."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "Cheaty musia byť v priečinku 'cheats\psxmame'."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Overiť každú ROM podľa databázy hier. Vypnite iba na testovanie romsetu, ktorý sa nenačíta: nesprávne ROM môžu spôsobiť pády alebo poškodiť uloženia. Predvolene zapnuté."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Kontroluje poškodené súbory pri spustení hry."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Čipset použitý pri výbere modelu AGA. Znižujte pod AGA iba na testovanie hry, ktorá sa na A1200 správa zle."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Vyberte 'Trojan Phazer' pre hry písané pre túto pištoľ. 'Light pen' vyhovuje všetkému ostatnému vrátane kresliacich programov."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "Vyberte rozšírenie MSX, ktoré sa pridá do druhého slotu kazety."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Vyberte anglické, francúzske alebo španielske rozloženie klávesnice."

msgctxt "game_options"
msgid "Choose between various texture enhancement filters."
msgstr "Vyberte z rôznych filtrov vylepšenia textúr."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Vyberte tlačidlo na povolenie IR na pravej páčke."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Vyberte tlačidlo na simuláciu mávnutia pravou páčkou."

msgctxt "game_options"
msgid "Choose if the mouse input is active or not."
msgstr "Vyberte, či je vstup myši aktívny."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Vyberte, či skratka výmeny obrazovky prehodí obrazovky natrvalo, alebo iba počas držania tlačidla."

msgctxt "game_options"
msgid "Choose the audio driver compatible with the hardware."
msgstr "Vyberte zvukový ovládač kompatibilný s hardvérom."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Vyberte farebnú paletu."

msgctxt "game_options"
msgid "Choose the disposition of the emulated screens."
msgstr "Vyberte usporiadanie emulovaných obrazoviek."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Vyberte rozšírenie pripojené k ovládaču."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Vyberte druhé usporiadanie emulovaných obrazoviek."

msgctxt "game_options"
msgid "Choose which Atari system to emulate."
msgstr "Vyberte, ktorý systém Atari sa má emulovať."

msgctxt "game_options"
msgid "Choose which color palette is going to be used"
msgstr "Vyberte farebnú paletu"

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Vyberte farebnú paletu."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Vyberte mechaniku, s ktorou pracuje menu ovládania diskov. Ostatné mechaniky ostanú pripojené. Načítané médium použije mechaniku, do ktorej bola hra načítaná."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "Klasické používa pravé a ľavé ramenné tlačidlo na silný kop a úder, moderné pravé ramenné tlačidlo a pravú spúšť."

msgctxt "game_options"
msgid "Cleans up stray black pixels."
msgstr "Vyčistí osamotené čierne pixely."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Farebná paleta pre pôvodné hry Game Boy."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Farebná teplota arkádového monitora."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Farby hier WonderSwan (mono). Palety WS napodobňujú pôvodné obrazovky."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "Nastaviť medzeru medzi obrazovkami v pixeloch."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "Nastaviť zorné pole (vyššie je širšie)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Nastaviť fps."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Nastavte, ak chcete prepínať medzi stereom a priestorovým zvukom."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Nastaví, ako sa ovládače vyžadujú od hostiteľa alebo klienta. Nevyhnutné pre lokálne pripojenie viacerých hráčov."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Pripojiť myš do portu 1."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Variant konzoly zodpovedajúci vybranému obrazu BIOSu."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "Riadi úroveň presnosti jednotky miešania GS. Vyššie hodnoty emulujú miešanie v shaderi presnejšie."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Riadi trilineárne filtrovanie textúr v emulácii."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Riadi spôsob použitia ditheringu."

msgctxt "game_options"
msgid "Controls the number of Auto-CRC fixes and hacks applied to games."
msgstr "Riadi počet opráv Auto-CRC a hackov použitých na hry."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Riadi podrobnosť výpisu pred zobrazením programu."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Prevádzať radenie hore/dole na gear3/gear4 na simuláciu sekvenčného radenia na štandardnej radiacej páke."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Kopírovať textúry do VRAM, pomalšie, ale presnejšie. Vypnite na úsporu výkonu."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Kopírovať farebný buffer do pamäte N64. Potrebné pre niektoré efekty (napr. obrazovky pauzy, fotky z kamery). VYPNUTÉ je najrýchlejšie, ale môže ich pokaziť. AUTO sa riadi výkonnostným režimom."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Správne, ale pomalšie."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Opraviť pomer strán neštvorcových pixelov."

msgctxt "game_options"
msgid "Correct the sampling of 2D sprite textures when upscaling."
msgstr "Opraviť vzorkovanie textúr 2D spritov pri škálovaní."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Orezať potenciálne náhodný chybný video výstup, ktorý by skryl rám okolo okraja obrazovky televízora štandardného rozlíšenia."

msgctxt "game_options"
msgid "Crop out the potentially video output that would have been hidden by the bezel."
msgstr "Orezať časť video výstupu, ktorú by skryl rám."

msgctxt "game_options"
msgid "Crop pixels around edge of screen."
msgstr "Orezať pixely okolo okraja obrazovky."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "Orezať obraz z natívneho pomeru strán na 4:3 alebo 16:9"

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "Oreže okraje na zobrazenie alebo skrytie grafiky okrajov."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "Oreže obraz z 256x240 na 252x239."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Medzná frekvencia filtra zvukového výstupu konzoly. 3390 Hz zodpovedá väčšine modelov Mega Drive."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "Oreže 8 pixelov na okrajoch na odstránenie okrajov Master System."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "Veľkosť dosky DIMM. Auto sa riadi hrou, ponechajte na Auto, pokiaľ sa hra nesťažuje."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Tlmí výkyvy sledujúcej kamery v závodných hrách. Predvolene silné."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Stmaviť každý druhý riadok na napodobnenie obrazovky s katódovou trubicou."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "DeSmuME má interný BIOS, vyberte túto možnosť na použitie BIOSu a firmvéru z priečinka bios RetroBat."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Znížte, ak je to príliš citlivé; prílišné zníženie môže zabrániť dosiahnutiu plného rozsahu."

msgctxt "game_options"
msgid "Default ON."
msgstr "Predvolene ZAPNUTÉ."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "Predvolený emulovaný ovládač je 6-tlačidlový."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Predvolene zapnuté, môže robiť problémy niekoľkým hrám."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Predvolene sa riadi jazykom EmulationStation."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "Predvolene 'VYSOKÉ', nastavte 'NORMÁLNE' na zvýšenie výkonu za cenu presnosti."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "Predvolene 30 sekúnd; nastavte čas čakania na spustenie hry pred návratom do zoznamu hier RetroBat."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "Predvolene VYPNUTÉ, použite pri problémoch s rýchlosťou na displejoch s vysokou obnovovacou frekvenciou."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Predvolene ZAPNUTÉ (rýchle). VYPNUTÉ spustí skutočné geometrické programy DSP, presnejšie, ale pomalšie (iba hry Model 1, Model 2 2B)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Predvolene ZAPNUTÉ, správne vykresľovanie štvoruholníkov. VYPNUTÉ vykreslí štvoruholníky ako trojuholníky (rýchlejšie)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Predvolene ZAPNUTÉ, VYPNUTÉ môže opraviť kompatibilitu so staršími GPU (iba Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "Predvolene ZAPNUTÉ, použite na odstránenie limitu 60hz, môže pokaziť hry."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Predvolene zapnuté, vypnite na zobrazenie úvodnej animácie."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Predvolene 10 bitov pre DS a 16 bitov pre DSi."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Predvolene Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "Predvolene WIIU Gamepad; zmeňte pre hry, ktoré v režime viacerých hráčov neprijímajú WIIU Gamepad."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Predvolene: kurzor skrytý."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Predvolene: zapnuté."

msgctxt "game_options"
msgid "Default: low."
msgstr "Predvolene: nízke."

msgctxt "game_options"
msgid "Default: true"
msgstr "Predvolene: true"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Predvolene 60, keď je nastavené 0 a VSYNC je zapnutá."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Určiť BIOS na emuláciu."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "Určiť typ gamepadu, platí pre oboch hráčov."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "Určiť model počítača PET."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "Určiť zariadenie Symbian na spustenie."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Určiť tlačidlo na zobrazenie obrazovky Gamepad, predvolene žiadne."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Určiť, koľko RAM bude mať emulovaný stroj."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Určiť, ako sa má kurzor zobrazovať na spodnej obrazovke."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Určiť, ako sa hra prispôsobí alebo naškáluje v okne."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Určiť spôsob konfigurácie pištole Sinden."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Určiť priradenie tlačidiel A a B GunCon (Start a Back Justifier). Predvolene: D-pad vpravo/vľavo s Wiimote na DolphinBar, tlačidlá myši s inými pištoľami."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "Určiť priradenie tlačidiel guncon2."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Určiť spôsob emulácie dotykovej obrazovky."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Určiť, ako je váš wiimote pripojený k DolphinBar."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Určiť, či sa má použiť patch a kde sú súbory patchov; 'AUTO' použije patche, ak sú vedľa rom s rovnakým názvom ako súbor rom."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Určiť priradenie tlačidiel myši (ľavé/pravé/stredné), predvolene a/reload/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "Určiť typ modelu a región."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Určiť model, predvolene BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Určiť model, predvolene CPC 6128+ pre GX4000."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "Určiť model, predvolene Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Určiť index myši pre hráča 1."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "Určiť index myši pre hráča 2."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Určiť index myši pre hráča 3."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Určiť index myši pre hráča 4."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Určiť cestu k vlastnému súboru controls.ini."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "Určiť región, používa sa pre uloženia."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Určiť kombináciu tlačidiel, ktorú treba podržať na prepnutie ovládača dualshock medzi analógovým a digitálnym režimom."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Určiť farebnú paletu, STARÉ NTSC reprodukuje staré škaredé farby japonských televízorov."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "Určiť pripojené zariadenie, ktoré emuluje otočný ovládač (Dial)."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Určiť pripojené zariadenie, ktoré emuluje pedál."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "Určiť pripojené zariadenie, ktoré emuluje pozičné zariadenie."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "Určiť pripojené zariadenie, ktoré emuluje trackball."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "Určiť pripojené zariadenie, ktoré emuluje svetelnú pištoľ."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Určiť pripojené zariadenie, ktoré emuluje myš."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "Určiť pripojené zariadenie, ktoré emuluje paddle."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Určiť pripojené zariadenie, ktoré emuluje analógovú smerovú páčku."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Určiť typ emulovaného joysticku."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Určiť typ emulovaného stroja."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "Určiť funkciu pravého joysticku."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "Určiť kombináciu kláves na vstup do diagnostického menu."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Určiť úroveň vibrácií a trasenia obrazovky; ak ovládač nepodporuje vibrácie, povoľte trasenie obrazovky. 'AUTO' povolí oboje."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Určiť polohu práve držanej zbrane."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Určiť priradenie D-PADU."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Určiť počet emulovaných pamäťových kariet."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Určiť počet pixelov na orezanie."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Určiť zvuk, ktorý bude prijímať emulovaný mikrofón."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "Určiť typ zariadenia na pohyb ukazovateľa."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Určiť typ monitora, zmení farby."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Určiť typ emulovaného ovládača."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "Určiť typ zameriavača pre pištole."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Určiť, kde sú umiestnené tlačidlá mince a start."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Určiť, či skratka 'zrýchlenia' funguje ako prepínač, alebo ju treba držať."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Určiť, či skratka 'spomalenia' funguje ako prepínač, alebo ju treba držať."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Určiť, ktorý zvuk Gameboy systém vydáva."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Určiť, ktorá analógová páčka ovláda ukazovateľ myši."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "Určiť tlačidlo, ktoré aktivuje režim turbo; nie je to tlačidlo, ktoré sa stane turbo."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Stupne otočenia volantu, ktoré zodpovedajú plnému natočeniu v hre. 270 je arkádový automat."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Odmietnuť zápis počas zaneprázdnenia."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "V závislosti od konfigurácie môže zvýšiť alebo znížiť oneskorenie."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Zariadenie zapojené do herného portu Apple II. Analógová páčka dáva plynulý pohyb paddle, D-pad ide iba úplne vľavo alebo vpravo."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Typ zariadenia pre hráča 2."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Iba DirectInput: použite, ak ovládače neovládajú správnych hráčov."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Vypnúť kontrolu podpisu XBE pri používaní homebrew hier."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Vypnúť nastavenia Xenia Edge pre každú hru, aby sa použili nastavenia RetroBat."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Vypnúť bezpečnostné funkcie jadra, aby sa dali spustiť niektoré homebrew hry."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Vypnúť dithering a použiť plnú 8-bitovú informáciu o farbe na kanál."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Vypnúť efekty hmly."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Vypnúť hardvérový renderer, môže zvýšiť kompatibilitu."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Vypnúť klávesové skratky a dať jadru plný prístup ku klávesnici. Prepína sa klávesom 'Scroll Lock'."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Vypnúť modifikačné objemy používané na vykresľovanie tieňov."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "Vypnutie pixel shaderov môže opraviť pády niektorých hier, neaktivujte, pokiaľ to hra nepotrebuje."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Vypnúť FM čip Master System."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Vypnúť menu Visual Pinball: kláves ukončenia (X) zatvorí stôl priamo."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Vypnúť analógový plunger (pravá páčka) a analógové postrčenie (ľavá páčka)."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Vypnúť kontrolu kamery automatu."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "Vypnúť kontrolu artworkov v priečinku 'saves\mame\artwork'."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "Vypnúť aplet ovládačov, ktorý sa objavuje v hrách viacerých hráčov na výber pripojených ovládačov."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Vypnúť herné menu otvárané HOTKEY + EAST alebo F12."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Vypnite túto možnosť, aby sa IR ukazovateľ vycentroval po pustení páčky."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Vypnite túto možnosť na zlepšenie výkonu."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Vypnite túto možnosť na priame spustenie súboru .bat alebo .cmd bez toho, aby sa RetroBat pokúšal nájsť v ňom spustiteľný súbor."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Vypnite na priradenie R2 a L2 na tlačidlá L a R (nedigitálne)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Vypnúť použitie osi X na postrčenie, osi Y na náklon a osi Z na plunger."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Vypnúť varovanie pri spúšťaní hier, ktoré nie sú plne podporované."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Vypne vibrácie joypadu; predvolene sú vibrácie zapnuté iba vtedy, keď sú hra a ovládač kompatibilné."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Vypne automatické nastavenia pre každú hru z databázy jadra a povolí manuálne opravy nižšie. Neodporúča sa."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Vypne interpoláciu pohybu, o jednu snímku menšie oneskorenie."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Vypne cache vrcholov. Môže vyriešiť chýbajúcu alebo blikajúcu grafiku. Môže znížiť výkon."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "Vypnutie ditheringu môže odstrániť časť šumu a efektov pixelizácie."

msgctxt "game_options"
msgid "Disabling safe features can help various games such as Xenosaga, Kingdom Hearts..."
msgstr "Vypnutie bezpečnostných funkcií môže pomôcť rôznym hrám, ako Xenosaga, Kingdom Hearts..."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "Pre niektoré hry môže byť potrebné vypnúť rozširujúci balík RAM 4MB."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Vypnutie tejto funkcie zníži farebnú hĺbku."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "Zobraziť rozhranie menu MAME pri načítaní hry."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "Zobraziť okraje SGB pri emulácii Super Game Boy."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Zobraziť správu pri odomknutí úspechu. Predvolene zapnuté."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Zobraziť malý ukazovateľ na dotykovej obrazovke."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Zobraziť ukazovateľ skúseností nad opaskom."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Pomer strán obrazu LaserActive, predvolene 4:3."

msgctxt "game_options"
msgid "Display crosshair if a lightgun is used."
msgstr "Zobraziť zameriavač pri použití svetelnej pištole."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Zobraziť aktuálne hodnoty života a many na guliach."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Zobraziť poškodenie a skúsenosti ako plávajúce čísla."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Zobraziť čas úrovne, nájdené tajomstvá a zabitých nepriateľov."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Zobrazenie druhej obrazovky (dotykovej) Primeval Hunt."

msgctxt "game_options"
msgid "Display or not on-screen notifications."
msgstr "Zobrazovať alebo nezobrazovať oznámenia na obrazovke."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Zobraziť okrajové oblasti obrazovky. Nemá vplyv na výstup F18A."

msgctxt "game_options"
msgid "Display the emulated framebuffer at a widescreen aspect ratio. Get best results with full 3D games."
msgstr "Zobraziť emulovaný framebuffer v širokouhlom pomere strán. Najlepšie výsledky s plne 3D hrami."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Zobraziť hru v 16:9. Najlepšie s POMER STRÁN HRY nastaveným na 16/9."

msgctxt "game_options"
msgid "Display the overscan regions of the screen."
msgstr "Zobraziť oblasti overscan obrazovky."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Zobraziť obrazovku VMU hráča 1 nad hrou."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Displej použitý pri spustení. V hre sa dá prepnúť klávesom F7 (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Zobraziť voxelové objekty namiesto plochých spritov, ak sú k dispozícii. Predvolene zapnuté."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Dithering supervzorkovaných efektov framebuffera."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Dithering použitý na obrazy framebuffera RDRAM."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Delí vnútorné rozlíšenie: pri vysokom vnútornom rozlíšení vyššie hodnoty zväčšia hru. Predvolene: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 je veľmi tmavá hra, zvýšte na zosvetlenie obrazu."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Zdvojnásobí vnímané vodorovné rozlíšenie, nekompatibilné so supervzorkovaním."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Zmenšiť naškálovaný obraz (SSAA). Vyžaduje škálovanie."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Vykresľovať scenériu až do konca trate v hrách, ktoré to podporujú (Daytona USA). Iba Model 1 a Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Mechanika použitá na výmenu diskov."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick: Robotron 2084 a Space Dungeon na pravej páčke. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: viactlačidlové joysticky."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Duplikovanie snímok vyžaduje renderer Vulkan."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Dynamická rekompilácia. Väčšina hier beží rýchlejšie, niektoré pomalšie."

msgctxt "game_options"
msgid "Efficient graphics filters improving the rendering of games."
msgstr "Efektívne grafické filtre zlepšujúce vykresľovanie hier."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Odstráni skreslenie a deformáciu textúr pri škálovaní."

msgctxt "game_options"
msgid "Eliminates position-dependent distortion and warping of textures."
msgstr "Odstráni skreslenie a deformáciu textúr závislé od polohy."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Emulovať bzučiaky Buzz! na vašich gamepadoch. Jeden ovládač pokryje 4 bzučiaky (hráči 1-4), dva ovládače pokryjú 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Emulovať dlaždicovanie pamäte PS3. Opraví grafické chyby v niektorých hrách za cenu malej straty výkonu."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Emulovať jednotku rozpoznávania hlasu (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Emulovať gramofón DJ Hero na vašich gamepadoch. Potrebné pre DJ Hero 1 a 2."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Emulovať ovládač Guitar Hero Live (GHLtar) na vašich gamepadoch. Potrebné pre Guitar Hero Live."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Emulovať New 3DS alebo pôvodnú 3DS."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Emulovať PlayStation TV pre lokálnu hru viacerých hráčov (až 4 ovládače). Rovnaké ovládače nie sú podporované, hry s dotykovou obrazovkou nemusia fungovať."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Emulovať konkrétne ovládanie pohybom. '/' znamená akciu pre ľavú/pravú páčku."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Emulovať ovládač spinner riadený pohybom myši. Tlačidlá myši sú priradené na ľavé (žlté) a pravé (červené) tlačidlo."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Emulovať frekvenciu vblank NTSC 59,94Hz namiesto 60Hz. Opraví časovanie a posun zvuku v niektorých hrách NTSC."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Emulovať príslušenstvo základne Disney Infinity."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Emulovať Game Boy Player na povolenie vibrácií v kompatibilných hrách."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Emulovať príslušenstvo toypad LEGO Dimensions."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Emulovať príslušenstvo portál Skylanders."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Emulovať kartu Video CD, vyžaduje mpeg_card.bin v priečinku bios."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emulovať správanie starších motorov, vyžadujú niektoré staršie módy a dema."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Časový úsek emulovaného vlákna. Zvýšenie môže pomôcť niekoľkým hrám, zníženie môže iné zjemniť."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Emuluje efekty priesvitnosti LCD, ale zvýši rozmazanie pohybu."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Emuluje rozloženie multisamplingu PS3. Môže opraviť niektoré vizuálne artefakty v niektorých hrách."

msgctxt "game_options"
msgid "Emulation method used. AUTO for mixed features with max performance and compatibility."
msgstr "Použitá metóda emulácie. AUTO pre zmiešané funkcie s maximálnym výkonom a kompatibilitou."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Scanlines emulátora, viditeľné iba v niektorých hrách."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Povoliť úpravu RAM 32MB pre dreamcast, môže ovplyvniť kompatibilitu."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "Povoliť spustenie do BIOSu pre hry DSI."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Povoliť emuláciu CMS."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Povoliť digitálny zvukový procesor. Zlepší presnosť zvuku za cenu vyšších nárokov na výkon."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Povoliť digitálny zvukový procesor. Zlepší presnosť zvuku za cenu výkonu."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Povoliť službu Discord Rich Presence, stav na Discorde bude zobrazovať hrané hry."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Povoliť dekodér Dolby Pro Logic II v kompatibilných hrách a s reproduktormi 5.1."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Povoliť kontrastné adaptívne zostrenie FidelityFX."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Povoliť jednotku s pohyblivou rádovou čiarkou, zvyčajne užitočné pre neskoršie 3D hry."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Povoliť emuláciu Gravis Ultrasound."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "Povoliť HDR pre displeje kompatibilné s HDR."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Povoliť emuláciu IBM PS/1 Audio (predvolene vypnuté)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Povoliť emuláciu Just In Time, zvyšuje rýchlosť emulácie, nekompatibilné s presnosťou cyklov."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "Povoliť interné premapovanie ovládania MAME."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "Povoliť možnosť MAME na automatickú konfiguráciu rozloženia tlačidiel pre každú hru podľa jeho internej databázy."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "Povoliť emulovaný bios MelonDS namiesto firmvérov dostupných v priečinku bios."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "Povoliť renderer OpenGL, ovládač RetroArch musí byť nastavený na OpenGL."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "Povoliť emuláciu NES PAL (50Hz)."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Povoliť RAM kazetu Sega CD."

msgctxt "game_options"
msgid "Enable Service button to enter settings."
msgstr "Povoliť servisné tlačidlo na vstup do nastavení."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Povoliť emuláciu zvuku Tandy."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Povoliť dodatočnú vývojársku RAM, môže pokaziť hry."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Povoliť vyhladzovanie hrán, vyhladí hrany polygónov."

msgctxt "game_options"
msgid "Enable blargg NTSC video filters"
msgstr "Povoliť video filtre NTSC blargg"

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Povoliť škálovanie hrubou silou nahor/nadol (iba 10.8.0)"

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Povoliť pripojenie cache"

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "Povoliť vrhanie tieňov hernými objektmi, kompatibilné iba s OpenGL."

msgctxt "game_options"
msgid "Enable certain games with support for the 3Dfx Voodoo accelerator."
msgstr "Povoliť určité hry s podporou akcelerátora 3Dfx Voodoo."

msgctxt "game_options"
msgid "Enable colorization of Game Boy games."
msgstr "Povoliť farebnenie hier Game Boy."

msgctxt "game_options"
msgid "Enable controller's rumble effects."
msgstr "Povoliť efekty vibrácií ovládača."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Povoliť efekty vibrácií ovládača. Funguje iba v závodných hrách."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Povoliť zameriavače v strieľačkách, možnosti (DS) sú kompatibilné iba s DemulShooter."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Povoliť zameriavače v strieľačkách."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Povoliť vlastné rozlíšenie podľa video režimu."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Povoliť dynamické rekompilátory, ktoré pomáhajú zlepšiť výkon."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Povoliť rozšírené funkcie pre DS4 a DualSense; naruší to kompatibilitu s emulátormi používajúcimi dinput, kým sa nevypne."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Povoliť silovú spätnú väzbu pre podporované ovládače."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Povoliť vyhladzovanie hrán celej obrazovky v Direct3D, vyhladí hrany polygónov."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Povoliť filter vodorovného miešania (rozmazanie)."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Povoľte, ak volant tlačí od stredu namiesto k nemu."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Povoliť herný zameriavač na uľahčenie mierenia."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Povoliť funkciu inteligentného priblíženia."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Povoliť patche ips."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "Povoliť menej presnú, ale lepšie znejúcu emuláciu zvuku Namco 106 (mapper 19)."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Povoliť manuálne hacky nižšie, inak sa hacky použijú automaticky."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Povoliť ovládanie pohybom (gyroskop) myšou alebo kompatibilným ovládačom."

msgctxt "game_options"
msgid "Enable multitap in port 1."
msgstr "Povoliť multitap v porte 1."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Povoliť multitap v porte 2."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Povoliť progresívne riadkovanie pre kompatibilné hry."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Povoliť režim run-ahead na zníženie oneskorenia vstupu."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Povoliť IBM Music Feature Card (predvolene vypnuté)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "Povoliť FM čip Master System."

msgctxt "game_options"
msgid "Enable the Memory Management Unit. Required for some games."
msgstr "Povoliť jednotku správy pamäte. Vyžadujú niektoré hry."

msgctxt "game_options"
msgid "Enable the On Screen Keyboard feature which can be activated with the L3 button."
msgstr "Povoliť klávesnicu na obrazovke, ktorú možno aktivovať tlačidlom L3."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Povoliť účinky cheatov aktivovaných v rozhraní Vita3K."

msgctxt "game_options"
msgid "Enable the effects of the chosen Action Replay and Gecko codes for a game."
msgstr "Povoliť účinky vybraných kódov Action Replay a Gecko pre hru."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Povoliť emuláciu joypadov Jaguar zapojených do rozšírených portov joystickov Atari STE."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Povoliť použitie myši pre dotykovú obrazovku namiesto pravej páčky."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Povoľte, ak sú indexy ovládačov XInput prehodené."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Povoľte, ak ovládač nemá analógové spúšte."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Povoľte, ak máte monitor gsync/freesync, môže spôsobiť chyby zvuku."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Povoľte túto možnosť pri problémoch s grafickým čipom Intel."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Povoľte túto možnosť, ak v hre chýba grafika alebo je pokazené osvetlenie."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Povoľte túto možnosť pri použití mamehooker s LED, solenoidmi, vibráciami..."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Povoľte na použitie shaderov, aj keď RetroBat nemá nastavený žiadny shader."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Povoľte na zapojenie joysticku hráča 1 do ľavého portu namiesto pravého."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Povoľte na použitie shaderov dodávaných s Duckstation."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Povoľte na použitie vlastných nastavení Project64 pre každú hru."

msgctxt "game_options"
msgid "Enable verbose mode for debugging."
msgstr "Povoliť podrobný režim na ladenie."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Predvolene zapnuté (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Predvolene zapnuté, zlepšuje prenos dát emulovaného portu SIO."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Predvolene zapnuté."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Predvolene zapnuté. Vypne dithering a vynúti 24-bitový farebný výstup."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Predvolene zapnuté. Vypnutie môže zlepšiť výkon, ale pokazí niektoré hry."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Predvolene zapnuté. Rýchlejšie shadery, môžu spôsobiť zriedkavé grafické problémy."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Predvolene zapnuté. Opraví grafické chyby v niektorých hrách za cenu malej straty výkonu."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Predvolene zapnuté. Odstráni rozmazanie z niektorých hier, ale zníži presnosť."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Predvolene zapnuté. Nahradí sprity hry HD balíkom, ak je k dispozícii. Vyžaduje reštart."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Predvolene zapnuté. Zobraziť správy samotného emulátora."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Predvolene zapnuté. Keď je vypnuté, snímková frekvencia je obmedzená na 60 FPS."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Predvolene zapnuté. Keď je vypnuté, snímkovú frekvenciu obmedzuje hra."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Povolí režim 60HZ na zníženie trhania obrazu na displejoch, ktoré nepodporujú prevádzku nad 60HZ."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Povolí automatické generovanie mipmáp Direct3D."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Povolí vysoké rozlíšenie WRX."

msgctxt "game_options"
msgid "Enables a low pass audio filter to soften the harsh sound of some games."
msgstr "Povolí dolnopriepustný zvukový filter na zjemnenie drsného zvuku niektorých hier."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Povolí hack proti rozmazaniu, menej presné, ale hry sú menej rozmazané."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Povolí šípky, CTRL a ALT ako joystick a tlačidlá streľby."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Povolí funkciu vlastných patchov."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Povolí vykresľovanie CEL vo vysokom rozlíšení."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Umožní prepínanie medzi rôznymi video signálmi."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Povolenie môže spôsobiť problémy s ovládačmi 8BitDo."

msgctxt "game_options"
msgid "Enabling this will downsampling to native color depth. Disabling enable output at higher color depth."
msgstr "Povolenie podvzorkuje na natívnu farebnú hĺbku. Vypnutie umožní výstup s vyššou farebnou hĺbkou."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Vynúti prísne dodržiavanie špecifikácie API. Môže znížiť výkon v niektorých hrách. Môže vyriešiť zriedkavé prípady chýbajúcej grafiky a blikania."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Zlepší presnosť grafiky za cenu vyšších nárokov na výkon."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "Vylepšiť tiene rôznych objektov."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "Zlepšiť kvalitu 2D textúr."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface."
msgstr "Zlepšiť kvalitu textúr na povrchoch."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Zlepšiť kvalitu textúr na povrchoch. Iba OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Zlepšiť kvalitu textúr na povrchoch. Iba Vulkan a OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Filter vylepšenia použitý na textúry."

msgctxt "game_options"
msgid "Enhancement. Reduces system slowdown. Causes issues in some games."
msgstr "Vylepšenie. Zníži spomalenia systému. Spôsobuje problémy v niektorých hrách."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Zadajte lokálny UDP port na hostovanie."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Zadajte adresu servera."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Zadajte prvé znaky rom hry použitej na prenos dát."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Zadajte prvé znaky súboru uloženia použitého na prenos dát."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Zadajte dotykový profil na načítanie."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Dozvuk prostredia (EFX), predvolene zapnutý."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Presné je najbližšie ku konzole a najnáročnejšie na GPU. Rýchle je oveľa ľahšie. Auto vyberie rýchle na slabých alebo nestabilných GPU."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "Spúšťa grafický backend v druhom vlákne, zlepšuje výkon, znižuje sekanie a zrýchľuje kompiláciu shaderov."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Rozšíriť pamäťovú kartu SAMS na 4M."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Rozširujúca kazeta vložená do konzoly. Hry so známou požiadavkou to automaticky prepíšu."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Experimentujte s touto možnosťou, ak joystick ubieha (predvolene zapnuté)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Experimentálne, iba Windows. Chráni dáta zásobníka hry, keď emulátor spracúva výnimky pamäte. Môže opraviť pády v niektorých hrách. Ponechajte vypnuté, pokiaľ to hra nepotrebuje."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Ďalší ovládač. Ponechajte prázdne, pokiaľ si ho hra nevyžiada."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Ďalšia pamäťová karta, iba modely //e. Niekoľko programov potrebuje viac ako štandardných 64KB."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "Citlivosť myši FM Towns."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Rýchle približné vyhladzovanie hrán, lacnejšie ako MSAA, ale rozmazanejšie."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Rýchle môže zlepšiť výkon, ale na niektorých ovládačoch môže byť nestabilné."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "ROM rýchleho načítania diskov. Vyžaduje VERNÁ EMULÁCIA MECHANIKY a ROM JiffyDOS v 'bios\vice'. Nepoužíva sa s páskami a kazetami."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Rýchle je menej presné, usporiadané a atomické je presné, ale pomalšie."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Rýchlejší motor emulácie DSP (experimentálny). Použije sa iba vtedy, keď je EMULÁCIA DSP zapnutá."

msgctxt "game_options"
msgid "Faster loading times but can cause issues with some games."
msgstr "Rýchlejšie načítanie, ale v niektorých hrách môže spôsobiť problémy."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Rýchlejšie čítanie sektorov. Niektorý softvér to nemusí očakávať."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Filtrovať všetky textúry vrátane tých, ktoré hra výslovne nastavuje ako nefiltrované. Predvolene vypnuté."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Filter použitý na konečný obraz."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Filter na škálovanie obrazu na obrazovku."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Filter pri škálovaní konečného obrazu."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Filter, keď je vykreslený obraz väčší ako obrazovka."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Filter, keď je vykreslený obraz menší ako obrazovka."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Filtrovanie použité na 3D textúry."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Filtrovanie použité na 3D textúry. Iba OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Filtrovanie použité na sprity a 2D prvky."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Strieľať nepretržite, kým je tlačidlo stlačené."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Spustiť motor spätného rázu pištole pri každom výstrele, pre pištole, ktoré ho majú. Predvolene zapnuté."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Vložiť hry s vysokým rozlíšením alebo širokouhlé do snímky 640x480 s čiernymi okrajmi. Užitočné iba na CRT televízore 4:3."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Vložiť Digital Video Cartridge (vmpega.rom v priečinku bios), vyžadujú ju hry s FMV a Video CD."

msgctxt "game_options"
msgid "Fit to the original ratio of the game."
msgstr "Prispôsobiť pôvodnému pomeru hry."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Opraviť chybu Demul (ukončenie celej obrazovky pri streľbe do ľavého horného rohu) zablokovaním všetkých vstupov myši do rozhrania Demul."

msgctxt "game_options"
msgid "Fix issues with upscaling in Namco games (Ace Combat, Tekken, SoulCalibur...)."
msgstr "Opraviť problémy so škálovaním v hrách Namco (Ace Combat, Tekken, SoulCalibur...)."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Opraviť spomalenia s týmto emulátorom."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Opraviť poškodenie textúr a problémy s hĺbkou na GPU AMD a niektorých Intel."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Opraviť pásikovanie, ktoré sa môže objaviť v naškálovaných textúrach."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Opraviť zaseknutie hry v slučke pri spustení."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Opraví koplanárnu geometriu a obtlačky v niektorých hrách, môže pokaziť iné."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Opraví medzery medzi 2D prvkami."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Opraví artefakty tieňov a hĺbky v niektorých hrách."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Opraví niektoré grafické chyby s čiarami."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Opraví chyby textu v niektorých hrách."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Jednotka s pohyblivou rádovou čiarkou, potrebná pre niektoré 3D hry. Predvolene zapnutá s 68040 (vstavaná), vypnutá s 68030."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Priečinok pre dáta Vita3K (firmvér, nainštalované hry, uloženia). Ignoruje sa, keď je Vita3K v prenosnom režime (neprázdny priečinok 'portable' vedľa Vita3K.exe)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "ROM písma, ktorú vyžadujú niektoré japonské hry."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "Pre Bleach Blade Battlers."

msgctxt "game_options"
msgid "For Goemon."
msgstr "Pre Goemon."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "Pre systémy Nintendo prehodiť A a B, aby zodpovedali názvom tlačidiel Xbox."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "Pre hry Run Behind a M-bit."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "Pre HUD SOCOM 2/Spy Hunter."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "Pre Scarface The World is Yours a Crash Tag Team Racing."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "Pre hry SegaScope 3-D zobraziť iba jedno oko namiesto blikajúcej dvojice."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "Pre Superman Returns."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "Pre Tales of Destiny."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "Pre hry Tri-Ace."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "Pre hry s textúrami ASTC prepnite na stredné s GPU so 6GB VRAM a na nízke s GPU so 4GB-2GB VRAM."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "Pre ovládače n64 s 2 spúšťami použiť R2 namiesto L2 ako tlačidlo Z."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "Pre nostalgiu. Predvolene vyzerá ako akcelerovaná hmla vojny (FoW) v BG2"

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "V niektorých emulátoroch sa dá použiť na opravu priradenia klávesnice a myši wiimote pri 2 wiimote."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Vynútiť pre softvér GBC, ktorý mení správanie pri spustení na GBA."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "Vynútiť režim GameBoy pre GameBoy Color."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Vynútiť index ovládača P1, užitočné, ak zariadenia XInput nie sú správne zoradené."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "Vynútiť index ovládača P1, užitočné pri použití ovládača na arkádovom stroji."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "Vynútiť index ovládača P2, užitočné pri použití ovládača na arkádovom stroji."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Vynútiť Rawinput, nemalo by byť potrebné vynútiť na ZAPNUTÉ."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Vynútiť počet cyklov CPU na operáciu. AUTO použije predvolenú hodnotu pre hru, meňte iba vtedy, ak je hra pokazená."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Vynútiť tlačidlo namiesto osi pre spúšte, môže pomôcť s ovládačmi Sony."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Vynútiť emulátor na celú obrazovku, aj keď je RetroBat v okne"

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Vynútiť obmedzovač snímok."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Vynútiť spôsob vzorkovania textúr. Najbližší sused zachová pixely ostré, lineárne ich vyhladí."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Vynútiť vstupný ovládač. Predvolene 'sdl', 'dinput', ak je povolených viac pištolí."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Vynútiť rozlíšenie na aktuálne rozlíšenie obrazovky pre hry, ktoré umožňujú vlastné rozlíšenie."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Vynútiť rozširujúcu kazetu saturn, ak zlyhá automatická detekcia."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Vynútiť región saturn, ak zlyhá automatická detekcia."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Vynútiť stereo na všetkých ROM."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Vynútiť model Game Boy na emuláciu, ak zlyhá automatická detekcia."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Vynútiť obnovovaciu frekvenciu VI. AUTO je správne takmer pre každú hru."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Vynútiť skutočné rozloženie výstupných kanálov. ZVUKOVÉ KANÁLY určujú, čo vidí hra, toto rozhoduje, ako sa zmixuje do vášho zariadenia. Ponechajte na AUTO, pokiaľ sa výstupné zariadenie nerozpozná nesprávne."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Vynútiť zapnutie alebo vypnutie backglass. AUTO sa riadi NASTAVENIE OBRAZOVIEK (zapnuté, keď NASTAVENIE OBRAZOVIEK nie je nastavené)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Vynútiť režim bilineárneho filtrovania pri škálovaní dirty rectangles."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Vynútiť zavádzacie zariadenie (iba modely 1F/2F a novšie)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "Vynútiť región konzoly."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Vynútiť región konzoly. Predvolene sa región zistí z hry."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Vynútiť emulovanú obnovovaciu frekvenciu namiesto jej zistenia z načítanej hry. Vyžaduje reštart jadra."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Vynútiť, aby emulátor použil konkrétny súbor BIOSu."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches."
msgstr "Vynútiť frekvenciu emulovaného CPU. Môže znížiť spomalenia, ale spôsobiť chyby."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Vynútiť frekvenciu emulovaného CPU. Môže znížiť spomalenia, ale spôsobiť chyby. Predvolene 57%."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "Vynútiť frekvenciu regiónu hry, aby sa predišlo problémom s rýchlosťou emulácie; ponechajte 'Auto', pokiaľ nezaznamenáte problémy s rýchlosťou."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Vynútiť klávesnicu na použitie, ak je pripojených viac klávesníc."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Vynútiť radič pamäťových bánk. Meňte iba vtedy, ak hra nebeží správne. Vyžaduje reštart jadra."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Vynútiť monochromatické režimy zobrazenia, ako na zelenom alebo jantárovom monitore z tej doby."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Vynútiť počet Wiimote, ktoré hra zistí. Nastavte 1 pre hry, ktoré prejdú do režimu viacerých hráčov, hneď ako je pripojených viac ovládačov."

msgctxt "game_options"
msgid "Force the region of the system."
msgstr "Vynútiť región systému."

msgctxt "game_options"
msgid "Force the rendering and display of frames to progressive mode."
msgstr "Vynútiť vykresľovanie a zobrazovanie snímok v progresívnom režime."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "Vynútiť typ mediálneho súboru"

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Vynútiť použitie ovládača SDL pre ovládače; nastavte, ak sa používa viac ako 4 ovládače, pretože XInput je obmedzený na 4 hráčov."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Vynútiť použitie ovládača SDL alebo DInput pre ovládače; nastavte, ak sa používa viac ako 4 ovládače, pretože XInput je obmedzený na 4 hráčov."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Vynútiť použitie konkrétneho softlistu, zoznam softvéru musí byť v priečinku 'bios\mame\hash'."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Vynútiť použitie vysokoúrovňovej emulácie BIOSu."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Vynútiť hlasovú kazetu v slote 1, vyžaduje súbor bios 'voice.zip'."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "Vynútiť index volantu, užitočné, ak RetroBat nastaví nesprávny index."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "Vynúti obnovovaciu frekvenciu 60Hz."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "Vynúti konzolu do režimu PAL namiesto NTSC, môže pôsobiť pomaly."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Vynúti emuláciu blit a manipulácie s obrazom na CPU, v niektorých prípadoch presnejšie a potrebné pre hry ako GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Vynúti ovládač raw input pri použití zariadení ako trackball a spinner."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Vynúti úroveň kompatibility motora. Nastavte MBF21 pre WAD, ktoré to vyžadujú."

msgctxt "game_options"
msgid "Full precision of 12-bit for the MCM5205 ADPCM can reduce whining noise during ADPCM playback."
msgstr "Plná 12-bitová presnosť pre ADPCM MCM5205 môže znížiť pískanie pri prehrávaní ADPCM."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Rozlíšenie na celej obrazovke. Predvolene sa použije rozlíšenie pracovnej plochy."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Plné ovládanie kamery pravou páčkou."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "Stavy GST sa dajú otvoriť v Kega a Gens, ale ukladajú menej zo stavu stroja."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Zosilnenie síl dosky pohonu. Predvolene 30%, 200% ich zdvojnásobí."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Rozlíšenie hry. Vyššie hodnoty zobrazia väčšiu časť hernej plochy."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Rozsah riadenia gamepadom v závodných hrách. Predvolene 66%, nemá vplyv na volant."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Gamepad: ovládač a klávesnica pohybujú ukazovateľom CD-i. Myš: myš PC pohybuje ukazovateľom (hry point and click a so streľbou), ovládač si ponechá iba tlačidlá. Hotkey + L3 prepína počas hry."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Gamepady sa stanú hráčom 1, 2... a arkádové páky sa priradia ďalším hráčom."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Všeobecný hack časovania."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "Nemčina a francúzština vyžadujú PAL verziu hry, japončina NTSC verziu."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Dať hre celú klávesnicu (Scroll Lock ju vráti skratkám) a zachytiť myš. Gamepad naďalej funguje."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Dobré pri problémoch s emuláciou cache."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Grafický čipset pre modely bez AGA. Automaticky sa riadi vybraným modelom, čo je takmer vždy to, čo chcete."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Grafický plugin na vykresľovanie hry."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Predvoľba kvality grafiky (textúry, filtrovanie). AUTO ju vyberie podľa množstva pamäte."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Výrazne ovplyvňuje výkon CPU."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Výrazne zvýši kvalitu textúr generovaných efektmi render-to-texture. Predvolene zapnuté. Vypnutie môže zabrániť pádom v hrách s vlastnými textúrami."

msgctxt "game_options"
msgid "Greatly inscrease the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Výrazne zvýši kvalitu textúr generovaných efektmi render-to-texture. Predvolene zapnuté. Vypnutie môže zabrániť pádom v hrách s vlastnými textúrami."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Hry so streľbou hrané na ovládači (bez svetelnej pištole). Relatívne: páčka pohybuje kurzorom. Absolútne: poloha páčky je poloha na obrazovke, po pustení sa vráti do stredu."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE je rýchle, LLE presnejšie, ale vyžaduje súbory ROM DSP."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START pošle kláves ukončenia (X) do Visual Pinball namiesto zatvorenia jeho okna."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START pošle kláves ukončenia (X) do Visual Pinball namiesto zatvorenia jeho okna: otvorí sa jeho menu (stôl sa ukončí so ZAKÁZAŤ MENU)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 rýchle uloženie, START+L3 rýchle načítanie, START+R3 snímka obrazovky. Predvolene zapnuté."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Hack potrebný pre niektoré hry (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Hack potrebný pre niektoré hry."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Polovičné scanlines napodobňujú CRT obrazovku. 560 x 192 dáva čistejší obraz na plochom paneli."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Radič pevného disku, potrebný na spustenie obrazov pevných diskov .hdv a .2mg. Zmena reštartuje stroj."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Predvolene skryté, vypnite, ak sa hra nespustí správne."

msgctxt "game_options"
msgid "Hide in-game crosshair (game dependant)."
msgstr "Skryť herný zameriavač (závisí od hry)."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Skryť model zbrane v hre (závisí od hry)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Skryť ukazovateľ na dotykovej obrazovke pri nečinnosti (časový limit)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Skryť tipy kompilácie shaderov a PPU."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Skryť zameriavač po chvíli bez mierenia alebo streľby. Vráti sa, hneď ako znova zamierite."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Skryť okraje obrazu ako televízor alebo pridať okraj (záporné hodnoty)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Skryť biely záblesk pri každom výstrele."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Vysokoúrovňová emulácia niektorých funkcií Portfolio OS. Môže zlepšiť výkon v niektorých hrách."

msgctxt "game_options"
msgid "High sound quality for games using expansion audio"
msgstr "Vysoká kvalita zvuku pre hry s rozširujúcim zvukom"

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "Vyššia presnosť opraví chyby v niektorých hrách za cenu výkonu. Použije sa iba vtedy, ak je dekodér SPU nastavený na Dynamic alebo LLVM."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "Vyššia snímková frekvencia vďaka interpolácii snímok, obmedzená vertikálnou synchronizáciou. Môže spôsobiť drobné vizuálne chyby alebo chyby animácie."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "Vyššie je presnejšie, ale pomalšie."

msgctxt "game_options"
msgid "Higher values give better signal noise ratio and preservation of higher frequencies."
msgstr "Vyššie hodnoty dávajú lepší pomer signálu k šumu a zachovanie vyšších frekvencií."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "Vyššie hodnoty používajú menej pamäte, nižšie bežia rýchlejšie."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Oprava rýchlosti House of the Dead 4: frekvencia CPU v GHz (napr. 4.3). Ak nie je nastavená, zistí sa automaticky."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Ako ďaleko sa musí páčka pohnúť, kým to Amiga zaregistruje. Zvýšte, ak sa postava pohybuje sama."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Ako rýchlo sa paddle pohybuje."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Ako rýchlo sa paddle pohybujú, keď sa myš používa ako zariadenie herného portu."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Akú časť šírky obrazovky prejde paddle od okraja k okraju. Menšia hodnota spraví paddle rýchlejší a umožní mu dosiahnuť dorazy bez toho, aby ukazovateľ opustil obrazovku, čo niektoré kalibračné obrazovky potrebujú."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Ako silno páčka reaguje."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Ako sa zobrazuje obrazovka TV a obrazovka GamePad."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Ako sa ovládač predstaví Amige."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Ako sa ovládač predstaví Amige. 'Joystick' je klasická 2-tlačidlová páka, ktorej rozumie každá hra. 'CD32 pad' pridáva farebné tlačidlá a na CD32 sa vyberie automaticky."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Ako sa obraz vykresľuje. RGB je najostrejšie, kompozitné a TV režimy reprodukujú presakovanie farieb displeja z tej doby."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Ako sa obraz vykresľuje. Kompozitné režimy reprodukujú presakovanie farieb displeja z tej doby, RGB je najostrejšie."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Ako sa obraz škáluje na obrazovku."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Hybridné hneď vykresľuje nové shadery, kým sa zostavujú. Asynchrónne môže na chvíľu nechať objekty chýbať. Synchrónne nechá hru čakať na každý shader."

msgctxt "game_options"
msgid "If Custom is selected it will use MesenPalette.pal as custom palette in bios directory."
msgstr "Ak je vybrané Vlastné, ako vlastná paleta sa použije MesenPalette.pal v adresári bios."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Ak je vypnuté, vypne vzor ditheringu, ktorý PSX používa proti farebnému pásikovaniu."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Ak je vypnuté, DualShock možno prepínať medzi DIGITÁLNY/ANALÓGOVÝ kombináciou tlačidiel."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Ak je vypnuté, tieto moduly sa skompilujú iba v prípade potreby. V závislosti od hry to môže neočakávane a možno často prerušovať hranie."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Ak je pripojených viac pištolí, nastavte túto možnosť na konfiguráciu iba jednej pištole."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Ak je to potrebné, určite GBA rom na použitie."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Ak názov priečinka obsahuje 'soniccd', RetroBat automaticky spustí Sonic CD RSDK; použite na vynútenie."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Ak je joystick v tejto mŕtvej zóne, kurzor sa nepohne."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Ak používate gamepad so snímaním pohybu, ako dualshock alebo switch pro, povoľte na použitie snímača pohybu."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Ak používate skutočné Wiimote so Sensor Bar, nastavte správnu polohu Sensor Bar pre lepšiu presnosť."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "Ignorovať služby Horizon OS, môže vyriešiť pády v niektorých hrách."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Ignorovať pohyb analógovej páčky pod týmto prahom."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "Ignorovať existujúce súbory ini v priečinku 'bios\mame\ini'."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Ignorovať malé pohyby páčky okolo stredu. Zvýšte, keď kurzor na obrazovke ubieha sám."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Ignorovať nastavenia backglass konkrétneho stola (súbor .res vedľa stola) počas hry. Súbor sa ponechá a pri ukončení obnoví."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Ignorovať nastavenia pre každú hru uložené v shadPS4 a vždy použiť nastavenia RetroBat."

msgctxt "game_options"
msgid "Improve performance at the cost of accuracy and input lag."
msgstr "Zlepšiť výkon za cenu presnosti a oneskorenia vstupu."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Zlepšiť výkon pre CPU s viac ako 4 jadrami, predvolene zapnuté."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Zlepší výkon v mnohých hrách. Vypnutie môže zabrániť grafickým chybám v niektorých iných hrách."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "Zlepšiť vykresľovanie polygónov s rendererom OpenGL."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Zlepšiť presnosť shaderov. Vypnutie dá malý nárast rýchlosti, ale môže spôsobiť grafické chyby v niektorých hrách."

msgctxt "game_options"
msgid "Improve the loading of discs of the emulated game."
msgstr "Zlepšiť načítanie diskov emulovanej hry."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements."
msgstr "Zlepšiť rozlíšenie za cenu vyšších nárokov na výkon."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Zlepšiť rozlíšenie za cenu vyšších nárokov na výkon. Iba OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Zlepšiť rozlíšenie za cenu vyšších nárokov na výkon. Vyžaduje kľúč Redream."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Zlepšiť rozlíšenie za cenu vyšších nárokov na výkon. Iba Vulkan a OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Zlepší presnosť v niektorých hrách, ale môže znížiť výkon."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Zlepší farebnú hĺbku."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Zlepší výkon v niektorých hrách, ale preskočí všetky efekty založené na EFB."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Zlepší výkon."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Zlepší výkon. Na viacerých konzolách experimentálne."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Zlepší stabilitu v niektorých hrách, ale zníži výkon."

msgctxt "game_options"
msgid "Improves the data loading speed."
msgstr "Zlepší rýchlosť načítania dát."

msgctxt "game_options"
msgid "Improves the emulation performance at the cost of accuracy."
msgstr "Zlepší výkon emulácie za cenu presnosti."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Iba v OpenGL."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "Pri hrách na viacerých diskoch so súborom .m3u určite číslo disku na spustenie."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "Zvýšiť presnosť, môže opraviť niektoré problémy so zvukom a rýchlosťou."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Zvýšte, ak sa výstrely registrujú mierne mimo cieľa."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Zvýšte, ak sa pohľad alebo hráč pohybuje sám."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Zvýšte, ak sa pohľad alebo hráč pohybuje sám. Predvolene 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Zvýšiť rozlíšenie OpenGL 3DFx Voodoo."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Zvýšiť počet spritov, ktoré sa dajú naraz vykresliť na obrazovke."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Zvýši využitie RAM a čas prvého spustenia, ale zníži čítanie z disku po spustení."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "Zvýšenie hodnoty môže spôsobiť chyby."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Inicializuje farebné ciele vykresľovania z emulovanej pamäte. Niektoré hry to potrebujú na správne vykreslenie, môže znížiť výkon. Predvolene vypnuté."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Inicializuje hĺbkové ciele vykresľovania z emulovanej pamäte. Niektoré hry to potrebujú na správne vykreslenie, môže znížiť výkon. Predvolene vypnuté."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Zadajte server vo formáte 'x.x.x.x:y'."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Vložiť rozšírenie MoonSound do slotu I/O."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Vložiť rozšírenie Video9000 do slotu I/O."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Vložiť disk do disketovej mechaniky, často sa používa pre hry na CDROM."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Nainštalovaný video čip. Automaticky použije TMS9918A, pokiaľ hra nevyžaduje vylepšenie F18A. Vyžaduje reštart jadra."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Interpoluje zvukový výstup pre lepšiu kvalitu."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "Interpreter má lepšiu kompatibilitu ako dynamický rekompilátor JIT, JIT je rýchlejší."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Prehodiť tlačidlá A/B a X/Y."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Invertovať signál svetelného senzora Zappera. Potrebné pre niektorý hardvér pištolí."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Invertovať signál spúšte Zappera. Potrebné pre niektorý hardvér pištolí."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Invertovať vertikálnu os pravej analógovej páčky gamepadu."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "Invertovať ovládanie zameriavača hore a dole."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Invertuje pozeranie hore a dole (gamepad a myš)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Invertuje pozeranie hore a dole gamepadom."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Invertuje pozeranie hore a dole pravou páčkou."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Invertuje vertikálnu os pri lietaní."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT je najrýchlejší, interpreter presnejší."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Kompilácia Just In Time. Výrazne zrýchli 68020 a novšie modely. Na strojoch 68000 sa ignoruje a v režime presnosti cyklov sa automaticky vypne."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Ponechať shell DOS aktívny po ukončení hry alebo pri neúspešnom spustení."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Ponechať alebo odstrániť súbory hry po rozbalení (squashfs, 7z)"

msgctxt "game_options"
msgid "Keep the CD image in memory."
msgstr "Ponechať obraz CD v pamäti."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Zachovať pôvodný pomer strán namiesto roztiahnutia obrazu."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Kláves, ktorý otvorí vlastné menu Amiberry. F12 je jediný funkčný kláves, ktorý Amiga nikdy nemala, preto je to jediný, ktorý ostáva voľný."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Kláves na prepínanie medzi oknom a celou obrazovkou počas emulácie."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Klávesy používané ako joystick, keď nie je pripojený ovládač. So šípkami sa strieľa pravým Ctrl. S numerickou klávesnicou 0 alebo 5. S WASD ľavým Alt."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 a R3 vykonajú špeciálne údery aktuálnej postavy, ak ich hra uvádza. Predvolene zapnuté."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = Service, R3 = Test, na otvorenie menu operátora v hrách. Predvolene zapnuté."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "LLVM je najrýchlejší, pri problémoch použite nastavenia interpretera."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "LLVM je najrýchlejšia možnosť s veľmi dobrou kompatibilitou. Pri problémoch použite rekompilátor ASMJIT."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "Jazyk, v ktorom majú hry zobrazovať text."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Jazyk menu a textu v hre. Jazyk, ktorý hra nemá, sa ignoruje a ponechá sa nastavenie hry."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Jazyk titulkov. Jazyk, ktorý hra nemá, sa ignoruje a ponechá sa nastavenie hry."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Jazyk hlasov. Jazyk, ktorý hra nemá, sa ignoruje a ponechá sa nastavenie hry."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Veľké zrýchlenie na viacjadrových CPU, ale malý počet hier sa s tým zasekne."

msgctxt "game_options"
msgid "Launch DemulShooter for gun games."
msgstr "Spustiť DemulShooter pre hry so svetelnou pištoľou."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Spustiť MameHooker na správu výstupov."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Ponechajte 'Auto', pokiaľ detekcia nezlyhá."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Ponechajte AUTO ako predvolené, pokiaľ hra nevyžaduje konkrétne nastavenie."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Ponechajte AUTO na automatickú detekciu."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Ponechajte auto na automatické prispôsobenie orientácii hry, toto nastavenie použite na vynútenie, ak je to potrebné."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Ponechajte vypnuté, pokiaľ zdroj synchronizácie nie je video: vsync a synchronizácia zvuku spolu fungujú zle."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Ponechajte na AUTO, aby emulátor vybral prvý platný BIOS nájdený v '\bios\pcsx2\bios'."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Ponechajte na Automaticky, aby sa zachoval procesor, ktorý vybraný model skutočne mal. Rýchlejší CPU môže pokaziť hry závislé od presného časovania."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Ponechajte na Automaticky, pokiaľ hra nepotrebuje konkrétnu ROM. Súbor musí byť v priečinku bios. Vyžaduje reštart jadra."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Ponechajte predvolene ZAPNUTÉ na povolenie optimalizácií CPU JIT."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Ponechajte 16:9, pokiaľ nemáte monitor 4:3."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Ponechajte predvolene zapnuté, na vykresľovanie sa použije viac vlákien."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "MANUÁLNE nezmení hodnotu nastavenú používateľom, AUTO je 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "Vľavo sa stane vpravo a hore dole."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Nechať ALTIRRA vybrať profil podľa hry."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Nechať RetroArch priradiť ovládače vlastnými profilmi automatickej konfigurácie namiesto priradenia RetroBat. Prepíše automatickú konfiguráciu RetroBat."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Nechať RetroBat pokúsiť sa získať zavádzaciu sekvenciu zo súboru hash MAME alebo z názvu súboru (zátvorky)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Nechať RetroBat pokúsiť sa získať zavádzaciu sekvenciu zo súboru hash MAME."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Nechať Visual Pinball samotný prepnúť na vybraný video režim namiesto zmeny rozlíšenia pracovnej plochy."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Umožní ROM kazety MegaWiFi pristupovať k vašej sieti a internetu. Povoľte iba pre ROM, ktorým dôverujete."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Nechá jadro, aby si samo udávalo tempo, namiesto spoliehania sa na RetroArch. Ak hra PAL beží nerovnomerne, skúste 'standard 50 Hz'."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Umožní emulátoru spätne čítať pamäť GS. Predvolene zapnuté. Vypnutie je rýchlejšie, ale môže pokaziť niektoré grafické efekty."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Umožní ľavej páčke fungovať ako joystick popri D-pade."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Zrušiť obmedzenie snímkovej frekvencie hry, kde to hra umožňuje. Čokoľvek iné ako pôvodné môže hru pokaziť."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Prepojiť 2 až 4 Lynx káblom ComLynx na jednej obrazovke, každý s jedným ovládačom. Vypne ukladanie stavov a úspechy."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Načítať vlastný profil na priradenie volantu."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Načítať módy (súbory .dusk) z priečinka s názvom hry vedľa nej alebo z dusklight\data\mods, ak taký nie je."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Načítať módy z priečinka User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Načítať módy umiestnené v priečinku mods hry (jeden priečinok s mod.ini na mód). Predvolene zapnuté."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Načíta predvoľbu kvality grafiky (textúry, filtrovanie, jemné častice). Ponechajte na AUTO na zachovanie nastavení hry."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Načíta prvé dva disky hry na viacerých diskoch naraz do mechaniky 1 a mechaniky 2 namiesto iba do mechaniky 1. Potrebné pre niekoľko hier, ktoré žiadajú dve mechaniky."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Načíta náhradné textúry z Data\Assets\HDTextures\<rom> v priečinku emulátora."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Načíta celý obraz disku do pamäte. Rýchlejšie načítanie, vyššie využitie RAM."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Nízka kvalita shaderov môže zlepšiť výkon, ale spôsobiť chyby."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Nižšie znamená menšie oneskorenie, príliš nízke spôsobí výpadky zvuku."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Znížiť presnosť GS, aby sa predišlo medzerám medzi pixelmi pri škálovaní. Opraví text Wild Arms a duchov v SoulCalibur."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Nižšie hodnoty znížia oneskorenie zvuku, vyššie znížia praskanie."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "Úroveň MSAA alebo SSAA."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Časovanie stroja. 60Hz je americký stroj, 50Hz európsky. Niekoľko európskych programov potrebuje 50Hz na správnu rýchlosť. Zmena reštartuje stroj."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Hlavná pamäť. Auto použije RAM modelu alebo databázu hier. Nepodporované veľkosti sa zaokrúhlia na ďalšiu veľkosť modelu."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "Výrazne zrýchli režim warp prepnutím emulácie SID na 'FastSID' počas warpu."

msgctxt "game_options"
msgid "Makes the emulator auto fast forward CD loading sequences."
msgstr "Emulátor automaticky zrýchli sekvencie načítania CD."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Ručne priradiť ovládač, ktorý používa hráč. Potrebné iba vtedy, keď RetroBat nedokáže rozlíšiť dva rovnaké ovládače, napríklad s arkádovým enkodérom pre 2 hráčov, ktorý Windows vidí ako jedno zariadenie. Inak ponechajte na AUTO."

msgctxt "game_options"
msgid "Manually select a 4 Player Adapter for some games"
msgstr "Ručne vybrať adaptér pre 4 hráčov pre niektoré hry"

msgctxt "game_options"
msgid "Manually specify your choice of Neo Geo BIOS."
msgstr "Ručne určiť zvolený BIOS Neo Geo."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Mnoho hier potrebuje kópie iba do textúr, ale ak vidíte začiernenú alebo chýbajúcu grafiku, možno budete musieť zvoliť kópie do RAM."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Priradiť 8BitDo M30 alebo podobný ovládač tlačidlo po tlačidle podľa mdControllers.json."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Priradiť ovládač ako závodný ovládač, hry nekompatibilné so závodným volantom nebudú fungovať."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Priradiť select na ďalšie tlačidlo, užitočné pre hru Zelda, aby ste pri ukladaní neodchádzali."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Priradí spúšte na vertikálnu os analógovej páčky. Užitočné pre Gran Turismo a iné závodné hry."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Prispôsobí farby tomu, ako vyzerajú na skutočnom hardvéri."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Matematický koprocesor. Používa ho iba hŕstka titulov Amiga a jeho pridanie do stroja, ktorý ho nikdy nemal, môže zmiasť niekoľko hier."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Maximálna rýchlosť dotykového kurzora joysticku."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "Maximálny počet vlákien CPU na škálovanie textúr. Použite celkový počet vlákien mínus 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Môže spôsobiť artefakty v niektorých hrách."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Môže zlepšiť výkon na niektorých procesoroch s mnohými jadrami. V niektorých situáciách môže spôsobiť spomalenie kvôli záťaži ďalšieho pracovného vlákna."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Môže znížiť sekanie za cenu dlhšieho čakania na spustenie hry."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Metóda pre prekladané video režimy (nepoužíva sa na Nintendo 64)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Metóda pre prekladané video režimy."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "Metóda čítania dát z disku: synchrónne napodobňuje pôvodný hardvér, asynchrónne môže znížiť sekanie, pre-cache načíta celý obraz za cenu počiatočného oneskorenia."

msgctxt "game_options"
msgid "Might fix some misaligned fog, bloom or blend effect."
msgstr "Môže opraviť nezarovnané efekty hmly, bloom alebo miešania."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Napodobňuje niektoré famiclony, ktoré prehadzujú duty cycle štvorcových kanálov."

msgctxt "game_options"
msgid "Mimics the display characteristics of the Game Gear and Nomad LCD panels."
msgstr "Napodobňuje charakteristiky zobrazenia LCD panelov Game Gear a Nomad."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "Mipmapping je pre niektoré hry nevyhnutný."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Zrkadliť svet vodorovne, ako vo verzii hry pre Wii."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C je zvuková karta podporovaná väčšinou hier. Mouse Card vyberte iba pre softvér, ktorý potrebuje skutočnú myš Apple, nahradí zvukovú kartu. Zmena reštartuje stroj."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard je zvuková karta podporovaná väčšinou hier. Na modeloch //c, ktoré nemajú rozširujúce sloty, sa ignoruje."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Režim predvolený na obrazovke výberu hráčov. Download Play vyžaduje pôvodný BIOS a firmvér."

msgctxt "game_options"
msgid "Modify the coin setting to Free Play."
msgstr "Zmeniť nastavenie mincí na Free Play."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "Monochromatické vyžadujú hry s vysokým rozlíšením (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Presnejšia emulácia CD block. Vyžaduje ROM CD block a vypne nastavenie rýchlosti čítania."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "Presnejšie správanie, ale môže znížiť výkon. Predvolene ZAPNUTÉ."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "Väčšina hier používa port 2, toto nastavenie použite pre staré hry, ktoré vyžadujú joystick zapojený v porte 1."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Automaticky pripojiť jednotku C: pri spustení."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Myš: hry ako Elansar alebo Defender of the Crown. Analógová páčka: BattleSphere, vyberte ju aj v možnostiach hry."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Pohybovať myšou analógovou páčkou ovládača 1 (L2/R2 = tlačidlá). Jeden port musí byť nastavený na Myš."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Pohyb ľavou analógovou páčkou aj D-padom. Predvolene zapnuté."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level."
msgstr "Úroveň viacvzorkového vyhladzovania hrán (MSAA)."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Úroveň viacvzorkového vyhladzovania hrán (MSAA). Iba OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Úroveň viacvzorkového vyhladzovania hrán (MSAA). Iba Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Násobič rýchlosti kurzora joysticku, kým je podržané tlačidlo zrýchlenia ukazovateľa (predvolene L2)."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "Multitap musí byť nastavený, ak majú hrať viac ako 2 hráči."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Stlmiť mechanický hluk disketových mechaník."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "NIE zobrazí iba obraz ľavého oka. Anaglyf vyžaduje 3D okuliare rovnakých farieb, vedľa seba je pre VR headsety a 3D displeje."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC používa cdi200.rom, PAL používa cdi220b.rom."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Natívne rozlíšenie hry. Predvolene to, ktoré je nastavené v hre."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Potrebné pre niekoľko hier vrátane viacerých titulov point and click."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "Na spustenie hry nie je potrebná minca."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Počet emulovaných disketových mechaník. Skutočná Amiga 500 mala iba jednu. Dve mechaniky zrýchlia hry na viacerých disketách, ale niekoľko titulov očakáva iba jednu."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Počet snímok medzi stlačeniami turbo."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Predvolene vypnuté. Adaptívne nečaká na displej, keď snímka mešká."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Predvolene vypnuté: emulátor sám beží arkádovou rýchlosťou (57.5 Hz). Zapnite, ak sa obraz trhá."

msgctxt "game_options"
msgid "Offset for the ST/UV texture coordinates."
msgstr "Posun pre súradnice textúr ST/UV."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "Na monitore 120Hz alebo rýchlejšom bez G-Sync či FreeSync použite jeho najvyššiu obnovovaciu frekvenciu, ktorá je násobkom 60Hz."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Predvolene zapnuté, vypnite na použitie kvality zvuku 11khz."

msgctxt "game_options"
msgid "On by default."
msgstr "Predvolene zapnuté."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Predvolene zapnuté. Vypnite na zvýšenie rýchlosti na integrovaných grafických kartách."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Predvolene zapnuté. Vypnite, keď má pištoľ vlastné mierenie (laser, zameriavač Sinden)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Jeden pixel na herný pixel (odporúčané pre shadery)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Platí iba pri zapnutom škálovaní textúr (xBRZ). Textúry väčšie ako táto hodnota sa nebudú škálovať."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Kompatibilné iba so systémom MVS ÁZIA/JAPONSKO."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Kompatibilné iba s OpenGL, tvrdá synchronizácia GPU a CPU. Zníži oneskorenie za cenu vyšších nárokov na výkon."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Kompatibilné iba so softvérovým video ovládačom."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Účinné iba vtedy, keď je OBMEDZIŤ FPS zapnuté. Predvolene: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Iba pre ázijské verzie hier."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Iba pre novšie verzie Ikemen GO. Vulkan je experimentálny."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Škálovať sa budú iba framebuffery väčšie ako táto veľkosť, môže opraviť niektoré problémy v určitých hrách."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Obmedzovač snímok použite iba vtedy, ak hra bez neho beží príliš rýchlo. Niektoré hry môžu pri príliš vysokej snímkovej frekvencii spadnúť. V takom prípade nastavte akúkoľvek hodnotu okrem Vypnuté."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Použite iba vtedy, ak máte dva rovnaké ovládače, ktoré sa nezistia správne. Priradí ovládače podľa pozície namiesto názvu, čo je menej spoľahlivé."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Použite iba na zmenšenie okna pri používaní škálovania v nastaveniach Windows."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Použije sa iba ak je nastavené — pre P2 sa nepredpokladá žiadny predvolený obrázok zameriavača."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Použije sa iba vtedy, keď je vybrané výstupné zariadenie MIDI."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Verzia motora OpenBOR na spustenie hry. Auto ju zistí z dát hry alebo z čísla zostavy [XXXX] v názve súboru ako pri samostatnom OpenBOR."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "Pre shadery a vnútorné rozlíšenie je potrebný OpenGL."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Iba OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Iba OpenGL. Opraví čiernu obrazovku na niektorých integrovaných GPU AMD, niekoľko hier sa vykreslí nesprávne."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Otvorí druhé okno pre zobrazenie Gamepad."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Voliteľná zvuková doska (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) alebo subwoofer (hry Gaelco). Predvolene mix, pre Star Wars Racer Arcade iba hlavná doska."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "Pretaktovať CPU, čip SA-1 a čip Super-FX, môže znížiť spomalenia, ale spôsobiť problémy v niektorých hrách."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Pretaktovať alebo podtaktovať oba CPU SH-2. 100 je štandardná rýchlosť."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Pretaktovať alebo podtaktovať emulovaný hlavný CPU. Môže stabilizovať snímkovú frekvenciu, ale pokazí niektoré hry."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Pretaktovať emulovaný čip 68k pre lepšiu snímkovú frekvenciu."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "Prepísať priradenie gamepadu RetroBat vlastným priradením používateľa umiestneným v priečinku script emulátora."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Prepísať predvolené osvetlenie stola."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL beží na 50 Hz a je správny takmer pre každý európsky titul Amiga. NTSC beží na 60 Hz a hodí sa pre hŕstku amerických vydaní."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 identifikuje ovládače vlastným číslom slotu, ktoré nezodpovedá poradiu hráčov RetroBat. Automaticky vezme prvý, ktorý nájde; zmeňte, ak reaguje nesprávny ovládač."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "Upraviť súbor TOS pre rýchlejšie spustenie."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Cesta k priečinku s AGS WinUAE; ak je vyplnená, RetroBat pridá spúšťač ags do systému amiga."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Cesta k priečinku s ExoDos, povinná, aby RetroBat mohol prehľadať hry ExoDOS."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Cesta k priečinku s ExoWin3x, povinná, aby RetroBat mohol prehľadať hry ExoWin3x."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Cesta k priečinku s ExoWin9x, povinná, aby RetroBat mohol prehľadať hry ExoWin9x."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Pre každú hru: každá hra má vlastnú pamäť konzoly 8 KB, takže sa nikdy nezaplní. Zdieľaná: jedna pamäť pre všetky hry, ako na skutočnom prehrávači."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Osvetlenie po pixeloch namiesto po vrcholoch. Zlepší kvalitu v niektorých hrách."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Zvýšenie výkonu, môže priniesť aj stabilitu niektorým hrám ako GT6."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Umiestnite vlastný obrázok zameriavača a vyberte ho nižšie."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Umiestnite vlastný súbor 'crosshair.png' do podpriečinka 'cross' emulátora alebo vyberte súbor nižšie."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Umiestnite vlastný súbor 'crosshair.png' do podpriečinka 'cross' emulátora."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: zatlačte páčku hore na stúpanie (v automate sa stúpa s páčkou pritiahnutou dozadu)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "Hrať hry MVS bez potreby vhadzovať mince."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Prehrať varovné pípnutie pri nízkom zdraví."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Prehrávať pípania VMU."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Hrať iba so skutočnými wiimote, iné ovládače nebudú fungovať."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Počet hráčov predvolený na obrazovke výberu hráčov pri spustení."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Zapojiť RetroPady do rôznych portov, užitočné pre adaptéry pre 4 hráčov."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Zapojiť myš do joyportu, tým sa odpoja zapojené joysticky."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "Zapojiť ďalšie joysticky do portov 2, 3 a 4."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "Zapojiť GunCon do portu 2, na použitie v Die Hard Trilogy."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Zapojí MIDI dosku a pošle jej výstup do tohto MIDI zariadenia Windows, číslovaného ako v možnostiach MIDI emulátora. ŽIADNE ponechá štandardný FM zvuk."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Nasmerovať adresár 'system' RetroArch do iného priečinka."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Port 1 je vždy Wii U GamePad. Pre hry, ktoré ho potrebujú, sa dá navyše pridať Wii Remote."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Port Light Phaser. Predvolene port 1."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Port Super Scope. Predvolene port 2."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Port Zappera. Predvolene port 2."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Potenciálne zníži čas načítania za cenu dlhšieho spustenia."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "Rekompilátor PowerPC, predvolene zapnutý a oveľa rýchlejší. Vypnite na použitie interpretera."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Predkompilovať cache shaderov pri spustení hry, ponechajte ZAPNUTÉ pre menej sekania v hre."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "Presné je najpresnejšie a uvoľnené môže zvýšiť výkon, ale pokaziť niektoré hry."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Preferovaný región. Hra, ktorá ho neprijme, sa vráti na taký, ktorý prijme."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Prednačítať všetky stopy CD do RAM."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Prednačítať vlastné textúry pri spustení."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Stlačením sa otvorí menu Amiberry."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Stlačením sa resetuje Amiga."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Stlačením sa zobrazí klávesnica na obrazovke."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Zabráni niektorým artefaktom, ale môže viesť k ostrým hranám."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Zabráni preťaženiu zmiešaného zvuku viacerých hráčov."

msgctxt "game_options"
msgid "Processor model."
msgstr "Model procesora."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Model procesora. CPU rýchlejší ako skutočný stroj môže pokaziť hry závislé od presného časovania."

msgctxt "game_options"
msgid "Provider for the Adlib emulation. DEFAULT has good quality and low perf requirements."
msgstr "Poskytovateľ emulácie Adlib. PREDVOLENÉ má dobrú kvalitu a nízke nároky na výkon."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Zapojí ovládač hráča 1 do portu 1 namiesto portu 2. Potrebné pre niekoľko hier vrátane viacerých titulov point and click."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Vylepšenia pohodlia: rýchla premena, väčšie peňaženky, rýchle šplhanie, okamžité ukladanie, automatické ukladanie, vylepšené menu mapy... Klasické zodpovedá hre na GameCube. Nenastavené: ponechajú sa nastavenia menu Dusklight."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD AKO KLÁVESNICA: D-pad posiela šípky a tlačidlá SPACE / RETURN, pre hry bez podpory joysticku."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "Predvolene BEH, tlačidlom behu sa chodí."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "ReShade používa RetroBat na zobrazenie rámčekov a shaderov v niektorých samostatných emulátoroch. ZAKÁZANÉ: rámčeky sa zobrazujú cez prekryvné okno. POUŽIŤ VLASTNÉ: RetroBat nikdy neinštaluje, neupravuje ani neodstraňuje súbory ReShade v priečinkoch emulátorov."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Čítať výsledky render-to-texture na CPU. Niektoré hry to môžu potrebovať, ale spôsobuje to synchronizáciu v strede snímky, takže to má obrovský vplyv na výkon."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Čítať disk rýchlejšie ako mechanika konzoly. Niektoré hry to nemusia očakávať."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Čítať súbor ini v podpriečinku 'bios'."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Čítať súbor ini v priečinku 'bios\mame\ini'."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "Skutočná rýchlosť Amigy je bezpečné predvolené nastavenie. Turbo načíta rýchlejšie, ale môže pokaziť niekoľko zavádzačov a ochrán proti kopírovaniu."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Plugin Reality Signal Processor, vynútený na LLE, keď je video ovládač nastavený na Parallel."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Plugin Reality Signal Processor."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Odporúčané: lineárne, keď je škála druhej obrazovky pod 100%."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "Rekompilátor je najrýchlejší, interpreter presnejší."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "Rekompilátor je oveľa rýchlejší, interpreter je užitočný iba na ladenie. Vyžaduje reštart."

msgctxt "game_options"
msgid "Recover significant color depth."
msgstr "Obnoviť výraznú farebnú hĺbku."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "Znížiť presnosť pre lepší výkon, kvalita grafiky bude nižšia."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Znížiť rýchlosť analógového ovládania, niektoré hry vyžadujú nízke hodnoty, aby sa dali hrať."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Skrátiť časy načítania. Môže pokaziť niekoľko hier, ktoré sa spoliehajú na skutočné časovanie disku."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Znížiť sekanie za cenu oveľa dlhšieho čakania na spustenie hry a vysokého zaťaženia GPU."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Zníži využitie VRAM za cenu kvality, môže zvýšiť sekanie."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Zníži cvakanie spôsobené veľkými zápismi do kanála DMC. Nepresné, môže zjemniť niektoré vzorkované zvuky."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Zníži praskanie a sekanie, ale na pomalších CPU môže výrazne znížiť kvalitu zvuku; ponechajte AUTO na vypnutie."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Zníži blikanie."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Zníži sekanie a zrýchli spustenie po prvom spustení."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Zníži kmitanie polygónov a deformáciu textúr v 3D hrách."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "Podpora prehrávania MPEG ReelMagic."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Dopĺňať opasok elixírmi z inventára."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "Obnoviť stav stránok pamäte na povolenie dát zapísaných GPU. (Použite pre hry 'Team Ninja' na opravu chýbajúcich modelov postáv.)"

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Región firmvéru NEC PAC. Japonsko: pac-n1.bin alebo pce-lp1.bin. USA: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Región vybraný ako prvý na viacregionálnych diskoch."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 1."
msgstr "Premapovať schému bočných tlačidiel pre hráča 1."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 2."
msgstr "Premapovať schému bočných tlačidiel pre hráča 2."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Odstrániť okraje n pixelov hore a dole na obrazovke."

msgctxt "game_options"
msgid "Remove odd composite green/blue artifacting that appears on real hardware."
msgstr "Odstrániť zvláštne zeleno-modré kompozitné artefakty, ktoré sa objavujú na skutočnom hardvéri."

msgctxt "game_options"
msgid "Remove the original sprites-per-scanline hardware limit."
msgstr "Odstrániť pôvodný hardvérový limit spritov na riadok."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Odstrániť bočné čierne pruhy v niektorých animáciách (ultraširoké obrazovky). Oblasti mimo pôvodného rámca môžu vyzerať chybne."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Odstrániť horné a dolné čierne pruhy pri zameriavaní, mierení, animáciách a dialógoch."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Odstrániť biely záblesk zobrazený pri streľbe."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Odstráni jednu snímku oneskorenia vstupu, ale zdvojnásobí systémové nároky."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Odstráni čierne okraje okolo obrazu Amigy. Silnejšie nastavenia orežú viac a môžu odrezať okraje niekoľkých hier."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Odstráni blikanie obrazu v Hummer."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Odstráni biely záblesk zobrazený, keď hry vypnú 3D vykresľovanie."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Vykresľovať v násobku natívneho rozlíšenia N64. Prepíše nastavenie vnútorného rozlíšenia, keď nie je VYPNUTÉ."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Vykresľovať Gouraudovo tieňovanie v plnej presnosti na zníženie farebného pásikovania v 3D hrách."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "Cesta emulácie render target. rtv/fbo ponúka lepší výkon, rov/fsi najvyššiu presnosť."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Rozlíšenie vykresľovania pre vektorové hry."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Vykresľuje v 24-bitových farbách a odstráni dithering."

msgctxt "game_options"
msgid "Replace meshed transparency by real transparency."
msgstr "Nahradiť mriežkovú priehľadnosť skutočnou priehľadnosťou."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Nahradiť pôvodné textúry balíkom vlastných textúr (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack in 'bios\dc\textures'."
msgstr "Nahradiť pôvodné textúry balíkom vlastných textúr v 'bios\dc\textures'."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack."
msgstr "Nahradiť pôvodné textúry balíkom vlastných textúr."

msgctxt "game_options"
msgid "Replaces game's sprites by HD pack available in HdPacks bios directory."
msgstr "Nahradí sprity hry HD balíkom dostupným v adresári bios HdPacks."

msgctxt "game_options"
msgid "Replaces post-processing multiple paving sprites by a single fat sprite."
msgstr "Nahradí viaceré dláždiace sprity postprocesingu jedným veľkým spritom."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Reprodukuje dolnopriepustný filter skutočného hardvéru. 'Emulované' sa riadi vlastným prepínačom filtra stroja."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Požadovať konkrétny slot(y), vyberte možnosť KONKRÉTNY SLOT vyššie."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "Vyžadujú programy BASIC. Použije ATARIBAS.ROM, ak je k dispozícii, inak vstavaný Altirra BASIC."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Potrebné pre hry Formula One."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Potrebné pre Paper Mario: The Thousand-Year Door."

msgctxt "game_options"
msgid "Required for certain games that use hi-res mode to produce transparency effects."
msgstr "Potrebné pre niektoré hry, ktoré používajú režim hi-res na efekty priehľadnosti."

msgctxt "game_options"
msgid "Required for certain visual effects."
msgstr "Potrebné pre niektoré vizuálne efekty."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Potrebné, aby skratka pretáčania späť niečo robila."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Potrebné na spustenie hry bez pohyblivej kabíny Cycraft."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Potrebné na opravu Def Jam Icon."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Potrebné na spustenie niektorých starých rom hackov, pre komerčné hry ponechajte vypnuté."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Vyžaduje aspoň '4X SSAA (USPORIADANÉ)'. Režimy 4x vyžadujú '16X SSAA (USPORIADANÉ)'."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Rozlíšenie emulovaného video výstupu."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "Rešpektovať hodnoty bitu Non-Java Mode pre vektorové operácie v backendoch PPU. Ak si nie ste istí, nemeňte. Predvolene vypnuté."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Krivka odozvy dotykového kurzora joysticku."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "RetroBat nastaví iba ovládač hráča 1."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "RetroBat bude synchronizovať priečinky uložení dolphin a libretro-dolphin."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "RetroBat predvolene používa BIOS psxonpsp, povoľte túto možnosť na vynútenie starého súboru bios SCPH550X."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Znova použiť cache shaderov zostavenú pre hru. Auto nechá rozhodnúť emulátor."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Výber prevodového stupňa pravou páčkou v závodných hrách so 4 stupňami. H-gate: uhlopriečky ako v skutočnej prevodovke. Smery: hore 1, dole 2, vľavo 3, vpravo 4. L1/R1 vždy podradia/preradia."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Otočiť obraz a ovládanie. Predvolene sa známe hry otočia automaticky. MANUÁLNE: SELECT mení otočenie."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "Otočiť obraz pre vertikálne hry, povoľte na použitie s mega-bezel."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Otočiť obraz pre vertikálne hry."

msgctxt "game_options"
msgid "Rotate display for vertical screen."
msgstr "Otočiť obraz pre vertikálnu obrazovku."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "Otočiť obraz, môže byť užitočné pre konkrétne hry, ktoré potrebujú vertikálnu obrazovku."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Otočiť akčné tlačidlá na zmenu rozloženia."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Otočiť obrazovku Windows hracej plochy počas hrania, pri ukončení sa obnoví (Visual Pinball 10.8 a novší)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Otočiť výstup, pre vertikálne strieľačky."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Rotácia použitá na koncoch mávnutia."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Bežať maximálnou rýchlosťou, kým sa hra na CD-ROM načítava na nehybnej tichej obrazovke."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Bežať maximálnou rýchlosťou počas načítavania disku alebo pásky, keď sa neprehráva zvuk. Pre disky je potrebná VERNÁ EMULÁCIA MECHANIKY."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Bežať na pôvodných 57,524 Hz namiesto 60 Hz. Na obrazovke 60 Hz môže sekať."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Predvolene beh, tlačidlom behu sa chodí. Predvolene zapnuté."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Predvolene beh, tlačidlom behu sa chodí. V hre jedného hráča spotrebúva výdrž."

msgctxt "game_options"
msgid "Run games faster. A powerful option for gaining performance that has no downsides some of the time. May cause various random issues caused by splitting the CPU and GPU threads onto different cores."
msgstr "Hry bežia rýchlejšie. Silná možnosť na zvýšenie výkonu, ktorá často nemá nevýhody. Môže spôsobiť rôzne náhodné problémy rozdelením vlákien CPU a GPU na rôzne jadrá."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "Spustiť systém s BIOSom a funkciami G7400."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Zrýchliť GPU a DSP. Môže zvýšiť snímkovú frekvenciu 3D hier, ale spôsobiť chyby."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Spustiť dva prepojené Game Gear vedľa seba. Hráči 1 a 2 ovládajú obrazovky 1 a 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Bežať bez držania tlačidla behu."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "Spustí 'jgenesis-gui.exe' namiesto verzie cli."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "Predvolene SDL gamepad: číta gamepady so štandardným rozložením a ostatné zariadenia (volanty, radiace páky, arkádové enkodéry) ich surovými tlačidlami. SDL číta každé zariadenie surovo."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT používa soundfont Roland SC-55 dodávaný s RetroBat."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "SSAA ponúka lepšiu kvalitu za cenu výkonu."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "ROZTIAHNUŤ vyplní celú obrazovku a vypne rámčeky."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Uložiť stav hry pri odchode a obnoviť ho pri ďalšom spustení (jeden súbor na hru)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "Uloženia idú do kópie v priečinku saves, pôvodný obraz sa nikdy nezmení. Reset začne znova z pôvodného disku (stará kópia sa ponechá ako .bak)."

msgctxt "game_options"
msgid "Saves the hiscores in supported games."
msgstr "Ukladá rekordy v podporovaných hrách."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Škála stavového riadka na obrazovke."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Škálovať obraz iba celými číslami, pre ostré pixely."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Škálovať obraz iba celými číslami, pre ostré pixely. Iba celá obrazovka 1080p alebo 4K na obrazovke 16:9, s miernym orezaním hore a dole."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Škáluje súradnice X vzhľadom na stred obrazovky. Znížte, ak výstrely na okrajoch dopadajú príliš ďaleko od zameriavača."

msgctxt "game_options"
msgid "Scales the dithern pattern to the resolution scale of the emulated GPU."
msgstr "Škáluje vzor ditheringu podľa škály rozlíšenia emulovanej GPU."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "Scanlines nie sú kompatibilné so shadermi HQ alebo xBRZ."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Scanlines, tieňová maska a žiara luminoforu katódovej trubice."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "Rotácia obrazovky nie je kompatibilná s vodorovným rozložením."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Obrazovka pre DMD na vyhradenej obrazovke, rovnaké číslovanie ako INDEX MONITORA. AUTO použije najmenšiu zostávajúcu obrazovku. Vyžaduje NASTAVENIE OBRAZOVIEK s 3 obrazovkami."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Obrazovka pre backglass, rovnaké číslovanie ako INDEX MONITORA. AUTO použije najväčšiu obrazovku okrem hracej plochy. Vyžaduje NASTAVENIE OBRAZOVIEK."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Obrazovka na zobrazenie hier (0 = hlavná obrazovka). AUTO nechá emulátor vybrať si obrazovku."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Obrazovky, ktoré používa pinball (Visual Pinball 10.8 a novší). Pozície backglass a DMD sa potom vypočítajú automaticky. Nenastavené: použijú sa hodnoty SCREENRES."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Obrazovky, ktoré používa pinball. Pozície backglass a DMD sa potom vypočítajú automaticky. Nenastavené: 1 obrazovka."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "Zapisovať 0xCD do celej pridelenej pamäte haldy."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "Druhý joystick môže kolidovať s myšou."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Vyberte 'ŠPECIFICKÉ PRE HRU' na použitie súboru cfg pre konkrétnu hru z priečinka emulators\psxmame\ctrlr."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Vybrať typ radiča katódovej trubice (CRTC) Amstrad."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Vybrať model Amstrad na emuláciu."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Vyberte Myš alebo Joypad na ovládanie virtuálneho ukazovateľa v hre."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Vyberte NIE na vypnutie cache textúr."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "Vybrať shader BigPemu, možné iba vtedy, keď sú shadery RetroBat nastavené na 'žiadne'."

msgctxt "game_options"
msgid "Select a bilinear filtering method."
msgstr "Vybrať metódu bilineárneho filtrovania."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Vybrať filter na použitie."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Vybrať shader na použitie."

msgctxt "game_options"
msgid "Select a video format for output."
msgstr "Vybrať video formát výstupu."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Vybrať z rôznych rozložení ovládača."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "Vyberte rozloženie ovládača, ktoré sa použije s možnosťou 'DYNAMICKÝ PROFIL'."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Vyberte roh obrazovky, kde sa zobrazí tetovanie."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Vyberte efekt na použitie, pri použití shaderov nemá vplyv."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Vybrať rozloženie akčných tlačidiel."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Vyberte, do ktorého portu sa vloží GBA rom, predvolene 2."

msgctxt "game_options"
msgid "Select method used to emulate the FM synthetiser."
msgstr "Vybrať metódu emulácie FM syntetizátora."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Vybrať model na emuláciu."

msgctxt "game_options"
msgid "Select palette for colorizing GB games when COLORIZATION is set to 'internal'."
msgstr "Vybrať paletu na farebnenie hier GB, keď je FAREBNENIE nastavené na 'INTERNÉ'."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Vybrať shader na použitie, kompatibilné iba s video ovládačom 'bgfx'."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Vybrať shader na použitie, kompatibilné iba s video ovládačom 'openGL'."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Vybrať režim radenia pre BattleGear4Tuned."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "Vybrať plugin GPU; možnosti RetroBat nebudú fungovať s nepredvoleným pluginom, dajú sa nastaviť v priečinku emulators cez config.exe."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Vybrať IPL BIOS na spustenie hry podľa jej regiónu. Vyžaduje 'IPL_JAP.n64', 'IPL_USA.n64' a 'IPL_DEV.n64' v priečinku bios\Mupen64plus."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Vybrať zariadenie na čítanie súradníc X a Y."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "Vybrať ovládač pre shadery pri použití video ovládača bgfx."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "Vybrať rozšírenie, ktoré sa pridá k ovládaču."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Vybrať režim prezentácie snímok."

msgctxt "game_options"
msgid "Select the graphics plugin used by the emulator. Depends on hardware compatibility."
msgstr "Vybrať grafický plugin emulátora. Závisí od kompatibility hardvéru."

msgctxt "game_options"
msgid "Select the keyboard layout."
msgstr "Vybrať rozloženie klávesnice."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Vybrať model osvetlenia, starý režim je najmenej náročný na grafickú kartu."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Vybrať stroj na emuláciu."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Vybrať profil, ktorý sa priradí hráčovi."

msgctxt "game_options"
msgid "Select the soundfont file or interface used for MIDI output."
msgstr "Vybrať súbor soundfont alebo rozhranie pre výstup MIDI."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "Vybrať zdrojový systém pre transfer pack medzi GB a GBC."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "Vybrať typ konzoly."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "Vybrať typ orámovania obrazovky. Použite hodnotu EMUSCV na opravu chýb zobrazenia pôvodnej konzoly."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "Vybrať typ pištole podľa hry."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Vybrať video režim (typ kábla)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Vyberte, kam sa priradia tlačidlá mince a Start pri hraní s volantom."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Vyberte, kam sa priradia tlačidlá Test a Service pri hraní s volantom."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Vyberte, či je potvrdzovacím tlačidlom krížik alebo kruh."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "Vyberte interne používaný zvukový motor."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Vyberte farebný filter na použitie."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Vyberte grafické API pre renderer textúr."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Vyberte joystick na emuláciu (nekompatibilné s MASTER COMPACT)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Vyberte joystick na emuláciu."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "Vyberte obrazovku, ktorá sa zobrazí v hybridnom rozložení."

msgctxt "game_options"
msgid "Selecting GBA unlocks extra features in certain GBA enhanced GBC games."
msgstr "Výber GBA odomkne ďalšie funkcie v niektorých hrách GBC vylepšených pre GBA."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Posielať MAME úplnú cestu k rom namiesto iba názvu ROM."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Posielať výstupy lámp a dosky pohonu externým nástrojom (MAMEHooker...) správami Windows."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Posielať výstupy lámp a spätného rázu pištole externým nástrojom (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Posielať výstupy lámp, vibrácií pištole a dosky pohonu externým nástrojom (Hook Of The Reaper, QMamehook...) sieťovým protokolom MAME."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Citlivosť emulovaného ovládača spinner."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Nastaviť predvolené ISO na použitie s niektorými homebrew hrami."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Nastaviť predvolené priradenie ovládača pre hráča 1."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Nastaviť predvolené priradenie ovládača pre hráča 2."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Nastaviť predvolené priradenie ovládača."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Nastaviť masku licencií pre aktivovaný obsah (VŠETKY LICENCIE je zvyčajne zlý nápad, môže viesť k nedefinovanému správaniu)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content."
msgstr "Nastaviť filter škálovania pre vykreslený obsah."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Nastaviť filter škálovania pre vykreslený obsah. FSR vyžaduje Vulkan."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Nastaviť filter škálovania pre vykreslený obsah. Iba OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Nastaviť prepínač obtiažnosti Atari 2600."

msgctxt "game_options"
msgid "Set the adress, interrupt, low 8 bit and high 16 bit DMA."
msgstr "Nastaviť adresu, prerušenie, nízke 8-bitové a vysoké 16-bitové DMA."

msgctxt "game_options"
msgid "Set the amount of extra columns to draw for widescreen."
msgstr "Nastaviť počet ďalších stĺpcov na vykreslenie pre širokouhlý obraz."

msgctxt "game_options"
msgid "Set the aspect ratio of the FMV cinematics."
msgstr "Nastaviť pomer strán filmových animácií FMV."

msgctxt "game_options"
msgid "Set the behavior of the start menu when autostarted game exit."
msgstr "Nastaviť správanie štartovacieho menu pri ukončení automaticky spustenej hry."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Nastaviť správanie tlačidla mikrofónu."

msgctxt "game_options"
msgid "Set the bottom screen as prominent."
msgstr "Nastaviť spodnú obrazovku ako hlavnú."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Nastaviť konzolu na širokouhlý obraz, pre hry, ktoré to podporujú."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Nastaviť obnovovaciu frekvenciu hostiteľa."

msgctxt "game_options"
msgid "Set the volume of the emulated floppy sound."
msgstr "Nastaviť hlasitosť emulovaného zvuku diskety."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Nastavte pre hry, ktoré vyžadujú ovládač v porte 2."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Zapnite pri použití viacerých pištolí. Predvolene zapnuté, ak sa nájde viac pištolí a vstupný ovládač nie je nastavený na 'sdl'."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Túto možnosť nastavte iba pri použití skutočnej balance board."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Nastavte túto možnosť na vloženie mikrofónu do slotu B."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Nastavte na 'ZAPNUTÉ' na ukončenie steam alebo Epic Game Launcher pri ukončení hry."

msgctxt "game_options"
msgid "Set this to effectively halve monitor refresh rate."
msgstr "Nastavte na efektívne zníženie obnovovacej frekvencie monitora na polovicu."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Nastavte na zapojenie GunCon do portu 2, používa sa pre niektoré verzie Die Hard."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Nastavte na použitie pôvodného PSX Gamepad namiesto Dualshock."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Nastavte na ÁNO na návrat do neutrálu v závodných hrách po pustení klávesu radenia."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Nastaví posun jasu emulovaného displeja z tekutých kryštálov."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Nastaví úroveň kontrastu emulovaného displeja z tekutých kryštálov."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Nastaví frekvenciu PowerPC v MHz. 0 (predvolené) použije frekvenciu hernej dosky."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Nastaví frekvenciu PowerPC v MHz. AUTO použije frekvenciu hardvéru hry (iba Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "Nastaví frekvenciu PowerPC v MHz. Predvolene 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Nastaví mŕtvu zónu analógových páčok gamepadu, keď je typ vstupného zariadenia nastavený na 'GAMEPAD KLASICKÝ' alebo 'GAMEPAD MODERNÝ'."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Nastaví mŕtvu zónu analógových páčok gamepadu."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Nastaví mŕtvu zónu analógových spúští gamepadu."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Nastaví mŕtvu zónu analógových páčok. Používa sa iba s typom ovládača 'GAMEPAD MODERNÝ'."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Nastaví typ ovládača hráča."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Nastaví citlivosť analógových páčok."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "Nastavenie na 0 znamená, že všetko sa hlási ako zakryté, potrebné pre Forza Motorsport 4."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Nastavenie na 1 môže zvýšiť výkon."

msgctxt "game_options"
msgid "Setting this too high may cause sample clipping."
msgstr "Príliš vysoká hodnota môže spôsobiť orezanie vzoriek."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Tvar pixelov: štvorcové alebo ako na pôvodnom displeji."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Tvar tieňovej masky, ktorú kreslí CRT shader. Používa sa iba vtedy, keď je shader nastavený na masku CRT."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Predvolene zdieľaná CMOS pre všetok obsah alebo jedna na hru (lepšie pre sieťovú hru)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "Intenzita zostrenia FidelityFX CAS. Používa sa iba vtedy, keď je filter škálovania nastavený na FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Krátke správy na obrazovke (stav uložený...). Predvolene zapnuté."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Zobraziť rozhranie Dolphin popri obrazovke hry."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "Zobraziť prekrytie FPS v hre."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Zobraziť ladiacu konzolu Ryujinx."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Zobraziť obrázok ovládania nad rámčekom."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Zobraziť oznámenie pri pripojení alebo odpojení ovládača."

msgctxt "game_options"
msgid "Show core specific notifications."
msgstr "Zobraziť oznámenia špecifické pre jadro."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Zobraziť rozhranie emulátora."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Zobraziť oznámenia emulátora, predvolene zapnuté (AUTO)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Zobraziť oznámenia emulátora."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Zobraziť informácie o hre v ľavom hornom rohu Craft."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Zobraziť informácie o kompilácii shaderov."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Zobraziť informácie o aktuálnom rozložení obrazoviek v pravom hornom rohu."

msgctxt "game_options"
msgid "Show notifications."
msgstr "Zobraziť oznámenia."

msgctxt "game_options"
msgid "Show or crop overscan. 'Auto' will try to adapt to game, cropping empty areas."
msgstr "Zobraziť alebo orezať overscan. 'Auto' sa pokúsi prispôsobiť hre a oreže prázdne oblasti."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "Zobraziť alebo skryť nastavenia RetroArch. 'Auto' je odporúčané nastavenie."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Zobraziť prekrytie štatistík výkonu v hre."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Zobraziť oznámenia o kompilácii shaderov."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Zobraziť vodorovné okraje. AUTO ich oreže na oblasť, ktorú používa hra, najlepšie s PAR BODOVÝCH HODÍN."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Zobrazí klávesnicu Amigy v spodnej časti obrazovky na písanie ovládačom. Prepína sa priradeným tlačidlom, pohyb D-padom alebo páčkou, ďalším tlačidlom sa kláves napíše."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Zobrazí stopy guliek na stenách v miestach zásahu."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Zobrazí aktivitu mechaník a informácie o výkone nad obrazom."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "Zobrazí rozšírené riadky CRT PAL, ktoré sú však vo väčšine hier zvyčajne prázdne."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Zobrazí názvy diskiet, kontrolky a rýchlosť mechaník v okne aj na celej obrazovke."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Zobrazí konfiguračnú obrazovku WHDLoad, ak ju hra podporuje."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Zobrazí výzvu WHDLoad a pred spustením hry čaká na stlačenie tlačidla. Predvolene vypnuté, aby sa hra spustila hneď."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Zmenšiť/zväčšiť tetovanie, aby sa zmestilo do okraja rámčeka."

msgctxt "game_options"
msgid "Significantly improves performances for CPU with 3+ cores."
msgstr "Výrazne zlepší výkon pre CPU s 3+ jadrami."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "Simulovať efekty dosvitu luminoforu CRT. 'Simple' zmieša aktuálnu a predchádzajúcu snímku v pomere 50:50."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "Simulovať efekty dosvitu LCD obrazovky."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Simulovať efekty špecifické pre GPU PowerVR2 a analógové video signály."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simulovať farby LCD obrazovky Game Boy Color."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "Simuluje efekt dosvitu CRT, dá sa použiť na zabránenie blikaniu."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Simuluje dosvit, môže pomôcť znížiť blikanie."

msgctxt "game_options"
msgid "Simulates stereo output."
msgstr "Simuluje stereo výstup."

msgctxt "game_options"
msgid "Single Field applies a de-interlacing filter, Double Field mimics the original hardware."
msgstr "Jedno pole použije filter odstránenia prekladania, dvojité pole napodobňuje pôvodný hardvér."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Veľkosť menu a panelov. Hra ju obmedzí na najväčšiu škálu, ktorá sa zmestí do vnútorného rozlíšenia."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Veľkosť herných pixelov: vyššie hodnoty priblížia a zobrazia menšiu časť mapy. Predvolene: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "Veľkosť najväčšej obrazovky pri hybridnom rozložení obrazoviek."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Veľkosť druhej obrazovky vzhľadom na hlavnú (iba rozloženia Hore/Dole)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Veľkosť okna mimo celej obrazovky."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Pomer veľkosti 2 emulovaných obrazoviek."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "Preskočiť VBI pri zistení oneskorenia, pomáha so sekaním zvuku, keď klesne rýchlosť emulácie."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Preskočiť vykreslenie snímky zhodnej s predchádzajúcou. Môže zlepšiť výkon."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Preskakovať snímky, aby sa predišlo praskaniu zvuku na pomalých zariadeniach."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Preskakovať snímky na zlepšenie výkonu za cenu trhaného pohybu."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Preskočiť 60-sekundové čakanie na ďalšie automaty pri spustení. Vypnite pre hru na viacerých automatoch."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "Preskočiť úvodné logo BIOSu."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Preskočiť kontrolu pri spustení, ktorá bráni spusteniu hry."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Preskočiť kontroly hardvéru pri spustení (kamera, volant, čítačka kariet)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Preskočiť dlhú inicializáciu motora volantu pri spustení. Vyberte revíziu vašej hry."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Preskočiť mechanickú čakaciu dobu disketovej mechaniky. Načítanie je oveľa rýchlejšie, samotný disk sa stále číta presne ako originál."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Preskočiť úvodné videá a logo."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Preskočiť úvodné videá."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Preskočiť inicializáciu motora volantu pri spustení."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Preskočiť videá/FMV."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "Preskočí vykresľovanie povrchov pre oblasť určenú vľavo a vpravo."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Preskočí úvodnú animáciu BIOSu zobrazenú pri načítaní obsahu."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Preskočí úvodnú animáciu BIOSu zobrazenú pri načítaní obsahu. Vypnite na prístup k systémovým nastaveniam PS2 a správcovi pamäťových kariet."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Preskočí úvodnú animáciu BIOSu pri načítaní obsahu."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Slot, do ktorého sa pripájajú obrazy diskov. AUTO ho vyberie podľa typu obrazu. Meňte iba vtedy, ak sa hra odmieta spustiť."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Pomalšie, ale potrebné pre niekoľko hier, ktoré závisia od správania cache."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Vyhladiť 3D textúry."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Vyhladí zmeny riadenia. Potrebné pri použití gamepadu alebo klávesnice."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Vyhladí hrany shaderom, mierne zjemní obraz."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Vyhladí zvuk čipu Paula. 'Sinc' je najjemnejší a najnáročnejší."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Zjemní riadenie gamepadom v závodných hrách. Predvolene silné, na volant nemá vplyv."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Niektoré fázy SPU sú citlivé na súbeh a povolenie obmedzeného počtu naraz pomáha zmierniť zastavenia výkonu. Menšia hodnota môže zlepšiť výkon a znížiť sekanie v niektorých hrách."

msgctxt "game_options"
msgid "Some games accept input from port 2 instead of port 1."
msgstr "Niektoré hry prijímajú vstup z portu 2 namiesto portu 1."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Niektoré hry sa nenačítajú, ak sa systém zapne s vloženým CD. 'ÁNO' vloží CD počas úvodnej animácie."

msgctxt "game_options"
msgid "Some games have graphic and/or speed issues without Cycle-exact."
msgstr "Niektoré hry majú bez presnosti cyklov problémy s grafikou a/alebo rýchlosťou."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Niektoré hry potrebujú na niektoré akcie konkrétny kláves; určite kláves, ktorý sa priradí na tlačidlo SELECT ovládača hráča 1."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Niektoré hry vyžadujú invertovanú os pre pištole."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Niektoré hry vyžadujú rozšírenie Game Drive."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Niektoré hry vyžadujú ovládač v druhom porte na hádzanie granátov."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Niektoré radiace páky sú k počítaču pripojené s iným device id ako volant, napríklad páky Thrustmaster."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Niektoré homebrew a ROM hacky vyžadujú konkrétny vzor RAM pri zapnutí. Vyžaduje reštart."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be disabled."
msgstr "Niektoré homebrew alebo rom hacky potrebujú túto možnosť vypnutú."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Niektoré homebrew alebo rom hacky potrebujú túto možnosť zapnutú."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "Zdroj zvuku pre hudbu MIDI. Možnosti MT-32 vyžadujú zodpovedajúce ROM Roland v priečinku bios."

msgctxt "game_options"
msgid "Space/Enter/Fire works as WHDLoad start button."
msgstr "Space/Enter/Streľba fungujú ako tlačidlo štartu WHDLoad."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Určuje, ako má fungovať emulácia hodín reálneho času v niektorých hrách."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Určuje, ktorý doplnok sa použije na prehrávanie zvukového CD s upravenými hrami MD."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Určiť IPS patch na povolenie; ak nie je nastavený, použijú sa všetky patche definované v .ini ips."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Určiť filter na škálovanie."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Určiť cestu k rámčeku."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Určiť cestu k súboru firmvéru."

msgctxt "game_options"
msgid "Specify the Amiga system model to emulate."
msgstr "Určiť model systému Amiga na emuláciu."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Určiť model počítača na emuláciu."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "Určiť metódu video vykresľovania. Accurate je presnejšie, ale pomalšie, good a fast sú rýchlejšie, ale pri niektorých hrách môžu zlyhať."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Nainštalovaný rečový modul."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Rýchlostný hack, ale nemusí byť kompatibilný s niektorými hrami."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Rýchlostný hack, môže pomôcť pomalým hrám za cenu chýb."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Rýchlostný hack."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Rýchlosť myši na analógovej páčke."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Rýchlosť emulovanej myši Amiga."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Rýchlosť ukazovateľa myši pohybovaného ľavou páčkou."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Zrýchliť načítanie GD-ROM, môže pokaziť niektoré hry."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Zrýchliť načítanie diskov. Môže pokaziť niektoré hry s ochranou proti kopírovaniu."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Zrýchli prístup k disketám na skrátenie časov načítania."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Rozdelí vykresľovanie do viacerých vlákien CPU. Užitočné iba pri vysokom vnútornom rozlíšení."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Vracať volant do stredu, keď hra neposiela silovú spätnú väzbu, ako mechanická pružina arkádového automatu."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Štandardná karta radiča disketových mechaník."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Spustiť priamo v režime Commodore 64."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Spustiť ovládač s už zapnutými páčkami namiesto stláčania tlačidla ANALOG v hre."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Spustiť disk priamo namiesto čakania v menu PLAY CD-I. Predvolene zapnuté."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Spustiť hru v testovacom režime. Test: kláves 0 alebo R3, service: kláves 9 alebo L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Spustí Outrun 2 SP SDX bez kontrol automatu (doska pohonu a veža)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Spustí Wii Menu (menu musí byť nainštalované v Dolphin)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Mŕtva zóna osi riadenia, pre gamepady alebo volanty bez samocentrovania."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Ukladať textúry BC1 v 16 bitoch. Ušetrí video pamäť za cenu malej straty kvality."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Sila vibrácií ovládača. Predvolene 60%."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Sila motora spätného rázu pištole. Predvolene 60%."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Roztiahnuť menu a 2D obrazovky na celú šírku obrazovky."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Roztiahnuť pixely vertikálne ako v pôvodnej DOS hre na obrazovke 4:3. Predvolene: zapnuté."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Roztiahnuť obraz na celú obrazovku bez ohľadu na pomer strán."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Roztiahnuť obraz na celú obrazovku namiesto zachovania tvaru monitora z tej doby."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Studio: TV úrovne skutočného prehrávača, čierna vyzerá na obrazovke PC ako tmavosivá. Plný rozsah: hlboká čierna."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Supervzorkovanie efektov framebuffera, môže spôsobiť artefakty."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Surround prehráva zadné reproduktory štvorreproduktorových automatov Model 3 (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) na zadných reproduktoroch. Ostatné hry ostanú v stereu."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Prehodiť paddle 1 a paddle 2, potrebné pre niekoľko hier, ktoré očakávajú osi naopak."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Prehodiť tlačidlá A a B ovládača."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Prehodiť tlačidlá A/B a X/Y ovládača."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Prehodiť obrazovky TV a GamePad v rozloženiach vedľa seba, hore/dole a obraz v obraze."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Prehodí dva porty Amigy. Potrebné pre niekoľko hier vrátane viacerých titulov point and click."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Prehodiť indexy pištolí medzi hráčom 1 a hráčom 2."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Zapnite na použitie priečinka RetroBat 'saves\switch' pre uloženia Citron a Eden (namiesto priečinka emulátora)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Prepnite typ ovládača hráča 1 na žiadny, ak sa správne vstupy klávesnice nečítajú."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Zapnite na aktiváciu servisného menu tlačidlami R3 a L3."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Zapnite na aktiváciu servisného menu."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Zapnite na použitie D-padu namiesto ľavej analógovej páčky."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Zapnite túto možnosť na vypnutie celej obrazovky a spustenie emulátora v okne."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Zapnite na použitie svetelnej pištole 1 pre hráča 2 a svetelnej pištole 2 pre hráča 1."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Zapnutie pri vyhradenom režime odstránenia prekladania môže pomôcť znížiť rozmazanie."

msgctxt "game_options"
msgid "Sync to exact content framerate. Only for G-Sync/FreeSync/HDMI-2.1-VRR compatible monitors."
msgstr "Synchronizovať s presnou snímkovou frekvenciou obsahu. Iba pre monitory kompatibilné s G-Sync/FreeSync/HDMI-2.1-VRR."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "System Card používaná hrami LD-ROM2, ktoré ju potrebujú. Predvolene: SYSTEM CARD 1, ak je syscard1.pce v priečinku bios."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "Adaptér konektora TI-99 Speech Synthesizer."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "TOS 1.06 je iba pre STE: ak typ stroja nie je nastavený, automaticky sa vyberie STE."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Cieľ 60fps namiesto natívnych 59.73fps."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 hráči vo White Men Can't Jump a NBA Jam T.E. Rotary: Tempest 2000, ovládané myšou."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "Amiga posiela kanály úplne doľava a úplne doprava. Zníženie ich zmieša a so slúchadlami je to oveľa pohodlnejšie. 10 je správanie pôvodného hardvéru."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "Amiga posiela kanály úplne doľava a úplne doprava. Zníženie ich zmieša a so slúchadlami je to oveľa pohodlnejšie. 100% je správanie pôvodného hardvéru."

msgctxt "game_options"
msgid "The CGA variation that is being emulated."
msgstr "Emulovaný variant CGA."

msgctxt "game_options"
msgid "The Neo Geo CD bios used by the emulator."
msgstr "BIOS Neo Geo CD, ktorý používa emulátor."

msgctxt "game_options"
msgid "The Neo Geo bios used by the emulator. UNIVERSE BIOS generally offer the best compatibility."
msgstr "BIOS Neo Geo, ktorý používa emulátor. UNIVERSE BIOS zvyčajne ponúka najlepšiu kompatibilitu."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Režim Neo Geo. UNIVERSE BIOS zvyčajne ponúka najlepšiu kompatibilitu."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "Tím RetroBat pripravil profily pre niektoré bežné ovládače, nachádzajú sa v priečinku 'saves\mame\ctrlr'. VLASTNÉ sa dá použiť na uloženie vlastných priradení."

msgctxt "game_options"
msgid "The SVGA variation that is being emulated."
msgstr "Emulovaný variant SVGA."

msgctxt "game_options"
msgid "The SoundBlaster emulated FM synth mode."
msgstr "Emulovaný režim FM syntetizátora SoundBlaster."

msgctxt "game_options"
msgid "The amount of high memory size the emulated machine has."
msgstr "Veľkosť hornej pamäte emulovaného stroja."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "Množstvo video pamäte."

msgctxt "game_options"
msgid "The aspect ratio that's used by the Widescreen Hack."
msgstr "Pomer strán, ktorý používa Widescreen Hack."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "BIOS, ktorý používa emulátor."

msgctxt "game_options"
msgid "The color scheme for Hercules emulation."
msgstr "Farebná schéma pre emuláciu Hercules."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "Ovládač 'xinput' povolí funkcie ako efekty vibrácií. Vyberte 'sdl' pre kompatibilitu so širokou škálou ovládačov."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "Región hry sa musí zhodovať s regiónom Wii Menu, inak hra nebude rozpoznaná."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Čím vyššia hodnota, tým ďalej sa budú objekty zobrazovať."

msgctxt "game_options"
msgid "The maximum RAM memory available for the system."
msgstr "Maximálna RAM dostupná pre systém."

msgctxt "game_options"
msgid "The normal core can be more stable when running installed OS."
msgstr "Normálne jadro môže byť stabilnejšie pri spúšťaní nainštalovaného OS."

msgctxt "game_options"
msgid "The raw performance to emulate."
msgstr "Hrubý výkon na emuláciu."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "Pravá analógová páčka hráča 1 ovláda druhý joystick, pre hry s dvoma páčkami (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "Pravá páčka sa používa ako pravý D-pad (aj na L2, R2, L3 a R3)."

msgctxt "game_options"
msgid "The type of emulated graphic chip."
msgstr "Typ emulovaného grafického čipu."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "V niektorých hrách je chyba, pri ktorej viac ako 1 aktívne zariadenie spôsobí pád emulátora."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Hrúbka bieleho okraja kresleného pri pripojenej pištoli Sinden. Predvolene normálna (12 pixelov)."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Užitočné v závodných hrách, aby bolo riadenie ovládačom menej trhané."

msgctxt "game_options"
msgid "This option can be used to override PAL timings to run games with NTSC timings."
msgstr "Táto možnosť môže prepísať časovanie PAL na spúšťanie hier s časovaním NTSC."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Táto možnosť mení zvukovú dosku Yamaha emulovaného PC. OPN je predvolená možnosť. Zvuk OPNA podporuje viac FM kanálov a vzoriek PCM."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Táto možnosť riadi analyzátor SPU, najmä veľkosť skompilovaných jednotiek. Pre maximálnu kompatibilitu použite bezpečný režim."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "Táto možnosť musí byť vypnutá, aby sa dal hrať SIGIL."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Táto možnosť ovplyvňuje iba ovládač Gamecube."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Táto možnosť určuje, či sa má emulovať PCG-8100. Môže byť potrebná pre niektorý softvér série PC-8000."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Táto možnosť nastaví takt CPU emulovaného PC."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Táto možnosť nastaví takt CPU emulovaného PC. Možnosti pretaktovania spôsobia, že väčšina softvéru pobeží rýchlejšie ako normálne."

msgctxt "game_options"
msgid "This option specifies which lock-on cartridge to emulate."
msgstr "Táto možnosť určuje, ktorá kazeta lock-on sa má emulovať."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "Toto nastavenie sa dá použiť iba s filtrom 'scanlines'."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Toto nastavenie zabráni pozastaveniu emulácie pri strate fokusu."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Toto nastavenie otočí pracovnú plochu Windows, po ukončení hry sa nevráti späť."

msgctxt "game_options"
msgid "This should only be disabled when playing ROM hacks."
msgstr "Vypínať iba pri hraní ROM hackov."

msgctxt "game_options"
msgid "This should only be disabled when playing certain demos and homebrews for correct operation."
msgstr "Vypínať iba pre správnu činnosť niektorých dem a homebrew."

msgctxt "game_options"
msgid "This will replace the BIOS CD-ROM busy loop with a STOP instruction."
msgstr "Nahradí čakaciu slučku CD-ROM v BIOSe inštrukciou STOP."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Spustí hru bez akýchkoľvek vybraných grafických alebo CPU vylepšení."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "Spustí BIOS konzoly namiesto hry."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Prah, od ktorého sa pohyb analógovej páčky počíta ako digitálny smer."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Dynamicky znížiť počet emulovaných cyklov CPU, ak CPU hostiteľa nestíha (predvolene vypnuté)"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Vstup náklonom pre Kirby Tilt 'n' Tumble a iné hry MBC7. Predvolene analógová páčka."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "Rozširujúca RAM Trapdoor, ako v klasickom rozšírení A501."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Skúsiť spustiť nastavenie (setup) hry."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Pokúsiť sa zistiť podmienky slučiek v jadrách SPU a použiť ich ako tipy na plánovanie. Predvolene vypnuté"

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "Pokúsiť sa zistiť hru a použiť priradenie ovládača."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Pokúsiť sa vybrať najlepšiu obnovovaciu frekvenciu pre ROM."

msgctxt "game_options"
msgid "Try to use legacy dosbox.conf config file instead of core options."
msgstr "Pokúsiť sa použiť starý konfiguračný súbor dosbox.conf namiesto možností jadra."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "TurboTap je potrebný na hru viacerých hráčov. Povolí sa automaticky pri pripojení druhého ovládača."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Zapnúť oznámenia emulátora: pripojené ovládače a správy o kompilácii shaderov."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Rýchlosť otáčania myšou. Predvolene: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Zapnite na priradenie iba D-PADU pre smery."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Zapnite pri použití svetelnej pištole, ktorá nepodporuje nabíjanie mimo obrazovky."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "Zapnutie tejto možnosti umožní MAME hlásiť pohyb a stlačenia tlačidiel rôznych myší nezávisle."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Zmení pravú páčku na myš Amiga, užitočné pre hry s menu a point and click bez púšťania ovládača."

msgctxt "game_options"
msgid "Tweak the behavior of the 3Dfx Voodoo emulation."
msgstr "Upraviť správanie emulácie 3Dfx Voodoo."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Predvolene dve vrstvy (bit-exact). Zoradené opraví navrstvený dym a sklo, šachovnica reprodukuje arkádovú dosku (sneh a hmla v Sega Rally 2)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Typ APPLE II na emuláciu."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Typ počítača Archimedes na emuláciu."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Typ BBC micro na emuláciu, predvolene MODEL B."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Typ jadra emulácie CPU na použitie."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Typ Color Computer na emuláciu, predvolene coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Typ počítača na emuláciu."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Typ FM Towns na emuláciu, predvolene FM TOWNS (MODEL 1/2)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Typ FM-7 na emuláciu, predvolene FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "Typ preskakovania snímok."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Typ LYNX na emuláciu, predvolene 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "Typ súboru ROM"

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Typ V.Smile na emuláciu."

msgctxt "game_options"
msgid "Type of emulated SoundBlaster card."
msgstr "Typ emulovanej karty SoundBlaster."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "Typ joysticku pripojeného k hernému portu."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Zruší obmedzenie snímkovej frekvencie hry, ak sa v internej databáze nájde patch."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Odomkne ďalšie jazyky v niektorých hrách, ak má databáza jadra pre ne záznam."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Zvýšiť frekvenciu CPU z 93.75 na 125 MHz. Môže zrýchliť niektoré hry závislé od CPU."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Škálovať textúry hry filtrom pixel-art."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Filter škálovania 2D vrstiev (HUD, pozadia)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Filter škálovania 2D vrstiev (HUD, pozadia). Iba Vulkan a OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Použite 'JUH' pre tlačidlo A a 'ZÁPAD' pre tlačidlo B."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Použiť priečinok 'cfg64' pre samostatný MAME."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Použite zameriavač 'vlastné' na povolenie vybraného súboru zameriavača."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Použite zameriavač 'vlastné' na povolenie súboru vybraného tu."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Použite 'PRE KAŽDÚ HRU', ak ste uložili profil pre hru v priečinku capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Použite 50 pre európsku konzolu a 60 pre japonskú konzolu."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Pre lepšiu kompatibilitu použite 8mhz."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Použiť analógovú páčku ako D-PAD."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Použite DSI pre hry DSI ako DSI Ware."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Použite IBA JOYSTICK pre hry s joystickom a IBA KLÁVESNICA pre hry s klávesnicou."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Použiť ľavú analógovú páčku namiesto D-PADU na ovládanie."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Použiť R1 a L1 na plyn a brzdu v závodných hrách, kompatibilné iba s radením 'auto'."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Použiť Resizable BAR na nahrávanie do GPU, ak je k dispozícii. Vypnite, ak s ovládačom zaznamenáte sekanie alebo nestabilitu."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Použiť SDL pre všetky ovládače namiesto XInput pre ovládače Xbox."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Použiť časovanie a správanie SGB2."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Použiť SSE4 namiesto AVX2 pre staršie CPU."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Použiť filter vysokého rozlíšenia na zlepšenie vykresľovania."

msgctxt "game_options"
msgid "Use a mouse-controlled Lightgun or Touchscreen input."
msgstr "Použiť svetelnú pištoľ alebo dotykový vstup ovládaný myšou."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Použiť preddefinovanú farebnú paletu namiesto palety vypočítanej emulátorom."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Použiť alternatívne spracovanie hĺbky, povoľte pri grafických problémoch alebo konkrétnej chybovej správe."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Použiť ampersand a parentleft pre start a mince."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Použiť externý firmvér (predvolene 'firmware.bin' v priečinku bios)."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Použiť analógovú páčku namiesto D-padu."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Použiť bilineárne filtrovanie na vyhladenie celého obrazu."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Použiť bios pre niektoré systémy ako Neo Geo a Sega ST-V"

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Použiť tlačidlo na nabíjanie namiesto výstrelu mimo obrazovky pre pištole, ktoré ho nepodporujú."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Použiť tlačidlá namiesto analógovej osi pre volant."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Použiť predvolené vstupné zvukové zariadenie počítača ako mikrofón."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Použiť hat na pohyb popri joysticku."

msgctxt "game_options"
msgid "Use input directly sends by keyboard to the core."
msgstr "Použiť vstup posielaný klávesnicou priamo do jadra."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Pre najlepšiu kompatibilitu použite interpreter, pre výkon dynarec."

msgctxt "game_options"
msgid "Use interpreter for best compatibility."
msgstr "Pre najlepšiu kompatibilitu použite interpreter."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Použiť ľavú analógovú páčku popri D-pade."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Použiť ľavú analógovú páčku namiesto D-PADU."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "Použiť ľavú páčku ako D-pad."

msgctxt "game_options"
msgid "Use native texture LOD computation when upscaling."
msgstr "Použiť natívny výpočet LOD textúr pri škálovaní."

msgctxt "game_options"
msgid "Use official BIOS and bootloader for emulated hardware."
msgstr "Použiť oficiálny BIOS a zavádzač pre emulovaný hardvér."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Použiť jednu zdieľanú pamäťovú kartu pre všetky hry namiesto jednej karty na hru. Karty sa ukladajú do '\bios\pcsx2\memcards'."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Použiť emuláciu s presnosťou na pixel, kde je k dispozícii."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Použiť porty 5-8 pre ovládače GameCube v režime Wii."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Použiť preemptive frames namiesto run-ahead, platí počet snímok run-ahead."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Použiť skutočné ovládače GameCube cez adaptér GameCube. Iba so skutočnými Wiimote."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Použiť ramenné tlačidlá pre L a R namiesto spúští."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "Použiť ramenné tlačidlá namiesto spúští."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Použiť 3D modely HD balíkov namiesto spritov (renderery OpenGL). Predvolene zapnuté."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "Použiť BIOS umiestnený v priečinku 'bios' RetroBat. Potrebné na spustenie do BIOSu."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Použiť BIOS umiestnený v priečinku 'bios' RetroBat."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Pre obrazovky s vyššou obnovovacou frekvenciou použite hodnotu VYSOKÁ FREKVENCIA."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Použiť rámčeky z balíka artwork Odin (priečinok artwork emulátora) namiesto dekorácií RetroBat."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Použiť renderer s compute shadermi namiesto klasického OpenGL. Rýchlejší pri vysokých vnútorných rozlíšeniach, vyžaduje OpenGL 4.3."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Použiť vstavaný BIOS emulátora namiesto súborov v priečinku bios. DS Download Play vyžaduje pôvodný BIOS a firmvér."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Použiť textúry vysokého rozlíšenia z HD balíkov (renderery OpenGL). Predvolene zapnuté."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Použiť myš ako paddle Apple II, potrebné pre Arkanoid, Breakout a ďalšie hry s otočným gombíkom. Poloha ukazovateľa na obrazovke je poloha paddle. Nahradí páčku ovládača pre paddle 1 a 2, pre hry s joystickom ponechajte vypnuté."

msgctxt "game_options"
msgid "Use the older and less compatible faster blitter"
msgstr "Použiť starší a menej kompatibilný rýchly blitter"

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Použiť nastavenia pre každú hru uložené v rozhraní Vita3K. Prepíšu nastavenia RetroBat pre túto hru."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Použiť jednoduchú farebnú mapu double hi-res. Niekoľko programov Apple II s ňou vyzerá bližšie skutočnému stroju."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Použite, ak emulátor po načítaní spadne alebo nič nezobrazuje."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Použite iba vtedy, ak analógová páčka ubieha."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Použite túto možnosť, ak sa ArcadeDuck nezobrazuje na správnom monitore."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Použite túto možnosť, ak sa Keisho nezobrazuje na správnom monitore."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Použite túto možnosť, ak sa Odin nezobrazuje na správnom monitore."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Použite túto možnosť, ak sa PCSX2 nezobrazuje na správnom monitore."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Použite túto možnosť, ak sa duckstation nezobrazuje na správnom monitore."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Použite túto možnosť, ak sú p1 a p2 prehodení."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Použite túto možnosť pri ovládači rozpoznanom ako klávesnica (ipac atď.)."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Použite túto možnosť pri volante bez manuálnej radiacej páky."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Použite toto nastavenie pre letecké hry."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Použite toto nastavenie na zníženie alebo zvýšenie jasu, nekompatibilné s video ovládačom 'gdi'."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Použite toto nastavenie na zníženie alebo zvýšenie kontrastu, nekompatibilné s video ovládačom 'gdi'."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Použite toto nastavenie na zníženie alebo zvýšenie gammy, nekompatibilné s video ovládačom 'gdi'."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Použite toto nastavenie na určenie predvoleného cieľového tlačidla turbo."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Použite toto nastavenie na ignorovanie súborov run.bat, autoexec.bat alebo dosbox.bat v priečinku hry."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Použite toto nastavenie na zníženie oneskorenia vstupu."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Použite na automatické načítanie obsahu ako HD balíky."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Použite winkey pre klávesnicu, xinput, ak máte ovládač XBOX, sdl pre iné typy ovládačov."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Použiť vlastný súbor .cfg v saves\mame\cfg. Premapovania cez TAB v hre sa zachovajú. Pri prvej aktivácii sa automaticky importuje priradenie z poslednej relácie. Možnosť rozloženia ovládača sa na túto hru už nevzťahuje."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Užitočné pre hry s efektmi trasenia obrazovky ako Wipeout Fusion, môže rozmazať obraz."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Užitočné pre jednovláknové procesory."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Užitočné na niektorých obrazovkách s vysokou obnovovacou frekvenciou na odstránenie dosvitu."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Užitočné pri rozlíšení vyššom ako obrazovka. Zabráni efektu moaré."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Použije 60hz (480i) namiesto 50hz (576i)."

msgctxt "game_options"
msgid "Uses the proper mipmap levels. Enhance graphics accuracy."
msgstr "Použije správne úrovne mipmáp. Zlepší presnosť grafiky."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "Emulácia filtra postprocesingu VI."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Hodnoty nad 1.00 zväčšia veľkosť, hodnoty pod ňou ju zmenšia."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "Vertikálne hry sa zobrazia na monitore zodpovedajúcom vybranému indexu."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD je vylepšená grafická karta, ktorú používa hŕstka moderných dem. Zmena reštartuje stroj."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Video režimy, ktoré konzola ponúka hrám. HD režimy vyžadujú video signál HDTV."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Rozloženie zobrazenia, ktoré používa stôl. AUTO sa riadi NASTAVENIE OBRAZOVIEK: pracovná plocha pre jednu obrazovku na šírku, plná jedna obrazovka pre jednu vertikálnu obrazovku, automat pre viac obrazoviek (pracovná plocha, keď NASTAVENIE OBRAZOVIEK nie je nastavené)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Virtuálne otočiť D-pad, keď je obrazovka otočená."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Hlasitosť cvakania emulovanej disketovej mechaniky."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Hlasitosť hudobnej dosky v hrách, ktoré ju majú (Daytona USA, Sega Rally). Predvolene 100%."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Iba Vulkan, pomalšie, ale s menším oneskorením."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Iba Vulkan. Zlepší výkon a opraví mnoho grafických problémov, ale na niektorých GPU môže byť nestabilné. Nepodporované metódy sa automaticky vrátia k záložným."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Iba Vulkan: povie video ovládaču, aby použil určený režim bufferovania."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Čo je zapojené v prvom porte Amigy. Väčšina hier používa joystick v porte 2 a myš v porte 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Čo je zapojené v druhom porte Amigy."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Čo je zapojené v druhom porte Amigy. Predvolene: Joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Čo dostane druhý port, keď sa pripojí druhý ovládač."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Po zadaní adresy sa režim automaticky nastaví na 'MANUÁLNE'."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "Keď zlyhá automatická detekcia."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Ak je k dispozícii, uprednostniť exkluzívnu celú obrazovku pre emulátory."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "Keď je zapnuté, každá hra bude mať vlastné VMU v porte 1."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "Pri výbere 'MANUÁLNE' zadajte adresu v ďalšom nastavení."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "Keď je obmedzenie rýchlosti vypnuté, MAME spúšťa emuláciu čo najrýchlejšie."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Pri použití súboru .m3u vyberte index disku na spustenie."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Pri použití Cursor Joystick musia byť tlačidlá priradené na klávesy v RetroArch."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "Pri použití XInput táto možnosť prehodí gamepady 1 a 2."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Pri použití pištole Sinden ukončiť softvér Lightgun po skončení hry."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Pri použití priradenia zo súboru pre arkádové systémy určite rozloženie na použitie."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "Pri použití skutočných Wiimote určite typ Wiimote."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "Pri softvéri, ktorý vyžaduje plný vstup z klávesnice, sa odporúča použiť aj režim fokusu hry."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Kde zobraziť DMD. AUTO: na hracej ploche s 1 obrazovkou, v spodnej časti obrazovky backglass s 2 obrazovkami, na vlastnej obrazovke s 3 obrazovkami. Vyžaduje NASTAVENIE OBRAZOVIEK."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Ktorý RetroPad riadi ktorý port Amigy. Ponechajte na Automaticky, pokiaľ nie sú hráči prehodení."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Ktorý disk hry na viacerých diskoch sa vloží pri spustení. POM2 načíta jeden disk naraz, ostatné sa vymieňajú z menu v hre."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Ktorý disk hry na viacerých diskoch sa vloží pri spustení: vždy prvý alebo ten, ktorý bol v mechanike pri poslednom ukončení."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Ktoré akčné tlačidlo potvrdzuje v systémových dialógoch PS3. Japonské hry zvyčajne očakávajú Kruh, západné Krížik. Ponechajte na AUTO, aby sa riadilo vybraným regiónom."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "S ktorou disketovou mechanikou pracuje menu výmeny diskov."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Biely okraj kreslený emulátorom, potrebný pre pištole Sinden na mierenie."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Šírka bieleho okraja kresleného pri pripojenej pištoli Sinden. Predvolene 16 pixelov."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Šírka bieleho okraja kresleného pri pripojenej pištoli Sinden. Predvolene 2 pixely."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Spustí proces XBOX vo viacerých vláknach CPU, môže zlepšiť výkon, ale pokaziť niektoré hry."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Obchádzka potrebná pre niekoľko homebrew a ROM hackov."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Obchádza chyby firmvéru niektorých volantov, ktoré spôsobujú krátke prerušenia sily. Ponechajte vypnuté, pokiaľ to nie je potrebné."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Zapíše Amiberry.log do priečinka emulátora. Užitočné iba pri hlásení problému, mierne spomalí chod."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Zapisuje hodnoty hĺbkového buffera do pamäte vm. Predvolene vypnuté."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Zapisuje udalosti vstupu do protokolu v priečinku uložení. Užitočné iba pri hlásení problému."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "Z80 SoftCard spúšťa softvér CP/M. Zvukové karty sa sem dajú pridať ako druhá. Zmena reštartuje stroj."

msgctxt "game_options"
msgid "Zooms in to hide black borders."
msgstr "Priblíži obraz na skrytie čiernych okrajov."

msgctxt "game_options"
msgid "Zooms in to hide black borders. Borders are different per game."
msgstr "Priblíži obraz na skrytie čiernych okrajov. Okraje sa líšia podľa hry."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "Rozširujúca RAM Zorro II. Vyžaduje ju mnoho titulov WHDLoad, ale niekoľko pôvodných disketových hier sa s ňou odmieta spustiť."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "Rozširujúca RAM Zorro II. Vyžaduje ju mnoho titulov WHDLoad."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Pamäť Zorro III, použiteľná iba strojom s akcelerátorom. Ponechajte na žiadne, pokiaľ si ju konkrétny titul nevyžaduje."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Pamäť Zorro III. Užitočná pre zostavy Workbench a niekoľko dem."

msgctxt "game_options"
msgid "use this to automatically start to a specified level."
msgstr "použite na automatické spustenie na zadanej úrovni."
