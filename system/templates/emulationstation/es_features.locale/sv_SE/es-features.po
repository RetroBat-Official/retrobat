# FEATURES - DESCRIPTIONS
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "»1x« är den verkliga enhetshastigheten. »Turbo« laddar nästan omedelbart, men några få spel upptäcker det och vägrar starta."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "»1x« är den verkliga enhetshastigheten. »Turbo« tar bort emuleringen av diskens rotation och laddar nästan omedelbart, men några få spel upptäcker det och vägrar starta."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "»Exakt« motsvarar hårdvaran men kan sänka bildfrekvensen kraftigt på spara/ladda-skärmar. Ändra bara om en meny är långsam."

msgctxt "game_options"
msgid "'Auto' defaults to the most compatible version for the model."
msgstr "»Auto« väljer som standard den mest kompatibla versionen för modellen."

msgctxt "game_options"
msgid "'Auto' is the default floppy speed (300RPM). 'Turbo' removes disk rotation emulation."
msgstr "»Auto« är standardhastigheten för disketter (300 RPM). »Turbo« tar bort emuleringen av diskens rotation."

msgctxt "game_options"
msgid "'Auto' will controls the half-screen fix detection on texture shuffling."
msgstr "»Auto« styr identifieringen av halvskärmskorrigeringen vid texture shuffling."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "»Kompatibel« passar nästan alla spel. »Cykelexakt« är mest exakt men kräver en snabb dator. »Snabb« låser upp CPU-hastigheten och kan förstöra tidskänsliga spel."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "»Dubbel« ger en ren modern bild. Scanline-lägena återskapar utseendet hos en CRT-skärm."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "»Dubbla spakar« mappar spelare 2:s joystick till spelare 1:s högra analoga spak, »Byt portar« åtgärdar portinverteringen i Wizard of Wor."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "»Exakt« är den mest troget emulerade Paula. Sänk bara om ljudet hackar på en långsam dator."

msgctxt "game_options"
msgid "'Games Express' is needed for several unlicensed games."
msgstr "»Games Express« krävs för flera olicensierade spel."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "»Joystick« är den klassiska spaken med 2 knappar som alla spel förstår. »CD32-handkontroll« lägger till de färgade knapparna och väljs automatiskt på CD32."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "»PÅ« skickar alla fysiska tangentbordshändelser till kärnan. »AV« hindrar RetroPad-knappar från att skapa tangentbordshändelser."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "»FÖRDEFINIERADE« använder konfigurationsfilerna i emulatorns mapp »cfg«, »DYNAMISK« skapar konfigurationen utifrån profilen som valts i de avancerade inställningarna för »STYRNING«."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "»Säker« åtgärdar texturfel i vissa spel till en hög prestandakostnad."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "Alternativet »Mallar« kopierar filerna i mappen »emulators\m2emulator\templatescfg« i stället för att göra en dynamisk autokonfiguration."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "»Trippelbuffert« och »matcha emulerat innehåll« är endast tillgängliga med Vulkan-videodrivrutinen."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "»Turbo« tar bort emuleringen av sökfördröjning."

msgctxt "game_options"
msgid "'Weave' should only be used with 1x scaling factor and CRT shaders."
msgstr "»Weave« bör endast användas med skalfaktor 1x och CRT-shaders."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "»XINPUT« tvingar användning av XInput-API:t för kompatibla handkontroller."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "»directx11« är standard och fungerar på nästan all hårdvara. »vulkan« kan vara snabbare på nya grafikkort. Vissa libretro-kärnor tvingar sin egen drivrutin."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8MB Fast RAM (CD32FR). Av som standard, som på originalets CD32."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "0 är lägst kvalitet, fördröjning och CPU-användning, 10 är högst kvalitet, fördröjning och CPU-användning."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "130-140% rekommenderas med moderna handkontroller."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 bitar tar bort färgbanden i mörka områden och övertoningar. HDR kräver en HDR-skärm med HDR aktiverat i RetroArch, annars faller kärnan tillbaka på 24 bitar."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x motsvarar den riktiga enheten. Högre hastigheter förkortar laddningstiderna men kan förstöra spel."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "32k RAM-utökningskort installerat."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "4/3 som standard, som arkadskärmen. Ramen visas endast i 4/3. 16/9 breddar 3D-vyn."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Några få spel kräver att detta alternativ är inaktiverat."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Några få spel kräver detta. Kostar omkring 10% prestanda."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Några mycket tidiga spel kräver CTIA-chipet för att visas korrekt."

msgctxt "game_options"
msgid "A shadows and colors fix needed for some games such as Tony Hawk Proving Ground."
msgstr "En korrigering av skuggor och färger som behövs i vissa spel, t.ex. Tony Hawk Proving Ground."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII mappar ditt tangentbord till de tecken det skriver. Original återger exakt den emulerade maskinens tangentbord, vilket några få program kräver."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "AUTO (rekommenderas) låter kärnan välja NAND-filen utifrån spelets region."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO visar siktet när du siktar med mus och döljer det med en riktig ljuspistol."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO byter till DSi endast för spel som är exklusiva för DSi. Tvinga DSI för DSiWare."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "AUTOMATISK väljer utökningen efter programmets storlek. Kan tvingas med taggar i filnamnet som (8k) eller [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMATISK: Vita3K laddar själv de firmwaremoduler som behövs (rekommenderas). EMULATORINSTÄLLNINGAR: behåll modulerna som valts i Vita3K-gränssnittet."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Över 60 fps interpoleras bildrutor mellan spelets uppdateringar. AUTO följer skärmens uppdateringsfrekvens."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Exakt framebuffer-emulering, mycket långsam men krävs av vissa spel."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Agera som spelare 1 och var värd för spelet."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Funktion för handkontrollens andra knapp: mellanslag (t.ex. Xenon 2) eller joystick uppåt (hopp i plattformsspel)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Aktivera siktehjälp."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Aktivera autosparning och ange intervallet mellan sparningarna."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "Aktivera detta när du använder WiiZapper för att byta avtryckare och omladdningsknapp."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Anpassa spelvyn till bredbildsskärmar."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Lägg till en tom 2HD spar-/användardisk i diskstyrningslistan."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Lägg till kontaktskuggor, kräver hårdvarurenderaren."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Justera muspekarens hastighet efter den analoga spakens känslighet."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "Justera utgångsfärgerna för att efterlikna den ursprungliga konsolskärmen."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Justera Wiimote-pekarens vertikala mittpunkt."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Justerar musikspårets volym."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Justerar ljudeffekternas volym."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Avancerat ljudbibliotek som används av många spel. Inaktivera bara om ett spel kraschar eller har ljudproblem."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Sikta med handkontrollens gyroskop (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Låt ADAM skriva till disketter och datapaket. Skrivningar går till en arbetskopia i sparmappen, originalfilen ändras aldrig. Kräver omstart av kärnan."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Tillåt DirectInput-handkontroller (generiska USB-handkontroller, arkadspakar). Inaktivera bara om en handkontroll upptäcks två gånger."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Tillåt XInput-handkontroller (Xbox-handkontroller och omvandlare). Inaktivera bara om en handkontroll upptäcks två gånger."

msgctxt "game_options"
msgid "Allow bilinear scaling on scanout."
msgstr "Tillåt bilinjär skalning vid scanout."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Möjliggör korrekt emulering av texture wrapping, men kostar prestanda."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Låt spel som stöder olika upplösningar renderas i en specifik upplösning."

msgctxt "game_options"
msgid "Allow gamma dither."
msgstr "Tillåt gamma-dither."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Tillåt inbyggt HID-stöd för DualShock 4-, DualSense- och Switch Pro-handkontroller. Inaktivera för att falla tillbaka på DirectInput."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Tillåt att vänster och höger, eller upp och ner, trycks samtidigt. Kan ge rörelsefel i vissa spel."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Tillåt att motsatta riktningar trycks samtidigt."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Låt vissa spel i 30 fps köras i 60 fps."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Tillåt fetch-konstanter för texturer och vertexar med ogiltig typ, kan användas för att kringgå fetch-fel i vissa spel."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Tillåt variabel uppdateringsfrekvens på skärmar som stöder det. På skärmar utan VRR kan skärmrivning uppstå i vissa fall."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Tillåt in- och utzoomning av kartan med mushjulet, som i Enhanced Editions."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Låter dig göra en särskild mappning för din arkadspak utifrån filen »arcade_sticks.json«."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Låter dig använda musinmatning även när enhetstypen inte är satt till »RetroKeyboard/Mouse«."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Sätt även in nästa diskett i enhet 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Packa alltid upp arkiv, även om dokan kunde användas för att montera dem som en enhetsbokstav."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Visa alltid namnen på föremål på marken."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Amiga-modell att emulera. Varje modell behöver sin egen Kickstart-ROM i bios-mappen."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Amiga-modell att emulera. Kräver omstart av kärnan. Varje modell behöver en matchande Kickstart-ROM i mappen bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Amiga-port som pistolen är ansluten till. Port 2 är rätt för nästan alla maskiner; endast A1000 läser pennan på port 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Mängd Chip RAM. Vissa senare spel behöver 1 MB. Att gå över vad modellen stöder kan försämra kompatibiliteten."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "Mängd RAM som används."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Mängd små pekarrörelser som ska ignoreras."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "En extra vibration som ökar när du styr."

msgctxt "game_options"
msgid "Anti-aliased fetch filter, smooth polygons edges."
msgstr "Kantutjämnande fetch-filter, jämnar ut polygonkanter."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Nivå för kantutjämning."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Metod och nivå för kantutjämning."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Apple II-modell att emulera. Ändring startar om maskinen."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Apple II-modell att emulera. PAL-modellerna körs i 50Hz och är de som europeiska demos skrevs för. Ändring startar om maskinen."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Tillämpas på siktesbilden, användbart för att skilja spelarna åt."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Tillämpar en potenskurva på styrvärdena, dämpar små rörelser."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Gäller flygspakens och gasreglagets axlar i After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Gäller gas- och bromspedalerna i bilspel."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Använd Gouraud-skuggning i stället för platt skuggning, endast med OpenGL."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Tillämpa ett CRT-filter (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Tillämpa ett brunaktigt färgfilter."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "Tillämpa ett videofilter som kärnan tillhandahåller."

msgctxt "game_options"
msgid "Apply a video filter to mimic various signals."
msgstr "Tillämpa ett videofilter för att efterlikna olika signaler."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Tillämpa ett videofilter på utgångsbilden."

msgctxt "game_options"
msgid "Apply an audio filter. 'Gaussian' reproduce the bass-heavy sound of the original hardware."
msgstr "Tillämpa ett ljudfilter. »Gaussisk« återger originalhårdvarans basrika ljud."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Tillämpa ett ljudfilter. Ändrar ljudinterpoleringen."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Tillämpa ett kärnspecifikt filter för att efterlikna rendering hos gamla signaler."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Tillämpa korrigering för vissa spel."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Tillämpa regionen ovan även när spelet anger en egen."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Efterliknar konsolens analoga utgångssteg: tar bort DC-förskjutningen och mjukar upp höga frekvenser."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Utseende som en arkadskärm."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Utseende som en arkadskärm: scanlines, skuggmask och glöd."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Bildformat som kärnan tillhandahåller, används när SPELETS BILDFORMAT är satt till AUTO."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Bildformat som ställts in i konsolens systeminställningar."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Atari-tangentbord: F2, F4 och F8 lämnas åt spelet, sparade lägen och skärmbilder använder då AltGr+K, AltGr+L och AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Försök göra omskalningen i nativ upplösning."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Tröskel för ljudbufferten vid manuell frameskip."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Ljud ger lägst fördröjning. Video är jämnare när skärmens uppdateringsfrekvens ligger nära konsolens."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Ljudutgångens frekvens."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (standard) följer skärmens uppdateringsfrekvens med rörelseinterpolering. Original och multiplar av 57.524 Hz kräver en G-SYNC-/FreeSync-skärm och vertikal synkronisering."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Autocentrera sikteaxeln. Användbart när du spelar pistolspel med en gamepad i stället för en ljuspistol."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Autofire-frekvens. Snabbare är inte alltid bättre: vissa spel ignorerar för snabba tryck."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: väst attack, syd hopp, öst special, nord attack 2, L1/R1 attack 3/4. OpenBOR standalone: samma knappar som den fristående emulatorn OpenBOR."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automatisk använder XInput när alla handkontroller är XInput-enheter, annars DirectInput."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automatisk: starta från hårddisken när spelet har en hårddisk och ingen diskett."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automatisk: visas endast när spelet inte har ett eget sikte."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Tillämpa automatiskt spelförbättringar om de finns i kärnans databas (LOD, siktavstånd, hoppa över FMV)."

msgctxt "game_options"
msgid "Automatically decrease frame delay temporarily to prevent frame drops. Turn off if this worsens audio/video stuttering."
msgstr "Minska tillfälligt bildfördröjningen automatiskt för att undvika tappade bildrutor. Inaktivera om detta förvärrar hackande ljud/bild."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Snabbspola FDS-spel automatiskt när disken laddas."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Ladda automatiskt patchar utan interlacing när spelet startar."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Ladda automatiskt widescreen-patchar när spelet startar."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Laddar och tillämpar fusk automatiskt när spelet startar."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Tar automatiskt bort de svarta kanterna runt Amiga-bilden så att den fyller mer av skärmen."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Rotera bilden automatiskt för vertikala spel."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Byt automatiskt Port0 och Port1 utifrån inmatningsaktiviteten."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Vänd automatiskt disksidan när spelet ber om det."

msgctxt "game_options"
msgid "Avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Undvik glipor mellan pixlar vid uppskalning. Åtgärdar texten i Wild Arms och spökbilder i SoulCalibur."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "BIOS-språket kan påverka språket i vissa spel."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Ramar visas endast i 4/3."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "Bilateral CAS rekommenderas men sänker prestandan, CAS är mindre aggressiv men mer subtil."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Bildens svartnivå. 50% som standard, anpassat efter en arkadinspelning: lägre är mörkare, högre är ljusare."

msgctxt "game_options"
msgid "Blend pixel together when in hires mode. Higher values will blur the picture more."
msgstr "Blanda pixlar i högupplöst läge. Högre värden gör bilden suddigare."

msgctxt "game_options"
msgid "Blend pixels from multiple successive frames to simulate LCD ghosting."
msgstr "Blanda pixlar från flera bildrutor i följd för att simulera LCD-spökbilder."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "Blandad ritar de genomskinliga polygonerna som en mjuk blandning i stället för arkadens schackrutemönster. Endast Model 1 och Model 2, Vulkan- och OpenGL-renderare."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Gör den emulerade bilden suddig."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "Gör intilliggande pixlar suddiga för genomskinlighetseffekter."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "Gör intilliggande pixlar suddiga för att simulera SDTV-upplösning, kan krävas av vissa spel för att emulera genomskinlighet."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Snabba upp emuleringen under uppstarten."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Starta direkt i DS BIOS-menyn, kräver att extern bios aktiveras."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Starta i Game Genies kodinmatningsskärm. Kräver »gamegenie.nes« i bios-mappen. Omstart krävs."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Starta i konsolens BIOS-meny."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Starta med den riktiga Jaguar-BIOS:en och dess startanimation. Krävs av vissa spel."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Avbryt till värdens felsökare (eller krascha om ingen felsökare är ansluten) när en oimplementerad PowerPC-instruktion påträffas."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "Visa systemets ROM-meny vid uppstart av arkadsystem."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Sänd inmatningsåterkoppling på TCP-port 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Bygg de cachade shaders innan spelet startar."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Knappkombination för att växla mellan TV och GamePad, används endast av skärmlayouten VÄXLINGSBAR."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Kärnans knapplayout, samma för alla spel. Lämna på AUTO för att använda RetroBats mappning per spel och HANDKONTROLLSLAYOUT."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Knapp som används för att bekräfta i systemdialoger och i spel som följer systeminställningen. CIRKEL är den japanska konventionen."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Som standard startas Hellfire när spelnamnet innehåller hellfire, annars Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Som standard konfigurerar RetroBat lika många spelare som anslutna handkontroller, använd detta för att åsidosätta."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Som standard skapar RetroBat sin egen konfigurationsfil, aktivera detta för att använda din egen fil med spelinställningar i mappen »emulators\ssf\Setting«."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Som standard används en andra gamepad när en andra handkontroll ansluts."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Som standard flyttar alla handkontroller hjälten. Aktivera om en annan ansluten handkontroll stör rörelsen."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "Som standard mappar zinc vänster spak för rörelse, använd detta alternativ för att byta till D-pad."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Som standard kräver RPCS3 guncon i spelarport 3, använd detta för att tvinga den till port 1."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Som standard kasserar RetroBat kärnspecifika inställningsfiler."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Som standard håller RetroBat installerade spel och rom-mappen synkroniserade."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "Som standard görs kalibreringen med mittersta musknappen, denna inställning låter dig välja en annan knapp för kalibreringsskottet."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Som standard sparas ändringar till diskenheten, »kassera« sparar inga ändringar."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Som standard används avtryckarknappen för att skaka, aktivera detta för att simulera sving i stället."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Kringgå mipmappning och använd alltid den skarpaste texturnivån. Bättre bildkvalitet, några få spel får renderingsproblem."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "CD32-konfiguration. Kräver både CD32-Kickstart och dess utökade ROM i bios-mappen."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "KLASSISK är den ursprungliga programvarurenderaren. POLYMOST och POLYMER använder OpenGL och stöder HD-paket."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "CPC:ns fysiska RAM-storlek i kB."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "CPU-klocka. Auto använder modellens klocka eller speldatabasen. Vissa spel (SSF2, Alltynex) tjänar på en snabbare CPU."

msgctxt "game_options"
msgid "CPU frequency multiplier. Applies only with Cycle-exact."
msgstr "Multiplikator för CPU-frekvensen. Gäller endast med Cykelexakt."

msgctxt "game_options"
msgid "Cache custom textures to system RAM on startup."
msgstr "Cacha anpassade texturer i systemets RAM vid start."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Kamerahastighet med höger analog spak eller musen."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Kan påverka prestandan på oväntade sätt."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Kan användas för att inaktivera BIOS-kontrollen av md5 om en anpassad bios används."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "Kan användas för att förbättra bildfrekvensen men kan förstöra hastigheten i vissa spel."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Kan användas för att förbättra 3D-renderingens prestanda i vissa spel."

msgctxt "game_options"
msgid "Can be used to simulate colors of particular displays."
msgstr "Kan användas för att simulera färgerna hos vissa skärmar."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Kan vara användbart för Gran Turismo, avtryckarna mappas till andra knappar."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Kan vara användbart för Gran Turismo, avtryckarna mappas till höger analog spak."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Kan vara användbart för Metal Gear, för att simulera tryckkänslighet."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Kan gynna vissa spel."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Kan orsaka diverse fel."

msgctxt "game_options"
msgid "Can fix bad memory access error with some games."
msgstr "Kan åtgärda fel med felaktig minnesåtkomst i vissa spel."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Kan åtgärda felplacerade 2D-bilder som vid val av figur i Mario Kart."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Kan åtgärda vissa buggar som förekom även på originalhårdvaran."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Kan åtgärda vissa spel vid icke-nativ upplösning genom att avrunda 2D-kanter."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Kan åtgärda vissa problem med XBOX-handkontroller."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Kan förbättra noggrannheten till en liten prestandakostnad."

msgctxt "game_options"
msgid "Can improve framerate or cause timing error."
msgstr "Kan förbättra bildfrekvensen eller orsaka timingfel."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Kan förbättra prestandan på kraftfullare grafikkort med marginal över. Fungerar endast med Vulkan-renderaren."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Kan öka prestandan på vissa svagare system."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Kan öka prestandan med ett kraftfullt grafikkort."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Kan endast användas om handkontrollen stöder rörelsestyrning."

msgctxt "game_options"
msgid "Can reduce input latency, but will inscrease CPU requirements."
msgstr "Kan minska inmatningsfördröjningen, men ökar CPU-kraven."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Kan minska hackandet vid kompilering av shaders men kan också skapa artefakter."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Kan minska fördröjningen eller ta bort nedersta raden på Wii på bekostnad av grafiska problem."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Begränsa bildfrekvensen till de ursprungliga 35 fps."

msgctxt "game_options"
msgid "Certain games require an external cartridge to run."
msgstr "Vissa spel kräver en extern kassett för att fungera."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Växla D-pad-styrningen mellan joystick och mus."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Ändra bildformat för nedre skärmen."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "Ändra bildformat för övre skärmen."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Ändra sökväg för uppackade spel (standard är »\roms\.uncompressed«)."

msgctxt "game_options"
msgid "Change the emulated audio chip model."
msgstr "Ändra modellen på det emulerade ljudchipet."

msgctxt "game_options"
msgid "Change the renderer used by the core."
msgstr "Ändra renderaren som kärnan använder."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Ändra renderaren som kärnan använder. Pistolspel fungerar endast med PROGRAMVARA."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Ändra den analoga spakens känslighet."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Ändra musens känslighet."

msgctxt "game_options"
msgid "Change this only if multiple GPU are used by your system."
msgstr "Ändra endast detta om ditt system använder flera grafikkort."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Ändra denna inställning beroende på spelets styrning, till vänster om tecknet / är originalspelets knapp för gas och broms, till höger för växlar."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Ändra denna inställning beroende på spelets styrning."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Ändra denna inställning när du stöter på instabila spel. Ju högre värde, desto bättre stabilitet kan den ge. 200μs och 400μs fungerar i regel bra för de flesta spel."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Ändrar hur emulatorns trådar fördelas över CPU-kärnorna. RPCS3-schemaläggarna kan hjälpa på CPU:er med flera CCX/CCD-kluster eller med SMT, men Operativsystem är säkrast på de flesta maskiner."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Ändrar hur pistolerna visas i Rambo."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Ändrar ljudchipet, TMSS-startskärmen och några hårdvarusärdrag."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Teckengeneratorchip. Automatisk väljer det som matchar vald maskin."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "Fusk måste placeras i mappen \bios\pcsx2\cheats."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "Fusk måste placeras i mappen »cheats\mame«."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "Fusk måste placeras i mappen »cheats\psxmame«."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Kontrollera varje ROM mot speldatabasen. Inaktivera bara för att testa en romset som inte laddas: fel ROM:ar kan krascha eller förstöra sparfiler. På som standard."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Kontrollerar om filer är skadade när ett spel startas."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Kretsuppsättning som används när en AGA-modell är vald. Sänk bara under AGA för att testa ett spel som beter sig fel på en A1200."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Välj »Trojan Phazer« för spel skrivna för den pistolen. »Ljuspenna« passar allt annat, även ritprogram."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "Välj en MSX-utökning att lägga till i den andra kassettplatsen."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Välj mellan engelsk, fransk eller spansk tangentbordslayout."

msgctxt "game_options"
msgid "Choose between various texture enhancement filters."
msgstr "Välj mellan olika filter för texturförbättring."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Välj knapp för att aktivera IR på höger spak."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Välj knapp för att simulera svinghandling med höger spak."

msgctxt "game_options"
msgid "Choose if the mouse input is active or not."
msgstr "Välj om musinmatningen är aktiv eller inte."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Välj om snabbtangenten för skärmbyte byter skärmarna permanent eller bara medan knappen hålls ned."

msgctxt "game_options"
msgid "Choose the audio driver compatible with the hardware."
msgstr "Välj den ljuddrivrutin som är kompatibel med hårdvaran."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Välj färgpalett."

msgctxt "game_options"
msgid "Choose the disposition of the emulated screens."
msgstr "Välj placeringen av de emulerade skärmarna."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Välj tillbehöret som är anslutet till handkontrollen."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Välj den andra placeringen av de emulerade skärmarna."

msgctxt "game_options"
msgid "Choose which Atari system to emulate."
msgstr "Välj vilket Atari-system som ska emuleras."

msgctxt "game_options"
msgid "Choose which color palette is going to be used"
msgstr "Välj vilken färgpalett som ska användas"

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Välj vilken färgpalett som ska användas."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Välj vilken enhet menyn för diskstyrning påverkar. De andra enheterna förblir monterade. Laddade medier använder enheten som spelet laddades i."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "Klassisk använder höger och vänster axelknapp för starka sparkar och slag, modern använder höger axelknapp och höger avtryckare."

msgctxt "game_options"
msgid "Cleans up stray black pixels."
msgstr "Rensar bort lösa svarta pixlar."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Färgpalett för originalspel till Game Boy."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Arkadskärmens färgtemperatur."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Färger för WonderSwan-spel (mono). WS-paletterna efterliknar originalskärmarna."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "Ange avståndet mellan de två skärmarna i pixlar."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "Ange synfältet (högre är bredare)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Ange fps."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Ange denna inställning om du vill växla mellan stereo- och surroundljud."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Anger hur handkontroller begärs från värden eller klienten. Nödvändigt för lokal flerspelaranslutning."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Anslut musen till port 1."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Konsolvariant som matchar vald BIOS-avbildning."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "Styr noggrannhetsnivån för GS-blandningsenheten. Högre värden emulerar blandningen mer exakt i shadern."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Styr emuleringens trilinjära texturfiltrering."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Styr hur dithering tillämpas."

msgctxt "game_options"
msgid "Controls the number of Auto-CRC fixes and hacks applied to games."
msgstr "Styr antalet automatiska CRC-korrigeringar och hacks som tillämpas på spel."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Styr detaljnivån innan programmet visas."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Konvertera uppväxling/nedväxling till växel 3/växel 4 för att simulera sekventiell växling med en vanlig växelspak."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Kopiera texturer till VRAM, långsammare men mer exakt. Inaktivera för att spara prestanda."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Kopiera färgbufferten till N64-minnet. Behövs för vissa effekter (t.ex. pausskärmar, kamerabilder). AV är snabbast men kan förstöra dem. AUTO följer prestandaläget."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Korrekt men långsammare."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Korrigera bildformatet för icke-kvadratiska pixlar."

msgctxt "game_options"
msgid "Correct the sampling of 2D sprite textures when upscaling."
msgstr "Korrigera samplingen av 2D-sprite-texturer vid uppskalning."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Beskär den eventuellt slumpmässiga, felaktiga videoutgången som skulle ha dolts av ramen runt kanten på en vanlig SD-TV-skärm."

msgctxt "game_options"
msgid "Crop out the potentially video output that would have been hidden by the bezel."
msgstr "Beskär den videoutgång som skulle ha dolts av ramen."

msgctxt "game_options"
msgid "Crop pixels around edge of screen."
msgstr "Beskär pixlar runt skärmens kant."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "Beskär bilden från dess nativa bildformat till 4:3 eller 16:9"

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "Beskär kanterna för att visa eller dölja kantgrafik."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "Beskär bilden från 256x240 till 252x239."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Gränsfrekvens för konsolens ljudutgångsfilter. 3390 Hz motsvarar de flesta Mega Drive-modeller."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "Skär bort 8 pixlar i kanterna för att ta bort Master System-kanterna."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "DIMM-kortets storlek. Auto följer spelet, lämna på Auto om inte ett spel klagar."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Dämpar följekamerans svängningar i bilspelen. Stark som standard."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Gör varannan rad mörkare för att efterlikna ett katodstrålerör."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "DeSmuME har en intern BIOS, välj detta alternativ för att använda BIOS och firmware från RetroBats bios-mapp."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Sänk om den är för känslig, att sänka för mycket kan hindra att hela omfånget nås."

msgctxt "game_options"
msgid "Default ON."
msgstr "PÅ som standard."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "Den emulerade standardhandkontrollen har 6 knappar."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Aktiverad som standard, kan ge problem i några få spel."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Standard följer EmulationStations språk."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "Standard är »HÖG«, sätt till »NORMAL« för att öka prestandan på bekostnad av noggrannheten."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "Standard är 30 sekunder, ange hur länge spelstarten ska inväntas innan du återgår till RetroBats spellista."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "Standard är AV, använd detta vid hastighetsproblem på skärmar med hög uppdateringsfrekvens."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Standard är PÅ (snabb). AV kör de riktiga DSP-programmen för geometri, mer exakt men långsammare (endast Model 1, Model 2 2B-spel)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Standard är PÅ, korrekt quad-rendering. AV renderar quads som trianglar (snabbare)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Standard är PÅ, AV kan förbättra kompatibiliteten med äldre grafikkort (endast Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "Standard är PÅ, använd denna inställning för att ta bort 60hz-gränsen, kan förstöra spel."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "På som standard, inaktivera för att visa startanimationen."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Som standard 10 bitar för DS och 16 bitar för DSi."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Som standard Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "Som standard Wii U GamePad, ändra för spel som inte accepterar Wii U GamePad i flerspelarläge."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Standard: markören dold."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Standard: aktiverad."

msgctxt "game_options"
msgid "Default: low."
msgstr "Standard: låg."

msgctxt "game_options"
msgid "Default: true"
msgstr "Standard: sant"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Standard är 60, när satt till 0 och VSYNC är aktiverat."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Ange vilken BIOS som ska användas för emuleringen."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "Ange gamepad-typ, gäller båda spelarna."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "Ange PET-datormodell."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "Ange Symbian-enheten som ska köras."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Ange knapp för att visa GamePad-skärmen, standard om ingen."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Ange hur mycket RAM den emulerade maskinen ska ha."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Ange hur markören ska visas på nedre skärmen."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Ange hur spelet anpassas eller skalas i fönstret."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Ange hur Sinden-pistolen ska konfigureras."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Ange hur GunCons A- och B-knappar (Justifierns Start och Back) ska mappas. Standard: D-pad höger/vänster med en Wiimote via DolphinBar, musknappar med andra pistoler."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "Ange hur guncon2-knapparna ska mappas."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Ange hur pekskärmen emuleras."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Ange hur din wiimote är ansluten till DolphinBar."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Ange om patchar ska tillämpas och var patchfilerna finns, »AUTO« tillämpar patchar om de ligger bredvid rom-filen med samma namn."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Ange mappning för musknapparna (vänster/höger/mitten), standard är a/ladda om/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "Ange modelltyp och region."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Ange modell, standard är BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Ange modell, standard är CPC 6128+ för GX4000."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "Ange modell, standard är Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Ange musindex för spelare 1."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "Ange musindex för spelare 2."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Ange musindex för spelare 3."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Ange musindex för spelare 4."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Ange sökväg till anpassad controls.ini-fil."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "Ange region, används för sparfiler."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Ange knappkombinationen som ska hållas in för att växla DualShock-handkontrollen mellan analogt och digitalt läge."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Ange färgpalett, Gammal NTSC återger de gamla fula japanska TV-färgerna."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "Ange den anslutna enheten som emulerar en vridratt."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Ange den anslutna enheten som emulerar en pedal."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "Ange den anslutna enheten som emulerar en positionsenhet."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "Ange den anslutna enheten som emulerar en styrkula."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "Ange den anslutna enheten som emulerar en ljuspistol."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Ange den anslutna enheten som emulerar en mus."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "Ange den anslutna enheten som emulerar en paddel."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Ange den anslutna enheten som emulerar en analog riktningsspak."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Ange typ av emulerad joystick."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Ange typ av emulerad maskin."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "Ange funktionen för höger joystick."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "Ange tangentkombinationen för att öppna diagnosmenyn."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Ange nivån på vibration och skärmskakning, aktivera skärmskakning om handkontrollen inte stöder vibration. »AUTO« aktiverar båda."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Ange var det vapen du håller placeras."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Ange mappningen av D-PAD."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Ange antalet minneskort som ska emuleras."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Ange antalet pixlar att beskära."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Ange ljudet som den emulerade mikrofonen tar emot."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "Ange typ av enhet som används för pekarrörelse."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Ange typ av skärm, ändrar färgerna."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Ange typ av emulerad handkontroll."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "Ange typ av sikte för pistoler."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Ange var mynt- och startknapparna finns."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Ange om genvägarna för »snabbspolning« växlar eller måste hållas ned."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Ange om genvägarna för »slowmotion« växlar eller måste hållas ned."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Ange vilket Game Boy-ljud som systemet matar ut."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Ange vilken analog spak som styr muspekaren."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "Ange vilken knapp som aktiverar turboläget, det är inte knappen som får turbo."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Rattens rotationsvinkel som ger fullt utslag i spelet. 270 motsvarar arkadkabinettet."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Neka skrivningar vid upptaget läge."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "Beroende på konfigurationen kan fördröjningen öka eller minska."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Enhet ansluten till Apple II:s spelport. Den analoga spaken ger stegvis paddelrörelse, D-pad går bara helt åt vänster eller höger."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Enhetstyp för spelare 2."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Endast DirectInput: använd om handkontrollerna inte styr rätt spelare."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Inaktivera XBE-signaturkontrollen vid användning av homebrew-spel."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Inaktivera Xenia Edges inställningar per spel så att RetroBats inställningar gäller."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Inaktivera kärnans säkerhetsfunktioner för att låta vissa homebrew-spel starta."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Inaktivera dithering och använd hela färginformationen med 8 bitar per kanal."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Inaktivera dimeffekter."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Inaktivera hårdvarurenderaren, kan öka kompatibiliteten."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Inaktivera tangentbordsgenvägar och ge kärnan full åtkomst till tangentbordet. Växla med tangenten »Scroll Lock«."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Inaktivera de modifier volumes som används för att rendera skuggor."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "Att inaktivera pixel-shaders kan åtgärda krascher i vissa spel, aktivera inte om spelet inte kräver det."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Inaktivera Master Systems FM-chip."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Inaktivera Visual Pinball-menyn: avslutningstangenten (X) lämnar bordet direkt."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Inaktivera den analoga utskjutaren (höger spak) och den analoga puffen (vänster spak)."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Inaktivera kontrollen av kabinettets kamera."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "Inaktivera kontrollen av artwork i mappen »saves\mame\artwork«."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "Inaktivera handkontrollsappleten som visas i flerspelarspel för att välja anslutna handkontroller."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Inaktivera menyn i spelet som öppnas med HOTKEY + ÖST eller F12."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Inaktivera detta alternativ för att centrera IR-pekaren när spaken släpps."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Inaktivera detta alternativ för att förbättra prestandan."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Inaktivera detta alternativ för att köra en .bat- eller .cmd-fil direkt utan att RetroBat försöker hitta programfilen i den."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Inaktivera detta för att mappa R2 och L2 till L- och R-knapparna (icke-digitala)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Inaktivera användningen av X-axeln för att puffa, Y-axeln för lod och Z-axeln för utskjutaren."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Inaktivera varningen vid start av spel som inte stöds fullt ut."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Inaktiverar vibrationen i handkontrollen, som standard är vibration endast aktiverad när spel och handkontroll är kompatibla."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Inaktiverar de automatiska inställningarna per spel från kärnans databas och aktiverar de manuella korrigeringarna nedan. Rekommenderas inte."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Inaktiverar rörelseinterpoleringen, en bildruta mindre fördröjning."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Inaktiverar vertex-cachen. Kan lösa saknad eller flimrande grafik. Kan försämra prestandan."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "Att inaktivera dithering kan ta bort visst brus och pixeleffekter."

msgctxt "game_options"
msgid "Disabling safe features can help various games such as Xenosaga, Kingdom Hearts..."
msgstr "Att inaktivera säkra funktioner kan hjälpa diverse spel som Xenosaga, Kingdom Hearts..."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "Att inaktivera 4MB-utökningspaketet för RAM kan vara nödvändigt för vissa spel."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Att inaktivera denna funktion minskar färgdjupet."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "Visa MAME-menyn när ett spel laddas."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "Visa SGB-ramar vid emulering av Super Game Boy."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Visa ett meddelande när en prestation låses upp. Aktiverat som standard."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Visa en liten pekare på pekskärmen."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Visa en erfarenhetsmätare ovanför bältet."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Bildformat för LaserActive-bilden, 4:3 som standard."

msgctxt "game_options"
msgid "Display crosshair if a lightgun is used."
msgstr "Visa sikte om en ljuspistol används."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Visa aktuella liv- och manavärden på kloten."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Visa skada och erfarenhet som flytande siffror."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Visa bantid, hittade hemligheter och dödade fiender."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Visning av Primeval Hunts andra skärm (pekskärm)."

msgctxt "game_options"
msgid "Display or not on-screen notifications."
msgstr "Visa eller dölj aviseringar på skärmen."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Visa skärmens kantområden. Påverkar inte F18A-utgången."

msgctxt "game_options"
msgid "Display the emulated framebuffer at a widescreen aspect ratio. Get best results with full 3D games."
msgstr "Visa den emulerade framebuffern i bredbildsformat. Bäst resultat med spel helt i 3D."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Visa spelet i 16:9. Bäst med SPELETS BILDFORMAT satt till 16/9."

msgctxt "game_options"
msgid "Display the overscan regions of the screen."
msgstr "Visa skärmens overscan-områden."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Visa skärmen på spelare 1:s VMU över spelet."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Skärm som används vid start. Kan växlas i spelet med tangenten F7 (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Visa voxelobjekt i stället för platta sprites när det finns. Aktiverat som standard."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Dither för supersamplade framebuffer-effekter."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Dithering som tillämpas på RDRAM-framebufferbilder."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Delar den interna upplösningen: med hög intern upplösning gör högre värden spelet större. Standard: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 är ett mycket mörkt spel, öka för att göra bilden ljusare."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Fördubblar den upplevda horisontella upplösningen, inte kompatibelt med supersampling."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Skala ner den uppskalade bilden (SSAA). Kräver uppskalning."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Rita omgivningen ända till banans slut i de spel som stöder det (Daytona USA). Endast Model 1 och Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Enhet som används vid diskbyte."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dubbla spakar: Robotron 2084 och Space Dungeon på höger spak. Byt portar: Wizard of Wor, Apple Panic. Joy 2B+: joysticks med flera knappar."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Duplicera bildrutor kräver Vulkan-renderaren."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Dynamisk omkompilering. De flesta spel går snabbare, vissa långsammare."

msgctxt "game_options"
msgid "Efficient graphics filters improving the rendering of games."
msgstr "Effektiva grafikfilter som förbättrar spelens rendering."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Eliminerar förvrängning och skevhet i texturer vid uppskalning."

msgctxt "game_options"
msgid "Eliminates position-dependent distortion and warping of textures."
msgstr "Eliminerar positionsberoende förvrängning och skevhet i texturer."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Emulera Buzz!-svarsknappar ovanpå dina gamepads. En handkontroll täcker 4 svarsknappar (spelare 1-4), två handkontroller täcker 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Emulera PS3:ans minnestiling. Åtgärdar grafiska fel i vissa spel till en liten prestandakostnad."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Emulera röstigenkänningsenheten (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Emulera en DJ Hero-skivspelare ovanpå dina gamepads. Krävs för DJ Hero 1 och 2."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Emulera en Guitar Hero Live-handkontroll (GHLtar) ovanpå dina gamepads. Krävs för Guitar Hero Live."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Emulera en New 3DS eller en original-3DS."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Emulera en PlayStation TV för lokalt flerspelarläge (upp till 4 handkontroller). Identiska handkontroller stöds inte, spel med pekskärm kanske inte fungerar."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Emulera en specifik rörelsestyrning. Tecknet »/« anger handlingen för vänster spak/höger spak."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Emulera en spinner-handkontroll som styrs med musrörelser. Musknapparna mappas till vänster (gul) och höger (röd) knapp."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Emulera NTSC:s vblank-frekvens på 59.94Hz i stället för 60Hz. Åtgärdar timing- och ljuddrift i vissa NTSC-spel."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Emulera tillbehöret Disney Infinity base."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Emulera Game Boy Player för att aktivera vibration i kompatibla spel."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Emulera tillbehöret LEGO Dimensions toypad."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Emulera tillbehöret Skylanders portal."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Emulera Video CD-kortet, kräver mpeg_card.bin i bios-mappen."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emulera äldre motorers beteende, krävs av vissa äldre mods och demos."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Tidsskiva för emulerade trådar. Att höja den kan hjälpa några få spel, att sänka den kan göra andra jämnare."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Emulerar LCD-genomskinlighetseffekter, men ökar rörelseoskärpan."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Emulerar PS3:ans layout för multisampling. Kan åtgärda vissa visuella artefakter i vissa spel."

msgctxt "game_options"
msgid "Emulation method used. AUTO for mixed features with max performance and compatibility."
msgstr "Emuleringsmetod som används. AUTO för blandade funktioner med maximal prestanda och kompatibilitet."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Emulatorns scanlines, syns endast i vissa spel."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Aktivera 32MB RAM-mod för Dreamcast, kan påverka kompatibiliteten."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "Aktivera start i BIOS för DSi-spel."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Aktivera CMS-emulering."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Aktivera den digitala signalprocessorn. Förbättrar ljudets noggrannhet till priset av högre prestandakrav."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Aktivera den digitala signalprocessorn. Förbättrar ljudets noggrannhet på bekostnad av prestanda."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Aktivera tjänsten Discord Rich Presence, som uppdaterar din Discord-status med spelet du spelar."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Aktivera Dolby Pro Logic II-avkodaren i kompatibla spel och för 5.1-högtalare."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Aktivera FidelityFX kontrastadaptiv skärpning."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Aktivera flyttalsenheten, oftast användbart för senare 3D-spel."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Aktivera Gravis Ultrasound-emulering."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "Aktivera HDR för HDR-kompatibla skärmar."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Aktivera IBM PS/1 Audio-emulering (inaktiverad som standard)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Aktivera Just In Time-emulering, ökar emuleringshastigheten, inte kompatibel med cykelexakt."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "Aktivera MAME:s interna ommappning av kontroller."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "Aktivera MAME-alternativet som automatiskt konfigurerar knapplayouten per spel utifrån dess interna databas."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "Aktivera MelonDS emulerade bios i stället för firmware i bios-mappen."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "Aktivera OpenGL-renderaren, RetroArch-drivrutinen måste vara satt till OpenGL."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "Aktivera NES-emulering i PAL (50Hz)."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Aktivera Sega CD:s RAM-kassett."

msgctxt "game_options"
msgid "Enable Service button to enter settings."
msgstr "Aktivera serviceknappen för att öppna inställningarna."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Aktivera Tandy Sound-emulering."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Aktivera extra utvecklar-RAM, kan förstöra spel."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Aktivera kantutjämning, jämnar ut polygonkanter."

msgctxt "game_options"
msgid "Enable blargg NTSC video filters"
msgstr "Aktivera blargg NTSC-videofilter"

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Aktivera brute force-uppskalning/nedskalning (endast 10.8.0)"

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Aktivera montering av cache"

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "Aktivera skuggor från objekt i spelet, endast kompatibelt med OpenGL."

msgctxt "game_options"
msgid "Enable certain games with support for the 3Dfx Voodoo accelerator."
msgstr "Aktivera stöd för 3Dfx Voodoo-acceleratorn i vissa spel."

msgctxt "game_options"
msgid "Enable colorization of Game Boy games."
msgstr "Aktivera färgläggning av Game Boy-spel."

msgctxt "game_options"
msgid "Enable controller's rumble effects."
msgstr "Aktivera handkontrollens vibrationseffekter."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Aktivera handkontrollens vibrationseffekter. Fungerar endast i bilspel."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Aktivera sikten i skjutspel, alternativen (DS) är endast kompatibla med DemulShooter."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Aktivera sikten i skjutspel."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Aktivera anpassad upplösning utifrån videoläget."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Aktivera dynamiska omkompilatorer som hjälper till att förbättra prestandan."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Aktivera förbättrade funktioner för DS4 och DualSense, detta förstör kompatibiliteten med emulatorer som använder dinput tills det stängs av."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Aktivera force feedback för handkontroller som stöds."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Aktivera helskärmskantutjämning i Direct3D, jämnar ut polygonkanter."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Aktivera filtret för horisontell blandning (oskärpa)."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Aktivera om ratten trycks bort från mitten i stället för mot den."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Aktivera sikte i spelet för att underlätta siktandet."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Aktivera intelligent zoomfunktion."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Aktivera ips-patchar."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "Aktivera en mindre exakt men bättre klingande ljudemulering av Namco 106 (mapper 19)."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Aktivera de manuella hacken nedan, annars tillämpas hacks automatiskt."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Aktivera rörelsestyrning (gyro) antingen med mus eller med kompatibel handkontroll."

msgctxt "game_options"
msgid "Enable multitap in port 1."
msgstr "Aktivera multitap i port 1."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Aktivera multitap i port 2."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Aktivera progressiv skanning för kompatibla spel."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Aktivera run-ahead-läget för att minska inmatningsfördröjningen."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Aktivera IBM Music Feature Card (inaktiverat som standard)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "Aktivera Master Systems FM-chip."

msgctxt "game_options"
msgid "Enable the Memory Management Unit. Required for some games."
msgstr "Aktivera minneshanteringsenheten. Krävs för vissa spel."

msgctxt "game_options"
msgid "Enable the On Screen Keyboard feature which can be activated with the L3 button."
msgstr "Aktivera skärmtangentbordet som kan aktiveras med L3-knappen."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Aktivera effekterna av fusk som aktiverats i Vita3K-gränssnittet."

msgctxt "game_options"
msgid "Enable the effects of the chosen Action Replay and Gecko codes for a game."
msgstr "Aktivera effekterna av de Action Replay- och Gecko-koder som valts för ett spel."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Aktivera emulering av Jaguar-handkontroller anslutna till Atari STE:s förbättrade joystickportar."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Använd musen för pekskärmen i stället för höger spak."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Aktivera om XInput-handkontrollernas index är omkastade."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Aktivera om handkontrollen saknar analoga avtryckare."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Aktivera om du har en gsync/freesync-skärm, kan orsaka ljudfel."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Aktivera detta alternativ vid problem med ett grafikchip från Intel."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Aktivera detta alternativ om grafik saknas eller belysningen är trasig i spelet."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Aktivera detta alternativ när du använder mamehooker med lysdioder, solenoider, vibration..."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Aktivera detta för att aktivera shaders även när RetroBat inte har någon shader inställd."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Aktivera detta för att ansluta spelare 1:s joystick i vänster port i stället för höger port."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Aktivera detta för att använda shaders som tillhandahålls av Duckstation."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Aktivera detta för att använda dina egna Project64-inställningar per spel."

msgctxt "game_options"
msgid "Enable verbose mode for debugging."
msgstr "Aktivera utförligt läge för felsökning."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Aktiverat som standard (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Aktiverat som standard, förbättrar dataöverföringen på den emulerade SIO-porten."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Aktiverat som standard."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Aktiverat som standard. Inaktiverar dithering och tvingar 24-bitars färgutgång."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Aktiverat som standard. Att inaktivera det kan förbättra prestandan men förstör vissa spel."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Aktiverat som standard. Snabbare shaders, kan orsaka sällsynta grafiska problem."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Aktiverat som standard. Åtgärdar grafiska fel i vissa spel till en liten prestandakostnad."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Aktiverat som standard. Tar bort oskärpa i vissa spel men minskar noggrannheten."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Aktiverat som standard. Ersätter spelets sprites med ett HD-paket när ett sådant finns. Omstart krävs."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Aktiverat som standard. Visa meddelanden som kommer från själva emulatorn."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Aktiverat som standard. När det är inaktiverat begränsas bildfrekvensen till 60 FPS."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Aktiverat som standard. När det är inaktiverat begränsas bildfrekvensen av spelet."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Aktiverar 60HZ-läget för att minska skärmrivning på skärmar som inte stöder mer än 60HZ."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Aktiverar automatisk mipmap-generering i Direct3D."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Aktiverar WRX hög upplösning."

msgctxt "game_options"
msgid "Enables a low pass audio filter to soften the harsh sound of some games."
msgstr "Aktiverar ett lågpassfilter för ljudet för att mjuka upp det skarpa ljudet i vissa spel."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Aktiverar anti-oskärpa-hacket, mindre exakt men gör spelen mindre suddiga."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Låter piltangenterna, CTRL och ALT fungera som joystick och avfyrningsknappar."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Aktiverar funktionen för anpassad patchning."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Aktiverar högupplöst CEL-rendering."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Gör det möjligt att växla mellan olika videosignaler."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Att aktivera detta kan orsaka vissa problem för 8BitDo-handkontroller."

msgctxt "game_options"
msgid "Enabling this will downsampling to native color depth. Disabling enable output at higher color depth."
msgstr "Om detta aktiveras nedsamplas till nativt färgdjup. Om det inaktiveras sker utgången med högre färgdjup."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Tvingar strikt efterlevnad av API-specifikationen. Kan ge sämre prestanda i vissa spel. Kan lösa sällsynta fall av saknad grafik och flimmer."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Förbättra grafikens noggrannhet till priset av högre prestandakrav."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "Förbättra skuggorna från olika objekt."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "Förbättra kvaliteten på 2D-texturer."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface."
msgstr "Förbättra kvaliteten på texturer på ytor."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Förbättra kvaliteten på texturer på ytor. Endast OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Förbättra kvaliteten på texturer på ytor. Endast Vulkan och OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Förbättringsfilter som tillämpas på texturer."

msgctxt "game_options"
msgid "Enhancement. Reduces system slowdown. Causes issues in some games."
msgstr "Förbättring. Minskar systemets slowdown. Orsakar problem i vissa spel."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Ange den lokala UDP-port som ska användas för värdskap."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Ange serveradress."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Ange de första tecknen i spelets rom som används för dataöverföring."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Ange de första tecknen i sparfilen som används för dataöverföring."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Ange pekprofil att ladda."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Miljöefterklang (EFX), aktiverad som standard."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Exakt ligger närmast konsolen och belastar grafikkortet mest. Snabb är mycket lättare. Auto väljer snabb på svaga eller instabila grafikkort."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "Kör grafik-backend i en andra tråd, förbättrar prestandan, minskar hackandet och snabbar upp shader-kompileringen."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Utöka SAMS-minneskortet till 4M."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Expansionskassett insatt i konsolen. Spel med ett känt krav åsidosätter detta automatiskt."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Experimentera med detta alternativ om din joystick driver (aktiverat som standard)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Experimentellt, endast Windows. Skyddar spelets stackdata när emulatorn hanterar minnesundantag. Kan åtgärda krascher i vissa spel. Lämna avstängt om inte ett spel kräver det."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Extra handkontroll. Lämna tomt om inte spelet ber om en."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Extra minneskort, endast //e-modeller. Några få program behöver mer än standardens 64KB."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "FM Towns muskänslighet."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Snabb approximativ kantutjämning, billigare än MSAA men suddigare."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Snabb kan förbättra prestandan men kan vara instabil med vissa drivrutiner."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "ROM för snabb diskladdning. Kräver FULL DISKSTATIONSEMULERING och JiffyDOS-ROM:arna i »bios\vice«. Används inte med band och kassetter."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Snabb är mindre exakt, ordnad och atomisk är exakt men långsammare."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Snabbare motor för DSP-emulering (experimentell). Används endast när DSP-EMULERING är aktiverad."

msgctxt "game_options"
msgid "Faster loading times but can cause issues with some games."
msgstr "Snabbare laddningstider men kan orsaka problem i vissa spel."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Snabbare sektorläsningar. Viss programvara kanske inte förväntar sig det."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Filtrera alla texturer. Även de som spelet uttryckligen anger som ofiltrerade. Inaktiverat som standard."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Filter som tillämpas på den slutliga bilden."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Filter som används för att skala bilden till skärmen."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Filter som används vid skalning av den slutliga bilden."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Filter som används när den renderade bilden är större än skärmen."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Filter som används när den renderade bilden är mindre än skärmen."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Filtrering som tillämpas på 3D-texturer."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Filtrering som tillämpas på 3D-texturer. Endast OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Filtrering som tillämpas på sprites och 2D-element."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Skjut kontinuerligt så länge knappen hålls nedtryckt."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Aktivera pistolens rekylmotor vid varje skott, för pistoler som har en. På som standard."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Passa in högupplösta spel eller bredbildsspel i en 640x480-bild med svarta kanter. Endast användbart på en 4:3 CRT-TV."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Sätt i Digital Video Cartridge (vmpega.rom i bios-mappen), krävs för FMV-spel och Video CD."

msgctxt "game_options"
msgid "Fit to the original ratio of the game."
msgstr "Anpassa till spelets ursprungliga förhållande."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Åtgärda Demul-felet (lämnar helskärm vid skott i övre vänstra hörnet) genom att blockera all musinmatning till Demuls gränssnitt."

msgctxt "game_options"
msgid "Fix issues with upscaling in Namco games (Ace Combat, Tekken, SoulCalibur...)."
msgstr "Åtgärda problem med uppskalning i Namco-spel (Ace Combat, Tekken, SoulCalibur...)."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Åtgärda slowdown med denna emulator."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Åtgärda texturkorruption och djupproblem på AMD och vissa Intel-grafikkort."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Åtgärda den banding som kan uppstå i uppskalade texturer."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Åtgärda att spelet fastnar i en loop vid uppstart."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Åtgärdar koplanär geometri och dekaler i vissa spel, kan förstöra andra."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Åtgärdar glipor mellan 2D-element."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Åtgärdar skugg- och djupartefakter i vissa spel."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Åtgärdar vissa grafiska fel med linjer."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Åtgärdar textfel i vissa spel."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Flyttalsenhet, behövs i vissa 3D-spel. På som standard med 68040 (inbyggd), av med 68030."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Mapp för Vita3K-data (firmware, installerade spel, sparfiler). Ignoreras när Vita3K är i portabelt läge (icke-tom mapp »portable« bredvid Vita3K.exe)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "Typsnitts-ROM som krävs av vissa japanska spel."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "För Bleach Blade Battlers."

msgctxt "game_options"
msgid "For Goemon."
msgstr "För Goemon."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "För Nintendo-system, byt A och B för att matcha Xbox-knapparnas namn."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "För Run Behind och M-bit Games."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "För SOCOM 2 HUD/Spy Hunter."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "För Scarface The World is Yours och Crash Tag Team Racing."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "För SegaScope 3-D-spel, visa endast ett öga i stället för det flimrande paret."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "För Superman Returns."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "För Tales of Destiny."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "För Tri-Ace-spel."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "För spel som använder ASTC-texturer, välj medel med ett grafikkort med 6GB VRAM och låg med 4GB-2GB VRAM."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "För N64-handkontroller med 2 avtryckare, använd R2 i stället för L2 som Z-knapp."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "För nostalgins skull. Som standard ser det ut som den accelererade krigsdimman i BG2"

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "För vissa emulatorer, kan användas för att åtgärda kopplingen mellan wiimote, tangentbord och mus vid användning av 2 wiimotes."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Tvinga GBC-programvara som ändrar beteende när den körs på GBA."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "Tvinga GameBoy-läge för GameBoy Color."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Tvinga P1:s handkontrollsindex, kan vara användbart om XInput-enheter inte är rätt ordnade."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "Tvinga P1:s handkontrollsindex, kan vara användbart när en handkontroll används på en arkadmaskin."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "Tvinga P2:s handkontrollsindex, kan vara användbart när en handkontroll används på en arkadmaskin."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Tvinga Rawinput, det bör inte behövas att sätta detta till PÅ."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Tvinga ett antal CPU-cykler per operation. AUTO använder standardvärdet per spel, ändra bara om ett spel inte fungerar."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Tvinga knapp i stället för axel för avtryckarna, kan hjälpa med Sony-handkontroller."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Tvinga emulatorn till helskärm även om RetroBat körs i fönster"

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Tvinga bildbegränsaren."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Tvinga hur texturer samplas. Närmaste granne håller pixlarna skarpa, linjär jämnar ut dem."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Tvinga inmatningsdrivrutin. Standard är »sdl«, »dinput« om flera pistoler är aktiverat."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Tvinga upplösningen till skärmens aktuella upplösning för spel som tillåter anpassad upplösning."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Tvinga Saturn-expansionskassett om den automatiska identifieringen misslyckas."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Tvinga Saturn-region om den automatiska identifieringen misslyckas."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Tvinga stereo på alla ROM:ar."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Tvinga vilken Game Boy-modell som ska emuleras om den automatiska identifieringen misslyckas."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Tvinga VI-uppdateringsfrekvensen. AUTO är rätt för nästan alla spel."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Tvinga den faktiska kanallayouten för utgången. LJUDKANALER anger vad spelet ser, detta avgör hur det mixas ned till din enhet. Lämna på AUTO om inte din utgångsenhet identifieras fel."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Tvinga backglass på eller av. AUTO följer SKÄRMUPPSÄTTNING (aktiverad när SKÄRMUPPSÄTTNING inte är angiven)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Tvinga det bilinjära filtreringsläget som används vid uppskalning av dirty rectangles."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Tvinga startenheten (endast 1F/2F och senare modeller)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "Tvinga konsolens region."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Tvinga konsolens region. Som standard identifieras regionen från spelet."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Tvinga den emulerade uppdateringsfrekvensen i stället för att identifiera den från det laddade spelet. Kräver omstart av kärnan."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Tvinga emulatorn att använda en specifik BIOS-fil."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches."
msgstr "Tvinga frekvensen för den emulerade CPU:n. Kan minska slowdown, men kan orsaka fel."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Tvinga frekvensen för den emulerade CPU:n. Kan minska slowdown, men kan orsaka fel. Standard är 57%."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "Tvinga frekvensen för spelets region för att undvika hastighetsproblem i emuleringen, lämna »Auto« om du inte märker hastighetsproblem."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Tvinga vilket tangentbord som ska användas om flera tangentbord är anslutna."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Tvinga minnesbankskontrollern (MBC). Ändra bara om ett spel inte körs korrekt. Kräver omstart av kärnan."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Tvinga de monokroma visningslägena, som på en grön eller bärnstensfärgad skärm från perioden."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Tvinga antalet Wiimotes som spelet upptäcker. Sätt till 1 för spel som växlar till flerspelarläge så snart flera handkontroller är anslutna."

msgctxt "game_options"
msgid "Force the region of the system."
msgstr "Tvinga systemets region."

msgctxt "game_options"
msgid "Force the rendering and display of frames to progressive mode."
msgstr "Tvinga rendering och visning av bildrutor till progressivt läge."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "Tvinga mediefilens typ"

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Tvinga användning av SDL-drivrutinen för handkontroller, ange detta om fler än 4 handkontroller används, eftersom XInput begränsar till 4 spelare."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Tvinga användning av SDL- eller DInput-drivrutinen för handkontroller, ange detta om fler än 4 handkontroller används, eftersom XInput begränsar till 4 spelare."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Tvinga användning av en specifik softlist, programvarulistan måste ligga i mappen »bios\mame\hash«."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Tvinga användning av högnivåemulering av BIOS."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Tvinga röstkassett i plats 1, kräver bios-filen »voice.zip«."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "Tvinga rattindex, kan vara användbart om RetroBat anger fel index."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "Tvingar uppdateringsfrekvensen 60Hz."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "Tvingar konsolen till PAL-läge i stället för NTSC, kan kännas trögt."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Tvingar emulering av blit och bildmanipulering på CPU:n, mer exakt i vissa fall och krävs för spel som GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Tvingar rawinput-drivrutinen vid användning av enheter som styrkulor och spinners."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Tvingar motorns kompatibilitetsnivå. Välj MBF21 för WAD-filer som kräver det."

msgctxt "game_options"
msgid "Full precision of 12-bit for the MCM5205 ADPCM can reduce whining noise during ADPCM playback."
msgstr "Full 12-bitarsprecision för MCM5205 ADPCM kan minska gnällande brus vid ADPCM-uppspelning."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Upplösning i helskärm. Som standard används skrivbordets upplösning."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Styr kameran helt med höger spak."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "GST-lägen kan öppnas av Kega och Gens, men lagrar mindre av maskinens tillstånd."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Förstärkning av drivkortets krafter. 30% som standard, 200% fördubblar dem."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Spelets upplösning. Högre värden visar mer av spelytan."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Gamepadens styrutslag i bilspel. 66% som standard, ingen effekt på en ratt."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Gamepad: handkontrollen och tangentbordet flyttar CD-i-pekaren. Mus: datorns mus flyttar pekaren (peka-och-klicka- och pistolspel), handkontrollen behåller bara sina knappar. Hotkey + L3 växlar under spelet."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Gamepads blir spelare 1, 2... och arkadspakar tilldelas de följande spelarna."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Allmänt timing-hack."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "Tyska och franska kräver en PAL-version av spelet, japanska en NTSC-version."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Ge hela tangentbordet till spelet (Scroll Lock ger det tillbaka till snabbtangenterna) och fånga musen. Gamepaden fungerar fortfarande."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Bra vid problem med cacheemuleringen."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Grafikkretsuppsättning för modellerna utan AGA. Automatisk följer vald modell, vilket nästan alltid är vad du vill ha."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Grafik-plugin som används för att rendera spelet."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Förinställning för grafikkvalitet (texturer, filtrering). AUTO väljer den utifrån mängden minne."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Påverkar CPU-prestandan kraftigt."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Förbättrar kraftigt kvaliteten på texturer som skapas med render-to-texture-effekter. Aktiverat som standard. Att inaktivera det kan undvika krascher i spel som använder anpassade texturer."

msgctxt "game_options"
msgid "Greatly inscrease the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Förbättrar kraftigt kvaliteten på texturer som skapas med render-to-texture-effekter. Aktiverat som standard. Att inaktivera det kan undvika krascher i spel som använder anpassade texturer."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Pistolspel som spelas med handkontroll (utan ljuspistol). Relativ: spaken flyttar markören. Absolut: spakens position är skärmpositionen, tillbaka till mitten när den släpps."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE är snabbt, LLE är mer exakt men kräver DSP ROM-filerna."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START skickar avslutningstangenten (X) till Visual Pinball i stället för att stänga dess fönster."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START skickar avslutningstangenten (X) till Visual Pinball i stället för att stänga dess fönster: dess meny öppnas (bordet avslutas med INAKTIVERA MENY)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 snabbsparning, START+L3 snabbladdning, START+R3 skärmbild. Aktiverat som standard."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Hack som behövs för vissa spel (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Hack som behövs för vissa spel."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Halva scanlines efterliknar en CRT-skärm. 560 x 192 ger en renare bild på en platt skärm."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Hårddiskkontroller, krävs för att köra hårddiskavbildningar .hdv och .2mg. Ändring startar om maskinen."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Dold som standard, inaktivera om ett spel inte startar korrekt."

msgctxt "game_options"
msgid "Hide in-game crosshair (game dependant)."
msgstr "Dölj siktet i spelet (beror på spelet)."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Dölj vapenmodellen i spelet (beror på spelet)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Dölj pekaren på pekskärmen när den är inaktiv (tidsgräns)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Dölj tips om shader- och PPU-kompilering."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Dölj siktet efter en stund utan att sikta eller skjuta. Det kommer tillbaka så snart du siktar igen."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Dölj bildens kanter som en TV gör, eller lägg till en kant (negativa värden)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Dölj den vita blixt som visas vid varje skott."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Högnivåemulering av vissa funktioner i Portfolio OS. Kan förbättra prestandan i vissa spel."

msgctxt "game_options"
msgid "High sound quality for games using expansion audio"
msgstr "Hög ljudkvalitet för spel som använder expansionsljud"

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "Högre noggrannhet åtgärdar fel i vissa spel på bekostnad av prestanda. Används endast om SPU-avkodaren är satt till Dynamic eller LLVM."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "Högre bildfrekvens genom bildinterpolering, begränsas av vertikal synkronisering. Kan ge mindre visuella fel eller animationsfel."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "Högre är mer exakt men långsammare."

msgctxt "game_options"
msgid "Higher values give better signal noise ratio and preservation of higher frequencies."
msgstr "Högre värden ger bättre signal-brusförhållande och bevarar höga frekvenser bättre."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "Högre värden använder mindre minne, lägre värden går snabbare."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Hastighetskorrigering för House of the Dead 4: CPU-frekvens i GHz (t.ex. 4.3). Identifieras automatiskt när den inte anges."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Hur långt en spak måste röras innan Amigan registrerar det. Höj om figuren driver av sig själv."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Hur snabbt paddeln rör sig."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Hur snabbt paddlarna rör sig när musen används som spelportsenhet."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Hur stor del av skärmbredden som för paddeln från ände till ände. Ett mindre värde gör paddeln snabbare och låter den nå sina ändlägen utan att pekaren lämnar skärmen, vilket vissa kalibreringsskärmar kräver."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Hur kraftigt spaken reagerar."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Hur TV-skärmen och GamePad-skärmen visas."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Hur handkontrollen presenteras för Amigan."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Hur handkontrollen presenteras för Amigan. »Joystick« är den klassiska spaken med 2 knappar som alla spel förstår. »CD32-handkontroll« lägger till de färgade knapparna och väljs automatiskt på CD32."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Hur bilden renderas. RGB är skarpast, komposit- och TV-lägena återger färgutflytningen hos en skärm från perioden."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Hur bilden renderas. Kompositlägena återger färgutflytningen hos en skärm från perioden, RGB är skarpast."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Hur bilden skalas till skärmen."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Hybrid ritar nya shaders direkt medan de byggs. Asynkron kan låta objekt saknas en kort stund. Synkron låter spelet vänta på varje shader."

msgctxt "game_options"
msgid "If Custom is selected it will use MesenPalette.pal as custom palette in bios directory."
msgstr "Om Anpassad väljs används MesenPalette.pal i bios-mappen som anpassad palett."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Om Av, inaktiveras det dithering-mönster som PSX använder mot färgband."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Om inaktiverat kan DualShock växlas mellan DIGITAL/ANALOG med en kombination."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Om inaktiverat kompileras dessa moduler först när de behövs. Beroende på spelet kan detta avbryta spelandet oväntat och kanske ofta."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Om flera pistolenheter är anslutna, använd detta alternativ för att konfigurera endast en pistol."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Ange vid behov vilken GBA-rom som ska användas."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Om mappnamnet innehåller »soniccd« startar RetroBat automatiskt Sonic CD RSDK, använd detta för att tvinga det."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Om joysticken är inom denna dödzon rör sig inte markören."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Om du använder en gamepad med rörelsesensor som en DualShock eller Switch Pro, aktivera detta för att använda rörelsesensorn."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Om du använder riktiga Wiimotes med en sensorstav, ange sensorstavens rätta position för bättre precision."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "Ignorera Horizon OS-tjänster, kan lösa krascher i vissa spel."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Ignorera rörelser hos den analoga spaken under denna tröskel."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "Ignorera befintliga ini-filer i mappen »bios\mame\ini«."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Ignorera små spakrörelser kring mitten. Öka när markören på skärmen driver av sig själv."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Ignorera bordets egna backglass-inställningar (.res-filen bredvid bordet) under spelet. Filen behålls och återställs vid avslut."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Ignorera inställningarna per spel som sparats i shadPS4 och använd alltid RetroBats inställningar."

msgctxt "game_options"
msgid "Improve performance at the cost of accuracy and input lag."
msgstr "Förbättra prestandan på bekostnad av noggrannhet och inmatningsfördröjning."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Förbättra prestandan för CPU:er med fler än 4 kärnor, aktiverat som standard."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Förbättrar prestandan i många spel. Att inaktivera det kan undvika grafiska fel i vissa andra spel."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "Förbättra polygonrenderingen med OpenGL-renderaren."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Förbättra shader-noggrannheten. Att inaktivera ger en liten hastighetsvinst men kan orsaka grafiska fel i vissa spel."

msgctxt "game_options"
msgid "Improve the loading of discs of the emulated game."
msgstr "Förbättra laddningen av skivor för det emulerade spelet."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements."
msgstr "Förbättra upplösningen till priset av högre prestandakrav."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Förbättra upplösningen till priset av högre prestandakrav. Endast OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Förbättra upplösningen till priset av högre prestandakrav. Kräver en Redream-nyckel."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Förbättra upplösningen till priset av högre prestandakrav. Endast Vulkan och OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Förbättrar noggrannheten i vissa spel men kan minska prestandan."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Förbättrar färgdjupet."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Förbättrar prestandan i vissa spel men hoppar över alla EFB-baserade effekter."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Förbättrar prestandan."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Förbättrar prestandan. Experimentellt med flera konsoler."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Förbättrar stabiliteten i vissa spel men minskar prestandan."

msgctxt "game_options"
msgid "Improves the data loading speed."
msgstr "Förbättrar hastigheten för dataladdning."

msgctxt "game_options"
msgid "Improves the emulation performance at the cost of accuracy."
msgstr "Förbättrar emuleringens prestanda på bekostnad av noggrannheten."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Endast i OpenGL."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "För spel med flera skivor och en .m3u-fil, ange vilket skivnummer som ska köras."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "Ökar noggrannheten, kan åtgärda vissa ljud- och hastighetsproblem."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Öka om skotten registreras något bredvid målet."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Öka om vyn eller spelaren rör sig av sig själv."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Öka om vyn eller spelaren rör sig av sig själv. Standard är 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Öka 3DFx Voodoo-upplösningen i OpenGL."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Öka antalet sprites som kan ritas samtidigt på skärmen."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Ökar RAM-användningen och den första starttiden men minskar läsningen från disk efter starten."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "Att öka värdet kan orsaka fel."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initierar färgrenderingsmål från det emulerade minnet. Behövs för att vissa spel ska renderas korrekt, kan minska prestandan. Standard av."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initierar djuprenderingsmål från det emulerade minnet. Behövs för att vissa spel ska renderas korrekt, kan minska prestandan. Standard av."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Ange servern i formatet »x.x.x.x:y«."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Sätt in MoonSound-utökningen i I/O-platsen."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Sätt in Video9000-utökningen i I/O-platsen."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Sätt in en diskett i diskettenheten, används ofta för CDROM-spel."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Installerat videochip. Automatisk använder TMS9918A om inte spelet kräver uppgraderingen F18A. Kräver omstart av kärnan."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Interpolerar ljudutgången för förbättrad kvalitet."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "Tolken har bättre kompatibilitet än JIT-omkompilatorn, JIT är snabbare."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Byt A/B- och X/Y-knapparna."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Invertera Zapperns ljussensorsignal. Behövs för viss pistolhårdvara."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Invertera Zapperns avtryckarsignal. Behövs för viss pistolhårdvara."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Invertera vertikalaxeln på gamepadens högra analoga spak."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "Invertera upp och ner för siktesstyrningen."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Inverterar att titta upp och ner (gamepad och mus)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Inverterar att titta upp och ner med gamepaden."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Inverterar att titta upp och ner med höger spak."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Inverterar vertikalaxeln vid flygning."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT är snabbast, tolken är mer exakt."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Just In Time-kompilering. Snabbar upp 68020 och senare modeller avsevärt. Ignoreras på 68000-maskiner och inaktiveras automatiskt i cykelexakt läge."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Håll DOS-skalet aktivt när spelet avslutas eller om starten misslyckas."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Behåll eller radera spelfiler efter uppackning (squashfs, 7z)"

msgctxt "game_options"
msgid "Keep the CD image in memory."
msgstr "Behåll CD-avbildningen i minnet."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Behåll det ursprungliga bildformatet i stället för att sträcka ut bilden."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Tangent som öppnar Amiberrys egen meny. F12 är den enda funktionstangent en Amiga aldrig hade, så det är den enda som förblir ledig."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Tangent som växlar mellan fönster och helskärm under emuleringen."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Tangenter som används som joystick när ingen handkontroll är ansluten. Piltangenterna skjuter med höger Ctrl. Det numeriska tangentbordet skjuter med 0 eller 5. WASD skjuter med vänster Alt."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 och R3 utför den aktuella figurens specialattacker när spelet listar dem. På som standard."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = Service, R3 = Test, för att öppna spelens operatörsmeny. På som standard."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "LLVM är snabbast, använd tolkinställningarna om det uppstår problem."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "LLVM är det snabbaste alternativet med mycket god kompatibilitet. Om du får problem, använd ASMJIT-omkompilatorn."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "Språk som spelen ska visa text på."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Språk för menyer och text i spelet. Ett språk som inte finns i spelet ignoreras och inställningen i spelet behålls."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Språk för undertexter. Ett språk som inte finns i spelet ignoreras och inställningen i spelet behålls."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Språk för röster. Ett språk som inte finns i spelet ignoreras och inställningen i spelet behålls."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Stor hastighetsökning på flerkärniga CPU:er, men ett litet antal spel hänger sig med det."

msgctxt "game_options"
msgid "Launch DemulShooter for gun games."
msgstr "Starta DemulShooter för pistolspel."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Starta MameHooker för hantering av utgångar."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Lämna »Auto« om inte identifieringen misslyckas."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Lämna AUTO som standard om inte spelet kräver en särskild inställning."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Lämna AUTO för automatisk identifiering."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Lämna auto för att automatiskt anpassa efter spelets orientering, använd denna inställning för att tvinga vid behov."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Lämna avstängt om inte synkroniseringskällan är satt till video: vsync och ljudsynkronisering fungerar dåligt tillsammans."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Lämna på AUTO för att låta emulatorn välja den första giltiga BIOS som hittas i »\bios\pcsx2\bios«."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Lämna på Automatisk för att behålla den processor som vald modell verkligen hade. En snabbare CPU kan förstöra spel som är beroende av exakt timing."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Lämna på Automatisk om inte ett spel kräver en specifik ROM. Filen måste ligga i bios-mappen. Kräver omstart av kärnan."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Lämna detta PÅ som standard för att aktivera CPU JIT-optimeringar."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Lämna detta på 16:9 om du inte har en 4:3-skärm."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Lämna detta på som standard, flera trådar används för rendering."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "MANUELL ändrar inte det användardefinierade värdet, AUTO är 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "Vänster blir höger och upp blir ner."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Låt ALTIRRA välja profilen utifrån spelet."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Låt RetroArch mappa handkontroller med sina egna autokonfigurationsprofiler i stället för RetroBats mappning. Åsidosätter RetroBats autokonfiguration."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Låt RetroBat försöka hämta startsekvensen från MAME:s hash-fil eller filnamnet (hakparenteser)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Låt RetroBat försöka hämta startsekvensen från MAME:s hash-fil."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Låt Visual Pinball själv byta till valt videoläge i stället för att ändra skrivbordets upplösning."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Låter en MegaWiFi-kassett-ROM nå ditt nätverk och internet. Aktivera endast för ROM:ar du litar på."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Låter kärnan styra takten själv i stället för att förlita sig på RetroArch. Prova »standard 50 Hz« om ett PAL-spel går ojämnt."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Låter emulatorn läsa tillbaka GS-minnet. På som standard. Att stänga av är snabbare men kan förstöra vissa grafiska effekter."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Låter vänster spak fungera som joystick utöver D-pad."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Häv spelets tak för bildfrekvensen där spelet tillåter det. Allt annat än original kan förstöra ett spel."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Koppla ihop 2 till 4 Lynx med ComLynx-kabeln på en skärm, en handkontroll var. Inaktiverar sparade lägen och prestationer."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Ladda anpassad profil för rattmappning."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Ladda mods (.dusk-filer) från en mapp med samma namn som spelet, bredvid det, eller från dusklight\data\mods om den saknas."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Ladda mods från mappen User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Ladda de mods som placerats i spelets mods-mapp (en mapp med en mod.ini per mod). På som standard."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Laddar en förinställning för grafikkvalitet (texturer, filtrering, mjuka partiklar). Lämna på AUTO för att behålla inställningarna i spelet."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Laddar de två första diskarna i ett spel med flera diskar i enhet 1 och enhet 2 samtidigt, i stället för endast enhet 1. Krävs av de få spel som ber om två enheter."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Laddar ersättningstexturerna i Data\Assets\HDTextures\<rom> i emulatorns mapp."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Laddar hela skivavbildningen i minnet. Snabbare laddning, högre RAM-användning."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Låg shader-kvalitet kan förbättra prestandan men orsaka fel."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Lägre ger mindre fördröjning, för lågt ger avbrott."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Sänk GS-precisionen för att undvika glipor mellan pixlar vid uppskalning. Åtgärdar texten i Wild Arms och spökbilder i SoulCalibur."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Lägre värden minskar ljudfördröjningen, högre värden minskar knastret."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "MSAA- eller SSAA-nivå."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Maskinens timing. 60Hz är den amerikanska maskinen, 50Hz den europeiska. Några få europeiska program behöver 50Hz för att gå i rätt hastighet. Ändring startar om maskinen."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Huvudminne. Auto använder modellens RAM eller speldatabasen. Storlekar som inte stöds avrundas uppåt till modellens nästa storlek."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "Gör warp-läget mycket snabbare genom att byta SID-emuleringen till »FastSID« under warp."

msgctxt "game_options"
msgid "Makes the emulator auto fast forward CD loading sequences."
msgstr "Låter emulatorn automatiskt snabbspola CD-laddningssekvenser."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Tilldela manuellt den handkontroll som spelaren använder. Behövs bara när RetroBat inte kan skilja två identiska handkontroller åt, t.ex. med en arkadenkoder för 2 spelare som Windows ser som en enda enhet. Lämna annars på AUTO."

msgctxt "game_options"
msgid "Manually select a 4 Player Adapter for some games"
msgstr "Välj manuellt en adapter för 4 spelare för vissa spel"

msgctxt "game_options"
msgid "Manually specify your choice of Neo Geo BIOS."
msgstr "Välj manuellt vilken Neo Geo-BIOS du vill använda."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Många spel behöver bara kopior till texturer, men om grafik är svart eller saknas kan du behöva välja kopior till RAM."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Mappa en 8BitDo M30 eller liknande handkontroll knapp för knapp, från mdControllers.json."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Mappa handkontrollen till racinghandkontroll, spel som inte var kompatibla med racingratt fungerar inte."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Mappa select till en extra knapp, användbart i Zelda-spel för att undvika att avsluta när du sparar."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Mappar avtryckarna till den analoga spakens vertikalaxel. Användbart för Gran Turismo och andra racingspel."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Matchar färgerna efter hur de ser ut på riktig hårdvara."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Matematisk samprocessor. Endast en handfull Amiga-titlar använder en, och att lägga till den i en maskin som aldrig hade den kan förvirra några få spel."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Maxhastighet för joystickens pekmarkör."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "Maximalt antal CPU-trådar för texturuppskalning. Använd totala antalet trådar minus 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Kan orsaka artefakter i vissa spel."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Kan förbättra prestandan för vissa processorer med många kärnor. Kan orsaka slowdown i vissa situationer på grund av den extra arbetstråden."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Kan minska hackandet till priset av längre väntan innan ett spel startar."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Metod för interlaced videolägen (tillämpas inte på Nintendo 64)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Metod för interlaced videolägen."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "Metod för att läsa data från skivan, sync efterliknar originalhårdvaran, async kan minska hackandet, pre-cache laddar hela avbildningen till priset av en inledande väntan."

msgctxt "game_options"
msgid "Might fix some misaligned fog, bloom or blend effect."
msgstr "Kan åtgärda vissa felplacerade dim-, bloom- eller blandningseffekter."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Efterliknar vissa famicloner som byter duty cycles för fyrkantskanalerna."

msgctxt "game_options"
msgid "Mimics the display characteristics of the Game Gear and Nomad LCD panels."
msgstr "Efterliknar visningsegenskaperna hos Game Gears och Nomads LCD-skärmar."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "Mipmappning är nödvändig för vissa spel."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Spegla världen horisontellt, som i spelets Wii-version."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C är ljudkortet som stöds av de flesta spel. Välj Mouse Card endast för programvara som behöver en riktig Apple-mus, det ersätter ljudkortet. Ändring startar om maskinen."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard är ljudkortet som stöds av de flesta spel. Ignoreras på //c-modellerna, som saknar expansionsplatser."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Läge som är förvalt på skärmen för spelarval. Download Play kräver original-BIOS och firmware."

msgctxt "game_options"
msgid "Modify the coin setting to Free Play."
msgstr "Ändra myntinställningen till Free Play."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "Monokrom krävs av högupplösta spel (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Mer exakt emulering av CD-blocket. Kräver en ROM för CD-blocket och inaktiverar inställningen för läshastighet."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "Mer exakt beteende men kan ge lägre prestanda. PÅ som standard."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "De flesta spel använder port 2, använd denna inställning för gamla spel som kräver att joysticken är ansluten i port 1."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Montera enhet C: automatiskt vid start."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Mus: spel som Elansar eller Defender of the Crown. Analog spak: BattleSphere, välj det även i spelets inställningar."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Flytta musen med en analog spak på handkontroll 1 (L2/R2 = knappar). En port måste vara satt till Mus."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Rör dig med vänster analoga spak såväl som med D-pad. På som standard."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level."
msgstr "Nivå för Multi-Sampling Anti Aliasing."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Nivå för Multi-Sampling Anti Aliasing. Endast OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Nivå för Multi-Sampling Anti Aliasing. Endast Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Multiplikator för joystickmarkörens hastighet medan knappen Speedup Pointer (L2 som standard) hålls ned."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "Multitap måste ställas in om fler än 2 spelare ska spela."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Tysta diskettenheternas mekaniska ljud."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "NEJ visar endast bilden för vänster öga. Anaglyf kräver 3D-glasögon i samma färger, sida vid sida är för VR-headset och 3D-skärmar."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC använder cdi200.rom, PAL använder cdi220b.rom."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Spelets nativa upplösning. Som standard den som är inställd i spelet."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Krävs av några få spel, däribland flera peka-och-klicka-titlar."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "Inget mynt behövs för att starta ett spel."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Antal emulerade diskettenheter. En riktig Amiga 500 hade bara en. Två enheter snabbar upp spel med flera disketter men några få titlar förväntar sig bara en."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Antal bildrutor mellan varje turbotryck."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Av som standard. Adaptiv väntar inte på skärmen när en bildruta är sen."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Av som standard: emulatorn körs själv i arkadhastighet (57.5 Hz). Aktivera om bilden rivs."

msgctxt "game_options"
msgid "Offset for the ST/UV texture coordinates."
msgstr "Förskjutning för texturkoordinaterna ST/UV."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "På en skärm med 120Hz eller mer utan G-Sync eller FreeSync, använd dess högsta uppdateringsfrekvens som är en multipel av 60Hz."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "På som standard, stäng av för att använda ljudkvaliteten 11khz."

msgctxt "game_options"
msgid "On by default."
msgstr "På som standard."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "På som standard. Stäng av för att vinna hastighet på integrerade grafikkort."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "På som standard. Stäng av när pistolen har ett eget sikte (laser, Sindens sikte)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "En pixel per spelpixel (rekommenderas för shaders)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Gäller endast när texturuppskalning (xBRZ) är aktiverad. Texturer större än detta uppskalas inte."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Endast kompatibel med ASIA/JAPAN MVS-systemet."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Endast kompatibel med OpenGL, hård synkronisering av GPU och CPU. Minskar fördröjningen till priset av högre prestandakrav."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Endast kompatibel med videodrivrutinen Software."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Gäller endast när BEGRÄNSA FPS är aktiverad. Standard: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Endast för asiatiska versioner av spelen."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Endast för nyare versioner av Ikemen GO. Vulkan är experimentell."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Endast framebuffers större än denna storlek uppskalas, kan åtgärda vissa problem i vissa spel."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Använd bara bildbegränsaren om ett spel går för snabbt utan den. Vissa spel kan krascha om bildfrekvensen är för hög. Om det händer, sätt värdet till något annat än Av."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Använd bara detta om du har två identiska handkontroller som inte identifieras korrekt. Binder handkontroller efter position i stället för namn, vilket är mindre tillförlitligt."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Använd bara detta för att skala ner fönstret när du använder uppskalning i Windows-inställningarna."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Används endast om angiven — ingen standardbild för sikte antas för P2."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Används endast när en MIDI-utgångsenhet är vald."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Version av OpenBOR-motorn som används för att köra spelet. Auto identifierar den från speldata, eller från ett byggnummer [XXXX] i filnamnet som i den fristående OpenBOR."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "OpenGL krävs för shaders och intern upplösning."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Endast OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Endast OpenGL. Åtgärdar svart skärm på vissa integrerade AMD-grafikkort, några få spel renderas felaktigt."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Öppnar ett andra fönster för GamePad-vyn."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Valfritt ljudkort (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) eller subwoofer (Gaelco-spel). Mix som standard, endast huvudkort för Star Wars Racer Arcade."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "Överklocka CPU, SA-1-chipet och Super-FX-chipet, kan minska slowdown men kan ge problem i vissa spel."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Överklocka eller underklocka båda SH-2-CPU:erna. 100 är standardhastighet."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Överklocka eller underklocka den emulerade huvud-CPU:n. Kan hjälpa till att stabilisera bildfrekvensen, men förstör vissa spel."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Överklocka det emulerade 68k-chipet för bättre bildfrekvens."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "Åsidosätt RetroBats gamepad-mappning med användarens egen mappning i emulatorns skriptmapp."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Åsidosätt bordets standardbelysning."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL körs i 50 Hz och är rätt för nästan alla europeiska Amiga-titlar. NTSC körs i 60 Hz och passar en handfull amerikanska utgåvor."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 identifierar handkontroller med sitt eget platsnummer, som inte följer RetroBats spelarordning. Automatisk tar den första den hittar, ändra om fel handkontroll svarar."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "Patcha TOS-filen för snabbare uppstart."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Sökväg till mappen där AGS WinUAE finns, om den fylls i lägger RetroBat till AGS-startaren i Amiga-systemet."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Sökväg till mappen där ExoDos finns, obligatoriskt för att RetroBat ska kunna söka efter ExoDOS-spel."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Sökväg till mappen där ExoWin3x finns, obligatoriskt för att RetroBat ska kunna söka efter ExoWin3x-spel."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Sökväg till mappen där ExoWin9x finns, obligatoriskt för att RetroBat ska kunna söka efter ExoWin9x-spel."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Per spel: varje spel har sitt eget konsolminne på 8 KB, så det kan aldrig bli fullt. Delat: ett minne för alla spel, som på en riktig spelare."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Belysning per pixel i stället för per vertex. Förbättrar kvaliteten i vissa spel."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Prestandaökning, kan också ge stabilitet i vissa spel som GT6."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Placera en anpassad siktesbild och välj den nedan."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Placera en anpassad fil »crosshair.png« i emulatorns undermapp »cross« eller välj fil nedan."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Placera en anpassad fil »crosshair.png« i emulatorns undermapp »cross«."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: tryck spaken uppåt för att stiga (i kabinettet stiger man med spaken bakåtdragen)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "Spela MVS-spel utan att behöva sätta in mynt."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Spela en varningssignal när hälsan är låg."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Spela VMU:ns pip."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Spela endast med riktiga wiimotes, andra handkontroller fungerar inte."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Antal spelare som är förvalt på skärmen för spelarval som visas vid start."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Anslut RetroPads i olika portar, användbart för adaptrar för 4 spelare."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Anslut en mus i joyporten, detta tar bort anslutna joysticks."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "Anslut ytterligare joysticks i portarna 2, 3 och 4."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "Anslut GunCon i port 2, för användning med Die Hard Trilogy."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Ansluter ett MIDI-kort och skickar dess utgång till denna Windows MIDI-enhet, numrerad som i emulatorns MIDI-inställningar. INGEN behåller det vanliga FM-ljudet."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Peka RetroArchs katalog »system« till en annan mapp."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Port 1 är alltid Wii U GamePad. En Wii Remote kan läggas till för spel som behöver en."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Port för Light Phaser. Port 1 som standard."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Port för Super Scope. Port 2 som standard."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Port för Zapper. Port 2 som standard."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Kan minska laddningstiden till priset av längre starttid."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "PowerPC-omkompilator, på som standard och mycket snabbare. Stäng av för tolken."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Förkompilera shader-cachen när spelet startar, lämna PÅ för mindre hackande i spelet."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "Precis är mest exakt och avslappnad kan öka prestandan men förstöra vissa spel."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Föredragen region. Ett spel som inte accepterar den faller tillbaka på en som det accepterar."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Förladda alla CD-spår i RAM."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Förladda anpassade texturer vid start."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Trycks för att öppna Amiberrys meny."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Trycks för att återställa Amigan."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Trycks för att visa skärmtangentbordet."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Förhindrar vissa artefakter men kan ge hårda kanter."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Förhindrar att det blandade ljudet från flera spelare överstyrs."

msgctxt "game_options"
msgid "Processor model."
msgstr "Processormodell."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Processormodell. En snabbare CPU än den riktiga maskinen kan förstöra spel som är beroende av exakt timing."

msgctxt "game_options"
msgid "Provider for the Adlib emulation. DEFAULT has good quality and low perf requirements."
msgstr "Leverantör för Adlib-emuleringen. STANDARD har god kvalitet och låga prestandakrav."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Sätter spelare 1:s handkontroll i port 1 i stället för port 2. Krävs av några få spel, däribland flera peka-och-klicka-titlar."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Bekvämlighetsjusteringar: snabb förvandling, större plånböcker, snabb klättring, omedelbar sparning, autosparning, förbättrade kartmenyer... Klassisk motsvarar GameCube-spelet. Ej angivet: Dusklights menyinställningar behålls."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD SOM TANGENTBORD: D-pad skickar piltangenterna och knapparna MELLANSLAG / RETURN, för spel utan joystickstöd."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "SPRING som standard, använd springknappen för att gå."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "ReShade används av RetroBat för att visa ramar och shaders i vissa fristående emulatorer. INAKTIVERAD: ramarna visas i stället med ett overlay-fönster. ANVÄND MIN EGEN: RetroBat installerar, ändrar eller raderar aldrig ReShade-filer i emulatormapparna."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Läs render-to-texture-resultat på CPU:n. Detta kan behövas i vissa spel men orsakar synkronisering mitt i bildrutan, så det har en enorm prestandapåverkan."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Läs skivan snabbare än konsolens enhet. Vissa spel kanske inte förväntar sig det."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Läs ini-filen i undermappen »bios«."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Läs ini-filen i mappen »bios\mame\ini«."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "Riktig Amiga-hastighet är det säkra standardvalet. Turbo laddar snabbare men kan förstöra några laddare och kopieringsskydd."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Plugin för Reality Signal Processor, tvingas till LLE när videodrivrutinen är satt till Parallel."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Plugin för Reality Signal Processor."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Rekommenderas: Linjär när Skala för sekundär skärm är under 100%."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "Omkompilatorn är snabbast, tolken är mer exakt."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "Omkompilatorn är mycket snabbare, tolken är bara användbar för felsökning. Kräver omstart."

msgctxt "game_options"
msgid "Recover significant color depth."
msgstr "Återvinn betydande färgdjup."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "Minska noggrannheten för bättre prestanda, grafikkvaliteten blir lägre."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Minska hastigheten för analog styrning, vissa spel kräver låga värden för att vara spelbara."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Minska laddningstiderna. Kan förstöra några få spel som är beroende av skivans verkliga timing."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Minska hackandet till priset av mycket längre väntan innan ett spel startar och hög GPU-användning."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Minskar VRAM-användningen på bekostnad av kvaliteten, kan öka hackandet."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Minskar klick som orsakas av stora skrivningar till DMC-kanalen. Inte exakt, kan mjuka upp vissa samplade ljud."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Minskar knaster och hackande, men kan ge en mycket märkbar försämring av ljudkvaliteten på långsammare CPU:er, lämna AUTO för att inaktivera."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Minskar flimmer."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Minskar hackandet och snabbar upp starten efter första starten."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Minskar vingliga polygoner och texturförvrängning i 3D-spel."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "Stöd för uppspelning av ReelMagic MPEG."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Fyll på bältet med drycker från inventariet."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "Uppdatera minnessidornas tillstånd för att aktivera data som skrivits av grafikkortet. (Används för »Team Ninja«-spel för att åtgärda saknade figurmodeller)."

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Region för NEC PAC-firmwaren. Japan: pac-n1.bin eller pce-lp1.bin. USA: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Region som väljs först på skivor med flera regioner."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 1."
msgstr "Mappa om sidoknappsschemat för spelare 1."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 2."
msgstr "Mappa om sidoknappsschemat för spelare 2."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Ta bort n pixlar breda kanter överst och nederst på skärmen."

msgctxt "game_options"
msgid "Remove odd composite green/blue artifacting that appears on real hardware."
msgstr "Ta bort de udda gröna/blå kompositartefakter som syns på riktig hårdvara."

msgctxt "game_options"
msgid "Remove the original sprites-per-scanline hardware limit."
msgstr "Ta bort originalhårdvarans gräns för antal sprites per scanline."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Ta bort de svarta sidofälten i vissa mellansekvenser (ultrabreda skärmar). Områden utanför originalbeskärningen kan se felaktiga ut."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Ta bort de svarta fälten upptill och nedtill vid inriktning, siktande, mellansekvenser och dialoger."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Ta bort den vita blixt som visas när man skjuter."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Tar bort en bildrutas inmatningsfördröjning, men fördubblar systemkraven."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Tar bort de svarta kanterna runt Amiga-bilden. Kraftigare inställningar skär bort mer och kan klippa kanterna i några få spel."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Tar bort bildflimret i Hummer."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Tar bort den vita blixt som visas när spelen inaktiverar 3D-renderingen."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Rendera i en multipel av N64:ans nativa upplösning. Åsidosätter inställningen för intern upplösning när den inte är AV."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Rendera Gouraud-skuggning med full precision för att minska färgband i 3D-spel."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "Emuleringsväg för render target. rtv/fbo ger bättre prestanda, rov/fsi högst noggrannhet."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Renderingsupplösning för vektorspel."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Renderar i 24-bitars färger och tar bort dithering."

msgctxt "game_options"
msgid "Replace meshed transparency by real transparency."
msgstr "Ersätt rutnätsgenomskinlighet med verklig genomskinlighet."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Ersätt originaltexturerna med ett anpassat texturpaket (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack in 'bios\dc\textures'."
msgstr "Ersätt originaltexturerna med ett anpassat texturpaket i »bios\dc\textures«."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack."
msgstr "Ersätt originaltexturerna med ett anpassat texturpaket."

msgctxt "game_options"
msgid "Replaces game's sprites by HD pack available in HdPacks bios directory."
msgstr "Ersätter spelets sprites med det HD-paket som finns i bios-mappen HdPacks."

msgctxt "game_options"
msgid "Replaces post-processing multiple paving sprites by a single fat sprite."
msgstr "Ersätter flera sammanfogade sprites i efterbehandlingen med en enda stor sprite."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Återger den riktiga hårdvarans lågpassfilter. »Emulerad« följer maskinens egen filteromkopplare."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Begär specifika platser, välj alternativet SPECIFIK PLATS ovan."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "Krävs av BASIC-program. Använder ATARIBAS.ROM när den finns, annars den inbyggda Altirra BASIC."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Krävs för Formel 1-spel."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Krävs för Paper Mario: The Thousand-Year Door."

msgctxt "game_options"
msgid "Required for certain games that use hi-res mode to produce transparency effects."
msgstr "Krävs för vissa spel som använder högupplöst läge för att skapa genomskinlighetseffekter."

msgctxt "game_options"
msgid "Required for certain visual effects."
msgstr "Krävs för vissa visuella effekter."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Krävs för att snabbtangenten för tillbakaspolning ska göra något."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Krävs för att starta spelet utan ett rörligt Cycraft-kabinett."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Krävs för att åtgärda Def Jam Icon."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Krävs för att köra vissa gamla rom-hacks, lämna avstängt för kommersiella spel."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Kräver minst »4X SSAA (ORDNAD)«. 4x-lägena kräver »16X SSAA (ORDNAD)«."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Upplösning för den emulerade videoutgången."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "Respektera bitvärdena för Non-Java Mode för vektoroperationer i PPU-backends. Ändra inte om du är osäker. Standard av."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Responskurva för joystickens pekmarkör."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "RetroBat konfigurerar endast handkontrollen för spelare 1."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "RetroBat synkroniserar sparmapparna för dolphin och libretro-dolphin."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "RetroBat använder som standard BIOS:en psxonpsp, aktivera detta alternativ för att tvinga användning av den äldre bios-filen SCPH550X."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Återanvänd shader-cachen som byggts för spelet. Auto låter emulatorn bestämma."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Växelval med höger spak i racingspel med 4 växlar. H-gate: diagonaler, som en riktig växellåda. Riktningar: upp 1, ner 2, vänster 3, höger 4. L1/R1 växlar alltid ner/upp."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Rotera bild och styrning. Som standard roteras kända spel automatiskt. MANUELL: SELECT ändrar rotationen."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "Rotera bilden för vertikala spel, aktivera för användning med mega-bezels."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Rotera bilden för vertikala spel."

msgctxt "game_options"
msgid "Rotate display for vertical screen."
msgstr "Rotera bilden för vertikal skärm."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "Rotera bilden, kan vara användbart för specifika spel som behöver vertikal visning."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Rotera frontknapparna för att ändra layouten."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Rotera Windows-visningen av spelplansskärmen under spelandet, återställs vid avslut (Visual Pinball 10.8 och senare)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Rotera utgången, för vertikala skjutspel."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Rotation som tillämpas i ytterlägena av en sving."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Kör i maxhastighet medan ett CD-ROM-spel laddas på en stillastående, tyst skärm."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Kör i maxhastighet medan en diskett eller ett band laddas, när inget ljud spelas. FULL DISKSTATIONSEMULERING krävs för disketter."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Kör i de ursprungliga 57.524 Hz i stället för 60 Hz. Kan hacka på en 60 Hz-skärm."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Spring som standard, springknappen får dig att gå. Aktiverat som standard."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Spring som standard, springknappen får dig att gå. Förbrukar uthållighet i enspelarläge."

msgctxt "game_options"
msgid "Run games faster. A powerful option for gaining performance that has no downsides some of the time. May cause various random issues caused by splitting the CPU and GPU threads onto different cores."
msgstr "Kör spelen snabbare. Ett kraftfullt alternativ för att vinna prestanda som ibland saknar nackdelar. Kan orsaka diverse slumpmässiga problem eftersom CPU- och GPU-trådarna delas upp på olika kärnor."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "Kör systemet med G7400-BIOS och funktioner."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Kör GPU och DSP snabbare. Kan höja bildfrekvensen i 3D-spel, men kan orsaka fel."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Kör två sammankopplade Game Gear sida vid sida. Spelare 1 och 2 styr skärm 1 och 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Spring utan att hålla in springknappen."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "Kör »jgenesis-gui.exe« i stället för cli-versionen."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "SDL gamepad som standard, läser gamepads med standardlayouten och övriga enheter (rattar, växelspakar, arkadenkodrar) med deras råa knappar. SDL läser alla enheter rått."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT använder Roland SC-55-soundfonten som följer med RetroBat."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "SSAA ger bättre kvalitet på bekostnad av prestanda."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "STRÄCK UT fyller hela skärmen och inaktiverar ramar."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Spara spelets tillstånd när du lämnar och återställ det vid nästa start (en fil per spel)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "Sparningar går till en kopia i sparmappen, originalavbildningen ändras aldrig. Återställning startar om från originaldisken (den gamla kopian behålls som .bak)."

msgctxt "game_options"
msgid "Saves the hiscores in supported games."
msgstr "Sparar highscores i spel som stöds."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Skala för statusraden på skärmen."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Skala bilden endast med heltal, för skarpa pixlar."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Skala bilden endast med heltal, för skarpa pixlar. Endast helskärm 1080p eller 4K på en 16:9-skärm, med en lätt beskärning upptill och nedtill."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Skalar X-koordinaterna i förhållande till skärmens mitt. Sänk om skotten hamnar för långt från siktet vid kanterna."

msgctxt "game_options"
msgid "Scales the dithern pattern to the resolution scale of the emulated GPU."
msgstr "Skalar dithering-mönstret till den emulerade GPU:ns upplösningsskala."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "Scanlines är inte kompatibla med HQ- eller xBRZ-shaders."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Scanlines, skuggmask och fosforglöd från ett katodstrålerör."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "Skärmrotation är inte kompatibel med horisontell layout."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Skärm som används för DMD på en separat skärm, samma numrering som SKÄRMINDEX. AUTO använder den minsta återstående skärmen. Kräver SKÄRMUPPSÄTTNING med 3 skärmar."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Skärm som används för backglass, samma numrering som SKÄRMINDEX. AUTO använder den största skärmen utöver spelplanen. Kräver SKÄRMUPPSÄTTNING."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Skärm som används för att visa spel (0 = primär skärm). AUTO låter emulatorn välja sin skärm."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Skärmar som flipperspelet använder (Visual Pinball 10.8 och senare). Positionerna för backglass och DMD beräknas då automatiskt. Ej angivet: SCREENRES-värdena används."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Skärmar som flipperspelet använder. Positionerna för backglass och DMD beräknas då automatiskt. Ej angivet: 1 skärm."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "Skriv 0xCD i allt allokerat heap-minne."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "Andra joysticken kan komma i konflikt med musen."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Välj »spelspecifik« för att använda den spelspecifika cfg-filen i mappen emulators\psxmame\ctrlr."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Välj typ av Amstrad Cathode Ray Tube Controller."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Välj Amstrad-modell att emulera."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Välj mus eller joypad för att styra den virtuella pekaren i spelet."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Välj NEJ för att inaktivera texturcachen."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "Välj en BigPemu-shader, endast möjligt när RetroBats shaders är satta till »ingen«."

msgctxt "game_options"
msgid "Select a bilinear filtering method."
msgstr "Välj en bilinjär filtreringsmetod."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Välj ett filter att tillämpa."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Välj en shader att tillämpa."

msgctxt "game_options"
msgid "Select a video format for output."
msgstr "Välj ett videoformat för utgången."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Välj mellan de olika handkontrollslayouterna."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "Välj den handkontrollslayout som ska användas med alternativet »Dynamisk profil«."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Välj det hörn av skärmen där tatueringen ska visas."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Välj effekt att tillämpa, detta har ingen effekt när shaders används."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Välj layout för frontknapparna."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Välj i vilken port GBA-rom ska sättas in, standard 2."

msgctxt "game_options"
msgid "Select method used to emulate the FM synthetiser."
msgstr "Välj metod för att emulera FM-syntesen."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Välj modell att emulera."

msgctxt "game_options"
msgid "Select palette for colorizing GB games when COLORIZATION is set to 'internal'."
msgstr "Välj palett för färgläggning av GB-spel när FÄRGLÄGGNING är satt till »internal«."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Välj shader att tillämpa, endast kompatibel med videodrivrutinen »bgfx«."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Välj shader att tillämpa, endast kompatibel med videodrivrutinen »openGL«."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Välj växlingsläge för BattleGear4Tuned."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "Välj GPU-plugin, RetroBats alternativ fungerar inte med ett annat plugin än standard, de kan konfigureras från emulatormappen med config.exe."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Välj IPL-BIOS för att köra ett spel beroende på dess region. Kräver »IPL_JAP.n64«, »IPL_USA.n64« och »IPL_DEV.n64« i mappen bios\Mupen64plus."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Välj enheten som läser X- och Y-koordinaterna."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "Välj drivrutinen för shaders när videodrivrutinen bgfx används."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "Välj tillbehöret som ska läggas till handkontrollen."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Välj läge för bildpresentation."

msgctxt "game_options"
msgid "Select the graphics plugin used by the emulator. Depends on hardware compatibility."
msgstr "Välj grafik-plugin som emulatorn använder. Beror på hårdvarans kompatibilitet."

msgctxt "game_options"
msgid "Select the keyboard layout."
msgstr "Välj tangentbordslayout."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Välj belysningsmodell, det äldre läget är minst krävande för grafikkortet."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Välj maskinen som ska emuleras."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Välj profilen som ska tilldelas spelaren."

msgctxt "game_options"
msgid "Select the soundfont file or interface used for MIDI output."
msgstr "Välj soundfont-fil eller gränssnitt för MIDI-utgången."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "Välj källsystemet för transfer pak mellan GB och GBC."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "Välj typ av konsol."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "Välj typ av bildinramning. Använd värdet EMUSCV för att korrigera originalkonsolens visningsfel."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "Välj typ av pistol beroende på spelet."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Välj videoläge (typ av kabel)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Välj var mynt- och startknapparna ska mappas när du spelar med ratt."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Välj var test- och serviceknapparna ska mappas när du spelar med ratt."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Välj om kryss eller cirkel är bekräftelseknappen."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "Välj vilken ljudmotor som ska användas internt."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Välj vilket färgfilter som ska tillämpas."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Välj vilket grafik-API som ska användas med texturrenderaren."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Välj vilken joystick som ska emuleras (inte kompatibel med MASTER COMPACT)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Välj vilken joystick som ska emuleras."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "Välj vilken skärm som ska visas med hybridlayouten."

msgctxt "game_options"
msgid "Selecting GBA unlocks extra features in certain GBA enhanced GBC games."
msgstr "Att välja GBA låser upp extra funktioner i vissa GBC-spel med GBA-förbättringar."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Skicka hela rom-sökvägen till MAME i stället för bara ROM-namnet."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Skicka utgångar för lampor och drivkort till externa verktyg (MAMEHooker...) med Windows-meddelanden."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Skicka utgångar för lampor och pistolrekyl till externa verktyg (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Skicka utgångar för lampor, pistolvibration och drivkort till externa verktyg (Hook Of The Reaper, QMamehook...) med MAME:s nätverksprotokoll."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Känslighet för den emulerade spinner-handkontrollen."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Ange en standard-ISO, för användning med vissa homebrew-spel."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Ange standardmappning av handkontroll för spelare 1."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Ange standardmappning av handkontroll för spelare 2."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Ange standardmappning av handkontroll."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Ange licensmask för aktiverat innehåll (ALLA LICENSER är i regel en dålig idé, kan leda till odefinierat beteende)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content."
msgstr "Ange skalningsfilter för renderat innehåll."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Ange skalningsfilter för renderat innehåll. FSR kräver Vulkan."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Ange skalningsfilter för renderat innehåll. Endast OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Ställ in Atari 2600:s svårighetsomkopplare."

msgctxt "game_options"
msgid "Set the adress, interrupt, low 8 bit and high 16 bit DMA."
msgstr "Ange adress, avbrott, låg 8-bitars och hög 16-bitars DMA."

msgctxt "game_options"
msgid "Set the amount of extra columns to draw for widescreen."
msgstr "Ange antalet extra kolumner att rita för widescreen."

msgctxt "game_options"
msgid "Set the aspect ratio of the FMV cinematics."
msgstr "Ange bildformatet för FMV-filmsekvenserna."

msgctxt "game_options"
msgid "Set the behavior of the start menu when autostarted game exit."
msgstr "Ange startmenyns beteende när ett autostartat spel avslutas."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Ange mikrofonknappens beteende."

msgctxt "game_options"
msgid "Set the bottom screen as prominent."
msgstr "Gör den nedre skärmen framträdande."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Ställ in konsolen på widescreen, för spel som stöder det."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Ange värdens uppdateringsfrekvens."

msgctxt "game_options"
msgid "Set the volume of the emulated floppy sound."
msgstr "Ange volymen för det emulerade diskettljudet."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Ange detta för spel som kräver handkontroll i port 2."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Slå på detta när du använder flera pistoler. Standard är på om flera pistoler hittas och inmatningsdrivrutinen inte är satt till »sdl«."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Ange detta alternativ endast när du använder en riktig balansbräda."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Ange detta alternativ för att sätta mikrofonen i plats B."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Sätt detta till »PÅ« för att avsluta Steam eller Epic Games Launcher när spelet avslutas."

msgctxt "game_options"
msgid "Set this to effectively halve monitor refresh rate."
msgstr "Ange detta för att i praktiken halvera skärmens uppdateringsfrekvens."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Ange detta för att ansluta GunCon till port 2, används för vissa versioner av Die Hard."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Ange detta för att använda den ursprungliga PSX-handkontrollen i stället för DualShock."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Sätt till JA för att återgå till friläge i bilspel när växeltangenten släpps."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Anger ljusstyrkeförskjutningen för den emulerade LCD-skärmen."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Anger kontrastnivån för den emulerade LCD-skärmen."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Anger PowerPC-frekvensen i MHz. 0 (standard) använder spelkortets frekvens."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Anger PowerPC-frekvensen i MHz. AUTO använder spelhårdvarans frekvens (endast Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "Anger PowerPC-frekvensen i MHz. Standard är 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Anger dödzonen för gamepadens analoga spakar när inmatningsenhetens typ är satt till »Klassisk gamepad« eller »Modern gamepad«."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Anger dödzonen för gamepadens analoga spakar."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Anger dödzonen för gamepadens analoga avtryckare."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Anger dödzonen för de analoga spakarna. Används endast med handkontrollstypen »Modern gamepad«."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Anger spelarens handkontrollstyp."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Anger de analoga spakarnas känslighet."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "Värdet 0 innebär att allt rapporteras som skymt, krävs för Forza Motorsport 4."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Värdet 1 kan öka prestandan."

msgctxt "game_options"
msgid "Setting this too high may cause sample clipping."
msgstr "För högt värde kan orsaka klippning av samples."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Pixlarnas form: kvadratiska eller som på originalskärmen."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Formen på skuggmasken som CRT-shadern ritar. Används endast när shadern är satt till CRT-mask."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Delad CMOS för allt innehåll som standard, eller en per spel (bättre för nätspel)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "Skärpningsstyrka som tillämpas av FidelityFX CAS. Används endast när skalningsfiltret är satt till FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Korta meddelanden på skärmen (läge sparat...). På som standard."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Visa Dolphins gränssnitt utöver spelskärmen."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "Visa FPS-overlay i spelet."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Visa Ryujinx felsökningskonsol."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Visa en styrningsbild ovanpå ramen."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Visa en avisering när en handkontroll ansluts eller kopplas från."

msgctxt "game_options"
msgid "Show core specific notifications."
msgstr "Visa kärnspecifika aviseringar."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Visa emulatorns gränssnitt."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Visa emulatorns aviseringar, aktiverat som standard (AUTO)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Visa emulatorns aviseringar."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Visa spelinformation i övre vänstra hörnet av Craft."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Visa information om shader-kompilering."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Visa information om aktuell skärmlayout i övre högra hörnet."

msgctxt "game_options"
msgid "Show notifications."
msgstr "Visa aviseringar."

msgctxt "game_options"
msgid "Show or crop overscan. 'Auto' will try to adapt to game, cropping empty areas."
msgstr "Visa eller beskär overscan. »Auto« försöker anpassa sig efter spelet och beskär tomma områden."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "Visa eller dölj RetroArch-inställningar. »Auto« är den rekommenderade inställningen."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Visa overlay med prestandastatistik i spelet."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Visa aviseringar om shader-kompilering."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Visa de horisontella kanterna. AUTO beskär dem till området som spelet använder, bäst med DOT CLOCK PAR."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Visar ett Amiga-tangentbord längst ned på skärmen för att skriva med handkontrollen. Växla med en tilldelad knapp, flytta med D-pad eller spak, tryck på en annan knapp för att skriva tangenten."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Visar kulhål i väggarna där skotten träffar."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Visar enhetsaktivitet och prestandainformation över bilden."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "Visar utökade PAL CRT-rader, men de är vanligtvis tomma i de flesta spel."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Visar disketternas namn, enhetslampor och hastighet, i fönster och helskärm."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Visar WHDLoad-konfigurationsskärmen när ett spel stöder det."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Visar WHDLoad-prompten och väntar på ett knapptryck innan spelet startar. Av som standard så att spelet startar direkt."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Krymp/förstora tatueringen för att passa inom ramens kant."

msgctxt "game_options"
msgid "Significantly improves performances for CPU with 3+ cores."
msgstr "Förbättrar prestandan avsevärt för CPU:er med 3+ kärnor."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "Simulera spökbildseffekter från CRT-fosfor. »Enkel« gör en 50:50-blandning av aktuell och föregående bildruta."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "Simulera spökbildseffekter hos LCD-skärmar."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Simulera effekter som är specifika för PowerVR2-grafikkortet och analoga videosignaler."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simulera färgerna hos Game Boy Colors LCD-skärm."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "Simulerar CRT-spökbildseffekten, kan användas för att undvika flimmer."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Simulerar spökbilder, kan hjälpa till att minska flimmer."

msgctxt "game_options"
msgid "Simulates stereo output."
msgstr "Simulerar stereoutgång."

msgctxt "game_options"
msgid "Single Field applies a de-interlacing filter, Double Field mimics the original hardware."
msgstr "Enkelt fält tillämpar ett avflätningsfilter, Dubbelt fält efterliknar originalhårdvaran."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Storlek på menyer och paneler. Begränsas av spelet till den största skala som ryms i den interna upplösningen."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Storlek på spelets pixlar: högre värden zoomar in och visar en mindre del av kartan. Standard: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "Storlek på den största skärmen med en hybridlayout."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Storlek på den sekundära skärmen i förhållande till den primära (endast layouterna Topp/Botten)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Fönstrets storlek när det inte är i helskärm."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Storleksförhållande mellan de 2 emulerade skärmarna."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "Hoppa över VBI när lagg upptäcks, hjälper mot hackande ljud när emuleringshastigheten sjunker."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Hoppa över att rita en bildruta som är identisk med den föregående. Kan förbättra prestandan."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Hoppa över bildrutor för att undvika knastrande ljud på långsamma enheter."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Hoppa över bildrutor för att förbättra prestandan, på bekostnad av ryckig rörelse."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Hoppa över väntan på 60 sekunder på andra kabinett vid start. Inaktivera för spel med flera kabinett."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "Hoppa över BIOS-startlogotypen."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Hoppa över startkontrollen som hindrar spelet från att starta."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Hoppa över hårdvarukontrollerna vid start (kamera, ratt, kortläsare)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Hoppa över den långa initieringen av styrmotorn vid start. Välj revisionen av ditt spel."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Hoppa över diskettenhetens mekaniska väntetid. Laddningen går mycket snabbare, disketten läses fortfarande exakt som originalet."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Hoppa över startvideor och logotyp."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Hoppa över startvideorna."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Hoppa över initieringen av styrmotorn vid start."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Hoppa över videor/FMV."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "Hoppar över ritning av ytor för området som anges till vänster och höger."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Hoppar över BIOS-startanimationen som visas när innehåll laddas."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Hoppar över BIOS-startanimationen som visas när innehåll laddas. Stäng av för att nå PS2:ans systeminställningar och minneskortshanteraren."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Hoppar över BIOS-startanimationen när innehåll laddas."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Plats som diskavbildningarna monteras i. AUTO väljer den utifrån avbildningstypen. Ändra bara om ett spel vägrar starta."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Långsammare, men krävs av några få spel som är beroende av cachebeteendet."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Jämna ut 3D-texturer."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Jämnar ut förändringar i styrningen. Behövs vid användning av gamepad eller tangentbord."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Jämnar ut kanterna med en shader, mjukar upp bilden något."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Jämnar ut ljudet som Paula-chipet producerar. »Sinc« är det mest förfinade och det mest krävande."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Mjukar upp gamepad-styrningen i bilspel. Stark som standard, ingen effekt på en ratt."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Vissa SPU-steg är känsliga för kapplöpningsvillkor, och att tillåta ett begränsat antal åt gången hjälper mot prestandastopp. Ett lägre värde kan förbättra prestandan och minska hackandet i vissa spel."

msgctxt "game_options"
msgid "Some games accept input from port 2 instead of port 1."
msgstr "Vissa spel accepterar inmatning från port 2 i stället för port 1."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Vissa spel laddas inte om systemet startas med en CD isatt. »JA« sätter in CD:n under startanimationen."

msgctxt "game_options"
msgid "Some games have graphic and/or speed issues without Cycle-exact."
msgstr "Vissa spel har grafik- och/eller hastighetsproblem utan Cykelexakt."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Vissa spel behöver en specifik tangent för att utföra vissa handlingar, ange tangenten som ska mappas till SELECT-knappen på spelare 1:s handkontroll."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Vissa spel kräver inverterad axel för pistoler."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Vissa spel kräver tillägget Game Drive."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Vissa spel kräver handkontrollen i andra porten för att kasta granater."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Vissa växelspakar är anslutna till datorn med ett annat enhets-ID än ratten, t.ex. Thrustmaster-spakar."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Vissa homebrews och ROM-hacks kräver ett specifikt RAM-mönster vid start. Omstart krävs."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be disabled."
msgstr "Vissa homebrews eller rom-hacks kräver att detta alternativ är inaktiverat."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Vissa homebrews eller rom-hacks kräver att detta alternativ är aktiverat."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "Ljudkälla för MIDI-musik. MT-32-alternativen kräver motsvarande Roland-ROM:ar i bios-mappen."

msgctxt "game_options"
msgid "Space/Enter/Fire works as WHDLoad start button."
msgstr "Mellanslag/Enter/Skjut fungerar som WHDLoads startknapp."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Anger hur emuleringen av realtidsklockan i vissa spel ska fungera."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Anger vilket tillägg som ska användas för uppspelning av ljud-CD med patchade MD-spel."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Ange IPS-patch som ska aktiveras, om den inte anges används alla patchar som definieras i ips .ini."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Ange filter för uppskalning."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Ange sökväg till ramen."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Ange sökväg till firmware-filen."

msgctxt "game_options"
msgid "Specify the Amiga system model to emulate."
msgstr "Ange vilken Amiga-systemmodell som ska emuleras."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Ange vilken datormodell som ska emuleras."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "Ange metod för videorendering. Exakt är mest precis men långsammare, bra och snabb är snabbare men kan misslyckas i vissa spel."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Talmodul installerad."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Hastighetshack, men kanske inte kompatibelt med vissa spel."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Hastighetshack, kan hjälpa långsamma spel på bekostnad av fel."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Hastighetshack."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Hastighet för musen som styrs med analog spak."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Hastighet för den emulerade Amiga-musen."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Hastighet för muspekaren som flyttas med vänster spak."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Snabba upp GD-ROM-laddningen, kan förstöra vissa spel."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Snabba upp diskladdningen. Kan förstöra vissa kopieringsskyddade spel."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Snabbar upp diskettåtkomsten för att minska laddningstiderna."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Delar upp renderingen på flera CPU-trådar. Endast användbart med höga interna upplösningar."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Låt ratten fjädra tillbaka till mitten medan spelet inte skickar force feedback, som den mekaniska fjädern i ett arkadkabinett."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Standardkort för diskettkontroller."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Starta direkt i Commodore 64-läge."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Starta handkontrollen med spakarna redan aktiverade, i stället för att behöva trycka på ANALOG-knappen i spelet."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Starta skivan direkt i stället för att vänta i PLAY CD-I-menyn. På som standard."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Starta spelet i testläge. Test: tangent 0 eller R3, service: tangent 9 eller L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Startar Outrun 2 SP SDX utan kabinettkontrollerna (drivkort och torn)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Startar Wii-menyn (menyn måste vara installerad i Dolphin)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Dödzon för styraxeln, för handkontroller eller rattar utan självcentrering."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Lagra BC1-texturer i 16 bitar. Sparar videominne till en liten kvalitetskostnad."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Styrka för handkontrollens vibration. 60% som standard."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Styrka för pistolens rekylmotor. 60% som standard."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Sträck ut menyer och 2D-skärmar till hela skärmbredden."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Sträck ut pixlar vertikalt som i det ursprungliga DOS-spelet på en 4:3-skärm. Standard: aktiverat."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Sträck ut bilden så att den fyller skärmen, utan hänsyn till bildformatet."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Sträck ut bilden över hela skärmen i stället för att behålla formen hos en skärm från perioden."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Studio: TV-nivåer från en riktig spelare, svart ser mörkgrått ut på en datorskärm. Fullt omfång: djup svart."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Supersampla framebuffer-effekter, kan ge artefakter."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Surround spelar de bakre högtalarna från Model 3-kabinetten med fyra högtalare (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) på bakre högtalare. Övriga spel förblir i stereo."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Byt paddel 1 och paddel 2, krävs av några få spel som förväntar sig axlarna omvända."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Byt handkontrollens A- och B-knappar."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Byt handkontrollens A/B- och X/Y-knappar."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Byt TV- och GamePad-skärmarna i layouterna sida vid sida, topp/botten och bild i bild."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Byter de två Amiga-portarna. Krävs av några få spel, däribland flera peka-och-klicka-titlar."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Byt pistolindex mellan spelare 1 och spelare 2."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Aktivera för att använda RetroBats mapp »saves\switch« för sparfiler från Citron och Eden (i stället för emulatormappen)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Byt spelare 1:s handkontrollstyp till ingen om rätt tangentbordsinmatning inte läses."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Aktivera detta för att öppna servicemenyn via knapparna R3 och L3."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Aktivera detta för att öppna servicemenyn."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Aktivera detta för att använda D-pad i stället för vänster analoga spak."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Aktivera detta alternativ för att inaktivera helskärm och köra emulatorn i fönsterläge."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Ändra detta för att använda ljuspistol 1 för spelare 2 och ljuspistol 2 för spelare 1."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Att aktivera detta med ett särskilt avflätningsläge kan hjälpa till att minska oskärpan."

msgctxt "game_options"
msgid "Sync to exact content framerate. Only for G-Sync/FreeSync/HDMI-2.1-VRR compatible monitors."
msgstr "Synkronisera med innehållets exakta bildfrekvens. Endast för skärmar som är kompatibla med G-Sync/FreeSync/HDMI-2.1-VRR."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "Systemkort som används av de LD-ROM2-spel som behöver ett. Standard: SYSTEM CARD 1 om syscard1.pce finns i bios-mappen."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "Anslutningsadapter för TI-99 Speech Synthesizer."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "TOS 1.06 är endast för STE: om maskintypen inte är angiven väljs STE automatiskt."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Sikta på 60fps i stället för de nativa 59.73fps."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 spelare i White Men Can't Jump och NBA Jam T.E. Roterande: Tempest 2000, styrs med musen."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "Amigan skickar sina kanaler helt till vänster och helt till höger. Att sänka detta blandar dem och är mycket bekvämare med hörlurar. 10 är originalhårdvarans beteende."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "Amigan skickar sina kanaler helt till vänster och helt till höger. Att sänka detta blandar dem och är mycket bekvämare med hörlurar. 100% är originalhårdvarans beteende."

msgctxt "game_options"
msgid "The CGA variation that is being emulated."
msgstr "Den CGA-variant som emuleras."

msgctxt "game_options"
msgid "The Neo Geo CD bios used by the emulator."
msgstr "Neo Geo CD-bios som emulatorn använder."

msgctxt "game_options"
msgid "The Neo Geo bios used by the emulator. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Neo Geo-bios som emulatorn använder. UNIVERSE BIOS ger i allmänhet bäst kompatibilitet."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Neo Geo-läget. UNIVERSE BIOS ger i allmänhet bäst kompatibilitet."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "RetroBat-teamet har förberett profiler för några vanliga handkontroller, de finns i mappen »saves\mame\ctrlr«. ANPASSAD kan användas för att spara egna mappningar."

msgctxt "game_options"
msgid "The SVGA variation that is being emulated."
msgstr "Den SVGA-variant som emuleras."

msgctxt "game_options"
msgid "The SoundBlaster emulated FM synth mode."
msgstr "SoundBlasters emulerade FM-syntläge."

msgctxt "game_options"
msgid "The amount of high memory size the emulated machine has."
msgstr "Storleken på den emulerade maskinens höga minne."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "Mängden videominne."

msgctxt "game_options"
msgid "The aspect ratio that's used by the Widescreen Hack."
msgstr "Bildformatet som widescreen-hacket använder."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "Den bios som emulatorn använder."

msgctxt "game_options"
msgid "The color scheme for Hercules emulation."
msgstr "Färgschemat för Hercules-emulering."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "Drivrutinen »xinput« aktiverar funktioner som vibrationseffekter. Välj »sdl« för kompatibilitet med ett brett utbud av handkontroller."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "Spelets region måste matcha Wii-menyns region, annars känns spelet inte igen."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Ju högre värde, desto längre bort visas objekt."

msgctxt "game_options"
msgid "The maximum RAM memory available for the system."
msgstr "Det maximala RAM-minnet som är tillgängligt för systemet."

msgctxt "game_options"
msgid "The normal core can be more stable when running installed OS."
msgstr "Den normala kärnan kan vara stabilare när ett installerat OS körs."

msgctxt "game_options"
msgid "The raw performance to emulate."
msgstr "Den råa prestanda som ska emuleras."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "Spelare 1:s högra analoga spak styr den andra joysticken, för spel med dubbla spakar (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "Höger spak används som höger D-pad (även på L2, R2, L3 och R3)."

msgctxt "game_options"
msgid "The type of emulated graphic chip."
msgstr "Typ av emulerat grafikchip."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "I vissa spel finns ett fel där mer än 1 aktiv enhet får emulatorn att krascha."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Tjocklek på den vita kant som ritas när en Sinden-pistol är ansluten. Normal (12 pixlar) som standard."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Användbart i bilspel för att göra styrningen mindre »ryckig« när en handkontroll används för att styra."

msgctxt "game_options"
msgid "This option can be used to override PAL timings to run games with NTSC timings."
msgstr "Detta alternativ kan användas för att åsidosätta PAL-timing och köra spel med NTSC-timing."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Detta alternativ ändrar Yamaha-ljudkortet i den emulerade datorn. OPN är standard. OPNA-ljud stöder fler FM-kanaler och PCM-samples."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Detta alternativ styr SPU-analysatorn, särskilt storleken på kompilerade enheter. Använd säkert läge för maximal kompatibilitet."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "Detta alternativ måste vara inaktiverat för att spela SIGIL."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Detta alternativ påverkar endast GameCube-handkontrollen."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Detta alternativ väljer om PCG-8100 ska emuleras eller inte. Kan krävas för viss programvara i PC-8000-serien."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Detta alternativ anger CPU-klockfrekvensen för den emulerade datorn."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Detta alternativ anger CPU-klockfrekvensen för den emulerade datorn. Överklockningsalternativen får det mesta av programvaran att gå snabbare än normalt."

msgctxt "game_options"
msgid "This option specifies which lock-on cartridge to emulate."
msgstr "Detta alternativ anger vilken lock-on-kassett som ska emuleras."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "Denna inställning kan endast användas med filtret »scanlines«."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Denna inställning förhindrar paus i emuleringen när fokus förloras."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Denna inställning roterar ditt Windows-skrivbord, det återställs inte när spelet avslutas."

msgctxt "game_options"
msgid "This should only be disabled when playing ROM hacks."
msgstr "Bör endast inaktiveras när du spelar ROM-hacks."

msgctxt "game_options"
msgid "This should only be disabled when playing certain demos and homebrews for correct operation."
msgstr "Bör endast inaktiveras när du spelar vissa demos och homebrews för att de ska fungera korrekt."

msgctxt "game_options"
msgid "This will replace the BIOS CD-ROM busy loop with a STOP instruction."
msgstr "Ersätter BIOS:ens upptagetloop för CD-ROM med en STOP-instruktion."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Kör spelet utan några valda grafik- eller CPU-förbättringar."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "Kör konsolens BIOS i stället för ett spel."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Tröskel där den analoga spakens rörelse räknas som en digital riktning."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Sänk dynamiskt antalet emulerade CPU-cykler om värdens CPU inte hänger med (inaktiverat som standard)"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Lutningsinmatning för Kirby Tilt 'n' Tumble och andra MBC7-spel. Analog spak som standard."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "Trapdoor-utökning av RAM, som i den klassiska A501-utökningen."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Försök köra spelets installation."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Försök identifiera loopvillkor i SPU-kärnor och använd dem som tips för schemaläggningen. Standard av"

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "Försök identifiera spelet och tillämpa en mappning av handkontrollen."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Försök välja den bästa uppdateringsfrekvensen för ROM:en."

msgctxt "game_options"
msgid "Try to use legacy dosbox.conf config file instead of core options."
msgstr "Försök använda den äldre konfigurationsfilen dosbox.conf i stället för kärnalternativen."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "TurboTap krävs för att spela med mer än en spelare. Aktiveras automatiskt när en andra handkontroll ansluts."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Aktivera emulatorns aviseringar: anslutna handkontroller och meddelanden om shader-kompilering."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Svänghastighet med musen. Standard: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Aktivera detta för att endast mappa D-PAD för riktningar."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Aktivera detta när du använder en ljuspistol som inte stöder omladdning utanför skärmen."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "Om detta alternativ aktiveras rapporterar MAME musrörelser och knapptryck från olika möss oberoende av varandra."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Gör höger spak till en Amiga-mus, användbart i menystyrda spel och peka-och-klicka-spel utan att släppa handkontrollen."

msgctxt "game_options"
msgid "Tweak the behavior of the 3Dfx Voodoo emulation."
msgstr "Justera beteendet hos 3Dfx Voodoo-emuleringen."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Två lager som standard (bitexakt). Sorterad åtgärdar staplad rök och glas, schackrutor återger arkadkortet (snö och dimma i Sega Rally 2)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Typ av APPLE II att emulera."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Typ av Archimedes-dator att emulera."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Typ av BBC micro att emulera, standard är MODEL B."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Typ av CPU-emuleringskärna som ska användas."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Typ av Color Computer att emulera, standard är coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Typ av dator att emulera."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Typ av FM Towns att emulera, standard är FM TOWNS (MODEL 1/2)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Typ av FM-7 att emulera, standard är FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "Typ av frameskip."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Typ av LYNX att emulera, standard är 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "Typ av ROM-fil"

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Typ av V.Smile att emulera."

msgctxt "game_options"
msgid "Type of emulated SoundBlaster card."
msgstr "Typ av emulerat SoundBlaster-kort."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "Typ av joystick ansluten till spelporten."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Häver spelets tak för bildfrekvensen om en patch hittas i den interna databasen."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Lås upp ytterligare språk i vissa spel om kärnans databas har en post för det."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Höj CPU-frekvensen från 93.75 till 125 MHz. Kan öka hastigheten i vissa CPU-beroende spel."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Uppskala spelets texturer med ett pixel art-filter."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Uppskalningsfilter för 2D-lagren (HUD, bakgrunder)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Uppskalningsfilter för 2D-lagren (HUD, bakgrunder). Endast Vulkan och OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Använd »SYD« för A-knappen och »VÄST« för B-knappen."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Använd mappen »cfg64« för MAME standalone."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Använd »anpassat« sikte för att aktivera vald siktesfil."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Använd »anpassat« sikte för att aktivera filen som väljs här."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Använd »per spel« om du har sparat en profil för spelet i mappen capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Använd 50 för europeisk konsol och 60 för japansk konsol."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Använd 8mhz för bättre kompatibilitet."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Använd den analoga spaken som D-PAD."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Använd DSI för DSi-spel som DSiWare."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Använd ENDAST JOYSTICK för joystickspel och ENDAST TANGENTBORD för tangentbordsspel."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Använd vänster analoga spak i stället för D-PAD för styrning."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Använd R1 och L1 för att gasa och bromsa i racingspel, endast kompatibelt med »auto«-växling."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Använd Resizable BAR för GPU-uppladdningar när det finns. Inaktivera om du upplever hackande eller instabilitet med din drivrutin."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Använd SDL för alla handkontroller i stället för XInput för Xbox-handkontroller."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Använd SGB2:s timing och beteende."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Använd SSE4 i stället för AVX2 för äldre CPU:er."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Använd ett högupplöst filter för att förbättra renderingen."

msgctxt "game_options"
msgid "Use a mouse-controlled Lightgun or Touchscreen input."
msgstr "Använd en musstyrd ljuspistol eller pekskärmsinmatning."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Använd en fördefinierad färgpalett i stället för den som emulatorn beräknar."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Använd alternativ djupbehandling, aktivera om det finns grafikproblem eller ett specifikt felmeddelande."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Använd ampersand och parentleft för start och mynt."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Använd en extern firmware (standard är »firmware.bin« i bios-mappen)."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Använd den analoga spaken i stället för D-pad."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Använd bilinjär filtrering för att jämna ut hela bilden."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Använd bios för vissa system som Neo Geo och Sega ST-V"

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Använd en knapp för omladdning i stället för skott utanför skärmen för pistoler som inte stöder skott utanför skärmen."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Använd knappar i stället för en analog axel för ratten."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Använd datorns standardenhet för ljudinmatning som mikrofon."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Använd hat för rörelse utöver joysticken."

msgctxt "game_options"
msgid "Use input directly sends by keyboard to the core."
msgstr "Använd inmatning som skickas direkt från tangentbordet till kärnan."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Använd tolken för bäst kompatibilitet, dynarec för prestanda."

msgctxt "game_options"
msgid "Use interpreter for best compatibility."
msgstr "Använd tolken för bäst kompatibilitet."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Använd vänster analoga spak utöver D-pad."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Använd vänster analoga spak i stället för D-PAD."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "Använd vänster spak som D-pad."

msgctxt "game_options"
msgid "Use native texture LOD computation when upscaling."
msgstr "Använd nativ beräkning av textur-LOD vid uppskalning."

msgctxt "game_options"
msgid "Use official BIOS and bootloader for emulated hardware."
msgstr "Använd officiell BIOS och starthanterare för den emulerade hårdvaran."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Använd ett delat minneskort för alla spel i stället för ett kort per spel. Korten lagras i »\bios\pcsx2\memcards«."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Använd pixelexakt emulering där det finns."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Använd portarna 5-8 för GameCube-handkontroller i Wii-läge."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Använd preemptiva bildrutor i stället för run-ahead, antalet run-ahead-bildrutor gäller."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Använd riktiga GameCube-handkontroller via en GameCube-adapter. Endast med riktiga Wiimotes."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Använd axelknapparna för L och R i stället för avtryckarna."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "Använd axelknapparna i stället för avtryckarna."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Använd HD-paketens 3D-modeller i stället för sprites (OpenGL-renderare). Aktiverat som standard."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "Använd BIOS:en i RetroBats mapp »bios«, krävs för att starta i BIOS."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Använd BIOS:en i RetroBats mapp »bios«."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Använd värdet HÖG FREKVENS för skärmar med högre uppdateringsfrekvens."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Använd ramarna från Odins artwork-paket (emulatorns artwork-mapp) i stället för RetroBats dekorationer."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Använd compute shader-renderaren i stället för den klassiska OpenGL-renderaren. Snabbare vid höga interna upplösningar, kräver OpenGL 4.3."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Använd emulatorns inbyggda BIOS i stället för filerna i bios-mappen. DS Download Play kräver original-BIOS och firmware."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Använd HD-paketens högupplösta texturer (OpenGL-renderare). Aktiverat som standard."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Använd musen som Apple II-paddlar, krävs av Arkanoid, Breakout och de andra spelen som styrs med vred. Pekarens position på skärmen är paddelns position. Ersätter handkontrollens spak för paddel 1 och 2, lämna avstängt för joystickspel."

msgctxt "game_options"
msgid "Use the older and less compatible faster blitter"
msgstr "Använd den äldre, mindre kompatibla och snabbare blittern"

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Använd inställningarna per spel som sparats i Vita3K-gränssnittet. De åsidosätter RetroBats inställningar för detta spel."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Använd den enkla färgtabellen för double hi-res. Några få Apple II-program ser mer ut som på den riktiga maskinen med den."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Använd detta om emulatorn kraschar efter laddningen eller inte visar något."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Använd endast detta om den analoga spaken driver."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Använd detta alternativ om ArcadeDuck inte visas på rätt skärm."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Använd detta alternativ om Keisho inte visas på rätt skärm."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Använd detta alternativ om Odin inte visas på rätt skärm."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Använd detta alternativ om PCSX2 inte visas på rätt skärm."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Använd detta alternativ om duckstation inte visas på rätt skärm."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Använd detta alternativ om p1 och p2 är omkastade."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Använd detta alternativ med en handkontroll som identifieras som tangentbord (ipac osv.)."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Använd detta alternativ med en ratt utan manuell växelspak."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Använd denna inställning för flygspel."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Använd denna inställning för att sänka eller höja ljusstyrkan, inte kompatibel med videodrivrutinen »gdi«."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Använd denna inställning för att sänka eller höja kontrasten, inte kompatibel med videodrivrutinen »gdi«."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Använd denna inställning för att sänka eller höja gamma, inte kompatibel med videodrivrutinen »gdi«."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Använd denna inställning för att ange en standardknapp som får turbo."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Använd denna inställning för att ignorera filerna run.bat, autoexec.bat eller dosbox.bat i spelmappen."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Använd denna inställning för att minska inmatningsfördröjningen."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Använd detta för att automatiskt ladda innehåll som HD-paket."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Använd winkey för tangentbord, xinput om du har en XBOX-handkontroll, sdl för andra typer av handkontroller."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Använd din egen .cfg-fil i saves\mame\cfg. Ommappningar med TAB i spelet behålls. Vid första aktiveringen importeras mappningen från senaste sessionen automatiskt. Alternativet för handkontrollslayout gäller inte längre för detta spel."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Användbart för spel med skärmskakningseffekter som Wipeout Fusion, kan göra bilden suddig."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Användbart för processorer med en tråd."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Användbart på vissa skärmar med hög uppdateringsfrekvens för att eliminera spökbilder."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Användbart vid högre upplösning än skärmens. Undviker moiréeffekt."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Använder 60hz (480i) i stället för 50hz (576i)."

msgctxt "game_options"
msgid "Uses the proper mipmap levels. Enhance graphics accuracy."
msgstr "Använder rätt mipmap-nivåer. Förbättrar grafikens noggrannhet."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "Emulering av VI-efterbehandlingsfiltret."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Värden över 1.00 ökar storleken, värden under minskar den."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "Vertikala spel visas på den skärm som motsvarar valt index."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD är ett förbättrat grafikkort som används av en handfull moderna demos. Ändring startar om maskinen."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Videolägen som konsolen erbjuder spelen. HD-lägen kräver HDTV-videosignalen."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Visningsuppsättning som bordet använder. AUTO följer SKÄRMUPPSÄTTNING: skrivbord för en liggande skärm, full enkel skärm för en vertikal skärm, kabinett för flera skärmar (skrivbord när SKÄRMUPPSÄTTNING inte är angiven)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Rotera D-pad virtuellt när skärmen roteras."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Volym för diskettenhetens emulerade klickljud."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Volym för musikkortet i de spel som har ett (Daytona USA, Sega Rally). 100% som standard."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Endast Vulkan, långsammare men mindre fördröjning."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Endast Vulkan. Förbättrar prestandan och åtgärdar många grafiska problem, men kan vara instabil på vissa grafikkort. Metoder som inte stöds faller tillbaka automatiskt."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Endast Vulkan: säger åt videodrivrutinen att använda ett angivet buffringsläge."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Vad som är anslutet till Amigans första port. De flesta spel använder joysticken i port 2 och musen i port 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Vad som är anslutet till Amigans andra port."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Vad som är anslutet till Amigans andra port. Standard är Joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Vad den andra porten tar emot när en andra handkontroll ansluts."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "När en adress anges sätts läget automatiskt till »MANUELL«."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "När den automatiska identifieringen misslyckas."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "När det är möjligt, föredra exklusiv helskärm för emulatorer."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "När aktiverat har varje spel sin egen VMU i port 1."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "När du väljer »MANUELL«, ange en adress i nästa inställning."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "När hastighetsbegränsningen är inaktiverad kör MAME emuleringen så snabbt som möjligt."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Vid användning av .m3u-fil: välj skivindex att köra."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Vid användning av Cursor Joystick måste knapparna mappas till tangenter i RetroArch."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "Vid användning av XInput byter detta alternativ gamepad 1 och 2."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Vid användning av en Sinden-pistol, stäng Lightgun-programvaran när spelet slutar."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Vid mappning från fil för arkadsystem, ange vilken layout som ska användas."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "Vid användning av riktiga Wiimotes, ange typ av Wiimote."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "Vid användning av programvara som kräver full tangentbordsinmatning rekommenderas även spelfokusläget."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Var DMD visas. AUTO: på spelplanen med 1 skärm, längst ned på backglass-skärmen med 2 skärmar, på en egen skärm med 3 skärmar. Kräver SKÄRMUPPSÄTTNING."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Vilken RetroPad som styr vilken Amiga-port. Lämna på Automatisk om inte spelarna är omkastade."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Vilken disk i ett spel med flera diskar som sätts in vid start. POM2 laddar en disk åt gången, de andra byts från menyn i spelet."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Vilken disk i ett spel med flera diskar som sätts in vid start: alltid den första, eller den som satt i enheten när du senast avslutade."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Vilken frontknapp som bekräftar i PS3:ans systemdialoger. Japanska spel förväntar sig i regel Cirkel, västerländska spel Kryss. Lämna på AUTO för att följa vald region."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Vilken diskettenhet menyn för diskbyte påverkar."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Vit kant som ritas av emulatorn, krävs av Sinden-pistoler för att sikta."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Bredd på den vita kant som ritas när en Sinden-pistol är ansluten. 16 pixlar som standard."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Bredd på den vita kant som ritas när en Sinden-pistol är ansluten. 2 pixlar som standard."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Kör XBOX-processen på flera CPU-trådar, kan förbättra prestandan men kan förstöra vissa spel."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Lösning som krävs av några få homebrews och ROM-hacks."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Kringgår firmwarefel i vissa rattar som orsakar korta avbrott i kraften. Lämna avstängt om det inte behövs."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Skriver Amiberry.log i emulatormappen. Endast användbart när du rapporterar ett problem, saktar ner något."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Skriver djupbuffertvärden till vm-minnet. Standard av."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Skriver inmatningshändelser till en loggfil i sparmappen. Endast användbart när du rapporterar ett problem."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "Z80 SoftCard kör CP/M-programvara. Ljudkorten kan läggas till här som ett andra kort. Ändring startar om maskinen."

msgctxt "game_options"
msgid "Zooms in to hide black borders."
msgstr "Zoomar in för att dölja svarta kanter."

msgctxt "game_options"
msgid "Zooms in to hide black borders. Borders are different per game."
msgstr "Zoomar in för att dölja svarta kanter. Kanterna skiljer sig mellan spel."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "Zorro II-utökning av RAM. Krävs av många WHDLoad-titlar, men några få originalspel på diskett vägrar starta med den."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "Zorro II-utökning av RAM. Krävs av många WHDLoad-titlar."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Zorro III-minne, kan endast användas av en accelererad maskin. Lämna på ingen om inte en specifik titel kräver det."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Zorro III-minne. Användbart för Workbench-uppsättningar och några få demos."

msgctxt "game_options"
msgid "use this to automatically start to a specified level."
msgstr "använd detta för att automatiskt starta på en angiven bana."
