# FEATURES - DESCRIPTIONS (added 2026-11)
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' to rzeczywista prędkość napędu. 'Turbo' wczytuje niemal natychmiast, ale niektóre gry to wykrywają i odmawiają działania."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' to rzeczywista prędkość napędu. 'Turbo' wyłącza emulację obrotu dysku i wczytuje niemal natychmiast, ale niektóre gry to wykrywają i odmawiają działania."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "'Dokładny' odpowiada sprzętowi, ale może mocno obniżać liczbę klatek na ekranach zapisu/wczytywania. Zmień tylko, jeśli jakieś menu działa wolno."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "'Kompatybilna' pasuje do niemal każdej gry. 'Cycle exact' jest najdokładniejsza, ale wymaga szybkiego PC. 'Szybka' odblokowuje prędkość CPU i może psuć gry wrażliwe na taktowanie."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "'Podwójny' daje czysty, nowoczesny obraz. Tryby scanline odtwarzają wygląd monitora CRT."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "'Dual Stick' mapuje joystick gracza 2 na prawą gałkę analogową gracza 1, 'Swap Ports' naprawia zamianę portów w 'Wizard of Wor'."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "'Dokładna' to najwierniejsza emulacja układu Paula. Obniż tylko, jeśli dźwięk się zacina na wolnym PC."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "'Joystick' to klasyczny 2-przyciskowy drążek obsługiwany przez każdą grę. 'Pad CD32' dodaje kolorowe przyciski i jest wybierany automatycznie na CD32."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "'WŁ.' przekazuje wszystkie zdarzenia fizycznej klawiatury do rdzenia. 'WYŁ.' zapobiega generowaniu zdarzeń klawiatury przez klawisze RetroPada."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "'PREDEFINIOWANE' używa plików konfiguracyjnych z folderu 'cfg' emulatora, 'DYNAMICZNY' generuje konfigurację na podstawie profilu wybranego w zaawansowanych ustawieniach 'STEROWANIE'."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "'Bezpieczna' naprawia błędy tekstur w niektórych grach kosztem dużego spadku wydajności."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "Opcja 'Szablony' kopiuje pliki z folderu 'emulators\m2emulator\templatescfg' zamiast wykonywać dynamiczną autokonfigurację."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "'Potrójne buforowanie' i 'dopasuj do emulowanej zawartości' są dostępne tylko ze sterownikiem wideo Vulkan."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "'Turbo' wyłącza emulację opóźnienia wyszukiwania."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "'XINPUT' wymusza użycie API XInput dla kompatybilnych kontrolerów."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "'directx11' jest domyślny i działa na niemal każdym sprzęcie. 'vulkan' może być szybszy na nowszych GPU. Niektóre rdzenie libretro wymuszają własny sterownik."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8MB Fast RAM (CD32FR). Domyślnie wyłączone, jak w oryginalnym CD32."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "0 to najniższa jakość, opóźnienie i użycie CPU, 10 to najwyższa jakość, opóźnienie i użycie CPU."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "Przy nowoczesnych kontrolerach zalecane jest 130-140%."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 bity usuwają banding kolorów w ciemnych obszarach i gradientach. HDR wymaga ekranu HDR z włączonym HDR w RetroArch, w przeciwnym razie rdzeń wraca do 24 bitów."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x odpowiada prawdziwemu napędowi. Wyższe prędkości skracają wczytywanie, ale mogą psuć gry."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "Zainstalowana karta rozszerzenia RAM 32k."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "Domyślnie 4/3, jak monitor automatu. Ramka (bezel) jest wyświetlana tylko w 4/3. 16/9 poszerza widok 3D."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Kilka gier wymaga wyłączenia tej opcji."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Wymagane przez kilka gier. Kosztuje około 10% wydajności."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Kilka bardzo wczesnych gier wymaga układu CTIA do poprawnego wyświetlania."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII mapuje klawiaturę na drukowane przez nią znaki. Oryginalna odtwarza dokładną klawiaturę emulowanej maszyny, wymaganą przez kilka programów."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "AUTO (zalecane) pozwala rdzeniowi wybrać plik NAND na podstawie regionu gry."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO pokazuje celownik przy celowaniu myszą i ukrywa go przy prawdziwym pistolecie."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO przełącza na DSi tylko dla gier ekskluzywnych na DSi. Wymuś DSI dla DSiWare."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "AUTOMATYCZNIE wybiera rozszerzenie na podstawie rozmiaru programu. Można je wymusić znacznikami w nazwie pliku, np. (8k) lub [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMATYCZNIE: Vita3K sam wczytuje wymagane moduły firmware (zalecane). USTAWIENIA EMULATORA: zachowuje moduły wybrane w interfejsie Vita3K."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Powyżej 60 fps klatki są interpolowane między aktualizacjami gry. AUTO podąża za częstotliwością odświeżania ekranu."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Dokładna emulacja bufora ramki, bardzo wolna, ale wymagana przez niektóre gry."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Działaj jako gracz 1 i hostuj grę."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Działanie drugiego przycisku kontrolera: spacja (np. Xenon 2) lub joystick w górę (skok w platformówkach)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Włącza mechanizm wspomagania celowania."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Włącza autozapis i określa odstęp między autozapisami."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "Włącz przy używaniu WiiZappera, aby zamienić przyciski spustu i przeładowania."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Dostosowuje widok gry do ekranów panoramicznych."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Dodaje pustą dyskietkę 2HD zapisu/użytkownika do listy sterowania dyskami."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Dodaje cienie kontaktowe, wymaga renderera sprzętowego."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Dostosowuje prędkość wskaźnika myszy na podstawie czułości gałki analogowej."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "Dostosowuje kolory wyjściowe, aby naśladować ekran oryginalnej konsoli."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Dostosowuje pionowy środek wskaźnika Wiimote."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Dostosowuje głośność ścieżki muzycznej."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Dostosowuje głośność efektów dźwiękowych."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Zaawansowana biblioteka audio używana przez wiele gier. Wyłącz tylko, jeśli gra się zawiesza lub ma problemy z dźwiękiem."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Celuj przedmiotami żyroskopem kontrolera (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Pozwala ADAM zapisywać na dyskach i data packach. Zapis trafia do kopii roboczej w folderze saves, oryginalny plik nigdy nie jest modyfikowany. Wymaga restartu rdzenia."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Zezwala na kontrolery DirectInput (ogólne pady USB, arcade sticki). Wyłącz tylko, jeśli pad jest wykrywany dwukrotnie."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Zezwala na kontrolery XInput (pady Xbox i wrappery). Wyłącz tylko, jeśli pad jest wykrywany dwukrotnie."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Umożliwia poprawną emulację zawijania tekstur, ale kosztem wydajności."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Pozwala grom obsługującym różne rozdzielczości renderować w określonej rozdzielczości."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Zezwala na natywną obsługę HID dla padów DualShock 4, DualSense i Switch Pro. Wyłącz, aby wrócić do DirectInput."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Pozwala naciskać jednocześnie lewo i prawo lub górę i dół. Może powodować błędy ruchu w niektórych grach."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Pozwala naciskać jednocześnie przeciwne kierunki."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Pozwala niektórym grom 30 fps działać w 60 fps."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Zezwala na stałe fetch tekstur i wierzchołków z nieprawidłowym typem, co pozwala ominąć błędy fetch w niektórych grach."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Pozwala używać zmiennej częstotliwości odświeżania na obsługujących ją ekranach. Na ekranach bez VRR w niektórych przypadkach może wystąpić rozrywanie obrazu."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Pozwala przybliżać i oddalać mapę kółkiem myszy, jak w Enhanced Editions."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Pozwala wykonać dedykowane mapowanie arcade sticka na podstawie pliku 'arcade_sticks.json'."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Pozwala używać myszy, nawet gdy typ urządzenia nie jest ustawiony na 'RetroKeyboard/Mouse'."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Wkłada także następną dyskietkę do napędu 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Zawsze rozpakowuj archiwa, nawet jeśli można by użyć dokan do zamontowania ich jako litery dysku."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Zawsze pokazuj nazwy przedmiotów leżących na ziemi."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Emulowany model Amigi. Każdy wymaga własnego ROM-u Kickstart w folderze bios."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Emulowany model Amigi. Wymaga restartu rdzenia. Każdy model wymaga odpowiedniego ROM-u Kickstart w folderze bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Port Amigi, do którego podłączony jest pistolet. Port 2 jest prawidłowy dla niemal każdej maszyny; tylko A1000 odczytuje pióro w porcie 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Ilość Chip RAM. Niektóre późniejsze gry wymagają 1 MB. Przekroczenie możliwości modelu może psuć kompatybilność."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "Ilość używanej pamięci RAM."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Zakres drobnych ruchów wskaźnika, które mają być ignorowane."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Dodatkowe wibracje, które rosną podczas skręcania."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Poziom wygładzania krawędzi."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Metoda i poziom wygładzania krawędzi."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Emulowany model Apple II. Zmiana uruchamia maszynę ponownie."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Emulowany model Apple II. Modele PAL działają w 50Hz i dla nich pisano europejskie dema. Zmiana uruchamia maszynę ponownie."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Stosowany do obrazu celownika, przydatny do rozróżniania graczy."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Stosuje krzywą potęgową do wartości kierowania, tłumi drobne ruchy."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Dotyczy osi drążka lotniczego i przepustnicy w After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Dotyczy pedałów gazu i hamulca w grach wyścigowych."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Stosuje cieniowanie Gourauda zamiast płaskiego, tylko z OpenGL."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Stosuje filtr CRT (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Stosuje brązowawy filtr chrominancji."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "Stosuje filtr wideo dostarczany przez rdzeń."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Stosuje filtr wideo do obrazu wyjściowego."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Stosuje filtr audio. Zmienia interpolację dźwięku."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Stosuje filtr rdzenia naśladujący renderowanie dawnych sygnałów."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Stosuje poprawkę dla niektórych gier."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Stosuje powyższy region, nawet gdy gra deklaruje własny."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Przybliża analogowy stopień wyjściowy konsoli: usuwa składową stałą i łagodzi wysokie częstotliwości."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Wygląd monitora automatu."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Wygląd monitora automatu: scanline'y, maska cienia i poświata."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Proporcje dostarczane przez rdzeń, używane gdy PROPORCJE OBRAZU GRY są ustawione na AUTO."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Proporcje ustawione w ustawieniach systemowych konsoli."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Klawiatura Atari: F2, F4 i F8 są zostawione grze, stany zapisu i zrzuty ekranu używają wtedy AltGr+K, AltGr+L i AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Próbuje wykonać przeskalowanie w natywnej rozdzielczości."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Próg bufora audio dla ręcznego pomijania klatek."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Audio daje najniższe opóźnienie. Wideo jest płynniejsze, gdy częstotliwość odświeżania ekranu jest bliska częstotliwości konsoli."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Częstotliwość wyjściowa audio."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (domyślnie) podąża za częstotliwością odświeżania ekranu z interpolacją ruchu. Oryginalna i wielokrotności 57,524 Hz wymagają ekranu G-SYNC / FreeSync i synchronizacji pionowej."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Automatycznie centruje oś celowania. Przydatne przy grach z pistoletem na gamepadzie zamiast pistoletu."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Częstotliwość autoognia. Szybciej nie zawsze znaczy lepiej: niektóre gry ignorują zbyt szybkie wciśnięcia."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: zachód atak, południe skok, wschód specjalny, północ atak 2, L1/R1 atak 3/4. OpenBOR standalone: te same przyciski co emulator OpenBOR standalone."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automatycznie używa XInput, gdy wszystkie kontrolery są urządzeniami XInput, w przeciwnym razie DirectInput."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automatycznie: uruchamia z dysku twardego, gdy gra ma dysk twardy i nie ma dyskietki."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automatycznie: pokazywany tylko, gdy gra nie ma własnego celownika."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Automatycznie stosuje ulepszenia gier, jeśli istnieją w bazie rdzenia (LOD, odległość rysowania, pomijanie FMV)."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Automatycznie przewija do przodu grę FDS podczas wczytywania dysku."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Automatycznie wczytuje łatki usuwające przeplot przy starcie gry."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Automatycznie wczytuje łatki panoramiczne przy starcie gry."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Automatycznie wczytuje i stosuje cheaty przy starcie gry."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Automatycznie usuwa czarne ramki wokół obrazu Amigi, aby obraz wypełniał większą część ekranu."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Automatycznie obraca obraz w grach pionowych."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Automatycznie przełącza Port0 i Port1 na podstawie aktywności wejścia."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Automatycznie zmienia stronę dysku, gdy gra o to prosi."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "Język BIOS może wpływać na język niektórych gier."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Ramki (bezels) są wyświetlane tylko w 4/3."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "Bilateralny CAS jest zalecany, ale obniża wydajność; CAS jest mniej agresywny i subtelniejszy."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Poziom czerni obrazu. Domyślnie 50%, dopasowane do nagrania z automatu: mniej to ciemniej, więcej to jaśniej."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "Mieszana rysuje przezroczyste wielokąty jako płynne mieszanie zamiast szachownicy z automatu. Tylko Model 1 i Model 2, renderery Vulkan i OpenGL."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Rozmywa emulowany obraz."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "Rozmywa sąsiednie piksele dla efektów przezroczystości."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "Rozmywa sąsiednie piksele, symulując rozdzielczość SDTV; może być wymagane przez niektóre gry do emulacji przezroczystości."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Przyspiesza emulację podczas rozruchu."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Uruchamia bezpośrednio menu BIOS DS, wymaga włączenia zewnętrznego BIOS."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Uruchamia ekran wprowadzania kodów Game Genie. Wymaga 'gamegenie.nes' w folderze bios. Wymagany restart."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Uruchamia menu BIOS konsoli."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Uruchamia z prawdziwym BIOS Jaguara i jego animacją startową. Wymagane przez niektóre gry."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Przechodzi do debugera hosta (lub zawiesza się, jeśli debuger nie jest podłączony) po napotkaniu niezaimplementowanej instrukcji PowerPC."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "Wyświetla menu ROM systemu przy uruchamianiu systemów arcade."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Rozgłasza informacje zwrotne wejścia na porcie TCP 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Buduje pamięć podręczną shaderów przed startem gry."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Kombinacja przycisków do przełączania między TV a GamePadem, używana tylko przez układ ekranu PRZEŁĄCZANE."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Układ przycisków rdzenia, taki sam dla wszystkich gier. Zostaw AUTO, aby używać mapowania RetroBat dla każdej gry oraz opcji UKŁAD KONTROLERA."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Przycisk potwierdzania w oknach systemowych i w grach stosujących ustawienie systemowe. KÓŁKO to konwencja japońska."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Domyślnie uruchamiany jest Hellfire, gdy nazwa gry zawiera hellfire, w przeciwnym razie Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Domyślnie RetroBat konfiguruje tylu graczy, ile jest podłączonych kontrolerów; użyj tego, aby to nadpisać."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Domyślnie RetroBat generuje własny plik konfiguracyjny; włącz tę opcję, aby użyć własnego pliku ustawień gry z folderu 'emulators\ssf\Setting'."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Domyślnie drugi gamepad jest używany, gdy podłączony jest drugi kontroler."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Domyślnie każdy kontroler porusza bohaterem. Włącz, jeśli inny podłączony kontroler zakłóca ruch."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "Domyślnie zinc mapuje ruch na lewą gałkę; użyj tej opcji, aby przełączyć na krzyżak."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Domyślnie RPCS3 wymaga GunCona w porcie gracza 3; użyj tego, aby wymusić port 1."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Domyślnie RetroBat pomija pliki opcji specyficzne dla rdzenia."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Domyślnie RetroBat synchronizuje zainstalowane gry z folderem roms."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "Domyślnie kalibracja odbywa się środkowym przyciskiem myszy; to ustawienie pozwala wybrać inny przycisk do strzału kalibracyjnego."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Domyślnie zmiany są zapisywane na dysku; 'odrzuć' nie zapisuje żadnych zmian."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Domyślnie potrząsanie wykonuje się przyciskiem spustu; włącz, aby zamiast tego symulować wymach."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Pomija mipmapping i zawsze używa najostrzejszego poziomu tekstur. Lepsza jakość obrazu, kilka gier ma wtedy problemy z renderowaniem."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "Konfiguracja CD32. Wymaga zarówno Kickstartu CD32, jak i jego rozszerzonego ROM-u w folderze bios."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "KLASYCZNY to oryginalny renderer programowy. POLYMOST i POLYMER używają OpenGL i obsługują pakiety HD."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "Rozmiar fizycznej pamięci RAM CPC w kB."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "Taktowanie CPU. Auto używa taktowania modelu lub bazy gier. Niektóre gry (SSF2, Alltynex) zyskują na szybszym CPU."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Prędkość kamery prawą gałką analogową lub myszą."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Może nieoczekiwanie wpływać na wydajność."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Pozwala wyłączyć sprawdzanie md5 BIOS w przypadku użycia własnego BIOS."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "Może poprawić liczbę klatek, ale może zaburzyć prędkość niektórych gier."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Może poprawić wydajność renderowania 3D w niektórych grach."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Przydatne w Gran Turismo: spusty zostaną zmapowane na inne przyciski."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Przydatne w Gran Turismo: spusty zostaną zmapowane na prawą gałkę analogową."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Przydatne w Metal Gear do symulowania czułości na nacisk."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Może pomóc w niektórych grach."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Może powodować różne błędy."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Może naprawić przesunięte obrazy 2D, np. wybór postaci w Mario Kart."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Może naprawić niektóre błędy, które występowały nawet na oryginalnym sprzęcie."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Może naprawić niektóre gry przy nienatywnej rozdzielczości przez zaokrąglanie krawędzi 2D."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Może naprawić niektóre problemy z kontrolerami XBOX."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Może poprawić dokładność niewielkim kosztem wydajności."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Może poprawić wydajność na mocniejszych GPU z zapasem mocy. Działa tylko z rendererem Vulkan."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Może zwiększyć wydajność na słabszych systemach."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Może zwiększyć wydajność przy mocnym GPU."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Działa tylko, jeśli kontroler obsługuje sterowanie ruchem."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Może zmniejszyć przycięcia podczas kompilacji shaderów, ale może też powodować artefakty."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Może zmniejszyć opóźnienie lub usunąć dolną linię na Wii kosztem błędów graficznych."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Ogranicza liczbę klatek do oryginalnych 35 fps."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Przełącza sterowanie krzyżakiem między joystickiem a myszą."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Zmienia proporcje dolnego ekranu."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "Zmienia proporcje górnego ekranu."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Zmienia ścieżkę dla rozpakowanych gier (domyślnie '\roms\.uncompressed')."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Zmienia renderer używany przez rdzeń. Gry z pistoletem działają tylko z PROGRAMOWY."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Zmienia czułość gałki analogowej."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Zmienia czułość myszy."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Zmień to ustawienie zależnie od sterowania gry: po lewej od znaku / jest oryginalny przycisk gry do przyspieszania i hamowania, po prawej do biegów."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Zmień to ustawienie zależnie od sterowania gry."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Zmień to ustawienie przy niestabilnych grach. Wyższa wartość może zapewnić lepszą stabilność. 200μs i 400μs są zwykle dobre dla większości gier."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Zmienia sposób rozdzielania wątków emulatora między rdzenie CPU. Harmonogramy RPCS3 mogą pomóc na CPU z wieloma klastrami CCX/CCD lub z SMT, ale system operacyjny jest najbezpieczniejszy na większości maszyn."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Zmienia sposób wyświetlania pistoletów w Rambo."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Zmienia układ dźwiękowy, ekran startowy TMSS i kilka osobliwości sprzętu."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Układ generatora znaków. Automatyczny wybiera ten pasujący do wybranej maszyny."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "Cheaty należy umieścić w folderze \bios\pcsx2\cheats."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "Cheaty należy umieścić w folderze 'cheats\mame'."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "Cheaty należy umieścić w folderze 'cheats\psxmame'."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Sprawdza każdy ROM względem bazy gier. Wyłącz tylko, aby przetestować romset, który się nie wczytuje: błędne ROM-y mogą powodować awarie lub uszkadzać zapisy. Domyślnie włączone."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Sprawdza uszkodzone pliki przy uruchamianiu gry."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Chipset używany po wybraniu modelu AGA. Obniżaj poniżej AGA tylko, aby przetestować grę, która źle działa na A1200."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Wybierz 'Trojan Phazer' dla gier napisanych pod ten pistolet. 'Pióro świetlne' pasuje do wszystkiego innego, w tym programów do rysowania."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "Wybierz rozszerzenie MSX dodawane do drugiego slotu kartridża."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Wybierz angielski, francuski lub hiszpański układ klawiatury."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Wybierz przycisk włączający IR na prawej gałce."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Wybierz przycisk symulujący wymach prawą gałką."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Określa, czy skrót zamiany ekranów zamienia je na stałe, czy tylko podczas przytrzymania przycisku."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Wybierz paletę kolorów."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Wybierz rozszerzenie podłączone do kontrolera."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Wybierz drugie rozmieszczenie emulowanych ekranów."

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Wybierz używaną paletę kolorów."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Wybierz napęd obsługiwany przez menu sterowania dyskami. Pozostałe napędy pozostają zamontowane. Wczytany nośnik używa napędu, do którego wczytano grę."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "Klasyczny używa prawego i lewego bumpera do mocnego kopnięcia i ciosu, nowoczesny używa prawego bumpera i prawego spustu."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Paleta kolorów dla gier na oryginalnego Game Boya."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Temperatura barwowa monitora automatu."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Kolory gier WonderSwan (mono). Palety WS naśladują oryginalne ekrany."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "Ustawia odstęp między ekranami w pikselach."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "Ustawia pole widzenia (więcej = szerzej)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Ustawia liczbę klatek na sekundę."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Ustaw, jeśli chcesz przełączać między dźwiękiem stereo a przestrzennym."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Określa, jak kontrolery są przydzielane przez hosta lub klienta. Kluczowe przy lokalnym połączeniu wieloosobowym."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Podłącza mysz do portu 1."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Wariant konsoli odpowiadający wybranemu obrazowi BIOS."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "Steruje dokładnością jednostki mieszania GS. Wyższe wartości dokładniej emulują mieszanie w shaderze."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Steruje filtrowaniem trójliniowym tekstur w emulacji."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Określa sposób stosowania ditheringu."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Określa szczegółowość komunikatów przed wyświetleniem programu."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Konwertuje bieg w górę/w dół na bieg 3/bieg 4 do symulacji zmiany sekwencyjnej na standardowej dźwigni."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Kopiuje tekstury do VRAM, wolniej, ale dokładniej. Wyłącz, aby zyskać wydajność."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Kopiuje bufor koloru do pamięci N64. Potrzebne dla niektórych efektów (np. ekrany pauzy, zdjęcia z aparatu). WYŁ. jest najszybsze, ale może je psuć. AUTO podąża za trybem wydajności."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Poprawne, ale wolniejsze."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Koryguje proporcje niekwadratowych pikseli."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Przycina potencjalnie przypadkowy, błędny obraz na krawędziach, który byłby ukryty przez ramkę telewizora o standardowej rozdzielczości."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "Przycina obraz z natywnych proporcji do 4:3 lub 16:9"

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "Przycina ramki, aby pokazać lub ukryć grafikę ramki."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "Przycina obraz z 256x240 do 252x239."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Częstotliwość odcięcia filtra wyjścia audio konsoli. 3390 Hz odpowiada większości modeli Mega Drive."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "Ucina 8 pikseli na krawędziach, aby usunąć ramki Master System."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "Rozmiar płyty DIMM. Auto podąża za grą; zostaw Auto, chyba że gra zgłasza problem."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Tłumi kołysanie kamery pościgowej w grach wyścigowych. Domyślnie silne."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Przyciemnia co drugą linię, naśladując kineskop."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "DeSmuME ma wewnętrzny BIOS; wybierz tę opcję, aby używać BIOS i firmware z folderu bios RetroBata."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Zmniejsz, jeśli zbyt czuły; zbyt duże zmniejszenie może uniemożliwić pełny zakres ruchu."

msgctxt "game_options"
msgid "Default ON."
msgstr "Domyślnie WŁ."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "Domyślnie emulowany jest pad 6-przyciskowy."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Domyślnie włączone, może sprawiać problemy w kilku grach."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Domyślnie zgodny z językiem EmulationStation."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "Domyślnie 'WYSOKA'; ustaw 'NORMALNA', aby zwiększyć wydajność kosztem dokładności."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "Domyślnie 30 sekund; określa czas oczekiwania na uruchomienie gry przed powrotem do listy gier RetroBata."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "Domyślnie WYŁ.; użyj w razie problemów z prędkością na ekranach o wysokiej częstotliwości odświeżania."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Domyślnie WŁ. (szybko). WYŁ. uruchamia prawdziwe programy DSP geometrii, dokładniej, ale wolniej (tylko gry Model 1, Model 2 2B)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Domyślnie WŁ., prawidłowe renderowanie czworokątów. WYŁ. renderuje czworokąty jako trójkąty (szybciej)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Domyślnie WŁ.; WYŁ. może poprawić kompatybilność ze starszymi GPU (tylko Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "Domyślnie WŁ.; użyj tego ustawienia, aby usunąć limit 60Hz, może psuć gry."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Domyślnie włączone; wyłącz, aby pokazać animację rozruchu."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Domyślnie 10 bitów dla DS i 16 bitów dla DSi."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Domyślnie Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "Domyślnie GamePad WIIU; zmień dla gier, które nie akceptują GamePada WIIU w trybie wieloosobowym."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Domyślnie: kursor ukryty."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Domyślnie: włączone."

msgctxt "game_options"
msgid "Default: low."
msgstr "Domyślnie: mało."

msgctxt "game_options"
msgid "Default: true"
msgstr "Domyślnie: włączone"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Domyślnie 60, gdy ustawione na 0 i włączony jest VSYNC."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Określa BIOS używany do emulacji."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "Określa typ gamepada, dotyczy obu graczy."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "Określa model komputera PET."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "Określa uruchamiane urządzenie Symbian."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Określa przycisk wyświetlania ekranu GamePada, domyślnie brak."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Określa ilość pamięci RAM emulowanej maszyny."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Określa, jak kursor ma się pojawiać na dolnym ekranie."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Określa, jak gra jest dopasowywana lub skalowana do okna."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Określa sposób konfiguracji pistoletu Sinden."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Określa mapowanie przycisków A i B GunCona (Start i Back Justifiera). Domyślnie: krzyżak w prawo/w lewo z Wiimote na DolphinBar, przyciski myszy z innymi pistoletami."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "Określa mapowanie przycisków GunCon2."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Określa sposób emulacji ekranu dotykowego."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Określa sposób podłączenia Wiimote do DolphinBar."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Określa, czy łatka ma być stosowana i gdzie znajdują się pliki łatek; 'AUTO' stosuje łatki, jeśli leżą obok ROM-u i mają tę samą nazwę co plik ROM."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Określa mapowanie przycisków myszy (lewy/prawy/środkowy), domyślnie A/przeładowanie/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "Określa typ modelu i region."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Określa model, domyślnie BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Określa model, domyślnie CPC 6128+ dla GX4000."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "Określa model, domyślnie Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Określa indeks myszy dla gracza 1."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "Określa indeks myszy dla gracza 2."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Określa indeks myszy dla gracza 3."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Określa indeks myszy dla gracza 4."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Określa ścieżkę do własnego pliku controls.ini."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "Określa region, używany dla zapisów."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Określa kombinację przycisków do przytrzymania, aby przełączyć kontroler DualShock między trybem analogowym a cyfrowym."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Określa paletę kolorów; Stary NTSC odtwarza dawne, brzydkie kolory japońskich telewizorów."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "Określa podłączone urządzenie emulujące pokrętło."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Określa podłączone urządzenie emulujące pedał."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "Określa podłączone urządzenie emulujące urządzenie pozycyjne."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "Określa podłączone urządzenie emulujące trackball."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "Określa podłączone urządzenie emulujące pistolet."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Określa podłączone urządzenie emulujące mysz."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "Określa podłączone urządzenie emulujące paddle."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Określa podłączone urządzenie emulujące analogowy drążek kierunkowy."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Określa typ emulowanego joysticka."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Określa typ emulowanej maszyny."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "Określa funkcję prawego joysticka."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "Określa kombinację klawiszy otwierającą menu diagnostyczne."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Określa poziom wibracji i wstrząsów ekranu; włącz wstrząsy ekranu, jeśli kontroler nie obsługuje wibracji. 'AUTO' włącza oba."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Określa położenie trzymanej broni."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Określa mapowanie krzyżaka."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Określa liczbę emulowanych kart pamięci."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Określa liczbę przycinanych pikseli."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Określa dźwięk, który odbierze emulowany mikrofon."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "Określa typ urządzenia używanego do ruchu wskaźnika."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Określa typ monitora, zmienia kolory."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Określa typ emulowanego kontrolera."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "Określa typ celownika dla pistoletów."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Określa, gdzie znajdują się przyciski monety i start."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Określa, czy skróty 'przewijania do przodu' działają jako przełącznik, czy wymagają przytrzymania."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Określa, czy skróty 'zwolnionego tempa' działają jako przełącznik, czy wymagają przytrzymania."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Określa, który dźwięk Game Boya jest wyprowadzany z systemu."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Określa, która gałka analogowa steruje wskaźnikiem myszy."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "Określa, który przycisk włącza tryb turbo; nie jest to przycisk, który staje się turbo."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Stopnie obrotu kierownicy odpowiadające pełnemu skrętowi w grze. 270 to automat."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Odrzuca zapisy, gdy zajęte."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "Zależnie od konfiguracji może zwiększyć lub zmniejszyć opóźnienie."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Urządzenie podłączone do portu gier Apple II. Gałka analogowa daje płynny ruch paddle, krzyżak przesuwa tylko maksymalnie w lewo lub w prawo."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Typ urządzenia dla gracza 2."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Tylko DirectInput: użyj, jeśli kontrolery nie sterują właściwymi graczami."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Wyłącza sprawdzanie podpisu XBE przy grach homebrew."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Wyłącza ustawienia Xenia Edge dla poszczególnych gier, aby obowiązywały ustawienia RetroBata."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Wyłącza funkcje bezpieczeństwa rdzenia, aby umożliwić uruchomienie niektórych gier homebrew."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Wyłącza dithering i używa pełnych 8 bitów informacji o kolorze na kanał."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Wyłącza efekty mgły."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Wyłącza renderer sprzętowy, może zwiększyć kompatybilność."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Wyłącza skróty klawiaturowe i daje rdzeniowi pełny dostęp do klawiatury. Przełączanie klawiszem 'Scroll Lock'."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Wyłącza modifier volumes używane do renderowania cieni."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "Wyłączenie pixel shaderów może naprawić awarie niektórych gier; nie włączaj, chyba że gra tego wymaga."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Wyłącza układ FM Master System."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Wyłącza menu Visual Pinball: klawisz wyjścia (X) od razu zamyka stół."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Wyłącza analogowy plunger (prawa gałka) i analogowe popychanie (lewa gałka)."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Wyłącza sprawdzanie kamery automatu."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "Wyłącza sprawdzanie artworków w folderze 'saves\mame\artwork'."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "Wyłącza aplet kontrolerów pojawiający się w grach wieloosobowych do wyboru podłączonych kontrolerów."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Wyłącza menu w grze otwierane przez HOTKEY + WSCHÓD lub F12."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Wyłącz tę opcję, aby wskaźnik IR wracał na środek po puszczeniu gałki."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Wyłącz tę opcję, aby poprawić wydajność."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Wyłącz tę opcję, aby uruchamiać bezpośrednio plik .bat lub .cmd bez szukania przez RetroBat pliku wykonywalnego wewnątrz."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Wyłącz, aby zmapować R2 i L2 na przyciski L i R (niecyfrowe)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Wyłącza użycie osi X do popychania, osi Y do pionu i osi Z do plungera."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Wyłącza ostrzeżenie przy uruchamianiu gier, które nie są w pełni obsługiwane."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Wyłącza wibracje pada; domyślnie wibracje są włączone tylko, gdy gra i kontroler je obsługują."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Wyłącza automatyczne ustawienia dla gier z bazy rdzenia i włącza poniższe ręczne poprawki. Niezalecane."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Wyłącza interpolację ruchu, o jedną klatkę mniej opóźnienia."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Wyłącza pamięć podręczną wierzchołków. Może rozwiązać brakującą lub migoczącą grafikę. Może obniżyć wydajność."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "Wyłączenie ditheringu może usunąć szum i efekty pikselizacji."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "Wyłączenie rozszerzenia pamięci 4MB może być konieczne w niektórych grach."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Wyłączenie tej funkcji zmniejszy głębię kolorów."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "Wyświetla interfejs menu MAME przy wczytywaniu gry."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "Wyświetla ramki SGB przy emulacji Super Game Boya."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Wyświetla komunikat po odblokowaniu osiągnięcia. Domyślnie włączone."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Wyświetla mały wskaźnik na ekranie dotykowym."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Wyświetla pasek doświadczenia nad pasem."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Proporcje wyświetlania obrazu LaserActive, domyślnie 4:3."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Wyświetla aktualne wartości życia i many na kulach."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Wyświetla obrażenia i doświadczenie jako latające liczby."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Wyświetla czas poziomu, znalezione sekrety i zabitych wrogów."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Wyświetlanie drugiego ekranu (dotykowego) w Primeval Hunt."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Wyświetla obszary ramki ekranu. Nie działa z wyjściem F18A."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Wyświetla grę w 16:9. Najlepiej z PROPORCJE OBRAZU GRY ustawionymi na 16/9."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Wyświetla ekran VMU gracza 1 nad grą."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Ekran używany przy starcie. Można przełączyć w grze klawiszem F7 (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Wyświetla obiekty wokselowe zamiast płaskich sprite'ów, gdy są dostępne. Domyślnie włączone."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Dithering efektów bufora ramki z supersamplingiem."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Dithering stosowany do obrazów bufora ramki RDRAM."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Dzieli rozdzielczość wewnętrzną: przy wysokiej rozdzielczości wewnętrznej wyższe wartości powiększają grę. Domyślnie: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 to bardzo ciemna gra; zwiększ, aby rozjaśnić obraz."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Podwaja odczuwalną rozdzielczość poziomą, niezgodne z supersamplingiem."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Zmniejsza powiększony obraz (SSAA). Wymaga upscalingu."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Rysuje scenerię aż do końca trasy w obsługujących to grach (Daytona USA). Tylko Model 1 i Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Napęd używany przy zmianie dysków."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick: Robotron 2084 i Space Dungeon na prawej gałce. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: joysticki wieloprzyciskowe."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Duplikowanie klatek wymaga renderera Vulkan."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Dynamiczna rekompilacja. Większość gier działa szybciej, niektóre wolniej."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Eliminuje zniekształcenia i wypaczenia tekstur przy upscalingu."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Emuluje buzzery Buzz! na gamepadach. Jeden kontroler obsługuje 4 buzzery (gracze 1-4), dwa kontrolery 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Emuluje kafelkowanie pamięci PS3. Naprawia błędy graficzne w niektórych grach niewielkim kosztem wydajności."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Emuluje moduł rozpoznawania mowy (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Emuluje gramofon DJ Hero na gamepadach. Wymagane w DJ Hero 1 i 2."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Emuluje kontroler Guitar Hero Live (GHLtar) na gamepadach. Wymagane w Guitar Hero Live."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Emuluje New 3DS lub oryginalne 3DS."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Emuluje PlayStation TV dla lokalnej gry wieloosobowej (do 4 kontrolerów). Identyczne kontrolery nie są obsługiwane, gry z ekranem dotykowym mogą nie działać."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Emuluje określone sterowanie ruchem. '/' oznacza akcję dla lewej/prawej gałki."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Emuluje kontroler z pokrętłem sterowany ruchem myszy. Przyciski myszy są zmapowane na lewy (żółty) i prawy (czerwony) przycisk."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Emuluje częstotliwość vblank NTSC 59,94Hz zamiast 60Hz. Naprawia rozjazd taktowania i dźwięku w niektórych grach NTSC."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Emuluje akcesorium Disney Infinity Base."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Emuluje Game Boy Playera, aby włączyć wibracje w kompatybilnych grach."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Emuluje akcesorium toypad LEGO Dimensions."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Emuluje akcesorium portal Skylanders."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Emuluje kartę Video CD, wymaga mpeg_card.bin w folderze bios."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emuluje zachowanie starszych silników, wymagane przez niektóre starsze mody i dema."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Wycinek czasu emulowanego wątku. Zwiększenie może pomóc w kilku grach, zmniejszenie może wygładzić inne."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Emuluje efekty przezroczystości LCD, ale zwiększa rozmycie ruchu."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Emuluje układ multisamplingu PS3. Może naprawić niektóre artefakty wizualne w niektórych grach."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Scanline'y emulatora, widoczne tylko w niektórych grach."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Włącza modyfikację RAM 32MB dla Dreamcasta, może wpływać na kompatybilność."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "Włącza rozruch w BIOS dla gier DSi."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Włącza emulację CMS."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Włącza cyfrowy procesor dźwięku. Poprawia dokładność dźwięku kosztem wyższych wymagań."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Włącza cyfrowy procesor dźwięku. Poprawia dokładność dźwięku kosztem wydajności."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Włącza usługę Discord Rich Presence, która aktualizuje status Discorda, pokazując grane gry."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Włącza dekoder Dolby Pro Logic II w kompatybilnych grach i dla głośników 5.1."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Włącza adaptacyjne wyostrzanie kontrastu FidelityFX."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Włącza jednostkę zmiennoprzecinkową, zwykle przydatną w późniejszych grach 3D."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Włącza emulację Gravis Ultrasound."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "Włącza HDR dla ekranów zgodnych z HDR."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Włącza emulację audio IBM PS/1 (domyślnie wyłączona)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Włącza emulację Just In Time, zwiększa prędkość emulacji, niezgodna z cycle exact."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "Włącza wewnętrzne przemapowanie sterowania w MAME."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "Włącza opcję MAME automatycznie konfigurującą układ przycisków dla każdej gry na podstawie wewnętrznej bazy."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "Włącza emulowany BIOS MelonDS zamiast firmware z folderu bios."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "Włącza renderer OpenGL; sterownik RetroArch musi być ustawiony na OpenGL."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "Włącza emulację NES PAL (50Hz)."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Włącza kartridż RAM Sega CD."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Włącza emulację dźwięku Tandy."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Włącza dodatkową pamięć RAM deweloperską, może psuć gry."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Włącza wygładzanie krawędzi, wygładza krawędzie wielokątów."

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Włącza siłowe skalowanie w górę/w dół (tylko 10.8.0)"

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Włącza montowanie pamięci podręcznej"

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "Włącza rzucanie cieni przez obiekty w grze, działa tylko z OpenGL."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Włącza efekty wibracji kontrolera. Działa tylko w grach wyścigowych."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Włącza celowniki w grach strzelankach; opcje (DS) działają tylko z DemulShooter."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Włącza celowniki w grach strzelankach."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Włącza własną rozdzielczość na podstawie trybu wideo."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Włącza dynamiczne rekompilatory, które pomagają poprawić wydajność."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Włącza rozszerzone funkcje dla DS4 i DualSense; psuje to kompatybilność z emulatorami używającymi DInput aż do wyłączenia."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Włącza force feedback dla obsługiwanych kontrolerów."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Włącza pełnoekranowe wygładzanie krawędzi w Direct3D, wygładza krawędzie wielokątów."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Włącza filtr mieszania poziomego (rozmycie)."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Włącz, jeśli kierownica jest odpychana od środka zamiast do niego."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Włącza celownik w grze, aby ułatwić celowanie."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Włącza funkcję inteligentnego przybliżania."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Włącza łatki IPS."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "Włącza mniej dokładną, ale lepiej brzmiącą emulację dźwięku Namco 106 (mapper 19)."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Włącza poniższe ręczne hacki, w przeciwnym razie hacki są stosowane automatycznie."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Włącza sterowanie ruchem (żyroskop) myszą lub kompatybilnym kontrolerem."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Włącza multitap w porcie 2."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Włącza skanowanie progresywne w kompatybilnych grach."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Włącza tryb run-ahead w celu zmniejszenia opóźnienia wejścia."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Włącza kartę IBM Music Feature Card (domyślnie wyłączona)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "Włącza układ FM Master System."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Włącza działanie cheatów aktywowanych w interfejsie Vita3K."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Włącza emulację padów Jaguar podłączonych do rozszerzonych portów joysticka Atari STE."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Włącza używanie myszy do ekranu dotykowego zamiast prawej gałki."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Włącz, jeśli indeksy kontrolerów XInput są zamienione."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Włącz, jeśli kontroler nie ma analogowych spustów."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Włącz, jeśli masz monitor G-Sync/FreeSync; może powodować błędy dźwięku."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Włącz tę opcję w razie problemów z grafiką Intel."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Włącz tę opcję, jeśli w grze brakuje grafiki lub oświetlenie jest błędne."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Włącz tę opcję przy używaniu mamehooker z diodami LED, solenoidami, wibracjami..."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Włącz, aby używać shaderów nawet, gdy RetroBat nie ma ustawionego shadera."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Włącz, aby podłączyć joystick gracza 1 do lewego portu zamiast prawego."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Włącz, aby używać shaderów dostarczanych przez Duckstation."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Włącz, aby używać własnych ustawień Project64 dla poszczególnych gier."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Domyślnie włączone (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Domyślnie włączone, poprawia transfer danych emulowanego portu SIO."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Domyślnie włączone."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Domyślnie włączone. Wyłącza dithering i wymusza 24-bitowe wyjście kolorów."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Domyślnie włączone. Wyłączenie może poprawić wydajność, ale psuje niektóre gry."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Domyślnie włączone. Szybsze shadery, mogą rzadko powodować błędy graficzne."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Domyślnie włączone. Naprawia błędy graficzne w niektórych grach niewielkim kosztem wydajności."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Domyślnie włączone. Usuwa rozmycie w niektórych grach, ale zmniejsza dokładność."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Domyślnie włączone. Zastępuje sprite'y gry pakietem HD, gdy jest dostępny. Wymagany restart."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Domyślnie włączone. Pokazuje komunikaty pochodzące z samego emulatora."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Domyślnie włączone. Po wyłączeniu liczba klatek jest ograniczona do 60 FPS."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Domyślnie włączone. Po wyłączeniu liczba klatek jest ograniczona przez grę."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Włącza tryb 60HZ, aby zmniejszyć rozrywanie obrazu na ekranach nieobsługujących pracy powyżej 60HZ."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Włącza automatyczne generowanie mipmap Direct3D."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Włącza wysoką rozdzielczość WRX."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Włącza hack anty-rozmycia, mniej dokładny, ale gry są mniej rozmyte."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Strzałki, CTRL i ALT działają jako joystick i przyciski ognia."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Włącza funkcję własnego łatania."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Włącza renderowanie CEL w wysokiej rozdzielczości."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Umożliwia przełączanie między różnymi sygnałami wideo."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Włączenie może powodować problemy z kontrolerami 8BitDo."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Wymusza ścisłą zgodność ze specyfikacją API. Może obniżyć wydajność w niektórych grach. Może rozwiązać rzadkie przypadki brakującej grafiki i migotania."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Poprawia dokładność grafiki kosztem wyższych wymagań."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "Wzmacnia cienie różnych obiektów."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "Poprawia jakość tekstur 2D."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Poprawia jakość tekstur na powierzchniach. Tylko OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Poprawia jakość tekstur na powierzchniach. Tylko Vulkan i OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Filtr ulepszający stosowany do tekstur."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Podaj lokalny port UDP używany do hostowania."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Podaj adres serwera."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Podaj pierwsze znaki ROM-u gry używanego do przesyłania danych."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Podaj pierwsze znaki pliku zapisu używanego do przesyłania danych."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Podaj profil dotyku do wczytania."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Pogłos otoczenia (EFX), domyślnie włączony."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Dokładna jest najbliższa konsoli i najbardziej obciąża GPU. Szybka jest znacznie lżejsza. Auto wybiera szybką na słabych lub niestabilnych GPU."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "Uruchamia backend graficzny w drugim wątku, poprawia wydajność, zmniejsza przycięcia i przyspiesza kompilację shaderów."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Rozszerza kartę pamięci SAMS do 4M."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Kartridż rozszerzeń włożony do konsoli. Gry o znanych wymaganiach nadpisują to automatycznie."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Eksperymentuj z tą opcją, jeśli joystick dryfuje (domyślnie włączona)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Eksperymentalne, tylko Windows. Chroni dane stosu gry, gdy emulator obsługuje wyjątki pamięci. Może naprawić awarie w niektórych grach. Zostaw wyłączone, chyba że gra tego wymaga."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Dodatkowy kontroler. Zostaw pusty, chyba że gra o niego prosi."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Dodatkowa karta pamięci, tylko modele //e. Kilka programów potrzebuje więcej niż fabryczne 64KB."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "Czułość myszy FM Towns."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Szybkie przybliżone wygładzanie krawędzi, tańsze niż MSAA, ale bardziej rozmyte."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Szybki może poprawić wydajność, ale bywa niestabilny z niektórymi sterownikami."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "ROM szybkiego wczytywania z dysku. Wymaga PEŁNA EMULACJA NAPĘDU i ROM-ów JiffyDOS w 'bios\vice'. Nieużywany z taśmami i kartridżami."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Szybka jest mniej dokładna, uporządkowana i atomowa jest dokładna, ale wolniejsza."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Szybszy silnik emulacji DSP (eksperymentalny). Używany tylko, gdy włączona jest EMULACJA DSP."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Szybszy odczyt sektorów. Niektóre programy mogą tego nie oczekiwać."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Filtruje wszystkie tekstury, także te, które gra wyraźnie ustawia jako niefiltrowane. Domyślnie wyłączone."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Filtr stosowany do końcowego obrazu."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Filtr używany do skalowania obrazu do ekranu."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Filtr używany przy skalowaniu końcowego obrazu."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Filtr używany, gdy renderowany obraz jest większy niż ekran."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Filtr używany, gdy renderowany obraz jest mniejszy niż ekran."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Filtrowanie stosowane do tekstur 3D."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Filtrowanie stosowane do tekstur 3D. Tylko OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Filtrowanie stosowane do sprite'ów i elementów 2D."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Strzela ciągle, dopóki przycisk jest wciśnięty."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Uruchamia silnik odrzutu pistoletu przy każdym strzale, w pistoletach, które go mają. Domyślnie włączone."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Mieści gry w wysokiej rozdzielczości lub panoramiczne w ramce 640x480 z czarnymi ramkami. Przydatne tylko na telewizorze CRT 4:3."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Wkłada kartridż Digital Video (vmpega.rom w folderze bios), wymagany przez gry FMV i Video CD."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Naprawia błąd Demul (wyjście z pełnego ekranu przy strzale w lewy górny róg), blokując całe wejście myszy do interfejsu Demul."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Naprawia spowolnienia w tym emulatorze."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Naprawia uszkodzenia tekstur i problemy z głębią na GPU AMD i niektórych Intel."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Naprawia banding, który może pojawić się na powiększonych teksturach."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Naprawia zapętlanie się gry przy rozruchu."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Naprawia współpłaszczyznową geometrię i naklejki w niektórych grach, może psuć inne."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Naprawia szczeliny między elementami 2D."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Naprawia artefakty cieni i głębi w niektórych grach."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Naprawia niektóre błędy graficzne związane z liniami."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Naprawia błędy tekstu w niektórych grach."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Jednostka zmiennoprzecinkowa, potrzebna w niektórych grach 3D. Domyślnie włączona z 68040 (wbudowana), wyłączona z 68030."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Folder danych Vita3K (firmware, zainstalowane gry, zapisy). Ignorowany, gdy Vita3K jest w trybie przenośnym (niepusty folder 'portable' obok Vita3K.exe)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "ROM czcionki wymagany przez niektóre gry japońskie."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "Dla Bleach Blade Battlers."

msgctxt "game_options"
msgid "For Goemon."
msgstr "Dla Goemon."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "W systemach Nintendo zamienia A i B, aby odpowiadały nazwom przycisków Xbox."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "Dla gier Run Behind i M-bit."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "Dla HUD w SOCOM 2/Spy Hunter."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "Dla Scarface The World is Yours i Crash Tag Team Racing."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "W grach SegaScope 3-D pokazuje obraz tylko dla jednego oka zamiast migoczącej pary."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "Dla Superman Returns."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "Dla Tales of Destiny."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "Dla gier Tri-Ace."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "W grach z teksturami ASTC przełącz na średnią przy GPU z 6GB VRAM i na niską przy GPU z 4GB-2GB VRAM."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "W kontrolerach N64 z 2 spustami używa R2 zamiast L2 jako przycisku Z."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "Dla nostalgii. Domyślnie wygląda jak przyspieszona mgła wojny w BG2"

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "W niektórych emulatorach pozwala naprawić powiązanie klawiatury i myszy z Wiimote przy używaniu 2 Wiimote."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Wymusza oprogramowanie GBC, które zmienia zachowanie po uruchomieniu na GBA."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "Wymusza tryb Game Boy dla Game Boy Color."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Wymusza indeks pada G1, przydatne, jeśli urządzenia XInput są źle uporządkowane."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "Wymusza indeks pada G1, przydatne przy używaniu kontrolera w automacie."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "Wymusza indeks pada G2, przydatne przy używaniu kontrolera w automacie."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Wymusza Raw Input, nie powinno być potrzeby ustawiania WŁ."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Wymusza liczbę cykli CPU na operację. AUTO używa domyślnej wartości dla gry, zmieniaj tylko, jeśli gra działa źle."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Wymusza przycisk zamiast osi dla spustów, może pomóc z kontrolerami Sony."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Wymusza pełny ekran emulatora, nawet jeśli RetroBat działa w oknie"

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Wymusza ogranicznik klatek."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Wymusza sposób próbkowania tekstur. Najbliższy sąsiad zachowuje ostre piksele, liniowe je wygładza."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Wymusza sterownik wejścia. Domyślnie 'sdl', 'dinput' przy włączonej obsłudze wielu pistoletów."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Wymusza bieżącą rozdzielczość ekranu w grach pozwalających na własną rozdzielczość."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Wymusza kartridż rozszerzeń Saturn, jeśli automatyczne wykrywanie zawiedzie."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Wymusza region Saturn, jeśli automatyczne wykrywanie zawiedzie."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Wymusza stereo dla wszystkich ROM-ów."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Wymusza emulowany model Game Boya, jeśli automatyczne wykrywanie zawiedzie."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Wymusza częstotliwość odświeżania VI. AUTO jest poprawne dla niemal każdej gry."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Wymusza rzeczywisty układ kanałów wyjściowych. KANAŁY AUDIO określają, co widzi gra, a to ustawienie decyduje, jak dźwięk jest miksowany na urządzenie. Zostaw AUTO, chyba że urządzenie wyjściowe jest źle wykrywane."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Wymusza włączenie lub wyłączenie backglassa. AUTO podąża za KONFIGURACJA EKRANÓW (włączony, gdy KONFIGURACJA EKRANÓW nie jest ustawiona)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Wymusza tryb filtrowania dwuliniowego przy upscalingu brudnych prostokątów."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Wymusza urządzenie rozruchowe (tylko modele 1F/2F i późniejsze)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "Wymusza region konsoli."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Wymusza region konsoli. Domyślnie region jest wykrywany z gry."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Wymusza emulowaną częstotliwość odświeżania zamiast wykrywania jej z wczytanej gry. Wymaga restartu rdzenia."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Wymusza użycie przez emulator określonego pliku BIOS."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Wymusza częstotliwość emulowanego CPU. Może zmniejszyć spowolnienia, ale może powodować błędy. Domyślnie 57%."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "Wymusza częstotliwość regionu gry, aby uniknąć problemów z prędkością emulacji; zostaw 'Auto', chyba że zauważysz problemy z prędkością."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Wymusza używaną klawiaturę, jeśli podłączonych jest kilka."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Wymusza kontroler banków pamięci. Zmieniaj tylko, jeśli gra nie działa poprawnie. Wymaga restartu rdzenia."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Wymusza monochromatyczne tryby wyświetlania, jak na zielonym lub bursztynowym monitorze z epoki."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Wymusza liczbę Wiimote wykrywanych przez grę. Ustaw 1 dla gier, które przechodzą w tryb wieloosobowy, gdy tylko podłączonych jest kilka kontrolerów."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "Wymusza typ pliku nośnika"

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Wymusza sterownik SDL dla kontrolerów; ustaw przy więcej niż 4 kontrolerach, ponieważ XInput ogranicza się do 4 graczy."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Wymusza sterownik SDL lub DInput dla kontrolerów; ustaw przy więcej niż 4 kontrolerach, ponieważ XInput ogranicza się do 4 graczy."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Wymusza użycie określonej softlisty; lista oprogramowania musi być w folderze 'bios\mame\hash'."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Wymusza wysokopoziomową emulację BIOS."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Wymusza kartridż głosowy w slocie 1, wymaga pliku bios 'voice.zip'."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "Wymusza indeks kierownicy, przydatne, jeśli RetroBat ustawia zły indeks."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "Wymusza częstotliwość odświeżania 60Hz."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "Wymusza tryb PAL konsoli zamiast NTSC, może sprawiać wrażenie ociężałości."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Wymusza emulację blit i manipulacji obrazem na CPU, w niektórych przypadkach dokładniejszą i wymaganą przez gry takie jak GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Wymusza sterownik Raw Input przy urządzeniach takich jak trackball i spinnery."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Wymusza poziom kompatybilności silnika. Ustaw MBF21 dla WAD-ów, które tego wymagają."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Rozdzielczość pełnoekranowa. Domyślnie używana jest rozdzielczość pulpitu."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Pełna kontrola kamery prawą gałką."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "Stany GST można otworzyć w Kega i Gens, ale przechowują mniej stanu maszyny."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Wzmocnienie sił płyty napędowej. Domyślnie 30%, 200% je podwaja."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Rozdzielczość gry. Wyższe wartości pokazują większy obszar gry."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Zakres skrętu gamepadem w grach wyścigowych. Domyślnie 66%, bez wpływu na kierownicę."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Gamepad: pad i klawiatura przesuwają wskaźnik CD-i. Mysz: mysz PC przesuwa wskaźnik (gry typu wskaż i kliknij oraz z pistoletem), pad zachowuje tylko przyciski. Hotkey + L3 przełącza w trakcie gry."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Gamepady stają się graczem 1, 2... a arcade sticki są przypisywane kolejnym graczom."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Uniwersalny hack taktowania."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "Niemiecki i francuski wymagają wersji PAL gry, japoński wersji NTSC."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Oddaje całą klawiaturę grze (Scroll Lock przywraca ją skrótom) i przechwytuje mysz. Gamepad nadal działa."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Dobre przy problemach z emulacją pamięci podręcznej."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Chipset graficzny dla modeli innych niż AGA. Automatyczny podąża za wybranym modelem, co prawie zawsze jest właściwe."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Wtyczka graficzna używana do renderowania gry."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Ustawienie wstępne jakości grafiki (tekstury, filtrowanie). AUTO wybiera je na podstawie ilości pamięci."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Znacząco wpływa na wydajność CPU."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Znacznie poprawia jakość tekstur generowanych efektami render-to-texture. Domyślnie włączone. Wyłączenie może zapobiec awariom gier używających własnych tekstur."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Gry z pistoletem grane kontrolerem (bez pistoletu). Względne: gałka przesuwa kursor. Bezwzględne: pozycja gałki odpowiada pozycji na ekranie, po puszczeniu wraca na środek."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE jest szybka, LLE dokładniejsza, ale wymaga plików ROM DSP."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START wysyła klawisz wyjścia (X) do Visual Pinball zamiast zamykać jego okno."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START wysyła klawisz wyjścia (X) do Visual Pinball zamiast zamykać jego okno: otwiera się jego menu (stół zamyka się z WYŁĄCZ MENU)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 szybki zapis, START+L3 szybkie wczytanie, START+R3 zrzut ekranu. Domyślnie włączone."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Hack wymagany przez niektóre gry (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Hack wymagany przez niektóre gry."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Połówkowe scanline'y naśladują ekran CRT. 560 x 192 daje czystszy obraz na płaskim panelu."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Kontroler dysku twardego, wymagany do uruchamiania obrazów dysków twardych .hdv i .2mg. Zmiana uruchamia maszynę ponownie."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Domyślnie ukryty; wyłącz, jeśli gra nie uruchamia się poprawnie."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Ukrywa model broni w grze (zależy od gry)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Ukrywa wskaźnik na ekranie dotykowym po okresie bezczynności."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Ukrywa wskazówki kompilacji shaderów i PPU."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Ukrywa celownik po chwili bez celowania lub strzelania. Wraca, gdy tylko znów wycelujesz."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Ukrywa krawędzie obrazu jak telewizor lub dodaje ramkę (wartości ujemne)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Ukrywa biały błysk pokazywany przy każdym strzale."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Wysokopoziomowa emulacja niektórych funkcji Portfolio OS. Może poprawić wydajność w niektórych grach."

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "Wyższa dokładność naprawia błędy w niektórych grach kosztem wydajności. Używana tylko, gdy dekoder SPU jest ustawiony na Dynamic lub LLVM."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "Wyższa liczba klatek dzięki interpolacji klatek, ograniczona synchronizacją pionową. Może powodować drobne błędy wizualne lub w animacjach."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "Więcej to dokładniej, ale wolniej."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "Wyższe wartości zużywają mniej pamięci, niższe działają szybciej."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Poprawka prędkości House of the Dead 4: częstotliwość CPU w GHz (np. 4.3). Wykrywana automatycznie, gdy nie jest ustawiona."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Jak daleko gałka musi się wychylić, zanim Amiga to zauważy. Zwiększ, jeśli postać porusza się sama."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Prędkość ruchu paddle."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Prędkość ruchu paddle, gdy mysz jest używana jako urządzenie portu gier."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Jaka część szerokości ekranu przesuwa paddle od końca do końca. Mniejsza wartość przyspiesza paddle i pozwala dojść do ograniczników bez wyprowadzania wskaźnika poza ekran, czego wymagają niektóre ekrany kalibracji."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Siła reakcji gałki."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Sposób wyświetlania ekranu TV i ekranu GamePada."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Sposób, w jaki pad jest przedstawiany Amidze."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Sposób, w jaki pad jest przedstawiany Amidze. 'Joystick' to klasyczny 2-przyciskowy drążek obsługiwany przez każdą grę. 'Pad CD32' dodaje kolorowe przyciski i jest wybierany automatycznie na CD32."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Sposób renderowania obrazu. RGB jest najostrzejszy, tryby kompozytowe i TV odtwarzają rozlewanie kolorów ekranów z epoki."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Sposób renderowania obrazu. Tryby kompozytowe odtwarzają rozlewanie kolorów ekranów z epoki, RGB jest najostrzejszy."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Sposób skalowania obrazu do ekranu."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Hybrydowa rysuje nowe shadery od razu, gdy się budują. Asynchroniczna może na chwilę pominąć obiekty. Synchroniczna każe grze czekać na każdy shader."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Po wyłączeniu wyłącza wzór ditheringu, którym PSX zwalcza banding kolorów."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Po wyłączeniu DualShock można przełączać między trybem CYFROWYM/ANALOGOWYM kombinacją przycisków."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Po wyłączeniu moduły są kompilowane dopiero, gdy są potrzebne. Zależnie od gry może to nieoczekiwanie i często przerywać rozgrywkę."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Jeśli podłączonych jest kilka pistoletów, ustaw tę opcję, aby skonfigurować tylko jeden."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "W razie potrzeby określ używany ROM GBA."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Jeśli nazwa folderu zawiera 'soniccd', RetroBat automatycznie uruchomi Sonic CD RSDK; użyj tego, aby to wymusić."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Gdy joystick jest w tej strefie martwej, kursor się nie porusza."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Jeśli używasz gamepada z czujnikiem ruchu, np. DualShock lub Switch Pro, włącz, aby korzystać z czujnika ruchu."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Jeśli używasz prawdziwych Wiimote z Sensor Barem, ustaw właściwe położenie Sensor Bara dla lepszej precyzji."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "Ignoruje usługi Horizon OS, może rozwiązać awarie niektórych gier."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Ignoruje ruch gałki analogowej poniżej tego progu."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "Ignoruje istniejące pliki ini w folderze 'bios\mame\ini'."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Ignoruje drobne ruchy gałki wokół środka. Zwiększ, gdy kursor na ekranie porusza się sam."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Ignoruje ustawienia backglassa specyficzne dla stołu (plik .res obok stołu) podczas gry. Plik jest zachowany i przywracany przy wyjściu."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Ignoruje ustawienia dla gier zapisane w shadPS4 i zawsze używa ustawień RetroBata."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Poprawia wydajność na CPU z więcej niż 4 rdzeniami, domyślnie włączone."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Poprawia wydajność w wielu grach. Wyłączenie może zapobiec błędom graficznym w niektórych innych grach."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "Poprawia renderowanie wielokątów z rendererem OpenGL."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Poprawia dokładność shaderów. Wyłączenie daje niewielki wzrost prędkości, ale może powodować błędy graficzne w niektórych grach."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Zwiększa rozdzielczość kosztem wyższych wymagań. Tylko OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Zwiększa rozdzielczość kosztem wyższych wymagań. Wymaga klucza Redream."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Zwiększa rozdzielczość kosztem wyższych wymagań. Tylko Vulkan i OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Poprawia dokładność w niektórych grach, ale może obniżyć wydajność."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Zwiększa głębię kolorów."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Poprawia wydajność w niektórych grach, ale pomija wszystkie efekty oparte na EFB."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Poprawia wydajność."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Poprawia wydajność. Eksperymentalne przy kilku konsolach."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Poprawia stabilność w niektórych grach, ale obniża wydajność."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Tylko w OpenGL."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "W grach wielopłytowych z plikiem .m3u określa numer uruchamianej płyty."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "Zwiększa dokładność, może naprawić niektóre problemy z dźwiękiem i prędkością."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Zwiększ, jeśli strzały są rejestrowane nieco obok celu."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Zwiększ, jeśli widok lub gracz porusza się sam."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Zwiększ, jeśli widok lub gracz porusza się sam. Domyślnie 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Zwiększa rozdzielczość OpenGL 3Dfx Voodoo."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Zwiększa liczbę sprite'ów rysowanych jednocześnie na ekranie."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Zwiększa użycie RAM i czas pierwszego uruchomienia, ale ogranicza odczyty z dysku po starcie."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "Zwiększenie wartości może powodować błędy."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Inicjuje cele renderowania koloru z emulowanej pamięci. Potrzebne niektórym grom do poprawnego renderowania, może obniżyć wydajność. Domyślnie wyłączone."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Inicjuje cele renderowania głębi z emulowanej pamięci. Potrzebne niektórym grom do poprawnego renderowania, może obniżyć wydajność. Domyślnie wyłączone."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Podaj używany serwer w formacie 'x.x.x.x:y'."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Wkłada rozszerzenie MoonSound do slotu I/O."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Wkłada rozszerzenie Video9000 do slotu I/O."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Wkłada dysk do napędu dyskietek, często używane w grach CD-ROM."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Zainstalowany układ wideo. Automatyczny używa TMS9918A, chyba że gra wymaga rozszerzenia F18A. Wymaga restartu rdzenia."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Interpoluje wyjście audio dla lepszej jakości."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "Interpreter ma lepszą kompatybilność niż dynamiczny rekompilator JIT, JIT jest szybszy."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Zamienia przyciski A/B i X/Y."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Odwraca sygnał czujnika światła Zappera. Wymagane przez niektóre pistolety."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Odwraca sygnał spustu Zappera. Wymagane przez niektóre pistolety."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Odwraca oś pionową prawej gałki analogowej gamepada."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "Odwraca celowanie w górę i w dół."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Odwraca patrzenie w górę i w dół (gamepad i mysz)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Odwraca patrzenie w górę i w dół gamepadem."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Odwraca patrzenie w górę i w dół prawą gałką."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Odwraca oś pionową podczas lotu."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT jest najszybszy, Interpreter dokładniejszy."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Kompilacja Just In Time. Znacznie przyspiesza modele 68020 i późniejsze. Ignorowana na maszynach 68000 i automatycznie wyłączana w trybie cycle exact."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Utrzymuje powłokę DOS po wyjściu z gry lub gdy uruchomienie się nie powiedzie."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Zachowuje lub usuwa pliki gier po rozpakowaniu (squashfs, 7z)"

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Zachowuje oryginalne proporcje zamiast rozciągać obraz."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Klawisz otwierający menu Amiberry. F12 to jedyny klawisz funkcyjny, którego Amiga nigdy nie miała, więc tylko on pozostaje wolny."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Klawisz przełączający między trybem okna a pełnym ekranem podczas emulacji."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Klawisze używane jako joystick, gdy nie podłączono kontrolera. Strzałki strzelają prawym Ctrl. Klawiatura numeryczna strzela 0 lub 5. WASD strzela lewym Alt."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 i R3 wykonują ruchy specjalne bieżącej postaci, gdy gra je udostępnia. Domyślnie włączone."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = serwis, R3 = test, do otwierania menu operatora gier. Domyślnie włączone."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "LLVM jest najszybszy; w razie problemów użyj ustawień Interpreter."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "LLVM to najszybsza opcja z bardzo dobrą kompatybilnością. W razie problemów użyj rekompilatora ASMJIT."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "Język, w którym gry mają wyświetlać tekst."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Język menu i tekstu w grze. Język niedostępny w grze jest ignorowany i zachowywane jest ustawienie z gry."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Język napisów. Język niedostępny w grze jest ignorowany i zachowywane jest ustawienie z gry."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Język głosów. Język niedostępny w grze jest ignorowany i zachowywane jest ustawienie z gry."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Duże przyspieszenie na wielordzeniowych CPU, ale niewielka liczba gier się z tym zawiesza."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Uruchamia MameHooker do obsługi wyjść."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Zostaw 'Auto', chyba że wykrywanie zawiedzie."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Zostaw domyślne AUTO, chyba że gra wymaga określonego ustawienia."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Zostaw AUTO dla automatycznego wykrywania."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Zostaw auto, aby automatycznie dopasować do orientacji gry; użyj tego ustawienia, aby w razie potrzeby wymusić."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Zostaw wyłączone, chyba że źródło synchronizacji to wideo: vsync i synchronizacja audio źle ze sobą współpracują."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Zostaw AUTO, aby emulator wybrał pierwszy prawidłowy BIOS znaleziony w '\bios\pcsx2\bios'."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Zostaw Automatyczny, aby zachować procesor, który faktycznie miał wybrany model. Szybszy CPU może psuć gry zależne od precyzyjnego taktowania."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Zostaw Automatyczny, chyba że gra wymaga określonego ROM-u. Plik musi być w folderze bios. Wymaga restartu rdzenia."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Zostaw domyślnie WŁ., aby włączyć optymalizacje JIT CPU."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Zostaw 16:9, chyba że masz monitor 4:3."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Zostaw domyślnie włączone, używa wielu wątków do renderowania."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "RĘCZNIE nie zmienia wartości ustawionej przez użytkownika, AUTO to 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "Lewo staje się prawem, a góra dołem."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Pozwala ALTIRRA wybrać profil na podstawie gry."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Pozwala RetroArch mapować kontrolery własnymi profilami autokonfiguracji zamiast mapowania RetroBat. Nadpisuje autokonfigurację RetroBata."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Pozwala RetroBat spróbować odczytać sekwencję rozruchu z pliku hash MAME lub nazwy pliku (nawiasy)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Pozwala RetroBat spróbować odczytać sekwencję rozruchu z pliku hash MAME."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Pozwala Visual Pinball samemu przełączyć się na wybrany tryb wideo zamiast zmieniać rozdzielczość pulpitu."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Pozwala ROM-owi kartridża MegaWiFi uzyskać dostęp do sieci i internetu. Włączaj tylko dla zaufanych ROM-ów."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Pozwala rdzeniowi samemu nadawać tempo zamiast polegać na RetroArch. Spróbuj 'standard 50 Hz', jeśli gra PAL działa nierówno."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Pozwala emulatorowi odczytywać pamięć GS. Domyślnie włączone. Wyłączenie jest szybsze, ale może psuć niektóre efekty graficzne."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Pozwala lewej gałce działać jako joystick oprócz krzyżaka."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Znosi limit klatek gry, jeśli gra na to pozwala. Każda wartość poza oryginalną może psuć grę."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Łączy od 2 do 4 Lynxów kablem ComLynx na jednym ekranie, każdy z własnym kontrolerem. Wyłącza stany zapisu i osiągnięcia."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Wczytuje własny profil mapowania kierownicy."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Wczytuje mody (pliki .dusk) z folderu nazwanego jak gra, obok niej, lub z dusklight\data\mods, gdy go nie ma."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Wczytuje mody z folderu User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Wczytuje mody umieszczone w folderze mods gry (jeden folder z mod.ini na mod). Domyślnie włączone."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Wczytuje ustawienie wstępne jakości grafiki (tekstury, filtrowanie, miękkie cząsteczki). Zostaw AUTO, aby zachować ustawienia z gry."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Wczytuje dwa pierwsze dyski gry wielodyskowej jednocześnie do napędu 1 i napędu 2, zamiast tylko do napędu 1. Wymagane przez nieliczne gry potrzebujące dwóch napędów."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Wczytuje zastępcze tekstury z Data\Assets\HDTextures\<rom> w folderze emulatora."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Wczytuje cały obraz płyty do pamięci. Szybsze wczytywanie, większe użycie RAM."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Niska jakość shaderów może poprawić wydajność, ale powodować błędy."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Mniej to mniejsze opóźnienie, zbyt mało powoduje zaniki dźwięku."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Obniża precyzję GS, aby uniknąć szczelin między pikselami przy upscalingu. Naprawia tekst w Wild Arms, efekt duchów w SoulCalibur."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Niższe wartości zmniejszają opóźnienie dźwięku, wyższe ograniczają trzaski."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "Poziom MSAA lub SSAA."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Taktowanie maszyny. 60Hz to maszyna amerykańska, 50Hz europejska. Kilka europejskich programów wymaga 50Hz do działania z właściwą prędkością. Zmiana uruchamia maszynę ponownie."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Pamięć główna. Auto używa RAM modelu lub bazy gier. Nieobsługiwane rozmiary są zaokrąglane w górę do następnego rozmiaru modelu."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "Znacznie przyspiesza tryb warp, przełączając emulację SID na 'FastSID' podczas warp."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Ręcznie przypisuje pad używany przez gracza. Potrzebne tylko, gdy RetroBat nie potrafi odróżnić dwóch identycznych padów, np. przy enkoderze arcade dla 2 graczy widzianym przez Windows jako jedno urządzenie. W przeciwnym razie zostaw AUTO."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Wiele gier potrzebuje tylko kopii do tekstur, ale jeśli widzisz zaczernioną lub brakującą grafikę, może być potrzebny wybór kopii do RAM."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Mapuje przyciski 8BitDo M30 lub podobnego pada jeden do jednego, na podstawie mdControllers.json."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Mapuje kontroler jako kontroler wyścigowy; gry niezgodne z kierownicą nie będą działać."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Mapuje select na dodatkowy przycisk, przydatne w grach Zelda, aby uniknąć wyjścia przy zapisie."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Mapuje spusty na oś pionową gałki analogowej. Przydatne w Gran Turismo i innych grach wyścigowych."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Dopasowuje kolory do wyglądu na prawdziwym sprzęcie."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Koprocesor matematyczny. Używa go tylko garstka tytułów Amigi, a dodanie go do maszyny, która go nie miała, może zdezorientować kilka gier."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Maksymalna prędkość kursora dotykowego sterowanego joystickiem."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "Maksymalna liczba wątków CPU używanych do upscalingu tekstur. Użyj łącznej liczby wątków minus 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Może powodować artefakty w niektórych grach."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Może poprawić wydajność na procesorach z wieloma rdzeniami. W niektórych sytuacjach może spowalniać z powodu obciążenia dodatkowego wątku."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Może zmniejszyć przycięcia kosztem dłuższego uruchamiania gry."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Metoda używana dla trybów wideo z przeplotem (nie dotyczy Nintendo 64)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Metoda używana dla trybów wideo z przeplotem."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "Metoda odczytu danych z dysku: synchroniczna naśladuje oryginalny sprzęt, asynchroniczna może ograniczyć przycięcia, wczytanie wstępne ładuje cały obraz kosztem początkowego opóźnienia."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Naśladuje niektóre famiklony zamieniające współczynniki wypełnienia kanałów prostokątnych."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "Mipmapping jest wymagany przez niektóre gry."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Odbija świat w poziomie, jak w wersji gry na Wii."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C to karta dźwiękowa obsługiwana przez większość gier. Wybierz Mouse Card tylko dla programów wymagających prawdziwej myszy Apple; zastępuje ona kartę dźwiękową. Zmiana uruchamia maszynę ponownie."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard to karta dźwiękowa obsługiwana przez większość gier. Ignorowana w modelach //c, które nie mają gniazd rozszerzeń."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Tryb wstępnie wybrany na ekranie wyboru graczy. Download Play wymaga oryginalnego BIOS i firmware."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "Monochromatyczny jest wymagany przez gry w wysokiej rozdzielczości (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Dokładniejsza emulacja CD block. Wymaga ROM-u CD block i wyłącza ustawienie prędkości odczytu."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "Dokładniejsze zachowanie, ale może obniżyć wydajność. Domyślnie WŁ."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "Większość gier używa portu 2; użyj tego ustawienia dla starych gier wymagających joysticka w porcie 1."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Automatycznie montuje dysk C: przy starcie."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Mysz: gry takie jak Elansar czy Defender of the Crown. Gałka analogowa: BattleSphere, wybierz ją też w opcjach gry."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Przesuwa mysz gałką analogową kontrolera 1 (L2/R2 = przyciski). Jeden port musi być ustawiony na Mysz."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Ruch lewą gałką analogową oraz krzyżakiem. Domyślnie włączone."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Poziom wygładzania krawędzi Multi-Sampling. Tylko OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Poziom wygładzania krawędzi Multi-Sampling. Tylko Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Mnożnik prędkości kursora joysticka podczas przytrzymania przycisku przyspieszenia wskaźnika (domyślnie L2)."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "Multitap musi być ustawiony, jeśli ma grać więcej niż 2 graczy."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Wycisza mechaniczny hałas napędów dyskietek."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "NIE pokazuje tylko obraz lewego oka. Anaglif wymaga okularów 3D w tych samych kolorach, obok siebie jest dla gogli VR i ekranów 3D."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC używa cdi200.rom, PAL używa cdi220b.rom."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Natywna rozdzielczość gry. Domyślnie ta ustawiona w grze."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Wymagane przez kilka gier, w tym kilka przygodówek typu wskaż i kliknij."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "Do rozpoczęcia gry nie jest potrzebna moneta."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Liczba emulowanych napędów dyskietek. Prawdziwa Amiga 500 miała tylko jeden. Dwa napędy przyspieszają gry wielodyskowe, ale kilka tytułów oczekuje tylko jednego."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Liczba klatek między kolejnymi naciśnięciami turbo."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Domyślnie wyłączone. Adaptacyjna nie czeka na ekran, gdy klatka jest spóźniona."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Domyślnie wyłączone: emulator sam działa z prędkością automatu (57,5 Hz). Włącz, jeśli obraz się rozrywa."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "Na monitorze 120Hz lub szybszym bez G-Sync ani FreeSync użyj najwyższej częstotliwości odświeżania będącej wielokrotnością 60Hz."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Domyślnie włączone; wyłącz, aby używać jakości dźwięku 11 kHz."

msgctxt "game_options"
msgid "On by default."
msgstr "Domyślnie włączone."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Domyślnie włączone. Wyłącz, aby zyskać prędkość na zintegrowanych kartach graficznych."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Domyślnie włączony. Wyłącz, gdy pistolet ma własne celowanie (laser, celownik Sinden)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Jeden piksel ekranu na piksel gry (zalecane dla shaderów)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Działa tylko przy włączonym upscalingu tekstur (xBRZ). Większe tekstury nie będą powiększane."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Działa tylko z systemem MVS AZJA/JAPONIA."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Działa tylko z OpenGL, twarda synchronizacja GPU i CPU. Zmniejsza opóźnienie kosztem wyższych wymagań."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Działa tylko z programowym sterownikiem wideo."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Działa tylko przy włączonym OGRANICZ FPS. Domyślnie: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Tylko dla azjatyckich wersji gier."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Tylko dla nowszych wersji Ikemen GO. Vulkan jest eksperymentalny."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Powiększane są tylko bufory ramki większe niż ten rozmiar; może naprawić problemy w niektórych grach."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Używaj ogranicznika klatek tylko, jeśli gra bez niego działa zbyt szybko. Niektóre gry mogą się zawieszać przy zbyt wysokiej liczbie klatek. W takim przypadku ustaw dowolną wartość inną niż Off."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Używaj tylko, jeśli masz dwa identyczne kontrolery wykrywane niepoprawnie. Przypisuje pady według pozycji zamiast nazwy, co jest mniej niezawodne."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Używaj tylko do zmniejszenia okna przy włączonym skalowaniu w ustawieniach Windows."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Używane tylko, jeśli ustawione: dla G2 nie zakłada się domyślnego obrazu celownika."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Używane tylko po wybraniu urządzenia wyjścia MIDI."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Wersja silnika OpenBOR używana do uruchomienia gry. Auto wykrywa ją z danych gry lub z numeru kompilacji [XXXX] w nazwie pliku, jak w OpenBOR standalone."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "OpenGL jest wymagany dla shaderów i rozdzielczości wewnętrznej."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Tylko OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Tylko OpenGL. Naprawia czarny ekran na niektórych zintegrowanych GPU AMD, kilka gier będzie renderowanych niepoprawnie."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Otwiera drugie okno z widokiem GamePada."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Opcjonalna płyta dźwiękowa (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) lub subwoofer (gry Gaelco). Domyślnie miks, tylko płyta główna dla Star Wars Racer Arcade."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "Podkręca CPU, układ SA-1 i układ Super-FX; może zmniejszyć spowolnienia, ale może powodować problemy w niektórych grach."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Podkręca lub obniża taktowanie obu procesorów SH-2. 100 to prędkość fabryczna."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Podkręca lub obniża taktowanie emulowanego głównego CPU. Może ustabilizować liczbę klatek, ale psuje niektóre gry."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Podkręca emulowany układ 68k dla lepszej liczby klatek."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "Nadpisuje mapowanie gamepada RetroBat własnym mapowaniem użytkownika umieszczonym w folderze skryptów emulatora."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Nadpisuje domyślne oświetlenie stołu."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL działa w 50 Hz i jest właściwy dla niemal każdego europejskiego tytułu Amigi. NTSC działa w 60 Hz i pasuje do garstki wydań amerykańskich."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 identyfikuje kontrolery własnym numerem slotu, który nie odpowiada kolejności graczy RetroBat. Automatyczny bierze pierwszy znaleziony; zmień, jeśli reaguje niewłaściwy kontroler."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "Łata plik TOS, aby szybciej się uruchamiał."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Ścieżka do folderu z AGS WinUAE; po uzupełnieniu RetroBat doda launcher AGS do systemu Amiga."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Ścieżka do folderu z ExoDos, wymagana, aby RetroBat mógł skanować gry ExoDOS."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Ścieżka do folderu z ExoWin3x, wymagana, aby RetroBat mógł skanować gry ExoWin3x."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Ścieżka do folderu z ExoWin9x, wymagana, aby RetroBat mógł skanować gry ExoWin9x."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Dla każdej gry: każda gra ma własną pamięć konsoli 8 KB, więc nigdy się nie zapełni. Wspólna: jedna pamięć dla wszystkich gier, jak w prawdziwym odtwarzaczu."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Oświetlenie na piksel zamiast na wierzchołek. Poprawia jakość w niektórych grach."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Wzrost wydajności, może też poprawić stabilność niektórych gier, np. GT6."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Umieść własny obraz celownika i wybierz go poniżej."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Umieść własny plik 'crosshair.png' w podfolderze 'cross' emulatora lub wybierz plik poniżej."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Umieść własny plik 'crosshair.png' w podfolderze 'cross' emulatora."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: pchnij gałkę w górę, aby się wznosić (w automacie wznoszenie to drążek do siebie)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "Graj w gry MVS bez wrzucania monet."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Odtwarza sygnał ostrzegawczy przy niskim zdrowiu."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Odtwarza sygnały VMU."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Gra tylko z prawdziwymi Wiimote, inne kontrolery nie będą działać."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Liczba graczy wstępnie wybrana na ekranie wyboru graczy przy uruchomieniu."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Podłącza RetroPady do różnych portów, przydatne przy adapterach dla 4 graczy."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Podłącza mysz do portu joysticka, odłączając podłączone joysticki."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "Podłącza dodatkowe joysticki do portów 2, 3 i 4."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "Podłącza GunCon do portu 2, do użycia w Die Hard Trilogy."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Podłącza kartę MIDI i wysyła jej wyjście do tego urządzenia MIDI Windows, numerowanego jak w opcjach MIDI emulatora. BRAK zachowuje standardowy dźwięk FM."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Wskazuje katalog 'system' RetroArch na inny folder."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Port 1 to zawsze GamePad Wii U. Można dodać do niego Wii Remote w grach, które go wymagają."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Port Light Phasera. Domyślnie port 1."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Port Super Scope. Domyślnie port 2."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Port Zappera. Domyślnie port 2."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Może skrócić wczytywanie kosztem dłuższego uruchamiania."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "Rekompilator PowerPC, domyślnie włączony i znacznie szybszy. Wyłącz, aby używać interpretera."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Prekompiluje pamięć podręczną shaderów przy starcie gry; zostaw WŁ., aby ograniczyć przycięcia w grze."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "Precyzyjna jest najdokładniejsza, a złagodzona może zwiększyć wydajność, ale psuć niektóre gry."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Preferowany region. Gra, która go nie akceptuje, wybiera obsługiwany."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Wczytuje wszystkie ścieżki CD do RAM."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Wczytuje wcześniej własne tekstury przy starcie."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Naciśnij, aby otworzyć menu Amiberry."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Naciśnij, aby zresetować Amigę."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Naciśnij, aby pokazać klawiaturę ekranową."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Zapobiega niektórym artefaktom, ale może dawać ostre krawędzie."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Zapobiega przesterowaniu zmiksowanego dźwięku kilku graczy."

msgctxt "game_options"
msgid "Processor model."
msgstr "Model procesora."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Model procesora. CPU szybszy niż w prawdziwej maszynie może psuć gry zależne od precyzyjnego taktowania."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Umieszcza pad gracza 1 w porcie 1 zamiast w porcie 2. Wymagane przez kilka gier, w tym kilka przygodówek typu wskaż i kliknij."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Usprawnienia wygody: szybka przemiana, większe portfele, szybka wspinaczka, natychmiastowe zapisy, autozapis, ulepszone menu mapy... Klasyczne odpowiada grze na GameCube. Nieustawione: zachowane są ustawienia z menu Dusklight."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD JAKO KLAWIATURA: krzyżak wysyła strzałki, a przyciski SPACE / RETURN, dla gier bez obsługi joysticka."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "Domyślnie bieg, przycisk biegu powoduje chodzenie."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "ReShade jest używany przez RetroBat do wyświetlania ramek (bezels) i shaderów w niektórych emulatorach standalone. WYŁĄCZONY: ramki są wyświetlane w oknie nakładki. UŻYJ WŁASNEGO: RetroBat nigdy nie instaluje, nie modyfikuje ani nie usuwa plików ReShade w folderach emulatorów."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Odczytuje wyniki render-to-texture na CPU. Może być potrzebne w niektórych grach, ale powoduje synchronizację w połowie klatki, więc ma ogromny wpływ na wydajność."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Odczytuje płytę szybciej niż napęd konsoli. Niektóre gry mogą tego nie oczekiwać."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Odczytuje plik ini z podfolderu 'bios'."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Odczytuje plik ini z folderu 'bios\mame\ini'."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "Rzeczywista prędkość Amigi to bezpieczne ustawienie domyślne. Turbo wczytuje szybciej, ale może psuć niektóre loadery i zabezpieczenia przed kopiowaniem."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Wtyczka Reality Signal Processor, wymuszana na LLE, gdy sterownik wideo jest ustawiony na Parallel."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Wtyczka Reality Signal Processor."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Zalecane: liniowe, gdy skala drugiego ekranu jest poniżej 100%."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "Rekompilator jest najszybszy, Interpreter dokładniejszy."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "Rekompilator jest znacznie szybszy, interpreter przydaje się tylko do debugowania. Wymaga restartu."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "Obniża dokładność dla lepszej wydajności, jakość grafiki będzie niższa."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Zmniejsza prędkość sterowania analogowego, niektóre gry wymagają niskich wartości, aby dało się grać."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Skraca wczytywanie. Może psuć kilka gier zależnych od rzeczywistego taktowania płyty."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Ogranicza przycięcia kosztem znacznie dłuższego uruchamiania gry i wysokiego użycia GPU."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Zmniejsza użycie VRAM kosztem jakości, może zwiększyć przycięcia."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Ogranicza trzaski powodowane dużymi zapisami do kanału DMC. Niedokładne, może łagodzić niektóre samplowane dźwięki."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Ogranicza trzaski i zacinanie, ale na wolniejszych CPU może wyraźnie obniżyć jakość dźwięku; zostaw AUTO, aby wyłączyć."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Ogranicza migotanie."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Ogranicza przycięcia i przyspiesza uruchamianie po pierwszym rozruchu."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Ogranicza drgające wielokąty i wypaczanie tekstur w grach 3D."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "Obsługa odtwarzania MPEG ReelMagic."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Uzupełnia pas miksturami z ekwipunku."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "Odświeża stan stron pamięci, aby uwzględnić dane zapisane przez GPU. (Użyj w grach 'Team Ninja', aby naprawić brakujące modele postaci)."

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Region firmware NEC PAC. Japonia: pac-n1.bin lub pce-lp1.bin. USA: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Region wybierany jako pierwszy na płytach wieloregionowych."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Usuwa ramki n pikseli u góry i u dołu ekranu."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Usuwa boczne czarne pasy w niektórych przerywnikach (ekrany ultraszerokie). Obszary poza oryginalnym kadrem mogą wyglądać na błędne."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Usuwa górne i dolne czarne pasy podczas namierzania, celowania, przerywników i dialogów."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Usuwa biały błysk wyświetlany przy strzale."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Usuwa jedną klatkę opóźnienia wejścia, ale podwaja wymagania systemowe."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Usuwa czarne ramki wokół obrazu Amigi. Silniejsze ustawienia przycinają więcej i mogą obciąć krawędzie kilku gier."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Usuwa migotanie obrazu w Hummer."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Usuwa biały błysk pokazywany, gdy gry wyłączają renderowanie 3D."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Renderuje w wielokrotności natywnej rozdzielczości N64. Nadpisuje ustawienie rozdzielczości wewnętrznej, gdy nie jest WYŁ."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Renderuje cieniowanie Gourauda z pełną precyzją, aby ograniczyć banding kolorów w grach 3D."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "Używana ścieżka emulacji render target. rtv/fbo daje lepszą wydajność, rov/fsi najwyższą dokładność."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Rozdzielczość renderowania dla gier wektorowych."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Renderuje w 24-bitowych kolorach i usuwa dithering."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Zastępuje oryginalne tekstury pakietem własnych tekstur (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Odtwarza filtr dolnoprzepustowy prawdziwego sprzętu. 'Emulowany' podąża za przełącznikiem filtra samej maszyny."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Żąda określonych slotów; wybierz powyżej opcję OKREŚLONY SLOT."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "Wymagane przez programy w BASIC. Używa ATARIBAS.ROM, jeśli jest obecny, w przeciwnym razie wbudowanego Altirra BASIC."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Wymagane w grach Formula One."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Wymagane w Paper Mario: The Thousand-Year Door."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Wymagane, aby skrót przewijania wstecz działał."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Wymagane, aby uruchomić grę bez automatu ruchowego Cycraft."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Wymagane, aby naprawić Def Jam Icon."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Wymagane do uruchamiania niektórych starych rom hacków; zostaw wyłączone dla gier komercyjnych."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Wymaga co najmniej '4X SSAA (UPORZĄDKOWANE)'. Tryby 4x wymagają '16X SSAA (UPORZĄDKOWANE)'."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Rozdzielczość emulowanego wyjścia wideo."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "Respektuje bit trybu Non-Java dla operacji wektorowych w backendach PPU. W razie wątpliwości nie zmieniaj. Domyślnie wyłączone."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Krzywa reakcji kursora dotykowego sterowanego joystickiem."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "RetroBat skonfiguruje tylko kontroler gracza 1."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "RetroBat zsynchronizuje foldery zapisów dolphin i libretro-dolphin."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "RetroBat domyślnie używa BIOS psxonpsp; włącz tę opcję, aby wymusić starszy plik BIOS SCPH550X."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Ponownie używa pamięci podręcznej shaderów zbudowanej dla gry. Auto pozwala zdecydować emulatorowi."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Wybór biegu prawą gałką w grach wyścigowych z 4 biegami. Skrzynia H: skosy, jak w prawdziwej skrzyni biegów. Kierunki: góra 1, dół 2, lewo 3, prawo 4. L1/R1 zawsze zmieniają bieg w dół/w górę."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Obraca obraz i sterowanie. Domyślnie znane gry są obracane automatycznie. RĘCZNIE: SELECT zmienia obrót."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "Obraca obraz w grach pionowych, do włączenia przy mega-bezels."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Obraca obraz w grach pionowych."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "Obraca obraz, przydatne w grach wymagających pionowego wyświetlania."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Obraca przyciski akcji, zmieniając układ."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Obraca ekran pola gry w Windows podczas gry, przywracany przy wyjściu (Visual Pinball 10.8 i nowsze)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Obraca obraz wyjściowy, dla pionowych strzelanek."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Obrót stosowany na krańcach wymachu."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Działa z maksymalną prędkością podczas wczytywania gry CD-ROM na nieruchomym, cichym ekranie."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Działa z maksymalną prędkością podczas wczytywania dysku lub taśmy, gdy nie gra dźwięk. Dla dysków wymagana jest PEŁNA EMULACJA NAPĘDU."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Działa z oryginalną częstotliwością 57,524 Hz zamiast 60 Hz. Może się zacinać na ekranie 60 Hz."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Domyślnie bieg, przycisk biegu powoduje chodzenie. Domyślnie włączone."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Domyślnie bieg, przycisk biegu powoduje chodzenie. Zużywa wytrzymałość w trybie jednoosobowym."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "Uruchamia system z BIOS i funkcjami G7400."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Przyspiesza GPU i DSP. Może zwiększyć liczbę klatek w grach 3D, ale może powodować błędy."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Uruchamia obok siebie dwa połączone Game Geary. Gracze 1 i 2 sterują ekranami 1 i 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Bieg bez przytrzymywania przycisku biegu."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "Uruchamia 'jgenesis-gui.exe' zamiast wersji cli."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "Domyślnie gamepad SDL: odczytuje gamepady w standardowym układzie, a inne urządzenia (kierownice, dźwignie biegów, enkodery arcade) z surowymi przyciskami. SDL odczytuje każde urządzenie surowo."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT używa soundfontu Roland SC-55 dostarczanego z RetroBat."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "SSAA daje lepszą jakość kosztem wydajności."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "ROZCIĄGNIJ wypełnia cały ekran i wyłącza ramki (bezels)."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Zapisuje stan gry przy wyjściu i przywraca go przy następnym uruchomieniu (jeden plik na grę)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "Zapisy trafiają do kopii w folderze saves, oryginalny obraz nigdy nie jest modyfikowany. Reset zaczyna od oryginalnego dysku (stara kopia zachowana jako .bak)."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Skala linii statusu na ekranie."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Skaluje obraz tylko o liczby całkowite, dla ostrych pikseli."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Skaluje obraz tylko o liczby całkowite, dla ostrych pikseli. Tylko pełny ekran 1080p lub 4K na ekranie 16:9, z lekkim przycięciem u góry i u dołu."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Skaluje współrzędne X względem środka ekranu. Zmniejsz, jeśli strzały na krawędziach trafiają za daleko od celownika."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "Scanline'y nie są zgodne z shaderami HQ ani xBRZ."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Scanline'y, maska cienia i poświata luminoforu kineskopu."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "Obrót ekranu nie jest zgodny z układem poziomym."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Ekran DMD na osobnym ekranie, numeracja jak w INDEKS MONITORA. AUTO używa najmniejszego pozostałego ekranu. Wymaga KONFIGURACJA EKRANÓW z 3 ekranami."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Ekran backglassa, numeracja jak w INDEKS MONITORA. AUTO używa największego ekranu innego niż pole gry. Wymaga KONFIGURACJA EKRANÓW."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Ekran wyświetlania gier (0 = ekran główny). AUTO pozwala emulatorowi wybrać ekran."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Ekrany używane przez flipper (Visual Pinball 10.8 i nowsze). Pozycje backglassa i DMD są wtedy obliczane automatycznie. Nieustawione: używane są wartości SCREENRES."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Ekrany używane przez flipper. Pozycje backglassa i DMD są wtedy obliczane automatycznie. Nieustawione: 1 ekran."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "Wpisuje 0xCD do całej przydzielonej pamięci sterty."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "Drugi joystick może kolidować z myszą."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Wybierz 'dla konkretnej gry', aby używać pliku cfg gry z folderu emulators\psxmame\ctrlr."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Wybierz typ kontrolera kineskopu Amstrad (CRTC)."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Wybierz emulowany model Amstrad."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Wybierz mysz lub pad do sterowania wirtualnym wskaźnikiem w grze."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Wybierz NIE, aby wyłączyć pamięć podręczną tekstur."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "Wybierz shader BigPemu, możliwe tylko, gdy shadery RetroBat są ustawione na 'none'."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Wybierz stosowany filtr."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Wybierz stosowany shader."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Wybierz jeden z układów kontrolera."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "Wybierz układ kontrolera używany z opcją 'Profil dynamiczny'."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Wybierz róg ekranu, w którym pojawi się tatuaż."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Wybierz stosowany efekt; nie działa przy używaniu shaderów."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Wybierz układ przycisków akcji."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Wybierz port, do którego wkładany jest ROM GBA, domyślnie 2."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Wybierz emulowany model."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Wybierz stosowany shader, działa tylko ze sterownikiem wideo 'bgfx'."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Wybierz stosowany shader, działa tylko ze sterownikiem wideo 'openGL'."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Wybierz tryb zmiany biegów dla BattleGear4Tuned."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "Wybierz wtyczkę GPU; opcje RetroBat nie działają z wtyczką inną niż domyślna, można ją skonfigurować w folderze emulatora za pomocą config.exe."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Wybierz BIOS IPL do uruchamiania gry zależnie od jej regionu. Wymaga 'IPL_JAP.n64', 'IPL_USA.n64' i 'IPL_DEV.n64' w folderze bios\Mupen64plus."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Wybierz urządzenie odczytujące współrzędne X i Y."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "Wybierz sterownik używany dla shaderów ze sterownikiem wideo bgfx."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "Wybierz rozszerzenie dodawane do kontrolera."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Wybierz tryb prezentacji klatek."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Wybierz model oświetlenia; tryb starszy najmniej obciąża kartę graficzną."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Wybierz emulowaną maszynę."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Wybierz profil przypisany graczowi."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "Wybierz system źródłowy dla transfer paka między GB a GBC."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "Wybierz typ konsoli."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "Wybierz typ kadrowania obrazu. Użyj wartości EMUSCV, aby skorygować błędy wyświetlania oryginalnej konsoli."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "Wybierz typ pistoletu zależnie od gry."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Wybierz tryb wideo (typ kabla)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Wybierz, gdzie mają być zmapowane przyciski monety i start przy grze kierownicą."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Wybierz, gdzie mają być zmapowane przyciski test i serwis przy grze kierownicą."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Wybierz, czy przyciskiem potwierdzenia jest krzyżyk, czy kółko."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "Wybierz wewnętrzny silnik audio."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Wybierz stosowany filtr kolorów."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Wybierz API graficzne używane z rendererem teksturowym."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Wybierz emulowany joystick (niezgodne z MASTER COMPACT)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Wybierz emulowany joystick."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "Wybierz ekran pokazywany w układzie hybrydowym."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Wysyła do MAME pełną ścieżkę ROM zamiast samej nazwy ROM."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Wysyła wyjścia lamp i płyty napędowej do zewnętrznych narzędzi (MAMEHooker...) przez komunikaty Windows."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Wysyła wyjścia lamp i odrzutu pistoletu do zewnętrznych narzędzi (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Wysyła wyjścia lamp, wibracji pistoletu i płyty napędowej do zewnętrznych narzędzi (Hook Of The Reaper, QMamehook...) przez protokół sieciowy MAME."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Czułość emulowanego kontrolera z pokrętłem."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Ustawia domyślny ISO, do użycia z niektórymi grami homebrew."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Ustawia domyślne mapowanie kontrolera dla gracza 1."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Ustawia domyślne mapowanie kontrolera dla gracza 2."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Ustawia domyślne mapowanie kontrolera."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Ustawia maskę licencji aktywowanej zawartości (WSZYSTKIE LICENCJE to zazwyczaj zły pomysł, może prowadzić do nieokreślonego zachowania)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Ustawia filtr skalowania renderowanej zawartości. FSR wymaga Vulkan."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Ustawia filtr skalowania renderowanej zawartości. Tylko OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Ustawia przełącznik trudności Atari 2600."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Ustawia zachowanie przycisku mikrofonu."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Ustawia konsolę w trybie panoramicznym dla gier, które to obsługują."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Ustawia częstotliwość odświeżania hosta."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Ustaw dla gier wymagających kontrolera w porcie 2."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Włącz przy używaniu wielu pistoletów. Domyślnie włączone, jeśli znaleziono kilka pistoletów, a sterownik wejścia nie jest ustawiony na 'sdl'."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Ustaw tę opcję tylko przy używaniu prawdziwej deski Balance Board."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Ustaw tę opcję, aby umieścić mikrofon w slocie B."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Ustaw na 'WŁ.', aby zamykać Steam lub Epic Games Launcher przy wyjściu z gry."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Ustaw, aby podłączyć GunCon do portu 2, używane w niektórych wersjach Die Hard."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Ustaw, aby używać oryginalnego pada PSX zamiast DualShock."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Ustaw na TAK, aby w grach wyścigowych wracać na luz po puszczeniu klawisza zmiany biegu."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Ustawia przesunięcie jasności emulowanego wyświetlacza ciekłokrystalicznego."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Ustawia poziom kontrastu emulowanego wyświetlacza ciekłokrystalicznego."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Ustawia częstotliwość PowerPC w MHz. 0 (domyślnie) używa częstotliwości płyty gry."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Ustawia częstotliwość PowerPC w MHz. AUTO używa częstotliwości sprzętu gry (tylko Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "Ustawia częstotliwość PowerPC w MHz. Domyślnie 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Ustawia strefę martwą gałek analogowych gamepada, gdy typ urządzenia wejścia to 'Gamepad Classic' lub 'Gamepad Modern'."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Ustawia strefę martwą gałek analogowych gamepada."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Ustawia strefę martwą analogowych spustów gamepada."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Ustawia strefę martwą gałek analogowych. Używane tylko z typem kontrolera 'Gamepad Modern'."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Ustawia typ kontrolera gracza."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Ustawia czułość gałek analogowych."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "Ustawienie 0 oznacza, że wszystko jest zgłaszane jako zasłonięte, wymagane dla Forza Motorsport 4."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Ustawienie 1 może zwiększyć wydajność."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Kształt pikseli: kwadratowe lub jak na oryginalnym ekranie."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Kształt maski cienia rysowanej przez shader CRT. Używane tylko, gdy shader jest ustawiony na maskę CRT."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Domyślnie wspólny CMOS dla całej zawartości lub osobny dla każdej gry (lepsze przy grze sieciowej)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "Intensywność wyostrzania stosowanego przez FidelityFX CAS. Używane tylko, gdy filtr skalowania to FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Krótkie komunikaty na ekranie (stan zapisany...). Domyślnie włączone."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Pokazuje interfejs Dolphin oprócz ekranu gry."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "Pokazuje nakładkę FPS w grze."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Pokazuje konsolę debugowania Ryujinx."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Pokazuje obraz sterowania nałożony na ramkę (bezel)."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Pokazuje powiadomienie po podłączeniu lub odłączeniu kontrolera."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Pokazuje interfejs emulatora."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Pokazuje powiadomienia emulatora, domyślnie włączone (AUTO)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Pokazuje powiadomienia emulatora."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Pokazuje informacje o grze w lewym górnym rogu Craft."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Pokazuje informacje o kompilacji shaderów."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Pokazuje informacje o bieżącym układzie ekranów w prawym górnym rogu."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "Pokazuje lub ukrywa ustawienia RetroArch. 'Auto' to zalecane ustawienie."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Pokazuje nakładkę statystyk wydajności w grze."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Pokazuje powiadomienia o kompilacji shaderów."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Pokazuje poziome ramki. AUTO przycina je do obszaru używanego przez grę, najlepiej z PAR WEDŁUG DOT CLOCK."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Pokazuje klawiaturę Amigi na dole ekranu do pisania padem. Przełączaj przypisanym przyciskiem, poruszaj się krzyżakiem lub gałką, naciśnij inny przycisk, aby wpisać klawisz."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Pokazuje ślady kul na ścianach w miejscach trafień."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Pokazuje aktywność napędów i informacje o wydajności nad obrazem."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "Pokazuje rozszerzone linie PAL CRT, ale w większości gier są one zwykle puste."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Pokazuje nazwy dyskietek, diody napędów i prędkość, w oknie i na pełnym ekranie."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Pokazuje ekran konfiguracji WHDLoad, gdy gra go obsługuje."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Pokazuje monit WHDLoad i czeka na naciśnięcie przycisku przed startem gry. Domyślnie wyłączone, aby gra uruchamiała się od razu."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Zmniejsza/powiększa tatuaż, aby zmieścił się w obramowaniu ramki."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "Symuluje efekty poświaty luminoforu CRT. 'Simple' miesza bieżącą i poprzednią klatkę w proporcji 50:50."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "Symuluje efekty poświaty ekranu LCD."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Symuluje efekty specyficzne dla GPU PowerVR2 i analogowych sygnałów wideo."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Symuluje kolory ekranu LCD Game Boy Color."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "Symuluje efekt poświaty CRT, może ograniczyć migotanie."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Symuluje poświatę, może pomóc ograniczyć migotanie."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Rozmiar menu i paneli. Ograniczany przez grę do największej skali mieszczącej się w rozdzielczości wewnętrznej."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Rozmiar pikseli gry: wyższe wartości przybliżają i pokazują mniejszą część mapy. Domyślnie: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "Rozmiar największego ekranu w hybrydowym układzie ekranów."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Rozmiar drugiego ekranu względem głównego (tylko układy górny/dolny)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Rozmiar okna poza trybem pełnoekranowym."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Stosunek rozmiarów 2 emulowanych ekranów."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "Pomija VBI po wykryciu opóźnienia, pomaga przy zacinaniu dźwięku, gdy prędkość emulacji spada."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Pomija rysowanie klatki identycznej z poprzednią. Może poprawić wydajność."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Pomija klatki, aby uniknąć trzasków dźwięku na wolnych urządzeniach."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Pomija klatki, aby poprawić wydajność, kosztem szarpanego ruchu."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Pomija 60-sekundowe oczekiwanie na inne automaty przy rozruchu. Wyłącz przy grze na kilku automatach."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "Pomija logo startowe BIOS."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Pomija sprawdzanie przy rozruchu, które uniemożliwia uruchomienie gry."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Pomija sprawdzanie sprzętu przy rozruchu (kamera, kierownica, czytnik kart)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Pomija długą inicjalizację silnika kierownicy przy rozruchu. Wybierz rewizję swojej gry."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Pomija mechaniczny czas oczekiwania napędu dyskietek. Wczytywanie jest znacznie szybsze, a sam dysk jest odczytywany dokładnie jak oryginał."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Pomija filmy i logo startowe."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Pomija filmy startowe."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Pomija inicjalizację silnika kierownicy przy rozruchu."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Pomija filmy/FMV."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "Pomija rysowanie powierzchni dla obszaru określonego z lewej i prawej."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Pomija animację rozruchu BIOS wyświetlaną przy wczytywaniu zawartości."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Pomija animację rozruchu BIOS wyświetlaną przy wczytywaniu zawartości. Wyłącz, aby dostać się do ustawień systemowych PS2 i menedżera kart pamięci."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Pomija animację rozruchu BIOS przy wczytywaniu zawartości."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Slot, w którym montowane są obrazy dysków. AUTO wybiera go na podstawie typu obrazu. Zmieniaj tylko, jeśli gra odmawia uruchomienia."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Wolniej, ale wymagane przez kilka gier zależnych od zachowania pamięci podręcznej."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Wygładza tekstury 3D."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Wygładza zmiany kierowania. Potrzebne przy używaniu gamepada lub klawiatury."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Wygładza krawędzie shaderem, lekko zmiękcza obraz."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Wygładza dźwięk generowany przez układ Paula. 'Sinc' jest najbardziej wyrafinowany i najbardziej wymagający."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Łagodzi kierowanie gamepadem w grach wyścigowych. Domyślnie silne, bez wpływu na kierownicę."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Niektóre etapy SPU są wrażliwe na wyścigi, a dopuszczenie ograniczonej ich liczby naraz pomaga ograniczyć przestoje wydajności. Mniejsza wartość może poprawić wydajność i ograniczyć przycięcia w niektórych grach."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Niektóre gry nie wczytują się, jeśli system jest włączany z włożoną płytą CD. 'TAK' wkłada CD podczas animacji rozruchu."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Niektóre gry wymagają określonego klawisza do wykonania akcji; określ klawisz mapowany na przycisk SELECT kontrolera gracza 1."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Niektóre gry wymagają odwróconej osi pistoletów."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Niektóre gry wymagają rozszerzenia Game Drive."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Niektóre gry wymagają kontrolera w drugim porcie do rzucania granatów."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Niektóre dźwignie zmiany biegów są podłączone do komputera z innym ID urządzenia niż kierownica, np. dźwignie Thrustmaster."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Niektóre homebrew i rom hacki wymagają określonego wzorca RAM przy włączeniu. Wymagany restart."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Niektóre homebrew lub rom hacki wymagają włączenia tej opcji."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "Źródło dźwięku dla muzyki MIDI. Opcje MT-32 wymagają odpowiednich ROM-ów Roland w folderze bios."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Określa, jak ma działać emulacja zegara czasu rzeczywistego w niektórych grach."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Określa dodatek używany do odtwarzania audio CD w załatanych grach MD."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Określa włączaną łatkę IPS; jeśli nie ustawiono, używane są wszystkie łatki zdefiniowane w pliku ips .ini."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Określa filtr używany do upscalingu."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Określa ścieżkę do ramki (bezel)."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Określa ścieżkę do pliku firmware."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Określa emulowany model komputera."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "Określa metodę renderowania wideo. Dokładny jest najprecyzyjniejszy, ale wolniejszy; dobry i szybki są szybsze, ale mogą zawodzić w niektórych grach."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Zainstalowany moduł mowy."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Hack prędkości, może być niezgodny z niektórymi grami."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Hack prędkości, może pomóc wolnym grom kosztem błędów."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Hack prędkości."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Prędkość myszy sterowanej gałką analogową."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Prędkość emulowanej myszy Amigi."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Prędkość wskaźnika myszy poruszanego lewą gałką."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Przyspiesza wczytywanie GD-ROM, może psuć niektóre gry."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Przyspiesza wczytywanie dysku. Może psuć niektóre gry z zabezpieczeniem przed kopiowaniem."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Przyspiesza dostęp do dyskietek, skracając wczytywanie."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Rozdziela renderowanie na kilka wątków CPU. Przydatne tylko przy wysokich rozdzielczościach wewnętrznych."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Sprężynowo przywraca kierownicę do środka, gdy gra nie steruje force feedbackiem, jak mechaniczna sprężyna w automacie."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Standardowa karta kontrolera dyskietek."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Uruchamia bezpośrednio w trybie Commodore 64."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Uruchamia kontroler z już włączonymi gałkami, bez konieczności naciskania przycisku ANALOG w grze."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Uruchamia płytę bezpośrednio zamiast czekać w menu PLAY CD-I. Domyślnie włączone."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Uruchamia grę w trybie testowym. Test: klawisz 0 lub R3, serwis: klawisz 9 lub L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Uruchamia Outrun 2 SP SDX bez sprawdzania automatu (płyta napędowa i wieża)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Uruchamia menu Wii (menu musi być zainstalowane w Dolphin)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Strefa martwa osi kierowania, dla padów lub kierownic bez samocentrowania."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Przechowuje tekstury BC1 w 16 bitach. Oszczędza pamięć wideo niewielkim kosztem jakości."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Siła wibracji kontrolera. Domyślnie 60%."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Siła silnika odrzutu pistoletu. Domyślnie 60%."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Rozciąga menu i ekrany 2D na pełną szerokość ekranu."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Rozciąga piksele w pionie jak oryginalna gra DOS na ekranie 4:3. Domyślnie: włączone."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Rozciąga obraz na cały ekran, ignorując proporcje."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Rozciąga obraz na cały ekran zamiast zachowywać kształt monitora z epoki."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Studyjne: poziomy TV prawdziwego odtwarzacza, czerń wygląda na ciemnoszarą na ekranie PC. Pełny zakres: głęboka czerń."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Supersampling efektów bufora ramki, może wprowadzać artefakty."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Dźwięk przestrzenny odtwarza tylne głośniki czterogłośnikowych automatów Model 3 (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) na tylnych głośnikach. Pozostałe gry zostają w stereo."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Zamienia paddle 1 i paddle 2, wymagane przez kilka gier oczekujących osi w odwrotnej kolejności."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Zamienia przyciski A i B kontrolera."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Zamienia przyciski A/B i X/Y kontrolera."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Zamienia ekrany TV i GamePada w układach obok siebie, góra/dół i obraz w obrazie."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Zamienia dwa porty Amigi. Wymagane przez kilka gier, w tym kilka przygodówek typu wskaż i kliknij."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Zamienia indeksy pistoletów między graczem 1 a graczem 2."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Włącz, aby używać folderu RetroBat 'saves\switch' dla zapisów Citron i Eden (zamiast folderu emulatora)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Ustaw typ kontrolera gracza 1 na brak, jeśli właściwe wejścia klawiatury nie są odczytywane."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Włącz, aby aktywować menu serwisowe przyciskami R3 i L3."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Włącz, aby aktywować menu serwisowe."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Włącz, aby używać krzyżaka zamiast lewej gałki analogowej."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Włącz tę opcję, aby wyłączyć pełny ekran i uruchamiać emulator w oknie."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Włącz, aby używać pistoletu 1 dla gracza 2 i pistoletu 2 dla gracza 1."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Włączenie przy dedykowanym trybie usuwania przeplotu może pomóc ograniczyć rozmycie."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "System Card używana przez gry LD-ROM2, które jej wymagają. Domyślnie: SYSTEM CARD 1, jeśli syscard1.pce jest w folderze bios."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "Adapter złącza syntezatora mowy TI-99."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "TOS 1.06 jest tylko dla STE: jeśli typ maszyny nie jest ustawiony, STE jest wybierany automatycznie."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Cel 60 fps zamiast natywnych 59,73 fps."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 graczy w White Men Can't Jump i NBA Jam T.E. Obrotowy: Tempest 2000, sterowany myszą."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "Amiga wysyła swoje kanały skrajnie w lewo i skrajnie w prawo. Zmniejszenie miesza je i jest znacznie wygodniejsze na słuchawkach. 10 to zachowanie oryginalnego sprzętu."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "Amiga wysyła swoje kanały skrajnie w lewo i skrajnie w prawo. Zmniejszenie miesza je i jest znacznie wygodniejsze na słuchawkach. 100% to zachowanie oryginalnego sprzętu."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Tryb Neo Geo. UNIVERSE BIOS zazwyczaj zapewnia najlepszą kompatybilność."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "Zespół RetroBat przygotował profile dla popularnych kontrolerów, znajdują się w folderze 'saves\mame\ctrlr'. Profile WŁASNE służą do zapisywania własnych mapowań."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "Ilość pamięci wideo."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "BIOS używany przez emulator."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "Sterownik 'xinput' włącza funkcje takie jak wibracje. Wybierz 'sdl' dla kompatybilności z szeroką gamą kontrolerów."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "Region gry musi odpowiadać regionowi menu Wii, w przeciwnym razie gra nie zostanie rozpoznana."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Im wyższa wartość, tym dalej wyświetlane są obiekty."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "Prawa gałka analogowa gracza 1 steruje drugim joystickiem, w grach dwudrążkowych (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "Prawa gałka jest używana jako prawy krzyżak (także na L2, R2, L3 i R3)."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "W niektórych grach jest błąd: więcej niż 1 aktywne urządzenie powoduje awarię emulatora."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Grubość białej ramki rysowanej po podłączeniu pistoletu Sinden. Domyślnie normalna (12 pikseli)."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Pomaga w grach wyścigowych uczynić sterowanie kontrolerem mniej 'nerwowym'."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Ta opcja zmienia kartę dźwiękową Yamaha w emulowanym PC. OPN jest opcją domyślną. Dźwięk OPNA obsługuje więcej kanałów FM i próbki PCM."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Ta opcja steruje analizatorem SPU, zwłaszcza rozmiarem kompilowanych jednostek. Użyj trybu bezpiecznego dla maksymalnej kompatybilności."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "Ta opcja musi być wyłączona, aby grać w SIGIL."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Ta opcja dotyczy tylko kontrolera GameCube."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Ta opcja określa, czy emulować PCG-8100. Może być wymagana przez niektóre programy serii PC-8000."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Ta opcja ustawia taktowanie CPU emulowanego PC."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Ta opcja ustawia taktowanie CPU emulowanego PC. Opcje podkręcania sprawią, że większość programów będzie działać szybciej niż normalnie."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "To ustawienie działa tylko z filtrem 'scanlines'."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "To ustawienie zapobiega pauzie emulacji po utracie fokusu."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "To ustawienie obraca pulpit Windows i nie zostanie przywrócone po wyjściu z gry."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Uruchamia grę bez żadnych wybranych ulepszeń graficznych ani CPU."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "Uruchamia BIOS konsoli zamiast gry."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Próg, od którego ruch gałki analogowej liczy się jako kierunek cyfrowy."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Dynamicznie zmniejsza liczbę emulowanych cykli CPU, jeśli CPU hosta nie nadąża (domyślnie wyłączone)"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Wejście przechyłu dla Kirby Tilt 'n' Tumble i innych gier MBC7. Domyślnie gałka analogowa."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "Rozszerzenie RAM w gnieździe Trapdoor, jak w klasycznym rozszerzeniu A501."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Próbuje uruchomić instalator gry."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Próbuje wykrywać warunki pętli w jądrach SPU i używać ich jako wskazówek harmonogramu. Domyślnie wyłączone"

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "Próbuje wykryć grę i zastosować mapowanie kontrolera."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Próbuje wybrać najlepszą częstotliwość odświeżania dla ROM-u."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "TurboTap jest potrzebny do gry więcej niż jednego gracza. Włączany automatycznie po podłączeniu drugiego kontrolera."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Włącza powiadomienia emulatora: podłączone kontrolery i komunikaty kompilacji shaderów."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Prędkość obrotu myszą. Domyślnie: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Włącz, aby mapować kierunki tylko na krzyżak."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Włącz przy używaniu pistoletu, który nie obsługuje przeładowania poza ekranem."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "Włączenie tej opcji pozwala MAME niezależnie raportować ruch i kliknięcia różnych myszy."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Zamienia prawą gałkę w mysz Amigi, przydatne w grach sterowanych menu i typu wskaż i kliknij bez odkładania pada."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Domyślnie dwie warstwy (bit-exact). Posortowana naprawia nakładający się dym i szkło, szachownica odtwarza płytę automatu (śnieg i mgła w Sega Rally 2)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Emulowany typ APPLE II."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Emulowany typ komputera Archimedes."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Emulowany typ BBC Micro, domyślnie MODEL B."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Typ używanego rdzenia emulacji CPU."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Emulowany typ Color Computer, domyślnie coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Emulowany typ komputera."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Emulowany typ FM Towns, domyślnie FM TOWNS (MODEL 1/2)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Emulowany typ FM-7, domyślnie FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "Typ pomijania klatek."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Emulowany typ LYNX, domyślnie 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "Typ pliku ROM"

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Emulowany typ V.Smile."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "Typ joysticka podłączonego do portu gier."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Znosi limit klatek gry, jeśli w wewnętrznej bazie jest łatka."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Odblokowuje dodatkowe języki w niektórych grach, jeśli baza rdzenia ma dla nich wpis."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Zwiększa częstotliwość CPU z 93,75 do 125 MHz. Może przyspieszyć niektóre gry zależne od CPU."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Powiększa tekstury gry filtrem pixel-art."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Filtr upscalingu warstw 2D (HUD, tła)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Filtr upscalingu warstw 2D (HUD, tła). Tylko Vulkan i OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Użyj 'POŁUDNIE' dla przycisku A i 'ZACHÓD' dla przycisku B."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Używa folderu 'cfg64' dla MAME standalone."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Użyj celownika 'custom', aby włączyć wybrany plik celownika."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Użyj celownika 'custom', aby włączyć wybrany tutaj plik."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Użyj 'per game', jeśli zapisano profil gry w folderze capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Użyj 50 dla konsoli europejskiej i 60 dla konsoli japońskiej."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Użyj 8 MHz dla lepszej kompatybilności."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Używa gałki analogowej jako krzyżaka."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Użyj DSI dla gier DSi, np. DSiWare."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Użyj TYLKO JOYSTICK dla gier na joystick i TYLKO KLAWIATURA dla gier na klawiaturę."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Używa lewej gałki analogowej zamiast krzyżaka do sterowania."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Używa R1 i L1 do przyspieszania i hamowania w grach wyścigowych, działa tylko z automatyczną zmianą biegów."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Używa Resizable BAR do przesyłania na GPU, gdy jest dostępny. Wyłącz w razie przycięć lub niestabilności sterownika."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Używa SDL dla wszystkich kontrolerów zamiast XInput dla kontrolerów Xbox."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Używa taktowania i zachowania SGB2."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Używa SSE4 zamiast AVX2 na starszych CPU."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Używa filtra wysokiej rozdzielczości, aby poprawić renderowanie."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Używa predefiniowanej palety kolorów zamiast obliczanej przez emulator."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Używa alternatywnego przetwarzania głębi; włącz w razie problemów graficznych lub określonego komunikatu o błędzie."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Używa ampersandu i nawiasu otwierającego dla start i monet."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Używa zewnętrznego firmware (domyślnie 'firmware.bin' w folderze bios)."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Używa gałki analogowej zamiast krzyżaka."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Używa filtrowania dwuliniowego, aby wygładzić cały obraz."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Używa BIOS dla niektórych systemów, np. Neo Geo i Sega ST-V"

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Używa przycisku do przeładowania zamiast strzału poza ekran, dla pistoletów nieobsługujących strzału poza ekran."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Używa przycisków zamiast osi analogowej dla kierownicy."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Używa domyślnego urządzenia wejścia audio komputera jako mikrofonu."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Używa hata do ruchu oprócz joysticka."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Użyj interpretera dla najlepszej kompatybilności, dynarec dla wydajności."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Używa lewej gałki analogowej oprócz krzyżaka."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Używa lewej gałki analogowej zamiast krzyżaka."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "Używa lewej gałki jako krzyżaka."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Używa jednej wspólnej karty pamięci dla wszystkich gier zamiast jednej karty na grę. Karty są przechowywane w '\bios\pcsx2\memcards'."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Używa emulacji dokładnej co do piksela, gdy jest dostępna."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Używa portów 5-8 dla kontrolerów GameCube w trybie Wii."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Używa klatek wyprzedzających zamiast run-ahead; obowiązuje liczba klatek run-ahead."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Używa prawdziwych kontrolerów GameCube przez adapter GameCube. Tylko z prawdziwymi Wiimote."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Używa bumperów dla L i R zamiast spustów."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "Używa bumperów zamiast spustów."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Używa modeli 3D z pakietów HD zamiast sprite'ów (renderery OpenGL). Domyślnie włączone."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "Używa BIOS z folderu 'bios' RetroBata, wymagane do rozruchu w BIOS."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Używa BIOS z folderu 'bios' RetroBata."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Użyj wartości WYSOKA CZĘSTOTLIWOŚĆ dla ekranów o wyższej częstotliwości odświeżania."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Używa ramek z pakietu artwork Odin (folder artwork emulatora) zamiast dekoracji RetroBat."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Używa renderera compute shader zamiast klasycznego OpenGL. Szybszy przy wysokich rozdzielczościach wewnętrznych, wymaga OpenGL 4.3."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Używa wbudowanego BIOS emulatora zamiast plików z folderu bios. DS Download Play wymaga oryginalnego BIOS i firmware."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Używa tekstur wysokiej rozdzielczości z pakietów HD (renderery OpenGL). Domyślnie włączone."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Używa myszy jako paddle Apple II, wymagane w Arkanoid, Breakout i innych grach sterowanych pokrętłem. Pozycja wskaźnika nad ekranem to pozycja paddle. Zastępuje gałkę kontrolera dla paddle 1 i 2; zostaw wyłączone w grach na joystick."

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Używa ustawień dla gier zapisanych w interfejsie Vita3K. Nadpisują one ustawienia RetroBat dla tej gry."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Używa prostej mapy kolorów double hi-res. Niektóre programy Apple II wyglądają z nią bliżej prawdziwej maszyny."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Użyj, jeśli emulator zawiesza się po wczytaniu lub nic nie wyświetla."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Używaj tylko, jeśli gałka analogowa dryfuje."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Użyj tej opcji, jeśli ArcadeDuck nie wyświetla się na właściwym monitorze."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Użyj tej opcji, jeśli Keisho nie wyświetla się na właściwym monitorze."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Użyj tej opcji, jeśli Odin nie wyświetla się na właściwym monitorze."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Użyj tej opcji, jeśli PCSX2 nie wyświetla się na właściwym monitorze."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Użyj tej opcji, jeśli duckstation nie wyświetla się na właściwym monitorze."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Użyj tej opcji, jeśli G1 i G2 są zamienieni."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Użyj tej opcji przy padzie rozpoznawanym jako klawiatura (ipac itp.)."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Użyj tej opcji przy kierownicy bez ręcznej dźwigni zmiany biegów."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Użyj tego ustawienia w grach lotniczych."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Użyj tego ustawienia, aby zmniejszyć lub zwiększyć jasność, niezgodne ze sterownikiem wideo 'gdi'."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Użyj tego ustawienia, aby zmniejszyć lub zwiększyć kontrast, niezgodne ze sterownikiem wideo 'gdi'."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Użyj tego ustawienia, aby zmniejszyć lub zwiększyć gammę, niezgodne ze sterownikiem wideo 'gdi'."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Użyj tego ustawienia, aby określić domyślny przycisk docelowy turbo."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Użyj tego ustawienia, aby ignorować pliki run.bat, autoexec.bat lub dosbox.bat w folderze gry."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Użyj tego ustawienia, aby zmniejszyć opóźnienie wejścia."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Użyj, aby automatycznie wczytywać zawartość, np. pakiety HD."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Użyj winkey dla klawiatury, xinput przy kontrolerze XBOX, sdl dla innych typów kontrolerów."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Używa własnego pliku .cfg w saves\mame\cfg. Przemapowania zrobione w grze przez TAB są zachowywane. Przy pierwszej aktywacji mapowanie z ostatniej sesji jest importowane automatycznie. Opcja układu kontrolera przestaje dotyczyć tej gry."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Przydatne w grach z efektami wstrząsów ekranu, np. Wipeout Fusion; może rozmywać obraz."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Przydatne dla procesorów jednowątkowych."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Przydatne na niektórych ekranach o wysokiej częstotliwości odświeżania, aby wyeliminować smużenie."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Przydatne przy rozdzielczości wyższej niż ekran. Unika efektu mory."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Używa 60Hz (480i) zamiast 50Hz (576i)."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "Emulacja filtra post-processingu VI."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Wartości powyżej 1.00 zwiększają rozmiar, poniżej zmniejszają."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "Gry pionowe będą wyświetlane na monitorze odpowiadającym wybranemu indeksowi."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD to ulepszona karta graficzna używana przez garstkę nowoczesnych dem. Zmiana uruchamia maszynę ponownie."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Tryby wideo oferowane grom przez konsolę. Tryby HD wymagają sygnału wideo HDTV."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Konfiguracja widoku używana przez stół. AUTO podąża za KONFIGURACJA EKRANÓW: desktop dla jednego ekranu poziomego, pełny jeden ekran dla jednego ekranu pionowego, automat dla wielu ekranów (desktop, gdy KONFIGURACJA EKRANÓW nie jest ustawiona)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Wirtualnie obraca krzyżak, gdy ekran jest obrócony."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Głośność emulowanego klikania napędu dyskietek."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Głośność płyty muzycznej w grach, które ją mają (Daytona USA, Sega Rally). Domyślnie 100%."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Tylko Vulkan, wolniej, ale z mniejszym opóźnieniem."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Tylko Vulkan. Poprawia wydajność i naprawia wiele błędów graficznych, ale może być niestabilne na niektórych GPU. Nieobsługiwane metody automatycznie przechodzą na zapasowe."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Tylko Vulkan: każe sterownikowi wideo użyć określonego trybu buforowania."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Co jest podłączone do pierwszego portu Amigi. Większość gier używa joysticka w porcie 2 i myszy w porcie 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Co jest podłączone do drugiego portu Amigi."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Co jest podłączone do drugiego portu Amigi. Domyślnie joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Co otrzymuje drugi port po podłączeniu drugiego pada."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Po wpisaniu adresu tryb zostanie automatycznie ustawiony na 'RĘCZNIE'."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "Gdy automatyczne wykrywanie zawodzi."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Gdy dostępny, preferuj ekskluzywny pełny ekran w emulatorach."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "Po włączeniu każda gra ma własną VMU w porcie 1."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "Po wybraniu 'RĘCZNIE' podaj adres w następnym ustawieniu."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "Po wyłączeniu ograniczenia prędkości MAME emuluje tak szybko, jak to możliwe."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Przy pliku .m3u wybierz indeks uruchamianej płyty."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Przy używaniu joysticka kursorowego przyciski muszą być zmapowane na klawisze w RetroArch."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "Przy używaniu XInput ta opcja zamienia gamepady 1 i 2."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Przy używaniu pistoletu Sinden zamyka oprogramowanie Lightgun po zakończeniu gry."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Przy mapowaniu z pliku dla systemów arcade określa używany układ."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "Przy używaniu prawdziwych Wiimote określa typ Wiimote."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "Przy oprogramowaniu wymagającym pełnej obsługi klawiatury zaleca się także użycie trybu fokusu gry."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Gdzie wyświetlać DMD. AUTO: na polu gry przy 1 ekranie, na dole ekranu backglassa przy 2 ekranach, na osobnym ekranie przy 3 ekranach. Wymaga KONFIGURACJA EKRANÓW."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Który RetroPad steruje którym portem Amigi. Zostaw Automatycznie, chyba że gracze są zamienieni."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Który dysk gry wielodyskowej jest wkładany przy starcie. POM2 wczytuje jeden dysk naraz, pozostałe zmienia się z menu w grze."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Który dysk gry wielodyskowej jest wkładany przy starcie: zawsze pierwszy lub ten, który był w napędzie przy ostatnim wyjściu."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Który przycisk akcji zatwierdza w oknach systemowych PS3. Gry japońskie zwykle oczekują kółka, gry zachodnie krzyżyka. Zostaw AUTO, aby podążać za wybranym regionem."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Napęd dyskietek, na którym działa menu zmiany dysku."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Biała ramka rysowana przez emulator, wymagana przez pistolety Sinden do celowania."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Szerokość białej ramki rysowanej po podłączeniu pistoletu Sinden. Domyślnie 16 pikseli."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Szerokość białej ramki rysowanej po podłączeniu pistoletu Sinden. Domyślnie 2 piksele."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Uruchamia proces XBOX na wielu wątkach CPU, może poprawić wydajność, ale może psuć niektóre gry."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Obejście wymagane przez kilka homebrew i rom hacków."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Omija błędy firmware niektórych kierownic powodujące krótkie zaniki siły. Zostaw wyłączone, chyba że potrzebne."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Zapisuje Amiberry.log w folderze emulatora. Przydatne tylko przy zgłaszaniu problemu, nieco spowalnia działanie."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Zapisuje wartości bufora głębi do pamięci vm. Domyślnie wyłączone."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Zapisuje zdarzenia wejścia do pliku dziennika w folderze zapisów. Przydatne tylko przy zgłaszaniu problemu."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "Z80 SoftCard uruchamia oprogramowanie CP/M. Karty dźwiękowe można tu dodać jako drugą. Zmiana uruchamia maszynę ponownie."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "RAM rozszerzenia Zorro II. Wymagana przez wiele tytułów WHDLoad, ale kilka oryginalnych gier dyskietkowych odmawia z nią uruchomienia."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "RAM rozszerzenia Zorro II. Wymagana przez wiele tytułów WHDLoad."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Pamięć Zorro III, dostępna tylko dla maszyny z akceleratorem. Zostaw brak, chyba że konkretny tytuł jej wymaga."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Pamięć Zorro III. Przydatna przy konfiguracjach Workbench i kilku demach."

msgctxt "game_options"
msgid "use this to automatically start to a specified level."
msgstr "Użyj, aby automatycznie rozpocząć od wybranego poziomu."
