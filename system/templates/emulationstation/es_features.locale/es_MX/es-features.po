# FEATURES - DESCRIPTIONS (added 2026-11)
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' es la velocidad real de la unidad. 'Turbo' carga casi al instante, pero algunos juegos lo detectan y se niegan a arrancar."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' es la velocidad real de la unidad. 'Turbo' elimina la emulación de la rotación del disco y carga casi al instante, pero algunos juegos lo detectan y se niegan a arrancar."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "'Preciso' es fiel al hardware, pero puede hundir los FPS en las pantallas de guardado/carga. Cámbialo solo si un menú va lento."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "'Compatible' sirve para casi todos los juegos. 'Ciclo exacto' es el más preciso, pero necesita un PC potente. 'Rápido' desbloquea la velocidad de la CPU y puede romper los juegos sensibles a la temporización."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "'Doble' ofrece una imagen limpia y moderna. Los modos de scanlines recrean el aspecto de un monitor CRT."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "'Exacto' es la emulación más fiel del chip Paula. Bájalo solo si el sonido se entrecorta en un PC lento."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "'Joystick' es el clásico control de 2 botones que entienden todos los juegos. 'Control CD32' añade los botones de colores y se selecciona automáticamente en CD32."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "'Seguro' corrige fallos de texturas en algunos juegos, con un coste de rendimiento elevado."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "'Triple búfer' y 'Ajustar al contenido emulado' solo están disponibles con el driver de video Vulkan."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "'directx11' es el valor por defecto y funciona en casi todo el hardware. 'vulkan' puede ser más rápido en GPU recientes. Algunos núcleos libretro fuerzan su propio driver."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8 MB de Fast RAM (CD32FR). Desactivado por defecto, como la CD32 original."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "Se recomienda 130-140% con controles modernos."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 bits elimina las bandas de color en las zonas oscuras y los degradados. HDR requiere una pantalla HDR con el HDR activado en RetroArch; si no, el núcleo vuelve a 24 bits."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x corresponde a la unidad real. Las velocidades superiores reducen los tiempos de carga, pero pueden romper juegos."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "4/3 por defecto, como el monitor arcade. El bezel solo se muestra en 4/3. 16/9 amplía la vista 3D."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Algunos juegos necesitan esta opción desactivada."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Algunos juegos lo necesitan. Cuesta alrededor de un 10% de rendimiento."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Algunos juegos muy antiguos necesitan el chip CTIA para mostrarse correctamente."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII asigna el teclado a los caracteres que imprime. Original reproduce el teclado exacto de la máquina emulada, necesario para algunos programas."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "AUTO (recomendado) deja que el núcleo elija el archivo NAND según la región del juego."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO muestra el punto de mira al apuntar con un mouse y lo oculta con una pistola real."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO cambia a DSi solo para los juegos exclusivos de DSi. Fuerza DSI para DSiWare."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "AUTOMÁTICO elige la ampliación según el tamaño del programa. Se puede forzar con etiquetas en el nombre del archivo como (8k) o [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMÁTICO: Vita3K carga por sí mismo los módulos de firmware necesarios (recomendado). AJUSTES DEL EMULADOR: conserva los módulos seleccionados en la interfaz de Vita3K."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Por encima de 60 FPS, los fotogramas se interpolan entre las actualizaciones del juego. AUTO sigue la frecuencia de refresco de la pantalla."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Emulación precisa del framebuffer, muy lenta pero necesaria para algunos juegos."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Actuar como jugador 1 y alojar la partida."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Acción del segundo botón del control: barra espaciadora (p. ej. Xenon 2) o joystick arriba (salto en los juegos de plataformas)."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Adapta la vista del juego a las pantallas panorámicas."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Añade un disco de guardado/usuario 2HD vacío a la lista de control de discos."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Añade sombras de contacto; requiere el renderizador por hardware."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Ajusta el centro vertical del puntero de la Wiimote."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Ajusta el volumen de la pista de música."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Ajusta el volumen de los efectos de sonido."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Biblioteca de audio avanzada usada por muchos juegos. Desactívala solo si un juego se cuelga o tiene problemas de sonido."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Apuntar los objetos con el giroscopio del control (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Permite a ADAM escribir en los discos y data packs. La escritura se hace en una copia de trabajo guardada en la carpeta saves; el archivo original nunca se modifica. Requiere reiniciar el núcleo."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Permite los controles DirectInput (controles USB genéricos, sticks arcade). Desactívalo solo si un control se detecta dos veces."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Permite los controles XInput (controles Xbox y adaptadores). Desactívalo solo si un control se detecta dos veces."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Permite el soporte HID nativo de los controles DualShock 4, DualSense y Switch Pro. Desactívalo para volver a DirectInput."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Permite presionar izquierda y derecha, o arriba y abajo, a la vez. Puede causar fallos de movimiento en algunos juegos."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Permite presionar direcciones opuestas a la vez."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Permite acercar y alejar el mapa con la rueda del mouse, como en las Enhanced Editions."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Permite hacer una asignación dedicada para tu stick arcade a partir del archivo 'arcade_sticks.json'."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Inserta también el disquete siguiente en la unidad 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Descomprimir siempre los archivos comprimidos, aunque se pudiera usar dokan para montarlos como letra de unidad."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Mostrar siempre los nombres de los objetos del suelo."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Modelo de Amiga a emular. Cada uno necesita su propia ROM Kickstart en la carpeta bios."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Modelo de Amiga a emular. Requiere reiniciar el núcleo para aplicarse. Cada modelo necesita la ROM Kickstart correspondiente en la carpeta bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Puerto del Amiga en el que está conectada la pistola. El puerto 2 es el correcto en casi todas las máquinas; solo el A1000 lee el lápiz en el puerto 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Cantidad de Chip RAM. Algunos juegos tardíos necesitan 1 MB. Superar lo que admite el modelo puede romper la compatibilidad."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Cantidad de pequeños movimientos del puntero que se ignoran."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Vibración añadida que aumenta al girar."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Nivel de antialiasing."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Método y nivel de antialiasing."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Modelo de Apple II a emular. Cambiarlo reinicia la máquina."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Modelo de Apple II a emular. Los modelos PAL funcionan a 50 Hz y son para los que se escribieron las demos europeas. Cambiarlo reinicia la máquina."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Se aplica a la imagen del punto de mira; útil para distinguir a los jugadores."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Aplica una curva de potencia a los valores de la dirección y amortigua los movimientos pequeños."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Se aplica a los ejes del joystick de vuelo y del acelerador en After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Se aplica a los pedales de acelerador y freno en los juegos de carreras."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Aplica un filtro CRT (crt-aperture)."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Aplica la región anterior aunque el juego declare la suya."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Imita la etapa de salida analógica de la consola: elimina el offset DC y suaviza las frecuencias altas."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Aspecto de monitor arcade."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Aspecto de monitor arcade: scanlines, máscara de sombra y resplandor."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Relación de aspecto proporcionada por el núcleo, usada cuando RELACIÓN DE ASPECTO DEL JUEGO está en AUTO."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Relación de aspecto definida en los ajustes del sistema de la consola."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Teclado Atari: F2, F4 y F8 quedan para el juego; los guardados rápidos y las capturas usan entonces AltGr+K, AltGr+L y AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Intenta hacer el reescalado a la resolución nativa."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Umbral del búfer de audio para el salto de fotogramas manual."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Audio ofrece la latencia más baja. Video es más fluido cuando la frecuencia de la pantalla está cerca de la de la consola."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Frecuencia de salida del audio."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (por defecto) sigue la frecuencia de la pantalla con interpolación de movimiento. Original y los múltiplos de 57,524 Hz necesitan una pantalla G-SYNC / FreeSync y la sincronización vertical."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Centra automáticamente el eje de puntería. Útil al jugar a juegos de pistola con un control en lugar de una pistola."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Cadencia del disparo automático. Más rápido no siempre es mejor: algunos juegos ignoran las presiones demasiado rápidas."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: oeste ataque, sur salto, este especial, norte ataque 2, L1/R1 ataque 3/4. OpenBOR standalone: los mismos botones que el emulador OpenBOR standalone."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automático usa XInput cuando todos los controles son XInput; si no, DirectInput."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automático: arranca desde el disco duro cuando el juego tiene disco duro y ningún disquete."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automático: solo se muestra cuando el juego no tiene mira propia."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Aplica automáticamente las mejoras del juego si existen en la base de datos del núcleo (LOD, distancia de dibujado, omitir FMV)."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Carga automáticamente los parches sin entrelazado al iniciar el juego."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Carga automáticamente los parches de pantalla panorámica al iniciar el juego."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Elimina automáticamente los bordes negros alrededor de la imagen del Amiga para que la imagen ocupe más pantalla."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Rota automáticamente la imagen en los juegos verticales."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Intercambia automáticamente Port0 y Port1 según la actividad de los controles."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Cambia automáticamente la cara del disco cuando el juego lo pide."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Los bezels solo se muestran en 4/3."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Nivel de negro de la imagen. 50% por defecto, ajustado a una captura arcade: menos es más oscuro, más es más claro."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "Mezclada dibuja los polígonos transparentes como una mezcla suave en lugar del damero arcade. Solo Model 1 y Model 2, renderizadores Vulkan y OpenGL."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Acelera la emulación durante el arranque."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Arranca en la pantalla de introducción de códigos de Game Genie. Requiere 'gamegenie.nes' en la carpeta bios. Requiere reiniciar."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Arranca en el menú de la BIOS de la consola."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Arranca con la BIOS real de Jaguar y su animación de inicio. Necesario para algunos juegos."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Detiene en el depurador del anfitrión (o se cuelga si no hay depurador) cuando se encuentra una instrucción PowerPC no implementada."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Difunde la información de las entradas por el puerto TCP 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Compila los shaders en caché antes de que empiece el juego."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Combinación de botones para alternar entre TV y GamePad; solo la usa la disposición de pantallas ALTERNABLE."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Disposición de botones del núcleo, la misma para todos los juegos. Déjalo en AUTO para usar la asignación por juego de RetroBat y la DISTRIBUCIÓN DE BOTONES."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Botón usado para confirmar en los diálogos del sistema y en los juegos que siguen el ajuste del sistema. CÍRCULO es la convención japonesa."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Por defecto se inicia Hellfire cuando el nombre del juego contiene hellfire; si no, Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Por defecto RetroBat configura tantos jugadores como controles conectados; usa esta opción para cambiarlo."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Por defecto RetroBat genera su propio archivo de configuración; activa esta opción para usar tu propio archivo de ajustes del juego situado en la carpeta 'emulators\ssf\Setting'."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Por defecto se usa un segundo control cuando hay un segundo control conectado."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Por defecto todos los controles mueven al héroe. Actívalo si otro control conectado interfiere con el movimiento."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Por defecto, RPCS3 requiere la GunCon en el puerto del jugador 3; usa esta opción para forzarla en el puerto 1."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Por defecto, RetroBat descarta los archivos de opciones específicos de los núcleos."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Por defecto, RetroBat mantiene sincronizados los juegos instalados y la carpeta roms."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Por defecto, las modificaciones se guardan en la unidad de disco; 'descartar' no guarda ninguna modificación."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Por defecto, el botón gatillo se usa para agitar; actívalo para simular un balanceo en su lugar."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Omite el mipmapping y usa siempre el nivel de textura más nítido. Mejor calidad de imagen; algunos juegos tienen fallos de renderizado con esta opción."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "Configuración CD32. Necesita tanto la Kickstart CD32 como su ROM extendida en la carpeta bios."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "CLÁSICO es el renderizador por software original. POLYMOST y POLYMER usan OpenGL y admiten los packs HD."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "Reloj de la CPU. Auto usa el reloj del modelo o la base de datos de juegos. Algunos juegos (SSF2, Alltynex) se benefician de una CPU más rápida."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Velocidad de la cámara con el stick analógico derecho o el mouse."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Puede afectar al rendimiento de forma inesperada."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Puede ser útil para Gran Turismo; los gatillos se asignarán a otros botones."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Puede ser útil para Gran Turismo; los gatillos se asignarán al stick analógico derecho."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Puede ser útil para Metal Gear, para simular la sensibilidad a la presión."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Puede beneficiar a algunos juegos."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Puede corregir imágenes 2D desalineadas, como la selección de personaje de Mario Kart."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Puede mejorar la precisión con un pequeño coste de rendimiento."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Puede aumentar el rendimiento con una GPU potente."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Puede reducir los tirones al compilar shaders, pero también puede crear artefactos."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Puede reducir la latencia o eliminar la línea inferior en Wii, a costa de fallos gráficos."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Limita los FPS a los 35 FPS originales."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Cambia los controles de la cruceta entre joystick y mouse."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Cambia la ruta de los juegos descomprimidos (por defecto '\roms\.uncompressed')."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Cambia el renderizador usado por el núcleo. Los juegos de pistola solo funcionan con SOFTWARE."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Cambia cómo se reparten los hilos del emulador entre los núcleos de la CPU. Los planificadores de RPCS3 pueden ayudar en CPU con varios clústeres CCX/CCD o con SMT, pero Sistema operativo es lo más seguro en la mayoría de equipos."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Cambia cómo se muestran las pistolas en Rambo."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Cambia el chip de sonido, la pantalla de arranque TMSS y algunas particularidades del hardware."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Chip generador de caracteres. Automático elige el que corresponde a la máquina seleccionada."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "Los trucos deben colocarse en la carpeta \bios\pcsx2\cheats."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Comprueba cada ROM con la base de datos de juegos. Desactívalo solo para probar un romset que no carga: unas ROM incorrectas pueden colgar el juego o corromper las partidas. Activado por defecto."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Chipset usado cuando se selecciona un modelo AGA. Bájalo por debajo de AGA solo para probar un juego que falla en un A1200."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Elige 'Trojan Phazer' para los juegos escritos para esa pistola. 'Lápiz óptico' sirve para todo lo demás, incluidos los programas de dibujo."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Elige el botón que activa el IR en el stick derecho."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Elige el botón que simula el balanceo con el stick derecho."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Elige si el atajo de intercambio de pantallas las cambia de forma permanente o solo mientras se mantiene presionado el botón."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Elige la segunda disposición de las pantallas emuladas."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Elige en qué unidad actúa el menú de control de discos. Las demás unidades siguen montadas. Soporte cargado usa la unidad en la que se cargó el juego."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Paleta de colores para los juegos de Game Boy original."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Temperatura de color del monitor arcade."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Colores de los juegos de WonderSwan (mono). Las paletas WS imitan las pantallas originales."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Configura cómo se solicitan los controles al anfitrión o al cliente. Imprescindible para la conexión multijugador local."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Variante de consola que corresponde a la imagen de BIOS seleccionada."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Controla cómo se aplica el dithering."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Controla el nivel de detalle de los mensajes antes de mostrar el programa."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Convierte subir/bajar marcha en marcha 3/marcha 4 para simular un cambio secuencial con una palanca de cambios estándar."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Copia el búfer de color a la memoria de la N64. Necesario para algunos efectos (p. ej. pantallas de pausa, fotos de cámara). DESACTIVADO es lo más rápido, pero puede romperlos. AUTO sigue el modo de rendimiento."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Corrige la relación de aspecto de los píxeles no cuadrados."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Frecuencia de corte del filtro de la salida de audio de la consola. 3390 Hz corresponde a la mayoría de modelos de Mega Drive."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "Tamaño de la placa DIMM. Auto sigue el juego; déjalo en Auto salvo que un juego se queje."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Amortigua el balanceo de la cámara de persecución en los juegos de carreras. Fuerte por defecto."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Oscurece una línea de cada dos para imitar un tubo de rayos catódicos."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "DeSmuME tiene una BIOS interna; selecciona esta opción para usar la BIOS y el firmware de la carpeta bios de RetroBat."

msgctxt "game_options"
msgid "Default ON."
msgstr "Activado por defecto."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Activado por defecto; puede dar problemas en algunos juegos."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Por defecto sigue el idioma de EmulationStation."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "Por defecto 30 segundos; define el tiempo de espera para que se inicie el juego antes de volver a la lista de juegos de RetroBat."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Activado por defecto (rápido). DESACTIVADO ejecuta los programas reales del DSP de geometría, más preciso pero más lento (solo juegos Model 1 y Model 2 2B)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Activado por defecto: renderizado correcto de los quads. DESACTIVADO renderiza los quads como triángulos (más rápido)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Activado por defecto; desactivarlo puede mejorar la compatibilidad con GPU antiguas (solo Model 3)."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Activado por defecto; desactívalo para mostrar la animación de arranque."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Por defecto 10 bits para DS y 16 bits para DSi."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Por defecto Pro Controller."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Por defecto: cursor oculto."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Por defecto: activado."

msgctxt "game_options"
msgid "Default: low."
msgstr "Por defecto: bajo."

msgctxt "game_options"
msgid "Default: true"
msgstr "Por defecto: activado"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Por defecto 60 cuando se pone a 0 y la VSYNC está activada."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Define la BIOS que se usa para la emulación."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Define el botón que muestra la pantalla del GamePad; por defecto si no se elige ninguno."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Define cómo configurar la pistola Sinden."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Define cómo asignar los botones A y B de la GunCon (Start y Back de la Justifier). Por defecto: cruceta derecha/izquierda con una Wiimote en DolphinBar, botones del mouse con las demás pistolas."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Define cómo está conectada la Wiimote a la DolphinBar."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Define si se aplica el parche y dónde están los archivos de parche; 'AUTO' aplica los parches si están junto a la ROM con el mismo nombre que el archivo de la ROM."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Define la asignación de los botones del mouse (izquierdo/derecho/central); por defecto a/recarga/start."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Define el modelo; por defecto BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Define el modelo; por defecto CPC 6128+ para GX4000."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Define el índice del mouse que usa el jugador 3."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Define el índice del mouse que usa el jugador 4."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Define la ruta del archivo controls.ini personalizado."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Define el dispositivo conectado que emula un pedal."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Define la asignación de la cruceta."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Define el número de píxeles que se recortan."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Define el sonido que recibirá el micrófono emulado."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Define el tipo de control emulado."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Define dónde están los botones de crédito y start."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Define si los atajos de 'avance rápido' funcionan como interruptor o hay que mantenerlos presionados."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Define si los atajos de 'cámara lenta' funcionan como interruptor o hay que mantenerlos presionados."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Grados de giro del volante que alcanzan el tope en el juego. 270 corresponde a la máquina arcade."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Dispositivo conectado al puerto de juegos del Apple II. El stick analógico da un movimiento progresivo del paddle; la cruceta solo va del todo a la izquierda o a la derecha."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Tipo de dispositivo del jugador 2."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Solo DirectInput: úsalo si los controles no controlan a los jugadores correctos."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Desactiva los ajustes por juego de Xenia Edge para que se apliquen los ajustes de RetroBat."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Desactiva las protecciones del núcleo para que puedan arrancar algunos juegos homebrew."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Desactiva el renderizador por hardware; puede mejorar la compatibilidad."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Desactiva los atajos de teclado y da acceso completo al teclado al núcleo. Se alterna con la tecla 'Bloq Despl'."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Desactiva el chip FM de la Master System."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Desactiva el menú de Visual Pinball: la tecla de salida (X) cierra la mesa directamente."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Desactiva el lanzador analógico (stick derecho) y el empujón analógico (stick izquierdo)."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Desactiva la comprobación de la cámara de la máquina."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Desactiva el menú del juego que se abre con HOTKEY + ESTE o F12."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Desactiva esta opción para centrar el puntero IR al soltar el stick."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Desactiva esta opción para mejorar el rendimiento."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Desactiva esta opción para ejecutar directamente un archivo .bat o .cmd sin que RetroBat intente buscar el ejecutable dentro."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Desactívalo para asignar R2 y L2 a los botones L y R (no digitales)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Desactiva el uso del eje X para empujar, del eje Y para el tilt y del eje Z para el lanzador."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Desactiva los ajustes automáticos por juego de la base de datos del núcleo y activa las correcciones manuales de abajo. No recomendado."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Desactiva la interpolación de movimiento: un fotograma menos de latencia."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Muestra un mensaje al desbloquear un logro. Activado por defecto."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Muestra una barra de experiencia encima del cinturón."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Aspecto de la imagen del LaserActive, 4:3 por defecto."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Muestra los valores actuales de vida y maná en los orbes."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Muestra el daño y la experiencia como números flotantes."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Muestra el tiempo del nivel, los secretos encontrados y los enemigos eliminados."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Visualización de la segunda pantalla (pantalla táctil) de Primeval Hunt."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Muestra las zonas del borde de la pantalla. No tiene efecto en la salida F18A."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Muestra el juego en 16:9. Mejor con RELACIÓN DE ASPECTO DEL JUEGO en 16/9."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Muestra la pantalla de la VMU del jugador 1 sobre el juego."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Pantalla usada al arrancar. Se puede cambiar en el juego con la tecla F7 (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Muestra objetos vóxel en lugar de sprites planos cuando están disponibles. Activado por defecto."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Aplica dithering a los efectos de framebuffer supermuestreados."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Dithering aplicado a las imágenes del framebuffer en RDRAM."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Divide la resolución interna: con una resolución interna alta, los valores más altos hacen el juego más grande. Por defecto: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 es un juego muy oscuro; súbelo para aclarar la imagen."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Reduce la imagen escalada (SSAA). Requiere el escalado."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Dibuja el decorado hasta el final del circuito en los juegos compatibles (Daytona USA). Solo Model 1 y Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Unidad usada para el cambio de discos."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick: Robotron 2084 y Space Dungeon en el stick derecho. Intercambiar puertos: Wizard of Wor, Apple Panic. Joy 2B+: joysticks de varios botones."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Duplicar fotogramas requiere el renderizador Vulkan."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Recompilación dinámica. La mayoría de juegos van más rápido; algunos, más lentos."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Emula los pulsadores de Buzz! con tus controles. Un control cubre 4 pulsadores (jugadores 1-4); dos controles cubren 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Emula el tiling de memoria de la PS3. Corrige fallos gráficos en algunos juegos con un pequeño coste de rendimiento."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Emula el Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Emula un plato de DJ Hero con tus controles. Necesario para DJ Hero 1 y 2."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Emula un control Guitar Hero Live (GHLtar) con tus controles. Necesario para Guitar Hero Live."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Emula una New 3DS o una 3DS original."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Emula una PlayStation TV para el multijugador local (hasta 4 controles). No se admiten controles idénticos; puede que los juegos táctiles no funcionen."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Emula un control spinner, controlado por el movimiento del mouse. Los botones del mouse se asignan a los botones izquierdo (amarillo) y derecho (rojo)."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Emula la frecuencia de vblank NTSC de 59,94 Hz en lugar de 60 Hz. Corrige la temporización y el desfase del audio en algunos juegos NTSC."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Emula el accesorio base de Disney Infinity."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Emula el Game Boy Player para activar la vibración en los juegos compatibles."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Emula el accesorio toypad de LEGO Dimensions."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Emula el accesorio portal de Skylanders."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Emula la Video CD Card; requiere mpeg_card.bin en la carpeta bios."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emula el comportamiento de los motores antiguos; necesario para algunos mods y demos antiguos."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Porción de tiempo de los hilos emulados. Subirla puede ayudar a algunos juegos; bajarla puede suavizar otros."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Scanlines del emulador, solo visibles en algunos juegos."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Activa el mod de 32 MB de RAM para Dreamcast; puede afectar a la compatibilidad."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Activa la emulación CMS."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Activa el procesador de sonido digital (DSP). Mejora la precisión del sonido a cambio de mayores requisitos de rendimiento."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Activa el procesador de sonido digital (DSP). Mejora la precisión del sonido a costa del rendimiento."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Activa el enfoque adaptativo por contraste FidelityFX (CAS)."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Activa la emulación de la Gravis Ultrasound."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Activa la emulación del audio IBM PS/1 (desactivada por defecto)."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Activa la emulación del sonido Tandy."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Activa la RAM de desarrollo adicional; puede romper juegos."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Activa los efectos de vibración del control. Solo funciona en los juegos de carreras."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Activa los puntos de mira en los juegos de disparos; las opciones (DS) solo son compatibles con DemulShooter."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Activa una resolución personalizada según el modo de video."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Activa las funciones avanzadas para DS4 y DualSense; esto rompe la compatibilidad con los emuladores que usan dinput hasta que se desactive."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Actívalo si el volante se aleja del centro en lugar de volver hacia él."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Activa la función de zoom inteligente."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Activa los parches IPS."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Activa el escaneo progresivo en los juegos compatibles."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Activa la IBM Music Feature Card (desactivada por defecto)."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Activa los efectos de los trucos activados en la interfaz de Vita3K."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Usa el mouse para la pantalla táctil en lugar del stick derecho."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Actívalo si los índices de los controles XInput están intercambiados."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Actívalo si tienes un monitor G-SYNC/FreeSync; puede causar fallos de audio."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Actívalo para permitir los shaders aunque RetroBat no tenga ningún shader seleccionado."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Actívalo para conectar el joystick del jugador 1 en el puerto izquierdo en lugar del derecho."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Actívalo para usar tus propios ajustes por juego de Project64."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Activado por defecto (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Activado por defecto; mejora la transferencia de datos del puerto SIO emulado."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Activado por defecto."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Activado por defecto. Desactiva el dithering y fuerza una salida de color de 24 bits."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Activado por defecto. Desactivarlo puede mejorar el rendimiento, pero rompe algunos juegos."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Activado por defecto. Shaders más rápidos; puede causar fallos gráficos poco frecuentes."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Activado por defecto. Corrige fallos gráficos en algunos juegos con un pequeño coste de rendimiento."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Activado por defecto. Elimina el desenfoque en algunos juegos, pero reduce la precisión."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Activado por defecto. Sustituye los sprites del juego por un pack HD cuando hay uno disponible. Requiere reiniciar."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Activado por defecto. Muestra los mensajes procedentes del propio emulador."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Activado por defecto. Desactivado, los FPS se limitan a 60."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Activado por defecto. Desactivado, los FPS los limita el juego."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Hace que las flechas y las teclas CTRL y ALT actúen como joystick y botones de disparo."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Activa la función de parcheado personalizado."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Permite cambiar entre distintas señales de video."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Activarlo puede causar problemas con los controles 8BitDo."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Mejora la precisión gráfica a cambio de mayores requisitos de rendimiento."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Mejora la calidad de las texturas en las superficies. Solo OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Mejora la calidad de las texturas en las superficies. Solo Vulkan y OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Filtro de mejora aplicado a las texturas."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Introduce el puerto UDP local que se usará para alojar la partida."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Introduce la dirección del servidor."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Introduce el perfil táctil que se cargará."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Reverberación ambiental (EFX), activada por defecto."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Exacta es la más cercana a la consola y la más exigente para la GPU. Rápida es mucho más ligera. Auto elige rápida en las GPU poco potentes o inestables."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Amplía la tarjeta de memoria SAMS a 4M."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Cartucho de expansión insertado en la consola. Los juegos con un requisito conocido lo sustituyen automáticamente."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Prueba esta opción si tu joystick se desvía solo (activada por defecto)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Experimental, solo Windows. Protege los datos de la pila del juego cuando el emulador gestiona las excepciones de memoria. Puede corregir cuelgues en algunos juegos. Déjalo desactivado salvo que un juego lo necesite."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Control adicional. Déjalo vacío salvo que el juego pida uno."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Tarjeta de memoria adicional, solo modelos //e. Algunos programas necesitan más de los 64 KB de serie."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "Sensibilidad del mouse de FM Towns."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Antialiasing aproximado rápido (FXAA), menos exigente que el MSAA pero más borroso."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Rápido puede mejorar el rendimiento, pero puede ser inestable con algunos drivers."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "ROM de carga rápida de disco. Necesita EMULACIÓN FIEL DE LA UNIDAD y las ROM de JiffyDOS en 'bios\vice'. No se usa con cintas ni cartuchos."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Rápido es menos preciso; ordenado y atómico es preciso pero más lento."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Motor de emulación del DSP más rápido (experimental). Solo se usa con la EMULACIÓN DSP activada."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Lectura de sectores más rápida. Puede que algunos programas no la esperen."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Filtro aplicado a la imagen final."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Filtro usado para escalar la imagen a la pantalla."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Filtro usado al escalar la imagen final."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Filtro usado cuando la imagen renderizada es más grande que la pantalla."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Filtro usado cuando la imagen renderizada es más pequeña que la pantalla."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Filtrado aplicado a las texturas 3D."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Filtrado aplicado a las texturas 3D. Solo OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Filtrado aplicado a los sprites y elementos 2D."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Dispara de forma continua mientras se mantenga presionado el botón."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Acciona el motor de retroceso de la pistola en cada disparo, para las pistolas que lo tienen. Activado por defecto."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Ajusta los juegos en alta resolución o panorámicos dentro de un cuadro de 640x480 con bordes negros. Solo útil en un televisor CRT 4:3."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Inserta el Digital Video Cartridge (vmpega.rom en la carpeta bios), necesario para los juegos FMV y los Video CD."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Corrige un fallo de Demul (sale de la pantalla completa al disparar en la esquina superior izquierda) bloqueando todas las entradas del mouse en la interfaz de Demul."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Corrige las ralentizaciones con este emulador."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Corrige la corrupción de texturas y los problemas de profundidad en las GPU AMD y algunas Intel."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Corrige las bandas que pueden aparecer en las texturas escaladas."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Corrige el bloqueo del juego en un bucle al arrancar."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Corrige la geometría coplanar y las calcomanías en algunos juegos; puede romper otros."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Corrige los huecos entre elementos 2D."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Corrige artefactos de sombras y de profundidad en algunos juegos."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Corrige algunos fallos gráficos relacionados con las líneas."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Corrige fallos de texto en algunos juegos."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Unidad de coma flotante, necesaria para algunos juegos 3D. Activada por defecto con el 68040 (integrada), desactivada con el 68030."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Carpeta de los datos de Vita3K (firmware, juegos instalados, partidas). Se ignora cuando Vita3K está en modo portable (carpeta 'portable' no vacía junto a Vita3K.exe)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "ROM de fuentes necesaria para algunos juegos japoneses."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "En los sistemas Nintendo, invierte A y B para que coincidan con los nombres de los botones de Xbox."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "En los juegos SegaScope 3-D, muestra un solo ojo en lugar del par parpadeante."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "Para los controles de N64 con 2 gatillos, usa R2 en lugar de L2 como botón Z."

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "En algunos emuladores, sirve para corregir la asociación teclado/mouse de las Wiimotes al usar 2 Wiimotes."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Fuerza el índice del control J1; útil si los dispositivos XInput no están bien ordenados."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Fuerza Raw Input; no debería ser necesario activarlo."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Fuerza un número de ciclos de CPU por operación. AUTO usa el valor por defecto de cada juego; cámbialo solo si un juego falla."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Fuerza botones en lugar de ejes para los gatillos; puede ayudar con los controles de Sony."

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Fuerza el limitador de fotogramas."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Fuerza cómo se muestrean las texturas. Vecino más cercano mantiene los píxeles nítidos; lineal los suaviza."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Fuerza el driver de entrada. Por defecto 'sdl'; 'dinput' si están activadas las multipistolas."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Fuerza la resolución de la pantalla actual en los juegos que admiten una resolución personalizada."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Fuerza la frecuencia de refresco VI. AUTO es correcto para casi todos los juegos."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Fuerza la disposición real de los canales de salida. CANALES DE AUDIO declara lo que ve el juego; esta opción decide cómo se mezcla para tu dispositivo. Déjalo en AUTO salvo que tu dispositivo de salida se detecte mal."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Fuerza el backglass activado o desactivado. AUTO sigue CONFIGURACIÓN DE LAS PANTALLAS (activado si CONFIGURACIÓN DE LAS PANTALLAS no está definida)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Fuerza el modo de filtrado bilineal usado al escalar los rectángulos sucios."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Fuerza el dispositivo de arranque (solo modelos 1F/2F y posteriores)."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Fuerza la región de la consola. Por defecto la región se detecta a partir del juego."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Fuerza la frecuencia de refresco emulada en lugar de detectarla a partir del juego cargado. Requiere reiniciar el núcleo."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Fuerza la frecuencia de la CPU emulada. Puede reducir las ralentizaciones, pero puede causar fallos. Por defecto 57%."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Fuerza el teclado que se usará si hay varios teclados conectados."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Fuerza el controlador de bancos de memoria (mapper). Cámbialo solo si un juego no funciona correctamente. Requiere reiniciar el núcleo."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Fuerza los modos de visualización monocromos, como en un monitor verde o ámbar de la época."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Fuerza el número de Wiimotes que detectará el juego. Ponlo a 1 en los juegos que pasan al multijugador en cuanto hay varios controles conectados."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Fuerza el uso de la emulación de alto nivel de la BIOS (HLE)."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Fuerza el cartucho de voz en la ranura 1; necesita el archivo de bios 'voice.zip'."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Fuerza el nivel de compatibilidad del motor. Elige MBF21 para los WAD que lo requieren."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Resolución a pantalla completa. Por defecto se usa la resolución del escritorio."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Control total de la cámara con el stick derecho."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "Los guardados rápidos GST se pueden abrir con Kega y Gens, pero guardan menos estado de la máquina."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Ganancia de las fuerzas de la drive board. 30% por defecto; 200% las duplica."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Resolución del juego. Los valores más altos muestran más área de juego."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Recorrido de la dirección con control en los juegos de carreras. 66% por defecto; sin efecto con un volante."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Control: el control y el teclado mueven el puntero del CD-i. Mouse: el mouse del PC mueve el puntero (juegos de apuntar y hacer clic y de pistola); el control solo conserva sus botones. Hotkey + L3 cambia durante el juego."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Los controles pasan a ser jugador 1, 2... y los sticks arcade se asignan a los jugadores siguientes."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "El alemán y el francés necesitan una versión PAL del juego; el japonés, una versión NTSC."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Da todo el teclado al juego (Bloq Despl lo devuelve a los atajos) y captura el mouse. El control sigue funcionando."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Chipset gráfico de los modelos no AGA. Automático sigue el modelo seleccionado, que es casi siempre lo que se quiere."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Plugin gráfico usado para renderizar el juego."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Preajuste de calidad gráfica (texturas, filtrado). AUTO lo elige según la cantidad de memoria."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Aumenta mucho la calidad de las texturas generadas mediante efectos de render-to-texture. Activado por defecto. Desactivarlo puede evitar cuelgues en los juegos con texturas personalizadas."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Juegos de pistola jugados con un control (sin pistola). Relativo: el stick mueve el cursor. Absoluto: la posición del stick es la posición en la pantalla; vuelve al centro al soltarlo."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE es rápido; LLE es más preciso, pero requiere los archivos ROM del DSP."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START envía la tecla de salida (X) a Visual Pinball en lugar de cerrar su ventana."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START envía la tecla de salida (X) a Visual Pinball en lugar de cerrar su ventana: se abre su menú (la mesa se cierra con DESACTIVAR EL MENÚ)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 guardado rápido, START+L3 carga rápida, START+R3 captura de pantalla. Activado por defecto."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Hack necesario para algunos juegos (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Hack necesario para algunos juegos."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Medias scanlines imita una pantalla CRT. 560 x 192 da una imagen más limpia en una pantalla plana."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Controladora de disco duro, necesaria para ejecutar las imágenes de disco duro .hdv y .2mg. Cambiarlo reinicia la máquina."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Oculto por defecto; desactívalo si un juego no arranca correctamente."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Oculta el modelo del arma en el juego (según el juego)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Oculta el puntero en la pantalla táctil cuando está inactivo (tras un tiempo)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Oculta los avisos de compilación de shaders y PPU."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Oculta el punto de mira tras un tiempo sin apuntar ni disparar. Vuelve en cuanto se apunta de nuevo."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Oculta los bordes de la imagen como un televisor, o añade un borde (valores negativos)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Oculta el destello blanco que aparece en cada disparo."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Emulación de alto nivel de algunas funciones de Portfolio OS. Puede mejorar el rendimiento en algunos juegos."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "FPS más altos mediante interpolación de fotogramas, limitados por la sincronización vertical. Puede causar pequeños fallos visuales o de animación."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "Cuanto más alto, más preciso pero más lento."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "Los valores altos usan menos memoria; los bajos van más rápido."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Corrección de velocidad de House of the Dead 4: frecuencia de la CPU en GHz (p. ej. 4.3). Se detecta automáticamente si no se define."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Cuánto hay que mover el stick antes de que el Amiga lo detecte. Súbelo si el personaje se mueve solo."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Velocidad de movimiento del paddle."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Velocidad de movimiento de los paddles cuando se usa el mouse como dispositivo del puerto de juegos."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Qué parte del ancho de la pantalla recorre el paddle de un extremo a otro. Un valor menor hace el paddle más rápido y le permite llegar a los topes sin sacar el puntero de la pantalla, algo que necesitan algunas pantallas de calibración."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Intensidad de la respuesta del stick."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Cómo se muestran la pantalla del TV y la del GamePad."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Cómo se presenta el control al Amiga."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Cómo se presenta el control al Amiga. 'Joystick' es el clásico control de 2 botones que entienden todos los juegos. 'Control CD32' añade los botones de colores y se selecciona automáticamente en CD32."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Cómo se renderiza la imagen. RGB es lo más nítido; los modos compuesto y TV reproducen el sangrado de color de una pantalla de la época."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Cómo se renderiza la imagen. Los modos compuestos reproducen el sangrado de color de una pantalla de la época; RGB es lo más nítido."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Cómo se escala la imagen a la pantalla."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Híbrido dibuja enseguida los nuevos shaders mientras se compilan. Asíncrono puede dejar objetos ausentes durante un momento. Síncrono hace que el juego espere a cada shader."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Si es necesario, define la ROM de GBA que se usará."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Si el joystick está dentro de esta zona muerta, el cursor no se mueve."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Ignora los pequeños movimientos del stick alrededor del centro. Súbelo cuando el cursor en pantalla se mueve solo."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Ignora los ajustes del backglass propios de la mesa (archivo .res junto a la mesa) durante la partida. El archivo se conserva y se restaura al salir."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Ignora los ajustes por juego guardados en shadPS4 y usa siempre los ajustes de RetroBat."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Mejora el rendimiento en CPU de más de 4 núcleos; activado por defecto."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Mejora la precisión de los shaders. Desactivarlo da una pequeña ganancia de velocidad, pero puede causar fallos gráficos en algunos juegos."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Mejora la resolución a cambio de mayores requisitos de rendimiento. Solo OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Mejora la resolución a cambio de mayores requisitos de rendimiento. Requiere una clave de Redream."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Mejora la resolución a cambio de mayores requisitos de rendimiento. Solo Vulkan y OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Mejora la precisión en algunos juegos, pero puede reducir el rendimiento."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Mejora el rendimiento en algunos juegos, pero omite todos los efectos basados en el EFB."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Mejora el rendimiento. Experimental con varias consolas."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Solo en OpenGL."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Súbelo si los disparos se registran ligeramente fuera del objetivo."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Súbelo si la vista o el jugador se mueven solos."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Súbelo si la vista o el jugador se mueven solos. Por defecto 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Aumenta la resolución OpenGL de la 3DFx Voodoo."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Aumenta el número de sprites que se pueden dibujar a la vez en pantalla."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Inicializa los render targets de color desde la memoria emulada. Necesario para que algunos juegos se rendericen bien; puede reducir el rendimiento. Desactivado por defecto."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Inicializa los render targets de profundidad desde la memoria emulada. Necesario para que algunos juegos se rendericen bien; puede reducir el rendimiento. Desactivado por defecto."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Introduce el servidor que se usará con el formato 'x.x.x.x:y'."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Inserta la extensión MoonSound en la ranura de E/S."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Inserta la extensión Video9000 en la ranura de E/S."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Chip de video instalado. Automático usa el TMS9918A salvo que el juego requiera la mejora F18A. Requiere reiniciar el núcleo."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Invierte la señal del sensor de luz de la Zapper. Necesario para algún hardware de pistola."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Invierte la señal del gatillo de la Zapper. Necesario para algún hardware de pistola."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Invierte la vista arriba/abajo (control y mouse)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Invierte la vista arriba/abajo con el control."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Invierte la vista arriba/abajo con el stick derecho."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Invierte el eje vertical en vuelo."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT es lo más rápido; Intérprete es más preciso."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Compilación Just In Time. Acelera mucho los modelos 68020 y posteriores. Se ignora en las máquinas 68000 y se desactiva automáticamente en el modo ciclo exacto."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Mantiene activa la consola DOS al salir del juego o si falla el lanzamiento."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Mantiene la relación de aspecto original en lugar de estirar la imagen."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Tecla que abre el menú propio de Amiberry. F12 es la única tecla de función que nunca tuvo un Amiga, así que es la única que queda libre."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Tecla que alterna entre ventana y pantalla completa durante la emulación."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Teclas usadas como joystick cuando no hay ningún control conectado. Las flechas disparan con Ctrl derecho. El teclado numérico dispara con 0 o 5. WASD dispara con Alt izquierdo."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 y R3 ejecutan los movimientos especiales del personaje actual, cuando el juego los enumera. Activado por defecto."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = Servicio, R3 = Test, para abrir el menú de operador de los juegos. Activado por defecto."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Idioma de los menús y del texto del juego. Un idioma no disponible en el juego se ignora y se mantiene el ajuste del juego."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Idioma de los subtítulos. Un idioma no disponible en el juego se ignora y se mantiene el ajuste del juego."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Idioma de las voces. Un idioma no disponible en el juego se ignora y se mantiene el ajuste del juego."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Gran aceleración en CPU multinúcleo, pero unos pocos juegos se cuelgan con esta opción."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Lanza MameHooker para gestionar las salidas."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Déjalo en auto para adaptarse automáticamente a la orientación del juego; usa este ajuste para forzarla si es necesario."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Déjalo desactivado salvo que la fuente de sincronización sea video: la vsync y la sincronización por audio funcionan mal juntas."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Déjalo en AUTO para que el emulador elija la primera BIOS válida encontrada en '\bios\pcsx2\bios'."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Déjalo en Automático para mantener el procesador que tenía realmente el modelo seleccionado. Una CPU más rápida puede romper los juegos que dependen de una temporización precisa."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Déjalo en Automático salvo que un juego necesite una ROM concreta. El archivo debe estar en la carpeta bios. Requiere reiniciar el núcleo."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "MANUAL no cambia el valor definido por el usuario; AUTO es 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "La izquierda pasa a ser la derecha y arriba pasa a ser abajo."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Deja que ALTIRRA elija el perfil según el juego."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Deja que RetroArch asigne los controles con sus propios perfiles de autoconfiguración en lugar de la asignación de RetroBat. Sustituye la autoconfiguración de RetroBat."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Deja que RetroBat intente obtener la secuencia de arranque del archivo hash de MAME o del nombre del archivo (corchetes)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Deja que RetroBat intente obtener la secuencia de arranque del archivo hash de MAME."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Deja que Visual Pinball cambie él mismo al modo de video seleccionado en lugar de cambiar la resolución del escritorio."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Permite que una ROM de cartucho MegaWiFi acceda a tu red y a Internet. Actívalo solo con ROM de confianza."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Deja que el núcleo marque su propio ritmo en lugar de depender de RetroArch. Prueba 'estándar 50 Hz' si un juego PAL va irregular."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Permite al emulador leer de vuelta la memoria del GS. Activado por defecto. Desactivarlo es más rápido, pero puede romper algunos efectos gráficos."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Permite que el stick izquierdo actúe como joystick además de la cruceta."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Elimina el límite de FPS del juego cuando el juego lo permite. Cualquier valor distinto del original puede romper un juego."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Conecta de 2 a 4 Lynx con el cable ComLynx en una sola pantalla, un control cada una. Desactiva los guardados rápidos y los logros."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Carga un perfil personalizado para la asignación del volante."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Carga los mods (archivos .dusk) desde una carpeta con el nombre del juego situada junto a él, o desde dusklight\data\mods si no la hay."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Carga los mods de la carpeta User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Carga los mods colocados en la carpeta mods del juego (una carpeta con un mod.ini por mod). Activado por defecto."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Carga un preajuste de calidad gráfica (texturas, filtrado, partículas suaves). Déjalo en AUTO para conservar los ajustes del juego."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Carga a la vez los dos primeros discos de un juego multidisco en la unidad 1 y la unidad 2, en lugar de solo en la unidad 1. Necesario para los pocos juegos que piden dos unidades."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Carga las texturas de sustitución de Data\Assets\HDTextures\<rom> en la carpeta del emulador."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Carga toda la imagen del disco en memoria. Carga más rápida, mayor uso de RAM."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Más bajo significa menos latencia; demasiado bajo provoca cortes."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Los valores bajos reducen el retraso del audio; los altos reducen los chasquidos."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "Nivel de MSAA o SSAA."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Temporización de la máquina. 60 Hz es la máquina americana; 50 Hz, la europea. Algunos programas europeos necesitan 50 Hz para ir a la velocidad correcta. Cambiarlo reinicia la máquina."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Memoria principal. Auto usa la RAM del modelo o la base de datos de juegos. Los tamaños no admitidos se redondean al siguiente tamaño del modelo."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Asigna manualmente el control que usa el jugador. Solo es necesario cuando RetroBat no puede distinguir dos controles idénticos, por ejemplo con un encoder arcade de 2 jugadores que Windows ve como un solo dispositivo. Si no, déjalo en AUTO."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Asigna botón a botón un control 8BitDo M30 o similar, a partir de mdControllers.json."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Asigna select a un botón adicional; útil en los juegos de Zelda para no salir al guardar."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Asigna los gatillos al eje vertical del stick analógico. Útil para Gran Turismo y otros juegos de carreras."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Coprocesador matemático. Solo un puñado de juegos de Amiga lo usa, y añadirlo a una máquina que nunca lo tuvo puede confundir a algunos juegos."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Velocidad máxima del cursor táctil con el joystick."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Puede causar artefactos en algunos juegos."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Puede reducir los tirones a cambio de un mayor retraso al iniciar un juego."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Método usado para los modos de video entrelazados (no se aplica a Nintendo 64)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Método usado para los modos de video entrelazados."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Imita algunos famiclones que intercambian los ciclos de trabajo de los canales de onda cuadrada."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "El mipmapping es necesario para algunos juegos."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Refleja el mundo horizontalmente, como en la versión de Wii del juego."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C es la tarjeta de sonido compatible con la mayoría de juegos. Elige Mouse Card solo para los programas que necesitan un mouse Apple real; sustituye a la tarjeta de sonido. Cambiarlo reinicia la máquina."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard es la tarjeta de sonido compatible con la mayoría de juegos. Se ignora en los modelos //c, que no tienen ranuras de expansión."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Modo preseleccionado en la pantalla de selección de jugadores. Download Play necesita la BIOS y el firmware originales."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "El monocromo es necesario para los juegos en alta resolución (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Emulación del CD block más precisa. Requiere una ROM del CD block y desactiva el ajuste de velocidad de lectura."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Monta automáticamente la unidad C: al arrancar."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Mouse: juegos como Elansar o Defender of the Crown. Stick analógico: BattleSphere; selecciónalo también en las opciones del juego."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Mueve el mouse con un stick analógico del control 1 (L2/R2 = botones). Un puerto debe estar en Mouse."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Moverse con el stick analógico izquierdo además de con la cruceta. Activado por defecto."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Nivel de antialiasing por multimuestreo (MSAA). Solo OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Nivel de antialiasing por multimuestreo (MSAA). Solo Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Multiplicador aplicado a la velocidad del cursor del joystick mientras se mantiene el botón de acelerar el puntero (L2 por defecto)."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Silencia el ruido mecánico de las disqueteras."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "NO muestra solo la imagen del ojo izquierdo. El anaglifo necesita lentes 3D de los mismos colores; lado a lado es para visores de RV y pantallas 3D."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC usa cdi200.rom; PAL usa cdi220b.rom."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Resolución nativa del juego. Por defecto, la definida en el juego."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Necesario para algunos juegos, entre ellos varias aventuras de apuntar y hacer clic."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "No hace falta crédito para empezar una partida."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Número de disqueteras emuladas. Un Amiga 500 real solo tenía una. Dos unidades aceleran los juegos multidisco, pero algunos títulos solo esperan una."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Número de fotogramas entre cada presión del turbo."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Desactivado por defecto. Adaptativa no espera a la pantalla cuando un fotograma llega tarde."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Desactivado por defecto: el emulador va por sí solo a la velocidad arcade (57,5 Hz). Actívalo si la imagen presenta tearing."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "En un monitor de 120 Hz o más sin G-SYNC ni FreeSync, usa su frecuencia más alta que sea múltiplo de 60 Hz."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Activado por defecto; desactívalo para usar una calidad de sonido de 11 kHz."

msgctxt "game_options"
msgid "On by default."
msgstr "Activado por defecto."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Activado por defecto. Desactívalo para ganar velocidad con gráficas integradas."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Activado por defecto. Desactívalo cuando la pistola tiene su propia mira (láser, punto de mira Sinden)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Un píxel por píxel del juego (recomendado para los shaders)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Solo se aplica cuando el escalado de texturas (xBRZ) está activado. Las texturas mayores que este tamaño no se escalan."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Solo compatible con OpenGL; sincroniza estrictamente GPU y CPU. Reduce la latencia a cambio de mayores requisitos de rendimiento."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Solo tiene efecto cuando LIMITAR LOS FPS está activado. Por defecto: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Solo para las versiones asiáticas de los juegos."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Solo para las versiones recientes de Ikemen GO. Vulkan es experimental."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Solo se escalan los framebuffers mayores que este tamaño; puede corregir algunos problemas en ciertos juegos."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Úsalo solo si tienes dos controles idénticos que no se detectan bien. Vincula los controles por posición en lugar de por nombre, lo que es menos confiable."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Úsalo solo para reducir la ventana cuando se usa el escalado en los ajustes de Windows."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Solo se usa si está definido; no se asume ninguna imagen de punto de mira por defecto para J2."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Solo se usa cuando hay un dispositivo de salida MIDI seleccionado."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Versión del motor OpenBOR usada para ejecutar el juego. Auto la detecta a partir de los datos del juego, o de un número de build [XXXX] en el nombre del archivo, como en OpenBOR standalone."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "OpenGL es necesario para los shaders y la resolución interna."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Solo OpenGL. Corrige una pantalla negra en algunas GPU integradas AMD; algunos juegos se renderizarán mal."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Abre una segunda ventana para la vista del GamePad."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Placa de sonido opcional (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) o woofer (juegos de Gaelco). Mezcla por defecto; solo placa principal para Star Wars Racer Arcade."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Overclock o underclock de las dos CPU SH-2. 100 es la velocidad de serie."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Overclock o underclock de la CPU principal emulada. Puede ayudar a estabilizar los FPS, pero rompe algunos juegos."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Sustituye la iluminación por defecto de la mesa."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL funciona a 50 Hz y es correcto para casi todos los juegos europeos de Amiga. NTSC funciona a 60 Hz y conviene a unos pocos lanzamientos americanos."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 identifica los controles por su propio número de ranura, que no sigue el orden de jugadores de RetroBat. Automático toma el primero que encuentra; cámbialo si responde el control equivocado."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Ruta de la carpeta donde está AGS WinUAE; si se rellena, RetroBat añade el lanzador AGS al sistema Amiga."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Ruta de la carpeta donde está ExoDOS; obligatoria para que RetroBat pueda escanear los juegos de ExoDOS."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Ruta de la carpeta donde está ExoWin3x; obligatoria para que RetroBat pueda escanear los juegos de ExoWin3x."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Ruta de la carpeta donde está ExoWin9x; obligatoria para que RetroBat pueda escanear los juegos de ExoWin9x."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Por juego: cada juego tiene su propia memoria de consola de 8 KB, así que nunca se llena. Compartida: una sola memoria para todos los juegos, como en un reproductor real."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Iluminación por píxel en lugar de por vértice. Mejora la calidad en algunos juegos."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Coloca una imagen de punto de mira personalizada y selecciónala abajo."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Coloca un archivo 'crosshair.png' personalizado en la subcarpeta 'cross' del emulador o selecciona un archivo abajo."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Coloca un archivo 'crosshair.png' personalizado en la subcarpeta 'cross' del emulador."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: empuja el stick hacia arriba para subir (en la máquina se sube tirando del stick hacia atrás)."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Emite un pitido de aviso cuando la salud es baja."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Reproduce los pitidos de la VMU."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Número de jugadores preseleccionado en la pantalla de selección de jugadores que aparece al iniciar."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Conecta los RetroPad en puertos distintos; útil para los adaptadores de 4 jugadores."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Conecta una tarjeta MIDI y envía su salida a este dispositivo MIDI de Windows, numerado como en las opciones MIDI del emulador. NINGUNO conserva el sonido FM estándar."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Apunta la carpeta 'system' de RetroArch a otra carpeta."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "El puerto 1 es siempre el GamePad de Wii U. Se puede añadir un Wii Remote además para los juegos que lo necesitan."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Puerto de la Light Phaser. Puerto 1 por defecto."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Puerto del Super Scope. Puerto 2 por defecto."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Puerto de la Zapper. Puerto 2 por defecto."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Puede reducir los tiempos de carga a cambio de un arranque más largo."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "Recompilador PowerPC, activado por defecto y mucho más rápido. Desactívalo para usar el intérprete."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Precompila la caché de shaders al iniciar el juego; déjalo ACTIVADO para tener menos tirones en el juego."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Región preferida. Un juego que no la acepta vuelve a una que sí acepta."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Precarga todas las pistas del CD en la RAM."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Se presiona para abrir el menú de Amiberry."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Se presiona para reiniciar el Amiga."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Se presiona para mostrar el teclado en pantalla."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Evita algunos artefactos, pero puede dar bordes duros."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Evita que el sonido mezclado de varios jugadores se sature."

msgctxt "game_options"
msgid "Processor model."
msgstr "Modelo de procesador."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Modelo de procesador. Una CPU más rápida que la de la máquina real puede romper los juegos que dependen de una temporización precisa."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Pone el control del jugador 1 en el puerto 1 en lugar del puerto 2. Necesario para algunos juegos, entre ellos varias aventuras de apuntar y hacer clic."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Mejoras de comodidad: transformación rápida, bolsas más grandes, escalada rápida, guardado instantáneo, guardado automático, menús de mapa mejorados... Clásico corresponde al juego de GameCube. Sin definir: se conservan los ajustes del menú de Dusklight."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD COMO TECLADO: la cruceta envía las flechas y los botones ESPACIO / INTRO, para los juegos sin soporte de joystick."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "RetroBat usa ReShade para mostrar los bezels y los shaders en algunos emuladores standalone. DESACTIVADO: los bezels se muestran con una ventana superpuesta. USAR EL MÍO: RetroBat nunca instala, modifica ni borra los archivos de ReShade en las carpetas de los emuladores."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Lee el disco más rápido que la unidad de la consola. Puede que algunos juegos no lo esperen."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "La velocidad real del Amiga es el valor seguro por defecto. Turbo carga más rápido, pero puede romper algunos cargadores y protecciones anticopia."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Recomendado: Lineal cuando la escala de la pantalla secundaria es inferior al 100%."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "El recompilador es mucho más rápido; el intérprete solo es útil para depurar. Requiere reiniciar."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Reduce la velocidad de los controles analógicos; algunos juegos necesitan valores bajos para ser jugables."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Reduce los tiempos de carga. Puede romper algunos juegos que dependen de los tiempos reales del disco."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Reduce los tirones a cambio de un retraso mucho mayor al iniciar un juego y de un uso elevado de la GPU."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Reduce los chasquidos causados por las escrituras grandes en el canal DMC. Poco preciso; puede suavizar algunos sonidos muestreados."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Reduce el parpadeo."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Reduce los polígonos temblorosos y la deformación de texturas en los juegos 3D."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "Soporte de reproducción MPEG ReelMagic."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Rellena el cinturón con pociones del inventario."

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Región del firmware NEC PAC. Japón: pac-n1.bin o pce-lp1.bin. EE. UU.: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Región elegida primero en los discos multirregión."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Elimina n píxeles de borde en la parte superior e inferior de la pantalla."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Elimina las barras negras laterales en algunas cinemáticas (pantallas ultrapanorámicas). Las zonas fuera del encuadre original pueden verse con fallos."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Elimina las barras negras superior e inferior durante el fijado, el apuntado, las cinemáticas y los diálogos."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Elimina el destello blanco que aparece al disparar."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Elimina los bordes negros alrededor de la imagen del Amiga. Los ajustes más fuertes recortan más y pueden cortar los bordes de algunos juegos."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Elimina el parpadeo de la imagen en Hummer."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Elimina el destello blanco que aparece cuando los juegos desactivan el renderizado 3D."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Renderiza a un múltiplo de la resolución nativa de la N64. Sustituye el ajuste de resolución interna cuando no está en DESACTIVADO."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Renderiza el sombreado Gouraud a precisión completa para reducir las bandas de color en los juegos 3D."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Resolución de renderizado de los juegos vectoriales."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Renderiza en color de 24 bits y elimina el dithering."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Reproduce el filtro paso bajo del hardware real. 'Emulado' sigue el interruptor de filtro de la propia máquina."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Solicita uno o varios puestos concretos; elige la opción PUESTO CONCRETO de arriba."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "Necesario para los programas BASIC. Usa ATARIBAS.ROM si está presente; si no, el Altirra BASIC integrado."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Necesario para Paper Mario: La Puerta Milenaria."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Necesario para que el atajo de rebobinado haga algo."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Necesario para arrancar el juego sin una máquina con movimiento Cycraft."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Necesario para corregir Def Jam Icon."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Requiere al menos '4X SSAA (ORDENADO)'. Los modos 4x requieren '16X SSAA (ORDENADO)'."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Resolución de la salida de video emulada."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Curva de respuesta del cursor táctil con el joystick."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "RetroBat solo configurará el control del jugador 1."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "RetroBat sincronizará las carpetas de partidas de Dolphin y libretro-dolphin."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Reutiliza la caché de shaders creada para el juego. Auto deja decidir al emulador."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Selección de marcha con el stick derecho en los juegos de carreras de 4 velocidades. Patrón en H: diagonales, como una caja de cambios real. Direcciones: arriba 1, abajo 2, izquierda 3, derecha 4. L1/R1 siempre bajan/suben marcha."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Rota la imagen y los controles. Por defecto, los juegos conocidos se rotan automáticamente. MANUAL: SELECT cambia la rotación."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Rota los botones frontales para cambiar la disposición."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Rota la pantalla de Windows del tablero durante la partida; se restaura al salir (Visual Pinball 10.8 y posteriores)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Rota la salida, para los shoot'em up verticales."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Rotación aplicada en los extremos de un balanceo."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Va a la velocidad máxima mientras carga un juego en CD-ROM con la pantalla fija y en silencio."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Va a la velocidad máxima mientras carga un disco o una cinta, cuando no suena nada. Para los discos se requiere EMULACIÓN FIEL DE LA UNIDAD."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Funciona a los 57,524 Hz originales en lugar de 60 Hz. Puede dar tirones en una pantalla de 60 Hz."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Correr por defecto; el botón de correr hace caminar. Activado por defecto."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Correr por defecto; el botón de correr hace caminar. Consume aguante en un jugador."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Hace funcionar más rápido la GPU y el DSP. Puede subir los FPS de los juegos 3D, pero puede causar fallos."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Ejecuta dos Game Gear conectadas lado a lado. Los jugadores 1 y 2 controlan las pantallas 1 y 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Correr sin mantener presionado el botón de correr."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "Control SDL por defecto: lee los controles con la disposición estándar y los demás dispositivos (volantes, palancas de cambios, encoders arcade) con sus botones en bruto. SDL lee todos los dispositivos en bruto."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT usa la soundfont Roland SC-55 incluida con RetroBat."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "ESTIRAR ocupa toda la pantalla y desactiva los bezels."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Guarda el estado del juego al salir y lo restaura en el siguiente inicio (un archivo por juego)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "La escritura se hace en una copia en la carpeta saves; la imagen original nunca se modifica. Restablecer vuelve a empezar desde el disco original (la copia anterior se conserva como .bak)."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Escala de la línea de estado en pantalla."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Escala la imagen solo por números enteros, para tener píxeles nítidos."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Escala la imagen solo por números enteros, para tener píxeles nítidos. Solo a pantalla completa en 1080p o 4K en una pantalla 16:9, con un ligero recorte arriba y abajo."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Escala las coordenadas X respecto al centro de la pantalla. Bájalo si los disparos caen demasiado lejos del punto de mira en los bordes."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Scanlines, máscara de sombra y resplandor del fósforo de un tubo de rayos catódicos."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Pantalla usada para el DMD en una pantalla dedicada, con la misma numeración que ÍNDICE DE MONITOR. AUTO usa la pantalla restante más pequeña. Requiere CONFIGURACIÓN DE LAS PANTALLAS con 3 pantallas."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Pantalla usada para el backglass, con la misma numeración que ÍNDICE DE MONITOR. AUTO usa la pantalla más grande que no sea la del tablero. Requiere CONFIGURACIÓN DE LAS PANTALLAS."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Pantalla usada para mostrar los juegos (0 = pantalla principal). AUTO deja que el emulador elija su pantalla."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Pantallas usadas por el pinball (Visual Pinball 10.8 y posteriores). Las posiciones del backglass y del DMD se calculan entonces automáticamente. Sin definir: se usan los valores de SCREENRES."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Pantallas usadas por el pinball. Las posiciones del backglass y del DMD se calculan entonces automáticamente. Sin definir: 1 pantalla."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Selecciona el tipo de controlador de tubo de rayos catódicos (CRTC) del Amstrad."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Selecciona el modelo de Amstrad a emular."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Selecciona la esquina de la pantalla en la que aparecerá el tatuaje."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Selecciona en qué puerto se inserta la ROM de GBA; por defecto 2."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Selecciona el modo de cambio de marchas de BattleGear4Tuned."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Selecciona el dispositivo que lee las coordenadas X e Y."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Selecciona el modo de presentación de los fotogramas."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Selecciona el modelo de iluminación; el modo antiguo es el menos exigente para la tarjeta gráfica."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Selecciona el perfil que se asigna al jugador."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Selecciona el modo de video (tipo de cable)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Selecciona dónde se asignan los botones Crédito y Start al jugar con un volante."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Selecciona dónde se asignan los botones Test y Servicio al jugar con un volante."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Selecciona qué API gráfica se usa con el renderizador de texturas."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Envía a MAME la ruta completa de la ROM en lugar de solo su nombre."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Envía las salidas de las lámparas y de la drive board a herramientas externas (MAMEHooker...) mediante mensajes de Windows."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Envía las salidas de las lámparas y del retroceso de la pistola a herramientas externas (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Envía las salidas de las lámparas, de la vibración de la pistola y de la drive board a herramientas externas (Hook Of The Reaper, QMamehook...) con el protocolo de red de MAME."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Sensibilidad del spinner emulado."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Define una ISO por defecto, para usar con algunos juegos homebrew."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Define la asignación de control por defecto del jugador 1."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Define la asignación de control por defecto del jugador 2."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Define la asignación de control por defecto."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Define el filtro de escalado del contenido renderizado. FSR requiere Vulkan."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Define el filtro de escalado del contenido renderizado. Solo OpenGL."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Define el comportamiento del botón del micrófono."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Pone la consola en modo panorámico, para los juegos que lo admiten."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Define la frecuencia de refresco del anfitrión."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Actívalo para los juegos que requieren el control en el puerto 2."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Actívalo al usar varias pistolas. Por defecto se activa si se detectan varias pistolas y el driver de entrada no está en 'sdl'."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Activa esta opción para poner el micrófono en la ranura B."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Ponlo en SÍ para volver a punto muerto en los juegos de carreras al soltar la tecla de cambio de marcha."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Define la frecuencia del PowerPC en MHz. 0 (por defecto) usa la frecuencia de la placa del juego."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Define la frecuencia del PowerPC en MHz. AUTO usa la frecuencia del hardware del juego (solo Model 3)."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Define la zona muerta de los sticks analógicos. Solo se usa con el tipo de control 'Control moderno'."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Define el tipo de control del jugador."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Ponerlo a 1 puede aumentar el rendimiento."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Forma de los píxeles: cuadrados o como en la pantalla original."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Forma de la máscara de sombra que dibuja el shader CRT. Solo se usa cuando el shader está en máscara CRT."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "CMOS compartida por todos los contenidos por defecto, o una por juego (mejor para el juego en red)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "Intensidad del enfoque aplicado por FidelityFX CAS. Solo se usa cuando el filtro de escalado está en FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Mensajes breves en pantalla (estado guardado...). Activado por defecto."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Muestra la interfaz de Dolphin además de la pantalla del juego."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Muestra la consola de depuración de Ryujinx."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Muestra una imagen de los controles superpuesta encima del bezel."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Muestra una notificación al conectar o desconectar un control."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Muestra la interfaz del emulador."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Muestra las notificaciones del emulador; activado por defecto (AUTO)."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Muestra información sobre la compilación de shaders."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Muestra información de la disposición de pantallas actual en la esquina superior derecha."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Muestra las notificaciones de compilación de shaders."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Muestra los bordes horizontales. AUTO los recorta al área usada por el juego; mejor con PAR SEGÚN DOT CLOCK."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Muestra un teclado de Amiga en la parte inferior de la pantalla para escribir con el control. Se alterna con un botón asignado; muévete con la cruceta o el stick y presiona otro botón para escribir la tecla."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Muestra marcas de bala en las paredes donde impactan los disparos."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Muestra la actividad de las unidades y la información de rendimiento sobre la imagen."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Muestra los nombres de los disquetes, las luces de las unidades y la velocidad, en ventana y a pantalla completa."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Muestra la pantalla de configuración de WHDLoad cuando un juego la admite."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Muestra el aviso de WHDLoad y espera a que se presione un botón antes de que empiece el juego. Desactivado por defecto para que el juego arranque directamente."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Reduce/amplía el tatuaje para que quepa dentro del borde del bezel."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simula los colores de la pantalla LCD de la Game Boy Color."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Tamaño de los menús y paneles. El juego lo limita a la escala más grande que quepa en la resolución interna."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Tamaño de los píxeles del juego: los valores altos acercan la vista y muestran una parte menor del mapa. Por defecto: 2."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Tamaño de la pantalla secundaria respecto a la principal (solo disposiciones arriba/abajo)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Tamaño de la ventana cuando no está a pantalla completa."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Proporción de tamaño entre las 2 pantallas emuladas."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Omite dibujar un fotograma idéntico al anterior. Puede mejorar el rendimiento."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Omite fotogramas para evitar los chasquidos de audio en equipos lentos."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Omite la espera de 60 segundos a las otras máquinas al arrancar. Desactívalo para jugar con varias máquinas."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Omite la comprobación de arranque que impide que el juego se inicie."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Omite las comprobaciones del hardware al arrancar (cámara, volante, lector de tarjetas)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Omite la larga inicialización del motor del volante al arrancar. Selecciona la revisión de tu juego."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Omite el tiempo de espera mecánico de la disquetera. La carga es mucho más rápida; el disco en sí se sigue leyendo exactamente como el original."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Omite los videos y el logotipo de inicio."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Omite los videos de inicio."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Omite la inicialización del motor del volante al arrancar."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Omite la animación de arranque de la BIOS que aparece al cargar el contenido. Desactívalo para acceder a los ajustes del sistema de PS2 y al gestor de tarjetas de memoria."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Ranura en la que se montan las imágenes de disco. AUTO la elige según el tipo de imagen. Cámbialo solo si un juego no arranca."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Más lento, pero necesario para algunos juegos que dependen del comportamiento de la caché."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Suaviza las texturas 3D."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Suaviza los cambios de dirección. Necesario al usar un control o un teclado."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Suaviza los bordes con un shader; suaviza ligeramente la imagen."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Suaviza el sonido que produce el chip Paula. 'Sinc' es el más refinado y el más exigente."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Suaviza la dirección con control en los juegos de carreras. Fuerte por defecto; sin efecto con un volante."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Algunos juegos requieren invertir los ejes de las pistolas."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Algunos homebrew y hacks de ROM requieren un patrón concreto de la RAM al encender. Requiere reiniciar."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Algunos homebrew o hacks de ROM necesitan esta opción activada."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "Fuente de sonido para la música MIDI. Las opciones MT-32 necesitan las ROM de Roland correspondientes en la carpeta bios."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Especifica qué add-on se usa para la reproducción de CD de audio con los juegos de MD parcheados."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Especifica el parche IPS que se activa; si no se define, se usan todos los parches definidos en el .ini de ips."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Especifica la ruta del bezel."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Especifica la ruta del archivo de firmware."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Hack de velocidad; puede ayudar en los juegos lentos a costa de fallos."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Hack de velocidad."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Velocidad del mouse con el stick analógico."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Velocidad del mouse de Amiga emulado."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Velocidad del puntero del mouse movido con el stick izquierdo."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Acelera la carga del GD-ROM; puede romper algunos juegos."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Acelera la carga de los discos. Puede romper algunos juegos con protección anticopia."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Acelera el acceso a los disquetes para reducir los tiempos de carga."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Reparte el renderizado entre varios hilos de la CPU. Solo es útil con resoluciones internas altas."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Devuelve el volante al centro mientras el juego no envía force feedback, como el muelle mecánico de una máquina arcade."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Tarjeta controladora de disquetes estándar."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Arranca directamente en modo Commodore 64."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Inicia el control con los sticks ya activados, en lugar de tener que presionar el botón ANALOG en el juego."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Inicia el disco directamente en lugar de esperar en el menú PLAY CD-I. Activado por defecto."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Inicia el juego en modo test. Test: tecla 0 o R3; servicio: tecla 9 o L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Inicia Outrun 2 SP SDX sin las comprobaciones de la máquina (drive board y torre)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Inicia el menú de Wii (el menú debe estar instalado en Dolphin)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Zona muerta del eje de dirección, para controles o volantes sin autocentrado."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Guarda las texturas BC1 en 16 bits. Ahorra memoria de video con una pequeña pérdida de calidad."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Intensidad de la vibración del control. 60% por defecto."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Intensidad del motor de retroceso de la pistola. 60% por defecto."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Estira los menús y las pantallas 2D a todo el ancho de la pantalla."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Estira los píxeles verticalmente como el juego DOS original en una pantalla 4:3. Por defecto: activado."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Estira la imagen para llenar la pantalla, ignorando la relación de aspecto."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Estira la imagen a toda la pantalla en lugar de conservar la forma de un monitor de la época."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Estudio: niveles de TV de un reproductor real; el negro se ve gris oscuro en una pantalla de PC. Rango completo: negro profundo."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Supermuestrea los efectos de framebuffer; puede introducir artefactos."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Surround envía a las bocinas traseras el sonido trasero de las máquinas Model 3 de cuatro bocinas (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World). Los demás juegos siguen en estéreo."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Intercambia el paddle 1 y el paddle 2; necesario para algunos juegos que esperan los ejes al revés."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Intercambia los botones A y B del control."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Intercambia los botones A/B y X/Y del control."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Intercambia las pantallas del TV y del GamePad en las disposiciones lado a lado, arriba/abajo e imagen en imagen."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Intercambia los dos puertos del Amiga. Necesario para algunos juegos, entre ellos varias aventuras de apuntar y hacer clic."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Intercambia los índices de pistola entre el jugador 1 y el jugador 2."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Actívalo para usar la carpeta 'saves\switch' de RetroBat para las partidas de Citron y Eden (en lugar de la carpeta del emulador)."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Activarlo cuando se usa un modo de desentrelazado dedicado puede ayudar a reducir el desenfoque."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "System Card usada por los juegos LD-ROM2 que la necesitan. Por defecto: SYSTEM CARD 1 si syscard1.pce está en la carpeta bios."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "Adaptador del conector del sintetizador de voz TI-99."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "TOS 1.06 es solo para STE: si no se define el tipo de máquina, se selecciona STE automáticamente."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 jugadores en White Men Can't Jump y NBA Jam T.E. Rotatorio: Tempest 2000, controlado con el mouse."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "El Amiga envía sus canales totalmente a la izquierda y totalmente a la derecha. Bajarlo los mezcla y es mucho más cómodo con auriculares. 10 es el comportamiento del hardware original."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "El Amiga envía sus canales totalmente a la izquierda y totalmente a la derecha. Bajarlo los mezcla y es mucho más cómodo con auriculares. 100% es el comportamiento del hardware original."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "Cantidad de memoria de video."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "La región del juego debe coincidir con la del menú de Wii; si no, el juego no se reconocerá."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Cuanto mayor es el valor, más lejos se muestran los objetos."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "El stick analógico derecho del jugador 1 controla el segundo joystick, para los juegos de doble stick (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "El stick derecho se usa como cruceta derecha (también en L2, R2, L3 y R3)."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Grosor del borde blanco dibujado cuando hay una pistola Sinden conectada. Normal (12 píxeles) por defecto."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Esta opción solo afecta al control de GameCube."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Este ajuste evita que la emulación se pause al perder el foco."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Este ajuste rota el escritorio de Windows; no se restablece al salir del juego."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Ejecuta el juego sin ninguna de las mejoras gráficas o de CPU seleccionadas."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Umbral a partir del cual el movimiento del stick analógico cuenta como una dirección digital."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Reduce dinámicamente el número de ciclos de CPU emulados si la CPU del anfitrión no da abasto (desactivado por defecto)."

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Entrada de inclinación para Kirby Tilt 'n' Tumble y otros juegos MBC7. Stick analógico por defecto."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "RAM de ampliación Trapdoor, como la de la clásica ampliación A501."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Intenta ejecutar el setup del juego."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "El TurboTap es necesario para jugar con más de un jugador. Se activa automáticamente al conectar un segundo control."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Velocidad de giro con el mouse. Por defecto: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Actívalo para asignar solo la cruceta a las direcciones."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Convierte el stick derecho en un mouse de Amiga; útil para los juegos con menús y las aventuras de apuntar y hacer clic sin soltar el control."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Dos capas por defecto (bit-exact). Ordenada corrige el humo y el cristal superpuestos; damero reproduce la placa arcade (nieve y niebla de Sega Rally 2)."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Tipo de núcleo de emulación de CPU que se usa."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Tipo de FM Towns a emular; por defecto FM TOWNS (MODELO 1/2)."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Elimina el límite de FPS del juego si se encuentra un parche en la base de datos interna."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Desbloquea idiomas adicionales en algunos juegos si la base de datos del núcleo tiene una entrada para ellos."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Sube la frecuencia de la CPU de 93,75 a 125 MHz. Puede aumentar la velocidad de algunos juegos que dependen de la CPU."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Escala las texturas del juego con un filtro de pixel art."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Filtro de escalado de las capas 2D (HUD, fondos)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Filtro de escalado de las capas 2D (HUD, fondos). Solo Vulkan y OpenGL."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Usa la carpeta 'cfg64' para MAME standalone."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Usa el punto de mira 'personalizado' para activar el archivo de punto de mira seleccionado."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Usa el punto de mira 'personalizado' para activar el archivo seleccionado aquí."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Usa 'por juego' si has guardado un perfil para el juego en la carpeta capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Usa 8 MHz para una mejor compatibilidad."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Usa el stick analógico como cruceta."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Usa R1 y L1 para acelerar y frenar en los juegos de carreras; solo compatible con el cambio de marchas 'auto'."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Usa Resizable BAR para las transferencias a la GPU cuando está disponible. Desactívalo si notas tirones o inestabilidad con tu driver."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Usa SDL para todos los controles en lugar de XInput para los controles de Xbox."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Usa SSE4 en lugar de AVX2 para las CPU antiguas."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Usa una paleta de colores predefinida en lugar de la calculada por el emulador."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Usa ampersand y paréntesis izquierdo para start y créditos."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Usa un firmware externo (por defecto 'firmware.bin' en la carpeta bios)."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Usa la BIOS para ciertos sistemas como Neo Geo y Sega ST-V."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Usa botones en lugar de un eje analógico para el volante."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Usa el dispositivo de entrada de audio por defecto de la computadora como micrófono."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Usa el hat para el movimiento además del joystick."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Usa el intérprete para la mejor compatibilidad y el dynarec para el rendimiento."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Usa el stick analógico izquierdo además de la cruceta."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Usa una sola tarjeta de memoria compartida para todos los juegos en lugar de una tarjeta por juego. Las tarjetas se guardan en '\bios\pcsx2\memcards'."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Usa los puertos 5-8 para los controles de GameCube en modo Wii."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Usa los fotogramas preventivos en lugar del run-ahead; se aplica el número de fotogramas de run-ahead."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Usa controles de GameCube reales mediante un adaptador de GameCube. Solo con Wiimotes reales."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Usa los botones superiores para L y R en lugar de los gatillos."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Usa los modelos 3D de los packs HD en lugar de los sprites (renderizadores OpenGL). Activado por defecto."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Usa la BIOS situada en la carpeta 'bios' de RetroBat."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Usa los bezels del pack de artwork de Odin (carpeta artwork del emulador) en lugar de las decoraciones de RetroBat."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Usa el renderizador con compute shaders en lugar del OpenGL clásico. Más rápido con resoluciones internas altas; necesita OpenGL 4.3."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Usa la BIOS integrada del emulador en lugar de los archivos de la carpeta bios. DS Download Play necesita la BIOS y el firmware originales."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Usa las texturas de alta resolución de los packs HD (renderizadores OpenGL). Activado por defecto."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Usa el mouse como los paddles del Apple II, necesario para Arkanoid, Breakout y los demás juegos de rueda. La posición del puntero en la pantalla es la posición del paddle. Sustituye al stick del control para los paddles 1 y 2; déjalo desactivado en los juegos de joystick."

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Usa los ajustes por juego guardados en la interfaz de Vita3K. Sustituyen a los ajustes de RetroBat para este juego."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Usa el mapa de colores double hi-res simplificado. Algunos programas de Apple II se ven más parecidos a la máquina real con él."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Usa esta opción si ArcadeDuck no se muestra en el monitor correcto."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Usa esta opción si Keisho no se muestra en el monitor correcto."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Usa esta opción si Odin no se muestra en el monitor correcto."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Usa esta opción si J1 y J2 están invertidos."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Usa esta opción con un control reconocido como teclado (ipac, etc.)."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Usa este ajuste para ignorar los archivos run.bat, autoexec.bat o dosbox.bat de la carpeta del juego."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Usa tu propio archivo .cfg en saves\mame\cfg. Se conservan las reasignaciones hechas con TAB en el juego. En la primera activación, se importa automáticamente la asignación de la última sesión. La opción de distribución de botones deja de aplicarse a este juego."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Útil para los juegos con efectos de temblor de pantalla como Wipeout Fusion; puede hacer la imagen borrosa."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Útil en algunas pantallas de alta frecuencia para eliminar el efecto fantasma."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Útil al usar una resolución superior a la de la pantalla. Evita el efecto moiré."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Usa 60 Hz (480i) en lugar de 50 Hz (576i)."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "Emulación del filtro de postprocesado VI."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Los valores superiores a 1.00 aumentan el tamaño; los inferiores lo reducen."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD es una tarjeta de video mejorada usada por unas pocas demos modernas. Cambiarlo reinicia la máquina."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Modos de video que la consola ofrece a los juegos. Los modos HD necesitan la señal de video HDTV."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Configuración de vista usada por la mesa. AUTO sigue CONFIGURACIÓN DE LAS PANTALLAS: escritorio para una pantalla horizontal, pantalla completa en una sola pantalla para una pantalla vertical, máquina para varias pantallas (escritorio cuando CONFIGURACIÓN DE LAS PANTALLAS no está definida)."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Volumen del clic de la disquetera emulada."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Volumen de la placa de música en los juegos que la tienen (Daytona USA, Sega Rally). 100% por defecto."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Solo Vulkan. Mejora el rendimiento y corrige muchos fallos gráficos, pero puede ser inestable en algunas GPU. Los métodos no compatibles se sustituyen automáticamente."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Solo Vulkan: indica al driver de video que use un modo de búfer concreto."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Lo que está conectado al primer puerto del Amiga. La mayoría de juegos usan el joystick en el puerto 2 y el mouse en el puerto 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Lo que está conectado al segundo puerto del Amiga."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Lo que está conectado al segundo puerto del Amiga. Por defecto, joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Lo que recibe el segundo puerto cuando se conecta un segundo control."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Al introducir una dirección, el modo pasa automáticamente a 'MANUAL'."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Si está disponible, preferir la pantalla completa exclusiva en los emuladores."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "Al seleccionar 'MANUAL', especifica una dirección en el ajuste siguiente."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Al usar un archivo .m3u, selecciona el índice del disco que se ejecuta."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "Con XInput, esta opción intercambia los controles 1 y 2."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Al usar una pistola Sinden, cierra el programa Lightgun cuando termina el juego."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Al usar la asignación desde archivo para los sistemas arcade, define la disposición que se usa."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Dónde se muestra el DMD. AUTO: en el tablero con 1 pantalla, en la parte inferior de la pantalla del backglass con 2 pantallas, en su propia pantalla con 3 pantallas. Requiere CONFIGURACIÓN DE LAS PANTALLAS."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Qué RetroPad controla cada puerto del Amiga. Déjalo en Automático salvo que los jugadores estén invertidos."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Qué disco de un juego multidisco se inserta al arrancar. POM2 carga un disco cada vez; los demás se cambian desde el menú del juego."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Qué disco de un juego multidisco se inserta al arrancar: siempre el primero, o el que estaba en la unidad la última vez que saliste."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Qué botón frontal valida en los diálogos del sistema de PS3. Los juegos japoneses suelen esperar Círculo y los occidentales, Equis. Déjalo en AUTO para seguir la región seleccionada."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Disquetera en la que actúa el menú de cambio de discos."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Borde blanco dibujado por el emulador, necesario para que las pistolas Sinden apunten."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Anchura del borde blanco dibujado cuando hay una pistola Sinden conectada. 16 píxeles por defecto."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Anchura del borde blanco dibujado cuando hay una pistola Sinden conectada. 2 píxeles por defecto."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Solución necesaria para algunos homebrew y hacks de ROM."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Evita fallos del firmware de algunos volantes que provocan breves cortes de la fuerza. Déjalo desactivado salvo que sea necesario."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Escribe Amiberry.log en la carpeta del emulador. Solo es útil para informar de un problema; ralentiza un poco."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Escribe los eventos de entrada en un archivo de registro en la carpeta saves. Solo es útil para informar de un problema."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "La Z80 SoftCard ejecuta programas CP/M. Aquí se pueden añadir las tarjetas de sonido como segunda tarjeta. Cambiarlo reinicia la máquina."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "RAM de ampliación Zorro II. Necesaria para muchos títulos WHDLoad, pero algunos juegos originales en disquete se niegan a arrancar con ella."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "RAM de ampliación Zorro II. Necesaria para muchos títulos WHDLoad."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Memoria Zorro III, solo utilizable por una máquina acelerada. Déjala en ninguna salvo que un título concreto la pida."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Memoria Zorro III. Útil para las configuraciones de Workbench y algunas demos."
