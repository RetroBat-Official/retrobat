# GLOBAL OPTIONS
msgctxt "game_options"
msgid "GENERAL SETTINGS"
msgstr "OPTIONS GÉNÉRALES"

msgctxt "game_options"
msgid "ADVANCED SETTINGS"
msgstr "OPTIONS AVANCÉES"

msgctxt "game_options"
msgid "LAUNCHER SELECTION"
msgstr "SÉLECTIONNÉ DANS LE LAUNCHER"

msgctxt "game_options"
msgid "GLOBAL OPTIONS"
msgstr "OPTIONS GÉNÉRALES"

msgctxt "game_options"
msgid "SHADER SET"
msgstr "SHADERS"

msgctxt "game_options"
msgid "disabled"
msgstr "désactivé"

msgctxt "game_options"
msgid "DECORATIONS"
msgstr "DÉCORATIONS"

msgctxt "game_options"
msgid "FORCE BEZEL"
msgstr "FORCER LA DÉCORATION"

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Spécifier le chemin du bezel à utiliser."

msgctxt "game_options"
msgid "VIDEO MODE"
msgstr "RÉSOLUTION DE L'ÉCRAN"

msgctxt "game_options"
msgid "GAME ASPECT RATIO"
msgstr "RAPPORT D'ASPECT"

msgctxt "game_options"
msgid "ASPECT RATIO CORRECTION"
msgstr "CORRECTION DU RAPPORT D'ASPECT"

msgctxt "game_options"
msgid "VIDEO SCALER"
msgstr "FILTRE DE MISE À L'ÉCHELLE"

msgctxt "game_options"
msgid "STRETCH TO SCREEN"
msgstr "ÉTIRER POUR REMPLIR L'ÉCRAN"

msgctxt "game_options"
msgid "ENABLE 3D"
msgstr "ACTIVER LA 3D"

msgctxt "game_options"
msgid "FSR UPSCALING"
msgstr "MISE À L'ÉCHELLE FSR"

msgctxt "game_options"
msgid "WRITE COLOR BUFFERS"
msgstr "ÉCRIRE LE TAMPON CHROMATIQUE EN MÉMOIRE"

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Activer cette option en cas de problèmes graphiques dans le jeu (éclairages erronés, éléments manquants)."

msgctxt "game_options"
msgid "ASYNCHRONOUS TEXTURE STREAMING"
msgstr "RENDU DES TEXTURES ASYNCHRONE"

msgctxt "game_options"
msgid "ASYNCHRONOUS TEXTURE COMPILATION"
msgstr "COMPILATION DES TEXTURES ASYNCHRONE"

msgctxt "game_options"
msgid "ASYNCHRONOUS"
msgstr "ASYNCHRONE"

msgctxt "game_options"
msgid "SYNCHRONOUS"
msgstr "SYNCHRONE"

msgctxt "game_options"
msgid "ANALOG/DIGITAL TOGGLE COMBO"
msgstr "COMBO DE BOUTONS ANALOG/DIGITAL"

msgctxt "game_options"
msgid "PERSPECTIVE CORRECTION (PGXP)"
msgstr "CORRECTION DE PERSPECTIVE(PGXP)"

msgctxt "game_options"
msgid "TEXTURE CORRECTION(PGXP)"
msgstr "CORRECTION DES TEXTURES(PGXP)"

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Désactiver cette option permet de passer du mode digital au mode analogique de la manette à l'aide d'une combinaison de touches."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Peut améliorer les performances pour les cartes graphiques puissantes. Uniquement compatible avec le pilot Vulkan."

msgctxt "game_options"
msgid "WRITE DEPTH BUFFERS"
msgstr "ÉCRIRE LE TAMPON DE PROFONDEUR EN MÉMOIRE"

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Copie les valeurs du tampon de profondeur dans la mémoire vidéo. Désactivé par défaut."

msgctxt "game_options"
msgid "READ DEPTH BUFFERS"
msgstr "LIRE LES TAMPONS DE PROFONDEUR"

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initialise les tampons de profondeur depuis la mémoire émulée. Nécessaire au bon rendu de certains jeux, peut réduire les performances. Désactivé par défaut."

msgctxt "game_options"
msgid "READ COLOR BUFFERS"
msgstr "LIRE LES TAMPONS DE COULEUR"

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initialise les tampons de couleur depuis la mémoire émulée. Nécessaire au bon rendu de certains jeux, peut réduire les performances. Désactivé par défaut."

msgctxt "game_options"
msgid "FORCE CPU BLIT EMULATION"
msgstr "FORCER L'ÉMULATION GRAPHIQUE SUR LE CPU"

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Force l'émulation des objets graphiques et la manipulation d'images par le CPU, plus précis dans certains cas et requis pour certains jeux tels que GT6."

msgctxt "game_options"
msgid "DISABLE ZCULL OCCLUSION QUERIES"
msgstr "DÉSACTIVER LES REQUÊTES D'OCCLUSION ZCULL"

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Choisir un shader à appliquer."

msgctxt "game_options"
msgid "PPU LVM PRECOMPILATION"
msgstr "PRÉCOMPILATION PPU LVM"

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Apporte des gains de performance, permet de stabiliser certains jeux tels que GT6."

msgctxt "game_options"
msgid "DRIVER WAKE-UP DELAY"
msgstr "DÉLAI D'ACTIVATION DU PILOTE"

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Modifier ce paramètre en cas d'instabilité. Plus la valeur est élevée, plus la stabilité peut être améliorée. Une valeur entre 200μs et 400μs est généralement recommandée."

msgctxt "game_options"
msgid "STRICT RENDERING MODE"
msgstr "MODE DE RENDU STRICT"

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Contraint l'émulateur à respecter les spécifications de l'API graphique. Peut dégrader les performances mais permet dans de rares cas de corriger des problèmes graphiques (éléments manquants ou scintillement)."

msgctxt "game_options"
msgid "DISABLE VERTEX CACHE"
msgstr "DÉSACTIVER LE CACHE DE VERTEX"

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Permet de résoudre des problèmes graphiques dans certains cas (scintillement, éléments manquants). Peut dégrader les performances."

msgctxt "game_options"
msgid "MULTITHREADED RSX"
msgstr "RSX MULTI-THREAD"

msgctxt "game_options"
msgid "THREADED RENDERING"
msgstr "RENDU MULTI-THREAD"

msgctxt "game_options"
msgid "BIT DEPTH"
msgstr "PROFONDEUR DE BITS"

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Défaut: 10-bits pour la DS et 16-bits pour la DSi"

msgctxt "game_options"
msgid "AUDIO OUTPUT"
msgstr "SORTIE AUDIO"

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Définir quelle console est audible."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Activer l'interpolation audio pour améliorer la qualité."

msgctxt "game_options"
msgid "CURSOR MODE"
msgstr "MODE D'AFFICHAGE DU CURSEUR"

msgctxt "game_options"
msgid "WHILE TOUCHING"
msgstr "AU TOUCHER"

msgctxt "game_options"
msgid "UNTIL TIMEOUT"
msgstr "DISPARAÎT APRÈS DÉLAI"

msgctxt "game_options"
msgid "TOUCH MODE"
msgstr "ÉMULATION DE L'ÉCRAN TACTILE"

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Choix de la méthode d'émulation de l'écran tactile."

msgctxt "game_options"
msgid "POINTER"
msgstr "POINTEUR"

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Définir comment le curseur apparaît sur l'écran du bas."

msgctxt "game_options"
msgid "CONSOLE TYPE"
msgstr "TYPE DE CONSOLE"

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Choisir DSi pour les jeux DSI Ware."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Compatible uniquement avec le pilote vidéo logiciel."

msgctxt "game_options"
msgid "AUDIO SYNC"
msgstr "SYNCHRONISATION AUDIO"

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Permet d'améliorer les performances pour les processeurs multi-coeurs. Peut également causer des ralentissements en cas de charge trop importante sur un coeur."

msgctxt "game_options"
msgid "ADAPT DISPLAY REFRESH RATE"
msgstr "ADAPTER LE TAUX DE RAFRAÎCHISSEMENT AUTOMATIQUEMENT"

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Laisse l'émulateur sélectionner le meilleur taux de rafraîchissement pour le jeu."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Choisir un filtre vidéo."

msgctxt "game_options"
msgid "SCANLINES INTENSITY"
msgstr "INTENSITÉ DES LIGNES DE BALAYAGE"

msgctxt "game_options"
msgid "NO SCANLINES"
msgstr "PAS DE BALAYAGE"

msgctxt "game_options"
msgid "AUDIO QUALITY"
msgstr "QUALITÉ AUDIO"

msgctxt "game_options"
msgid "FORCE STEREO"
msgstr "FORCER LE SON STÉRÉO"

msgctxt "game_options"
msgid "STEREO"
msgstr "STÉRÉO"

msgctxt "game_options"
msgid "SAVE ON EXIT"
msgstr "SAUVEGARDER EN QUITTANT"

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Forcer le son en stéréo même pour les jeux mono."

msgctxt "game_options"
msgid "UPSCALE FILTER"
msgstr "FILTRE DE MISE À L'ÉCHELLE"

msgctxt "game_options"
msgid "PRESCALING"
msgstr "MISE À L'ÉCHELLE AMONT"

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Spécifier le filtre à utiliser pour la mise à l'échelle."

msgctxt "game_options"
msgid "AUTOCONFIGURE CONTROLLERS"
msgstr "AUTOCONFIGURER LES MANETTES"

msgctxt "game_options"
msgid "DISABLE CONTROLLERS AUTOCONFIGURATION"
msgstr "DÉSACTIVER CONFIGURATION AUTO DES MANETTES"

msgctxt "game_options"
msgid "DISCORD RICH PRESENCE"
msgstr "NOTIFICATIONS DISCORD"

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Active la notification Discord du jeu en cours pour les émulateurs compatibles."

msgctxt "game_options"
msgid "COMPRESSION"
msgstr "COMPRESSION"

msgctxt "game_options"
msgid "DECOMPRESSION PATH"
msgstr "EMPLACEMENT DES FICHIERS DÉCOMPRESSÉS"

msgctxt "game_options"
msgid "DECOMPRESSION"
msgstr "DÉCOMPRESSION"

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Modifier l'emplacement des fichiers décompressés (par défaut dans '\roms\.uncompressed')."

msgctxt "game_options"
msgid "ENABLE SUBTITLES"
msgstr "ACTIVER LES SOUS-TITRES"

msgctxt "game_options"
msgid "ALLOW UNSUPPORTED GAMES"
msgstr "AUTORISER LES JEUX NON SUPPORTÉS"

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Désactiver l'avertissement qui apparaît lors du lancement de jeux non supportés."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Conserver ou supprimer les fichiers du jeu une fois décompressés (squashfs, 7z)"

msgctxt "game_options"
msgid "ALWAYS ASK"
msgstr "TOUJOURS DEMANDER"

msgctxt "game_options"
msgid "KEEP"
msgstr "CONSERVER"

msgctxt "game_options"
msgid "DELETE"
msgstr "SUPPRIMER"

msgctxt "game_options"
msgid "SHOW FOLDERS FIRST"
msgstr "AFFICHER LES DOSSIERS EN PREMIER"

msgctxt "game_options"
msgid "SHOW RETROACHIEVEMENTS ICON"
msgstr "AFFICHER L'ICÔNE DE SUCCÈS RÉTRO"

msgctxt "game_options"
msgid "RETROARCH OPTIONS"
msgstr "OPTIONS RETROARCH"

msgctxt "game_options"
msgid "SCREEN ORIENTATION"
msgstr "ORIENTATION DE L'ÉCRAN"

msgctxt "game_options"
msgid "Intro Videos"
msgstr "Vidéos d'intro"

msgctxt "game_options"
msgid "Games"
msgstr "Jeux"

msgctxt "game_options"
msgid "MONITOR INDEX"
msgstr "INDEX DE L'ÉCRAN"

msgctxt "game_options"
msgid "GRAPHIC CARD INDEX"
msgstr "INDEX DE LA CARTE GRAPHIQUE"

msgctxt "game_options"
msgid "GUN 1 INDEX"
msgstr "INDEX DU 1ER PISTOLET"

msgctxt "game_options"
msgid "GUN 2 INDEX"
msgstr "INDEX DU 2E PISTOLET"

msgctxt "game_options"
msgid "Change this only if multiple GPU are used by your system."
msgstr "À modifier uniquement si le système utilise plusieurs cartes graphiques."

msgctxt "game_options"
msgid "CRT SCREEN OUTPUT"
msgstr "FRÉQUENCE DE L'ÉCRAN CRT"

msgctxt "game_options"
msgid "15KHz"
msgstr "15KHz"

msgctxt "game_options"
msgid "31KHz (Standard)"
msgstr "31KHz (Standard)"

msgctxt "game_options"
msgid "31KHz (120Hz)"
msgstr "31KHz (120Hz)"

msgctxt "game_options"
msgid "CRT SCREEN RESOLUTION"
msgstr "RÉSOLUTION DE L'ÉCRAN CRT"

msgctxt "game_options"
msgid "Native"
msgstr "Natif"

msgctxt "game_options"
msgid "Dynamic"
msgstr "Dynamique"

msgctxt "game_options"
msgid "SCREEN SYNC"
msgstr "SYNCHRONISATION VIDÉO"

msgctxt "game_options"
msgid "VERTICAL SYNC"
msgstr "SYNCHRONISATION VERTICALE"

msgctxt "game_options"
msgid "no"
msgstr "non"

msgctxt "game_options"
msgid "yes"
msgstr "oui"

msgctxt "game_options"
msgid "adaptative"
msgstr "adaptative"

msgctxt "game_options"
msgid "HARD SYNC"
msgstr "SYNCHRONISATION MATÉRIELLE"

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of inscreased performance requirements."
msgstr "Uniquement compatible avec OpenGL, réduit la latence mais affecte les performances."

msgctxt "game_options"
msgid "0 frame"
msgstr "0 image"

msgctxt "game_options"
msgid "1 frame"
msgstr "1 image"

msgctxt "game_options"
msgid "2 frames"
msgstr "2 images"

msgctxt "game_options"
msgid "3 frames"
msgstr "3 images"

msgctxt "game_options"
msgid "4 FRAMES"
msgstr "4 IMAGES"

msgctxt "game_options"
msgid "4 frames"
msgstr "4 images"

msgctxt "game_options"
msgid "SWAP INTERVAL"
msgstr "INTERVALLE D'ÉCHANGE"

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Choix de la disposition des boutons, notamment les boutons c-stick."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Définir l'extension attachée au contrôleur."

msgctxt "game_options"
msgid "CONTROLLER LAYOUT"
msgstr "DISPOSITION DES BOUTONS"

msgctxt "game_options"
msgid "CONTROLLER LAYOUT P1"
msgstr "DISPOSITION DES BOUTONS JOUEUR 1"

msgctxt "game_options"
msgid "CONTROLLER LAYOUT P2"
msgstr "DISPOSITION DES BOUTONS JOUEUR 2"

msgctxt "game_options"
msgid "CONTROLLER LAYOUT P3"
msgstr "DISPOSITION DES BOUTONS JOUEUR 3"

msgctxt "game_options"
msgid "CONTROLLER LAYOUT P4"
msgstr "DISPOSITION DES BOUTONS JOUEUR 4"

msgctxt "game_options"
msgid "P1 CONTROLLER EXTENSION"
msgstr "EXTENSION MANETTE 1"

msgctxt "game_options"
msgid "P2 CONTROLLER EXTENSION"
msgstr "EXTENSION MANETTE 2"

msgctxt "game_options"
msgid "P3 CONTROLLER EXTENSION"
msgstr "EXTENSION MANETTE 3"

msgctxt "game_options"
msgid "P4 CONTROLLER EXTENSION"
msgstr "EXTENSION MANETTE 4"

msgctxt "game_options"
msgid "REFRESH RATE (FPS)"
msgstr "TAUX DE RAFRAÎCHISSEMENT (FPS)"

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Définir le taux de fps cible."

msgctxt "game_options"
msgid "COLOR PALETTE"
msgstr "PALETTE DE COULEURS"

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Choisir la palette de couleurs."

msgctxt "game_options"
msgid "LCD BRIGHTNESS"
msgstr "LUMINOSITÉ LCD"

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Régler la luminosité de l'écran LCD émulé."

msgctxt "game_options"
msgid "LCD CONTRAST"
msgstr "CONTRASTE LCD"

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Régler le niveau de contraste de l'écran LCD émulé."

msgctxt "game_options"
msgid "ALWAYS RUN"
msgstr "TOUJOURS COURIR"

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "Par défaut le personnage court, le bouton 'courir' permet de marcher."

msgctxt "game_options"
msgid "RUMBLE LEVEL"
msgstr "RÉGLAGE DES VIBRATIONS"

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Définir la puissance des vibrations. Activer 'secousse écran' si la manette n'est pas compatible avec les vibrations, 'AUTO' active les deux."

msgctxt "game_options"
msgid "NO RUMBLE/NO SHAKE"
msgstr "PAS DE VIBRATIONS/PAS DE SECOUSSES"

msgctxt "game_options"
msgid "NO RUMBLE/LOW SCREEN SHAKE"
msgstr "PAS DE VIBRATIONS/SECOUSSES LÉGÈRES"

msgctxt "game_options"
msgid "NO RUMBLE/STRONG SCREEN SHAKE"
msgstr "PAS DE VIBRATIONS/SECOUSSES FORTES"

msgctxt "game_options"
msgid "LOW RUMBLE/NO SCREEN SHAKE"
msgstr "VIBRATIONS LÉGÈRES/PAS DE SECOUSSES"

msgctxt "game_options"
msgid "MEDIUM RUMBLE/NO SCREEN SHAKE"
msgstr "VIBRATIONS MOYENNES/PAS DE SECOUSSES"

msgctxt "game_options"
msgid "STRONG RUMBLE/NO SCREEN SHAKE"
msgstr "VIBRATIONS FORTES/PAS DE SECOUSSES"

msgctxt "game_options"
msgid "Set this to effectively halve monitor refresh rate."
msgstr "Réduit efficacement la fréquence de rafraîchissement par le facteur spécifié pour permettre une meilleure cadence d'images lors de l'exécution de contenu à une fréquence différente de celle du moniteur."

msgctxt "game_options"
msgid "BLACK FRAMES INSERTION"
msgstr "INSERTION D'IMAGES NOIRES"

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Permet d'éliminer la rémanence sur les écrans ayant une fréquence de rafraîchissement élevée."

msgctxt "game_options"
msgid "G-SYNC/FREESYNC COMPATIBILITY"
msgstr "COMPATIBLITÉ G-SYNC/FREESYNC"

msgctxt "game_options"
msgid "Sync to exact content framerate. Only for G-Sync/FreeSync/HDMI-2.1-VRR compatible monitors."
msgstr "Synchroniser la fréquence de rafraîchissement au contenu, uniquement sur les moniteurs compatibles G-Sync/FreeSync/HDMI-2.1-VRR."

msgctxt "game_options"
msgid "NETWORK"
msgstr "RÉSEAU"

msgctxt "game_options"
msgid "NETWORK TYPE"
msgstr "MODE RÉSEAU"

msgctxt "game_options"
msgid "DISABLE RESIZE"
msgstr "DÉSACTIVER LE REDIMENSIONNEMENT"

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Corrigez le bug Demul (quitte le plein écran en tirant dans le coin supérieur gauche), ce qui bloquera toutes les entrées de la souris vers l'interface graphique de Demul."

msgctxt "game_options"
msgid "USE MAMEHOOKER"
msgstr "UTILISER MAMEHOOKER"

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Lancer MameHooker pour la gestion des sorties."

msgctxt "game_options"
msgid "HOST GAME"
msgstr "MODE HÔTE"

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Se connecter en tant qu'hôte, joueur 1."

msgctxt "game_options"
msgid "UDP PORT"
msgstr "PORT UDP"

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Modifier la résolution du jeu pour les jeux le permettant."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Utiliser winkey pour un clavier, Xinput pour une manette XBOX, sdl pour les autres types de manettes."

msgctxt "game_options"
msgid "ENABLE UPNP"
msgstr "ACTIVER UPNP"

msgctxt "game_options"
msgid "BROADCAST DIGITAL OUTPUTS"
msgstr "DIFFUSER LES SORTIES NUMÉRIQUES"

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Diffuse le retour de saisie sur le port TCP 8000."

msgctxt "game_options"
msgid "DUPLICATE FRAMES"
msgstr "DUPLIQUER LES IMAGES"

msgctxt "game_options"
msgid "Duplicate frames"
msgstr "Dupliquer les images"

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Tourner l'affichage pour les jeux verticaux."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Activer le mod RAM 32MB pour la Dreamcast, peut affecter la compatibilité des jeux."

msgctxt "game_options"
msgid "USE HLE BIOS"
msgstr "UTILISER LE BIOS HLE"

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Utiliser l'interpréteur pour la meilleure compatibilité, le dynarec pour les performances."

msgctxt "game_options"
msgid "AUDIO"
msgstr "AUDIO"

msgctxt "game_options"
msgid "RESAMPLER"
msgstr "RÉ-ÉCHANTILLONEUR"

msgctxt "game_options"
msgid "sinc"
msgstr "sinc"

msgctxt "game_options"
msgid "CC"
msgstr "CC"

msgctxt "game_options"
msgid "none"
msgstr "aucun"

msgctxt "game_options"
msgid "NEAREST"
msgstr "AU PLUS PROCHE"

msgctxt "game_options"
msgid "EMULATION"
msgstr "ÉMULATION"

msgctxt "game_options"
msgid "REWIND"
msgstr "REMBOBINAGE"

msgctxt "game_options"
msgid "LATENCY REDUCTION"
msgstr "RÉDUCTION DE LA LATENCE"

msgctxt "game_options"
msgid "RUN-AHEAD FRAMES"
msgstr "NOMBRE D'IMAGES EN AVANCE"

msgctxt "game_options"
msgid "RUN-AHEAD FRAMES (CORE)"
msgstr "NOMBRE D'IMAGES EN AVANCE (COEUR)"

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Permet de réduire l'input lag."

msgctxt "game_options"
msgid "ENABLE RUN-AHEAD"
msgstr "ACTIVER LE SAUT D'IMAGE"

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Saute une image pour diminuer la latence, impacte les performances."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Activer le saut d'images pour diminuer la latence, impacte les performances."

msgctxt "game_options"
msgid "RUN-AHEAD USE SECOND INSTANCE"
msgstr "INSTANCE SECONDAIRE POUR L'ÉXECUTION EN AVANCE"

msgctxt "game_options"
msgid "USE PREEMPTIVE FRAMES"
msgstr "EXÉCUTER DES IMAGES PRÉEMPTIVES"

