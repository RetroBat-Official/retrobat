msgid "Rendering resolution for vector games."
msgstr "Résolution de rendu des jeux vectoriels."

msgctxt "game_options"
msgid "SELECT + L + R"
msgstr "SELECT + L + R"

msgctxt "game_options"
msgid "ANALOG SPEED"
msgstr "VITESSE ANALOGIQUE"

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Réduit la vitesse des contrôles analogiques, certains jeux nécessitent des valeurs basses pour être jouables."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automatique utilise XInput si toutes les manettes sont XInput, DirectInput sinon."

msgctxt "game_options"
msgid "ANTI-ALIASING (MSAA)"
msgstr "ANTICRÉNELAGE (MSAA)"

