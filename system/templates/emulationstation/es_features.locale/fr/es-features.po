msgid "ZEDMD"
msgstr "ZEDMD"

msgctxt "game_options"
msgid "ZEDMDHD"
msgstr "ZEDMDHD"

msgctxt "game_options"
msgid "PIN2DMD"
msgstr "PIN2DMD"

