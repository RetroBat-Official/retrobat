msgid "SHAKER"
msgstr "SHAKER"

msgctxt "game_options"
msgid "FLIPPERS"
msgstr "FLIPPERS"

msgctxt "game_options"
msgid "USE FPU"
msgstr "UTILISER LE FPU"

msgctxt "game_options"
msgid "FREEPLAY"
msgstr "PARTIE GRATUITE"

msgctxt "game_options"
msgid "IPL VARIANT"
msgstr "VARIANTE IPL"

msgctxt "game_options"
msgid "FRAMERATE POSITION"
msgstr "POSITION DU FRAMERATE"

msgctxt "game_options"
msgid "90 SECONDES"
msgstr "90 SECONDES"

msgctxt "game_options"
msgid "SWAP A/B AND X/Y"
msgstr "INVERSER A/B ET X/Y"

msgid "RED-ZONE PATCHING"
msgstr "CORRECTIF RED-ZONE"

msgid "Experimental. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Expérimental. Protège les données de pile du jeu lorsque l'émulateur gère des exceptions mémoire. Peut corriger des plantages dans certains jeux. À laisser désactivé sauf si un jeu en a besoin."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Affiche le nom des disquettes, les voyants des lecteurs et la vitesse, en fenêtre et en plein écran."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Permet de se déplacer avec le stick analogique gauche en plus de la croix directionnelle. Activé par défaut."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Activé par défaut (AUTO)."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Utiliser cette option si ArcadeDuck ne s'affiche pas sur le bon écran."

msgctxt "game_options"
msgid "TEXTURE CORRECTION (PGXP)"
msgstr "CORRECTION DES TEXTURES (PGXP)"

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Réduit le tremblement des polygones et la déformation des textures dans les jeux 3D."

msgctxt "game_options"
msgid "TRUE COLORS (24 BITS)"
msgstr "COULEURS RÉELLES (24 BITS)"

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Rendu en couleurs 24 bits, sans tramage."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Utilise SDL pour toutes les manettes, au lieu de XInput pour les manettes Xbox."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Affiche les notifications de l'émulateur, activé par défaut (AUTO)."

msgctxt "game_options"
msgid "EXTERNAL OUTPUTS"
msgstr "SORTIES EXTERNES"

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Envoie les sorties (lampes, recul des pistolets) vers des outils externes (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "WINDOWS MESSAGES (MAME)"
msgstr "MESSAGES WINDOWS (MAME)"

msgctxt "game_options"
msgid "NETWORK (TCP)"
msgstr "RÉSEAU (TCP)"

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO affiche la cible lors de la visée à la souris et la masque avec un vrai pistolet."

msgctxt "game_options"
msgid "DSP JIT ENGINE"
msgstr "MOTEUR JIT DU DSP"

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Moteur d'émulation du DSP plus rapide (expérimental). Utilisé uniquement si l'ÉMULATION DSP est activée."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Charge un préréglage de qualité graphique (textures, filtrage, particules douces). Laisser sur AUTO pour conserver les réglages du jeu."

msgctxt "game_options"
msgid "BRIGHTNESS"
msgstr "LUMINOSITÉ"

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 est un jeu très sombre, augmenter pour éclaircir l'image."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Réverbération environnementale (EFX), activée par défaut."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Courir par défaut, le bouton de course fait marcher. Consomme l'endurance en solo."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Inverse le regard haut/bas (manette et souris)."

msgctxt "game_options"
msgid "DOT"
msgstr "POINT"

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Courir par défaut, le bouton de course fait marcher. Activé par défaut."

msgctxt "game_options"
msgid "RENDERER"
msgstr "MOTEUR DE RENDU"

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "CLASSIC est le rendu logiciel d'origine. POLYMOST et POLYMER utilisent OpenGL et gèrent les packs HD."

msgctxt "game_options"
msgid "HD TEXTURES"
msgstr "TEXTURES HD"

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Utilise les textures haute résolution des packs HD (rendus OpenGL). Activé par défaut."

msgctxt "game_options"
msgid "3D MODELS"
msgstr "MODÈLES 3D"

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Utilise les modèles 3D des packs HD à la place des sprites (rendus OpenGL). Activé par défaut."

msgctxt "game_options"
msgid "VOXELS"
msgstr "VOXELS"

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Affiche les objets en voxels au lieu des sprites plats quand ils existent. Activé par défaut."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT utilise la soundfont Roland SC-55 fournie avec RetroBat."

msgctxt "game_options"
msgid "OPL3 EMULATION"
msgstr "ÉMULATION OPL3"

msgctxt "game_options"
msgid "WINDOWS MIDI"
msgstr "MIDI WINDOWS"

msgctxt "game_options"
msgid "SOUNDFONT"
msgstr "SOUNDFONT"

msgctxt "game_options"
msgid "HUD"
msgstr "HUD"

msgctxt "game_options"
msgid "SHOW LEVEL STATS"
msgstr "AFFICHER LES STATS DU NIVEAU"

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Affiche le temps du niveau, les secrets trouvés et les ennemis tués."

msgctxt "game_options"
msgid "HITSCAN WEAPONS ONLY"
msgstr "ARMES À IMPACT DIRECT UNIQUEMENT"

msgctxt "game_options"
msgid "PROJECTILES ONLY"
msgstr "PROJECTILES UNIQUEMENT"

msgctxt "game_options"
msgid "ALL WEAPONS"
msgstr "TOUTES LES ARMES"

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Inverse le regard haut/bas avec le stick droit."

msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Par défaut, Hellfire est lancé si le nom du jeu contient hellfire, sinon Diablo."

msgid "640x480 (ORIGINAL)"
msgstr "640x480 (ORIGINAL)"

msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Activé par défaut. Désactivé, le jeu limite lui-même la fréquence d'images."

msgid "SKIP INTRO"
msgstr "PASSER L'INTRO"

msgid "Skip the startup videos and logo."
msgstr "Passe les vidéos et le logo au démarrage."

msgid "NEAREST PIXEL"
msgstr "PIXEL LE PLUS PROCHE"

msgid "ANISOTROPIC"
msgstr "ANISOTROPE"

msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Agrandit l'image uniquement par multiples entiers, pour des pixels nets."

msgid "EXPERIENCE BAR"
msgstr "BARRE D'EXPÉRIENCE"

msgid "Display an experience bar above the belt."
msgstr "Affiche une barre d'expérience au-dessus de la ceinture."

msgid "ENEMY HEALTH BAR"
msgstr "BARRE DE VIE DES ENNEMIS"

msgid "LIFE AND MANA VALUES"
msgstr "VALEURS DE VIE ET DE MANA"

msgid "Display current life and mana values on the globes."
msgstr "Affiche les valeurs de vie et de mana sur les globes."

msgid "ITEM LABELS"
msgstr "NOMS DES OBJETS"

msgid "Always display the names of items on the ground."
msgstr "Affiche toujours le nom des objets au sol."

msgid "FLOATING NUMBERS"
msgstr "NOMBRES FLOTTANTS"

msgid "Display damage and experience as floating numbers."
msgstr "Affiche les dégâts et l'expérience sous forme de nombres flottants."

msgid "RANDOM ANGLES"
msgstr "ANGLES ALÉATOIRES"

msgid "RUN IN TOWN"
msgstr "COURIR EN VILLE"

msgid "AUTO GOLD PICKUP"
msgstr "RAMASSAGE AUTO DE L'OR"

msgid "AUTO REFILL BELT"
msgstr "REMPLISSAGE AUTO DE LA CEINTURE"

msgid "Refill the belt with potions from the inventory."
msgstr "Remplit la ceinture avec les potions de l'inventaire."

msgid "GAMEPAD SHORTCUTS"
msgstr "RACCOURCIS MANETTE"

msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 sauvegarde rapide, START+L3 chargement rapide, START+R3 capture d'écran. Activé par défaut."

msgid "7% (DEFAULT)"
msgstr "7% (DÉFAUT)"

msgctxt "game_options"
msgid "PLAYER 1 CONTROLLER ONLY"
msgstr "MANETTE DU JOUEUR 1 UNIQUEMENT"

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Par défaut, toutes les manettes déplacent le héros. À activer si une autre manette branchée perturbe les déplacements."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Activé par défaut. Désactivé, la fréquence d'images est limitée à 60 FPS."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Passe les vidéos de démarrage."

msgctxt "game_options"
msgid "ZOOM"
msgstr "ZOOM"

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Permet de zoomer et dézoomer la carte avec la molette de la souris, comme dans les Enhanced Editions."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Uniquement pour les versions asiatiques des jeux."

msgctxt "game_options"
msgid "KOREAN"
msgstr "CORÉEN"

msgctxt "game_options"
msgid "CHINESE"
msgstr "CHINOIS"

msgctxt "game_options"
msgid "POINTER SPEED"
msgstr "VITESSE DU POINTEUR"

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Vitesse du pointeur de la souris déplacé avec le stick gauche."

msgctxt "game_options"
msgid "SLOW"
msgstr "LENT"

msgctxt "game_options"
msgid "VERY FAST"
msgstr "TRÈS RAPIDE"

msgctxt "game_options"
msgid "15% (DEFAULT)"
msgstr "15% (DÉFAUT)"

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Les bezels ne s'affichent qu'en 4/3."

msgctxt "game_options"
msgid "SHOW ACHIEVEMENTS"
msgstr "AFFICHER LES SUCCÈS"

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Affiche un message quand un succès est débloqué. Activé par défaut."

msgctxt "game_options"
msgid "CPU SPEED"
msgstr "VITESSE DU CPU"

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "Fréquence du CPU. Auto utilise la fréquence du modèle ou celle de la base de données des jeux. Certains jeux (SSF2, Alltynex) tournent mieux avec un CPU plus rapide."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Mémoire principale. Auto utilise la RAM du modèle ou celle de la base de données des jeux. Une taille non gérée par le modèle est arrondie à la taille supérieure disponible."

msgctxt "game_options"
msgid "1 MB"
msgstr "1 Mo"

msgctxt "game_options"
msgid "2 MB"
msgstr "2 Mo"

msgctxt "game_options"
msgid "4 MB"
msgstr "4 Mo"

msgctxt "game_options"
msgid "6 MB"
msgstr "6 Mo"

msgctxt "game_options"
msgid "8 MB"
msgstr "8 Mo"

msgctxt "game_options"
msgid "10 MB"
msgstr "10 Mo"

msgctxt "game_options"
msgid "12 MB"
msgstr "12 Mo"

msgctxt "game_options"
msgid "16 MB"
msgstr "16 Mo"

msgctxt "game_options"
msgid "20 MB"
msgstr "20 Mo"

msgctxt "game_options"
msgid "24 MB"
msgstr "24 Mo"

msgctxt "game_options"
msgid "26 MB"
msgstr "26 Mo"

msgctxt "game_options"
msgid "CPU DYNAREC"
msgstr "RECOMPILATION DYNAMIQUE DU CPU"

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Recompilation dynamique. La plupart des jeux tournent plus vite, certains plus lentement."

msgctxt "game_options"
msgid "BOOT DEVICE"
msgstr "PÉRIPHÉRIQUE DE DÉMARRAGE"

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Force le périphérique de démarrage (modèles 1F/2F et suivants uniquement)."

msgctxt "game_options"
msgid "Floppy 1"
msgstr "Disquette 1"

msgctxt "game_options"
msgid "Floppy 2"
msgstr "Disquette 2"

msgctxt "game_options"
msgid "Hard Disk ID 0"
msgstr "Disque dur ID 0"

msgctxt "game_options"
msgid "Hard Disk ID 1"
msgstr "Disque dur ID 1"

msgctxt "game_options"
msgid "Hard Disk ID 2"
msgstr "Disque dur ID 2"

msgctxt "game_options"
msgid "Hard Disk ID 3"
msgstr "Disque dur ID 3"

msgctxt "game_options"
msgid "Hard Disk ID 4"
msgstr "Disque dur ID 4"

msgctxt "game_options"
msgid "PER GAME CMOS"
msgstr "CMOS PAR JEU"

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Par défaut, une CMOS partagée pour tous les jeux, ou une CMOS par jeu (préférable pour le netplay)."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Lecture plus rapide des secteurs. Certains logiciels peuvent ne pas le supporter."

msgctxt "game_options"
msgid "PRELOAD CD-ROM"
msgstr "PRÉCHARGER LE CD-ROM"

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Précharge toutes les pistes du CD en mémoire RAM."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Lecteur utilisé lors du changement de disque."

msgctxt "game_options"
msgid "FLOPPY MULTIDRIVE"
msgstr "MULTI-LECTEUR DE DISQUETTES"

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Insère aussi la disquette suivante dans le lecteur 2."

msgctxt "game_options"
msgid "SAVE DISK"
msgstr "DISQUETTE DE SAUVEGARDE"

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Ajoute une disquette 2HD vierge (sauvegarde/utilisateur) à la liste de changement de disque."

msgctxt "game_options"
msgid "NATIVE RESOLUTION"
msgstr "RÉSOLUTION NATIVE"

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Un pixel de sortie par pixel du jeu (recommandé pour les shaders)."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Saute des images pour éviter les craquements audio sur les machines lentes."

msgctxt "game_options"
msgid "MANUAL"
msgstr "MANUEL"

msgctxt "game_options"
msgid "FRAMESKIP THRESHOLD (%)"
msgstr "SEUIL DU SAUT D'IMAGES (%)"

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Seuil du tampon audio pour le saut d'images en mode manuel."

msgctxt "game_options"
msgid "ORIGINAL GAMEPAD"
msgstr "MANETTE D'ORIGINE"

msgctxt "game_options"
msgid "MARTY GAMEPAD"
msgstr "MANETTE MARTY"

msgctxt "game_options"
msgid "6-BUTTON GAMEPAD"
msgstr "MANETTE 6 BOUTONS"

msgctxt "game_options"
msgid "ALLOW OPPOSING DIRECTIONS"
msgstr "AUTORISER LES DIRECTIONS OPPOSÉES"

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Autorise l'appui simultané sur des directions opposées."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "Sensibilité de la souris FM Towns."

msgctxt "game_options"
msgid "ANALOG STICK MOUSE"
msgstr "SOURIS AU STICK ANALOGIQUE"

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Déplace la souris avec un stick analogique de la manette 1 (L2/R2 = boutons). Un port doit être réglé sur Souris."

msgctxt "game_options"
msgid "ANALOG MOUSE SPEED"
msgstr "VITESSE DE LA SOURIS ANALOGIQUE"

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Vitesse de la souris contrôlée au stick analogique."

msgctxt "game_options"
msgid "ENGINE BUILD"
msgstr "VERSION DU MOTEUR"

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Version du moteur OpenBOR utilisée pour le jeu. Auto la détecte à partir des données du jeu, ou d'un numéro de build [XXXX] dans le nom du fichier comme pour OpenBOR standalone."

msgctxt "game_options"
msgid "ADJUST FOR 4:3 CRT TV"
msgstr "ADAPTER POUR TV CRT 4:3"

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Place les jeux haute résolution ou en écran large dans une image 640x480 avec des bandes noires. Utile uniquement sur une TV CRT 4:3."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto : gauche attaque, bas saut, droite spécial, haut attaque 2, L1/R1 attaque 3/4. OpenBOR standalone : mêmes boutons que l'émulateur OpenBOR standalone."

msgctxt "game_options"
msgid "SPECIAL MOVE MACROS"
msgstr "MACROS DES COUPS SPÉCIAUX"

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 et R3 exécutent les coups spéciaux du personnage, quand le jeu les décrit. Activé par défaut."

msgctxt "game_options"
msgid "ROM CRC VERIFICATION"
msgstr "VÉRIFICATION CRC DES ROMS"

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Vérifie chaque ROM avec la base des jeux. À désactiver uniquement pour tester un romset qui refuse de se charger : des ROMs incorrectes peuvent planter ou corrompre les sauvegardes. Activé par défaut."

msgctxt "game_options"
msgid "2D LAYER UPSCALING"
msgstr "MISE À L'ÉCHELLE DES COUCHES 2D"

msgctxt "game_options"
msgid "NATIVE REFRESH RATE (57.5 HZ)"
msgstr "FRÉQUENCE NATIVE (57,5 HZ)"

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Fonctionne à la fréquence d'origine de 57,524 Hz au lieu de 60 Hz. Peut saccader sur un écran 60 Hz."

msgctxt "game_options"
msgid "TEST/SERVICE ON L3/R3"
msgstr "TEST/SERVICE SUR L3/R3"

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = Service, R3 = Test, pour ouvrir le menu opérateur des jeux. Activé par défaut."

msgctxt "game_options"
msgid "4-SPEED SHIFTER"
msgstr "BOÎTE 4 VITESSES"

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Choix du rapport au stick droit dans les jeux de course à 4 vitesses. Grille en H : diagonales, comme une vraie boîte. Directions : haut 1, bas 2, gauche 3, droite 4. L1/R1 rétrogradent / passent toujours le rapport."

msgctxt "game_options"
msgid "H-GATE"
msgstr "GRILLE EN H"

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automatique : affiché uniquement quand le jeu n'a pas son propre viseur."

msgctxt "game_options"
msgid "PLAYER 1"
msgstr "JOUEUR 1"

msgctxt "game_options"
msgid "PLAYER 2"
msgstr "JOUEUR 2"

msgctxt "game_options"
msgid "PLAYERS 1 AND 2"
msgstr "JOUEURS 1 ET 2"

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Supprime le flash blanc affiché lors des tirs."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "4/3 par défaut, comme le moniteur de la borne. Le bezel n'est affiché qu'en 4/3. Le 16/9 élargit la vue 3D."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Désactivée par défaut : l'émulateur tourne seul à la vitesse de la borne (57,5 Hz). À activer si l'image se déchire."

msgctxt "game_options"
msgid "Use this option if sm2-emu is not displayed on the correct monitor."
msgstr "Utiliser cette option si sm2-emu ne s'affiche pas sur le bon écran."

msgctxt "game_options"
msgid "TRANSLUCENCY"
msgstr "TRANSPARENCE"

msgctxt "game_options"
msgid "BLENDED"
msgstr "MÉLANGÉE"

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Vulkan and OpenGL renderers only."
msgstr "Mélangée affiche les polygones transparents en fondu au lieu du damier de la borne. Rendus Vulkan et OpenGL uniquement."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA)."
msgstr "Affiche le décor jusqu'au bout du circuit dans les jeux compatibles (Daytona USA)."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Aspect moniteur de borne : scanlines, masque et halo."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Courts messages à l'écran (sauvegarde effectuée...). Activé par défaut."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Envoie les lampes et les sorties de la carte de pilotage aux outils externes (MAMEHooker...) par messages Windows."

msgctxt "game_options"
msgid "HIDE SHOT FLASH"
msgstr "MASQUER LE FLASH DES TIRS"

msgctxt "game_options"
msgid "THIN"
msgstr "FIN"

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Activé par défaut. À désactiver si le gun a sa propre visée (laser, viseur Sinden)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Masque le flash blanc affiché à chaque tir."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Épaisseur de la bordure blanche affichée quand un gun Sinden est connecté. Normale (12 pixels) par défaut."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Inverse le regard haut/bas avec la manette."

msgctxt "game_options"
msgid "GAME ZOOM"
msgstr "ZOOM DU JEU"

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Taille des pixels du jeu : une valeur plus élevée zoome et affiche une plus petite partie de la carte. Par défaut : 2."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Étire les pixels verticalement comme le jeu DOS d'origine sur un écran 4:3. Par défaut : activé."

msgctxt "game_options"
msgid "BLOOD AMOUNT"
msgstr "QUANTITÉ DE SANG"

msgctxt "game_options"
msgid "Default: low."
msgstr "Par défaut : faible."

msgctxt "game_options"
msgid "STRETCH UI"
msgstr "ÉTIRER L'INTERFACE"

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Étire les menus et les écrans 2D sur toute la largeur de l'écran."

msgctxt "game_options"
msgid "ADLIB EMULATION"
msgstr "ÉMULATION ADLIB"

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Divise la résolution interne : avec une résolution interne élevée, une valeur plus grande agrandit le jeu. Par défaut : 1."

msgctxt "game_options"
msgid "GAMEPADS BEFORE ARCADE STICKS"
msgstr "MANETTES AVANT LES STICKS ARCADE"

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Les manettes deviennent joueur 1, 2… et les sticks arcade sont attribués aux joueurs suivants."

msgctxt "game_options"
msgid "CONSOLES ONLY"
msgstr "CONSOLES UNIQUEMENT"

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "Le monochrome est requis par les jeux en haute résolution (640x400)."

msgctxt "game_options"
msgid "COLOR (RGB)"
msgstr "COULEUR (RVB)"

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "Le TOS 1.06 est réservé au STE : si le type de machine n'est pas défini, le STE est choisi automatiquement."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Sauvegarde l'état du jeu en quittant et le restaure au lancement suivant (un fichier par jeu)."

msgctxt "game_options"
msgid "BUTTON 2"
msgstr "BOUTON 2"

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Action du deuxième bouton de la manette : barre espace (ex. Xenon 2) ou joystick vers le haut (saut dans les jeux de plateforme)."

msgctxt "game_options"
msgid "SPACE BAR"
msgstr "BARRE ESPACE"

msgctxt "game_options"
msgid "JUMP (UP)"
msgstr "SAUT (HAUT)"

msgctxt "game_options"
msgid "FUNCTION KEYS"
msgstr "TOUCHES DE FONCTION"

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Clavier Atari : F2, F4 et F8 sont laissées au jeu, les sauvegardes d'état et captures passent alors par AltGr+K, AltGr+L et AltGr+G."

msgctxt "game_options"
msgid "RETROBAT SHORTCUTS (F2/F4/F8)"
msgstr "RACCOURCIS RETROBAT (F2/F4/F8)"

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Accélère le chargement des disquettes. Peut empêcher certains jeux protégés de fonctionner."

msgctxt "game_options"
msgid "SCREEN BORDERS"
msgstr "BORDURES DE L'ÉCRAN"

msgctxt "game_options"
msgid "CROP 720P"
msgstr "RECADRAGE 720P"

msgctxt "game_options"
msgid "CROP 1080P"
msgstr "RECADRAGE 1080P"

msgctxt "game_options"
msgid "HARD DISK BOOT"
msgstr "DÉMARRAGE SUR DISQUE DUR"

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automatique : démarrage sur le disque dur quand le jeu a un disque dur et pas de disquette."

msgctxt "game_options"
msgid "ALLOW GAMES TO WRITE TO DISK IMAGES"
msgstr "AUTORISER LES JEUX À ÉCRIRE SUR LES IMAGES DISQUE"

msgctxt "game_options"
msgid "YES (WORKING COPY IN SAVES)"
msgstr "OUI (COPIE DE TRAVAIL DANS SAVES)"

msgctxt "game_options"
msgid "YES AND RESET THE DISK"
msgstr "OUI ET RÉINITIALISER LE DISQUE"

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Modèle d'Apple II à émuler. Les modèles PAL fonctionnent en 50 Hz et sont ceux pour lesquels les démos européennes ont été écrites. Changer cette valeur redémarre la machine."

msgctxt "game_options"
msgid "CHARACTER ROM"
msgstr "ROM DE CARACTÈRES"

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Puce de génération des caractères. Automatique choisit celle qui correspond à la machine sélectionnée."

msgctxt "game_options"
msgid "AUXILIARY MEMORY (RAMWORKS)"
msgstr "MÉMOIRE AUXILIAIRE (RAMWORKS)"

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Carte d'extension mémoire, modèles //e uniquement. Quelques programmes ont besoin de plus que les 64 Ko d'origine."

msgctxt "game_options"
msgid "DISK TURBO"
msgstr "TURBO DISQUE"

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Supprime le temps d'attente mécanique du lecteur de disquette. Le chargement est bien plus rapide, la disquette reste lue exactement comme l'originale."

msgctxt "game_options"
msgid "DISC NUMBER (M3U)"
msgstr "NUMÉRO DE DISQUE (M3U)"

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Quel disque d'un jeu multi-disques est inséré au démarrage. POM2 ne charge qu'un disque à la fois, les autres se changent depuis le menu en jeu."

msgctxt "game_options"
msgid "SLOT 4 SOUND CARD"
msgstr "CARTE SON DU SLOT 4"

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "La Mockingboard est la carte son prise en charge par la plupart des jeux. Ignorée sur les modèles //c, qui n'ont pas de slots d'extension."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Façon dont l'image est rendue. Les modes composite reproduisent la bavure des couleurs d'un écran d'époque, le RVB est le plus net."

msgctxt "game_options"
msgid "CRT EFFECTS"
msgstr "EFFETS CRT"

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Lignes de balayage, masque et halo des phosphores d'un tube cathodique."

msgctxt "game_options"
msgid "DISABLE FLOPPY DRIVE SOUNDS"
msgstr "DÉSACTIVER LES BRUITS DES LECTEURS DE DISQUETTE"

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Coupe le bruit mécanique des lecteurs de disquette."

msgctxt "game_options"
msgid "CONTROLLER FOR THE GAME PORT"
msgstr "MANETTE DU PORT JEU"

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 identifie les manettes par son propre numéro de slot, qui ne suit pas l'ordre des joueurs de RetroBat. Automatique prend la première trouvée, changez si ce n'est pas la bonne manette qui répond."

msgctxt "game_options"
msgid "STICK DEAD ZONE"
msgstr "ZONE MORTE DU STICK"

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Ignore les petits mouvements du stick autour du centre. À augmenter si le curseur dérive tout seul à l'écran."

msgctxt "game_options"
msgid "APPLE //e UNENHANCED (1983)"
msgstr "APPLE //e NON AMÉLIORÉ (1983)"

msgctxt "game_options"
msgid "APPLE //e UNENHANCED PAL (50HZ)"
msgstr "APPLE //e NON AMÉLIORÉ PAL (50HZ)"

msgctxt "game_options"
msgid "AUTOMATIC (DEFAULT)"
msgstr "AUTOMATIQUE (PAR DÉFAUT)"

msgctxt "game_options"
msgid "US ENHANCED"
msgstr "US AMÉLIORÉE"

msgctxt "game_options"
msgid "US UNENHANCED"
msgstr "US NON AMÉLIORÉE"

msgctxt "game_options"
msgid "FRENCH CANADIAN"
msgstr "CANADIEN FRANÇAIS"

msgctxt "game_options"
msgid "APPLE ][ CLASSIC"
msgstr "APPLE ][ CLASSIQUE"

msgctxt "game_options"
msgid "64 KB - STOCK //e (DEFAULT)"
msgstr "64 Ko - //e D'ORIGINE (PAR DÉFAUT)"

msgctxt "game_options"
msgid "128 KB"
msgstr "128 Ko"

msgctxt "game_options"
msgid "256 KB"
msgstr "256 Ko"

msgctxt "game_options"
msgid "512 KB"
msgstr "512 Ko"

msgctxt "game_options"
msgid "DISC 1 (DEFAULT)"
msgstr "DISQUE 1 (PAR DÉFAUT)"

msgctxt "game_options"
msgid "DISC 2"
msgstr "DISQUE 2"

msgctxt "game_options"
msgid "DISC 3"
msgstr "DISQUE 3"

msgctxt "game_options"
msgid "DISC 4"
msgstr "DISQUE 4"

msgctxt "game_options"
msgid "MOCKINGBOARD A/C (DEFAULT)"
msgstr "MOCKINGBOARD A/C (PAR DÉFAUT)"

msgctxt "game_options"
msgid "COLOR - COMPOSITE, GPU (DEFAULT)"
msgstr "COULEUR - COMPOSITE, GPU (PAR DÉFAUT)"

msgctxt "game_options"
msgid "COLOR - COMPOSITE, CPU"
msgstr "COULEUR - COMPOSITE, CPU"

msgctxt "game_options"
msgid "COLOR - APPLEWIN NTSC"
msgstr "COULEUR - APPLEWIN NTSC"

msgctxt "game_options"
msgid "COLOR - NTSC"
msgstr "COULEUR - NTSC"

msgctxt "game_options"
msgid "COLOR - COMPOSITE MEDIUM"
msgstr "COULEUR - COMPOSITE MOYEN"

msgctxt "game_options"
msgid "COLOR - COMPOSITE 4-BIT"
msgstr "COULEUR - COMPOSITE 4 BITS"

msgctxt "game_options"
msgid "COLOR - RGB LE CHAT MAUVE"
msgstr "COULEUR - RVB LE CHAT MAUVE"

msgctxt "game_options"
msgid "SQUARE PIXELS (DEFAULT)"
msgstr "PIXELS CARRÉS (PAR DÉFAUT)"

msgctxt "game_options"
msgid "FIRST CONTROLLER"
msgstr "PREMIÈRE MANETTE"

msgctxt "game_options"
msgid "THIRD CONTROLLER"
msgstr "TROISIÈME MANETTE"

msgctxt "game_options"
msgid "FOURTH CONTROLLER"
msgstr "QUATRIÈME MANETTE"

msgctxt "game_options"
msgid "MOUSE DRIVES THE PADDLES"
msgstr "LA SOURIS PILOTE LES PADDLES"

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Utilise la souris comme paddles Apple II, nécessaire pour Arkanoid, Breakout et les autres jeux à molette. La position du pointeur sur l'écran donne la position du paddle. Remplace le stick de la manette pour les paddles 1 et 2, à laisser désactivé pour les jeux au joystick."

msgctxt "game_options"
msgid "PADDLE MOUSE RANGE"
msgstr "COURSE DU PADDLE SOURIS"

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Quelle portion de la largeur de l'écran parcourt le paddle d'une butée à l'autre. Une valeur plus faible rend le paddle plus rapide et permet d'atteindre les butées sans sortir le pointeur de l'écran, ce dont certains écrans de calibration ont besoin."

msgctxt "game_options"
msgid "FULL SCREEN WIDTH (DEFAULT)"
msgstr "TOUTE LA LARGEUR (PAR DÉFAUT)"

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Assombrit une ligne sur deux pour imiter un tube cathodique."

msgctxt "game_options"
msgid "LIGHT (25%)"
msgstr "LÉGER (25%)"

msgctxt "game_options"
msgid "MEDIUM (50%)"
msgstr "MOYEN (50%)"

msgctxt "game_options"
msgid "STRONG (75%)"
msgstr "FORT (75%)"

msgctxt "game_options"
msgid "IGNORE ASPECT RATIO"
msgstr "IGNORER LE FORMAT D'IMAGE"

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Étire l'image sur tout l'écran au lieu de conserver la forme d'un moniteur d'époque."

msgctxt "game_options"
msgid "BLACK AND WHITE"
msgstr "NOIR ET BLANC"

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Force les modes d'affichage monochromes, comme sur un moniteur vert ou ambre d'époque."

msgctxt "game_options"
msgid "SIMPLE DOUBLE HI-RES COLORS"
msgstr "COULEURS DOUBLE HI-RES SIMPLIFIÉES"

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Utilise la table de couleurs double hi-res simplifiée. Quelques programmes Apple II s'affichent plus fidèlement ainsi."

msgctxt "game_options"
msgid "SWAP PADDLES"
msgstr "INTERVERTIR LES PADDLES"

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Intervertit le paddle 1 et le paddle 2, nécessaire pour quelques jeux qui attendent les axes dans l'autre sens."

msgctxt "game_options"
msgid "INVERT PADDLES"
msgstr "INVERSER LES PADDLES"

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "La gauche devient la droite et le haut devient le bas."

msgctxt "game_options"
msgid "VIDEO SHADER"
msgstr "SHADER VIDÉO"

msgctxt "game_options"
msgid "Built-in video shader. CRT mask reproduces the shadow mask of a tube television, SABR and the interpolation filters smooth the picture without blurring edges, and Scale2x doubles the resolution of the original pixels."
msgstr "Shader vidéo intégré à l'émulateur. Le masque CRT reproduit le masque d'ombre d'un téléviseur cathodique, SABR et les filtres d'interpolation lissent l'image sans rendre les contours flous, et Scale2x double la résolution des pixels d'origine."

msgctxt "game_options"
msgid "CRT MASK (GOAT)"
msgstr "MASQUE CRT (GOAT)"

msgctxt "game_options"
msgid "AUTO INTERPOLATION"
msgstr "INTERPOLATION AUTOMATIQUE"

msgctxt "game_options"
msgid "AUTO INTERPOLATION (SHARPER)"
msgstr "INTERPOLATION AUTOMATIQUE (PLUS NETTE)"

msgctxt "game_options"
msgid "INTERPOLATION (SHARPER)"
msgstr "INTERPOLATION (PLUS NETTE)"

msgctxt "game_options"
msgid "INTERPOLATION, HORIZONTAL ONLY"
msgstr "INTERPOLATION HORIZONTALE UNIQUEMENT"

msgctxt "game_options"
msgid "INTERPOLATION, VERTICAL ONLY"
msgstr "INTERPOLATION VERTICALE UNIQUEMENT"

msgctxt "game_options"
msgid "INTERPOLATION, HORIZONTAL ONLY (SHARPER)"
msgstr "INTERPOLATION HORIZONTALE UNIQUEMENT (PLUS NETTE)"

msgctxt "game_options"
msgid "INTERPOLATION, VERTICAL ONLY (SHARPER)"
msgstr "INTERPOLATION VERTICALE UNIQUEMENT (PLUS NETTE)"

msgctxt "game_options"
msgid "CRT MASK PATTERN"
msgstr "MOTIF DU MASQUE CRT"

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Forme du masque d'ombre dessiné par le shader CRT. Utilisé uniquement lorsque le shader est réglé sur masque CRT."

msgctxt "game_options"
msgid "SCREEN ROTATION"
msgstr "ROTATION DE L'ÉCRAN"

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Fait pivoter l'affichage Windows de l'écran du plateau pendant la partie. L'orientation initiale est rétablie à la fermeture (Visual Pinball 10.8 et versions ultérieures)."

msgctxt "game_options"
msgid "PORTRAIT (90 DEGREES)"
msgstr "PORTRAIT (90 DEGRÉS)"

msgctxt "game_options"
msgid "LANDSCAPE FLIPPED (180 DEGREES)"
msgstr "PAYSAGE INVERSÉ (180 DEGRÉS)"

msgctxt "game_options"
msgid "PORTRAIT FLIPPED (270 DEGREES)"
msgstr "PORTRAIT INVERSÉ (270 DEGRÉS)"

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Permet à Visual Pinball de basculer directement vers le mode vidéo sélectionné au lieu de modifier la résolution du bureau."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Force l'activation ou la désactivation du backglass. AUTO suit la configuration des écrans (activé si aucune configuration des écrans n'est définie)."

msgctxt "game_options"
msgid "TABLE VIEW"
msgstr "VUE DU FLIPPER"

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Mode d'affichage utilisé par le flipper. AUTO suit la configuration des écrans : bureau avec un seul écran en paysage, plein écran unique avec un seul écran en portrait, mode borne avec plusieurs écrans (mode bureau si aucune configuration des écrans n'est définie)."

msgctxt "game_options"
msgid "DESKTOP"
msgstr "BUREAU"

msgctxt "game_options"
msgid "CABINET"
msgstr "BORNE"

msgctxt "game_options"
msgid "FULL SINGLE SCREEN"
msgstr "PLEIN ÉCRAN SUR UN SEUL ÉCRAN"

msgctxt "game_options"
msgid "SCREEN SETUP"
msgstr "CONFIGURATION DES ÉCRANS"

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Écrans utilisés par le flipper (Visual Pinball 10.8 et versions ultérieures). Les positions du backglass et du DMD sont alors calculées automatiquement. Si cette option n'est pas définie, les valeurs SCREENRES sont utilisées."

msgctxt "game_options"
msgid "DETECT CONNECTED SCREENS"
msgstr "DÉTECTER LES ÉCRANS CONNECTÉS"

msgctxt "game_options"
msgid "1 SCREEN"
msgstr "1 ÉCRAN"

msgctxt "game_options"
msgid "2 SCREENS (PLAYFIELD + BACKGLASS)"
msgstr "2 ÉCRANS (PLATEAU + BACKGLASS)"

msgctxt "game_options"
msgid "3 SCREENS (PLAYFIELD + BACKGLASS + DMD)"
msgstr "3 ÉCRANS (PLATEAU + BACKGLASS + DMD)"

msgctxt "game_options"
msgid "BACKGLASS SCREEN"
msgstr "ÉCRAN DU BACKGLASS"

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Écran utilisé pour le backglass, avec la même numérotation que MONITOR INDEX. AUTO utilise le plus grand écran autre que celui du plateau. Nécessite la configuration des écrans."

msgctxt "game_options"
msgid "DMD LOCATION"
msgstr "EMPLACEMENT DU DMD"

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Emplacement d'affichage du DMD. AUTO : sur l'écran du plateau avec 1 écran, en bas de l'écran du backglass avec 2 écrans, sur un écran dédié avec 3 écrans. Nécessite la configuration des écrans."

msgctxt "game_options"
msgid "ON PLAYFIELD SCREEN"
msgstr "SUR L'ÉCRAN DU PLATEAU"

msgctxt "game_options"
msgid "ON BACKGLASS SCREEN"
msgstr "SUR L'ÉCRAN DU BACKGLASS"

msgctxt "game_options"
msgid "DEDICATED SCREEN"
msgstr "ÉCRAN DÉDIÉ"

msgctxt "game_options"
msgid "HARDWARE DMD ONLY"
msgstr "DMD MATÉRIEL UNIQUEMENT"

msgctxt "game_options"
msgid "DMD SCREEN"
msgstr "ÉCRAN DU DMD"

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Écran utilisé pour le DMD lorsqu'il dispose d'un écran dédié, avec la même numérotation que MONITOR INDEX. AUTO utilise le plus petit des écrans restants. Nécessite une configuration de 3 écrans."

msgctxt "game_options"
msgid "IGNORE TABLE .RES FILE"
msgstr "IGNORER LE FICHIER .RES DU FLIPPER"

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Ignore pendant la partie les paramètres de backglass propres au flipper (fichier .res situé à côté de la table). Le fichier est conservé et restauré à la fermeture."

msgctxt "game_options"
msgid "NATIVE (496x384)"
msgstr "NATIVE (496x384)"

msgctxt "game_options"
msgid "2X (992x768)"
msgstr "2X (992x768)"

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Définit la fréquence du PowerPC en MHz. 0 (par défaut) utilise la fréquence de la carte du jeu."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (par défaut) suit la fréquence de l'écran avec interpolation des mouvements. Original et les multiples de 57,524 Hz nécessitent un écran G-SYNC / FreeSync et la synchronisation verticale."

msgctxt "game_options"
msgid "ORIGINAL (57.524 HZ)"
msgstr "ORIGINAL (57,524 HZ)"

msgctxt "game_options"
msgid "VRR 2X (115 HZ)"
msgstr "VRR 2X (115 HZ)"

msgctxt "game_options"
msgid "VRR 3X (172 HZ)"
msgstr "VRR 3X (172 HZ)"

msgctxt "game_options"
msgid "VRR 4X (230 HZ)"
msgstr "VRR 4X (230 HZ)"

msgctxt "game_options"
msgid "LOW LATENCY"
msgstr "FAIBLE LATENCE"

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Désactive l'interpolation des mouvements, une image de latence en moins."

msgctxt "game_options"
msgid "2X"
msgstr "2X"

msgctxt "game_options"
msgid "4X"
msgstr "4X"

msgctxt "game_options"
msgid "8X"
msgstr "8X"

msgctxt "game_options"
msgid "TRANSPARENCY"
msgstr "TRANSPARENCE"

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Deux couches par défaut (exact au bit près). Triée corrige les fumées et vitres superposées, damier reproduit la carte arcade (neige et brouillard de Sega Rally 2)."

msgctxt "game_options"
msgid "SORTED"
msgstr "TRIÉE"

msgctxt "game_options"
msgid "CHECKERBOARD"
msgstr "DAMIER"

msgctxt "game_options"
msgid "QUAD INTERPOLATION"
msgstr "INTERPOLATION DES QUADS"

msgctxt "game_options"
