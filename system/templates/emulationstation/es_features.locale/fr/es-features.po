msgid "Anti-aliasing level."
msgstr "Niveau d'anticrénelage."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Méthode et niveau d'anticrénelage."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "Niveau MSAA ou SSAA."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Niveau d'antialiasing multi-échantillon. OpenGL uniquement."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Niveau d'antialiasing multi-échantillon. Vulkan uniquement."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Réduit l'image agrandie (SSAA). Nécessite l'upscaling."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Lisse les textures 3D."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Filtrage appliqué aux textures 3D."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Filtrage appliqué aux textures 3D. OpenGL uniquement."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Filtre d'amélioration appliqué aux textures."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Filtre appliqué à l'image finale."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Définir le filtre de mise à l'échelle à appliquer. OpenGL uniquement."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Définir le filtre de mise à l'échelle à appliquer. FSR nécessite Vulkan."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Améliore la qualité des textures. OpenGL uniquement."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Améliore la qualité des textures. Vulkan et OpenGL uniquement."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Activé par défaut, rendu correct des quads. Désactivé, les quads sont rendus en triangles (plus rapide)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Définit la fréquence du PowerPC en MHz. AUTO utilise la fréquence du matériel du jeu (Model 3 uniquement)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "Les sauvegardes vont dans une copie du dossier saves, l'image d'origine n'est jamais modifiée. Réinitialiser repart du disque d'origine (ancienne copie conservée en .bak)."

msgctxt "game_options"
msgid "SCREEN RESOLUTION"
msgstr "RÉSOLUTION D'ÉCRAN"

msgctxt "game_options"
msgid "OUTPUT RESOLUTION"
msgstr "RÉSOLUTION DE SORTIE"

msgctxt "game_options"
msgid "WINDOW SIZE"
msgstr "TAILLE DE LA FENÊTRE"

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Résolution du jeu. Une valeur plus élevée affiche une plus grande partie de l'aire de jeu."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Résolution en plein écran. Par défaut, celle du bureau est utilisée."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Résolution de la sortie vidéo émulée."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Taille de la fenêtre hors plein écran."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Améliore la résolution mais nécessite plus de ressources. OpenGL uniquement."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Améliore la résolution mais nécessite plus de ressources. Vulkan et OpenGL uniquement."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Améliore la résolution mais nécessite plus de ressources. Nécessite une clé Redream."

msgctxt "game_options"
msgid "HIGH LEVEL GEOMETRIZER"
msgstr "GÉOMÉTRISEUR HAUT NIVEAU"

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Activé par défaut (rapide). Désactivé, les vrais programmes DSP de géométrie sont exécutés : plus précis mais plus lent (Model 1, jeux Model 2 2B uniquement)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Activé par défaut, le désactiver peut corriger la compatibilité avec les anciens GPU (Model 3 uniquement)."

msgctxt "game_options"
msgid "Black level of the Model 2 picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Niveau du noir de l'image Model 2. 50 % par défaut, calé sur une capture de borne : plus bas est plus sombre, plus haut est plus clair."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Adapte la vue du jeu aux écrans larges."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Étire l'image pour remplir l'écran, sans respecter le format."

msgctxt "game_options"
msgid "CONSOLE ASPECT RATIO"
msgstr "RAPPORT D'ASPECT DE LA CONSOLE"

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Rapport d'aspect fourni par le core, utilisé quand RAPPORT D'ASPECT est sur AUTO."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Rapport d'aspect défini dans les paramètres système de la console."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Corrige le rapport d'aspect des pixels non carrés."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Conserve le rapport d'aspect d'origine au lieu d'étirer l'image."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Forme des pixels : carrés ou comme sur l'affichage d'origine."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Méthode de mise à l'échelle de l'image à l'écran."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Slot dans lequel les images disque sont montées. AUTO le choisit selon le type d'image. À changer uniquement si un jeu refuse de démarrer."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Émule une PlayStation TV pour le multijoueur local (jusqu'à 4 manettes). Les manettes identiques ne sont pas prises en charge, les jeux tactiles peuvent ne pas fonctionner."

msgctxt "game_options"
msgid "TEXTURE UPSCALING FILTER"
msgstr "FILTRE D'AGRANDISSEMENT DES TEXTURES"

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Agrandit les textures du jeu avec un filtre pixel-art."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Filtre d'agrandissement des couches 2D (HUD, décors)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Filtre d'agrandissement des couches 2D (HUD, décors). Vulkan et OpenGL uniquement."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Filtre utilisé quand l'image rendue est plus petite que l'écran."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Filtre utilisé quand l'image rendue est plus grande que l'écran."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Modifier le moteur de rendu utilisé par le coeur. Les jeux au pistolet ne fonctionnent qu'en SOFTWARE."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Plugin graphique utilisé pour le rendu du jeu."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Active les effets de vibration de la manette. Ne fonctionne que dans les jeux de course."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Émule le Game Boy Player pour activer les vibrations dans les jeux compatibles."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "Le 24 bits supprime les bandes de couleur dans les zones sombres et les dégradés. Le HDR nécessite un écran HDR avec le HDR activé dans RetroArch, sinon le core repasse en 24 bits."

msgctxt "game_options"
msgid "AUDIO LATENCY"
msgstr "LATENCE AUDIO"

msgctxt "game_options"
msgid "AUDIO SOURCE"
msgstr "SOURCE AUDIO"

msgctxt "game_options"
msgid "AUTOMATIC PORT SWITCH"
msgstr "BASCULE AUTOMATIQUE DES PORTS"

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Une vibration supplémentaire qui augmente quand vous tournez le volant."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Bascule automatiquement entre Port0 et Port1 selon l'activité des contrôles."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Combinaison de boutons pour basculer entre la TV et le GamePad, utilisée uniquement par la disposition SWITCHABLE."

msgctxt "game_options"
msgid "COMPATIBILITY LEVEL"
msgstr "NIVEAU DE COMPATIBILITÉ"

msgctxt "game_options"
msgid "CONTROLLER PORT 1"
msgstr "PORT MANETTE 1"

msgctxt "game_options"
msgid "CONTROLLER PORT 2"
msgstr "PORT MANETTE 2"

msgctxt "game_options"
msgid "CONTROLLER PORT 3"
msgstr "PORT MANETTE 3"

msgctxt "game_options"
msgid "CONTROLLER PORT 4"
msgstr "PORT MANETTE 4"

msgctxt "game_options"
msgid "CPU"
msgstr "CPU"

msgctxt "game_options"
msgid "DISK SLOT"
msgstr "SLOT DU DISQUE"

msgctxt "game_options"
msgid "DMD"
msgstr "DMD"

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Définit l'affectation des boutons A et B du GunCon (Start et Back du Justifier). Par défaut : croix directionnelle droite/gauche avec une Wiimote sur DolphinBar, boutons de la souris avec les autres pistolets."

msgctxt "game_options"
msgid "EMULATE DIMENSIONS TOYPAD"
msgstr "ÉMULER LE TOYPAD LEGO DIMENSIONS"

msgctxt "game_options"
msgid "EMULATE INFINITY BASE"
msgstr "ÉMULER LA BASE DISNEY INFINITY"

msgctxt "game_options"
msgid "EMULATE SKYLANDER PORTAL"
msgstr "ÉMULER LE PORTAIL SKYLANDERS"

msgctxt "game_options"
msgid "ENABLE STEERING RUMBLE"
msgstr "ACTIVER LA VIBRATION DE DIRECTION"

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Émule l'accessoire Disney Infinity Base."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Émule l'accessoire LEGO Dimensions Toypad."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Émule l'accessoire portail Skylanders."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Tranche de temps des threads émulés. L'augmenter peut aider certains jeux, la baisser peut en fluidifier d'autres."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Activé par défaut. Le désactiver peut améliorer les performances mais casse certains jeux."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Activé par défaut. Shaders plus rapides, peut causer de rares problèmes graphiques."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Activé par défaut. Corrige des problèmes graphiques dans certains jeux, avec un léger coût en performances."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Activé par défaut. Affiche les messages de l'émulateur lui-même."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Expérimental, Windows uniquement. Protège la pile du jeu quand l'émulateur gère des exceptions mémoire. Peut corriger des plantages dans certains jeux. À laisser désactivé sauf si un jeu en a besoin."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Manette supplémentaire. À laisser vide sauf si le jeu en demande une."

msgctxt "game_options"
msgid "FOCUSED PLAYER"
msgstr "JOUEUR ACTIF"

msgctxt "game_options"
msgid "FOUR SWORDS LINK ASSIST"
msgstr "ASSISTANCE LIAISON FOUR SWORDS"

msgctxt "game_options"
msgid "FPS"
msgstr "FPS"

msgctxt "game_options"
msgid "FPU"
msgstr "FPU"

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Force le niveau de compatibilité du moteur. Choisir MBF21 pour les WAD qui l'exigent."

msgctxt "game_options"
msgid "GAMEPAD CURSOR SPEED"
msgstr "VITESSE DU CURSEUR À LA MANETTE"

msgctxt "game_options"
msgid "GX2DRAWDONE SYNC"
msgstr "SYNCHRO GX2DRAWDONE"

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Manière d'afficher l'écran de la TV et celui du GamePad."

msgctxt "game_options"
msgid "LEFT SHOULDER"
msgstr "GÂCHETTE HAUTE GAUCHE"

msgctxt "game_options"
msgid "LEFT TRIGGER"
msgstr "GÂCHETTE GAUCHE"

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Une valeur basse réduit le retard du son, une valeur haute réduit les craquements."

msgctxt "game_options"
msgid "On by default."
msgstr "Activé par défaut."

msgctxt "game_options"
msgid "PLAYER OUTLINES AND BADGES"
msgstr "CONTOURS ET BADGES DES JOUEURS"

msgctxt "game_options"
msgid "PLAYERS"
msgstr "JOUEURS"

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Le port 1 est toujours le GamePad Wii U. Une Wiimote peut y être ajoutée pour les jeux qui en ont besoin."

msgctxt "game_options"
msgid "REDUCE TEXTURE MEMORY"
msgstr "RÉDUIRE LA MÉMOIRE DES TEXTURES"

msgctxt "game_options"
msgid "RIGHT SHOULDER"
msgstr "GÂCHETTE HAUTE DROITE"

msgctxt "game_options"
msgid "RIGHT TRIGGER"
msgstr "GÂCHETTE DROITE"

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "Le recompilateur est bien plus rapide, l'interpréteur ne sert qu'au débogage. Nécessite un redémarrage."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Réutilise le cache de shaders créé pour le jeu. AUTO laisse l'émulateur décider."

msgctxt "game_options"
msgid "SCAN RECOMPILATION (QUIVERLAUNCHER)"
msgstr "ANALYSE DES RECOMPILATIONS (QUIVERLAUNCHER)"

msgctxt "game_options"
msgid "SCREEN LAYOUT"
msgstr "DISPOSITION DES ÉCRANS"

msgctxt "game_options"
msgid "SEARCH IWAD IN PARENT FOLDERS"
msgstr "CHERCHER L'IWAD DANS LES DOSSIERS PARENTS"

msgctxt "game_options"
msgid "SERVER"
msgstr "SERVEUR"

msgctxt "game_options"
msgid "SHADER FAST MATH"
msgstr "CALCULS RAPIDES DES SHADERS"

msgctxt "game_options"
msgid "SHADERSET"
msgstr "SHADERS"

msgctxt "game_options"
msgid "SKIP DUPLICATE FRAMES"
msgstr "IGNORER LES IMAGES EN DOUBLE"

msgctxt "game_options"
msgid "SWAP SCREENS"
msgstr "INVERSER LES ÉCRANS"

msgctxt "game_options"
msgid "SWITCH LAYOUT BUTTON"
msgstr "BOUTON DE CHANGEMENT D'ÉCRAN"

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Règle la zone morte des sticks analogiques. Utilisé uniquement avec le type de manette 'Gamepad Modern'."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Affiche un clavier Amiga en bas de l'écran pour taper à la manette. Il s'ouvre avec un bouton assigné, se parcourt avec la croix ou le stick, et un autre bouton tape la touche."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Affiche les impacts de balles sur les murs."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "N'affiche pas une image identique à la précédente. Peut améliorer les performances."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Répartit le rendu sur plusieurs threads CPU. Utile uniquement avec une résolution interne élevée."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Stocke les textures BC1 en 16 bits. Économise la mémoire vidéo, avec une légère perte de qualité."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Inverse les écrans TV et GamePad dans les dispositions côte à côte, haut/bas et image dans l'image."

msgctxt "game_options"
msgid "TATTOO CORNER"
msgstr "COIN DU TATOUAGE"

msgctxt "game_options"
msgid "THREAD QUANTUM"
msgstr "QUANTUM DES THREADS"

msgctxt "game_options"
msgid "TOS"
msgstr "TOS"

msgctxt "game_options"
msgid "VIEW LAYOUT"
msgstr "DISPOSITION DES VUES"

msgctxt "game_options"
msgid "VRR"
msgstr "VRR"

msgctxt "game_options"
msgid "WALL BULLET DECALS"
msgstr "IMPACTS DE BALLES SUR LES MURS"

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Ce qui est branché sur le second port de l'Amiga. Joystick par défaut."

msgctxt "game_options"
msgid "STICK AIMING"
msgstr "VISÉE AU STICK"

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Jeux de tir joués à la manette (sans lightgun). Relatif : le stick déplace le curseur. Absolu : la position du stick correspond à la position à l'écran, retour au centre au relâchement."

msgctxt "game_options"
msgid "RELATIVE"
msgstr "RELATIF"

msgctxt "game_options"
msgid "ABSOLUTE"
msgstr "ABSOLU"

msgctxt "game_options"
msgid "HIDE INACTIVE CROSSHAIR"
msgstr "MASQUER LE VISEUR INACTIF"

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Masque le viseur après un délai sans viser ni tirer. Il réapparaît dès que vous visez à nouveau."

msgctxt "game_options"
msgid "AFTER 2 SECONDS"
msgstr "APRÈS 2 SECONDES"

msgctxt "game_options"
msgid "AFTER 5 SECONDS"
msgstr "APRÈS 5 SECONDES"

msgctxt "game_options"
msgid "AFTER 10 SECONDS"
msgstr "APRÈS 10 SECONDES"

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Lance le jeu en mode test. Test : touche 0 ou R3, service : touche 9 ou L3."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Correctif de vitesse de House of the Dead 4 : fréquence du CPU en GHz (par ex. 4.3). Détectée automatiquement si non renseignée."

msgctxt "game_options"
msgid "SPRITE TEXTURE FILTERING"
msgstr "FILTRAGE DES TEXTURES DES SPRITES"

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Filtrage appliqué aux sprites et éléments 2D."

msgctxt "game_options"
msgid "Required by BASIC programs. Needs ATARIBAS.ROM."
msgstr "Requis par les programmes BASIC. Nécessite ATARIBAS.ROM."

msgctxt "game_options"
msgid "INTERNAL BASIC"
msgstr "BASIC INTERNE"

msgctxt "game_options"
msgid "ATTACH XEGS KEYBOARD"
msgstr "BRANCHER LE CLAVIER XEGS"

msgctxt "game_options"
msgid "VIDEO CD CARD"
msgstr "CARTE VIDEO CD"

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Émule la carte Video CD, nécessite mpeg_card.bin dans le dossier bios."

msgctxt "game_options"
msgid "MOTION ADAPTIVE"
msgstr "ADAPTATIF AU MOUVEMENT"

msgctxt "game_options"
msgid "GLIDEN64 PLUGIN"
msgstr "PLUGIN GLIDEN64"

msgctxt "game_options"
msgid "BIO SENSOR"
msgstr "CAPTEUR BIO"

msgctxt "game_options"
msgid "GD-ROM FAST LOADING"
msgstr "CHARGEMENT RAPIDE DU GD-ROM"

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Accélère le chargement du GD-ROM, peut perturber certains jeux."

msgctxt "game_options"
msgid "VMU SOUNDS"
msgstr "SONS DU VMU"

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Joue les bips du VMU."

msgctxt "game_options"
msgid "SHOW VMU SCREEN"
msgstr "AFFICHER L'ÉCRAN DU VMU"

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Affiche l'écran du VMU du joueur 1 par-dessus le jeu."

msgctxt "game_options"
msgid "NATIVE DEPTH INTERPOLATION"
msgstr "INTERPOLATION NATIVE DE LA PROFONDEUR"

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Corrige les textures corrompues et les problèmes de profondeur sur les GPU AMD et certains Intel."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers : pousser le manche vers le haut pour monter (sur la borne, on monte en tirant le manche)."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Force la région de la console. Par défaut, la région est détectée à partir du jeu."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Reproduit l'étage de sortie analogique de la console : supprime la composante continue et adoucit les aigus."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Réduit les clics causés par les fortes écritures sur le canal DMC. Peu fidèle, peut atténuer certains sons échantillonnés."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Calcule les dégradés à pleine précision pour réduire les bandes de couleur dans les jeux 3D."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Démarre avec le vrai BIOS Jaguar et son animation de démarrage. Requis par certains jeux."

msgctxt "game_options"
msgid "GPU OVERCLOCK"
msgstr "OVERCLOCKING GPU"

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Accélère le GPU et le DSP. Peut augmenter la fluidité des jeux 3D, mais peut provoquer des bugs."

msgctxt "game_options"
msgid "INSTANT"
msgstr "INSTANTANÉ"

msgctxt "game_options"
msgid "TEAM TAP"
msgstr "TEAM TAP"

msgctxt "game_options"
msgid "ROTARY (MOUSE)"
msgstr "ROTATIF (SOURIS)"

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap : 3-4 joueurs dans White Men Can't Jump et NBA Jam T.E. Rotatif : Tempest 2000, contrôlé à la souris."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Souris : jeux comme Elansar ou Defender of the Crown. Stick analogique : BattleSphere, à sélectionner aussi dans les options du jeu."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Utilise une palette de couleurs prédéfinie au lieu de celle calculée par l'émulateur."

msgctxt "game_options"
msgid "GRAY"
msgstr "GRIS"

msgctxt "game_options"
msgid "PADDLE SPEED"
msgstr "VITESSE DU PADDLE"

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Vitesse de déplacement du paddle."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick : Robotron 2084 et Space Dungeon sur le stick droit. Inverser les ports : Wizard of Wor, Apple Panic. Joy 2B+ : joysticks multi-boutons."

msgctxt "game_options"
msgid "DOT CLOCK PAR"
msgstr "PAR DOT CLOCK"

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Affiche les bordures horizontales. AUTO les recadre sur la zone utilisée par le jeu, idéal avec PAR DOT CLOCK."

msgctxt "game_options"
msgid "SHOW"
msgstr "AFFICHER"

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Tourne à vitesse maximale pendant qu'un jeu CD-ROM charge sur un écran fixe et silencieux."

msgctxt "game_options"
msgid "LASERACTIVE ASPECT RATIO"
msgstr "RAPPORT D'ASPECT LASERACTIVE"

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Format d'affichage de l'image LaserActive, 4:3 par défaut."

msgctxt "game_options"
msgid "LASERACTIVE REGION"
msgstr "RÉGION LASERACTIVE"

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Région du firmware NEC PAC. Japon : pac-n1.bin ou pce-lp1.bin. US : pac-n10.bin."

msgctxt "game_options"
msgid "2 PLAYERS (LINK CABLE)"
msgstr "2 JOUEURS (CÂBLE LINK)"

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Émule deux Game Gear reliées côte à côte. Les joueurs 1 et 2 contrôlent les écrans 1 et 2."

msgctxt "game_options"
msgid "3D GLASSES"
msgstr "LUNETTES 3D"

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "Pour les jeux SegaScope 3-D, n'affiche qu'un oeil au lieu des deux images qui clignotent."

msgctxt "game_options"
msgid "LEFT EYE"
msgstr "OEIL GAUCHE"

msgctxt "game_options"
msgid "RIGHT EYE"
msgstr "OEIL DROIT"

msgctxt "game_options"
msgid "CDZ (UNIVERSE BIOS)"
msgstr "CDZ (UNIVERSE BIOS)"

msgctxt "game_options"
msgid "COMPUTE SHADER RENDERER"
msgstr "RENDU PAR COMPUTE SHADERS"

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Utilise le rendu par compute shaders au lieu du rendu OpenGL classique. Plus rapide en haute résolution interne, nécessite OpenGL 4.3."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO passe en DSi uniquement pour les jeux exclusifs DSi. Forcer DSI pour les DSiWare."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC utilise cdi200.rom, PAL utilise cdi220b.rom."

msgctxt "game_options"
msgid "AUTO PLAY"
msgstr "LECTURE AUTOMATIQUE"

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Lance directement le disque au lieu d'attendre sur le menu PLAY CD-I. Activé par défaut."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Par défaut, une deuxième manette est utilisée quand une deuxième manette est branchée."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Palette de couleurs pour les jeux Game Boy originaux."

msgctxt "game_options"
msgid "B/W"
msgstr "NOIR/BLANC"

msgctxt "game_options"
msgid "AUTUMN"
msgstr "AUTOMNE"

msgctxt "game_options"
msgid "SOFT"
msgstr "DOUX"

msgctxt "game_options"
msgid "SLIME"
msgstr "SLIME"

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simule les couleurs de l'écran LCD de la Game Boy Color."

msgctxt "game_options"
msgid "TILT CONTROL"
msgstr "CONTRÔLE D'INCLINAISON"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Contrôle d'inclinaison pour Kirby Tilt 'n' Tumble et les autres jeux MBC7. Stick analogique par défaut."

msgctxt "game_options"
msgid "NO"
msgstr "NON"

msgctxt "game_options"
msgid "NUMBER OF PLAYERS (COMLYNX)"
msgstr "NOMBRE DE JOUEURS (COMLYNX)"

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Relie 2 à 4 Lynx avec le câble ComLynx sur un seul écran, une manette chacune. Désactive les sauvegardes instantanées et les succès."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Méthode utilisée pour les modes vidéo entrelacés (hors Nintendo 64)."

msgctxt "game_options"
msgid "PHOSPHOR"
msgstr "PHOSPHORE"

msgctxt "game_options"
msgid "OPENGL 4.6"
msgstr "OPENGL 4.6"

msgctxt "game_options"
msgid "VIDEO LEVELS"
msgstr "NIVEAUX VIDÉO"

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Studio : niveaux TV d'un vrai lecteur, le noir paraît gris foncé sur un écran de PC. Plage complète : noir profond."

msgctxt "game_options"
msgid "STUDIO (AUTHENTIC)"
msgstr "STUDIO (AUTHENTIQUE)"

msgctxt "game_options"
msgid "A500 (v1.3, 0.5M Chip)"
msgstr "A500 (v1.3, 0.5M Chip)"

msgctxt "game_options"
msgid "A500 (v1.3, 1.0M Chip)"
msgstr "A500 (v1.3, 1.0M Chip)"

msgctxt "game_options"
msgid "A600 (v3.1, 2M Chip)"
msgstr "A600 (v3.1, 2M Chip)"

msgctxt "game_options"
msgid "A2000 (v1.3, 0.5M Chip + 0.5M Slow)"
msgstr "A2000 (v1.3, 0.5M Chip + 0.5M Lent)"

msgctxt "game_options"
msgid "CHASE CAMERA STABILIZER"
msgstr "STABILISATEUR DE CAMÉRA DE POURSUITE"

msgctxt "game_options"
msgid "Damps the camera swing when steering with a gamepad. Strong by default."
msgstr "Atténue le balancement de la caméra quand on tourne avec une manette. Fort par défaut."

msgctxt "game_options"
msgid "STEERING SENSITIVITY"
msgstr "SENSIBILITÉ DE LA DIRECTION"

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Amplitude de la direction à la manette dans les jeux de course. 66% par défaut, sans effet sur un volant."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Adoucit la direction à la manette dans les jeux de course. Fort par défaut, sans effet sur un volant."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "Recompilateur PowerPC, activé par défaut et beaucoup plus rapide. Désactiver pour utiliser l'interpréteur."

msgctxt "game_options"
msgid "MUSIC VOLUME"
msgstr "VOLUME DE LA MUSIQUE"

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Volume de la carte musicale dans les jeux qui en ont une (Daytona USA, Sega Rally). 100% par défaut."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Puissance des vibrations de la manette. 60% par défaut."

msgctxt "game_options"
msgid "ENABLE GUN RECOIL"
msgstr "ACTIVER LE RECUL DU PISTOLET"

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Déclenche le moteur de recul du pistolet à chaque tir, pour les pistolets qui en ont un. Activé par défaut."

msgctxt "game_options"
msgid "RECOIL STRENGTH"
msgstr "PUISSANCE DU RECUL"

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Puissance du moteur de recul du pistolet. 60% par défaut."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Gain appliqué aux forces de la drive board. 30% par défaut, 200% les double."

msgctxt "game_options"
msgid "D-PAD MODE"
msgstr "MODE DE LA CROIX DIRECTIONNELLE"

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Coprocesseur mathématique (FPU), demandé par certains jeux 3D. Activé par défaut avec le 68040 (intégré), désactivé avec le 68030."