msgid "AGS EXECUTABLE PATH"
msgstr "CHEMIN DE AGS"

msgctxt "game_options"
msgid "NEVER TRY TO MOUNT AS DRIVE"
msgstr "NE PAS MONTER DE LECTEUR"

