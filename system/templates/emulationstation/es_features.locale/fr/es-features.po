msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Les émulateurs ne seront pas mis en pause en cas de perte de focus."

msgctxt "game_options"
msgid "DISABLE GAME CENTER"
msgstr "DÉSACTIVER LE GAME CONTROL CENTER"

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Désactive le menu accessible avec HOTKEY + EST ou F12."

msgctxt "game_options"
msgid "SAVES IN RETROBAT SAVES FOLDER"
msgstr "SAUVEGARDES DANS LE DOSSIER SAVES DE RETROBAT"

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Activer pour sauvegarder dans 'saves\switch' pour citron et eden."

msgctxt "game_options"
msgid "TRY TO READ EXECUTABLE IN BAT FILES"
msgstr "DÉTECTION DES EXÉCUTABLES DANS LES FICHIERS BAT"

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Désactiver cette option pour lancer le fichier .bat. Sinon RetroBat recherche l'exécutable à lancer."

