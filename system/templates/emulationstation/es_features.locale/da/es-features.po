# FEATURES - DESCRIPTIONS
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "»1x« er drevets reelle hastighed. »Turbo« indlæser næsten med det samme, men nogle få spil opdager det og nægter at køre."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "»1x« er drevets reelle hastighed. »Turbo« fjerner emuleringen af diskrotationen og indlæser næsten med det samme, men nogle få spil opdager det og nægter at køre."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "»Præcis« svarer til hardwaren, men kan sænke billedhastigheden kraftigt på gem/indlæs-skærme. Skift kun, hvis en menu er langsom."

msgctxt "game_options"
msgid "'Auto' defaults to the most compatible version for the model."
msgstr "»Auto« bruger som standard den mest kompatible version til modellen."

msgctxt "game_options"
msgid "'Auto' is the default floppy speed (300RPM). 'Turbo' removes disk rotation emulation."
msgstr "»Auto« er standardhastigheden for disketter (300RPM). »Turbo« fjerner emuleringen af diskrotationen."

msgctxt "game_options"
msgid "'Auto' will controls the half-screen fix detection on texture shuffling."
msgstr "»Auto« styrer registreringen af halvskærmsrettelsen ved texture shuffling."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "»Kompatibel« passer til næsten alle spil. »Cykluspræcis« er den mest nøjagtige, men kræver en hurtig pc. »Hurtig« fjerner CPU-hastighedsgrænsen og kan ødelægge timingfølsomme spil."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "»Dobbelt« giver et rent, moderne billede. Scanline-tilstandene genskaber udseendet af en CRT-skærm."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "»Dobbelt stik« tildeler spiller 2's joystick til spiller 1's højre analoge stik, »Byt porte« retter ombytningen af porte i »Wizard of Wor«."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "»Eksakt« er den mest tro Paula-emulering. Sænk den kun, hvis lyden hakker på en langsom pc."

msgctxt "game_options"
msgid "'Games Express' is needed for several unlicensed games."
msgstr "»Games Express« kræves til flere ikke-licenserede spil."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "»Joystick« er det klassiske 2-knaps stik, som alle spil forstår. »CD32-pad« tilføjer de farvede knapper og vælges automatisk på CD32."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "»TIL« sender alle fysiske tastaturhændelser til kernen. »FRA« forhindrer RetroPad-knapper i at skabe tastaturhændelser."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "»FORUDDEFINEREDE FILER« bruger konfigurationsfilerne i emulatorens »cfg«-mappe, »DYNAMISK« genererer konfigurationen ud fra den profil, der er valgt i de avancerede indstillinger under »STYRING«."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "»Sikker« retter teksturfejl i nogle spil på bekostning af meget ydeevne."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "Indstillingen »Skabeloner« kopierer filerne i mappen »emulators\m2emulator\templatescfg« i stedet for at udføre dynamisk autokonfiguration."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "»Tredobbelt buffer« og »Match emuleret indhold« er kun tilgængelige med Vulkan-videodriveren."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "»Turbo« fjerner emuleringen af søgeforsinkelse."

msgctxt "game_options"
msgid "'Weave' should only be used with 1x scaling factor and CRT shaders."
msgstr "»Weave« bør kun bruges med skaleringsfaktor 1x og CRT-shaders."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "»XINPUT« tvinger brug af XInput-API'et for kompatible controllere."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "»directx11« er standard og virker på næsten al hardware. »vulkan« kan være hurtigere på nyere GPU'er. Nogle libretro-kerner tvinger deres egen driver."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8MB Fast RAM (CD32FR). Slået fra som standard ligesom den originale CD32."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "0 giver laveste kvalitet, forsinkelse og CPU-forbrug, 10 giver højeste kvalitet, forsinkelse og CPU-forbrug."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "130-140% anbefales med moderne controllere."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 bit fjerner farvebånd i mørke områder og overgange. HDR kræver en HDR-skærm med HDR aktiveret i RetroArch, ellers falder kernen tilbage til 24 bit."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x svarer til det rigtige drev. Højere hastigheder giver kortere indlæsning, men kan ødelægge spil."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "32k RAM-udvidelseskort installeret."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "4/3 som standard, ligesom arkadeskærmen. Rammen vises kun i 4/3. 16/9 udvider 3D-billedet."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Nogle få spil kræver, at denne indstilling er slået fra."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Nogle få spil kræver dette. Koster omkring 10% ydeevne."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Nogle få meget tidlige spil kræver CTIA-chippen for at blive vist korrekt."

msgctxt "game_options"
msgid "A shadows and colors fix needed for some games such as Tony Hawk Proving Ground."
msgstr "En rettelse af skygger og farver, som nogle spil som Tony Hawk Proving Ground har brug for."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII tildeler tastaturet efter de tegn, det skriver. Original genskaber præcis tastaturet på den emulerede maskine, som nogle få programmer kræver."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "AUTO (anbefalet) lader kernen vælge NAND-filen ud fra spillets region."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO viser sigtekornet, når der sigtes med en mus, og skjuler det med en rigtig lyspistol."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO skifter kun til DSi for DSi-eksklusive spil. Tving DSI til DSiWare."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "AUTOMATISK vælger udvidelsen ud fra programmets størrelse. Kan tvinges med filnavnemærker som (8k) eller [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMATISK: Vita3K indlæser selv de nødvendige firmwaremoduler (anbefalet). EMULATORINDSTILLINGER: behold de moduler, der er valgt i Vita3K-brugerfladen."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Over 60 fps interpoleres billeder mellem spilopdateringer. AUTO følger skærmens opdateringshastighed."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Præcis framebuffer-emulering, meget langsom, men nødvendig for nogle spil."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Agér som spiller 1 og vær vært for spillet."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Handling for controllerens anden knap: mellemrumstast (f.eks. Xenon 2) eller joystick op (hop i platformspil)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Aktivér sigtehjælp."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Aktivér autogem og angiv tiden mellem automatiske gemninger."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "Aktivér dette ved brug af WiiZapper for at bytte aftrækker- og genladningsknapper."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Tilpas spilbilledet til widescreen-skærme."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Tilføj en tom 2HD gemme-/brugerdisk til disklisten."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Tilføj kontaktskygger, kræver hardware-rendereren."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Justér musemarkørens hastighed ud fra det analoge stiks følsomhed."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "Justér udgangsfarverne for at efterligne den originale konsolskærm."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Justér det lodrette centrum for Wiimote-markøren."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Justerer musiknumrenes lydstyrke."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Justerer lydeffekternes lydstyrke."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Avanceret lydbibliotek, som mange spil bruger. Deaktivér kun, hvis et spil går ned eller har lydproblemer."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Sigt med controllerens gyroskop (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Tillad ADAM at skrive til disketter og datapakker. Skrivninger går til en arbejdskopi i gemmemappen, originalfilen ændres aldrig. Kræver genstart af kernen."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Tillad DirectInput-controllere (generiske USB-pads, arkadestik). Slå kun fra, hvis en pad registreres to gange."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Tillad XInput-controllere (Xbox-pads og wrappers). Slå kun fra, hvis en pad registreres to gange."

msgctxt "game_options"
msgid "Allow bilinear scaling on scanout."
msgstr "Tillad bilineær skalering ved scanout."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Muliggør korrekt emulering af teksturombrydning, men koster ydeevne."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Tillad spil, der understøtter forskellige opløsninger, at blive renderet i en bestemt opløsning."

msgctxt "game_options"
msgid "Allow gamma dither."
msgstr "Tillad gamma-dither."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Tillad indbygget HID-understøttelse af DualShock 4-, DualSense- og Switch Pro-pads. Slå fra for at falde tilbage til DirectInput."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Tillad at trykke venstre og højre, eller op og ned, på samme tid. Kan give bevægelsesfejl i nogle spil."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Tillad at trykke modsatte retninger samtidig."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Lad nogle 30fps-spil køre med 60fps."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Tillad tekstur- og vertex-hentekonstanter med ugyldig type, kan bruges til at omgå hentefejl i visse spil."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Tillad variabel opdateringshastighed på skærme, der understøtter det. På skærme uden VRR kan der i visse tilfælde opstå tearing."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Tillad zoom ind og ud på kortet med musehjulet, som i Enhanced Editions."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Giver en særlig tildeling til dit arkadestik baseret på filen »arcade_sticks.json«."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Giver mulighed for at bruge museinput, selv når enhedstypen ikke er »RetroKeyboard/Mouse«."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Indsæt også den næste diskette i drev 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Pak altid arkiver ud, selv hvis dokan kunne montere dem som et drevbogstav."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Vis altid navnene på genstande på jorden."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Amiga-model, der skal emuleres. Hver model kræver sin egen Kickstart-ROM i bios-mappen."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Amiga-model, der skal emuleres. Kræver genstart af kernen. Hver model kræver en tilsvarende Kickstart-ROM i mappen bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Amiga-port, som pistolen er tilsluttet. Port 2 er korrekt på næsten alle maskiner; kun A1000 læser pennen på port 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Mængde af Chip RAM. Nogle senere spil kræver 1 MB. Mere end modellen understøtter kan ødelægge kompatibiliteten."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "Mængde af brugt RAM."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Mængde af små markørbevægelser, der ignoreres."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "En ekstra vibration, der tiltager, når du styrer."

msgctxt "game_options"
msgid "Anti-aliased fetch filter, smooth polygons edges."
msgstr "Anti-aliased hentefilter, udglatter polygonkanter."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Niveau for anti-aliasing."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Metode og niveau for anti-aliasing."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Apple II-model, der skal emuleres. Ændring genstarter maskinen."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Apple II-model, der skal emuleres. PAL-modellerne kører ved 50Hz og er dem, europæiske demoer blev skrevet til. Ændring genstarter maskinen."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Anvendes på sigtekornsbilledet, nyttigt til at skelne spillere fra hinanden."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Anvender en potenskurve på styreværdierne og dæmper små input."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Gælder flight stick- og gashåndtagsakserne i After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Gælder speeder- og bremsepedaler i racerspil."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Anvend Gouraud-skygning i stedet for flad skygning, kun med OpenGL."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Anvend et CRT-filter (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Anvend et brunligt farvefilter."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "Anvend et videofilter fra kernen."

msgctxt "game_options"
msgid "Apply a video filter to mimic various signals."
msgstr "Anvend et videofilter, der efterligner forskellige signaler."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Anvend et videofilter på udgangsbilledet."

msgctxt "game_options"
msgid "Apply an audio filter. 'Gaussian' reproduce the bass-heavy sound of the original hardware."
msgstr "Anvend et lydfilter. »Gaussisk« genskaber den originale hardwares baskraftige lyd."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Anvend et lydfilter. Ændrer lydinterpolationen."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Anvend et kernespecifikt filter, der efterligner gamle signalers rendering."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Anvend rettelse til nogle spil."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Anvend regionen ovenfor, selv når spillet angiver sin egen."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Tilnærmer konsollens analoge udgangstrin: fjerner DC-forskydningen og blødgør de høje frekvenser."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Udseende som en arkadeskærm."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Udseende som en arkadeskærm: scanlines, skyggemaske og glød."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Billedformat fra kernen, bruges når SPILLETS BILLEDFORMAT står på AUTO."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Billedformat angivet i konsollens systemindstillinger."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Atari-tastatur: F2, F4 og F8 overlades til spillet, gemte tilstande og skærmbilleder bruger så AltGr+K, AltGr+L og AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Forsøg at foretage omskalering i nativ opløsning."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Lydbuffertærskel for manuelt frameskip."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Lyd giver den laveste forsinkelse. Video er mere flydende, når skærmens opdateringshastighed ligger tæt på konsollens."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Lydudgangens frekvens."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (standard) følger skærmens opdateringshastighed med bevægelsesinterpolation. Original og multipla af 57.524 Hz kræver en G-SYNC-/FreeSync-skærm og lodret synkronisering."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Centrér sigteaksen automatisk. Nyttigt, når man spiller pistolspil med gamepad i stedet for lyspistol."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Autofire-hastighed. Hurtigere er ikke altid bedre: nogle spil ignorerer input, der er for hurtigt."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: vest angreb, syd hop, øst specialangreb, nord angreb 2, L1/R1 angreb 3/4. OpenBOR standalone: samme knapper som OpenBOR standalone-emulatoren."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automatisk bruger XInput, når alle controllere er XInput-enheder, ellers DirectInput."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automatisk: start fra harddisken, når spillet har en harddisk og ingen diskette."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automatisk: vises kun, når spillet ikke har sit eget sigtekorn."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Anvend automatisk spilforbedringer, hvis de findes i kernens database (LOD, sigtbarhed, spring FMV over)."

msgctxt "game_options"
msgid "Automatically decrease frame delay temporarily to prevent frame drops. Turn off if this worsens audio/video stuttering."
msgstr "Sænk billedforsinkelsen midlertidigt og automatisk for at undgå tabte billeder. Slå fra, hvis det forværrer hakken i lyd/billede."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Spol automatisk FDS-spil frem, når disken indlæses."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Indlæs automatisk patches uden interlacing ved spilstart."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Indlæs automatisk widescreen-patches ved spilstart."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Indlæser og anvender automatisk snydekoder ved spilstart."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Fjerner automatisk de sorte kanter omkring Amiga-billedet, så billedet fylder mere af skærmen."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Rotér automatisk visningen for lodrette spil."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Skift automatisk mellem Port0 og Port1 ud fra inputaktivitet."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Skift automatisk diskside, når spillet beder om det."

msgctxt "game_options"
msgid "Avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Undgå mellemrum mellem pixels ved opskalering. Retter tekst i Wild Arms og efterbilleder i SoulCalibur."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "BIOS-sproget kan påvirke sproget i nogle spil."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Rammer vises kun med 4/3."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "Bilateral CAS anbefales, men går ud over ydeevnen; CAS er mindre aggressiv, men mere subtil."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Billedets sortniveau. 50% som standard, tilpasset en arkadeoptagelse: lavere er mørkere, højere er lysere."

msgctxt "game_options"
msgid "Blend pixel together when in hires mode. Higher values will blur the picture more."
msgstr "Bland pixels i hires-tilstand. Højere værdier slører billedet mere."

msgctxt "game_options"
msgid "Blend pixels from multiple successive frames to simulate LCD ghosting."
msgstr "Bland pixels fra flere på hinanden følgende billeder for at simulere LCD-efterbilleder."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "Blandet tegner de gennemsigtige polygoner som en blød blanding i stedet for arkadens skaktern. Kun Model 1 og Model 2, Vulkan- og OpenGL-renderere."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Slør det emulerede billede."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "Slører tilstødende pixels for gennemsigtighedseffekter."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "Slører tilstødende pixels for at simulere SDTV-opløsning; nogle spil kan kræve det for at emulere gennemsigtighed."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Sæt farten op på emuleringen under opstart."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Start direkte i DS BIOS-menuen, kræver at ekstern bios er aktiveret."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Start på Game Genie-skærmen til indtastning af koder. Kræver »gamegenie.nes« i bios-mappen. Genstart kræves."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Start i konsollens BIOS-menu."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Start med den rigtige Jaguar BIOS og dens startanimation. Kræves af nogle spil."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Stop i værtens debugger (eller gå ned, hvis ingen debugger er tilknyttet), hvis der mødes en ikke-implementeret PowerPC-instruktion."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "Vis system-ROM-menuen ved opstart af arkadesystemer."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Udsend input-feedback på TCP-port 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Byg de cachede shaders, før spillet starter."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Knapkombination til at skifte mellem TV og GamePad, bruges kun af det SKIFTBARE skærmlayout."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Kernens knaplayout, det samme for alle spil. Lad stå på AUTO for at bruge RetroBats tildeling pr. spil og CONTROLLERLAYOUT."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Knap til at bekræfte i systemdialoger og i spil, der følger systemindstillingen. CIRKEL er den japanske konvention."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Som standard startes Hellfire, når spillets navn indeholder hellfire, ellers Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Som standard konfigurerer RetroBat lige så mange spillere som tilsluttede controllere; brug dette til at tilsidesætte det."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Som standard genererer RetroBat sin egen konfigurationsfil; aktivér denne indstilling for at bruge din egen spilindstillingsfil i mappen »emulators\ssf\Setting«."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Som standard bruges en anden gamepad, når en anden controller er tilsluttet."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Som standard flytter alle controllere helten. Aktivér, hvis en anden tilsluttet controller forstyrrer bevægelsen."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "Som standard tildeler zinc venstre stik til bevægelse; brug denne indstilling til at skifte til D-pad."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Som standard kræver RPCS3 guncon i spillerport 3; brug dette til at tvinge den til port 1."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Som standard kasserer RetroBat kernespecifikke indstillingsfiler."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Som standard holder RetroBat installerede spil og roms-mappen synkroniseret."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "Som standard kalibreres med midterste museknap; denne indstilling giver mulighed for en anden knap til kalibreringsskuddet."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Som standard gemmes ændringer på diskdrevet, »Kassér« gemmer ingen ændringer."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Som standard bruges aftrækkeren til at ryste; aktivér for i stedet at simulere et sving."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Spring mipmapping over og brug altid det skarpeste teksturniveau. Bedre billedkvalitet, men nogle få spil får renderingsproblemer."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "CD32-konfiguration. Kræver både CD32-Kickstart og dens udvidede ROM i bios-mappen."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "KLASSISK er den originale software-renderer. POLYMOST og POLYMER bruger OpenGL og understøtter HD-pakker."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "CPC's fysiske RAM-størrelse i kB."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "CPU-ur. Auto bruger modellens ur eller spildatabasen. Nogle spil (SSF2, Alltynex) har gavn af en hurtigere CPU."

msgctxt "game_options"
msgid "CPU frequency multiplier. Applies only with Cycle-exact."
msgstr "Multiplikator for CPU-frekvens. Gælder kun med cykluspræcis."

msgctxt "game_options"
msgid "Cache custom textures to system RAM on startup."
msgstr "Cache brugerdefinerede teksturer i system-RAM ved opstart."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Kamerahastighed med højre analoge stik eller musen."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Kan påvirke ydeevnen på uventede måder."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Kan bruges til at slå BIOS md5-kontrollen fra, hvis der bruges en brugerdefineret bios."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "Kan bruges til at forbedre billedhastigheden, men kan ødelægge hastigheden i nogle spil."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Kan bruges til at forbedre ydeevnen for 3D-rendering i nogle spil."

msgctxt "game_options"
msgid "Can be used to simulate colors of particular displays."
msgstr "Kan bruges til at simulere farverne på bestemte skærme."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Kan være nyttig til Gran Turismo, aftrækkere tildeles andre knapper."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Kan være nyttig til Gran Turismo, aftrækkere tildeles højre analoge stik."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Kan være nyttig til Metal Gear for at simulere trykfølsomhed."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Kan gavne nogle spil."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Kan give forskellige fejl."

msgctxt "game_options"
msgid "Can fix bad memory access error with some games."
msgstr "Kan rette fejl med ugyldig hukommelsesadgang i nogle spil."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Kan rette forskudte 2D-billeder som karaktervalget i Mario Kart."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Kan rette nogle fejl, der også opstod på den originale hardware."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Kan rette nogle spil ved brug af ikke-nativ opløsning ved at afrunde 2D-kanter."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Kan rette nogle problemer med XBOX-controllere."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Kan forbedre nøjagtigheden for en lille ydeevneomkostning."

msgctxt "game_options"
msgid "Can improve framerate or cause timing error."
msgstr "Kan forbedre billedhastigheden eller give timingfejl."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Kan forbedre ydeevnen på kraftigere GPU'er med ledig kapacitet. Virker kun med Vulkan-rendereren."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Kan øge ydeevnen på nogle svagere systemer."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Kan øge ydeevnen ved brug af en kraftig GPU."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Kan kun bruges, hvis controlleren understøtter bevægelsesstyring."

msgctxt "game_options"
msgid "Can reduce input latency, but will inscrease CPU requirements."
msgstr "Kan reducere inputforsinkelsen, men øger kravene til CPU'en."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Kan mindske hakken under shader-kompilering, men kan også give artefakter."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Kan reducere forsinkelsen eller fjerne den nederste linje på wii på bekostning af grafiske fejl."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Begræns billedhastigheden til de originale 35 fps."

msgctxt "game_options"
msgid "Certain games require an external cartridge to run."
msgstr "Visse spil kræver et eksternt modul for at køre."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Skift D-pad-styring mellem joystick og mus."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Skift billedformat for den nederste skærm."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "Skift billedformat for den øverste skærm."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Skift sti for udpakkede spil (standard er »\roms\.uncompressed«)."

msgctxt "game_options"
msgid "Change the emulated audio chip model."
msgstr "Skift den emulerede lydchipmodel."

msgctxt "game_options"
msgid "Change the renderer used by the core."
msgstr "Skift den renderer, kernen bruger."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Skift den renderer, kernen bruger. Pistolspil virker kun med SOFTWARE."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Skift følsomheden for det analoge stik."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Skift musens følsomhed."

msgctxt "game_options"
msgid "Change this only if multiple GPU are used by your system."
msgstr "Skift kun dette, hvis dit system bruger flere GPU'er."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Skift denne indstilling efter spillets styring; til venstre for /-tegnet er spillets originale knap til speeder og bremse, til højre for gear."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Skift denne indstilling efter spillets styring."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Skift denne indstilling ved ustabile spil. Jo højere værdi, desto bedre stabilitet kan den give. 200μs og 400μs er generelt gode til de fleste spil."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Ændrer, hvordan emulatorens tråde fordeles på CPU-kerner. RPCS3-planlæggerne kan hjælpe på CPU'er med flere CCX/CCD-klynger eller med SMT, men Operativsystem er det sikreste på de fleste maskiner."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Ændrer, hvordan pistolerne vises i Rambo."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Ændrer lydchippen, TMSS-startskærmen og et par hardwareegenskaber."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Tegngeneratorchip. Automatisk vælger den, der passer til den valgte maskine."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "Snydekoder skal placeres i mappen \bios\pcsx2\cheats."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "Snydekoder skal placeres i mappen »cheats\mame«."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "Snydekoder skal placeres i mappen »cheats\psxmame«."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Kontrollér hver ROM mod spildatabasen. Slå kun fra for at teste et romsæt, der ikke kan indlæses: forkerte ROM'er kan gå ned eller ødelægge gemmefiler. Til som standard."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Kontrollerer for beskadigede filer ved opstart af et spil."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Chipsæt, der bruges, når en AGA-model er valgt. Sænk det kun under AGA for at teste et spil, der opfører sig forkert på en A1200."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Vælg »Trojan Phazer« til spil skrevet til den pistol. »Lyspen« passer til alt andet, også tegneprogrammer."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "Vælg en MSX-udvidelse, der skal tilføjes til den anden modulplads."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Vælg mellem engelsk, fransk eller spansk tastaturlayout."

msgctxt "game_options"
msgid "Choose between various texture enhancement filters."
msgstr "Vælg mellem forskellige teksturforbedringsfiltre."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Vælg knap til at aktivere IR på højre stik."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Vælg knap til at simulere svinghandling med højre stik."

msgctxt "game_options"
msgid "Choose if the mouse input is active or not."
msgstr "Vælg, om museinput er aktivt eller ej."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Vælg, om hotkey'en til skærmskift bytter skærmene permanent eller kun, mens knappen holdes nede."

msgctxt "game_options"
msgid "Choose the audio driver compatible with the hardware."
msgstr "Vælg den lyddriver, der er kompatibel med hardwaren."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Vælg farvepaletten."

msgctxt "game_options"
msgid "Choose the disposition of the emulated screens."
msgstr "Vælg placeringen af de emulerede skærme."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Vælg den udvidelse, der er tilsluttet controlleren."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Vælg den anden placering af de emulerede skærme."

msgctxt "game_options"
msgid "Choose which Atari system to emulate."
msgstr "Vælg, hvilket Atari-system der skal emuleres."

msgctxt "game_options"
msgid "Choose which color palette is going to be used"
msgstr "Vælg, hvilken farvepalet der skal bruges"

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Vælg, hvilken farvepalet der skal bruges."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Vælg, hvilket drev Diskstyring-menuen arbejder på. De andre drev forbliver monteret. Indlæste medier bruger det drev, spillet blev indlæst i."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "Klassisk bruger højre og venstre skulderknap til kraftigt spark og slag, moderne bruger højre skulderknap og højre aftrækker."

msgctxt "game_options"
msgid "Cleans up stray black pixels."
msgstr "Fjerner vildfarne sorte pixels."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Farvepalet til originale Game Boy-spil."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Farvetemperatur for arkadeskærmen."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Farver til WonderSwan-spil (mono). WS-paletterne efterligner de originale skærme."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "Indstil afstanden mellem de to skærme i pixels."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "Indstil synsfeltet (højere er bredere)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Indstil fps."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Indstil denne, hvis du vil skifte mellem stereo og surroundlyd."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Indstiller, hvordan controllere anmodes fra vært eller klient. Afgørende for lokal multiplayer-forbindelse."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Tilslut mus til port 1."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Konsolvariant, der passer til det valgte BIOS-billede."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "Styr nøjagtigheden af GS-blandingsenheden. Højere værdier emulerer blanding mere præcist i shaderen."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Styr emuleringens trilineære teksturfiltrering."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Styrer, hvordan dithering anvendes."

msgctxt "game_options"
msgid "Controls the number of Auto-CRC fixes and hacks applied to games."
msgstr "Styrer antallet af Auto-CRC-rettelser og hacks, der anvendes på spil."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Styrer detaljeringsgraden, før programmet vises."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Konvertér gear op/ned til gear3/gear4 for simulering af sekventielt gearskifte med en almindelig gearstang."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Kopiér teksturer til VRAM, langsommere men mere præcist. Deaktivér for at spare ydeevne."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Kopiér farvebufferen til N64-hukommelsen. Nødvendig for visse effekter (f.eks. pauseskærme, kamerabilleder). FRA er hurtigst, men kan ødelægge dem. AUTO følger YDEEVNETILSTAND."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Korrekt, men langsommere."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Korrigér billedformatet for ikke-kvadratiske pixels."

msgctxt "game_options"
msgid "Correct the sampling of 2D sprite textures when upscaling."
msgstr "Korrigér samplingen af 2D-sprite-teksturer ved opskalering."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Beskær det potentielt tilfældige, fejlbehæftede videosignal, som ville være skjult af rammen omkring kanten af en almindelig SD-tv-skærm."

msgctxt "game_options"
msgid "Crop out the potentially video output that would have been hidden by the bezel."
msgstr "Beskær det videosignal, som ville være skjult af rammen."

msgctxt "game_options"
msgid "Crop pixels around edge of screen."
msgstr "Beskær pixels rundt om skærmens kant."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "Beskær billedet fra dets native format til 4:3 eller 16:9"

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "Beskærer kanterne for at vise eller skjule kantgrafik."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "Beskærer billedet fra 256x240 til 252x239."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Grænsefrekvens for konsollens lydudgangsfilter. 3390 Hz svarer til de fleste Mega Drive-modeller."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "Skærer 8 pixels af kanterne for at fjerne Master System-kanterne."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "Størrelse på DIMM-kortet. Auto følger spillet; lad stå på Auto, medmindre et spil klager."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Dæmper følgekameraets svingninger i racerspil. Kraftig som standard."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Mørkner hver anden linje for at efterligne et katodestrålerør."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "DeSmuME har en intern BIOS; vælg denne indstilling for at bruge BIOS og firmware fra RetroBats bios-mappe."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Sænk, hvis den er for følsom; sænkes den for meget, kan det forhindre fuldt udslag."

msgctxt "game_options"
msgid "Default ON."
msgstr "Standard TIL."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "Den emulerede standard-pad er en pad med 6 knapper."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Aktiveret som standard, kan give problemer i nogle få spil."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Standard følger EmulationStations sprog."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "Standard er »HØJ«; sæt til »NORMAL« for at øge ydeevnen på bekostning af nøjagtigheden."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "Standard er 30 sekunder; angiv, hvor længe der skal ventes på, at spillet starter, før der vendes tilbage til RetroBats spilliste."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "Standard er FRA; brug dette ved hastighedsproblemer på skærme med høj opdateringshastighed."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Standard er TIL (hurtig). FRA kører de rigtige geometri-DSP-programmer, mere præcist men langsommere (kun spil til Model 1 og Model 2 2B)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Standard er TIL, korrekt quad-rendering. FRA renderer quads som trekanter (hurtigere)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Standard er TIL; FRA kan rette kompatibiliteten med ældre GPU'er (kun Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "Standard er TIL; brug denne indstilling til at fjerne 60hz-grænsen, kan ødelægge spil."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Standard er til; deaktivér for at vise startanimationen."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Standard er 10 bit til DS og 16 bit til DSi."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Standard er Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "Standard er WIIU Gamepad; skift dette for spil, der ikke accepterer WIIU Gamepad i multiplayer."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Standard: markør skjult."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Standard: aktiveret."

msgctxt "game_options"
msgid "Default: low."
msgstr "Standard: lav."

msgctxt "game_options"
msgid "Default: true"
msgstr "Standard: sand"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Standard er 60, når den sættes til 0 og VSYNC er aktiveret."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Angiv den BIOS, der skal bruges til emuleringen."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "Angiv gamepad-type, gælder for begge spillere."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "Angiv PET-computermodel."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "Angiv den Symbian-enhed, der skal køres."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Angiv knap til at vise Gamepad-skærmen, standard hvis ingen."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Angiv, hvor meget RAM den emulerede maskine skal have."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Angiv, hvordan markøren skal vises på den nederste skærm."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Angiv, hvordan spillet tilpasses eller skaleres i vinduet."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Angiv, hvordan Sinden-pistolen konfigureres."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Angiv, hvordan GunCons A- og B-knapper tildeles (Start og Back på Justifier). Standard: D-pad højre/venstre med en DolphinBar-Wiimote, museknapper med andre pistoler."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "Angiv, hvordan guncon2-knapperne tildeles."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Angiv, hvordan touchskærmen emuleres."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Angiv, hvordan din wiimote er forbundet til DolphinBar."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Angiv, om patch skal anvendes, og hvor patchfilerne ligger; »AUTO« anvender patches, hvis de ligger ved siden af rom'en med samme navn som rom-filen."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Angiv tildeling af museknapper (venstre/højre/midterste); standard er a/genlad/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "Angiv modeltype og region."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Angiv model, standard er BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Angiv model, standard er CPC 6128+ til GX4000."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "Angiv model, standard er Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Angiv det museindeks, spiller 1 skal bruge."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "Angiv det museindeks, spiller 2 skal bruge."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Angiv det museindeks, spiller 3 skal bruge."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Angiv det museindeks, spiller 4 skal bruge."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Angiv sti til en brugerdefineret controls.ini-fil."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "Angiv region, bruges til gemmefiler."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Angiv den knapkombination, der skal holdes nede for at skifte dualshock-controlleren mellem analog og digital tilstand."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Angiv farvepaletten; Gammel NTSC genskaber de gamle, grimme farver fra japanske tv."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "Angiv den tilsluttede enhed, der emulerer en drejeknap."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Angiv den tilsluttede enhed, der emulerer en pedal."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "Angiv den tilsluttede enhed, der emulerer en positionsenhed."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "Angiv den tilsluttede enhed, der emulerer en trackball."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "Angiv den tilsluttede enhed, der emulerer en lyspistol."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Angiv den tilsluttede enhed, der emulerer en mus."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "Angiv den tilsluttede enhed, der emulerer en paddle."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Angiv den tilsluttede enhed, der emulerer et analogt retningsstik."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Angiv den emulerede joysticktype."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Angiv den emulerede maskintype."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "Angiv højre joysticks funktion."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "Angiv tastekombinationen til at åbne diagnosemenuen."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Angiv niveauet for vibration og skærmrysten; aktivér skærmrysten, hvis controlleren ikke understøtter vibration. »AUTO« aktiverer begge."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Angiv placeringen af det våben, der holdes."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Angiv tildelingen af D-PAD'en."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Angiv antallet af hukommelseskort, der skal emuleres."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Angiv antallet af pixels, der skal beskæres."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Angiv den lyd, den emulerede mikrofon modtager."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "Angiv den type enhed, der bruges til markørbevægelse."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Angiv skærmtypen, ændrer farverne."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Angiv typen af emuleret controller."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "Angiv typen af sigtekorn for pistoler."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Angiv, hvor mønt- og startknapperne sidder."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Angiv, om genvejen til »spol frem« fungerer som til/fra eller skal holdes nede."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Angiv, om genvejen til »slowmotion« fungerer som til/fra eller skal holdes nede."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Angiv, hvilken Game Boy-lyd systemet sender ud."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Angiv, hvilket analogt stik der styrer musemarkøren."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "Angiv, hvilken knap der aktiverer turbotilstand; det er ikke den knap, der får turbo."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Rattets drejning i grader, der giver fuldt udslag i spillet. 270 svarer til arkadekabinettet."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Afvis skrivninger, når optaget."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "Afhængigt af konfigurationen kan forsinkelsen øges eller mindskes."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Enhed tilsluttet Apple II's spilport. Det analoge stik giver gradvis paddlebevægelse, D-pad'en går kun helt til venstre eller højre."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Enhedstype for spiller 2."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Kun DirectInput: brug det, hvis controllerne ikke styrer de rigtige spillere."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Deaktivér kontrol af XBE-signatur ved brug af homebrew-spil."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Deaktivér Xenia Edges indstillinger pr. spil, så RetroBats indstillinger gælder."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Deaktivér kernens sikkerhedsfunktioner, så nogle homebrew-spil kan starte."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Deaktivér dithering og brug den fulde farveinformation på 8 bit pr. kanal."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Deaktivér tågeeffekter."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Deaktivér hardware-rendereren, kan øge kompatibiliteten."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Deaktivér tastaturgenveje og giv kernen fuld adgang til tastaturet. Skift med tasten »Scroll Lock«."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Deaktivér modifier volumes, der bruges til at rendere skygger."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "Deaktivering af pixel-shaders kan rette nedbrud i nogle spil; aktivér kun, hvis spillet har brug for det."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Deaktivér Master Systems FM-chip."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Deaktivér Visual Pinball-menuen: afslut-tasten (X) lukker bordet direkte."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Deaktivér den analoge plunger (højre stik) og det analoge skub (venstre stik)."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Deaktivér kontrollen af kabinetkameraet."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "Deaktivér kontrollen af artwork i mappen »saves\mame\artwork«."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "Deaktivér den controller-applet, der vises i multiplayer-spil for at vælge de tilsluttede controllere."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Deaktivér menuen i spillet, der åbnes med HOTKEY + ØST eller F12."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Deaktivér denne indstilling for at centrere IR-markøren, når stikket slippes."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Deaktivér denne indstilling for at forbedre ydeevnen."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Deaktivér denne indstilling for at køre en .bat- eller .cmd-fil direkte, uden at RetroBat forsøger at finde programmet i den."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Deaktivér for at tildele R2 og L2 til L- og R-knapperne (ikke-digitale)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Deaktivér brug af X-aksen til skub, Y-aksen til lod og Z-aksen til plunger."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Deaktivér advarslen ved kørsel af spil, der ikke er fuldt understøttede."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Deaktiverer joypad-vibration; som standard er vibration kun aktiv, når spil og controller er kompatible."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Deaktiverer de automatiske indstillinger pr. spil fra kernens database og aktiverer de manuelle rettelser nedenfor. Anbefales ikke."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Deaktiverer bevægelsesinterpolationen, ét billede mindre forsinkelse."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Deaktiverer vertex-cachen. Kan løse manglende eller flimrende grafik. Kan forringe ydeevnen."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "Deaktivering af dithering kan fjerne noget støj og pixeleffekter."

msgctxt "game_options"
msgid "Disabling safe features can help various games such as Xenosaga, Kingdom Hearts..."
msgstr "Deaktivering af sikkerhedsfunktioner kan hjælpe forskellige spil som Xenosaga, Kingdom Hearts..."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "Det kan være nødvendigt at deaktivere 4MB-udvidelsespakken for nogle spil."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Deaktivering af denne funktion reducerer farvedybden."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "Vis MAME-menuen, når et spil indlæses."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "Vis SGB-rammer ved emulering af Super Game Boy."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Vis en besked, når en præstation låses op. Aktiveret som standard."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Vis en lille markør på touchskærmen."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Vis en erfaringsbjælke over bæltet."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Visningsformat for LaserActive-billedet, 4:3 som standard."

msgctxt "game_options"
msgid "Display crosshair if a lightgun is used."
msgstr "Vis sigtekorn, hvis der bruges en lyspistol."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Vis aktuelle liv- og manaværdier på kuglerne."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Vis skade og erfaring som flydende tal."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Vis banetid, fundne hemmeligheder og dræbte fjender."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Visning af den anden skærm (touchskærm) i Primeval Hunt."

msgctxt "game_options"
msgid "Display or not on-screen notifications."
msgstr "Vis eller skjul notifikationer på skærmen."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Vis skærmens kantområder. Har ingen effekt på F18A-udgangen."

msgctxt "game_options"
msgid "Display the emulated framebuffer at a widescreen aspect ratio. Get best results with full 3D games."
msgstr "Vis den emulerede framebuffer i widescreen-format. Bedste resultat med rene 3D-spil."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Vis spillet i 16:9. Bedst med SPILLETS BILLEDFORMAT sat til 16/9."

msgctxt "game_options"
msgid "Display the overscan regions of the screen."
msgstr "Vis skærmens overscan-områder."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Vis skærmen fra spiller 1's VMU over spillet."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Skærm, der bruges ved opstart. Kan skiftes i spillet med F7-tasten (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Vis voxel-objekter i stedet for flade sprites, når de findes. Aktiveret som standard."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Dither supersamplede framebuffer-effekter."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Dithering anvendt på RDRAM-framebufferbilleder."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Dividerer den interne opløsning: med en høj intern opløsning gør højere værdier spillet større. Standard: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 er et meget mørkt spil; øg for at gøre billedet lysere."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Fordobler den oplevede vandrette opløsning, ikke kompatibel med supersampling."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Nedskalér det opskalerede billede (SSAA). Kræver opskalering."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Tegn landskabet helt til banens ende i de spil, der understøtter det (Daytona USA). Kun Model 1 og Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Drev, der bruges ved diskskift."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dobbelt stik: Robotron 2084 og Space Dungeon på højre stik. Byt porte: Wizard of Wor, Apple Panic. Joy 2B+: joysticks med flere knapper."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Duplikering af billeder kræver Vulkan-rendereren."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Dynamisk rekompilering. De fleste spil kører hurtigere, nogle langsommere."

msgctxt "game_options"
msgid "Efficient graphics filters improving the rendering of games."
msgstr "Effektive grafikfiltre, der forbedrer renderingen af spil."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Fjerner forvrængning og vridning af teksturer ved opskalering."

msgctxt "game_options"
msgid "Eliminates position-dependent distortion and warping of textures."
msgstr "Fjerner positionsafhængig forvrængning og vridning af teksturer."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Emulér Buzz!-svarknapper oven på dine gamepads. Én controller dækker 4 svarknapper (spiller 1-4), to controllere dækker 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Emulér PS3-hukommelsestiling. Retter grafiske fejl i nogle spil for en lille ydeevneomkostning."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Emulér stemmegenkendelsesenheden (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Emulér en DJ Hero-pladespiller oven på dine gamepads. Kræves til DJ Hero 1 og 2."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Emulér en Guitar Hero Live-controller (GHLtar) oven på dine gamepads. Kræves til Guitar Hero Live."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Emulér en New 3DS eller en original 3DS."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Emulér et PlayStation TV til lokal multiplayer (op til 4 controllere). Identiske controllere understøttes ikke, og spil med touchskærm virker muligvis ikke."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Emulér en bestemt bevægelsesstyring. »/« betyder handlingen for venstre/højre stik."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Emulér en spinner-controller, styret af musens bevægelse. Museknapperne tildeles venstre (gul) og højre (rød) knap."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Emulér NTSC's vblank-frekvens på 59,94Hz i stedet for 60Hz. Retter timing og lydforskydning i nogle NTSC-spil."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Emulér tilbehøret Disney Infinity base."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Emulér Game Boy Player for at aktivere vibration i kompatible spil."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Emulér tilbehøret LEGO Dimensions toypad."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Emulér tilbehøret Skylanders portal."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Emulér Video CD-kortet, kræver mpeg_card.bin i bios-mappen."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emulér ældre motorers adfærd, kræves af nogle ældre mods og demoer."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Tidsskive for emulerede tråde. At hæve den kan hjælpe nogle få spil, at sænke den kan gøre andre mere flydende."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Emulerer LCD-gennemskinnelighedseffekter, men øger bevægelsessløringen."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Emulerer PS3's multisampling-layout. Kan rette visse visuelle artefakter i nogle spil."

msgctxt "game_options"
msgid "Emulation method used. AUTO for mixed features with max performance and compatibility."
msgstr "Anvendt emuleringsmetode. AUTO for blandede funktioner med maksimal ydeevne og kompatibilitet."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Emulatorens scanlines, kun synlige i nogle spil."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Aktivér 32MB RAM-mod til dreamcast, kan påvirke kompatibiliteten."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "Aktivér start i BIOS for DSI-spil."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Aktivér CMS-emulering."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Aktivér den digitale signalprocessor. Forbedrer lydens nøjagtighed på bekostning af højere krav til ydeevnen."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Aktivér den digitale signalprocessor. Forbedrer lydens nøjagtighed på bekostning af ydeevnen."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Aktivér tjenesten Discord Rich Presence, der opdaterer Discord-status med det spil, der spilles."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Aktivér Dolby Pro Logic II-dekoderen i kompatible spil og 5.1-højttalere."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Aktivér FidelityFX kontrastadaptiv skærpning."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Aktivér flydende kommatalsenheden, ofte nyttig til senere 3D-spil."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Aktivér Gravis Ultrasound-emulering."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "Aktivér HDR på HDR-kompatible skærme."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Aktivér IBM PS/1 Audio-emulering (deaktiveret som standard)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Aktivér Just In Time-emulering, øger emuleringshastigheden, ikke kompatibel med cykluspræcis."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "Aktivér MAMEs interne omtildeling af styringen."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "Aktivér MAME-indstillingen, der automatisk konfigurerer knaplayoutet pr. spil ud fra dens interne database."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "Aktivér MelonDS' emulerede bios i stedet for firmwaren i bios-mappen."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "Aktivér OpenGL-rendereren; RetroArch-driveren skal være sat til OpenGL."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "Aktivér PAL-emulering (50Hz) af NES."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Aktivér Sega CD RAM-modulet."

msgctxt "game_options"
msgid "Enable Service button to enter settings."
msgstr "Aktivér serviceknappen til at åbne indstillingerne."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Aktivér Tandy Sound-emulering."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Aktivér ekstra udvikler-RAM, kan ødelægge spil."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Aktivér anti-aliasing, udglatter polygonkanter."

msgctxt "game_options"
msgid "Enable blargg NTSC video filters"
msgstr "Aktivér blargg NTSC-videofiltre"

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Aktivér brute force op-/nedskalering (kun 10.8.0)"

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Aktivér cache-montering"

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "Aktivér skygger fra objekter i spillet, kun kompatibel med OpenGL."

msgctxt "game_options"
msgid "Enable certain games with support for the 3Dfx Voodoo accelerator."
msgstr "Aktivér visse spil med understøttelse af 3Dfx Voodoo-acceleratoren."

msgctxt "game_options"
msgid "Enable colorization of Game Boy games."
msgstr "Aktivér farvelægning af Game Boy-spil."

msgctxt "game_options"
msgid "Enable controller's rumble effects."
msgstr "Aktivér controllerens vibrationseffekter."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Aktivér controllerens vibrationseffekter. Virker kun i racerspil."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Aktivér sigtekorn i skydespil; indstillinger med (DS) er kun kompatible med DemulShooter."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Aktivér sigtekorn i skydespil."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Aktivér brugerdefineret opløsning baseret på videotilstand."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Aktivér dynamiske rekompilatorer, som hjælper med at forbedre ydeevnen."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Aktivér udvidede funktioner til DS4 og DualSense; dette ødelægger kompatibiliteten med emulatorer, der bruger dinput, indtil det slås fra."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Aktivér force feedback for understøttede controllere."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Aktivér fuldskærms-anti-aliasing i Direct3D, udglatter polygonkanter."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Aktivér filter for vandret blanding (sløring)."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Aktivér, hvis rattet skubbes væk fra midten i stedet for mod den."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Aktivér sigtekorn i spillet for at lette sigtningen."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Aktivér intelligent zoomfunktion."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Aktivér ips-patches."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "Aktivér mindre præcis, men bedre lydende Namco 106-lydemulering (mapper 19)."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Aktivér de manuelle hacks nedenfor, ellers anvendes hacks automatisk."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Aktivér bevægelsesstyring (gyro) enten med mus eller med kompatibel controller."

msgctxt "game_options"
msgid "Enable multitap in port 1."
msgstr "Aktivér multitap i port 1."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Aktivér multitap i port 2."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Aktivér progressiv scanning for kompatible spil."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Aktivér run-ahead-tilstand for at mindske inputforsinkelsen."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Aktivér IBM Music Feature Card (deaktiveret som standard)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "Aktivér Master Systems FM-chip."

msgctxt "game_options"
msgid "Enable the Memory Management Unit. Required for some games."
msgstr "Aktivér hukommelsesstyringsenheden. Kræves af nogle spil."

msgctxt "game_options"
msgid "Enable the On Screen Keyboard feature which can be activated with the L3 button."
msgstr "Aktivér skærmtastaturet, som kan aktiveres med L3-knappen."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Aktivér effekterne af de snydekoder, der er aktiveret i Vita3K-brugerfladen."

msgctxt "game_options"
msgid "Enable the effects of the chosen Action Replay and Gecko codes for a game."
msgstr "Aktivér effekterne af de valgte Action Replay- og Gecko-koder for et spil."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Aktivér emulering af Jaguar-joypads tilsluttet de udvidede joystickporte på Atari STE."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Brug musen til touchskærmen i stedet for højre stik."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Aktivér dette, hvis XInput-controllernes indeks er byttet om."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Aktivér dette, hvis controlleren ikke har analoge aftrækkere."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Aktivér dette, hvis du har en gsync/freesync-skærm, kan give lydfejl."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Aktivér denne indstilling ved problemer med en Intel-grafikchip."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Aktivér denne indstilling, hvis der mangler grafik eller belysningen er forkert i spillet."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Aktivér denne indstilling ved brug af mamehooker med LED'er, solenoider, vibration..."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Aktivér dette for at aktivere shaders, selv når RetroBat ikke har valgt noget shader-sæt."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Aktivér dette for at sætte spiller 1's joystick i venstre port i stedet for højre."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Aktivér dette for at bruge de shaders, Duckstation leverer."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Aktivér dette for at bruge dine egne Project64-indstillinger pr. spil."

msgctxt "game_options"
msgid "Enable verbose mode for debugging."
msgstr "Aktivér detaljeret tilstand til fejlfinding."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Aktiveret som standard (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Aktiveret som standard, forbedrer dataoverførslen på den emulerede SIO-port."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Aktiveret som standard."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Aktiveret som standard. Deaktiverer dithering og tvinger 24-bit farveudgang."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Aktiveret som standard. Deaktivering kan forbedre ydeevnen, men ødelægger nogle spil."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Aktiveret som standard. Hurtigere shaders, kan give sjældne grafiske problemer."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Aktiveret som standard. Retter grafiske fejl i nogle spil for en lille ydeevneomkostning."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Aktiveret som standard. Fjerner sløring i nogle spil, men reducerer nøjagtigheden."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Aktiveret som standard. Erstatter spillets sprites med en HD-pakke, når en sådan findes. Genstart kræves."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Aktiveret som standard. Vis beskeder fra selve emulatoren."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Aktiveret som standard. Når den er deaktiveret, begrænses billedhastigheden til 60 FPS."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Aktiveret som standard. Når den er deaktiveret, begrænses billedhastigheden af spillet."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Aktiverer 60HZ-tilstand for at mindske tearing på skærme, der ikke kan køre over 60HZ."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Aktiverer automatisk mipmap-generering i Direct3D."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Aktiverer WRX høj opløsning."

msgctxt "game_options"
msgid "Enables a low pass audio filter to soften the harsh sound of some games."
msgstr "Aktiverer et lavpas-lydfilter, der blødgør den skarpe lyd i nogle spil."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Aktiverer anti-slørings-hack, mindre præcist, men gør spillene mindre slørede."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Lader pile-, CTRL- og ALT-tasterne fungere som joystick og skydeknapper."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Aktiverer funktion til brugerdefinerede patches."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Aktiverer CEL-rendering i høj opløsning."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Giver mulighed for at skifte mellem forskellige videosignaler."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Aktivering kan give problemer med 8BitDo-controllere."

msgctxt "game_options"
msgid "Enabling this will downsampling to native color depth. Disabling enable output at higher color depth."
msgstr "Aktivering nedsampler til den native farvedybde. Deaktivering giver udgang med højere farvedybde."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Håndhæver nøje overholdelse af API-specifikationen. Kan give lavere ydeevne i nogle spil. Kan løse sjældne tilfælde af manglende grafik og flimmer."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Forbedr grafikkens nøjagtighed på bekostning af højere krav til ydeevnen."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "Forbedr skyggerne på de forskellige objekter."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "Forbedr kvaliteten af 2D-teksturer."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface."
msgstr "Forbedr kvaliteten af teksturer på overflader."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Forbedr kvaliteten af teksturer på overflader. Kun OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Forbedr kvaliteten af teksturer på overflader. Kun Vulkan og OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Forbedringsfilter anvendt på teksturer."

msgctxt "game_options"
msgid "Enhancement. Reduces system slowdown. Causes issues in some games."
msgstr "Forbedring. Mindsker systemets langsommelighed. Giver problemer i nogle spil."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Angiv den lokale UDP-port, der skal bruges som vært."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Angiv serveradresse."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Angiv de første tegn i den spil-rom, der bruges til at overføre data."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Angiv de første tegn i den gemmefil, der bruges til at overføre data."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Angiv den touchprofil, der skal indlæses."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Rumklang fra omgivelserne (EFX), aktiveret som standard."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Eksakt er tættest på konsollen og den tungeste for GPU'en. Hurtig er meget lettere. Auto vælger hurtig på svage eller ustabile GPU'er."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "Kører grafik-backend'en i en anden tråd, forbedrer ydeevnen, mindsker hakken og gør shader-kompilering hurtigere."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Udvid SAMS-hukommelseskortet til 4M."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Udvidelsesmodul isat i konsollen. Spil med et kendt krav tilsidesætter dette automatisk."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Eksperimentér med denne indstilling, hvis dit joystick driver (aktiveret som standard)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Eksperimentel, kun Windows. Beskytter spillets stakdata, når emulatoren håndterer hukommelsesundtagelser. Kan rette nedbrud i nogle spil. Lad være slået fra, medmindre et spil kræver det."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Ekstra controller. Lad stå tom, medmindre spillet beder om en."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Ekstra hukommelseskort, kun //e-modeller. Nogle få programmer kræver mere end de indbyggede 64KB."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "FM Towns-musens følsomhed."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Hurtig tilnærmet anti-aliasing, billigere end MSAA, men mere sløret."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Hurtig kan forbedre ydeevnen, men kan være ustabil med nogle drivere."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "ROM til hurtig diskindlæsning. Kræver FULD DREVEMULERING og JiffyDOS-ROM'erne i »bios\vice«. Bruges ikke med bånd og moduler."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Hurtig er mindre præcis, ordnet og atomisk er præcis, men langsommere."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Hurtigere DSP-emuleringsmotor (eksperimentel). Bruges kun, når DSP-EMULERING er aktiveret."

msgctxt "game_options"
msgid "Faster loading times but can cause issues with some games."
msgstr "Hurtigere indlæsning, men kan give problemer i nogle spil."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Hurtigere sektorlæsning. Noget software forventer det muligvis ikke."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Filtrér alle teksturer, også dem spillet udtrykkeligt sætter som ufiltrerede. Deaktiveret som standard."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Filter anvendt på det endelige billede."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Filter, der bruges til at skalere billedet til skærmen."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Filter, der bruges ved skalering af det endelige billede."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Filter, der bruges, når det renderede billede er større end skærmen."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Filter, der bruges, når det renderede billede er mindre end skærmen."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Filtrering anvendt på 3D-teksturer."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Filtrering anvendt på 3D-teksturer. Kun OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Filtrering anvendt på sprites og 2D-elementer."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Skyd uafbrudt, så længe knappen holdes nede."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Aktivér pistolens rekylmotor ved hvert skud, for pistoler der har en. Til som standard."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Tilpas spil i høj opløsning eller widescreen til en 640x480-ramme med sorte kanter. Kun nyttigt på et 4:3 CRT-TV."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Isæt Digital Video Cartridge (vmpega.rom i bios-mappen), kræves af FMV-spil og Video CD'er."

msgctxt "game_options"
msgid "Fit to the original ratio of the game."
msgstr "Tilpas til spillets originale format."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Ret Demul-fejl (afslutter fuldskærm ved skud i øverste venstre hjørne) ved at blokere alle museinput til Demuls brugerflade."

msgctxt "game_options"
msgid "Fix issues with upscaling in Namco games (Ace Combat, Tekken, SoulCalibur...)."
msgstr "Ret problemer med opskalering i Namco-spil (Ace Combat, Tekken, SoulCalibur...)."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Ret langsommelighed med denne emulator."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Ret ødelagte teksturer og dybdeproblemer på AMD og nogle Intel-GPU'er."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Ret farvebånd, der kan opstå i opskalerede teksturer."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Ret, at spillet sidder fast i en løkke ved opstart."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Retter koplanar geometri og decals i nogle spil, kan ødelægge andre."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Retter mellemrum mellem 2D-elementer."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Retter skygge- og dybdeartefakter i nogle spil."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Retter nogle grafiske fejl med linjer."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Retter tekstfejl i nogle spil."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Flydende kommatalsenhed, kræves af nogle 3D-spil. Til som standard med 68040 (indbygget), fra med 68030."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Mappe til Vita3K-data (firmware, installerede spil, gemmefiler). Ignoreres, når Vita3K er i bærbar tilstand (ikke-tom »portable«-mappe ved siden af Vita3K.exe)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "Skrifttype-ROM, som nogle japanske spil kræver."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "Til Bleach Blade Battlers."

msgctxt "game_options"
msgid "For Goemon."
msgstr "Til Goemon."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "For Nintendo-systemer: byt A og B for at matche Xbox-knapnavne."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "Til Run Behind- og M-bit-spil."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "Til SOCOM 2 HUD/Spy Hunter."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "Til Scarface The World is Yours og Crash Tag Team Racing."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "Til SegaScope 3-D-spil: vis kun ét øje i stedet for det flimrende par."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "Til Superman Returns."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "Til Tales of Destiny."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "Til Tri-Ace-spil."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "Til spil med ASTC-teksturer: skift til middel med en GPU med 6GB VRAM og til lav med en GPU med 4GB-2GB VRAM."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "For n64-controllere med 2 aftrækkere: brug R2 i stedet for L2 som Z-knap."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "Af nostalgi. Som standard ligner det den accelererede krigens tåge i BG2"

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "I nogle emulatorer kan dette bruges til at rette tilknytningen af wiimote-tastatur og -mus ved brug af 2 wiimotes."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Tving GBC-software, der opfører sig anderledes på GBA."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "Tving GameBoy-tilstand for GameBoy Color."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Tving P1's padindeks, kan være nyttigt, hvis XInput-enheder ikke er i den rigtige rækkefølge."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "Tving P1's padindeks, kan være nyttigt ved brug af en controller på en arkademaskine."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "Tving P2's padindeks, kan være nyttigt ved brug af en controller på en arkademaskine."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Tving Rawinput; det burde ikke være nødvendigt at tvinge dette TIL."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Tving et antal CPU-cyklusser pr. operation. AUTO bruger standarden pr. spil; skift kun, hvis et spil ikke virker."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Tving knap i stedet for akse til aftrækkere, kan hjælpe med Sony-controllere."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Tving emulatoren i fuldskærm, selv hvis RetroBat kører i vindue"

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Tving billedbegrænser."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Tving, hvordan teksturer samples. Nærmeste nabo holder pixels skarpe, lineær udglatter dem."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Tving inputdriver. Standard er »sdl«, »dinput« hvis flere pistoler er aktiveret."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Tving opløsningen til den aktuelle skærmopløsning for spil, der tillader brugerdefineret opløsning."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Tving saturn-udvidelsesmodul, hvis den automatiske registrering mislykkes."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Tving saturn-region, hvis den automatiske registrering mislykkes."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Tving stereo på alle ROM'er."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Tving den Game Boy-model, der skal emuleres, hvis den automatiske registrering mislykkes."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Tving VI-opdateringshastigheden. AUTO er korrekt for næsten alle spil."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Tving det faktiske udgangskanallayout. LYDKANALER angiver, hvad spillet ser; dette afgør, hvordan det mixes ned til din enhed. Lad stå på AUTO, medmindre din udgangsenhed registreres forkert."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Tving backglass til eller fra. AUTO følger SKÆRMOPSÆTNING (aktiveret, når SKÆRMOPSÆTNING ikke er angivet)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Tving den bilineære filtreringstilstand, der bruges ved opskalering af dirty rectangles."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Tving opstartsenheden (kun 1F/2F og senere modeller)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "Tving konsolregionen."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Tving konsolregionen. Som standard registreres regionen ud fra spillet."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Tving den emulerede opdateringshastighed i stedet for at registrere den fra det indlæste spil. Kræver genstart af kernen."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Tving emulatoren til at bruge en bestemt BIOS-fil."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches."
msgstr "Tving frekvensen for den emulerede CPU. Kan mindske langsommelighed, men kan give fejl."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Tving frekvensen for den emulerede CPU. Kan mindske langsommelighed, men kan give fejl. Standard er 57%."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "Tving spilregionens frekvens for at undgå hastighedsproblemer i emuleringen; lad stå på »Auto«, medmindre du bemærker hastighedsproblemer."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Tving det tastatur, der skal bruges, hvis flere tastaturer er tilsluttet."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Tving memory bank controlleren. Skift kun, hvis et spil ikke kører korrekt. Kræver genstart af kernen."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Tving de monokrome visningstilstande som på en grøn eller ravfarvet skærm fra perioden."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Tving det antal Wiimotes, spillet registrerer. Sæt til 1 for spil, der skifter til multiplayer, så snart flere controllere er tilsluttet."

msgctxt "game_options"
msgid "Force the region of the system."
msgstr "Tving systemets region."

msgctxt "game_options"
msgid "Force the rendering and display of frames to progressive mode."
msgstr "Tving rendering og visning af billeder til progressiv tilstand."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "Tving medietypen"

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Tving brug af SDL-driveren til controllere; sæt dette, hvis der bruges mere end 4 controllere, da XInput er begrænset til 4 spillere."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Tving brug af SDL- eller DInput-driveren til controllere; sæt dette, hvis der bruges mere end 4 controllere, da XInput er begrænset til 4 spillere."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Tving brug af en bestemt softlist; softwarelisten skal ligge i mappen »bios\mame\hash«."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Tving brug af højniveau-BIOS-emulering."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Tving talemodul i plads 1, kræver bios-filen »voice.zip«."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "Tving ratindeks, kan være nyttigt, hvis RetroBat sætter et forkert indeks."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "Tvinger opdateringshastighed på 60Hz."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "Tvinger konsollen i PAL-tilstand i stedet for NTSC, kan føles træg."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Tvinger emulering af blit og billedbehandling på CPU'en, mere præcist i visse tilfælde og nødvendigt for spil som GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Tvinger raw input-driveren ved brug af enheder som trackball og spinnere."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Tvinger motorens kompatibilitetsniveau. Sæt til MBF21 for WAD'er, der kræver det."

msgctxt "game_options"
msgid "Full precision of 12-bit for the MCM5205 ADPCM can reduce whining noise during ADPCM playback."
msgstr "Fuld 12-bit præcision for MCM5205 ADPCM kan mindske hylende støj under ADPCM-afspilning."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Fuldskærmsopløsning. Som standard bruges skrivebordets opløsning."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Styr kameraet fuldt ud med højre stik."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "GST-tilstande kan åbnes af Kega og Gens, men gemmer mindre af maskinens tilstand."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Forstærkning af drivkortets kræfter. 30% som standard, 200% fordobler dem."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Spilopløsning. Højere værdier viser mere af spilområdet."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Gamepadens styreudslag i racerspil. 66% som standard, ingen effekt på et rat."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Gamepad: pad og tastatur flytter CD-i-markøren. Mus: pc-musen flytter markøren (peg-og-klik- og pistolspil), pad'en beholder kun sine knapper. Hotkey + L3 skifter under spillet."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Gamepads bliver spiller 1, 2... og arkadestik tildeles de næste spillere."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Generelt timing-hack."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "Tysk og fransk kræver en PAL-version af spillet, japansk en NTSC-version."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Giv hele tastaturet til spillet (Scroll Lock giver det tilbage til genvejene) og fang musen. Gamepad'en virker stadig."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Godt til problemer med cache-emulering."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Grafikchipsæt til ikke-AGA-modellerne. Automatisk følger den valgte model, hvilket næsten altid er det, du ønsker."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Grafik-plugin, der bruges til at rendere spillet."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Forudindstilling for grafikkvalitet (teksturer, filtrering). AUTO vælger den ud fra mængden af hukommelse."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Påvirker CPU-ydeevnen betydeligt."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Øger kvaliteten af teksturer genereret med render-to-texture-effekter betydeligt. Aktiveret som standard. Deaktivering kan undgå nedbrud i spil med brugerdefinerede teksturer."

msgctxt "game_options"
msgid "Greatly inscrease the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Øger kvaliteten af teksturer genereret med render-to-texture-effekter betydeligt. Aktiveret som standard. Deaktivering kan undgå nedbrud i spil med brugerdefinerede teksturer."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Pistolspil spillet med en controller (ingen lyspistol). Relativ: stikket flytter markøren. Absolut: stikkets position er positionen på skærmen, tilbage i midten når det slippes."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE er hurtig, LLE er mere præcis, men kræver DSP ROM-filerne."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START sender afslut-tasten (X) til Visual Pinball i stedet for at lukke vinduet."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START sender afslut-tasten (X) til Visual Pinball i stedet for at lukke vinduet: dens menu åbnes (bordet lukkes med DEAKTIVÉR MENU)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 hurtiggem, START+L3 hurtigindlæs, START+R3 skærmbillede. Aktiveret som standard."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Hack, som nogle spil kræver (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Hack, som nogle spil kræver."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Halve scanlines efterligner en CRT-skærm. 560 x 192 giver et renere billede på en fladskærm."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Harddiskcontroller, kræves for at køre harddiskbillederne .hdv og .2mg. Ændring genstarter maskinen."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Skjult som standard; deaktivér, hvis et spil ikke starter korrekt."

msgctxt "game_options"
msgid "Hide in-game crosshair (game dependant)."
msgstr "Skjul sigtekornet i spillet (afhænger af spillet)."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Skjul våbenmodellen i spillet (afhænger af spillet)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Skjul markøren på touchskærmen, når den er inaktiv (timeout)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Skjul tips om shader- og PPU-kompilering."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Skjul sigtekornet efter en pause uden sigtning eller skud. Det vender tilbage, så snart du sigter igen."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Skjul billedets kanter, som et TV gør, eller tilføj en kant (negative værdier)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Skjul det hvide glimt, der vises ved hvert skud."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Højniveau-emulering af nogle Portfolio OS-funktioner. Kan forbedre ydeevnen i nogle spil."

msgctxt "game_options"
msgid "High sound quality for games using expansion audio"
msgstr "Høj lydkvalitet til spil med udvidelseslyd"

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "Højere nøjagtighed retter fejl i nogle spil på bekostning af ydeevnen. Bruges kun, hvis SPU-DEKODER er sat til Dynamisk eller LLVM."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "Højere billedhastighed gennem billedinterpolation, begrænset af lodret synkronisering. Kan give mindre visuelle fejl eller animationsfejl."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "Højere er mere præcist, men langsommere."

msgctxt "game_options"
msgid "Higher values give better signal noise ratio and preservation of higher frequencies."
msgstr "Højere værdier giver bedre signal/støj-forhold og bevarer højere frekvenser."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "Højere værdier bruger mindre hukommelse, lavere værdier kører hurtigere."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Hastighedsrettelse til House of the Dead 4: CPU-frekvens i GHz (f.eks. 4.3). Registreres automatisk, hvis ikke angivet."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Hvor langt et stik skal bevæges, før Amigaen registrerer det. Hæv det, hvis figuren driver af sig selv."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Hvor hurtigt paddlen bevæger sig."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Hvor hurtigt paddlerne bevæger sig, når musen bruges som spilportenhed."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Hvor meget af skærmbredden, der fører paddlen fra yderpunkt til yderpunkt. En mindre værdi gør paddlen hurtigere og lader den nå sine stop uden at føre markøren ud af skærmen, hvilket nogle kalibreringsskærme kræver."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Hvor kraftigt stikket reagerer."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Hvordan TV-skærmen og GamePad-skærmen vises."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Hvordan pad'en præsenteres for Amigaen."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Hvordan pad'en præsenteres for Amigaen. »Joystick« er det klassiske 2-knaps stik, som alle spil forstår. »CD32-pad« tilføjer de farvede knapper og vælges automatisk på CD32."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Hvordan billedet renderes. RGB er skarpest, komposit- og TV-tilstandene genskaber farveudflydningen fra en skærm fra perioden."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Hvordan billedet renderes. Komposittilstandene genskaber farveudflydningen fra en skærm fra perioden, RGB er skarpest."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Hvordan billedet skaleres til skærmen."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Hybrid tegner nye shaders med det samme, mens de bygges. Asynkron kan få objekter til at mangle et øjeblik. Synkron får spillet til at vente på hver shader."

msgctxt "game_options"
msgid "If Custom is selected it will use MesenPalette.pal as custom palette in bios directory."
msgstr "Hvis Brugerdefineret vælges, bruges MesenPalette.pal i bios-mappen som brugerdefineret palet."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Hvis Fra, deaktiveres det dithering-mønster, PSX anvender mod farvebånd."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Hvis deaktiveret, kan DualShock skiftes mellem DIGITAL/ANALOG med en kombination."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Hvis deaktiveret, kompileres disse moduler kun efter behov. Afhængigt af spillet kan det afbryde spillet uventet og muligvis ofte."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Hvis flere pistolenheder er tilsluttet, kan denne indstilling bruges til kun at opsætte én pistol."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Angiv om nødvendigt den GBA-rom, der skal bruges."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Hvis mappenavnet indeholder »soniccd«, kører RetroBat automatisk Sonic CD RSDK; brug dette til at tvinge det."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Hvis joysticket er inden for denne dødzone, flytter markøren sig ikke."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Hvis du bruger en gamepad med bevægelsessensor som en dualshock eller switch pro, så aktivér dette for at bruge bevægelsessensoren."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Hvis du bruger rigtige Wiimotes med en sensorbar, så angiv sensorbarens korrekte placering for bedre præcision."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "Ignorér Horizon OS-tjenester, kan løse nedbrud i nogle spil."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Ignorér bevægelser af det analoge stik under denne tærskel."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "Ignorér eksisterende ini-filer i mappen »bios\mame\ini«."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Ignorér små stikbevægelser omkring midten. Øg den, når markøren på skærmen driver af sig selv."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Ignorér bordspecifikke backglass-indstillinger (.res-fil ved siden af bordet) under spillet. Filen bevares og gendannes ved afslutning."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Ignorér indstillingerne pr. spil, der er gemt i shadPS4, og brug altid RetroBats indstillinger."

msgctxt "game_options"
msgid "Improve performance at the cost of accuracy and input lag."
msgstr "Forbedr ydeevnen på bekostning af nøjagtighed og inputforsinkelse."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Forbedr ydeevnen for CPU'er med mere end 4 kerner, standard er aktiveret."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Forbedr ydeevnen i mange spil. Deaktivering kan undgå grafiske fejl i nogle andre spil."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "Forbedr polygonrenderingen ved brug af OpenGL-rendereren."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Forbedr shader-nøjagtigheden. Deaktivering giver en lille hastighedsgevinst, men kan give grafiske fejl i nogle spil."

msgctxt "game_options"
msgid "Improve the loading of discs of the emulated game."
msgstr "Forbedr indlæsningen af diske i det emulerede spil."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements."
msgstr "Forbedr opløsningen på bekostning af højere krav til ydeevnen."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Forbedr opløsningen på bekostning af højere krav til ydeevnen. Kun OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Forbedr opløsningen på bekostning af højere krav til ydeevnen. Kræver en Redream-nøgle."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Forbedr opløsningen på bekostning af højere krav til ydeevnen. Kun Vulkan og OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Forbedrer nøjagtigheden i nogle spil, men kan sænke ydeevnen."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Forbedrer farvedybden."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Forbedrer ydeevnen i nogle spil, men springer alle EFB-baserede effekter over."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Forbedrer ydeevnen."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Forbedrer ydeevnen. Eksperimentel med flere konsoller."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Forbedrer stabiliteten i nogle spil, men sænker ydeevnen."

msgctxt "game_options"
msgid "Improves the data loading speed."
msgstr "Forbedrer hastigheden for dataindlæsning."

msgctxt "game_options"
msgid "Improves the emulation performance at the cost of accuracy."
msgstr "Forbedrer emuleringens ydeevne på bekostning af nøjagtigheden."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Kun i OpenGL."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "For spil med flere diske ved brug af .m3u-fil: angiv nummeret på den disk, der skal køres."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "Øg nøjagtigheden, kan rette nogle lyd- og hastighedsproblemer."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Øg, hvis skud rammer lidt ved siden af målet."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Øg, hvis udsynet eller spilleren bevæger sig af sig selv."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Øg, hvis udsynet eller spilleren bevæger sig af sig selv. Standard er 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Øg 3DFx Voodoo OpenGL-opløsningen."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Øg antallet af sprites, der kan tegnes samtidig på skærmen."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Øger RAM-forbruget og den første opstartstid, men mindsker læsning fra disk efter opstart."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "At øge værdien kan give fejl."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initialiserer farve-render targets fra emuleret hukommelse. Nødvendigt for korrekt rendering i nogle spil, kan sænke ydeevnen. Standard fra."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initialiserer dybde-render targets fra emuleret hukommelse. Nødvendigt for korrekt rendering i nogle spil, kan sænke ydeevnen. Standard fra."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Angiv den server, der skal bruges, i formatet »x.x.x.x:y«."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Indsæt MoonSound-udvidelse i I/O-plads."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Indsæt Video9000-udvidelse i I/O-plads."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Indsæt en disk i diskettedrevet, bruges ofte til CDROM-spil."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Installeret videochip. Automatisk bruger TMS9918A, medmindre spillet kræver F18A-opgraderingen. Kræver genstart af kernen."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Interpolerer lydudgangen for bedre kvalitet."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "Fortolkeren har bedre kompatibilitet end JIT dynamisk rekompilator, JIT er hurtigere."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Byt A/B- og X/Y-knapper."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Invertér Zapperens lyssensorsignal. Kræves af noget pistolhardware."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Invertér Zapperens aftrækkersignal. Kræves af noget pistolhardware."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Invertér den lodrette akse på gamepadens højre analoge stik."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "Invertér op og ned i sigtekornsstyringen."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Inverterer at kigge op og ned (gamepad og mus)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Inverterer at kigge op og ned med gamepad."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Inverterer at kigge op og ned med højre stik."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Inverterer den lodrette akse under flyvning."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT er hurtigst, fortolkeren er mere præcis."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Just In Time-kompilering. Øger hastigheden betydeligt på 68020 og senere modeller. Ignoreres på 68000-maskiner og deaktiveres automatisk i cykluspræcis tilstand."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Hold DOS-prompten aktiv, hvis spillet afsluttes, eller hvis starten mislykkes."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Behold eller slet spilfiler, når de er pakket ud (squashfs, 7z)"

msgctxt "game_options"
msgid "Keep the CD image in memory."
msgstr "Hold CD-billedet i hukommelsen."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Bevar det originale billedformat i stedet for at strække billedet."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Tast, der åbner Amiberrys egen menu. F12 er den eneste funktionstast, en Amiga aldrig havde, så den er den eneste, der forbliver ledig."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Tast, der skifter mellem vindue og fuldskærm under emuleringen."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Taster, der bruges som joystick, når ingen controller er tilsluttet. Piletaster skyder med højre Ctrl. Det numeriske tastatur skyder med 0 eller 5. WASD skyder med venstre Alt."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 og R3 udfører den aktuelle figurs specialangreb, når spillet viser dem. Til som standard."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = Service, R3 = Test, for at åbne spillenes operatørmenu. Til som standard."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "LLVM er hurtigst; brug fortolkerindstillingerne ved problemer."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "LLVM er den hurtigste mulighed med meget god kompatibilitet. Brug ASMJIT-rekompilatoren, hvis du oplever problemer."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "Sprog, spillene skal vise tekst på."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Sprog for menuer og tekst i spillet. Et sprog, der ikke findes i spillet, ignoreres, og indstillingen i spillet bevares."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Sprog for undertekster. Et sprog, der ikke findes i spillet, ignoreres, og indstillingen i spillet bevares."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Sprog for stemmer. Et sprog, der ikke findes i spillet, ignoreres, og indstillingen i spillet bevares."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Stor hastighedsforøgelse på CPU'er med flere kerner, men et lille antal spil fryser."

msgctxt "game_options"
msgid "Launch DemulShooter for gun games."
msgstr "Start DemulShooter til pistolspil."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Start MameHooker til håndtering af outputs."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Lad stå på »Auto«, medmindre registreringen mislykkes."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Lad AUTO være standard, medmindre spillet kræver en bestemt indstilling."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Lad stå på AUTO for automatisk registrering."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Lad stå på auto for automatisk at tilpasse sig spillets orientering; brug denne indstilling til at tvinge den, hvis nødvendigt."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Lad være slået fra, medmindre synkroniseringskilden er sat til video: vsync og lydsynkronisering fungerer dårligt sammen."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Lad stå på AUTO for at lade emulatoren vælge den første gyldige BIOS i »\bios\pcsx2\bios«."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Lad stå på Automatisk for at beholde den processor, den valgte model faktisk havde. En hurtigere CPU kan ødelægge spil, der bygger på præcis timing."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Lad stå på Automatisk, medmindre et spil kræver en bestemt ROM. Filen skal ligge i bios-mappen. Kræver genstart af kernen."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Lad denne være TIL som standard for at aktivere CPU JIT-optimeringer."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Lad denne stå på 16:9, medmindre du har en 4:3-skærm."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Lad denne være slået til som standard; bruger flere tråde til rendering."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "MANUEL ændrer ikke den brugerdefinerede værdi, AUTO er 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "Venstre bliver højre, og op bliver ned."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Lad ALTIRRA vælge profilen ud fra spillet."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Lad RetroArch tildele controllere med sine egne autokonfigurationsprofiler i stedet for RetroBats tildeling. Tilsidesætter RetroBats autokonfiguration."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Lad RetroBat forsøge at hente opstartssekvensen fra MAME-hash-filen eller filnavnet (klammer)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Lad RetroBat forsøge at hente opstartssekvensen fra MAME-hash-filen."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Lad Visual Pinball selv skifte til den valgte videotilstand i stedet for at ændre skrivebordets opløsning."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Lader en MegaWiFi-modul-ROM få adgang til dit netværk og internettet. Aktivér kun for ROM'er, du stoler på."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Lader kernen selv styre tempoet i stedet for at være afhængig af RetroArch. Prøv »standard 50 Hz«, hvis et PAL-spil kører ujævnt."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Lader emulatoren læse GS-hukommelsen tilbage. Til som standard. Fra er hurtigere, men kan ødelægge nogle grafiske effekter."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Lader venstre stik fungere som joystick ud over D-pad'en."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Ophæv spillets loft for billedhastighed, hvor spillet tillader det. Alt andet end original kan ødelægge et spil."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Forbind 2 til 4 Lynx med ComLynx-kablet på én skærm, én controller hver. Deaktiverer gemte tilstande og præstationer."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Indlæs brugerdefineret profil til rattildeling."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Indlæs mods (.dusk-filer) fra en mappe med samme navn som spillet ved siden af det, eller fra dusklight\data\mods, hvis der ikke er nogen."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Indlæs mods fra mappen User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Indlæs de mods, der ligger i spillets mods-mappe (én mappe med en mod.ini pr. mod). Til som standard."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Indlæser en forudindstilling for grafikkvalitet (teksturer, filtrering, bløde partikler). Lad stå på AUTO for at beholde indstillingerne i spillet."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Indlæser de to første diske i et spil med flere diske i drev 1 og drev 2 på én gang i stedet for kun drev 1. Kræves af de få spil, der beder om to drev."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Indlæser erstatningsteksturerne i Data\Assets\HDTextures\<rom> i emulatormappen."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Indlæser hele diskbilledet i hukommelsen. Hurtigere indlæsning, højere RAM-forbrug."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Lav shader-kvalitet kan forbedre ydeevnen, men give fejl."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Lavere betyder mindre forsinkelse, for lavt giver udfald."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Sænk GS-præcisionen for at undgå mellemrum mellem pixels ved opskalering. Retter tekst i Wild Arms og efterbilleder i SoulCalibur."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Lavere værdier mindsker lydforsinkelsen, højere værdier mindsker knas."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "MSAA- eller SSAA-niveau."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Maskinens timing. 60Hz er den amerikanske maskine, 50Hz den europæiske. Nogle få europæiske programmer kræver 50Hz for at køre med korrekt hastighed. Ændring genstarter maskinen."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Hovedhukommelse. Auto bruger modellens RAM eller spildatabasen. Ikke-understøttede størrelser rundes op til modellens næste størrelse."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "Gør warp-tilstand meget hurtigere ved at skifte SID-emuleringen til »FastSID« under warp."

msgctxt "game_options"
msgid "Makes the emulator auto fast forward CD loading sequences."
msgstr "Får emulatoren til automatisk at spole CD-indlæsningssekvenser frem."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Tildel manuelt den pad, spilleren bruger. Kun nødvendigt, når RetroBat ikke kan skelne to identiske pads, f.eks. med en arkadeencoder til 2 spillere, som Windows ser som én enhed. Lad ellers stå på AUTO."

msgctxt "game_options"
msgid "Manually select a 4 Player Adapter for some games"
msgstr "Vælg manuelt en adapter til 4 spillere til nogle spil"

msgctxt "game_options"
msgid "Manually specify your choice of Neo Geo BIOS."
msgstr "Angiv manuelt dit valg af Neo Geo BIOS."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Mange spil behøver kun kopier til teksturer, men hvis du ser sort eller manglende grafik, skal du måske vælge kopier til RAM."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Tildel en 8BitDo M30 eller lignende pad knap for knap ud fra mdControllers.json."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Tildel controlleren som racercontroller; spil, der ikke var kompatible med racerrat, virker ikke."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Tildel select til en ekstra knap, nyttigt i Zelda-spil for at undgå at afslutte, når der gemmes."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Tildeler aftrækkerne til det analoge stiks lodrette akse. Nyttigt til Gran Turismo og andre racerspil."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Tilpasser farverne til, hvordan de ser ud på rigtig hardware."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Matematik-coprocessor. Kun en håndfuld Amiga-titler bruger en, og at tilføje den til en maskine, der aldrig havde en, kan forvirre nogle få spil."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Maks. hastighed for joystickets touchmarkør."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "Maksimalt antal CPU-tråde til teksturopskalering. Brug det samlede antal tråde minus 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Kan give artefakter i nogle spil."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Kan forbedre ydeevnen for nogle processorer med mange kerner. Kan give langsommelighed i visse situationer på grund af den ekstra arbejdstråds belastning."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Kan mindske hakken på bekostning af længere ventetid ved spilstart."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Metode til interlacede videotilstande (anvendes ikke på Nintendo 64)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Metode til interlacede videotilstande."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "Metode til at læse data fra disken: synk efterligner den originale hardware, asynk kan mindske hakken, forudcache indlæser hele billedet på bekostning af en indledende forsinkelse."

msgctxt "game_options"
msgid "Might fix some misaligned fog, bloom or blend effect."
msgstr "Kan rette forskudt tåge, bloom eller blandingseffekter."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Efterligner nogle famikloner, der bytter firkantkanalernes duty cycles."

msgctxt "game_options"
msgid "Mimics the display characteristics of the Game Gear and Nomad LCD panels."
msgstr "Efterligner visningsegenskaberne for Game Gear- og Nomad-LCD-panelerne."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "Mipmapping er nødvendig for nogle spil."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Spejl verden vandret ligesom i spillets Wii-version."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C er det lydkort, de fleste spil understøtter. Vælg kun Mouse Card til software, der kræver en rigtig Apple-mus; det erstatter lydkortet. Ændring genstarter maskinen."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard er det lydkort, de fleste spil understøtter. Ignoreres på //c-modellerne, som ikke har udvidelsesporte."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Forvalgt tilstand på skærmen til valg af spillere. Download Play kræver den originale BIOS og firmware."

msgctxt "game_options"
msgid "Modify the coin setting to Free Play."
msgstr "Ændr møntindstillingen til Free Play."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "Monokrom kræves af spil i høj opløsning (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Mere præcis CD-blok-emulering. Kræver en CD-blok-ROM og deaktiverer indstillingen for læsehastighed."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "Mere præcis adfærd, men kan give lavere ydeevne. TIL som standard."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "De fleste spil bruger port 2; brug denne indstilling til de gamle spil, der kræver joysticket i port 1."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Montér automatisk drev C: ved opstart."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Mus: spil som Elansar eller Defender of the Crown. Analogt stik: BattleSphere, vælg det også i spillets indstillinger."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Flyt musen med et analogt stik på controller 1 (L2/R2 = knapper). En port skal være sat til Mus."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Bevæg dig med venstre analoge stik såvel som D-pad'en. Til som standard."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level."
msgstr "Niveau for multi-sampling anti-aliasing."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Niveau for multi-sampling anti-aliasing. Kun OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Niveau for multi-sampling anti-aliasing. Kun Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Multiplikator for joystickmarkørens hastighed, mens knappen til hurtig markør (L2 som standard) holdes nede."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "Multitap skal være indstillet, hvis mere end 2 spillere vil spille."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Slå diskettedrevenes mekaniske støj fra."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "NEJ viser kun billedet til venstre øje. Anaglyf kræver 3D-briller med de samme farver, side om side er til VR-headsets og 3D-skærme."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC bruger cdi200.rom, PAL bruger cdi220b.rom."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Spillets native opløsning. Som standard den, der er angivet i spillet."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Kræves af nogle få spil, herunder flere peg-og-klik-titler."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "Ingen mønt nødvendig for at starte et spil."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Antal emulerede diskettedrev. En rigtig Amiga 500 havde kun ét. To drev gør spil med flere disketter hurtigere, men nogle få titler forventer kun ét."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Antal billeder mellem hvert turbotryk."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Fra som standard. Adaptiv venter ikke på skærmen, når et billede er forsinket."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Fra som standard: emulatoren kører selv med arkadehastighed (57,5 Hz). Slå til, hvis billedet river."

msgctxt "game_options"
msgid "Offset for the ST/UV texture coordinates."
msgstr "Forskydning for ST/UV-teksturkoordinaterne."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "På en skærm med 120Hz eller mere uden G-Sync eller FreeSync: brug dens højeste opdateringshastighed, der er et multiplum af 60Hz."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Til som standard; slå fra for at bruge lydkvalitet på 11khz."

msgctxt "game_options"
msgid "On by default."
msgstr "Til som standard."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Til som standard. Slå fra for at få fart på integrerede grafikkort."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Til som standard. Slå fra, når pistolen har sin egen sigtning (laser, Sinden-sigtekorn)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Én pixel pr. spilpixel (anbefales til shaders)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Gælder kun, når teksturopskalering (xBRZ) er aktiveret. Teksturer større end dette opskaleres ikke."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Kun kompatibel med ASIA/JAPAN MVS-system."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Kun kompatibel med OpenGL, hård synkronisering af GPU og CPU. Mindsker forsinkelsen på bekostning af højere krav til ydeevnen."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Kun kompatibel med software-videodriveren."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Har kun effekt, når BEGRÆNS FPS er aktiveret. Standard: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Kun til asiatiske versioner af spillene."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Kun til nyere versioner af Ikemen GO. Vulkan er eksperimentel."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Kun framebuffere større end denne størrelse opskaleres, kan rette nogle problemer i visse spil."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Brug kun billedbegrænseren, hvis et spil kører for hurtigt uden. Nogle spil kan gå ned, hvis billedhastigheden er for høj. Sker det, så sæt værdien til alt andet end Fra."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Brug kun dette, hvis du har to identiske controllere, og de ikke registreres korrekt. Binder pads efter position i stedet for navn, hvilket er mindre pålideligt."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Brug kun dette til at nedskalere vinduet, når der bruges skalering i Windows-indstillingerne."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Bruges kun, hvis angivet — der antages intet standardsigtekornsbillede for P2."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Bruges kun, når en MIDI-udgangsenhed er valgt."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "OpenBOR-motorversion, der bruges til at køre spillet. Auto registrerer den ud fra spildataene eller et [XXXX]-buildnummer i filnavnet som for OpenBOR standalone."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "OpenGL kræves til shaders og intern opløsning."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Kun OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Kun OpenGL. Retter en sort skærm på nogle integrerede AMD-GPU'er, nogle få spil renderes forkert."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Åbner et andet vindue til Gamepad-visningen."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Valgfrit lydkort (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) eller subwoofer (Gaelco-spil). Miks som standard, kun hovedkort til Star Wars Racer Arcade."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "Overclock CPU, SA-1-chip og Super-FX-chip, kan mindske langsommelighed, men kan give problemer i nogle spil."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Overclock eller underclock begge SH-2-CPU'er. 100 er standardhastighed."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Overclock eller underclock den emulerede hoved-CPU. Kan hjælpe med at stabilisere billedhastigheden, men ødelægger nogle spil."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Overclock den emulerede 68k-chip for bedre billedhastighed."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "Tilsidesæt RetroBats gamepad-tildeling med brugerens egen tildeling i emulatorens script-mappe."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Tilsidesæt bordets standardbelysning."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL kører ved 50 Hz og er korrekt for næsten alle europæiske Amiga-titler. NTSC kører ved 60 Hz og passer til en håndfuld amerikanske udgivelser."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 identificerer controllere ud fra sit eget pladsnummer, som ikke følger RetroBats spillerrækkefølge. Automatisk tager den første, den finder; skift, hvis den forkerte controller reagerer."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "Patch TOS-filen for hurtigere opstart."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Sti til mappen med AGS WinUAE; hvis udfyldt, tilføjer RetroBat ags-starteren til amiga-systemet."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Sti til mappen med ExoDos, påkrævet for at RetroBat kan scanne ExoDOS-spil."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Sti til mappen med ExoWin3x, påkrævet for at RetroBat kan scanne ExoWin3x-spil."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Sti til mappen med ExoWin9x, påkrævet for at RetroBat kan scanne ExoWin9x-spil."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Pr. spil: hvert spil har sin egen konsolhukommelse på 8 KB, så den kan aldrig blive fuld. Delt: én hukommelse til alle spil, som på en rigtig afspiller."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Belysning pr. pixel i stedet for pr. vertex. Forbedrer kvaliteten i nogle spil."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Ydeevneløft, kan også give stabilitet i nogle spil som GT6."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Placér et brugerdefineret sigtekornsbillede og vælg det nedenfor."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Placér en brugerdefineret »crosshair.png«-fil i emulatorens undermappe »cross«, eller vælg en fil nedenfor."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Placér en brugerdefineret »crosshair.png«-fil i emulatorens undermappe »cross«."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: skub stikket op for at stige (kabinettet stiger med stikket trukket tilbage)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "Spil MVS-spil uden at indsætte mønter."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Afspil en advarselslyd, når helbredet er lavt."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Afspil VMU-bip."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Spil kun med rigtige wiimotes, andre controllere virker ikke."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Antal spillere forvalgt på skærmen til valg af spillere, der vises ved start."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Tilslut RetroPads i forskellige porte, nyttigt til adaptere til 4 spillere."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Tilslut en mus i joyporten; dette fjerner tilsluttede joysticks."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "Tilslut ekstra joysticks i port 2, 3 og 4."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "Tilslut GunCon i port 2 til brug i Die Hard Trilogy."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Tilslutter et MIDI-kort og sender dets udgang til denne Windows MIDI-enhed, nummereret som i emulatorens MIDI-indstillinger. INGEN beholder standard-FM-lyden."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Lad RetroArchs »system«-mappe pege på en anden mappe."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Port 1 er altid Wii U GamePad. En Wii-fjernbetjening kan tilføjes oven i den til spil, der kræver en."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Port for Light Phaser. Port 1 som standard."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Port for Super Scope. Port 2 som standard."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Port for Zapper. Port 2 som standard."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Kan potentielt mindske indlæsningstiden på bekostning af længere opstartstid."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "PowerPC-rekompilator, til som standard og meget hurtigere. Slå fra for at bruge fortolkeren."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Forkompilér shader-cachen ved spilstart; lad stå TIL for mindre hakken i spillet."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "Nøjagtig er den mest præcise, og afslappet kan øge ydeevnen, men ødelægge nogle spil."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Foretrukken region. Et spil, der ikke accepterer den, falder tilbage til en, det gør."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Forudindlæs alle CD-spor i RAM."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Forudindlæs brugerdefinerede teksturer ved opstart."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Trykkes for at åbne Amiberrys menu."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Trykkes for at nulstille Amigaen."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Trykkes for at vise skærmtastaturet."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Forhindrer nogle artefakter, men kan give hårde kanter."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Forhindrer, at den blandede lyd fra flere spillere overstyres."

msgctxt "game_options"
msgid "Processor model."
msgstr "Processormodel."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Processormodel. En hurtigere CPU end den rigtige maskine kan ødelægge spil, der bygger på præcis timing."

msgctxt "game_options"
msgid "Provider for the Adlib emulation. DEFAULT has good quality and low perf requirements."
msgstr "Udbyder af Adlib-emuleringen. STANDARD har god kvalitet og lave krav til ydeevnen."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Sætter spiller 1's pad i port 1 i stedet for port 2. Kræves af nogle få spil, herunder flere peg-og-klik-titler."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Bekvemmelighedsjusteringer: hurtig forvandling, større punge, hurtig klatring, øjeblikkelig gemning, autogem, forbedrede kortmenuer... Klassisk svarer til GameCube-spillet. Ikke angivet: Dusklights menuindstillinger bevares."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD SOM TASTATUR: D-pad'en sender piletasterne og knapperne MELLEMRUM / RETURN til spil uden joystickunderstøttelse."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "LØB som standard, brug løbeknappen til at gå."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "ReShade bruges af RetroBat til at vise rammer og shaders i nogle standalone-emulatorer. DEAKTIVERET: rammer vises i stedet med et overlay-vindue. BRUG MIN EGEN: RetroBat installerer, ændrer eller sletter aldrig ReShade-filer i emulatormapper."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Læs render-to-texture-resultater på CPU'en. Kan være nødvendigt i nogle spil, men giver synkronisering midt i billedet og har derfor stor indvirkning på ydeevnen."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Læs disken hurtigere end konsollens drev. Nogle spil forventer det muligvis ikke."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Læs ini-filen i undermappen »bios«."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Læs ini-filen i mappen »bios\mame\ini«."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "Rigtig Amiga-hastighed er den sikre standard. Turbo indlæser hurtigere, men kan ødelægge nogle få indlæsere og kopibeskyttelser."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Reality Signal Processor-plugin, tvunget til LLE, når videodriveren er sat til Parallel."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Reality Signal Processor-plugin."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Anbefalet: Lineær, når SKALA FOR SEKUNDÆR SKÆRM er under 100%."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "Rekompilatoren er hurtigst, fortolkeren er mere præcis."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "Rekompilatoren er meget hurtigere, fortolkeren er kun nyttig til fejlfinding. Kræver genstart."

msgctxt "game_options"
msgid "Recover significant color depth."
msgstr "Genvind betydelig farvedybde."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "Sænk nøjagtigheden for bedre ydeevne, grafikkvaliteten bliver lavere."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Sænk hastigheden for analog styring; nogle spil kræver lave værdier for at kunne spilles."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Kortere indlæsningstider. Kan ødelægge nogle få spil, der bygger på rigtig disktiming."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Mindsk hakken på bekostning af meget længere ventetid ved spilstart og højt GPU-forbrug."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Mindsker VRAM-forbruget på bekostning af kvaliteten, kan øge hakken."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Mindsker klik forårsaget af store skrivninger til DMC-kanalen. Upræcist, kan blødgøre nogle samplede lyde."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Mindsker knas og hakken, men kan give en meget mærkbar forringelse af lydkvaliteten på langsomme CPU'er; lad stå på AUTO for at deaktivere."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Mindsker flimmer."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Mindsker hakken og gør opstarten hurtigere efter første opstart."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Mindsker vaklende polygoner og teksturvridning i 3D-spil."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "Understøttelse af ReelMagic MPEG-afspilning."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Genopfyld bæltet med eliksirer fra inventaret."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "Opdatér tilstanden for hukommelsessider for at aktivere data skrevet af GPU'en. (Bruges i »Team Ninja«-spil for at rette manglende figurmodeller)."

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Region for NEC PAC-firmwaren. Japan: pac-n1.bin eller pce-lp1.bin. US: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Region, der vælges først på diske med flere regioner."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 1."
msgstr "Omtildel sideknapperne for spiller 1."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 2."
msgstr "Omtildel sideknapperne for spiller 2."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Fjern kanter på n pixels øverst og nederst på skærmen."

msgctxt "game_options"
msgid "Remove odd composite green/blue artifacting that appears on real hardware."
msgstr "Fjern de underlige grønne/blå kompositartefakter, der optræder på rigtig hardware."

msgctxt "game_options"
msgid "Remove the original sprites-per-scanline hardware limit."
msgstr "Fjern den originale hardwares grænse for sprites pr. scanline."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Fjern de sorte sidebjælker i nogle mellemsekvenser (ultrabrede skærme). Områder uden for den originale indramning kan se fejlbehæftede ud."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Fjern de sorte bjælker foroven og forneden under målretning, sigtning, mellemsekvenser og dialoger."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Fjern det hvide glimt, der vises ved skud."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Fjerner ét billede inputforsinkelse, men fordobler systemkravene."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Fjerner de sorte kanter omkring Amiga-billedet. Stærkere indstillinger skærer mere og kan beskære kanterne i nogle få spil."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Fjerner billedflimmeret i Hummer."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Fjerner det hvide glimt, der vises, når spillene deaktiverer 3D-rendering."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Rendér ved et multiplum af den native N64-opløsning. Tilsidesætter indstillingen for intern opløsning, når den ikke er FRA."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Rendér Gouraud-skygning med fuld præcision for at mindske farvebånd i 3D-spil."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "Emuleringssti for render targets. rtv/fbo giver bedre ydeevne, rov/fsi højeste nøjagtighed."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Renderingsopløsning for vektorspil."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Renderer i 24-bit farver og fjerner dithering."

msgctxt "game_options"
msgid "Replace meshed transparency by real transparency."
msgstr "Erstat masket gennemsigtighed med ægte gennemsigtighed."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Erstat originale teksturer med en brugerdefineret teksturpakke (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack in 'bios\dc\textures'."
msgstr "Erstat originale teksturer med en brugerdefineret teksturpakke i »bios\dc\textures«."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack."
msgstr "Erstat originale teksturer med en brugerdefineret teksturpakke."

msgctxt "game_options"
msgid "Replaces game's sprites by HD pack available in HdPacks bios directory."
msgstr "Erstatter spillets sprites med en HD-pakke fra bios-mappen HdPacks."

msgctxt "game_options"
msgid "Replaces post-processing multiple paving sprites by a single fat sprite."
msgstr "Erstatter flere flisebelagte sprites i efterbehandlingen med én stor sprite."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Genskaber den rigtige hardwares lavpasfilter. »Emuleret« følger maskinens egen filterkontakt."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Anmod om bestemte pladser; vælg indstillingen BESTEMT PLADS ovenfor."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "Kræves af BASIC-programmer. Bruger ATARIBAS.ROM, når den findes, ellers den indbyggede Altirra BASIC."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Kræves til Formel 1-spil."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Kræves til Paper Mario: The Thousand-Year Door."

msgctxt "game_options"
msgid "Required for certain games that use hi-res mode to produce transparency effects."
msgstr "Kræves til visse spil, der bruger hires-tilstand til at skabe gennemsigtighedseffekter."

msgctxt "game_options"
msgid "Required for certain visual effects."
msgstr "Kræves til visse visuelle effekter."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Kræves, for at Spol tilbage-hotkey'en gør noget."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Kræves for at starte spillet uden et Cycraft-bevægelseskabinet."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Kræves for at rette Def Jam Icon."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Kræves for at køre nogle gamle rom-hacks; lad være slået fra til kommercielle spil."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Kræver mindst »4X SSAA (ORDNET)«. 4x-tilstandene kræver »16X SSAA (ORDNET)«."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Opløsning for den emulerede videoudgang."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "Respektér Non-Java Mode-bitværdier for vektoroperationer i PPU-backends. Er du i tvivl, så lad være med at ændre denne indstilling. Standard fra."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Responskurve for joystickets touchmarkør."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "RetroBat konfigurerer kun controlleren til spiller 1."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "RetroBat synkroniserer gemmemapperne for dolphin og libretro-dolphin."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "RetroBat bruger som standard psxonpsp BIOS; aktivér denne indstilling for at tvinge brug af den ældre SCPH550X bios-fil."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Genbrug den shader-cache, der er bygget til spillet. Auto lader emulatoren bestemme."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Gearvalg med højre stik i racerspil med 4 gear. H-gate: diagonaler som en rigtig gearkasse. Retninger: op 1, ned 2, venstre 3, højre 4. L1/R1 skifter altid ned/op."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Rotér visning og styring. Som standard roteres kendte spil automatisk. MANUEL: SELECT skifter rotationen."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "Rotér visningen for lodrette spil; aktivér til brug med mega-bezels."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Rotér visningen for lodrette spil."

msgctxt "game_options"
msgid "Rotate display for vertical screen."
msgstr "Rotér visningen til lodret skærm."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "Rotér visningen, kan være nyttigt til bestemte spil, der kræver lodret visning."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Rotér frontknapperne for at ændre layoutet."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Rotér Windows-visningen af spillepladeskærmen under spillet, gendannes ved afslutning (Visual Pinball 10.8 og senere)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Rotér udgangen, til lodrette skydespil."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Rotation anvendt i yderpunkterne af et sving."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Kør med maksimal hastighed, mens et CD-ROM-spil indlæses på en stillestående, lydløs skærm."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Kør med maksimal hastighed, mens en disk eller et bånd indlæses, når der ikke afspilles lyd. FULD DREVEMULERING kræves for diske."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Kør med de originale 57.524 Hz i stedet for 60 Hz. Kan hakke på en 60 Hz-skærm."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Løb som standard, løbeknappen går. Aktiveret som standard."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Løb som standard, løbeknappen går. Bruger udholdenhed i enkeltspiller."

msgctxt "game_options"
msgid "Run games faster. A powerful option for gaining performance that has no downsides some of the time. May cause various random issues caused by splitting the CPU and GPU threads onto different cores."
msgstr "Kør spil hurtigere. En kraftfuld indstilling til at få ydeevne, som ofte ikke har ulemper. Kan give forskellige tilfældige problemer, fordi CPU- og GPU-trådene fordeles på forskellige kerner."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "Kør systemet med G7400 BIOS og funktioner."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Kør GPU og DSP hurtigere. Kan hæve billedhastigheden i 3D-spil, men kan give fejl."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Kør to forbundne Game Gears side om side. Spiller 1 og 2 styrer skærm 1 og 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Løb uden at holde løbeknappen nede."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "Kører »jgenesis-gui.exe« i stedet for cli-versionen."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "SDL-gamepad som standard: den læser gamepads med standardlayoutet og de andre enheder (rat, gearstænger, arkadeencodere) med deres rå knapper. SDL læser alle enheder råt."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT bruger Roland SC-55-soundfonten, der følger med RetroBat."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "SSAA giver bedre kvalitet på bekostning af ydeevnen."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "STRÆK fylder hele skærmen og deaktiverer rammer."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Gem spillets tilstand ved afslutning og gendan den ved næste start (én fil pr. spil)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "Gemninger går til en kopi i gemmemappen, originalbilledet ændres aldrig. Nulstil starter forfra fra den originale disk (gammel kopi beholdes som .bak)."

msgctxt "game_options"
msgid "Saves the hiscores in supported games."
msgstr "Gemmer highscores i understøttede spil."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Skala for statuslinjen på skærmen."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Skalér kun billedet med hele tal, for skarpe pixels."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Skalér kun billedet med hele tal, for skarpe pixels. Kun fuldskærm 1080p eller 4K på en 16:9-skærm, med en let beskæring foroven og forneden."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Skalerer X-koordinater i forhold til skærmens midte. Sænk dette, hvis skud lander for langt fra sigtekornet ved kanterne."

msgctxt "game_options"
msgid "Scales the dithern pattern to the resolution scale of the emulated GPU."
msgstr "Skalerer dither-mønsteret til den emulerede GPU's opløsningsskala."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "Scanlines er ikke kompatible med HQ- eller xBRZ-shaders."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Scanlines, skyggemaske og fosforglød fra et katodestrålerør."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "Skærmrotation er ikke kompatibel med vandret layout."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Skærm, der bruges til DMD'en på en separat skærm, samme nummerering som SKÆRMINDEKS. AUTO bruger den mindste resterende skærm. Kræver SKÆRMOPSÆTNING med 3 skærme."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Skærm, der bruges til backglass, samme nummerering som SKÆRMINDEKS. AUTO bruger den største skærm ud over spillepladen. Kræver SKÆRMOPSÆTNING."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Skærm, der bruges til at vise spil (0 = primær skærm). AUTO lader emulatoren vælge sin skærm."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Skærme, der bruges af flipperspillet (Visual Pinball 10.8 og senere). Backglass- og DMD-placeringer beregnes derefter automatisk. Ikke angivet: SCREENRES-værdierne bruges."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Skærme, der bruges af flipperspillet. Backglass- og DMD-placeringer beregnes derefter automatisk. Ikke angivet: 1 skærm."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "Skriv 0xCD i al allokeret heap-hukommelse."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "Andet joystick kan komme i konflikt med musen."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Vælg »spilspecifik« for at bruge spilspecifik cfg-fil i mappen emulators\psxmame\ctrlr."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Vælg type af Amstrads katodestrålerør-controller."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Vælg den Amstrad-model, der skal emuleres."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Vælg mus eller joypad til at styre den virtuelle markør i spillet."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Vælg NEJ for at deaktivere teksturcachen."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "Vælg en BigPemu-shader, kun muligt når RetroBat-shaders er sat til »none«."

msgctxt "game_options"
msgid "Select a bilinear filtering method."
msgstr "Vælg en bilineær filtreringsmetode."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Vælg et filter, der skal anvendes."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Vælg en shader, der skal anvendes."

msgctxt "game_options"
msgid "Select a video format for output."
msgstr "Vælg et videoformat til udgangen."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Vælg mellem de forskellige controllerlayouts."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "Vælg det controllerlayout, der skal bruges med indstillingen »Dynamisk profil«."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Vælg det hjørne af skærmen, hvor tatoveringen skal vises."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Vælg den effekt, der skal anvendes; har ingen effekt, når der bruges shaders."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Vælg layout for frontknapperne."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Vælg, hvilken port GBA-rom'en skal indsættes i, standard 2."

msgctxt "game_options"
msgid "Select method used to emulate the FM synthetiser."
msgstr "Vælg metoden til emulering af FM-synthesizeren."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Vælg den model, der skal emuleres."

msgctxt "game_options"
msgid "Select palette for colorizing GB games when COLORIZATION is set to 'internal'."
msgstr "Vælg palet til farvelægning af GB-spil, når FARVELÆGNING er sat til »internal«."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Vælg den shader, der skal anvendes, kun kompatibel med videodriveren »bgfx«."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Vælg den shader, der skal anvendes, kun kompatibel med videodriveren »openGL«."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Vælg gearskiftetilstand for BattleGear4Tuned."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "Vælg GPU-plugin; RetroBats indstillinger virker ikke med et andet plugin end standard, de kan konfigureres fra emulatormappen med config.exe."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Vælg den IPL BIOS, der skal køre et spil afhængigt af dets region. Kræver »IPL_JAP.n64«, »IPL_USA.n64« og »IPL_DEV.n64« i mappen bios\Mupen64plus."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Vælg den enhed, der læser X- og Y-koordinater."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "Vælg den driver, der bruges til shaders med videodriveren bgfx."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "Vælg den udvidelse, der skal tilføjes til controlleren."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Vælg tilstanden for billedpræsentation."

msgctxt "game_options"
msgid "Select the graphics plugin used by the emulator. Depends on hardware compatibility."
msgstr "Vælg det grafik-plugin, emulatoren bruger. Afhænger af hardwarekompatibiliteten."

msgctxt "game_options"
msgid "Select the keyboard layout."
msgstr "Vælg tastaturlayoutet."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Vælg belysningsmodellen; den ældre tilstand er den mindst krævende for grafikkortet."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Vælg den maskine, der skal emuleres."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Vælg den profil, der skal tildeles spilleren."

msgctxt "game_options"
msgid "Select the soundfont file or interface used for MIDI output."
msgstr "Vælg den soundfont-fil eller det interface, der bruges til MIDI-udgang."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "Vælg kildesystemet for transfer pak mellem GB og GBC."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "Vælg konsoltypen."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "Vælg typen af billedindramning. Brug værdien EMUSCV til at rette fejl i den originale konsols visning."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "Vælg pistoltypen afhængigt af spillet."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Vælg videotilstand (kabeltype)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Vælg, hvor mønt- og startknapperne skal tildeles, når der spilles med rat."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Vælg, hvor test- og serviceknapperne skal tildeles, når der spilles med rat."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Vælg, om kryds- eller cirkel-input er bekræftelsesknappen."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "Vælg, hvilken lydmotor der skal bruges internt."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Vælg, hvilket farvefilter der skal anvendes."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Vælg, hvilket grafik-API der skal bruges med tekstur-rendereren."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Vælg, hvilket joystick der skal emuleres (ikke kompatibel med MASTER COMPACT)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Vælg, hvilket joystick der skal emuleres."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "Vælg, hvilken skærm der vises ved hybridlayout."

msgctxt "game_options"
msgid "Selecting GBA unlocks extra features in certain GBA enhanced GBC games."
msgstr "Valg af GBA låser ekstra funktioner op i visse GBC-spil, der er forbedret til GBA."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Send den fulde rom-sti til MAME i stedet for kun ROM-navnet."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Send outputs fra lamper og drivkort til eksterne værktøjer (MAMEHooker...) med Windows-beskeder."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Send outputs fra lamper og pistolrekyl til eksterne værktøjer (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Send outputs fra lamper, pistolvibration og drivkort til eksterne værktøjer (Hook Of The Reaper, QMamehook...) med MAMEs netværksprotokol."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Følsomhed for den emulerede spinner-controller."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Angiv en standard-ISO til brug med nogle homebrew-spil."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Angiv standardcontrollertildeling for spiller 1."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Angiv standardcontrollertildeling for spiller 2."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Angiv standardcontrollertildeling."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Angiv licensmaske for aktiveret indhold (ALLE LICENSER er generelt en dårlig idé og kan føre til udefineret adfærd)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content."
msgstr "Angiv skaleringsfilter for renderet indhold."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Angiv skaleringsfilter for renderet indhold. FSR kræver Vulkan."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Angiv skaleringsfilter for renderet indhold. Kun OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Indstil Atari 2600's sværhedsgradskontakt."

msgctxt "game_options"
msgid "Set the adress, interrupt, low 8 bit and high 16 bit DMA."
msgstr "Angiv adresse, interrupt, lav 8 bit og høj 16 bit DMA."

msgctxt "game_options"
msgid "Set the amount of extra columns to draw for widescreen."
msgstr "Angiv antallet af ekstra kolonner, der skal tegnes til widescreen."

msgctxt "game_options"
msgid "Set the aspect ratio of the FMV cinematics."
msgstr "Angiv billedformatet for FMV-mellemsekvenserne."

msgctxt "game_options"
msgid "Set the behavior of the start menu when autostarted game exit."
msgstr "Angiv startmenuens adfærd, når et autostartet spil afsluttes."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Angiv mikrofonknappens adfærd."

msgctxt "game_options"
msgid "Set the bottom screen as prominent."
msgstr "Gør den nederste skærm fremtrædende."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Sæt konsollen til widescreen for de spil, der understøtter det."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Angiv værtens opdateringshastighed."

msgctxt "game_options"
msgid "Set the volume of the emulated floppy sound."
msgstr "Angiv lydstyrken for den emulerede diskettelyd."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Indstil dette for spil, der kræver controller i port 2."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Slå dette til ved brug af flere pistoler. Til som standard, hvis der findes flere pistoler, og inputdriveren ikke er sat til »sdl«."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Indstil kun dette ved brug af et rigtigt balance board."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Indstil dette for at sætte mikrofonen i plads B."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Sæt til »TIL« for at lukke steam eller Epic Game Launcher, når spillet afsluttes."

msgctxt "game_options"
msgid "Set this to effectively halve monitor refresh rate."
msgstr "Indstil dette for reelt at halvere skærmens opdateringshastighed."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Indstil dette for at tilslutte GunCon til port 2, bruges til visse versioner af Die Hard."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Indstil dette for at bruge den originale PSX-gamepad i stedet for Dualshock."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Sæt til JA for at vende tilbage til frigear i racerspil, når gearknappen slippes."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Indstiller lysstyrkeforskydningen for det emulerede LCD-display."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Indstiller kontrastniveauet for det emulerede LCD-display."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Indstiller PowerPC-frekvensen i MHz. 0 (standard) bruger spilkortets frekvens."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Indstiller PowerPC-frekvensen i MHz. AUTO bruger spilhardwarens frekvens (kun Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "Indstiller PowerPC-frekvensen i MHz. Standard er 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Indstiller dødzonen for gamepadens analoge stik, når inputenhedstypen er sat til »Klassisk gamepad« eller »Moderne gamepad«."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Indstiller dødzonen for gamepadens analoge stik."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Indstiller dødzonen for gamepadens analoge aftrækkere."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Indstiller dødzonen for de analoge stik. Bruges kun med controllertypen »Moderne gamepad«."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Indstiller spillerens controllertype."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Indstiller følsomheden for de analoge stik."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "Sættes denne til 0, rapporteres alt som skjult; kræves til Forza Motorsport 4."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "At sætte denne til 1 kan øge ydeevnen."

msgctxt "game_options"
msgid "Setting this too high may cause sample clipping."
msgstr "Sættes denne for højt, kan samples blive klippet."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Pixelernes form: kvadratiske eller som på den originale skærm."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Formen på skyggemasken, som CRT-shaderen tegner. Bruges kun, når shaderen er sat til CRT-maske."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Delt CMOS for alt indhold som standard, eller én pr. spil (bedre til netspil)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "Skærpningsintensitet anvendt af FidelityFX CAS. Bruges kun, når skaleringsfilteret er sat til FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Korte beskeder på skærmen (tilstand gemt...). Til som standard."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Vis Dolphins brugerflade ud over spilskærmen."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "Vis FPS-overlay i spillet."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Vis Ryujinx' fejlfindingskonsol."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Vis et styringsbillede oven på rammen."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Vis en notifikation, når en controller tilsluttes eller frakobles."

msgctxt "game_options"
msgid "Show core specific notifications."
msgstr "Vis kernespecifikke notifikationer."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Vis emulatorens brugerflade."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Vis emulatorens notifikationer, aktiveret som standard (AUTO)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Vis emulatorens notifikationer."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Vis spilinformation i øverste venstre hjørne af Craft."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Vis information om shader-kompilering."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Vis information om det aktuelle skærmlayout i øverste højre hjørne."

msgctxt "game_options"
msgid "Show notifications."
msgstr "Vis notifikationer."

msgctxt "game_options"
msgid "Show or crop overscan. 'Auto' will try to adapt to game, cropping empty areas."
msgstr "Vis eller beskær overscan. »Auto« forsøger at tilpasse sig spillet og beskærer tomme områder."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "Vis eller skjul RetroArch-indstillinger. »Auto« er den anbefalede indstilling."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Vis overlay med ydeevnestatistik i spillet."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Vis notifikationer om shader-kompilering."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Vis de vandrette kanter. AUTO beskærer dem til det område, spillet bruger, bedst med DOT CLOCK PAR."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Viser et Amiga-tastatur nederst på skærmen til at skrive med pad'en. Slå det til/fra med en tildelt knap, flyt med D-pad'en eller stikket, og tryk på en anden knap for at skrive tasten."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Viser skudhuller på vægge, hvor skuddene rammer."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Viser drevaktivitet og ydeevneinformation over billedet."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "Viser udvidede PAL CRT-linjer, men de er normalt tomme i de fleste spil."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Viser disketternes navne, drevlamper og hastighed i vindue og fuldskærm."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Viser WHDLoad-konfigurationsskærmen, når et spil understøtter det."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Viser WHDLoad-prompten og venter på et tryk på en knap, før spillet starter. Fra som standard, så spillet starter med det samme."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Formindsk/forstør tatoveringen, så den passer inden for rammens kant."

msgctxt "game_options"
msgid "Significantly improves performances for CPU with 3+ cores."
msgstr "Forbedrer ydeevnen betydeligt for CPU'er med 3+ kerner."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "Simulér CRT-fosforets efterbilleder. »Simpel« blander det aktuelle og det forrige billede 50:50."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "Simulér efterbilleder på LCD-skærme."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Simulér effekter, der er særlige for PowerVR2-GPU'en og analoge videosignaler."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simulér farverne på Game Boy Color-LCD-skærmen."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "Simulerer CRT-efterbilleder, kan bruges til at undgå flimmer."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Simulerer efterbilleder, kan hjælpe med at mindske flimmer."

msgctxt "game_options"
msgid "Simulates stereo output."
msgstr "Simulerer stereoudgang."

msgctxt "game_options"
msgid "Single Field applies a de-interlacing filter, Double Field mimics the original hardware."
msgstr "Enkelt felt anvender et deinterlace-filter, dobbelt felt efterligner den originale hardware."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Størrelse på menuer og paneler. Begrænses af spillet til den største skala, der passer til den interne opløsning."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Størrelse på spillets pixels: højere værdier zoomer ind og viser en mindre del af kortet. Standard: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "Størrelse på den største skærm ved brug af et hybrid skærmlayout."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Størrelse på den sekundære skærm i forhold til den primære (kun top/bund-layouts)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Vinduets størrelse, når det ikke er i fuldskærm."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Størrelsesforhold mellem de 2 emulerede skærme."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "Spring VBI over, når der registreres forsinkelse; hjælper på hakkende lyd, når emuleringshastigheden falder."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Spring tegning af et billede over, der er identisk med det forrige. Kan forbedre ydeevnen."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Spring billeder over for at undgå knasende lyd på langsomme enheder."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Spring billeder over for at forbedre ydeevnen på bekostning af hakkende bevægelse."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Spring de 60 sekunders venten på andre kabinetter ved opstart over. Deaktivér ved spil med flere kabinetter."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "Spring BIOS-opstartslogoet over."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Spring den opstartskontrol over, der forhindrer spillet i at starte."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Spring hardwarekontrollerne ved opstart over (kamera, rat, kortlæser)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Spring den lange initialisering af styremotoren ved opstart over. Vælg dit spils revision."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Spring diskettedrevets mekaniske ventetid over. Indlæsningen er meget hurtigere, selve disken læses stadig præcis som originalen."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Spring startvideoer og logo over."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Spring startvideoerne over."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Spring initialiseringen af styremotoren ved opstart over."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Spring videoer/FMV'er over."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "Springer tegning af overflader over i det område, der er angivet til venstre og højre."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Springer BIOS-startanimationen over, der vises ved indlæsning af indhold."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Springer BIOS-startanimationen over, der vises ved indlæsning af indhold. Slå fra for at nå PS2-systemindstillingerne og hukommelseskortstyringen."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Springer BIOS-startanimationen over ved indlæsning af indhold."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Plads, hvor diskbillederne monteres. AUTO vælger den ud fra billedtypen. Skift kun, hvis et spil nægter at starte."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Langsommere, men kræves af nogle få spil, der afhænger af cacheadfærd."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Udglat 3D-teksturer."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Udglatter ændringer i styringen. Nødvendigt ved brug af gamepad eller tastatur."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Udglatter kanterne med en shader, blødgør billedet en smule."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Udglatter den lyd, Paula-chippen frembringer. »Sinc« er den mest raffinerede og den mest krævende."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Blødgør gamepadens styring i racerspil. Kraftig som standard, ingen effekt på et rat."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Nogle SPU-trin er følsomme over for kapløbstilstande, og at tillade et begrænset antal ad gangen hjælper med at mindske ydeevnestop. En mindre værdi kan forbedre ydeevnen og mindske hakken i nogle spil."

msgctxt "game_options"
msgid "Some games accept input from port 2 instead of port 1."
msgstr "Nogle spil accepterer input fra port 2 i stedet for port 1."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Nogle spil kan ikke indlæses, hvis systemet tændes med en CD isat. »JA« indsætter CD'en under startanimationen."

msgctxt "game_options"
msgid "Some games have graphic and/or speed issues without Cycle-exact."
msgstr "Nogle spil har grafik- og/eller hastighedsproblemer uden cykluspræcis."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Nogle spil kræver en bestemt tast for at udføre visse handlinger; angiv den tast, der skal tildeles SELECT-knappen på spiller 1's controller."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Nogle spil kræver inverteret akse for pistoler."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Nogle spil kræver Game Drive-udvidelsen."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Nogle spil kræver controlleren i anden port for at kaste granater."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Nogle gearstænger er forbundet til computeren med et andet enheds-ID end rattet, f.eks. Thrustmaster-stænger."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Nogle homebrews og ROM-hacks kræver et bestemt RAM-mønster ved opstart. Genstart kræves."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be disabled."
msgstr "Nogle homebrews eller rom-hacks kræver, at denne indstilling er deaktiveret."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Nogle homebrews eller rom-hacks kræver, at denne indstilling er aktiveret."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "Lydkilde for MIDI-musik. MT-32-indstillingerne kræver de tilsvarende Roland-ROM'er i bios-mappen."

msgctxt "game_options"
msgid "Space/Enter/Fire works as WHDLoad start button."
msgstr "Mellemrum/Enter/Skyd fungerer som WHDLoads startknap."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Angiver, hvordan emuleringen af realtidsuret i visse spil skal fungere."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Angiver, hvilken tilføjelse der skal bruges til afspilning af lyd-CD i patchede MD-spil."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Angiv den IPS-patch, der skal aktiveres; hvis ikke angivet, bruges alle patches defineret i ips .ini."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Angiv filteret til opskalering."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Angiv sti til rammen."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Angiv sti til firmwarefilen."

msgctxt "game_options"
msgid "Specify the Amiga system model to emulate."
msgstr "Angiv den Amiga-systemmodel, der skal emuleres."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Angiv den computermodel, der skal emuleres."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "Angiv metoden til videorendering. Præcis er den mest nøjagtige, men langsommere; god og hurtig er hurtigere, men kan fejle i nogle spil."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Talemodul installeret."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Hastigheds-hack, men måske ikke kompatibel med nogle spil."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Hastigheds-hack, kan hjælpe langsomme spil på bekostning af fejl."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Hastigheds-hack."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Hastighed for musen med analogt stik."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Hastighed for den emulerede Amiga-mus."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Hastighed for musemarkøren, der flyttes med venstre stik."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Gør GD-ROM-indlæsning hurtigere, kan ødelægge nogle spil."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Gør diskindlæsning hurtigere. Kan ødelægge nogle kopibeskyttede spil."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Gør adgangen til disketter hurtigere for at mindske indlæsningstiden."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Deler renderingen over flere CPU-tråde. Kun nyttigt med høje interne opløsninger."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Lad rattet fjedre tilbage til midten, mens spillet ikke sender force feedback, ligesom den mekaniske fjeder i et arkadekabinet."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Standard diskettecontrollerkort."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Start direkte i Commodore 64-tilstand."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Start controlleren med stikkene allerede aktiveret i stedet for at skulle trykke på ANALOG-knappen i spillet."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Start disken direkte i stedet for at vente i PLAY CD-I-menuen. Til som standard."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Start spillet i testtilstand. Test: tast 0 eller R3, service: tast 9 eller L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Starter Outrun 2 SP SDX uden kabinetkontroller (drivkort og tårn)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Starter Wii-menuen (menuen skal være installeret i Dolphin)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Dødzone for styreaksen, til pads eller rat uden selvcentrering."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Gem BC1-teksturer i 16 bit. Sparer videohukommelse for en lille kvalitetsomkostning."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Styrken af controllerens vibration. 60% som standard."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Styrken af pistolens rekylmotor. 60% som standard."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Stræk menuer og 2D-skærme til den fulde skærmbredde."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Stræk pixels lodret som i det originale DOS-spil på en 4:3-skærm. Standard: aktiveret."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Stræk billedet, så det fylder skærmen, uden hensyn til billedformatet."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Stræk billedet til hele skærmen i stedet for at bevare formen på en skærm fra perioden."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Studie: TV-niveauer fra en rigtig afspiller, sort ser mørkegrå ud på en pc-skærm. Fuldt område: dyb sort."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Supersample framebuffer-effekter, kan give artefakter."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Surround afspiller de bageste højttalere fra Model 3-kabinetterne med fire højttalere (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) på bageste højttalere. Andre spil forbliver i stereo."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Byt paddle 1 og paddle 2, kræves af nogle få spil, der forventer akserne omvendt."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Byt controllerens A- og B-knapper."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Byt controllerens A/B- og X/Y-knapper."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Byt TV- og GamePad-skærmene i layouterne side om side, top/bund og billede i billede."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Bytter de to Amiga-porte. Kræves af nogle få spil, herunder flere peg-og-klik-titler."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Byt pistolindeks mellem spiller 1 og spiller 2."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Slå til for at bruge RetroBats mappe »saves\switch« til Citron- og Eden-gemmefiler (i stedet for emulatormappen)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Skift spiller 1's controllertype til ingen, hvis de rigtige tastaturinput ikke læses."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Slå dette til for at aktivere servicemenuen via R3 og L3."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Slå dette til for at aktivere servicemenuen."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Slå dette til for at bruge D-pad i stedet for venstre analoge stik."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Slå denne indstilling til for at deaktivere fuldskærm og køre emulatoren i vindue."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Skift denne for at bruge lyspistol 1 til spiller 2 og lyspistol 2 til spiller 1."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "At slå dette til ved brug af en særskilt deinterlace-tilstand kan hjælpe med at mindske sløring."

msgctxt "game_options"
msgid "Sync to exact content framerate. Only for G-Sync/FreeSync/HDMI-2.1-VRR compatible monitors."
msgstr "Synkronisér til indholdets præcise billedhastighed. Kun til skærme, der er kompatible med G-Sync/FreeSync/HDMI-2.1-VRR."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "Systemkort, der bruges af de LD-ROM2-spil, der kræver et. Standard: SYSTEM CARD 1, hvis syscard1.pce ligger i bios-mappen."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "Stikadapter til TI-99 Speech Synthesizer."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "TOS 1.06 er kun til STE: hvis maskintypen ikke er angivet, vælges STE automatisk."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Sigt efter 60fps i stedet for de native 59,73fps."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 spillere i White Men Can't Jump og NBA Jam T.E. Roterende: Tempest 2000, styret med musen."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "Amigaen sender sine kanaler helt til venstre og helt til højre. At sænke denne blander dem og er langt mere behageligt med hovedtelefoner. 10 er den originale hardwares adfærd."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "Amigaen sender sine kanaler helt til venstre og helt til højre. At sænke denne blander dem og er langt mere behageligt med hovedtelefoner. 100% er den originale hardwares adfærd."

msgctxt "game_options"
msgid "The CGA variation that is being emulated."
msgstr "Den CGA-variant, der emuleres."

msgctxt "game_options"
msgid "The Neo Geo CD bios used by the emulator."
msgstr "Den Neo Geo CD-bios, emulatoren bruger."

msgctxt "game_options"
msgid "The Neo Geo bios used by the emulator. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Den Neo Geo-bios, emulatoren bruger. UNIVERSE BIOS giver generelt den bedste kompatibilitet."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Neo Geo-tilstanden. UNIVERSE BIOS giver generelt den bedste kompatibilitet."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "RetroBat-holdet har lavet profiler til nogle almindelige controllere; de ligger i mappen »saves\mame\ctrlr«. BRUGERDEFINERET kan bruges til at gemme egne tildelinger."

msgctxt "game_options"
msgid "The SVGA variation that is being emulated."
msgstr "Den SVGA-variant, der emuleres."

msgctxt "game_options"
msgid "The SoundBlaster emulated FM synth mode."
msgstr "SoundBlasters emulerede FM-synthtilstand."

msgctxt "game_options"
msgid "The amount of high memory size the emulated machine has."
msgstr "Størrelsen på den emulerede maskines høje hukommelse."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "Mængden af videohukommelse."

msgctxt "game_options"
msgid "The aspect ratio that's used by the Widescreen Hack."
msgstr "Det billedformat, der bruges af widescreen-hacket."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "Den bios, emulatoren bruger."

msgctxt "game_options"
msgid "The color scheme for Hercules emulation."
msgstr "Farveskemaet for Hercules-emulering."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "Driveren »xinput« aktiverer funktioner som vibrationseffekter. Vælg »sdl« for kompatibilitet med en bred vifte af controllere."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "Spillets region skal svare til Wii-menuens region, ellers genkendes spillet ikke."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Jo højere værdien er, desto længere væk vises objekter."

msgctxt "game_options"
msgid "The maximum RAM memory available for the system."
msgstr "Den maksimale RAM-hukommelse, der er tilgængelig for systemet."

msgctxt "game_options"
msgid "The normal core can be more stable when running installed OS."
msgstr "Den normale kerne kan være mere stabil ved kørsel af installeret OS."

msgctxt "game_options"
msgid "The raw performance to emulate."
msgstr "Den rå ydeevne, der skal emuleres."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "Spiller 1's højre analoge stik styrer det andet joystick i spil med dobbelt stik (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "Højre stik bruges som højre D-pad (også på L2, R2, L3 og R3)."

msgctxt "game_options"
msgid "The type of emulated graphic chip."
msgstr "Typen af emuleret grafikchip."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "Der er en fejl i nogle spil, hvor mere end 1 aktiv enhed får emulatoren til at gå ned."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Tykkelsen af den hvide kant, der tegnes, når en Sinden-pistol er tilsluttet. Normal (12 pixels) som standard."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Dette er nyttigt i racerspil for at gøre styringen mindre »nervøs«, når der styres med controller."

msgctxt "game_options"
msgid "This option can be used to override PAL timings to run games with NTSC timings."
msgstr "Denne indstilling kan bruges til at tilsidesætte PAL-timing for at køre spil med NTSC-timing."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Denne indstilling ændrer Yamaha-lydkortet på den emulerede pc. OPN er standard. OPNA-lyd understøtter flere FM-kanaler og PCM-samples."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Denne indstilling styrer SPU-analysatoren, især størrelsen på kompilerede enheder. Brug sikker tilstand for maksimal kompatibilitet."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "Denne indstilling skal være deaktiveret for at spille SIGIL."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Denne indstilling påvirker kun Gamecube-controlleren."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Denne indstilling vælger, om PCG-8100 skal emuleres eller ej. Den kan være nødvendig for noget software i PC-8000-serien."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Denne indstilling sætter den emulerede pc's CPU-urhastighed."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Denne indstilling sætter den emulerede pc's CPU-urhastighed. Overclock-indstillingerne får det meste software til at køre hurtigere end normalt."

msgctxt "game_options"
msgid "This option specifies which lock-on cartridge to emulate."
msgstr "Denne indstilling angiver, hvilket lock-on-modul der skal emuleres."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "Denne indstilling kan kun bruges med filteret »scanlines«."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Denne indstilling forhindrer pause i emuleringen, når fokus mistes."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Denne indstilling roterer dit Windows-skrivebord; det stilles ikke tilbage, når spillet afsluttes."

msgctxt "game_options"
msgid "This should only be disabled when playing ROM hacks."
msgstr "Dette bør kun deaktiveres, når der spilles ROM-hacks."

msgctxt "game_options"
msgid "This should only be disabled when playing certain demos and homebrews for correct operation."
msgstr "Dette bør kun deaktiveres, når der spilles visse demoer og homebrews, for at de virker korrekt."

msgctxt "game_options"
msgid "This will replace the BIOS CD-ROM busy loop with a STOP instruction."
msgstr "Dette erstatter BIOS'ens CD-ROM-venteløkke med en STOP-instruktion."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Dette kører spillet uden nogen valgte grafik- eller CPU-forbedringer."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "Dette kører konsollens BIOS i stedet for et spil."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Tærskel, hvor bevægelse af det analoge stik tæller som en digital retning."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Sænk antallet af emulerede CPU-cyklusser dynamisk, hvis din værts-CPU ikke kan følge med (deaktiveret som standard)"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Vippeinput til Kirby Tilt 'n' Tumble og andre MBC7-spil. Analogt stik som standard."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "Trapdoor-udvidelses-RAM som i den klassiske A501-udvidelse."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Forsøg at køre spillets installation."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Forsøg at registrere løkkebetingelser i SPU-kerner og bruge dem som planlægningstips. Standard fra"

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "Forsøg at registrere spillet og anvende en controllertildeling."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Forsøg at vælge den bedste opdateringshastighed til ROM'en."

msgctxt "game_options"
msgid "Try to use legacy dosbox.conf config file instead of core options."
msgstr "Forsøg at bruge den ældre konfigurationsfil dosbox.conf i stedet for kerneindstillinger."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "TurboTap kræves for at spille med mere end én spiller. Aktiveres automatisk, når en anden controller tilsluttes."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Slå emulatornotifikationer til: tilsluttede controllere og beskeder om shader-kompilering."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Drejehastighed med musen. Standard: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Slå dette til for kun at tildele D-PAD'en til retninger."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Slå dette til ved brug af en lyspistol, der ikke understøtter genladning uden for skærmen."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "At slå denne indstilling til får MAME til at rapportere musebevægelser og knaptryk på forskellige mus uafhængigt af hinanden."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Gør højre stik til en Amiga-mus, nyttigt til menustyrede spil og peg-og-klik-spil uden at slippe pad'en."

msgctxt "game_options"
msgid "Tweak the behavior of the 3Dfx Voodoo emulation."
msgstr "Justér adfærden for 3Dfx Voodoo-emuleringen."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "To lag som standard (bit-eksakt). Sorteret retter stablet røg og glas, skaktern genskaber arkadekortet (sne og tåge i Sega Rally 2)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Den type APPLE II, der skal emuleres."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Den type Archimedes-computer, der skal emuleres."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Den type BBC micro, der skal emuleres, standard er MODEL B."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Den type CPU-emuleringskerne, der skal bruges."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Den type Color Computer, der skal emuleres, standard er coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Den type computer, der skal emuleres."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Den type FM Towns, der skal emuleres, standard er FM TOWNS (MODEL 1/2)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Den type FM-7, der skal emuleres, standard er FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "Typen af frameskip."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Den type LYNX, der skal emuleres, standard er 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "Typen af ROM-fil"

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Den type V.Smile, der skal emuleres."

msgctxt "game_options"
msgid "Type of emulated SoundBlaster card."
msgstr "Typen af emuleret SoundBlaster-kort."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "Typen af joystick tilsluttet spilporten."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Ophæver spillets billedhastighedsloft, hvis der findes en patch i den interne database."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Lås yderligere sprog op i nogle spil, hvis kernens database har en post for det."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Øg CPU-frekvensen fra 93,75 til 125 MHz. Kan øge hastigheden i nogle CPU-afhængige spil."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Opskalér spillets teksturer med et pixel art-filter."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Opskaleringsfilter for 2D-lagene (HUD, baggrunde)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Opskaleringsfilter for 2D-lagene (HUD, baggrunde). Kun Vulkan og OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Brug »SYD« til A-knappen og »VEST« til B-knappen."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Brug mappen »cfg64« til MAME standalone."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Brug »brugerdefineret« sigtekorn for at aktivere den valgte sigtekornsfil."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Brug »brugerdefineret« sigtekorn for at aktivere den fil, der er valgt her."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Brug »pr. spil«, hvis du har gemt en profil til spillet i mappen capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Brug 50 til europæisk konsol og 60 til japansk konsol."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Brug 8mhz for bedre kompatibilitet."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Brug det analoge stik som D-PAD."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Brug DSI til DSI-spil som DSI Ware."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Brug KUN JOYSTICK til joystickspil og KUN TASTATUR til tastaturspil."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Brug venstre analoge stik i stedet for D-PAD til styring."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Brug R1 og L1 til at speede op og bremse i racerspil, kun kompatibel med »auto«-gearskifte."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Brug Resizable BAR til GPU-uploads, når det er tilgængeligt. Deaktivér, hvis du oplever hakken eller ustabilitet med din driver."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Brug SDL til alle controllere i stedet for XInput til Xbox-controllere."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Brug SGB2-timing og -adfærd."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Brug SSE4 i stedet for AVX2 til ældre CPU'er."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Brug et filter i høj opløsning til at forbedre renderingen."

msgctxt "game_options"
msgid "Use a mouse-controlled Lightgun or Touchscreen input."
msgstr "Brug en musestyret lyspistol eller touchskærm-input."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Brug en foruddefineret farvepalet i stedet for den, emulatoren beregner."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Brug alternativ dybdebehandling; aktivér, hvis der er grafikproblemer eller en bestemt fejlmeddelelse."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Brug ampersand og parentleft til start og mønter."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Brug en ekstern firmware (standard er »firmware.bin« i bios-mappen)."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Brug det analoge stik i stedet for d-pad."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Brug bilineær filtrering til at udglatte hele billedet."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Brug bios til visse systemer som Neo Geo og Sega ST-V"

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Brug en knap til at genlade i stedet for skud uden for skærmen for pistoler, der ikke understøtter det."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Brug knapper i stedet for en analog akse til rattet."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Brug computerens standard lydinputenhed som mikrofon."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Brug hat til bevægelse ud over joystick."

msgctxt "game_options"
msgid "Use input directly sends by keyboard to the core."
msgstr "Brug input sendt direkte fra tastaturet til kernen."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Brug fortolker for bedste kompatibilitet, dynarec for ydeevne."

msgctxt "game_options"
msgid "Use interpreter for best compatibility."
msgstr "Brug fortolker for bedste kompatibilitet."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Brug venstre analoge stik ud over d-pad."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Brug venstre analoge stik i stedet for D-PAD."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "Brug venstre stik som d-pad."

msgctxt "game_options"
msgid "Use native texture LOD computation when upscaling."
msgstr "Brug nativ beregning af tekstur-LOD ved opskalering."

msgctxt "game_options"
msgid "Use official BIOS and bootloader for emulated hardware."
msgstr "Brug officiel BIOS og bootloader til den emulerede hardware."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Brug ét delt hukommelseskort til alle spil i stedet for ét kort pr. spil. Kortene gemmes i »\bios\pcsx2\memcards«."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Brug pixelpræcis emulering, hvor det er muligt."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Brug portene 5-8 til GameCube-controllere i Wii-tilstand."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Brug præemptive billeder i stedet for run-ahead; antallet af run-ahead-billeder gælder."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Brug rigtige GameCube-controllere gennem en GameCube-adapter. Kun med rigtige Wiimotes."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Brug skulderknapper til L og R i stedet for aftrækkere."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "Brug skulderknapper i stedet for aftrækkere."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Brug HD-pakkernes 3D-modeller i stedet for sprites (OpenGL-renderere). Aktiveret som standard."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "Brug BIOS'en i RetroBats »bios«-mappe; kræves for at starte i BIOS."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Brug BIOS'en i RetroBats »bios«-mappe."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Brug værdien HØJ FREKVENS til skærme med højere opdateringshastighed."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Brug rammerne fra Odin-artworkpakken (emulatorens artwork-mappe) i stedet for RetroBats dekorationer."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Brug compute shader-rendereren i stedet for den klassiske OpenGL-renderer. Hurtigere ved høje interne opløsninger, kræver OpenGL 4.3."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Brug emulatorens indbyggede BIOS i stedet for filerne i bios-mappen. DS Download Play kræver den originale BIOS og firmware."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Brug HD-pakkernes teksturer i høj opløsning (OpenGL-renderere). Aktiveret som standard."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Brug musen som Apple II-paddles, kræves af Arkanoid, Breakout og de andre spil, der styres med drejeknap. Markørens position på skærmen er paddlens position. Erstatter controllerens stik for paddle 1 og 2; lad være slået fra til joystickspil."

msgctxt "game_options"
msgid "Use the older and less compatible faster blitter"
msgstr "Brug den ældre og mindre kompatible, hurtigere blitter"

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Brug de indstillinger pr. spil, der er gemt i Vita3K-brugerfladen. De tilsidesætter RetroBats indstillinger for dette spil."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Brug den simple double hi-res-farvetabel. Nogle få Apple II-programmer ser tættere på den rigtige maskine ud med den."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Brug dette, hvis emulatoren går ned efter indlæsning eller ikke viser noget."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Brug kun dette, hvis det analoge stik driver."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Brug denne indstilling, hvis ArcadeDuck ikke vises på den rigtige skærm."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Brug denne indstilling, hvis Keisho ikke vises på den rigtige skærm."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Brug denne indstilling, hvis Odin ikke vises på den rigtige skærm."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Brug denne indstilling, hvis PCSX2 ikke vises på den rigtige skærm."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Brug denne indstilling, hvis duckstation ikke vises på den rigtige skærm."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Brug denne indstilling, hvis p1 og p2 er byttet om."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Brug denne indstilling ved brug af en pad, der genkendes som tastatur (ipac osv.)."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Brug denne indstilling ved brug af et rat uden manuel gearstang."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Brug denne indstilling til flyspil."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Brug denne indstilling til at sænke eller øge lysstyrken, ikke kompatibel med videodriveren »gdi«."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Brug denne indstilling til at sænke eller øge kontrasten, ikke kompatibel med videodriveren »gdi«."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Brug denne indstilling til at sænke eller øge gamma, ikke kompatibel med videodriveren »gdi«."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Brug denne indstilling til at angive en standardknap, der får turbo."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Brug denne indstilling til at ignorere run.bat-, autoexec.bat- eller dosbox.bat-filer i spilmappen."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Brug denne indstilling til at mindske inputforsinkelsen."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Brug denne til automatisk at indlæse indhold som HD-pakker."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Brug winkey til tastatur, xinput hvis du har en XBOX-controller, sdl til andre typer controllere."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Brug din egen .cfg-fil i saves\mame\cfg. Omtildelinger med TAB i spillet bevares. Ved første aktivering importeres tildelingen fra sidste session automatisk. Indstillingen for controllerlayout gælder ikke længere for dette spil."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Nyttigt til spil med skærmrysteeffekter som Wipeout Fusion, kan gøre billedet sløret."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Nyttigt til processorer med én tråd."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Nyttigt på nogle skærme med høj opdateringshastighed for at fjerne efterbilleder."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Nyttigt ved brug af højere opløsning end skærmen. Undgår moiré-effekt."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Bruger 60hz (480i) i stedet for 50hz (576i)."

msgctxt "game_options"
msgid "Uses the proper mipmap levels. Enhance graphics accuracy."
msgstr "Bruger de korrekte mipmap-niveauer. Forbedrer grafikkens nøjagtighed."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "Emulering af VI-efterbehandlingsfilter."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Værdier over 1.00 øger størrelsen, værdier under formindsker den."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "Lodrette spil vises på den skærm, der svarer til det valgte indeks."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD er et forbedret videokort, som en håndfuld moderne demoer bruger. Ændring genstarter maskinen."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Videotilstande, konsollen tilbyder spillene. HD-tilstande kræver HDTV-videosignalet."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Visningsopsætning, bordet bruger. AUTO følger SKÆRMOPSÆTNING: skrivebord for én liggende skærm, fuld enkelt skærm for én lodret skærm, kabinet for flere skærme (skrivebord når SKÆRMOPSÆTNING ikke er angivet)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Rotér D-pad'en virtuelt, når skærmen roteres."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Lydstyrke for den emulerede klikkelyd fra diskettedrevet."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Lydstyrke for musikkortet i de spil, der har et (Daytona USA, Sega Rally). 100% som standard."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Kun Vulkan, langsommere men mindre forsinkelse."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Kun Vulkan. Forbedrer ydeevnen og retter mange grafiske problemer, men kan være ustabil på nogle GPU'er. Ikke-understøttede metoder falder automatisk tilbage."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Kun Vulkan: beder videodriveren om at bruge en bestemt buffertilstand."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Hvad der er tilsluttet Amigaens første port. De fleste spil bruger joysticket i port 2 og musen i port 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Hvad der er tilsluttet Amigaens anden port."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Hvad der er tilsluttet Amigaens anden port. Standard er Joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Hvad den anden port modtager, når en anden pad tilsluttes."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Når en adresse indtastes, sættes tilstanden automatisk til »MANUEL«."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "Når den automatiske registrering mislykkes."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Foretræk eksklusiv fuldskærm for emulatorer, når det er muligt."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "Når aktiveret, har hvert spil sin egen VMU i port 1."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "Når »MANUEL« vælges, angives en adresse i den næste indstilling."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "Når hastighedsbegrænsning er deaktiveret, kører MAME emuleringen så hurtigt som muligt."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Ved brug af .m3u-fil: vælg det diskindeks, der skal køres."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Ved brug af markør-joystick skal knapperne tildeles taster i RetroArch."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "Ved brug af XInput bytter denne indstilling gamepad 1 og 2."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Ved brug af en Sinden-pistol lukkes Lightgun-softwaren, når spillet slutter."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Ved brug af tildeling fra fil for arkadesystemer: angiv det layout, der skal bruges."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "Ved brug af rigtige Wiimotes: angiv typen af Wiimote."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "Ved brug af software, der kræver fuldt tastaturinput, anbefales det også at bruge spilfokustilstand."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Hvor DMD'en vises. AUTO: på spillepladen med 1 skærm, nederst på backglass-skærmen med 2 skærme, på sin egen skærm med 3 skærme. Kræver SKÆRMOPSÆTNING."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Hvilken RetroPad der styrer hvilken Amiga-port. Lad stå på Automatisk, medmindre spillerne er byttet om."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Hvilken disk i et spil med flere diske, der indsættes ved start. POM2 indlæser én disk ad gangen, de andre skiftes fra menuen i spillet."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Hvilken disk i et spil med flere diske, der indsættes ved start: altid den første eller den, der var i drevet, da du sidst afsluttede."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Hvilken frontknap der bekræfter i PS3-systemdialoger. Japanske spil forventer generelt Cirkel, vestlige spil Kryds. Lad stå på AUTO for at følge den valgte region."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Hvilket diskettedrev menuen til diskskift virker på."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Hvid kant tegnet af emulatoren, kræves af Sinden-pistoler for at sigte."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Bredden af den hvide kant, der tegnes, når en Sinden-pistol er tilsluttet. 16 pixels som standard."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Bredden af den hvide kant, der tegnes, når en Sinden-pistol er tilsluttet. 2 pixels som standard."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Kører XBOX-processen på flere CPU-tråde, kan forbedre ydeevnen, men ødelægge nogle spil."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Omgåelse, som nogle få homebrews og ROM-hacks kræver."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Omgår firmwarefejl i nogle rat, der giver korte afbrydelser i kraften. Lad være slået fra, medmindre det er nødvendigt."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Skriver Amiberry.log i emulatormappen. Kun nyttigt ved fejlrapportering, gør tingene en smule langsommere."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Skriver dybdebufferværdier til vm-hukommelsen. Standard fra."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Skriver inputhændelser til en logfil i gemmemappen. Kun nyttigt ved fejlrapportering."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "Z80 SoftCard kører CP/M-software. Lydkortene kan tilføjes her som et ekstra kort. Ændring genstarter maskinen."

msgctxt "game_options"
msgid "Zooms in to hide black borders."
msgstr "Zoomer ind for at skjule sorte kanter."

msgctxt "game_options"
msgid "Zooms in to hide black borders. Borders are different per game."
msgstr "Zoomer ind for at skjule sorte kanter. Kanterne er forskellige fra spil til spil."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "Zorro II-udvidelses-RAM. Kræves af mange WHDLoad-titler, men nogle få originale diskettespil nægter at starte med den."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "Zorro II-udvidelses-RAM. Kræves af mange WHDLoad-titler."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Zorro III-hukommelse, kun brugbar på en accelereret maskine. Lad stå på ingen, medmindre en bestemt titel beder om det."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Zorro III-hukommelse. Nyttig til Workbench-opsætninger og nogle få demoer."

msgctxt "game_options"
msgid "use this to automatically start to a specified level."
msgstr "brug dette til automatisk at starte på en bestemt bane."
