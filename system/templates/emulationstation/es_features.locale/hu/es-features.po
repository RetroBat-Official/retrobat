# FEATURES - DESCRIPTIONS
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "Az '1x' a meghajtó valós sebessége. A 'Turbo' szinte azonnal tölt, de néhány játék ezt észleli és megtagadja az indulást."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "Az '1x' a meghajtó valós sebessége. A 'Turbo' kikapcsolja a lemezforgás emulációját és szinte azonnal tölt, de néhány játék ezt észleli és megtagadja az indulást."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "A 'Pontos' megfelel a hardvernek, de a mentési/betöltési képernyőkön erősen csökkentheti a képfrissítést. Csak akkor módosítsa, ha egy menü lassú."

msgctxt "game_options"
msgid "'Auto' defaults to the most compatible version for the model."
msgstr "Az 'Auto' a modellhez legkompatibilisebb verziót választja."

msgctxt "game_options"
msgid "'Auto' is the default floppy speed (300RPM). 'Turbo' removes disk rotation emulation."
msgstr "Az 'Auto' a floppy alapértelmezett sebessége (300 RPM). A 'Turbo' kikapcsolja a lemezforgás emulációját."

msgctxt "game_options"
msgid "'Auto' will controls the half-screen fix detection on texture shuffling."
msgstr "Az 'Auto' a félképernyős javítás észlelését vezérli a textúrakeverésnél (texture shuffling)."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "A 'Kompatibilis' szinte minden játékhoz megfelel. A 'Ciklus-pontos' a legpontosabb, de gyors PC-t igényel. A 'Gyors' feloldja a CPU sebességét, és elronthatja az időzítésre érzékeny játékokat."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "A 'Dupla' tiszta, modern képet ad. A scanline módok a CRT monitor megjelenését idézik."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "A 'Dual Stick' a 2. játékos joystickját az 1. játékos jobb analóg karjára képezi le, a 'Swap Ports' javítja a portcserét a 'Wizard of Wor' játéknál."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "A 'Pontos' a leghűbb Paula emuláció. Csak akkor csökkentse, ha lassú PC-n akadozik a hang."

msgctxt "game_options"
msgid "'Games Express' is needed for several unlicensed games."
msgstr "A 'Games Express' több licenc nélküli játékhoz szükséges."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "A 'Joystick' a klasszikus 2 gombos kar, amelyet minden játék megért. A 'CD32 kontroller' hozzáadja a színes gombokat, és CD32-n automatikusan kiválasztódik."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "A 'BE' minden fizikai billentyűzet-eseményt továbbít a magnak. A 'KI' megakadályozza, hogy a RetroPad gombjai billentyűzet-eseményeket generáljanak."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "Az 'ELŐRE DEFINIÁLT' az emulátor 'cfg' mappájában lévő konfigurációs fájlokat használja, a 'DINAMIKUS' a 'VEZÉRLÉS' speciális beállításaiban kiválasztott profil alapján hozza létre a konfigurációt."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "A 'Biztonságos' javítja a textúrahibákat egyes játékokban, jelentős teljesítményveszteség árán."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "A 'Sablonok' opció az 'emulators\m2emulator\templatescfg' mappában lévő fájlokat másolja a dinamikus automatikus konfiguráció helyett."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "A 'Tripla puffer' és az 'Igazítás az emulált tartalomhoz' csak Vulkan videó illesztővel érhető el."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "A 'Turbo' kikapcsolja a keresési késleltetés emulációját."

msgctxt "game_options"
msgid "'Weave' should only be used with 1x scaling factor and CRT shaders."
msgstr "A 'Weave' csak 1x-es skálázási tényezővel és CRT shaderekkel használható."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "Az 'XINPUT' kényszeríti az XInput API használatát a kompatibilis kontrollereknél."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "A 'directx11' az alapértelmezett, és szinte minden hardveren működik. A 'vulkan' gyorsabb lehet újabb videokártyákon. Egyes libretro magok a saját illesztőjüket kényszerítik."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8 MB Fast RAM (CD32FR). Alapértelmezetten ki, az eredeti CD32-nek megfelelően."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "A 0 a legalacsonyabb minőség, késleltetés és CPU-használat, a 10 a legmagasabb minőség, késleltetés és CPU-használat."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "Modern kontrollerekhez 130-140% ajánlott."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "A 24 bit megszünteti a színsávosodást a sötét területeken és színátmeneteken. A HDR-hez HDR kijelző és a RetroArchban engedélyezett HDR szükséges, különben a mag 24 bitre vált vissza."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "A 2x megfelel a valódi meghajtónak. A nagyobb sebességek csökkentik a betöltési időt, de elronthatnak játékokat."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "32k RAM-bővítő kártya telepítve."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "Alapértelmezetten 4/3, mint az arcade monitoron. A keret csak 4/3-ban jelenik meg. A 16/9 kiszélesíti a 3D nézetet."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Néhány játékhoz ezt az opciót le kell tiltani."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Néhány játék igényli. Körülbelül 10% teljesítménybe kerül."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Néhány nagyon korai játéknak a CTIA chipre van szüksége a helyes megjelenítéshez."

msgctxt "game_options"
msgid "A shadows and colors fix needed for some games such as Tony Hawk Proving Ground."
msgstr "Árnyék- és színjavítás, amelyre egyes játékoknak, például a Tony Hawk Proving Groundnak szükségük van."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "Az ASCII a billentyűzetet a rajta lévő karakterekre képezi le. Az Eredeti pontosan az emulált gép billentyűzetét reprodukálja, amire néhány programnak szüksége van."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "Az AUTO (ajánlott) hagyja, hogy a mag a játék régiója alapján válassza ki a NAND fájlt."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "Az AUTO megjeleníti a célkeresztet egérrel célzáskor, és elrejti valódi fénypisztollyal."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "Az AUTO csak a DSi-exkluzív játékoknál vált DSi-re. DSiWare-hez kényszerítse a DSI-t."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "Az AUTOMATIKUS a program mérete alapján választja ki a bővítést. Kényszeríthető fájlnév-címkékkel, például (8k) vagy [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMATIKUS: a Vita3K maga tölti be a szükséges firmware modulokat (ajánlott). EMULÁTOR BEÁLLÍTÁSAI: a Vita3K felületén kiválasztott modulok megtartása."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "60 fps felett a képkockák interpolálva készülnek a játékfrissítések között. Az AUTO a kijelző frissítési gyakoriságát követi."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Pontos képpuffer-emuláció, nagyon lassú, de egyes játékokhoz szükséges."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "1. játékosként a játék hosztolása."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "A kontroller második gombjának funkciója: szóköz (pl. Xenon 2) vagy joystick fel (ugrás platformjátékokban)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Célzássegítő mechanizmus bekapcsolása."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Automatikus mentés bekapcsolása és a mentések közötti idő megadása."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "WiiZapper használatakor kapcsolja be a ravasz és az újratöltés gomb felcseréléséhez."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "A játéknézet igazítása szélesvásznú képernyőkhöz."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Üres 2HD mentési/felhasználói lemez hozzáadása a lemezkezelési listához."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Érintkezési árnyékok hozzáadása, hardveres renderelőt igényel."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Az egérmutató sebességének igazítása az analóg kar érzékenységéhez."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "A kimeneti színek igazítása az eredeti konzol képernyőjének utánzásához."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "A Wiimote mutató függőleges középpontjának beállítása."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "A zenei sáv hangerejének beállítása."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "A hangeffektusok hangerejének beállítása."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Sok játék által használt fejlett hangkönyvtár. Csak akkor tiltsa le, ha egy játék összeomlik vagy hangproblémái vannak."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Tárgyak célzása a kontroller giroszkópjával (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Engedélyezi, hogy az ADAM lemezekre és adatcsomagokra írjon. Az írások a saves mappában tárolt munkapéldányba kerülnek, az eredeti fájl soha nem módosul. A mag újraindítását igényli."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "DirectInput kontrollerek engedélyezése (általános USB kontrollerek, arcade karok). Csak akkor kapcsolja ki, ha egy kontroller kétszer jelenik meg."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "XInput kontrollerek engedélyezése (Xbox kontrollerek és wrapperek). Csak akkor kapcsolja ki, ha egy kontroller kétszer jelenik meg."

msgctxt "game_options"
msgid "Allow bilinear scaling on scanout."
msgstr "Bilineáris skálázás engedélyezése a képkimenetnél (scanout)."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Lehetővé teszi a textúraismétlés (texture wrapping) helyes emulációját, a teljesítmény rovására."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Lehetővé teszi, hogy a különböző felbontásokat támogató játékok meghatározott felbontásban rendereljenek."

msgctxt "game_options"
msgid "Allow gamma dither."
msgstr "Gamma dithering engedélyezése."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Natív HID támogatás engedélyezése DualShock 4, DualSense és Switch Pro kontrollerekhez. Kapcsolja ki a DirectInputra való visszaváltáshoz."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "A bal és jobb, illetve a fel és le egyidejű lenyomásának engedélyezése. Egyes játékokban mozgási hibákat okozhat."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Ellentétes irányok egyidejű lenyomásának engedélyezése."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Lehetővé teszi, hogy egyes 30 fps-es játékok 60 fps-sel fussanak."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Érvénytelen típusú textúra- és vertexlekérési konstansok engedélyezése, egyes játékokban a lekérési hibák megkerülésére használható."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Változó frissítési gyakoriság használatának engedélyezése az azt támogató kijelzőkön. VRR-t nem támogató kijelzőkön bizonyos esetekben képszakadás léphet fel."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "A térkép nagyításának és kicsinyítésének engedélyezése az egérgörgővel, mint az Enhanced Editions kiadásokban."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Lehetővé teszi az arcade kar egyedi hozzárendelését az 'arcade_sticks.json' fájl alapján."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Lehetővé teszi az egérbemenetek használatát akkor is, ha az eszköztípus nem 'RetroKeyboard/Mouse'."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "A következő floppy behelyezése a 2. meghajtóba is."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Archívumok mindig kitömörítése, akkor is, ha a dokan segítségével meghajtóbetűjelként csatolhatók lennének."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "A földön lévő tárgyak nevének mindig megjelenítése."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Az emulálandó Amiga modell. Mindegyikhez saját Kickstart ROM szükséges a bios mappában."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Az emulálandó Amiga modell. A mag újraindítását igényli. Minden modellhez megfelelő Kickstart ROM szükséges a bios\amiberry mappában."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Az Amiga port, amelybe a pisztoly csatlakozik. Szinte minden géphez a 2. port a helyes; csak az A1000 olvassa a ceruzát az 1. porton."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "A Chip RAM mennyisége. Egyes későbbi játékoknak 1 MB kell. A modell által támogatottnál több elronthatja a kompatibilitást."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "A használt RAM mennyisége."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "A figyelmen kívül hagyandó kis mutatómozgás mértéke."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Kiegészítő rezgés, amely kormányzás közben erősödik."

msgctxt "game_options"
msgid "Anti-aliased fetch filter, smooth polygons edges."
msgstr "Élsimított lekérési szűrő, simítja a poligonok éleit."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Élsimítás szintje."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Élsimítás módszere és szintje."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Az emulálandó Apple II modell. A módosítás újraindítja a gépet."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Az emulálandó Apple II modell. A PAL modellek 50 Hz-en futnak, és ezekre készültek az európai demók. A módosítás újraindítja a gépet."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "A célkereszt képére alkalmazva, hasznos a játékosok megkülönböztetéséhez."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Hatványgörbét alkalmaz a kormányzási értékekre, csillapítja a kis mozdulatokat."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Az After Burner Climax / Let's Go Jungle repülőbot- és gázkar-tengelyeire vonatkozik."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "A versenyjátékok gáz- és fékpedáljaira vonatkozik."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Gouraud árnyalás alkalmazása lapos árnyalás helyett, csak OpenGL-lel."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "CRT szűrő alkalmazása (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Barnás színszűrő alkalmazása."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "A mag által biztosított videószűrő alkalmazása."

msgctxt "game_options"
msgid "Apply a video filter to mimic various signals."
msgstr "Videószűrő alkalmazása különféle jelek utánzására."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Videószűrő alkalmazása a kimeneti képre."

msgctxt "game_options"
msgid "Apply an audio filter. 'Gaussian' reproduce the bass-heavy sound of the original hardware."
msgstr "Hangszűrő alkalmazása. A 'Gauss' az eredeti hardver mélyhangsúlyos hangját idézi."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Hangszűrő alkalmazása. Módosítja a hanginterpolációt."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Magspecifikus szűrő alkalmazása a régi jelek megjelenítésének utánzására."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Javítás alkalmazása egyes játékokhoz."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "A fenti régió alkalmazása akkor is, ha a játék saját régiót ad meg."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "A konzol analóg kimeneti fokozatát közelíti: eltávolítja az egyenáramú eltolást és lágyítja a magas frekvenciákat."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Arcade monitor megjelenés."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Arcade monitor megjelenés: scanline-ok, árnyékmaszk és ragyogás."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "A mag által megadott képarány, amelyet akkor használ, ha a JÁTÉK KÉPARÁNYA AUTO értékű."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "A konzol rendszerbeállításaiban megadott képarány."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Atari billentyűzet: az F2, F4 és F8 a játéké marad, az állapotmentések és képernyőképek ekkor AltGr+K, AltGr+L és AltGr+G kombinációt használnak."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Az átméretezés megkísérlése natív felbontáson."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Hangpuffer küszöb a kézi képkocka-kihagyáshoz."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "A hang adja a legkisebb késleltetést. A videó simább, ha a képernyő frissítési gyakorisága közel van a konzoléhoz."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Hangkimeneti frekvencia."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Az Auto (alapértelmezett) mozgásinterpolációval követi a képernyő frissítési gyakoriságát. Az Eredeti és az 57,524 Hz többszörösei G-SYNC / FreeSync képernyőt és függőleges szinkronizálást igényelnek."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "A célzási tengely automatikus középre állítása. Hasznos, ha pisztolyos játékokat gamepaddel játszik fénypisztoly helyett."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Automatikus tüzelés sebessége. A gyorsabb nem mindig jobb: egyes játékok figyelmen kívül hagyják a túl gyors bemeneteket."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: nyugat támadás, dél ugrás, kelet speciális, észak 2. támadás, L1/R1 3./4. támadás. OpenBOR standalone: ugyanazok a gombok, mint az önálló OpenBOR emulátorban."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Az Automatikus XInputot használ, ha minden kontroller XInput eszköz, egyébként DirectInputot."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automatikus: indítás merevlemezről, ha a játéknak van merevlemeze és nincs floppyja."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automatikus: csak akkor jelenik meg, ha a játéknak nincs saját célkeresztje."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Játékfejlesztések automatikus alkalmazása, ha szerepelnek a mag adatbázisában (LOD, látótávolság, FMV kihagyás)."

msgctxt "game_options"
msgid "Automatically decrease frame delay temporarily to prevent frame drops. Turn off if this worsens audio/video stuttering."
msgstr "A képkocka-késleltetés ideiglenes automatikus csökkentése a képkocka-kiesések elkerülésére. Kapcsolja ki, ha ez rontja a hang/kép akadozását."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Az FDS játék automatikus gyorsítása lemezbetöltés közben."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "A váltottsoros megjelenítést kikapcsoló patchek automatikus betöltése a játék indításakor."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Szélesvásznú patchek automatikus betöltése a játék indításakor."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Csalások automatikus betöltése és alkalmazása a játék indításakor."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Automatikusan eltávolítja az Amiga kép körüli fekete szegélyeket, így a kép jobban kitölti a képernyőt."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "A kijelző automatikus elforgatása függőleges játékokhoz."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Port0 és Port1 automatikus váltása a bemeneti aktivitás alapján."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "A lemezoldal automatikus váltása, amikor a játék kéri."

msgctxt "game_options"
msgid "Avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Elkerüli a pixelek közötti réseket felskálázáskor. Javítja a Wild Arms szövegét és a SoulCalibur szellemképét."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "A BIOS nyelve hatással lehet egyes játékok nyelvére."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "A keretek csak 4/3-ban jelennek meg."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "A bilaterális CAS ajánlott, de rontja a teljesítményt; a CAS kevésbé agresszív, de finomabb."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "A kép feketeszintje. Alapértelmezetten 50%, egy arcade felvételhez igazítva: alacsonyabb értéken sötétebb, magasabbon világosabb."

msgctxt "game_options"
msgid "Blend pixel together when in hires mode. Higher values will blur the picture more."
msgstr "Pixelek összekeverése hires módban. A nagyobb értékek jobban elmossák a képet."

msgctxt "game_options"
msgid "Blend pixels from multiple successive frames to simulate LCD ghosting."
msgstr "Több egymást követő képkocka pixeleinek keverése az LCD szellemkép szimulálására."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "A kevert mód az átlátszó poligonokat sima keverésként rajzolja az arcade sakktáblaminta helyett. Csak Model 1 és Model 2, Vulkan és OpenGL renderelőkkel."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Az emulált kijelző elmosása."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "A szomszédos pixelek elmosása áttetszőségi effektusokhoz."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "A szomszédos pixelek elmosása az SDTV felbontás szimulálására, egyes játékok igényelhetik az átlátszóság emulálásához."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Emuláció gyorsítása rendszerindítás közben."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Indítás közvetlenül a DS BIOS menübe, külső BIOS aktiválását igényli."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Indítás a Game Genie kódbeviteli képernyőre. A 'gamegenie.nes' fájlt igényli a bios mappában. Újraindítás szükséges."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Indítás a konzol BIOS menüjébe."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Indítás a valódi Jaguar BIOS-szal és annak indítóanimációjával. Egyes játékokhoz szükséges."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Megállás a hoszt hibakeresőben (vagy összeomlás, ha nincs csatolt hibakereső), ha nem implementált PowerPC utasítás fordul elő."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "A rendszer ROM menüjének megjelenítése arcade rendszerek indításakor."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Bemeneti visszajelzés sugárzása a 8000-es TCP porton."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "A gyorsítótárazott shaderek felépítése a játék indulása előtt."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Gombkombináció a TV és a GamePad közötti váltáshoz, csak a VÁLTHATÓ képernyő-elrendezésnél használatos."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "A mag gombkiosztása, minden játéknál ugyanaz. Hagyja AUTO értéken a RetroBat játékonkénti hozzárendelésének és a KONTROLLER ELRENDEZÉS használatához."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "A rendszer párbeszédablakaiban és a rendszerbeállítást követő játékokban megerősítésre használt gomb. A KÖR a japán szokás."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Alapértelmezetten a Hellfire indul, ha a játék neve tartalmazza a hellfire szót, egyébként a Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Alapértelmezetten a RetroBat annyi játékost állít be, ahány kontroller csatlakoztatva van, ezzel felülbírálható."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Alapértelmezetten a RetroBat saját konfigurációs fájlt hoz létre, engedélyezze ezt az opciót a saját, 'emulators\ssf\Setting' mappában lévő játékbeállítás fájl használatához."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Alapértelmezetten második gamepad használatos, ha második kontroller csatlakozik."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Alapértelmezetten minden kontroller mozgatja a hőst. Engedélyezze, ha egy másik csatlakoztatott kontroller zavarja a mozgást."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "Alapértelmezetten a zinc a bal kart rendeli a mozgáshoz, ezzel az opcióval iránykeresztre váltható."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Alapértelmezetten az RPCS3 a GunCont a 3. játékosportban igényli, ezzel az 1. portba kényszeríthető."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Alapértelmezetten a RetroBat elveti a magspecifikus beállításfájlokat."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Alapértelmezetten a RetroBat szinkronban tartja a telepített játékokat és a roms mappát."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "Alapértelmezetten a kalibráció a középső egérgombbal történik, ezzel a beállítással alternatív gomb adható meg a kalibrációs lövéshez."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Alapértelmezetten a módosítások a lemezmeghajtóra mentődnek, az 'elvetés' nem ment módosítást."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Alapértelmezetten a rázáshoz a ravasz gomb használatos, engedélyezze ezt a lendítés szimulálásához."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "A mip-leképezés megkerülése és mindig a legélesebb textúraszint használata. Jobb képminőség, néhány játékban megjelenítési hibákat okoz."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "CD32 konfiguráció. A CD32 Kickstart és a bővített ROM is szükséges a bios mappában."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "A KLASSZIKUS az eredeti szoftveres renderelő. A POLYMOST és a POLYMER OpenGL-t használ, és támogatja a HD csomagokat."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "A CPC fizikai RAM mérete kB-ban."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "CPU órajel. Az Auto a modell órajelét vagy a játékadatbázist használja. Egyes játékok (SSF2, Alltynex) gyorsabb CPU-val jobbak."

msgctxt "game_options"
msgid "CPU frequency multiplier. Applies only with Cycle-exact."
msgstr "CPU frekvenciaszorzó. Csak ciklus-pontos módban érvényes."

msgctxt "game_options"
msgid "Cache custom textures to system RAM on startup."
msgstr "Egyéni textúrák gyorsítótárazása a rendszermemóriába indításkor."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Kamerasebesség a jobb analóg karral vagy egérrel."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Váratlan módon befolyásolhatja a teljesítményt."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Egyéni BIOS használata esetén a BIOS md5 ellenőrzésének letiltására használható."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "A képfrissítés javítására használható, de egyes játékok sebességét elronthatja."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Egyes játékokban a 3D renderelés teljesítményének javítására használható."

msgctxt "game_options"
msgid "Can be used to simulate colors of particular displays."
msgstr "Adott kijelzők színeinek szimulálására használható."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Hasznos lehet a Gran Turismóhoz, a ravaszok más gombokra lesznek leképezve."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Hasznos lehet a Gran Turismóhoz, a ravaszok a jobb analóg karra lesznek leképezve."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Hasznos lehet a Metal Gearhez, a nyomásérzékenység szimulálására."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Egyes játékoknak előnyös lehet."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Különféle hibákat okozhat."

msgctxt "game_options"
msgid "Can fix bad memory access error with some games."
msgstr "Javíthatja a hibás memória-hozzáférési hibát egyes játékokban."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Javíthatja a rosszul igazított 2D képeket, például a Mario Kart karakterválasztását."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Javíthat olyan hibákat, amelyek még az eredeti hardveren is előfordultak."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Nem natív felbontás használatakor egyes játékokat a 2D élek kerekítésével javíthat."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Javíthat egyes XBOX kontrolleres problémákat."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Kis teljesítményveszteség árán javíthatja a pontosságot."

msgctxt "game_options"
msgid "Can improve framerate or cause timing error."
msgstr "Javíthatja a képfrissítést vagy időzítési hibát okozhat."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Javíthatja a teljesítményt erősebb, tartalékkal rendelkező videokártyákon. Csak Vulkan renderelővel működik."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Egyes gyengébb rendszereken javíthatja a teljesítményt."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Erős videokártya használatakor javíthatja a teljesítményt."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Csak akkor használható, ha a kontroller támogatja a mozgásvezérlést."

msgctxt "game_options"
msgid "Can reduce input latency, but will inscrease CPU requirements."
msgstr "Csökkentheti a bemeneti késleltetést, de növeli a CPU-igényt."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Csökkentheti az akadozást shaderfordításkor, de artefaktumokat is okozhat."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Csökkentheti a késleltetést vagy eltüntetheti az alsó sort Wii-n, grafikai hibák árán."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "A képfrissítés korlátozása az eredeti 35 fps-re."

msgctxt "game_options"
msgid "Certain games require an external cartridge to run."
msgstr "Bizonyos játékok futtatásához külső kazetta szükséges."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Az iránykereszt vezérlésének váltása joystick és egér között."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Az alsó képernyő képarányának módosítása."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "A felső képernyő képarányának módosítása."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "A kitömörített játékok elérési útjának módosítása (alapértelmezett: '\roms\.uncompressed')."

msgctxt "game_options"
msgid "Change the emulated audio chip model."
msgstr "Az emulált hangchip modelljének módosítása."

msgctxt "game_options"
msgid "Change the renderer used by the core."
msgstr "A mag által használt renderelő módosítása."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "A mag által használt renderelő módosítása. A pisztolyos játékok csak SZOFTVERES módban működnek."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Az analóg kar érzékenységének módosítása."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Az egér érzékenységének módosítása."

msgctxt "game_options"
msgid "Change this only if multiple GPU are used by your system."
msgstr "Csak akkor módosítsa, ha a rendszer több videokártyát használ."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Módosítsa ezt a beállítást a játék vezérlése szerint: a / jeltől balra a játék eredeti gombja a gázhoz és a fékhez, jobbra a sebességváltáshoz."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Módosítsa ezt a beállítást a játék vezérlése szerint."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Módosítsa ezt a beállítást instabil játékoknál. Minél nagyobb az érték, annál jobb stabilitást adhat. A 200 μs és 400 μs általában a legtöbb játékhoz megfelelő."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Módosítja, hogyan oszlanak el az emulátor szálai a CPU magok között. Az RPCS3 ütemezők segíthetnek a több CCX/CCD klaszterrel vagy SMT-vel rendelkező processzorokon, de a legtöbb gépen az operációs rendszer a legbiztonságosabb."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Módosítja a pisztolyok megjelenítését a Rambóban."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Módosítja a hangchipet, a TMSS indítóképernyőt és néhány hardveres sajátosságot."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Karaktergenerátor chip. Az Automatikus a kiválasztott géphez illőt választja."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "A csalásokat a \bios\pcsx2\cheats mappába kell helyezni."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "A csalásokat a 'cheats\mame' mappába kell helyezni."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "A csalásokat a 'cheats\psxmame' mappába kell helyezni."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Minden ROM ellenőrzése a játékadatbázis alapján. Csak egy be nem töltődő romset teszteléséhez kapcsolja ki: a hibás ROM-ok összeomlást vagy sérült mentéseket okozhatnak. Alapértelmezetten be."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Sérült fájlok ellenőrzése a játék indításakor."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Az AGA modell kiválasztásakor használt lapkakészlet. Csak akkor állítsa AGA alá, ha egy A1200-on hibásan működő játékot tesztel."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "A 'Trojan Phazer' az ehhez a pisztolyhoz írt játékokhoz való. A 'Fényceruza' minden máshoz megfelel, a rajzprogramokat is beleértve."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "A második kazettahelyre helyezendő MSX bővítmény kiválasztása."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Választás angol, francia vagy spanyol billentyűzetkiosztás között."

msgctxt "game_options"
msgid "Choose between various texture enhancement filters."
msgstr "Választás különböző textúrajavító szűrők között."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "A gomb kiválasztása, amely engedélyezi az IR-t a jobb karon."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "A jobb kar lendítő mozdulatát szimuláló gomb kiválasztása."

msgctxt "game_options"
msgid "Choose if the mouse input is active or not."
msgstr "Annak kiválasztása, hogy az egérbemenet aktív-e."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Annak kiválasztása, hogy a képernyőváltó gyorsbillentyű véglegesen vagy csak a gomb nyomva tartásáig cseréli-e a képernyőket."

msgctxt "game_options"
msgid "Choose the audio driver compatible with the hardware."
msgstr "A hardverrel kompatibilis hangillesztő kiválasztása."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "A színpaletta kiválasztása."

msgctxt "game_options"
msgid "Choose the disposition of the emulated screens."
msgstr "Az emulált képernyők elrendezésének kiválasztása."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "A kontrollerhez csatlakoztatott kiegészítő kiválasztása."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Az emulált képernyők második elrendezésének kiválasztása."

msgctxt "game_options"
msgid "Choose which Atari system to emulate."
msgstr "Az emulálandó Atari rendszer kiválasztása."

msgctxt "game_options"
msgid "Choose which color palette is going to be used"
msgstr "A használandó színpaletta kiválasztása"

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "A használandó színpaletta kiválasztása."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Annak a meghajtónak a kiválasztása, amelyen a lemezkezelő menü működik. A többi meghajtó csatolva marad. A betöltött média azt a meghajtót használja, amelybe a játékot betöltötték."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "A klasszikus a jobb és bal vállgombot használja az erős rúgáshoz és ütéshez, a modern a jobb vállgombot és a jobb ravaszt."

msgctxt "game_options"
msgid "Cleans up stray black pixels."
msgstr "Eltávolítja a kóbor fekete pixeleket."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Színpaletta az eredeti Game Boy játékokhoz."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Az arcade monitor színhőmérséklete."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "A WonderSwan (mono) játékok színei. A WS paletták az eredeti képernyőket idézik."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "A két képernyő közötti rés beállítása pixelben."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "A látómező beállítása (a nagyobb szélesebb)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Az fps beállítása."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Állítsa be, ha sztereó és térhatású hang között szeretne váltani."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Beállítja, hogyan kérik a kontrollereket a hoszttól vagy klienstől. Elengedhetetlen a helyi többjátékos kapcsolathoz."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Egér csatlakoztatása az 1. porthoz."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "A kiválasztott BIOS képnek megfelelő konzolváltozat."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "A GS keverőegység pontossági szintjének szabályozása. A nagyobb értékek pontosabban emulálják a keverést a shaderben."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Az emuláció trilineáris textúraszűrésének szabályozása."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "A dithering alkalmazásának módját szabályozza."

msgctxt "game_options"
msgid "Controls the number of Auto-CRC fixes and hacks applied to games."
msgstr "A játékokra alkalmazott Auto-CRC javítások és hackek számát szabályozza."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "A program megjelenítése előtti részletességet szabályozza."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "A fel/leváltás átalakítása 3./4. fokozatra a szekvenciális váltó szimulálásához normál váltókaron."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Textúrák másolása a VRAM-ba, lassabb, de pontosabb. Kapcsolja ki a teljesítmény javításához."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "A színpuffer másolása az N64 memóriájába. Egyes effektusokhoz szükséges (pl. szünetképernyők, kamerafotók). A KI a leggyorsabb, de elronthatja ezeket. Az AUTO a teljesítménymódot követi."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Helyes, de lassabb."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "A nem négyzetes pixelek képarányának korrigálása."

msgctxt "game_options"
msgid "Correct the sampling of 2D sprite textures when upscaling."
msgstr "A 2D sprite textúrák mintavételezésének javítása felskálázáskor."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Levágja a potenciálisan véletlenszerű, hibás videókimenetet, amelyet egy normál felbontású TV képernyőjének kerete eltakart volna."

msgctxt "game_options"
msgid "Crop out the potentially video output that would have been hidden by the bezel."
msgstr "Levágja a videókimenet azon részét, amelyet a keret eltakart volna."

msgctxt "game_options"
msgid "Crop pixels around edge of screen."
msgstr "Pixelek levágása a képernyő szélein."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "A kép levágása a natív képarányról 4:3-ra vagy 16:9-re"

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "A szegélyek levágása a szegélygrafikák megjelenítéséhez vagy elrejtéséhez."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "A kép levágása 256x240-ről 252x239-re."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "A konzol hangkimeneti szűrőjének vágási frekvenciája. A 3390 Hz a legtöbb Mega Drive modellnek felel meg."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "8 pixelt vág le a széleken a Master System szegélyeinek eltávolításához."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "DIMM kártya mérete. Az Auto a játékot követi, hagyja Auto értéken, hacsak egy játék nem panaszkodik."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Csillapítja a követőkamera lengését a versenyjátékokban. Alapértelmezetten erős."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Minden második sor sötétítése a katódsugárcső utánzására."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "A DeSmuME belső BIOS-szal rendelkezik, válassza ezt a RetroBat bios mappájában lévő BIOS és firmware használatához."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Csökkentse, ha túl érzékeny; a túlzott csökkentés megakadályozhatja a teljes tartomány elérését."

msgctxt "game_options"
msgid "Default ON."
msgstr "Alapértelmezetten BE."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "Az alapértelmezett emulált kontroller 6 gombos."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Alapértelmezetten engedélyezve, néhány játéknál problémás lehet."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Alapértelmezetten az EmulationStation nyelvét követi."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "Az alapértelmezett a 'MAGAS', állítsa 'NORMÁL' értékre a teljesítmény javításához a pontosság rovására."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "Az alapértelmezett 30 másodperc; adja meg, mennyi ideig várjon a játék indulására, mielőtt visszatér a RetroBat játéklistájához."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "Alapértelmezetten KI, használja sebességprobléma esetén magas frissítési gyakoriságú kijelzőkön."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Alapértelmezetten BE (gyors). A KI a valódi geometriai DSP programokat futtatja, pontosabb, de lassabb (csak Model 1, Model 2 2B játékok)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Alapértelmezetten BE, helyes négyszög-renderelés. A KI háromszögekként rendereli a négyszögeket (gyorsabb)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Alapértelmezetten BE, a KI javíthatja a kompatibilitást régebbi videokártyáknál (csak Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "Alapértelmezetten BE, ezzel a beállítással eltávolítható a 60 Hz-es korlát, elronthat játékokat."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Alapértelmezetten be, kapcsolja ki az indítóanimáció megjelenítéséhez."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Alapértelmezetten 10 bit DS-hez és 16 bit DSi-hez."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Alapértelmezetten Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "Alapértelmezetten WIIU Gamepad, módosítsa azoknál a játékoknál, amelyek többjátékos módban nem fogadják el a WIIU Gamepadet."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Alapértelmezett: kurzor elrejtve."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Alapértelmezett: engedélyezve."

msgctxt "game_options"
msgid "Default: low."
msgstr "Alapértelmezett: alacsony."

msgctxt "game_options"
msgid "Default: true"
msgstr "Alapértelmezett: igaz"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Alapértelmezetten 60, ha 0-ra van állítva és a VSYNC engedélyezve van."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Az emulációhoz használt BIOS megadása."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "A gamepad típusának megadása, mindkét játékosra vonatkozik."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "A PET számítógép modelljének megadása."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "A futtatandó Symbian eszköz megadása."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "A Gamepad képernyő megjelenítésére szolgáló gomb megadása, alapértelmezett, ha nincs."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Annak megadása, mennyi RAM-mal rendelkezzen az emulált gép."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Annak megadása, hogyan jelenjen meg a kurzor az alsó képernyőn."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Annak megadása, hogyan illeszkedjen vagy skálázódjon a játék az ablakba."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "A Sinden pisztoly beállítási módjának megadása."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "A GunCon A és B gombjainak (a Justifier Start és Back gombjainak) hozzárendelése. Alapértelmezett: iránykereszt jobb/bal DolphinBar Wiimote-tal, egérgombok más pisztolyokkal."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "A guncon2 gombjainak hozzárendelése."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Az érintőképernyő emulálási módjának megadása."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Annak megadása, hogyan csatlakozik a Wiimote a DolphinBarhoz."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Annak megadása, hogy alkalmazandó-e patch és hol vannak a patch fájlok; az 'AUTO' alkalmazza a patcheket, ha a rom mellett, a rom fájllal azonos néven találhatók."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Az egérgombok (bal/jobb/középső) hozzárendelése, az alapértelmezett a/újratöltés/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "A modelltípus és a régió megadása."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "A modell megadása, alapértelmezett a BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "A modell megadása, GX4000-hez alapértelmezett a CPC 6128+."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "A modell megadása, alapértelmezett a Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Az 1. játékos által használt egér indexének megadása."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "A 2. játékos által használt egér indexének megadása."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "A 3. játékos által használt egér indexének megadása."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "A 4. játékos által használt egér indexének megadása."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Az egyéni controls.ini fájl elérési útjának megadása."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "A régió megadása, a mentésekhez használatos."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "A nyomva tartandó gombkombináció megadása a DualShock kontroller analóg és digitális mód közötti váltásához."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "A színpaletta megadása, a Régi NTSC a régi, csúnya japán TV színeket reprodukálja."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "A tárcsa eszközt emuláló csatlakoztatott eszköz megadása."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "A pedált emuláló csatlakoztatott eszköz megadása."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "A pozíciós eszközt emuláló csatlakoztatott eszköz megadása."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "A trackballt emuláló csatlakoztatott eszköz megadása."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "A fénypisztolyt emuláló csatlakoztatott eszköz megadása."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Az egeret emuláló csatlakoztatott eszköz megadása."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "A paddle-t emuláló csatlakoztatott eszköz megadása."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Az analóg irányító kart emuláló csatlakoztatott eszköz megadása."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Az emulált joystick típusának megadása."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Az emulált gép típusának megadása."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "A jobb joystick funkciójának megadása."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "A diagnosztikai menübe lépés billentyűkombinációjának megadása."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "A rezgés és a képernyőrázkódás szintjének megadása; engedélyezze a képernyőrázkódást, ha a kontroller nem támogatja a rezgést. Az 'AUTO' mindkettőt engedélyezi."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Az éppen tartott fegyver helyzetének megadása."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Az iránykereszt hozzárendelésének megadása."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Az emulálandó memóriakártyák számának megadása."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "A levágandó pixelek számának megadása."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Az emulált mikrofon által fogadott hang megadása."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "A mutató mozgatásához használt eszköz típusának megadása."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "A monitor típusának megadása, módosítja a színeket."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Az emulált kontroller típusának megadása."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "A pisztolyok célkereszt-típusának megadása."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Annak megadása, hol helyezkednek el az érme és start gombok."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Annak megadása, hogy a gyorsítás gyorsbillentyűje kapcsolóként működik-e, vagy nyomva kell tartani."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Annak megadása, hogy a lassítás gyorsbillentyűje kapcsolóként működik-e, vagy nyomva kell tartani."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Annak megadása, melyik Game Boy hang szól a rendszerből."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Annak megadása, melyik analóg kar vezérli az egérmutatót."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "A turbó módot aktiváló gomb megadása; ez nem az a gomb, amely turbóvá válik."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "A kormány elfordulási foka, amely a játékbeli teljes kormánykitérést eléri. A 270 az arcade gépszekrényé."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Írások megtagadása foglalt állapotban."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "A konfigurációtól függően növelheti vagy csökkentheti a késleltetést."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Az Apple II játékportjába csatlakoztatott eszköz. Az analóg kar fokozatos paddle-mozgást ad, az iránykereszt csak teljesen balra vagy jobbra visz."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "A 2. játékos eszköztípusa."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Csak DirectInput: használja, ha a kontrollerek nem a megfelelő játékosokat vezérlik."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Az XBE aláírás-ellenőrzés letiltása homebrew játékok használatakor."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "A Xenia Edge játékonkénti beállításainak letiltása, hogy a RetroBat beállításai érvényesüljenek."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "A mag biztonsági funkcióinak letiltása, hogy egyes homebrew játékok elindulhassanak."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "A dithering letiltása és a teljes csatornánkénti 8 bites színinformáció használata."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Ködeffektusok letiltása."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "A hardveres renderelő letiltása, javíthatja a kompatibilitást."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "A gyorsbillentyűk letiltása és a billentyűzet teljes átadása a magnak. Váltás a 'Scroll Lock' billentyűvel."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Az árnyékok rendereléséhez használt modifier volume-ok letiltása."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "A pixel shaderek letiltása javíthatja egyes játékok összeomlását, csak akkor aktiválja, ha a játéknak szüksége van rá."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "A Master System FM chip letiltása."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "A Visual Pinball menü letiltása: a kilépés billentyű (X) közvetlenül kilép az asztalból."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Az analóg elsütő (jobb kar) és az analóg meglökés (bal kar) letiltása."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "A gépszekrény kamera-ellenőrzésének letiltása."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "A 'saves\mame\artwork' mappában lévő artworkök ellenőrzésének letiltása."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "A többjátékos játékokban a csatlakoztatott kontrollerek kiválasztására megjelenő kontroller kisalkalmazás letiltása."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "A HOTKEY + KELET vagy F12 billentyűvel megnyitható játékon belüli menü letiltása."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Kapcsolja ki az IR mutató középre állításához a kar elengedésekor."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Kapcsolja ki a teljesítmény javításához."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Kapcsolja ki, ha egy .bat vagy .cmd fájlt közvetlenül szeretne futtatni anélkül, hogy a RetroBat megpróbálná megtalálni benne a futtatható fájlt."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Kapcsolja ki az R2 és L2 hozzárendeléséhez az L és R gombokra (nem digitális)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Az X tengely meglökésre, az Y tengely ingára és a Z tengely elsütőre való használatának letiltása."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Figyelmeztetés letiltása nem teljesen támogatott játékok futtatásakor."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Letiltja a kontroller rezgését; alapértelmezetten a rezgés csak akkor aktív, ha a játék és a kontroller kompatibilis."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Letiltja a mag adatbázisából származó automatikus játékonkénti beállításokat, és engedélyezi az alábbi kézi javításokat. Nem ajánlott."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Letiltja a mozgásinterpolációt, egy képkockával kisebb késleltetés."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Letiltja a vertex gyorsítótárat. Megoldhatja a hiányzó vagy villódzó grafikát. Ronthatja a teljesítményt."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "A dithering letiltása eltávolíthat némi zajt és pixeles hatást."

msgctxt "game_options"
msgid "Disabling safe features can help various games such as Xenosaga, Kingdom Hearts..."
msgstr "A biztonsági funkciók letiltása segíthet különféle játékoknál, például Xenosaga, Kingdom Hearts..."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "A 4 MB-os RAM-bővítő csomag letiltása egyes játékoknál szükséges lehet."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Ennek a funkciónak a letiltása csökkenti a színmélységet."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "A MAME menüfelület megjelenítése a játék betöltésekor."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "SGB keretek megjelenítése Super Game Boy emulálásakor."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Üzenet megjelenítése egy teljesítmény feloldásakor. Alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Kis mutató megjelenítése az érintőképernyőn."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Tapasztalati sáv megjelenítése az öv felett."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "A LaserActive kép megjelenítési aránya, alapértelmezetten 4:3."

msgctxt "game_options"
msgid "Display crosshair if a lightgun is used."
msgstr "Célkereszt megjelenítése fénypisztoly használatakor."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Az aktuális élet- és manaértékek megjelenítése a gömbökön."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "A sebzés és a tapasztalat megjelenítése lebegő számokként."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "A pályaidő, a megtalált titkok és a megölt ellenségek megjelenítése."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "A Primeval Hunt második képernyőjének (érintőképernyő) megjelenítése."

msgctxt "game_options"
msgid "Display or not on-screen notifications."
msgstr "Képernyőn megjelenő értesítések megjelenítése vagy elrejtése."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "A képernyő szegélyterületeinek megjelenítése. Nincs hatása az F18A kimenetre."

msgctxt "game_options"
msgid "Display the emulated framebuffer at a widescreen aspect ratio. Get best results with full 3D games."
msgstr "Az emulált képpuffer megjelenítése szélesvásznú képarányban. Teljes 3D-s játékokkal a legjobb."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "A játék megjelenítése 16:9-ben. A legjobb, ha a JÁTÉK KÉPARÁNYA 16/9."

msgctxt "game_options"
msgid "Display the overscan regions of the screen."
msgstr "A képernyő overscan területeinek megjelenítése."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Az 1. játékos VMU képernyőjének megjelenítése a játék felett."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Indításkor használt kijelző. A játékban az F7 billentyűvel váltható (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Voxel objektumok megjelenítése lapos sprite-ok helyett, ha elérhetők. Alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Dithering a szupermintavételezett képpuffer-effektusokhoz."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Az RDRAM képpufferképekre alkalmazott dithering."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Elosztja a belső felbontást: magas belső felbontásnál a nagyobb értékek nagyobbá teszik a játékot. Alapértelmezett: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "A Doom 3 nagyon sötét játék, növelje a kép világosításához."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Megduplázza az érzékelt vízszintes felbontást, nem kompatibilis a szupermintavételezéssel."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "A felskálázott kép leskálázása (SSAA). Felskálázást igényel."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "A táj kirajzolása a pálya végéig az ezt támogató játékokban (Daytona USA). Csak Model 1 és Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "A lemezcseréhez használt meghajtó."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick: Robotron 2084 és Space Dungeon a jobb karon. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: többgombos joystickok."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "A képkockák duplikálása Vulkan renderelőt igényel."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Dinamikus újrafordítás. A legtöbb játék gyorsabban fut, néhány lassabban."

msgctxt "game_options"
msgid "Efficient graphics filters improving the rendering of games."
msgstr "Hatékony grafikus szűrők, amelyek javítják a játékok megjelenítését."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Kiküszöböli a textúrák torzulását felskálázáskor."

msgctxt "game_options"
msgid "Eliminates position-dependent distortion and warping of textures."
msgstr "Kiküszöböli a textúrák pozíciófüggő torzulását."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Buzz! berregők emulálása a gamepadekkel. Egy kontroller 4 berregőt fed le (1-4. játékos), két kontroller 7-et."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "A PS3 memória-csempézés emulálása. Kis teljesítményveszteség árán javítja egyes játékok grafikai hibáit."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Hangfelismerő egység emulálása (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "DJ Hero lemezjátszó emulálása a gamepadekkel. A DJ Hero 1-hez és 2-höz szükséges."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Guitar Hero Live (GHLtar) kontroller emulálása a gamepadekkel. A Guitar Hero Live-hoz szükséges."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "New 3DS vagy eredeti 3DS emulálása."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "PlayStation TV emulálása helyi többjátékos módhoz (legfeljebb 4 kontroller). Azonos kontrollerek nem támogatottak, az érintőképernyős játékok nem biztos, hogy működnek."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Adott mozgásvezérlés emulálása. A '/' a bal kar/jobb kar műveletét jelöli."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Egérmozgással vezérelt spinner kontroller emulálása. Az egérgombok a bal (sárga) és jobb (piros) gombra vannak leképezve."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Az 59,94 Hz-es NTSC vblank frekvencia emulálása 60 Hz helyett. Javítja egyes NTSC játékok időzítési és hangcsúszási problémáit."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "A Disney Infinity bázis kiegészítő emulálása."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "A Game Boy Player emulálása a rezgés engedélyezéséhez a kompatibilis játékokban."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "A LEGO Dimensions toypad kiegészítő emulálása."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "A Skylanders portál kiegészítő emulálása."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "A Video CD kártya emulálása, az mpeg_card.bin fájlt igényli a bios mappában."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Régebbi motorok viselkedésének emulálása, egyes régebbi modokhoz és demókhoz szükséges."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Az emulált szál időszelete. Növelése segíthet néhány játéknál, csökkentése simábbá tehet másokat."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Az LCD áttetszőségi effektusainak emulálása, de növeli a mozgási elmosódást."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "A PS3 multisampling elrendezésének emulálása. Javíthat egyes vizuális artefaktumokat bizonyos játékokban."

msgctxt "game_options"
msgid "Emulation method used. AUTO for mixed features with max performance and compatibility."
msgstr "A használt emulációs módszer. Az AUTO vegyes funkciókat használ a legjobb teljesítménnyel és kompatibilitással."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Emulátor scanline-ok, csak egyes játékokban láthatók."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "32 MB RAM mod engedélyezése Dreamcasthoz, befolyásolhatja a kompatibilitást."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "BIOS-ba indítás engedélyezése DSi játékokhoz."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "CMS emuláció engedélyezése."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Digitális jelprocesszor engedélyezése. Javítja a hang pontosságát, nagyobb teljesítményigény árán."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Digitális jelprocesszor engedélyezése. Javítja a hang pontosságát a teljesítmény rovására."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Discord Rich Presence szolgáltatás engedélyezése, a Discord állapotában megjelennek a játszott játékok."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Dolby Pro Logic II dekóder engedélyezése kompatibilis játékokban és 5.1 hangszórókkal."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "FidelityFX kontrasztadaptív élesítés engedélyezése."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Lebegőpontos egység engedélyezése, általában a későbbi 3D játékokhoz hasznos."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Gravis Ultrasound emuláció engedélyezése."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "HDR engedélyezése HDR-kompatibilis kijelzőkhöz."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "IBM PS/1 Audio emuláció engedélyezése (alapértelmezetten letiltva)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Just In Time emuláció engedélyezése, növeli az emuláció sebességét, nem kompatibilis a ciklus-pontos móddal."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "A vezérlés belső MAME átkiosztásának engedélyezése."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "A MAME opció engedélyezése, amely a belső adatbázisa alapján játékonként automatikusan beállítja a gombkiosztást."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "A MelonDS emulált BIOS engedélyezése a bios mappában lévő firmware-ek helyett."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "OpenGL renderelő engedélyezése, a RetroArch illesztőnek OpenGL-nek kell lennie."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "PAL (50 Hz) NES emuláció engedélyezése."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Sega CD RAM kazetta engedélyezése."

msgctxt "game_options"
msgid "Enable Service button to enter settings."
msgstr "Szerviz gomb engedélyezése a beállításokba lépéshez."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Tandy hang emuláció engedélyezése."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Kiegészítő fejlesztői RAM engedélyezése, elronthat játékokat."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Élsimítás engedélyezése, simítja a poligonok éleit."

msgctxt "game_options"
msgid "Enable blargg NTSC video filters"
msgstr "Blargg NTSC videószűrők engedélyezése"

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Nyers erővel végzett fel-/leskálázás engedélyezése (csak 10.8.0)"

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Gyorsítótár csatolásának engedélyezése"

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "A játékbeli objektumok vetett árnyékainak engedélyezése, csak OpenGL-lel kompatibilis."

msgctxt "game_options"
msgid "Enable certain games with support for the 3Dfx Voodoo accelerator."
msgstr "Bizonyos, 3Dfx Voodoo gyorsítót támogató játékok engedélyezése."

msgctxt "game_options"
msgid "Enable colorization of Game Boy games."
msgstr "Game Boy játékok színezésének engedélyezése."

msgctxt "game_options"
msgid "Enable controller's rumble effects."
msgstr "A kontroller rezgési effektusainak engedélyezése."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "A kontroller rezgési effektusainak engedélyezése. Csak versenyjátékokban működik."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Célkeresztek engedélyezése lövöldözős játékokban, a (DS) opciók csak a DemulShooterrel kompatibilisek."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Célkeresztek engedélyezése lövöldözős játékokban."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "A videómód alapú egyéni felbontás engedélyezése."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Dinamikus újrafordítók engedélyezése, amelyek javítják a teljesítményt."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "A DS4 és DualSense fejlett funkcióinak engedélyezése; ez a kikapcsolásig megszünteti a kompatibilitást a dinputot használó emulátorokkal."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Erővisszacsatolás engedélyezése a támogatott kontrollereknél."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Teljes képernyős élsimítás engedélyezése Direct3D-ben, simítja a poligonok éleit."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Vízszintes keverő (elmosó) szűrő engedélyezése."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Engedélyezze, ha a kormány a középtől eltávolodik, ahelyett, hogy visszatérne."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Játékbeli célkereszt engedélyezése a célzás megkönnyítésére."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Intelligens nagyítás funkció engedélyezése."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "IPS patchek engedélyezése."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "A kevésbé pontos, de jobban szóló Namco 106 (mapper 19) hangemuláció engedélyezése."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Az alábbi kézi hackek engedélyezése, egyébként a hackek automatikusan kerülnek alkalmazásra."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Mozgásvezérlés (giroszkóp) engedélyezése egérrel vagy kompatibilis kontrollerrel."

msgctxt "game_options"
msgid "Enable multitap in port 1."
msgstr "Multitap engedélyezése az 1. portban."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Multitap engedélyezése a 2. portban."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Progresszív pásztázás engedélyezése kompatibilis játékokhoz."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Run-ahead mód engedélyezése a bemeneti késleltetés csökkentésére."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Az IBM Music Feature Card engedélyezése (alapértelmezetten letiltva)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "A Master System FM chip engedélyezése."

msgctxt "game_options"
msgid "Enable the Memory Management Unit. Required for some games."
msgstr "A memóriakezelő egység engedélyezése. Egyes játékokhoz szükséges."

msgctxt "game_options"
msgid "Enable the On Screen Keyboard feature which can be activated with the L3 button."
msgstr "A képernyő-billentyűzet funkció engedélyezése, amely az L3 gombbal aktiválható."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "A Vita3K felületén aktivált csalások hatásainak engedélyezése."

msgctxt "game_options"
msgid "Enable the effects of the chosen Action Replay and Gecko codes for a game."
msgstr "A játékhoz kiválasztott Action Replay és Gecko kódok hatásainak engedélyezése."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Az Atari STE fejlett joystick portjaiba csatlakoztatott Jaguar joypadek emulációjának engedélyezése."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Az egér használatának engedélyezése az érintőképernyőhöz a jobb kar helyett."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Engedélyezze, ha az XInput kontrollerek indexei fel vannak cserélve."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Engedélyezze, ha a kontrollernek nincsenek analóg ravaszai."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Engedélyezze, ha G-Sync/FreeSync monitorja van, hanghibákat okozhat."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Engedélyezze, ha Intel grafikus chippel problémák lépnek fel."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Engedélyezze, ha a játékban hiányzó grafika vagy hibás megvilágítás jelenik meg."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Engedélyezze, ha a mamehookert LED-ekkel, szolenoidokkal, rezgéssel... használja."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Engedélyezze a shaderek használatához akkor is, ha a RetroBatban nincs shader beállítva."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Engedélyezze, hogy az 1. játékos joystickja a bal portba kerüljön a jobb helyett."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Engedélyezze a Duckstation által biztosított shaderek használatához."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Engedélyezze a saját Project64 játékonkénti beállításainak használatához."

msgctxt "game_options"
msgid "Enable verbose mode for debugging."
msgstr "Részletes mód engedélyezése hibakereséshez."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Alapértelmezetten engedélyezve (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Alapértelmezetten engedélyezve, javítja az emulált SIO port adatátvitelét."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Alapértelmezetten engedélyezve. Letiltja a ditheringet és 24 bites színkimenetet kényszerít."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Alapértelmezetten engedélyezve. Letiltása javíthatja a teljesítményt, de egyes játékokat elront."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Alapértelmezetten engedélyezve. Gyorsabb shaderek, ritka grafikai hibákat okozhat."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Alapértelmezetten engedélyezve. Kis teljesítményveszteség árán javítja egyes játékok grafikai hibáit."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Alapértelmezetten engedélyezve. Eltávolítja az elmosódást egyes játékokból, de csökkenti a pontosságot."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Alapértelmezetten engedélyezve. A játék sprite-jait HD csomagra cseréli, ha elérhető. Újraindítás szükséges."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Alapértelmezetten engedélyezve. Magától az emulátortól érkező üzenetek megjelenítése."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Alapértelmezetten engedélyezve. Letiltva a képfrissítés 60 FPS-re korlátozódik."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Alapértelmezetten engedélyezve. Letiltva a képfrissítést a játék korlátozza."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Engedélyezi a 60 Hz-es módot a képszakadás csökkentésére a 60 Hz feletti működést nem támogató kijelzőkön."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Engedélyezi a Direct3D automatikus mipmap generálását."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Engedélyezi a WRX nagy felbontást."

msgctxt "game_options"
msgid "Enables a low pass audio filter to soften the harsh sound of some games."
msgstr "Aluláteresztő hangszűrőt engedélyez egyes játékok éles hangjának lágyítására."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Elmosódásgátló hacket engedélyez, kevésbé pontos, de kevésbé elmosódottá teszi a játékokat."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Engedélyezi, hogy a nyilak, a CTRL és az ALT billentyű joystickként és tűzgombként működjön."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Egyéni patchelési funkció engedélyezése."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Nagy felbontású CEL renderelés engedélyezése."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Lehetővé teszi a különböző videójelek közötti váltást."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Ennek engedélyezése problémákat okozhat egyes 8BitDo kontrollereknél."

msgctxt "game_options"
msgid "Enabling this will downsampling to native color depth. Disabling enable output at higher color depth."
msgstr "Engedélyezve natív színmélységre mintavételez le. Letiltva magasabb színmélységű kimenetet tesz lehetővé."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Az API specifikáció szigorú betartását kényszeríti. Egyes játékokban ronthatja a teljesítményt. Megoldhatja a hiányzó grafika és villódzás ritka eseteit."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Javítja a grafikai pontosságot, nagyobb teljesítményigény árán."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "A különböző objektumok árnyékainak javítása."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "A 2D textúrák minőségének javítása."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface."
msgstr "A felületi textúrák minőségének javítása."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "A felületi textúrák minőségének javítása. Csak OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "A felületi textúrák minőségének javítása. Csak Vulkan és OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "A textúrákra alkalmazott javító szűrő."

msgctxt "game_options"
msgid "Enhancement. Reduces system slowdown. Causes issues in some games."
msgstr "Javítás. Csökkenti a rendszer lassulását. Egyes játékokban problémákat okoz."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Adja meg a hosztoláshoz használandó helyi UDP portot."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Adja meg a szerver címét."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Adja meg az adatátvitelhez használt játék rom első karaktereit."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Adja meg az adatátvitelhez használt mentési fájl első karaktereit."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Adja meg a betöltendő érintő profilt."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Környezeti zengetés (EFX), alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "A Pontos áll legközelebb a konzolhoz, és ez terheli leginkább a GPU-t. A Gyors sokkal könnyebb. Az Auto gyenge vagy instabil GPU-kon a gyorsat választja."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "A grafikus háttérrendszert egy második szálon futtatja, javítja a teljesítményt, csökkenti az akadozást és gyorsítja a shaderfordítást."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "A SAMS memóriakártya bővítése 4M-re."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "A konzolba helyezett bővítőkazetta. Az ismert igényű játékok ezt automatikusan felülbírálják."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Kísérletezzen ezzel az opcióval, ha a joystick elmászik (alapértelmezetten engedélyezve)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Kísérleti, csak Windows. Védi a játék veremadatait, amikor az emulátor memóriakivételeket kezel. Javíthat összeomlásokat egyes játékokban. Hagyja kikapcsolva, hacsak egy játéknak nincs rá szüksége."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "További kontroller. Hagyja üresen, hacsak a játék nem kér ilyet."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "További memóriakártya, csak //e modellek. Néhány programnak a gyári 64 KB-nál több kell."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "FM Towns egérérzékenység."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Gyors közelítő élsimítás, olcsóbb az MSAA-nál, de elmosódottabb."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "A Gyors javíthatja a teljesítményt, de egyes illesztőknél instabil lehet."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "Gyors lemezbetöltő ROM. A VALÓDI MEGHAJTÓ-EMULÁCIÓ beállítást és a JiffyDOS ROM-okat igényli a 'bios\vice' mappában. Magnókazettákkal és kazettákkal nem használatos."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "A Gyors kevésbé pontos, a rendezett és atomi pontos, de lassabb."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Gyorsabb DSP emulációs motor (kísérleti). Csak akkor használatos, ha a DSP EMULÁCIÓ engedélyezve van."

msgctxt "game_options"
msgid "Faster loading times but can cause issues with some games."
msgstr "Gyorsabb betöltési idők, de egyes játékokban problémákat okozhat."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Gyorsabb szektorolvasás. Nem minden szoftver számít rá."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Minden textúra szűrése, azokat is beleértve, amelyeket a játék kifejezetten szűretlenre állít. Alapértelmezetten letiltva."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "A végső képre alkalmazott szűrő."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "A kép képernyőre skálázásához használt szűrő."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "A végső kép skálázásakor használt szűrő."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Szűrő, amelyet akkor használ, ha a renderelt kép nagyobb a képernyőnél."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Szűrő, amelyet akkor használ, ha a renderelt kép kisebb a képernyőnél."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "A 3D textúrákra alkalmazott szűrés."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "A 3D textúrákra alkalmazott szűrés. Csak OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "A sprite-okra és 2D elemekre alkalmazott szűrés."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Folyamatos tüzelés, amíg a gomb nyomva van."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "A pisztoly visszarúgó motorjának működtetése minden lövésnél, ha a pisztolyban van ilyen. Alapértelmezetten be."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "A nagy felbontású vagy szélesvásznú játékok beillesztése egy 640x480-as keretbe fekete szegélyekkel. Csak 4:3-as CRT TV-n hasznos."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "A Digital Video Cartridge behelyezése (vmpega.rom a bios mappában), FMV játékokhoz és Video CD-khez szükséges."

msgctxt "game_options"
msgid "Fit to the original ratio of the game."
msgstr "Igazítás a játék eredeti képarányához."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "A Demul hibájának javítása (kilépés a teljes képernyőből a bal felső sarokba lövéskor) az összes egérbemenet blokkolásával a Demul felületén."

msgctxt "game_options"
msgid "Fix issues with upscaling in Namco games (Ace Combat, Tekken, SoulCalibur...)."
msgstr "Javítja a felskálázási problémákat a Namco játékokban (Ace Combat, Tekken, SoulCalibur...)."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Javítja a lassulásokat ennél az emulátornál."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Javítja a textúrasérülést és a mélységi problémákat AMD és egyes Intel videokártyákon."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Javítja a felskálázott textúrákon esetleg megjelenő sávosodást."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Javítja, hogy a játék indításkor egy hurokban ragadjon."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Javítja a koplanáris geometriát és a matricákat (decals) egyes játékokban, másokat elronthat."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Javítja a 2D elemek közötti réseket."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Javítja az árnyék- és mélységi artefaktumokat egyes játékokban."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Javít néhány vonalakkal kapcsolatos grafikai hibát."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Javítja a szöveghibákat egyes játékokban."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Lebegőpontos egység, egyes 3D játékokhoz szükséges. A 68040-nél (beépített) alapértelmezetten be, a 68030-nál ki."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "A Vita3K adatainak mappája (firmware, telepített játékok, mentések). Figyelmen kívül marad, ha a Vita3K hordozható módban van (nem üres 'portable' mappa a Vita3K.exe mellett)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "Egyes japán játékokhoz szükséges betűkészlet ROM."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "A Bleach Blade Battlershez."

msgctxt "game_options"
msgid "For Goemon."
msgstr "A Goemonhoz."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "Nintendo rendszereken az A és B felcserélése az Xbox gombnevekhez igazodva."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "Run Behind és M-bit játékokhoz."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "A SOCOM 2 HUD-hoz / Spy Hunterhez."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "A Scarface The World is Yours és a Crash Tag Team Racing játékokhoz."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "SegaScope 3-D játékoknál csak egy szem megjelenítése a villódzó pár helyett."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "A Superman Returnshöz."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "A Tales of Destinyhoz."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "Tri-Ace játékokhoz."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "ASTC textúrákat használó játékoknál: 6 GB VRAM-os videokártyánál válassza a közepeset, 4-2 GB VRAM-osnál az alacsonyat."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "2 ravaszos N64 kontrollereknél az R2 használata az L2 helyett Z gombként."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "Nosztalgiából. Alapértelmezetten a BG2 gyorsított hadiködéhez (FoW) hasonlít"

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "Egyes emulátoroknál a Wiimote billentyűzet- és egértársításának javítására használható két Wiimote használatakor."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Azoknak a GBC szoftvereknek a kényszerítése, amelyek GBA-n futva másként viselkednek."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "GameBoy mód kényszerítése GameBoy Colorhoz."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "A P1 kontroller indexének kényszerítése, hasznos lehet, ha az XInput eszközök nem jó sorrendben vannak."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "A P1 kontroller indexének kényszerítése, hasznos lehet, ha arcade gépen kontrollert használ."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "A P2 kontroller indexének kényszerítése, hasznos lehet, ha arcade gépen kontrollert használ."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Rawinput kényszerítése, ezt nem kellene BE értékre kényszeríteni."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Műveletenkénti CPU ciklusszám kényszerítése. Az AUTO a játékonkénti alapértelmezést használja, csak akkor módosítsa, ha egy játék hibás."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Gomb kényszerítése tengely helyett a ravaszokhoz, segíthet a Sony kontrollereknél."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Az emulátor teljes képernyőre kényszerítése akkor is, ha a RetroBat ablakban fut"

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Képkocka-korlátozó kényszerítése."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "A textúrák mintavételezési módjának kényszerítése. A legközelebbi szomszéd élesen tartja a pixeleket, a lineáris simítja őket."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Bemeneti illesztő kényszerítése. Alapértelmezett: 'sdl', illetve 'dinput', ha több pisztoly engedélyezve van."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "A felbontás kényszerítése az aktuális képernyőfelbontásra az egyéni felbontást engedő játékoknál."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Saturn bővítőkazetta kényszerítése, ha az automatikus felismerés sikertelen."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Saturn régió kényszerítése, ha az automatikus felismerés sikertelen."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Sztereó kényszerítése minden ROM-ra."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Az emulálandó Game Boy modell kényszerítése, ha az automatikus felismerés sikertelen."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "A VI frissítési gyakoriság kényszerítése. Az AUTO szinte minden játékhoz helyes."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "A tényleges kimeneti csatornaelrendezés kényszerítése. A HANGCSATORNÁK azt adja meg, mit lát a játék, ez pedig azt, hogyan keverődik le az eszközére. Hagyja AUTO értéken, hacsak a kimeneti eszközt nem ismeri fel hibásan."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "A backglass be- vagy kikapcsolásának kényszerítése. Az AUTO a KÉPERNYŐ KONFIGURÁCIÓ beállítást követi (engedélyezve, ha a KÉPERNYŐ KONFIGURÁCIÓ nincs megadva)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "A piszkos téglalapok (dirty rectangles) felskálázásakor használt bilineáris szűrési mód kényszerítése."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "A rendszerindító eszköz kényszerítése (csak 1F/2F és későbbi modellek)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "A konzol régiójának kényszerítése."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "A konzol régiójának kényszerítése. Alapértelmezetten a régiót a játékból állapítja meg."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Az emulált frissítési gyakoriság kényszerítése ahelyett, hogy a betöltött játékból állapítaná meg. A mag újraindítását igényli."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Az emulátor kényszerítése egy adott BIOS fájl használatára."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches."
msgstr "Az emulált CPU frekvenciájának kényszerítése. Csökkentheti a lassulást, de hibákat okozhat."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Az emulált CPU frekvenciájának kényszerítése. Csökkentheti a lassulást, de hibákat okozhat. Az alapértelmezett 57%."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "A játékrégió frekvenciájának kényszerítése az emulációs sebességproblémák elkerülésére, hagyja 'Auto' értéken, hacsak nem észlel sebességproblémát."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "A használandó billentyűzet kényszerítése, ha több billentyűzet csatlakozik."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "A memóriabank-vezérlő kényszerítése. Csak akkor módosítsa, ha egy játék nem fut helyesen. A mag újraindítását igényli."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "A monokróm megjelenítési módok kényszerítése, mint egy korabeli zöld vagy borostyán monitoron."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "A játék által érzékelt Wiimote-ok számának kényszerítése. Állítsa 1-re azoknál a játékoknál, amelyek több kontroller csatlakoztatásakor azonnal többjátékos módra váltanak."

msgctxt "game_options"
msgid "Force the region of the system."
msgstr "A rendszer régiójának kényszerítése."

msgctxt "game_options"
msgid "Force the rendering and display of frames to progressive mode."
msgstr "A képkockák renderelésének és megjelenítésének kényszerítése progresszív módra."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "A médiafájl típusának kényszerítése"

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Az SDL illesztő használatának kényszerítése a kontrollerekhez; állítsa be, ha 4-nél több kontrollert használ, mivel az XInput 4 játékosra korlátoz."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Az SDL vagy DInput illesztő használatának kényszerítése a kontrollerekhez; állítsa be, ha 4-nél több kontrollert használ, mivel az XInput 4 játékosra korlátoz."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Adott softlist használatának kényszerítése, a szoftverlistának a 'bios\mame\hash' mappában kell lennie."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "A magas szintű BIOS emuláció használatának kényszerítése."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Beszédkazetta kényszerítése az 1. helyre, a 'voice.zip' BIOS fájlt igényli."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "A kormány indexének kényszerítése, hasznos lehet, ha a RetroBat rossz indexet állít be."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "60 Hz-es frissítési gyakoriságot kényszerít."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "A konzolt NTSC helyett PAL módba kényszeríti, lomhának tűnhet."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "A blit és képmanipuláció CPU-n történő emulálását kényszeríti, bizonyos esetekben pontosabb, és szükséges olyan játékokhoz, mint a GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Raw input illesztőt kényszerít olyan eszközök használatakor, mint a trackball és a spinner."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Kényszeríti a motor kompatibilitási szintjét. Állítsa MBF21-re az ezt igénylő WAD-okhoz."

msgctxt "game_options"
msgid "Full precision of 12-bit for the MCM5205 ADPCM can reduce whining noise during ADPCM playback."
msgstr "Az MCM5205 ADPCM teljes 12 bites pontossága csökkentheti a sípoló zajt ADPCM lejátszás közben."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Teljes képernyős felbontás. Alapértelmezetten az asztal felbontása használatos."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "A kamera teljes vezérlése a jobb karral."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "A GST állapotmentéseket a Kega és a Gens is meg tudja nyitni, de kevesebbet tárolnak a gép állapotából."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "A meghajtópanel erőinek erősítése. Alapértelmezetten 30%, a 200% megduplázza őket."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Játékfelbontás. A nagyobb értékek többet mutatnak a játéktérből."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "A gamepad kormányzási útja versenyjátékokban. Alapértelmezetten 66%, kormányra nincs hatással."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Gamepad: a kontroller és a billentyűzet mozgatja a CD-i mutatót. Egér: a PC egere mozgatja a mutatót (point and click és pisztolyos játékok), a kontroller csak a gombjait tartja meg. A Hotkey + L3 a játék közben vált."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "A gamepadek lesznek az 1., 2.... játékosok, az arcade karok a következő játékosokhoz kerülnek."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Általános célú időzítési hack."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "A német és a francia a játék PAL, a japán az NTSC verzióját igényli."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "A teljes billentyűzet átadása a játéknak (a Scroll Lock visszaadja a gyorsbillentyűknek) és az egér befogása. A gamepad továbbra is működik."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Jó a gyorsítótár-emulációs problémákra."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Grafikus lapkakészlet a nem AGA modellekhez. Az Automatikus a kiválasztott modellt követi, ami szinte mindig a kívánt beállítás."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "A játék rendereléséhez használt grafikus bővítmény."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Grafikai minőség előbeállítás (textúrák, szűrés). Az AUTO a memória mennyisége alapján választja ki."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Nagyban befolyásolja a CPU teljesítményét."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Jelentősen javítja a render-to-texture effektusokkal létrehozott textúrák minőségét. Alapértelmezetten engedélyezve. Letiltása megelőzheti az összeomlást egyéni textúrákat használó játékoknál."

msgctxt "game_options"
msgid "Greatly inscrease the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Jelentősen javítja a render-to-texture effektusokkal létrehozott textúrák minőségét. Alapértelmezetten engedélyezve. Letiltása megelőzheti az összeomlást egyéni textúrákat használó játékoknál."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Kontrollerrel játszott pisztolyos játékok (fénypisztoly nélkül). Relatív: a kar mozgatja a kurzort. Abszolút: a kar helyzete a képernyő pozíciója, elengedéskor visszatér középre."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "A HLE gyors, az LLE pontosabb, de DSP ROM fájlokat igényel."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "A HOTKEY + START a kilépés billentyűt (X) küldi a Visual Pinballnak az ablak bezárása helyett."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "A HOTKEY + START a kilépés billentyűt (X) küldi a Visual Pinballnak az ablak bezárása helyett: megnyílik a menüje (a MENÜ LETILTÁSA beállítással az asztal kilép)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 gyorsmentés, START+L3 gyorsbetöltés, START+R3 képernyőkép. Alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Egyes játékokhoz szükséges hack (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Egyes játékokhoz szükséges hack."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "A fél scanline-ok CRT kijelzőt utánoznak. Az 560 x 192 tisztább képet ad lapos kijelzőn."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Merevlemez-vezérlő, a .hdv és .2mg merevlemez-képek futtatásához szükséges. A módosítás újraindítja a gépet."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Alapértelmezetten elrejtve, tiltsa le, ha egy játék nem indul el megfelelően."

msgctxt "game_options"
msgid "Hide in-game crosshair (game dependant)."
msgstr "Játékbeli célkereszt elrejtése (játékfüggő)."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Játékbeli fegyvermodell elrejtése (játékfüggő)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Az érintőképernyő mutatójának elrejtése inaktivitáskor (időtúllépés)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "A shader és PPU fordítási tippek elrejtése."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "A célkereszt elrejtése bizonyos idő után, ha nem céloz vagy lő. Amint újra céloz, visszatér."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "A kép széleinek elrejtése, ahogy egy TV teszi, vagy szegély hozzáadása (negatív értékek)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Az egyes lövéseknél megjelenő fehér villanás elrejtése."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Egyes Portfolio OS funkciók magas szintű emulációja. Javíthatja a teljesítményt egyes játékokban."

msgctxt "game_options"
msgid "High sound quality for games using expansion audio"
msgstr "Kiváló hangminőség a bővítőhangot használó játékokhoz"

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "A nagyobb pontosság egyes játékok hibáit javítja a teljesítmény rovására. Csak akkor használatos, ha az SPU dekóder Dinamikus vagy LLVM."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "Magasabb képfrissítés képkocka-interpolációval, a függőleges szinkronizálás korlátozza. Kisebb vizuális vagy animációs hibákat okozhat."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "A nagyobb pontosabb, de lassabb."

msgctxt "game_options"
msgid "Higher values give better signal noise ratio and preservation of higher frequencies."
msgstr "A nagyobb értékek jobb jel-zaj viszonyt és a magasabb frekvenciák jobb megőrzését adják."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "A nagyobb értékek kevesebb memóriát használnak, a kisebbek gyorsabban futnak."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "House of the Dead 4 sebességjavítás: CPU frekvencia GHz-ben (pl. 4.3). Ha nincs megadva, automatikusan felismeri."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Mennyire kell elmozdítani a kart, mielőtt az Amiga érzékeli. Növelje, ha a karakter magától elmászik."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Milyen gyorsan mozog a paddle."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Milyen gyorsan mozognak a paddle-k, ha az egér a játékport eszköze."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "A képernyőszélesség mekkora része mozgatja a paddle-t végponttól végpontig. A kisebb érték gyorsabbá teszi a paddle-t, és lehetővé teszi, hogy a mutató képernyőről való kimozdítása nélkül elérje a végállásait, amire egyes kalibrációs képernyőknek szüksége van."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Mennyire erősen reagál a kar."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Hogyan jelenjen meg a TV képernyő és a GamePad képernyő."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Hogyan jelenik meg a kontroller az Amiga számára."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Hogyan jelenik meg a kontroller az Amiga számára. A 'Joystick' a klasszikus 2 gombos kar, amelyet minden játék megért. A 'CD32 kontroller' hozzáadja a színes gombokat, és CD32-n automatikusan kiválasztódik."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Hogyan renderelődik a kép. Az RGB a legélesebb, a kompozit és TV módok egy korabeli kijelző színfolyását reprodukálják."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Hogyan renderelődik a kép. A kompozit módok egy korabeli kijelző színfolyását reprodukálják, az RGB a legélesebb."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Hogyan skálázódik a kép a képernyőre."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "A hibrid azonnal rajzolja az új shadereket, amíg azok felépülnek. Az aszinkron egy pillanatra hiányzó objektumokat hagyhat. A szinkron minden shaderre várakoztatja a játékot."

msgctxt "game_options"
msgid "If Custom is selected it will use MesenPalette.pal as custom palette in bios directory."
msgstr "Ha az Egyéni van kiválasztva, a bios könyvtárban lévő MesenPalette.pal lesz az egyéni paletta."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Ha Ki, letiltja azt a dithering mintát, amelyet a PSX a színsávosodás ellen alkalmaz."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Ha letiltva, a DualShock egy váltó kombinációval kapcsolható DIGITÁLIS/ANALÓG között."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Ha letiltva, ezek a modulok csak szükség esetén fordulnak le. A játéktól függően ez váratlanul és akár gyakran is megszakíthatja a játékmenetet."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Ha több pisztoly eszköz csatlakozik, ezzel az opcióval csak egy pisztoly állítható be."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Szükség esetén a használandó GBA rom megadása."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Ha a mappa neve tartalmazza a 'soniccd' szót, a RetroBat automatikusan a Sonic CD RSDK-t futtatja, ezzel kényszeríthető."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Ha a joystick ezen a holtzónán belül van, a kurzor nem mozdul."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Ha mozgásérzékelős gamepadet használ, például DualShockot vagy Switch Prót, engedélyezze a mozgásérzékelő használatához."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Ha valódi Wiimote-okat használ Sensor Barral, a jobb pontosság érdekében állítsa be a Sensor Bar helyes pozícióját."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "A Horizon OS szolgáltatások figyelmen kívül hagyása, megoldhatja egyes játékok összeomlását."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Az e küszöb alatti analóg karmozgások figyelmen kívül hagyása."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "A 'bios\mame\ini' mappában lévő ini fájlok figyelmen kívül hagyása."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "A kis karmozgások figyelmen kívül hagyása a középpont körül. Növelje, ha a képernyőn lévő kurzor magától elmászik."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Az asztalspecifikus backglass beállítások (.res fájl az asztal mellett) figyelmen kívül hagyása a játék alatt. A fájl megmarad, és kilépéskor visszaáll."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "A shadPS4-ben mentett játékonkénti beállítások figyelmen kívül hagyása, mindig a RetroBat beállításait használja."

msgctxt "game_options"
msgid "Improve performance at the cost of accuracy and input lag."
msgstr "A teljesítmény javítása a pontosság és a bemeneti késleltetés rovására."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "A teljesítmény javítása 4-nél több magos CPU-knál, alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Sok játékban javítja a teljesítményt. Letiltása más játékokban megelőzheti a grafikai hibákat."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "A poligonrenderelés javítása OpenGL renderelő használatakor."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "A shader pontosság javítása. Letiltása kis sebességnövekedést ad, de egyes játékokban grafikai hibákat okozhat."

msgctxt "game_options"
msgid "Improve the loading of discs of the emulated game."
msgstr "Az emulált játék lemezeinek betöltését javítja."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements."
msgstr "A felbontás javítása nagyobb teljesítményigény árán."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "A felbontás javítása nagyobb teljesítményigény árán. Csak OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "A felbontás javítása nagyobb teljesítményigény árán. Redream kulcsot igényel."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "A felbontás javítása nagyobb teljesítményigény árán. Csak Vulkan és OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Egyes játékokban javítja a pontosságot, de csökkentheti a teljesítményt."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Javítja a színmélységet."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Egyes játékokban javítja a teljesítményt, de minden EFB-alapú effektust kihagy."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Javítja a teljesítményt."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Javítja a teljesítményt. Több konzolnál kísérleti."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Egyes játékokban javítja a stabilitást, de csökkenti a teljesítményt."

msgctxt "game_options"
msgid "Improves the data loading speed."
msgstr "Javítja az adatbetöltés sebességét."

msgctxt "game_options"
msgid "Improves the emulation performance at the cost of accuracy."
msgstr "Az emuláció teljesítményét javítja a pontosság rovására."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Csak OpenGL-ben."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "Többlemezes játékoknál .m3u fájl használatakor adja meg az indítandó lemez számát."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "A pontosság növelése, javíthat egyes hang- és sebességproblémákat."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Növelje, ha a lövések kissé a cél mellé regisztrálódnak."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Növelje, ha a nézet vagy a játékos magától mozog."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Növelje, ha a nézet vagy a játékos magától mozog. Az alapértelmezett 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "A 3DFx Voodoo OpenGL felbontásának növelése."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "A képernyőn egyszerre megjeleníthető sprite-ok számának növelése."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Növeli a RAM-használatot és az első indítás idejét, de csökkenti a lemezolvasást az indítás után."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "Az érték növelése hibákat okozhat."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "A szín render targeteket az emulált memóriából inicializálja. Egyes játékok helyes megjelenítéséhez szükséges, csökkentheti a teljesítményt. Alapértelmezetten ki."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "A mélységi render targeteket az emulált memóriából inicializálja. Egyes játékok helyes megjelenítéséhez szükséges, csökkentheti a teljesítményt. Alapértelmezetten ki."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Adja meg a használandó szervert 'x.x.x.x:y' formátumban."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "MoonSound bővítmény behelyezése az I/O helyre."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Video9000 bővítmény behelyezése az I/O helyre."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Lemez behelyezése a floppymeghajtóba, gyakran használatos CD-ROM-os játékoknál."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Telepített videóchip. Az Automatikus a TMS9918A-t használja, hacsak a játék nem igényli az F18A bővítést. A mag újraindítását igényli."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "A hangkimenet interpolálása a jobb minőségért."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "Az értelmező kompatibilisebb a JIT dinamikus újrafordítónál, a JIT gyorsabb."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Az A/B és X/Y gombok felcserélése."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "A Zapper fényérzékelő jelének invertálása. Egyes pisztolyhardverekhez szükséges."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "A Zapper ravaszjelének invertálása. Egyes pisztolyhardverekhez szükséges."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "A gamepad jobb analóg karja függőleges tengelyének megfordítása."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "A célkereszt fel-le célzási vezérlésének megfordítása."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "A fel-le nézés megfordítása (gamepad és egér)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "A fel-le nézés megfordítása a gamepaddel."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "A fel-le nézés megfordítása a jobb karral."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "A függőleges tengely megfordítása repülés közben."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "A JIT a leggyorsabb, az értelmező pontosabb."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Just In Time fordítás. Nagyban gyorsítja a 68020-as és későbbi modelleket. 68000-es gépeken figyelmen kívül marad, ciklus-pontos módban automatikusan letiltódik."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "A DOS parancsértelmező aktív marad kilépéskor vagy sikertelen indításkor."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "A játékfájlok megtartása vagy törlése kicsomagolás után (squashfs, 7z)"

msgctxt "game_options"
msgid "Keep the CD image in memory."
msgstr "A CD-kép memóriában tartása."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Az eredeti képarány megtartása a kép nyújtása helyett."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Az Amiberry saját menüjét megnyitó billentyű. Az F12 az egyetlen funkcióbillentyű, amely az Amigán soha nem volt, így ez az egyetlen, amely szabad marad."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Billentyű, amely emuláció közben vált ablakos és teljes képernyős mód között."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Joystickként használt billentyűk, ha nincs kontroller csatlakoztatva. A nyilakkal a jobb Ctrl-lel lehet tüzelni. A számbillentyűzettel a 0-val vagy 5-tel. A WASD-vel a bal Alt-tal."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "Az L2, R2, L3 és R3 az aktuális karakter speciális mozdulatait hajtja végre, ha a játék felsorolja őket. Alapértelmezetten be."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = szerviz, R3 = teszt, a játékok operátori menüjének megnyitásához. Alapértelmezetten be."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "Az LLVM a leggyorsabb, probléma esetén használja az értelmező beállításait."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "Az LLVM a leggyorsabb lehetőség nagyon jó kompatibilitással. Ha problémák jelentkeznek, használja az ASMJIT újrafordítót."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "A nyelv, amelyen a játékok szövege megjelenik."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "A menük és a játékbeli szövegek nyelve. A játékban nem elérhető nyelv figyelmen kívül marad, és a játékbeli beállítás megmarad."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "A feliratok nyelve. A játékban nem elérhető nyelv figyelmen kívül marad, és a játékbeli beállítás megmarad."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "A szinkronhangok nyelve. A játékban nem elérhető nyelv figyelmen kívül marad, és a játékbeli beállítás megmarad."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Nagy gyorsulás többmagos CPU-kon, de kevés játék lefagy vele."

msgctxt "game_options"
msgid "Launch DemulShooter for gun games."
msgstr "A DemulShooter indítása pisztolyos játékokhoz."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "A MameHooker indítása a kimenetek kezeléséhez."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Hagyja 'Auto' értéken, hacsak a felismerés nem sikertelen."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Hagyja alapértelmezésként AUTO értéken, hacsak a játék nem igényel egyedi beállítást."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Hagyja AUTO értéken az automatikus felismeréshez."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Hagyja auto értéken a játék tájolásához való automatikus igazodáshoz, szükség esetén ezzel a beállítással kényszeríthető."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Hagyja kikapcsolva, hacsak a szinkronizálás forrása nem a videó: a vsync és a hangszinkronizálás rosszul működik együtt."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Hagyja AUTO értéken, hogy az emulátor a '\bios\pcsx2\bios' mappában talált első érvényes BIOS-t válassza."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Hagyja Automatikus értéken, hogy megmaradjon a kiválasztott modellben valóban meglévő processzor. A gyorsabb CPU elronthatja a pontos időzítésre építő játékokat."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Hagyja Automatikus értéken, hacsak egy játéknak nem kell egy adott ROM. A fájlnak a bios mappában kell lennie. A mag újraindítását igényli."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Hagyja alapértelmezetten BE állásban a CPU JIT optimalizálások engedélyezéséhez."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Hagyja 16:9-en, hacsak nincs 4:3-as monitorja."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Hagyja alapértelmezetten bekapcsolva, a rendereléshez több szálat használ."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "A KÉZI nem módosítja a felhasználó által megadott értéket, az AUTO 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "A balból jobb, a felülből alul lesz."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Az ALTIRRA válassza ki a profilt a játék alapján."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "A RetroArch saját autoconfig profiljaival rendelje hozzá a kontrollereket a RetroBat hozzárendelése helyett. Felülírja a RetroBat automatikus konfigurációját."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "A RetroBat megpróbálja kinyerni az indítási szekvenciát a MAME hash fájlból vagy a fájlnévből (zárójelek)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "A RetroBat megpróbálja kinyerni az indítási szekvenciát a MAME hash fájlból."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "A Visual Pinball maga váltson a kiválasztott videómódra az asztal felbontásának módosítása helyett."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Lehetővé teszi, hogy egy MegaWiFi kazetta ROM elérje a hálózatot és az internetet. Csak megbízható ROM-okhoz engedélyezze."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "A mag maga ütemezi magát a RetroArch helyett. Próbálja a 'standard 50 Hz' értéket, ha egy PAL játék egyenetlenül fut."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Lehetővé teszi, hogy az emulátor visszaolvassa a GS memóriát. Alapértelmezetten be. Kikapcsolva gyorsabb, de elronthat egyes grafikai effektusokat."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "A bal kar is joystickként működhet az iránykereszt mellett."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "A játék képfrissítési korlátjának feloldása, ahol a játék engedi. Az eredetitől eltérő érték elronthatja a játékot."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "2-4 Lynx összekapcsolása ComLynx kábellel egy képernyőn, mindegyiknek saját kontrollerrel. Letiltja az állapotmentéseket és a teljesítményeket."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Egyéni profil betöltése a kormány hozzárendeléséhez."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Modok (.dusk fájlok) betöltése a játékkal azonos nevű, mellette lévő mappából, vagy a dusklight\data\mods mappából, ha nincs ilyen."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Modok betöltése a User\Load\GraphicsMods mappából."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "A játék mods mappájába helyezett modok betöltése (modonként egy mappa egy mod.ini fájllal). Alapértelmezetten be."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Grafikai minőség előbeállítás betöltése (textúrák, szűrés, lágy részecskék). Hagyja AUTO értéken a játékbeli beállítások megtartásához."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Egy többlemezes játék első két lemezét egyszerre tölti be az 1. és 2. meghajtóba, nem csak az 1.-be. Annak a néhány játéknak kell, amely két meghajtót kér."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Az emulátor mappájában lévő Data\Assets\HDTextures\<rom> csere textúráinak betöltése."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "A teljes lemezkép betöltése a memóriába. Gyorsabb betöltés, nagyobb RAM-használat."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Az alacsony shaderminőség javíthatja a teljesítményt, de hibákat okozhat."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Az alacsonyabb kisebb késleltetést jelent, a túl alacsony kieséseket okoz."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "A GS pontosság csökkentése a pixelek közötti rések elkerülésére felskálázáskor. Javítja a Wild Arms szövegét és a SoulCalibur szellemképét."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Az alacsonyabb értékek csökkentik a hangkésleltetést, a magasabbak a recsegést."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "MSAA vagy SSAA szint."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "A gép időzítése. A 60 Hz az amerikai, az 50 Hz az európai gép. Néhány európai programnak 50 Hz kell a helyes sebességhez. A módosítás újraindítja a gépet."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Fő memória. Az Auto a modell RAM-ját vagy a játékadatbázist használja. A nem támogatott méretek a modell következő méretére kerekítődnek."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "A warp mód jelentős gyorsítása a SID emuláció 'FastSID'-re váltásával warp közben."

msgctxt "game_options"
msgid "Makes the emulator auto fast forward CD loading sequences."
msgstr "Az emulátor automatikusan gyorsítja a CD betöltési szakaszokat."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "A játékos által használt kontroller kézi hozzárendelése. Csak akkor szükséges, ha a RetroBat nem tud megkülönböztetni két azonos kontrollert, például egy Windows által egy eszköznek látott 2 játékos arcade enkódernél. Egyébként hagyja AUTO értéken."

msgctxt "game_options"
msgid "Manually select a 4 Player Adapter for some games"
msgstr "4 játékos adapter kézi kiválasztása egyes játékokhoz"

msgctxt "game_options"
msgid "Manually specify your choice of Neo Geo BIOS."
msgstr "A választott Neo Geo BIOS kézi megadása."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Sok játéknak csak textúrába másolás kell, de ha elsötétült vagy hiányzó grafikát lát, lehet, hogy a RAM-ba másolást kell választania."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Egy 8BitDo M30 vagy hasonló kontroller gombonkénti hozzárendelése az mdControllers.json fájlból."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Kontroller hozzárendelése Racing Controllerként, a versenykormánnyal nem kompatibilis játékok nem fognak működni."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "A Select hozzárendelése egy további gombhoz, hasznos a Zelda játéknál, hogy mentéskor ne lépjen ki."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "A ravaszokat az analóg kar függőleges tengelyére képezi le. Hasznos a Gran Turismóhoz és más versenyjátékokhoz."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "A színeket a valódi hardveren látható megjelenéshez igazítja."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Matematikai társprocesszor. Csak maroknyi Amiga játék használja, és egy olyan géphez adva, amelyben sosem volt, megzavarhat néhány játékot."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "A joystick érintőkurzor maximális sebessége."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "A textúra felskálázáshoz használt CPU szálak maximális száma. Használja a szálak teljes számát mínusz 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Egyes játékokban artefaktumokat okozhat."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Javíthatja a teljesítményt egyes sokmagos processzoroknál. Bizonyos helyzetekben lassulást okozhat a további munkaszál terhelése miatt."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Csökkentheti az akadozást a játék hosszabb indítási ideje árán."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "A váltottsoros videómódokhoz használt módszer (Nintendo 64-re nem vonatkozik)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "A váltottsoros videómódokhoz használt módszer."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "A lemezről való adatolvasás módszere: a szinkron az eredeti hardvert utánozza, az aszinkron csökkentheti az akadozást, az előgyorsítótárazás a teljes képet betölti a kezdeti késleltetés árán."

msgctxt "game_options"
msgid "Might fix some misaligned fog, bloom or blend effect."
msgstr "Javíthatja a rosszul igazított köd-, bloom- vagy keverési effektusokat."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Egyes Famicom-klónokat utánoz, amelyek felcserélik a négyszögjel-csatornák kitöltési tényezőit."

msgctxt "game_options"
msgid "Mimics the display characteristics of the Game Gear and Nomad LCD panels."
msgstr "A Game Gear és a Nomad LCD paneljeinek megjelenítési jellemzőit utánozza."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "A mip-leképezés egyes játékokhoz szükséges."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "A világ vízszintes tükrözése, mint a játék Wii verziójában."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "A Mockingboard C a legtöbb játék által támogatott hangkártya. A Mouse Cardot csak valódi Apple egeret igénylő szoftverhez válassza, ez helyettesíti a hangkártyát. A módosítás újraindítja a gépet."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "A Mockingboard a legtöbb játék által támogatott hangkártya. A bővítőhely nélküli //c modelleken figyelmen kívül marad."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "A játékosválasztó képernyőn előre kiválasztott mód. A letöltéses játékhoz (Download Play) az eredeti BIOS és firmware szükséges."

msgctxt "game_options"
msgid "Modify the coin setting to Free Play."
msgstr "Az érmebeállítás módosítása ingyenes játékra (Free Play)."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "A monokróm mód a nagy felbontású (640x400) játékokhoz szükséges."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Pontosabb CD blokk emuláció. CD blokk ROM-ot igényel, és letiltja az olvasási sebesség beállítást."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "Pontosabb működés, de alacsonyabb teljesítményt okozhat. Alapértelmezetten BE."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "A legtöbb játék a 2. portot használja, ezt a beállítást azokhoz a régi játékokhoz használja, amelyek a joystickot az 1. portban igénylik."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "A C: meghajtó automatikus csatolása indításkor."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Egér: olyan játékok, mint az Elansar vagy a Defender of the Crown. Analóg kar: BattleSphere, a játék beállításaiban is válassza ki."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Az egér mozgatása az 1. kontroller analóg karjával (L2/R2 = gombok). Az egyik portot Egérre kell állítani."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Mozgás a bal analóg karral és az iránykereszttel is. Alapértelmezetten be."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level."
msgstr "Többmintás élsimítás (MSAA) szintje."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Többmintás élsimítás (MSAA) szintje. Csak OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Többmintás élsimítás (MSAA) szintje. Csak Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "A joystick kurzorsebességére alkalmazott szorzó, amíg a mutatógyorsító gomb (alapértelmezetten L2) nyomva van."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "A multitapot be kell állítani, ha 2-nél több játékos szeretne játszani."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "A floppymeghajtók mechanikus zajának némítása."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "A NEM csak a bal szem képét mutatja. Az anaglifhez azonos színű 3D szemüveg kell, az egymás melletti mód VR headsetekhez és 3D kijelzőkhöz való."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "Az NTSC a cdi200.rom, a PAL a cdi220b.rom fájlt használja."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "A játék natív felbontása. Alapértelmezetten a játékban beállított."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Néhány játékhoz szükséges, köztük több point and click címhez."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "A játék indításához nem kell érme."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Az emulált floppymeghajtók száma. Egy valódi Amiga 500-ban csak egy volt. Két meghajtó gyorsítja a többlemezes játékokat, de néhány cím csak egyet vár."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "A turbó lenyomások közötti képkockák száma."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Alapértelmezetten ki. Az adaptív nem vár a kijelzőre, ha egy képkocka késik."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Alapértelmezetten ki: az emulátor magától arcade sebességgel (57,5 Hz) fut. Kapcsolja be, ha a kép szakad."

msgctxt "game_options"
msgid "Offset for the ST/UV texture coordinates."
msgstr "Az ST/UV textúrakoordináták eltolása."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "120 Hz-es vagy gyorsabb monitoron G-Sync vagy FreeSync nélkül használja a 60 Hz többszörösét képező legmagasabb frissítési gyakoriságot."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Alapértelmezetten be, kapcsolja ki a 11 kHz-es hangminőséghez."

msgctxt "game_options"
msgid "On by default."
msgstr "Alapértelmezetten be."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Alapértelmezetten be. Kapcsolja ki a sebesség növeléséhez integrált videokártyákon."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Alapértelmezetten be. Kapcsolja ki, ha a pisztolynak saját célzása van (lézer, Sinden célkereszt)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Egy pixel játékpixelenként (shaderekhez ajánlott)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Csak akkor érvényes, ha a textúra felskálázás (xBRZ) engedélyezve van. Az ennél nagyobb textúrák nem skálázódnak fel."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Csak az ÁZSIA/JAPÁN MVS rendszerrel kompatibilis."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Csak OpenGL-lel kompatibilis, szigorúan szinkronizálja a GPU-t és a CPU-t. Csökkenti a késleltetést nagyobb teljesítményigény árán."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Csak szoftveres videó illesztővel kompatibilis."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Csak akkor érvényes, ha az FPS KORLÁTOZÁSA engedélyezve van. Alapértelmezett: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Csak a játékok ázsiai verzióihoz."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Csak az újabb Ikemen GO verziókhoz. A Vulkan kísérleti."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Csak az ennél nagyobb képpufferek skálázódnak fel, javíthat egyes problémákat bizonyos játékokban."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Csak akkor használja a képkocka-korlátozót, ha egy játék nélküle túl gyorsan fut. Egyes játékok összeomolhatnak túl magas képfrissítésnél. Ilyenkor állítsa a Ki-től eltérő értékre."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Csak akkor használja, ha két azonos kontrollere van, és azokat nem ismeri fel helyesen. A kontrollereket pozíció és nem név szerint rendeli hozzá, ami kevésbé megbízható."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Csak az ablak kicsinyítésére használja, ha a Windows beállításaiban skálázás van."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Csak akkor használatos, ha be van állítva — a P2-nek nincs alapértelmezett célkereszt képe."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Csak akkor használatos, ha MIDI kimeneti eszköz van kiválasztva."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "A játék futtatásához használt OpenBOR motorverzió. Az Auto a játék adataiból vagy a fájlnévben lévő [XXXX] buildszámból ismeri fel, mint az önálló OpenBOR-nál."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "A shaderekhez és a belső felbontáshoz OpenGL szükséges."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Csak OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Csak OpenGL. Javítja a fekete képernyőt egyes AMD integrált videokártyákon, néhány játék hibásan renderelődik."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Második ablakot nyit a Gamepad nézethez."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Opcionális hangkártya (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) vagy mélynyomó (Gaelco játékok). Alapértelmezetten keverés, a Star Wars Racer Arcade-nál csak az alaplap."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "A CPU, az SA-1 chip és a Super-FX chip túlhajtása, csökkentheti a lassulást, de egyes játékokban problémákat okozhat."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Mindkét SH-2 CPU túl- vagy alulhajtása. A 100 a gyári sebesség."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Az emulált fő CPU túl- vagy alulhajtása. Segíthet stabilizálni a képfrissítést, de egyes játékokat elront."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Az emulált 68k chip túlhajtása a jobb képfrissítésért."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "A RetroBat gamepad hozzárendelésének felülbírálása a felhasználó saját, az emulátor script mappájában lévő hozzárendelésével."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Az asztal alapértelmezett megvilágításának felülbírálása."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "A PAL 50 Hz-en fut, és szinte minden európai Amiga címhez helyes. Az NTSC 60 Hz-en fut, és maroknyi amerikai kiadáshoz illik."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "A POM2 a kontrollereket saját helyszámuk alapján azonosítja, amely nem követi a RetroBat játékossorrendjét. Az Automatikus az elsőként találtat veszi, módosítsa, ha rossz kontroller reagál."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "A TOS fájl patchelése a gyorsabb indításért."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Az AGS WinUAE mappájának elérési útja; ha ki van töltve, a RetroBat hozzáadja az ags indítót az amiga rendszerhez."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Az ExoDos mappájának elérési útja, kötelező ahhoz, hogy a RetroBat megtalálja az ExoDOS játékokat."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Az ExoWin3x mappájának elérési útja, kötelező ahhoz, hogy a RetroBat megtalálja az ExoWin3x játékokat."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Az ExoWin9x mappájának elérési útja, kötelező ahhoz, hogy a RetroBat megtalálja az ExoWin9x játékokat."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Játékonként: minden játéknak saját 8 KB-os konzolmemóriája van, így soha nem telhet meg. Megosztott: egy memória minden játékhoz, mint egy valódi lejátszón."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Pixelenkénti megvilágítás vertexenkénti helyett. Egyes játékokban javítja a minőséget."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Teljesítménynövelés, egyes játékoknál, például a GT6-nál stabilitást is hozhat."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Helyezzen el egy egyéni célkereszt képet, és válassza ki alább."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Helyezzen egyéni 'crosshair.png' fájlt az emulátor 'cross' almappájába, vagy válasszon fájlt alább."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Helyezzen egyéni 'crosshair.png' fájlt az emulátor 'cross' almappájába."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: a kar felfelé tolása emelkedést jelent (a gépszekrényen a kar hátrahúzásával lehet emelkedni)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "MVS játékok érmék bedobása nélkül."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Figyelmeztető hangjelzés alacsony életerőnél."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "A VMU hangjelzéseinek lejátszása."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Játék csak valódi Wiimote-okkal, más kontrollerek nem fognak működni."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Az indításkor megjelenő játékosválasztó képernyőn előre kiválasztott játékosszám."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "RetroPadek csatlakoztatása különböző portokba, hasznos 4 játékos adapterekhez."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Egér csatlakoztatása a joyportba, ez eltávolítja a csatlakoztatott joystickokat."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "További joystickok csatlakoztatása a 2., 3. és 4. portba."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "A GunCon csatlakoztatása a 2. portba, a Die Hard Trilogyhoz."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "MIDI kártyát csatlakoztat, és a kimenetét erre a Windows MIDI eszközre küldi, az emulátor MIDI beállításai szerinti számozással. A NINCS megtartja a szokásos FM hangot."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "A RetroArch 'system' könyvtárának másik mappára irányítása."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Az 1. port mindig a Wii U GamePad. Wii Remote adható hozzá azokhoz a játékokhoz, amelyek igénylik."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "A Light Phaser portja. Alapértelmezetten az 1. port."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "A Super Scope portja. Alapértelmezetten a 2. port."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "A Zapper portja. Alapértelmezetten a 2. port."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Csökkentheti a betöltési időt a hosszabb indítási idő árán."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "PowerPC újrafordító, alapértelmezetten be és sokkal gyorsabb. Kapcsolja ki az értelmezőhöz."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "A shader gyorsítótár előfordítása a játék indításakor, hagyja BE állásban a kevesebb akadozásért."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "A precíz a legpontosabb, a laza javíthatja a teljesítményt, de egyes játékokat elronthat."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Előnyben részesített régió. Az ezt el nem fogadó játék egy általa elfogadottra vált vissza."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Az összes CD-sáv előzetes betöltése a RAM-ba."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Egyéni textúrák előzetes betöltése indításkor."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Megnyomásra megnyitja az Amiberry menüjét."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Megnyomásra újraindítja (reset) az Amigát."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Megnyomásra megjeleníti a képernyő-billentyűzetet."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Megakadályoz egyes artefaktumokat, de éles éleket eredményezhet."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Megakadályozza, hogy több játékos kevert hangja túlvezéreljen."

msgctxt "game_options"
msgid "Processor model."
msgstr "Processzor modell."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Processzor modell. A valódi gépnél gyorsabb CPU elronthatja a pontos időzítésre építő játékokat."

msgctxt "game_options"
msgid "Provider for the Adlib emulation. DEFAULT has good quality and low perf requirements."
msgstr "Az Adlib emuláció szolgáltatója. Az ALAPÉRTELMEZETT jó minőségű és alacsony teljesítményigényű."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Az 1. játékos kontrollerét az 1. portba helyezi a 2. helyett. Néhány játékhoz szükséges, köztük több point and click címhez."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Kényelmi finomítások: gyors átváltozás, nagyobb pénztárcák, gyors mászás, azonnali mentések, automatikus mentés, jobb térképmenük... A Klasszikus a GameCube-os játéknak felel meg. Nincs beállítva: a Dusklight menübeállításai megmaradnak."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD BILLENTYŰZETKÉNT: az iránykereszt a nyílbillentyűket, a gombok a SPACE / RETURN billentyűt küldik, a joystick-támogatás nélküli játékokhoz."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "Alapértelmezetten futás, a futás gombbal sétálni lehet."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "A ReShade-et a RetroBat egyes önálló emulátorokban a keretek és shaderek megjelenítésére használja. LETILTVA: a keretek helyette átfedő ablakkal jelennek meg. SAJÁT HASZNÁLATA: a RetroBat soha nem telepít, módosít vagy töröl ReShade fájlokat az emulátorok mappáiban."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "A render-to-texture eredmények olvasása a CPU-n. Egyes játékokban szükséges lehet, de képkocka közbeni szinkronizálást okoz, így hatalmas teljesítményhatása van."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "A lemez gyorsabb olvasása a konzol meghajtójánál. Nem minden játék számít rá."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Az ini fájl olvasása a 'bios' almappából."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Az ini fájl olvasása a 'bios\mame\ini' mappából."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "A valódi Amiga sebesség a biztonságos alapértelmezés. A Turbo gyorsabban tölt, de elronthat néhány betöltőt és másolásvédelmet."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Reality Signal Processor bővítmény, LLE-re kényszerítve, ha a videó illesztő Parallel."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Reality Signal Processor bővítmény."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Ajánlott: lineáris, ha a másodlagos képernyő skálája 100% alatt van."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "Az újrafordító a leggyorsabb, az értelmező pontosabb."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "Az újrafordító sokkal gyorsabb, az értelmező csak hibakereséshez hasznos. Újraindítást igényel."

msgctxt "game_options"
msgid "Recover significant color depth."
msgstr "Jelentős színmélység visszanyerése."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "A pontosság csökkentése a jobb teljesítményért, a grafikai minőség gyengébb lesz."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Az analóg vezérlés sebességének csökkentése, egyes játékok csak alacsony értékekkel játszhatók."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "A betöltési idők csökkentése. Elronthat néhány játékot, amely a lemez valós időzítéseire épít."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Az akadozás csökkentése a játék sokkal hosszabb indítási ideje és magas GPU-használat árán."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Csökkenti a VRAM-használatot a minőség rovására, növelheti az akadozást."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Csökkenti a DMC csatornára írt nagy értékek okozta kattanásokat. Pontatlan, lágyíthat egyes mintavételezett hangokat."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Csökkenti a recsegést és az akadozást, de lassabb CPU-kon jelentősen ronthatja a hangminőséget; hagyja AUTO értéken a letiltáshoz."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Csökkenti a villódzást."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Csökkenti az akadozást és gyorsítja az indítást az első indítás után."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Csökkenti a remegő poligonokat és a textúrák torzulását a 3D játékokban."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "ReelMagic MPEG lejátszás támogatása."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Az öv feltöltése bájitalokkal a felszerelésből."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "A memórialapok állapotának frissítése a GPU által írt adatok engedélyezéséhez. ('Team Ninja' játékoknál a hiányzó karaktermodellek javítására.)"

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "A NEC PAC firmware régiója. Japán: pac-n1.bin vagy pce-lp1.bin. US: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Többrégiós lemezeken elsőként választott régió."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 1."
msgstr "Az 1. játékos oldalsó gombjainak átkiosztása."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 2."
msgstr "A 2. játékos oldalsó gombjainak átkiosztása."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "n pixeles szegély eltávolítása a képernyő tetején és alján."

msgctxt "game_options"
msgid "Remove odd composite green/blue artifacting that appears on real hardware."
msgstr "A valódi hardveren megjelenő furcsa kompozit zöld/kék artefaktumok eltávolítása."

msgctxt "game_options"
msgid "Remove the original sprites-per-scanline hardware limit."
msgstr "Az eredeti, sorokénti sprite hardverkorlát eltávolítása."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Az oldalsó fekete sávok eltávolítása egyes átvezető jelenetekben (ultraszéles képernyők). Az eredeti képkivágáson kívüli területek hibásnak tűnhetnek."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "A felső és alsó fekete sávok eltávolítása célzás, célpontkijelölés, átvezető jelenetek és párbeszédek alatt."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "A lövéskor megjelenő fehér villanás eltávolítása."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Egy képkockányi bemeneti késleltetést szüntet meg, de megduplázza a rendszerigényt."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Eltávolítja az Amiga kép körüli fekete szegélyeket. Az erősebb beállítások többet vágnak le, és néhány játék széleit is levághatják."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Eltávolítja a kép villódzását a Hummerben."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Eltávolítja a fehér villanást, amely akkor jelenik meg, amikor a játékok kikapcsolják a 3D renderelést."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Renderelés a natív N64 felbontás többszörösén. Felülbírálja a belső felbontás beállítást, ha nem KI."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Gouraud árnyalás renderelése teljes pontossággal a színsávosodás csökkentésére a 3D játékokban."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "A használandó render target emulációs út. Az rtv/fbo jobb teljesítményt, az rov/fsi legnagyobb pontosságot ad."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Renderelési felbontás vektoros játékokhoz."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "24 bites színekkel renderel és eltávolítja a ditheringet."

msgctxt "game_options"
msgid "Replace meshed transparency by real transparency."
msgstr "A hálós átlátszóság cseréje valódi átlátszóságra."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Az eredeti textúrák cseréje egyéni textúracsomagra (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack in 'bios\dc\textures'."
msgstr "Az eredeti textúrák cseréje egyéni textúracsomagra a 'bios\dc\textures' mappában."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack."
msgstr "Az eredeti textúrák cseréje egyéni textúracsomagra."

msgctxt "game_options"
msgid "Replaces game's sprites by HD pack available in HdPacks bios directory."
msgstr "A játék sprite-jainak cseréje a HdPacks bios könyvtárban elérhető HD csomagra."

msgctxt "game_options"
msgid "Replaces post-processing multiple paving sprites by a single fat sprite."
msgstr "Az utófeldolgozás több csempéző sprite-ját egyetlen nagy sprite-ra cseréli."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "A valódi hardver aluláteresztő szűrőjét reprodukálja. Az 'Emulált' a gép saját szűrőkapcsolóját követi."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Megadott hely(ek) kérése, válassza fent a MEGADOTT HELY opciót."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "BASIC programokhoz szükséges. Az ATARIBAS.ROM fájlt használja, ha van, egyébként a beépített Altirra BASIC-et."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Forma-1-es játékokhoz szükséges."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "A Paper Mario: The Thousand-Year Door játékhoz szükséges."

msgctxt "game_options"
msgid "Required for certain games that use hi-res mode to produce transparency effects."
msgstr "Bizonyos játékokhoz szükséges, amelyek a hi-res módot átlátszósági effektusokhoz használják."

msgctxt "game_options"
msgid "Required for certain visual effects."
msgstr "Bizonyos vizuális effektusokhoz szükséges."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Szükséges ahhoz, hogy a visszatekerés gyorsbillentyű egyáltalán működjön."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Szükséges a játék Cycraft mozgó gépszekrény nélküli indításához."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "A Def Jam Icon javításához szükséges."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Egyes régi rom hackek futtatásához szükséges, kereskedelmi játékokhoz hagyja kikapcsolva."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Legalább '4X SSAA (RENDEZETT)' szükséges. A 4x módokhoz '16X SSAA (RENDEZETT)' kell."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Az emulált videókimenet felbontása."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "A Non-Java Mode bit értékeinek betartása a PPU háttérrendszerek vektoros műveleteinél. Ha bizonytalan, ne módosítsa. Alapértelmezetten ki."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "A joystick érintőkurzor válaszgörbéje."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "A RetroBat csak az 1. játékos kontrollerét állítja be."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "A RetroBat szinkronizálja a dolphin és a libretro-dolphin mentési mappáit."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "A RetroBat alapértelmezetten a psxonpsp BIOS-t használja, engedélyezze a régi SCPH550X BIOS fájl használatának kényszerítéséhez."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "A játékhoz felépített shader gyorsítótár újrahasználata. Az Auto az emulátorra bízza a döntést."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Sebességválasztás a jobb karral 4 fokozatú versenyjátékokban. H-gate: átlók, mint egy valódi váltóban. Irányok: fel 1, le 2, bal 3, jobb 4. Az L1/R1 mindig le-/felvált."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "A kijelző és a vezérlés elforgatása. Alapértelmezetten az ismert játékok automatikusan elfordulnak. KÉZI: a SELECT módosítja az elforgatást."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "A kijelző elforgatása függőleges játékokhoz, mega-bezel keretekkel való használathoz engedélyezze."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "A kijelző elforgatása függőleges játékokhoz."

msgctxt "game_options"
msgid "Rotate display for vertical screen."
msgstr "A kijelző elforgatása függőleges képernyőhöz."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "A kijelző elforgatása, hasznos lehet bizonyos függőleges kijelzőt igénylő játékokhoz."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Az akciógombok elforgatása az elrendezés módosításához."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "A játéktér képernyő Windows-kijelzőjének elforgatása játék közben, kilépéskor visszaáll (Visual Pinball 10.8 és újabb)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "A kimenet elforgatása függőleges lövöldözős játékokhoz."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "A lendítés szélső pontjain alkalmazott elforgatás."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Maximális sebességű futás, amíg egy CD-ROM-os játék álló, néma képernyőn tölt."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Maximális sebességű futás lemez vagy magnókazetta betöltése alatt, amikor nem szól hang. Lemezekhez a VALÓDI MEGHAJTÓ-EMULÁCIÓ szükséges."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Futás az eredeti 57,524 Hz-en 60 Hz helyett. 60 Hz-es képernyőn akadozhat."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Alapértelmezetten futás, a futás gomb sétál. Alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Alapértelmezetten futás, a futás gomb sétál. Egyjátékos módban állóképességet fogyaszt."

msgctxt "game_options"
msgid "Run games faster. A powerful option for gaining performance that has no downsides some of the time. May cause various random issues caused by splitting the CPU and GPU threads onto different cores."
msgstr "A játékok gyorsabb futtatása. Hatékony teljesítménynövelő opció, amelynek sokszor nincs hátránya. Különféle véletlenszerű problémákat okozhat, mivel a CPU és GPU szálakat külön magokra osztja."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "A rendszer futtatása G7400 BIOS-szal és funkciókkal."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "A GPU és DSP gyorsabb futtatása. Növelheti a 3D játékok képfrissítését, de hibákat okozhat."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Két összekapcsolt Game Gear futtatása egymás mellett. Az 1. és 2. játékos az 1. és 2. képernyőt vezérli."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Futás a futás gomb nyomva tartása nélkül."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "A 'jgenesis-gui.exe' futtatása a cli verzió helyett."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "Alapértelmezetten SDL gamepad: a gamepadeket szabványos elrendezéssel, a többi eszközt (kormányok, váltók, arcade enkóderek) nyers gombjaikkal olvassa. Az SDL minden eszközt nyersen olvas."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "A SOUNDFONT a RetroBattal szállított Roland SC-55 soundfontot használja."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "Az SSAA jobb minőséget ad a teljesítmény rovására."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "A NYÚJTÁS kitölti a teljes képernyőt és letiltja a kereteket."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "A játékállapot mentése kilépéskor és visszaállítása a következő indításkor (játékonként egy fájl)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "A mentések a saves mappában lévő másolatba kerülnek, az eredeti kép soha nem módosul. A visszaállítás az eredeti lemezről indul újra (a régi másolat .bak fájlként megmarad)."

msgctxt "game_options"
msgid "Saves the hiscores in supported games."
msgstr "A pontrekordok mentése a támogatott játékokban."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "A képernyőn megjelenő állapotsor mérete."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "A kép skálázása csak egész számokkal, az éles pixelekért."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "A kép skálázása csak egész számokkal, az éles pixelekért. Csak teljes képernyős 1080p vagy 4K 16:9-es képernyőn, enyhe levágással felül és alul."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Az X koordinátákat a képernyő közepéhez viszonyítva skálázza. Csökkentse, ha a lövések a széleken túl messze érnek a célkereszttől."

msgctxt "game_options"
msgid "Scales the dithern pattern to the resolution scale of the emulated GPU."
msgstr "A dithering mintát az emulált GPU felbontásskálájához igazítja."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "A scanline-ok nem kompatibilisek a HQ vagy xBRZ shaderekkel."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Egy katódsugárcső scanline-jai, árnyékmaszkja és foszforragyogása."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "A képernyő elforgatása nem kompatibilis a vízszintes elrendezéssel."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "A külön képernyőn lévő DMD-hez használt képernyő, a számozás azonos a MONITOR INDEX értékével. Az AUTO a legkisebb fennmaradó képernyőt használja. 3 képernyős KÉPERNYŐ KONFIGURÁCIÓ szükséges."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "A backglasshoz használt képernyő, a számozás azonos a MONITOR INDEX értékével. Az AUTO a játéktéren kívüli legnagyobb képernyőt használja. KÉPERNYŐ KONFIGURÁCIÓ szükséges."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "A játékok megjelenítésére használt képernyő (0 = elsődleges képernyő). Az AUTO az emulátorra bízza a képernyő kiválasztását."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "A flipper által használt képernyők (Visual Pinball 10.8 és újabb). A backglass és a DMD pozíciója ezután automatikusan kiszámítódik. Nincs beállítva: a SCREENRES értékek használatosak."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "A flipper által használt képernyők. A backglass és a DMD pozíciója ezután automatikusan kiszámítódik. Nincs beállítva: 1 képernyő."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "0xCD írása minden lefoglalt heap memóriába."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "A második joystick ütközhet az egérrel."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Válassza a 'JÁTÉKSPECIFIKUS' opciót az emulators\psxmame\ctrlr mappában lévő játékspecifikus cfg fájl használatához."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Az Amstrad katódsugárcső-vezérlő (CRTC) típusának kiválasztása."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Az emulálandó Amstrad modell kiválasztása."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Válassza az Egeret vagy a Joypadet a játékbeli virtuális mutató vezérléséhez."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Válassza a NEM opciót a textúra gyorsítótár letiltásához."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "BigPemu shader kiválasztása, csak akkor lehetséges, ha a RetroBat shaderek 'NINCS' értékre vannak állítva."

msgctxt "game_options"
msgid "Select a bilinear filtering method."
msgstr "Bilineáris szűrési módszer kiválasztása."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Az alkalmazandó szűrő kiválasztása."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Az alkalmazandó shader kiválasztása."

msgctxt "game_options"
msgid "Select a video format for output."
msgstr "A kimeneti videóformátum kiválasztása."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Választás a különböző kontroller elrendezések között."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "A 'DINAMIKUS PROFIL' opció használatakor alkalmazandó kontroller elrendezés kiválasztása."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "A képernyő sarkának kiválasztása, ahol a tetoválás megjelenik."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Az alkalmazandó effektus kiválasztása, shaderek használatakor nincs hatása."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Az akciógombok elrendezésének kiválasztása."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "A port kiválasztása, amelybe a GBA rom kerül, alapértelmezett a 2."

msgctxt "game_options"
msgid "Select method used to emulate the FM synthetiser."
msgstr "Az FM szintetizátor emulálásának módszere."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Az emulálandó modell kiválasztása."

msgctxt "game_options"
msgid "Select palette for colorizing GB games when COLORIZATION is set to 'internal'."
msgstr "Paletta kiválasztása a GB játékok színezéséhez, ha a SZÍNEZÉS 'BELSŐ' értékre van állítva."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Az alkalmazandó shader kiválasztása, csak a 'bgfx' videó illesztővel kompatibilis."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Az alkalmazandó shader kiválasztása, csak az 'openGL' videó illesztővel kompatibilis."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "A BattleGear4Tuned váltási módjának kiválasztása."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "A GPU bővítmény kiválasztása; a RetroBat beállításai nem működnek nem alapértelmezett bővítménnyel, azok az emulátorok mappájából a config.exe programmal állíthatók be."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Az IPL BIOS kiválasztása a játék régiójától függően. A 'IPL_JAP.n64', 'IPL_USA.n64' és 'IPL_DEV.n64' fájlokat igényli a bios\Mupen64plus mappában."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Az X és Y koordinátákat olvasó eszköz kiválasztása."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "A shaderekhez használt illesztő kiválasztása bgfx videó illesztő használatakor."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "A kontrollerhez adandó kiegészítő kiválasztása."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "A képkocka-megjelenítési mód kiválasztása."

msgctxt "game_options"
msgid "Select the graphics plugin used by the emulator. Depends on hardware compatibility."
msgstr "Az emulátor által használt grafikus bővítmény kiválasztása. Hardverkompatibilitástól függ."

msgctxt "game_options"
msgid "Select the keyboard layout."
msgstr "A billentyűzetkiosztás kiválasztása."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "A megvilágítási modell kiválasztása, a régi mód a legkevésbé terheli a videokártyát."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Az emulálandó gép kiválasztása."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "A játékoshoz rendelendő profil kiválasztása."

msgctxt "game_options"
msgid "Select the soundfont file or interface used for MIDI output."
msgstr "A MIDI kimenethez használt soundfont fájl vagy interfész kiválasztása."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "A Transfer Pak forrásrendszerének kiválasztása GB és GBC között."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "A konzol típusának kiválasztása."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "A képkivágás típusának kiválasztása. Az EMUSCV értékkel az eredeti konzol megjelenítési hibái javíthatók."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "A pisztoly típusának kiválasztása a játéktól függően."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Videómód kiválasztása (kábel típusa)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Annak kiválasztása, hová kerüljenek az érme és start gombok kormánnyal játszva."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Annak kiválasztása, hová kerüljenek a teszt és szerviz gombok kormánnyal játszva."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Annak kiválasztása, hogy a kereszt vagy a kör legyen a megerősítő gomb."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "A belsőleg használt hangmotor kiválasztása."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Az alkalmazandó színszűrő kiválasztása."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "A textúra renderelő használatakor alkalmazott grafikus API kiválasztása."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Az emulálandó joystick kiválasztása (nem kompatibilis a MASTER COMPACT-tal)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Az emulálandó joystick kiválasztása."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "A hibrid elrendezés használatakor megjelenő képernyő kiválasztása."

msgctxt "game_options"
msgid "Selecting GBA unlocks extra features in certain GBA enhanced GBC games."
msgstr "A GBA kiválasztása további funkciókat old fel bizonyos GBA-ra optimalizált GBC játékokban."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "A teljes rom elérési út küldése a MAME-nek a ROM neve helyett."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "A lámpák és a meghajtópanel kimeneteinek küldése külső eszközöknek (MAMEHooker...) Windows üzenetekkel."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "A lámpák és a pisztoly visszarúgás kimeneteinek küldése külső eszközöknek (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "A lámpák, a pisztolyrezgés és a meghajtópanel kimeneteinek küldése külső eszközöknek (Hook Of The Reaper, QMamehook...) a MAME hálózati protokolljával."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Az emulált spinner kontroller érzékenysége."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Alapértelmezett ISO beállítása egyes homebrew játékokhoz."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Az 1. játékos alapértelmezett kontroller-hozzárendelésének beállítása."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "A 2. játékos alapértelmezett kontroller-hozzárendelésének beállítása."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Alapértelmezett kontroller-hozzárendelés beállítása."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Licencmaszk beállítása az aktivált tartalomhoz (a MINDEN LICENC általában rossz ötlet, meghatározatlan működéshez vezethet)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content."
msgstr "Skálázó szűrő beállítása a renderelt tartalomhoz."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Skálázó szűrő beállítása a renderelt tartalomhoz. Az FSR Vulkant igényel."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Skálázó szűrő beállítása a renderelt tartalomhoz. Csak OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Az Atari 2600 nehézségi kapcsolójának beállítása."

msgctxt "game_options"
msgid "Set the adress, interrupt, low 8 bit and high 16 bit DMA."
msgstr "A cím, a megszakítás, az alsó 8 bites és a felső 16 bites DMA beállítása."

msgctxt "game_options"
msgid "Set the amount of extra columns to draw for widescreen."
msgstr "A szélesvászonhoz rajzolandó további oszlopok számának beállítása."

msgctxt "game_options"
msgid "Set the aspect ratio of the FMV cinematics."
msgstr "Az FMV átvezető videók képarányának beállítása."

msgctxt "game_options"
msgid "Set the behavior of the start menu when autostarted game exit."
msgstr "A start menü viselkedésének beállítása, amikor az automatikusan indított játék kilép."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "A mikrofon gomb viselkedésének beállítása."

msgctxt "game_options"
msgid "Set the bottom screen as prominent."
msgstr "Az alsó képernyő kiemelése."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "A konzol szélesvásznúra állítása az ezt támogató játékokhoz."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "A hoszt frissítési gyakoriságának beállítása."

msgctxt "game_options"
msgid "Set the volume of the emulated floppy sound."
msgstr "Az emulált floppy hang hangerejének beállítása."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Állítsa be azokhoz a játékokhoz, amelyek a 2. portban igénylik a kontrollert."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Kapcsolja be több pisztoly használatakor. Alapértelmezetten be, ha több pisztolyt talál és a bemeneti illesztő nem 'sdl'."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Csak valódi Balance Board használatakor állítsa be."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Állítsa be a mikrofon B helyre helyezéséhez."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Állítsa 'BE' értékre a Steam vagy az Epic Games Launcher bezárásához a játékból való kilépéskor."

msgctxt "game_options"
msgid "Set this to effectively halve monitor refresh rate."
msgstr "Állítsa be a monitor frissítési gyakoriságának tényleges megfelezéséhez."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Állítsa be a GunCon 2. portba csatlakoztatásához, a Die Hard egyes verzióihoz használatos."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Állítsa be az eredeti PSX gamepad használatához a DualShock helyett."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Állítsa IGEN értékre, hogy versenyjátékokban a váltógomb elengedésekor üresbe kerüljön."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Az emulált folyadékkristályos kijelző fényerő-eltolásának beállítása."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Az emulált folyadékkristályos kijelző kontrasztszintjének beállítása."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "A PowerPC frekvenciájának beállítása MHz-ben. A 0 (alapértelmezett) a játéklap frekvenciáját használja."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "A PowerPC frekvenciájának beállítása MHz-ben. Az AUTO a játékhardver frekvenciáját használja (csak Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "A PowerPC frekvenciájának beállítása MHz-ben. Az alapértelmezett 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "A gamepad analóg karjainak holtzónája, ha a bemeneti eszköz típusa 'GAMEPAD KLASSZIKUS' vagy 'GAMEPAD MODERN'."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "A gamepad analóg karjainak holtzónája."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "A gamepad analóg ravaszainak holtzónája."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Az analóg karok holtzónája. Csak a 'GAMEPAD MODERN' kontrollertípussal használatos."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "A játékos kontrollertípusának beállítása."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Az analóg karok érzékenységének beállítása."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "A 0 érték azt jelenti, hogy minden takartként jelentődik, a Forza Motorsport 4-hez szükséges."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Az 1 érték javíthatja a teljesítményt."

msgctxt "game_options"
msgid "Setting this too high may cause sample clipping."
msgstr "A túl magas érték a minták levágódását okozhatja."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "A pixelek alakja: négyzetes vagy az eredeti kijelzőhöz hasonló."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "A CRT shader által rajzolt árnyékmaszk alakja. Csak akkor használatos, ha a shader CRT maszkra van állítva."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Alapértelmezetten megosztott CMOS minden tartalomhoz, vagy játékonként egy (jobb hálózati játékhoz)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "A FidelityFX CAS által alkalmazott élesítés erőssége. Csak akkor használatos, ha a skálázó szűrő FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Rövid képernyőüzenetek (állapot mentve...). Alapértelmezetten be."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "A Dolphin felületének megjelenítése a játékképernyő mellett."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "FPS átfedés megjelenítése játék közben."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "A Ryujinx hibakereső konzoljának megjelenítése."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Vezérlési kép megjelenítése a keret felett."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Értesítés megjelenítése kontroller csatlakoztatásakor vagy leválasztásakor."

msgctxt "game_options"
msgid "Show core specific notifications."
msgstr "Magspecifikus értesítések megjelenítése."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Az emulátor felületének megjelenítése."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Az emulátor értesítéseinek megjelenítése, alapértelmezetten engedélyezve (AUTO)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Az emulátor értesítéseinek megjelenítése."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Játékinformációk megjelenítése a Craft bal felső sarkában."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Információk megjelenítése a shaderfordításról."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Az aktuális képernyő-elrendezés információinak megjelenítése a jobb felső sarokban."

msgctxt "game_options"
msgid "Show notifications."
msgstr "Értesítések megjelenítése."

msgctxt "game_options"
msgid "Show or crop overscan. 'Auto' will try to adapt to game, cropping empty areas."
msgstr "Az overscan megjelenítése vagy levágása. Az 'Auto' megpróbál a játékhoz igazodni, levágva az üres területeket."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "A RetroArch beállítások megjelenítése vagy elrejtése. Az 'Auto' az ajánlott beállítás."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Teljesítménystatisztika átfedés megjelenítése játék közben."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Shaderfordítási értesítések megjelenítése."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "A vízszintes szegélyek megjelenítése. Az AUTO a játék által használt területre vágja őket, a PONTÓRAJEL PAR beállítással a legjobb."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Amiga billentyűzetet jelenít meg a képernyő alján a kontrollerrel való gépeléshez. Egy hozzárendelt gombbal kapcsolható, az iránykereszttel vagy a karral mozoghat, egy másik gombbal gépelheti be a billentyűt."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Golyónyomokat jelenít meg a falakon, ahol a lövések becsapódnak."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "A meghajtó aktivitását és a teljesítményinformációkat jeleníti meg a kép felett."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "A kiterjesztett PAL CRT sorokat jeleníti meg, de ezek a legtöbb játékban általában üresek."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "A floppy lemezek nevét, a meghajtók lámpáit és a sebességet jeleníti meg ablakban és teljes képernyőn."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Megjeleníti a WHDLoad konfigurációs képernyőjét, ha a játék támogatja."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Megjeleníti a WHDLoad kérdését, és gombnyomásra vár a játék indulása előtt. Alapértelmezetten ki, így a játék azonnal elindul."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "A tetoválás kicsinyítése/nagyítása, hogy a keret szegélyén belülre illeszkedjen."

msgctxt "game_options"
msgid "Significantly improves performances for CPU with 3+ cores."
msgstr "Jelentősen javítja a teljesítményt 3 vagy több magos CPU-knál."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "CRT foszfor szellemkép effektusok szimulálása. Az 'Egyszerű' 50:50 arányban keveri az aktuális és az előző képkockát."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "LCD képernyő szellemkép effektusainak szimulálása."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "A PowerVR2 GPU-ra és az analóg videójelekre jellemző effektusok szimulálása."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "A Game Boy Color LCD képernyő színeinek szimulálása."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "CRT szellemkép effektust szimulál, a villódzás elkerülésére használható."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Szellemképet szimulál, segíthet csökkenteni a villódzást."

msgctxt "game_options"
msgid "Simulates stereo output."
msgstr "Sztereó kimenetet szimulál."

msgctxt "game_options"
msgid "Single Field applies a de-interlacing filter, Double Field mimics the original hardware."
msgstr "Az Egy mező deinterlace szűrőt alkalmaz, a Dupla mező az eredeti hardvert utánozza."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "A menük és panelek mérete. A játék a belső felbontásba illeszkedő legnagyobb méretre korlátozza."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "A játék pixeleinek mérete: a nagyobb értékek ráközelítenek és a térkép kisebb részét mutatják. Alapértelmezett: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "A legnagyobb képernyő mérete hibrid képernyő-elrendezés használatakor."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "A másodlagos képernyő mérete az elsődlegeshez képest (csak felül/alul elrendezéseknél)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Az ablak mérete, ha nem teljes képernyős módban van."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "A 2 emulált képernyő méretaránya."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "A VBI kihagyása késés észlelésekor, segít a hang akadozásán, amikor az emuláció sebessége csökken."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Az előzővel azonos képkocka kirajzolásának kihagyása. Javíthatja a teljesítményt."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Képkockák kihagyása a hangrecsegés elkerülésére lassú eszközökön."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Képkockák kihagyása a teljesítmény javítására, a darabos mozgás árán."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Az indításkori 60 másodperces várakozás kihagyása a többi gépszekrényre. Többgépes játékhoz tiltsa le."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "A BIOS indítólogójának kihagyása."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Az indítási ellenőrzés kihagyása, amely megakadályozza a játék indulását."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "A hardverellenőrzések kihagyása indításkor (kamera, kormány, kártyaolvasó)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "A hosszú kormánymotor-inicializálás kihagyása indításkor. Válassza ki a játék revízióját."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "A floppymeghajtó mechanikus várakozási idejének kihagyása. A betöltés sokkal gyorsabb, a lemezt pedig továbbra is pontosan az eredetinek megfelelően olvassa."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Az indítóvideók és a logó kihagyása."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Az indítóvideók kihagyása."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "A kormánymotor inicializálásának kihagyása indításkor."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Videók/FMV-k kihagyása."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "A bal és jobb oldalon megadott terület felületeinek kirajzolását kihagyja."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Kihagyja a tartalom betöltésekor megjelenő BIOS indítóanimációt."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Kihagyja a tartalom betöltésekor megjelenő BIOS indítóanimációt. Kapcsolja ki a PS2 rendszerbeállításainak és a memóriakártya-kezelőnek az eléréséhez."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Kihagyja a BIOS indítóanimációt tartalom betöltésekor."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "A hely, amelybe a lemezképek csatolódnak. Az AUTO a kép típusa alapján választja ki. Csak akkor módosítsa, ha egy játék nem hajlandó elindulni."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Lassabb, de néhány, a gyorsítótár viselkedésére építő játékhoz szükséges."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "3D textúrák simítása."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "A kormányzás változásainak simítása. Gamepad vagy billentyűzet használatakor szükséges."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Shaderrel simítja az éleket, kissé lágyítja a képet."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "A Paula chip által előállított hang simítása. A 'Sinc' a legkifinomultabb és a legigényesebb."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Lágyítja a gamepados kormányzást versenyjátékokban. Alapértelmezetten erős, kormányra nincs hatással."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Egyes SPU fázisok érzékenyek a versenyhelyzetekre, és egyszerre korlátozott számú engedélyezése segít enyhíteni a teljesítménybeli megakadásokat. Kisebb érték javíthatja a teljesítményt és csökkentheti az akadozást egyes játékokban."

msgctxt "game_options"
msgid "Some games accept input from port 2 instead of port 1."
msgstr "Egyes játékok a 2. portról fogadják a bemenetet az 1. helyett."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Egyes játékok nem töltődnek be, ha a rendszert behelyezett CD-vel kapcsolják be. Az 'IGEN' az indítóanimáció alatt helyezi be a CD-t."

msgctxt "game_options"
msgid "Some games have graphic and/or speed issues without Cycle-exact."
msgstr "Egyes játékoknak grafikai és/vagy sebességproblémáik vannak ciklus-pontos mód nélkül."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Egyes játékok bizonyos műveletekhez adott billentyűt igényelnek; adja meg az 1. játékos kontrollerének SELECT gombjához rendelendő billentyűt."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Egyes játékok invertált tengelyt igényelnek a pisztolyokhoz."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Egyes játékok a Game Drive bővítményt igénylik."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Egyes játékok a gránátdobáshoz a második portban lévő kontrollert igénylik."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Egyes váltókarok a kormánytól eltérő eszközazonosítóval csatlakoznak a számítógéphez, például a Thrustmaster karok."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Egyes homebrew-k és ROM hackek adott bekapcsoláskori RAM-mintát igényelnek. Újraindítás szükséges."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be disabled."
msgstr "Egyes homebrew-k vagy rom hackek esetén ezt az opciót le kell tiltani."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Egyes homebrew-k vagy rom hackek esetén ezt az opciót engedélyezni kell."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "A MIDI zene hangforrása. Az MT-32 opciókhoz a megfelelő Roland ROM-ok szükségesek a bios mappában."

msgctxt "game_options"
msgid "Space/Enter/Fire works as WHDLoad start button."
msgstr "A Szóköz/Enter/Tűz WHDLoad indítógombként működik."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Megadja, hogyan működjön a valós idejű óra emulációja bizonyos játékokban."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Megadja, melyik kiegészítő játssza le az audio CD-t a patchelt MD játékoknál."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Az engedélyezendő IPS patch megadása; ha nincs beállítva, az ips .ini fájlban megadott összes patch használatos."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "A felskálázáshoz használandó szűrő megadása."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "A keret elérési útjának megadása."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "A firmware fájl elérési útjának megadása."

msgctxt "game_options"
msgid "Specify the Amiga system model to emulate."
msgstr "Az emulálandó Amiga rendszermodell megadása."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Az emulálandó számítógépmodell megadása."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "A videórenderelési módszer megadása. A Pontos a legprecízebb, de lassabb, a jó és a gyors gyorsabbak, de egyes játékoknál hibázhatnak."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Beszédmodul telepítve."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Sebesség hack, de egyes játékokkal nem biztos, hogy kompatibilis."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Sebesség hack, segíthet a lassú játékokon hibák árán."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Sebesség hack."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Az analóg karos egér sebessége."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Az emulált Amiga egér sebessége."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "A bal karral mozgatott egérmutató sebessége."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "A GD-ROM betöltés gyorsítása, elronthat egyes játékokat."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "A lemezbetöltés gyorsítása. Elronthat egyes másolásvédett játékokat."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Gyorsítja a floppy hozzáférést a betöltési idők csökkentésére."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Több CPU szálra osztja a renderelést. Csak magas belső felbontásnál hasznos."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "A kormány rugós visszatérítése középre, amíg a játék nem vezérel erővisszacsatolást, mint egy arcade gépszekrény mechanikus rugója."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Szabványos floppyvezérlő kártya."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Indítás közvetlenül Commodore 64 módban."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "A kontroller indítása eleve engedélyezett karokkal, ahelyett, hogy a játékban meg kellene nyomni az ANALOG gombot."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "A lemez közvetlen indítása a PLAY CD-I menüre való várakozás helyett. Alapértelmezetten be."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "A játék indítása teszt módban. Teszt: 0 billentyű vagy R3, szerviz: 9 billentyű vagy L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Az Outrun 2 SP SDX indítása a gépszekrény-ellenőrzések nélkül (meghajtópanel és torony)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "A Wii menü indítása (a menünek telepítve kell lennie a Dolphinban)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "A kormányzási tengely holtzónája kontrollerekhez vagy nem önközpontosító kormányokhoz."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "BC1 textúrák tárolása 16 biten. Videómemóriát takarít meg kis minőségveszteség árán."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "A kontroller rezgésének erőssége. Alapértelmezetten 60%."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "A pisztoly visszarúgó motorjának erőssége. Alapértelmezetten 60%."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "A menük és 2D képernyők nyújtása a teljes képernyőszélességre."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "A pixelek függőleges nyújtása, mint az eredeti DOS játéknál 4:3-as képernyőn. Alapértelmezett: engedélyezve."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "A kép nyújtása a képernyő kitöltésére a képarány figyelmen kívül hagyásával."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "A kép nyújtása a teljes képernyőre egy korabeli monitor formájának megtartása helyett."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Stúdió: egy valódi lejátszó TV-szintjei, a fekete sötétszürkének látszik PC képernyőn. Teljes tartomány: mély fekete."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Képpuffer-effektusok szupermintavételezése, artefaktumokat okozhat."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "A térhatású mód a négyhangszórós Model 3 gépszekrények (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) hátsó hangszóróit a hátsó hangszórókon szólaltatja meg. A többi játék sztereó marad."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Az 1. és 2. paddle felcserélése, néhány játékhoz szükséges, amely fordítva várja a tengelyeket."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "A kontroller A és B gombjának felcserélése."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "A kontroller A/B és X/Y gombjainak felcserélése."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "A TV és GamePad képernyők felcserélése az egymás melletti, felül/alul és kép a képben elrendezésekben."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "A két Amiga port felcserélése. Néhány játékhoz szükséges, köztük több point and click címhez."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "A pisztolyindexek felcserélése az 1. és 2. játékos között."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Kapcsolja be, hogy a Citron és Eden mentésekhez a RetroBat 'saves\switch' mappáját használja (az emulátor mappája helyett)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Állítsa az 1. játékos kontrollertípusát nincsre, ha a helyes billentyűzetbemeneteket nem olvassa."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Kapcsolja be a szervizmenü R3 és L3 gombokkal való aktiválásához."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Kapcsolja be a szervizmenü aktiválásához."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Kapcsolja be az iránykereszt használatához a bal analóg kar helyett."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Kapcsolja be a teljes képernyő letiltásához és az emulátor ablakos módban való futtatásához."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Kapcsolja be, hogy az 1. fénypisztoly a 2. játékosé, a 2. fénypisztoly az 1. játékosé legyen."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Külön deinterlace mód használatakor bekapcsolva segíthet csökkenteni az elmosódást."

msgctxt "game_options"
msgid "Sync to exact content framerate. Only for G-Sync/FreeSync/HDMI-2.1-VRR compatible monitors."
msgstr "Szinkronizálás a tartalom pontos képfrissítéséhez. Csak G-Sync/FreeSync/HDMI-2.1-VRR kompatibilis monitorokhoz."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "A System Card, amelyet az azt igénylő LD-ROM2 játékok használnak. Alapértelmezett: SYSTEM CARD 1, ha a syscard1.pce a bios mappában van."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "TI-99 beszédszintetizátor csatlakozóadapter."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "A TOS 1.06 csak STE-hez való: ha a géptípus nincs beállítva, automatikusan az STE választódik ki."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Cél a 60 fps a natív 59,73 fps helyett."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 játékos a White Men Can't Jump és NBA Jam T.E. játékokban. Rotary: Tempest 2000, egérrel vezérelve."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "Az Amiga a csatornáit teljesen balra és teljesen jobbra küldi. Ennek csökkentése összekeveri őket, és fejhallgatóval sokkal kényelmesebb. A 10 az eredeti hardver viselkedése."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "Az Amiga a csatornáit teljesen balra és teljesen jobbra küldi. Ennek csökkentése összekeveri őket, és fejhallgatóval sokkal kényelmesebb. A 100% az eredeti hardver viselkedése."

msgctxt "game_options"
msgid "The CGA variation that is being emulated."
msgstr "Az emulált CGA változat."

msgctxt "game_options"
msgid "The Neo Geo CD bios used by the emulator."
msgstr "Az emulátor által használt Neo Geo CD BIOS."

msgctxt "game_options"
msgid "The Neo Geo bios used by the emulator. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Az emulátor által használt Neo Geo BIOS. A UNIVERSE BIOS általában a legjobb kompatibilitást nyújtja."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "A Neo Geo mód. A UNIVERSE BIOS általában a legjobb kompatibilitást nyújtja."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "A RetroBat csapat profilokat készített néhány gyakori kontrollerhez, ezek a 'saves\mame\ctrlr' mappában találhatók. Az EGYÉNI a saját hozzárendelések mentésére használható."

msgctxt "game_options"
msgid "The SVGA variation that is being emulated."
msgstr "Az emulált SVGA változat."

msgctxt "game_options"
msgid "The SoundBlaster emulated FM synth mode."
msgstr "A SoundBlaster emulált FM szintetizátor módja."

msgctxt "game_options"
msgid "The amount of high memory size the emulated machine has."
msgstr "Az emulált gép felső memóriájának (high memory) mérete."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "A videómemória mennyisége."

msgctxt "game_options"
msgid "The aspect ratio that's used by the Widescreen Hack."
msgstr "A szélesvásznú hack által használt képarány."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "Az emulátor által használt BIOS."

msgctxt "game_options"
msgid "The color scheme for Hercules emulation."
msgstr "A Hercules emuláció színsémája."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "Az 'xinput' illesztő engedélyez olyan funkciókat, mint a rezgési effektusok. Válassza az 'sdl'-t a kontrollerek széles körével való kompatibilitáshoz."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "A játék régiójának meg kell egyeznie a Wii menü régiójával, különben a játékot nem ismeri fel."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Minél nagyobb az érték, annál távolabbi objektumok jelennek meg."

msgctxt "game_options"
msgid "The maximum RAM memory available for the system."
msgstr "A rendszer számára elérhető maximális RAM memória."

msgctxt "game_options"
msgid "The normal core can be more stable when running installed OS."
msgstr "A normál mag stabilabb lehet telepített operációs rendszer futtatásakor."

msgctxt "game_options"
msgid "The raw performance to emulate."
msgstr "Az emulálandó nyers teljesítmény."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "Az 1. játékos jobb analóg karja vezérli a második joystickot a kétkaros játékokban (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "A jobb kar jobb iránykeresztként használatos (az L2, R2, L3 és R3 gombon is)."

msgctxt "game_options"
msgid "The type of emulated graphic chip."
msgstr "Az emulált grafikus chip típusa."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "Egyes játékokban hiba van, amely miatt 1-nél több aktív eszköz összeomlasztja az emulátort."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "A Sinden pisztoly csatlakoztatásakor rajzolt fehér szegély vastagsága. Alapértelmezetten normál (12 pixel)."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Versenyjátékokban hasznos, hogy kevésbé legyen 'ideges' a kormányzás kontrollerrel."

msgctxt "game_options"
msgid "This option can be used to override PAL timings to run games with NTSC timings."
msgstr "Ezzel az opcióval felülbírálhatók a PAL időzítések, hogy a játékok NTSC időzítéssel fussanak."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Ez az opció az emulált PC Yamaha hangkártyáját módosítja. Az OPN az alapértelmezett. Az OPNA hang több FM csatornát és PCM mintát támogat."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Ez az opció az SPU elemzőt vezérli, különösen a fordított egységek méretét. A maximális kompatibilitáshoz használja a biztonságos módot."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "A SIGIL játszásához ezt az opciót le kell tiltani."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Ez az opció csak a GameCube kontrollerre vonatkozik."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Ez az opció határozza meg, hogy emulálja-e a PCG-8100-at. Egyes PC-8000 sorozatú szoftverekhez szükséges lehet."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Ez az opció az emulált PC CPU órajelét állítja be."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Ez az opció az emulált PC CPU órajelét állítja be. A túlhajtási opciókkal a legtöbb szoftver a normálisnál gyorsabban fut."

msgctxt "game_options"
msgid "This option specifies which lock-on cartridge to emulate."
msgstr "Ez az opció határozza meg, melyik lock-on kazettát emulálja."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "Ez a beállítás csak a 'scanlines' szűrővel használható."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Ez a beállítás megakadályozza az emuláció szüneteltetését fókuszvesztéskor."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Ez a beállítás elforgatja a Windows asztalt, a játékból való kilépéskor nem áll vissza."

msgctxt "game_options"
msgid "This should only be disabled when playing ROM hacks."
msgstr "Ezt csak ROM hackek játszásakor kell letiltani."

msgctxt "game_options"
msgid "This should only be disabled when playing certain demos and homebrews for correct operation."
msgstr "Ezt csak bizonyos demók és homebrew-k helyes működéséhez kell letiltani."

msgctxt "game_options"
msgid "This will replace the BIOS CD-ROM busy loop with a STOP instruction."
msgstr "Ez a BIOS CD-ROM várakozó hurkát STOP utasításra cseréli."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "A játékot kiválasztott grafikai vagy CPU javítások nélkül futtatja."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "A konzol BIOS-át futtatja játék helyett."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Az a küszöb, amelynél az analóg kar mozgása digitális iránynak számít."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Az emulált CPU ciklusok számának dinamikus csökkentése, ha a hoszt CPU nem bírja (alapértelmezetten letiltva)"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Döntés bemenet a Kirby Tilt 'n' Tumble és más MBC7 játékokhoz. Alapértelmezetten analóg kar."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "Trapdoor bővítő RAM, mint a klasszikus A501 bővítésben."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "A játék telepítőjének futtatása."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Hurokfeltételek felismerése az SPU kernelekben, és ütemezési tippként való felhasználásuk. Alapértelmezetten ki"

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "A játék felismerése és kontroller-hozzárendelés alkalmazása."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "A ROM-hoz legjobb frissítési gyakoriság kiválasztásának megkísérlése."

msgctxt "game_options"
msgid "Try to use legacy dosbox.conf config file instead of core options."
msgstr "A régi dosbox.conf konfigurációs fájl használatának megkísérlése a mag beállításai helyett."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "A TurboTap egynél több játékossal való játékhoz szükséges. Második kontroller csatlakoztatásakor automatikusan engedélyeződik."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Az emulátor értesítéseinek bekapcsolása: csatlakoztatott kontrollerek és shaderfordítási üzenetek."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Fordulási sebesség egérrel. Alapértelmezett: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Kapcsolja be, hogy az irányokhoz csak az iránykereszt legyen hozzárendelve."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Kapcsolja be, ha olyan fénypisztolyt használ, amely nem támogatja a képernyőn kívüli újratöltést."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "Ennek az opciónak a bekapcsolásával a MAME a különböző egerek mozgását és gombnyomásait egymástól függetlenül jelenti."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "A jobb kart Amiga egérré alakítja, hasznos menüvezérelt és point and click játékokhoz a kontroller elengedése nélkül."

msgctxt "game_options"
msgid "Tweak the behavior of the 3Dfx Voodoo emulation."
msgstr "A 3Dfx Voodoo emuláció viselkedésének finomhangolása."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Alapértelmezetten két réteg (bitpontos). A Rendezett javítja az egymásra rakott füstöt és üveget, a sakktábla az arcade lapot reprodukálja (a Sega Rally 2 hója és köde)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Az emulálandó APPLE II típusa."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Az emulálandó Archimedes számítógép típusa."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Az emulálandó BBC Micro típusa, alapértelmezett a B MODELL."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "A használandó CPU emulációs mag típusa."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Az emulálandó Color Computer típusa, alapértelmezett a coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Az emulálandó számítógép típusa."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Az emulálandó FM Towns típusa, alapértelmezett az FM TOWNS (1/2. MODELL)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Az emulálandó FM-7 típusa, alapértelmezett az FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "A képkocka-kihagyás típusa."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Az emulálandó LYNX típusa, alapértelmezett a 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "A ROM fájl típusa"

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Az emulálandó V.Smile típusa."

msgctxt "game_options"
msgid "Type of emulated SoundBlaster card."
msgstr "Az emulált SoundBlaster kártya típusa."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "A játékporthoz csatlakoztatott joystick típusa."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Feloldja a játék képfrissítési korlátját, ha a belső adatbázisban van hozzá patch."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "További nyelveket old fel egyes játékokban, ha a mag adatbázisában van hozzá bejegyzés."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "A CPU frekvencia emelése 93,75-ről 125 MHz-re. Gyorsíthat egyes CPU-függő játékokat."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "A játék textúráinak felskálázása pixel art szűrővel."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "A 2D rétegek (HUD, hátterek) felskálázó szűrője."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "A 2D rétegek (HUD, hátterek) felskálázó szűrője. Csak Vulkan és OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Használja a 'DÉL' gombot A-ként és a 'NYUGAT' gombot B-ként."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "A 'cfg64' mappa használata az önálló MAME-hez."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Használja az 'EGYÉNI' célkeresztet a kiválasztott célkereszt fájl engedélyezéséhez."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Használja az 'EGYÉNI' célkeresztet az itt kiválasztott fájl engedélyezéséhez."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Használja a 'JÁTÉKONKÉNT' opciót, ha mentett profilt a játékhoz a capriceforever\Profiles mappába."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Európai konzolhoz 50-et, japán konzolhoz 60-at használjon."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "A jobb kompatibilitásért használjon 8 MHz-et."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Az analóg kar használata iránykeresztként."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "DSI-t használjon a DSi játékokhoz, például a DSiWare-hez."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Használja a CSAK JOYSTICK opciót joystickos játékokhoz és a CSAK BILLENTYŰZET opciót billentyűzetes játékokhoz."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "A bal analóg kar használata az iránykereszt helyett a vezérléshez."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Az R1 és L1 használata gyorsításra és fékezésre versenyjátékokban, csak 'auto' sebességváltással kompatibilis."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Resizable BAR használata a GPU feltöltésekhez, ha elérhető. Tiltsa le, ha akadozást vagy instabilitást tapasztal az illesztőjével."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "SDL használata minden kontrollerhez az Xbox kontrollerek XInputja helyett."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Az SGB2 időzítéseinek és viselkedésének használata."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "SSE4 használata AVX2 helyett régebbi CPU-khoz."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Nagy felbontású szűrő használata a megjelenítés javítására."

msgctxt "game_options"
msgid "Use a mouse-controlled Lightgun or Touchscreen input."
msgstr "Egérrel vezérelt fénypisztoly vagy érintőképernyő bemenet használata."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Előre meghatározott színpaletta használata az emulátor által kiszámított helyett."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Alternatív mélységfeldolgozás használata, engedélyezze, ha grafikai problémák vagy adott hibaüzenet jelentkezik."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Az & jel és a bal zárójel használata a starthoz és az érmékhez."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Külső firmware használata (alapértelmezett a bios mappában lévő 'firmware.bin')."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Az analóg kar használata az iránykereszt helyett."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Bilineáris szűrés használata a teljes kép simításához."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "BIOS használata bizonyos rendszerekhez, például a Neo Geo és a Sega ST-V"

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Gomb használata az újratöltéshez a képernyőn kívüli lövés helyett az ezt nem támogató pisztolyoknál."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Gombok használata analóg tengely helyett a kormányhoz."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "A számítógép alapértelmezett hangbemeneti eszközének használata mikrofonként."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "A hat használata a mozgáshoz a joystick mellett."

msgctxt "game_options"
msgid "Use input directly sends by keyboard to the core."
msgstr "A billentyűzet által közvetlenül a magnak küldött bemenet használata."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Az értelmezőt használja a legjobb kompatibilitásért, a dynarecet a teljesítményért."

msgctxt "game_options"
msgid "Use interpreter for best compatibility."
msgstr "Az értelmezőt használja a legjobb kompatibilitásért."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "A bal analóg kar használata az iránykereszt mellett."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "A bal analóg kar használata az iránykereszt helyett."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "A bal kar használata iránykeresztként."

msgctxt "game_options"
msgid "Use native texture LOD computation when upscaling."
msgstr "Natív textúra LOD számítás használata felskálázáskor."

msgctxt "game_options"
msgid "Use official BIOS and bootloader for emulated hardware."
msgstr "Hivatalos BIOS és rendszertöltő használata az emulált hardverhez."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Egy megosztott memóriakártya használata minden játékhoz játékonkénti kártya helyett. A kártyák a '\bios\pcsx2\memcards' mappában tárolódnak."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Pixelpontos emuláció használata, ahol elérhető."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Az 5-8. portok használata GameCube kontrollerekhez Wii módban."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Megelőző képkockák használata a run-ahead helyett, a run-ahead képkockaszám érvényes."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Valódi GameCube kontrollerek használata GameCube adapteren keresztül. Csak valódi Wiimote-okkal."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "A vállgombok használata L-ként és R-ként a ravaszok helyett."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "A vállgombok használata a ravaszok helyett."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "A HD csomagok 3D modelljeinek használata sprite-ok helyett (OpenGL renderelők). Alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "A RetroBat 'bios' mappájában lévő BIOS használata, a BIOS-ba indításhoz szükséges."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "A RetroBat 'bios' mappájában lévő BIOS használata."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Használja a MAGAS FREKVENCIA értéket magasabb frissítési gyakoriságú képernyőkhöz."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Az Odin artwork csomag kereteinek használata (az emulátor artwork mappája) a RetroBat dekorációi helyett."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "A compute shader renderelő használata a klasszikus OpenGL helyett. Magas belső felbontásokon gyorsabb, OpenGL 4.3-at igényel."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Az emulátor beépített BIOS-ának használata a bios mappa fájljai helyett. A DS letöltéses játékhoz (Download Play) az eredeti BIOS és firmware szükséges."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "A HD csomagok nagy felbontású textúráinak használata (OpenGL renderelők). Alapértelmezetten engedélyezve."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Az egér használata Apple II paddle-ként, az Arkanoidhoz, a Breakouthoz és más forgatógombos játékokhoz szükséges. A mutató képernyőn lévő pozíciója a paddle pozíciója. Az 1. és 2. paddle-nél a kontroller karját helyettesíti, joystickos játékokhoz hagyja kikapcsolva."

msgctxt "game_options"
msgid "Use the older and less compatible faster blitter"
msgstr "A régebbi és kevésbé kompatibilis gyorsabb blitter használata"

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "A Vita3K felületén mentett játékonkénti beállítások használata. Ezek felülbírálják a RetroBat beállításait ennél a játéknál."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Az egyszerű double hi-res színtérkép használata. Néhány Apple II program ezzel közelebb áll a valódi géphez."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Használja, ha az emulátor betöltés után összeomlik vagy nem jelenít meg semmit."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Csak akkor használja, ha az analóg kar elmászik."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Használja ezt az opciót, ha az ArcadeDuck nem a megfelelő monitoron jelenik meg."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Használja ezt az opciót, ha a Keisho nem a megfelelő monitoron jelenik meg."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Használja ezt az opciót, ha az Odin nem a megfelelő monitoron jelenik meg."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Használja ezt az opciót, ha a PCSX2 nem a megfelelő monitoron jelenik meg."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Használja ezt az opciót, ha a duckstation nem a megfelelő monitoron jelenik meg."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Használja ezt az opciót, ha a p1 és p2 fel van cserélve."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Használja ezt az opciót billentyűzetként felismert kontroller (ipac stb.) használatakor."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Használja ezt az opciót kézi váltókar nélküli kormány használatakor."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Használja ezt a beállítást repülős játékokhoz."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Ezzel a beállítással csökkentheti vagy növelheti a fényerőt, nem kompatibilis a 'gdi' videó illesztővel."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Ezzel a beállítással csökkentheti vagy növelheti a kontrasztot, nem kompatibilis a 'gdi' videó illesztővel."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Ezzel a beállítással csökkentheti vagy növelheti a gammát, nem kompatibilis a 'gdi' videó illesztővel."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Ezzel a beállítással megadhatja az alapértelmezett turbó célgombot."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Ezzel a beállítással figyelmen kívül hagyhatók a játék mappájában lévő run.bat, autoexec.bat vagy dosbox.bat fájlok."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Ezzel a beállítással csökkentheti a bemeneti késleltetést."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Ezzel automatikusan betölthető tartalom, például HD csomagok."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Billentyűzethez a winkey-t, XBOX kontrollerhez az xinputot, más kontrollertípusokhoz az sdl-t használja."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Saját .cfg fájl használata a saves\mame\cfg mappában. A játék közbeni TAB átkiosztások megmaradnak. Az első bekapcsoláskor az utolsó munkamenet hozzárendelése automatikusan importálódik. A kontroller elrendezés opció erre a játékra már nem vonatkozik."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Hasznos képernyőrázkódás-effektusos játékoknál, például a Wipeout Fusionnél, elmosódottá teheti a képet."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Hasznos egyszálú processzorokhoz."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Hasznos egyes magas frissítési gyakoriságú képernyőkön a szellemkép kiküszöbölésére."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Hasznos a képernyőnél nagyobb felbontás használatakor. Elkerüli a moiré-hatást."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "60 Hz-et (480i) használ 50 Hz (576i) helyett."

msgctxt "game_options"
msgid "Uses the proper mipmap levels. Enhance graphics accuracy."
msgstr "A megfelelő mipmap szinteket használja. Javítja a grafikai pontosságot."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "A VI utófeldolgozó szűrő emulációja."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Az 1,00 feletti értékek növelik, az alatta lévők csökkentik a méretet."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "A függőleges játékok a kiválasztott indexnek megfelelő monitoron jelennek meg."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "A Video HD egy fejlett videokártya, amelyet maroknyi modern demó használ. A módosítás újraindítja a gépet."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "A konzol által a játékoknak felkínált videómódok. A HD módokhoz HDTV videójel szükséges."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Az asztal által használt nézetbeállítás. Az AUTO a KÉPERNYŐ KONFIGURÁCIÓ beállítást követi: asztali egy fekvő képernyőnél, teljes egy képernyő egy álló képernyőnél, gépszekrény több képernyőnél (asztali, ha a KÉPERNYŐ KONFIGURÁCIÓ nincs beállítva)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Az iránykereszt virtuális elforgatása a képernyő elforgatásakor."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Az emulált floppymeghajtó kattogó hangjának hangereje."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "A zenei kártya hangereje az ilyennel rendelkező játékokban (Daytona USA, Sega Rally). Alapértelmezetten 100%."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Csak Vulkan, lassabb, de kisebb késleltetés."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Csak Vulkan. Javítja a teljesítményt és sok grafikai problémát, de egyes GPU-kon instabil lehet. A nem támogatott módszerek automatikusan visszaváltanak."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Csak Vulkan: utasítja a videó illesztőt egy megadott pufferelési mód használatára."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Mi csatlakozik az Amiga első portjába. A legtöbb játék a joystickot a 2. portban, az egeret az 1. portban használja."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Mi csatlakozik az Amiga második portjába."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Mi csatlakozik az Amiga második portjába. Az alapértelmezett a joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Mit kap a második port, amikor második kontroller csatlakozik."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Cím megadásakor a mód automatikusan 'KÉZI' értékre áll."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "Ha az automatikus felismerés sikertelen."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Ha elérhető, a kizárólagos teljes képernyő előnyben részesítése az emulátoroknál."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "Engedélyezve minden játéknak saját VMU-ja lesz az 1. portban."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "A 'KÉZI' kiválasztásakor adjon meg egy címet a következő beállításban."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "Ha a sebességkorlát le van tiltva, a MAME a lehető leggyorsabban futtatja az emulációt."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr ".m3u fájl használatakor válassza ki az indítandó lemez indexét."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Kurzor joystick használatakor a gombokat billentyűkhöz kell rendelni a RetroArchban."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "XInput használatakor ez az opció felcseréli az 1. és 2. gamepadet."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Sinden pisztoly használatakor a Lightgun szoftver bezárása a játék végén."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Arcade rendszereknél fájlból történő hozzárendelés használatakor adja meg a használandó elrendezést."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "Valódi Wiimote-ok használatakor adja meg a Wiimote típusát."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "Teljes billentyűzetbemenetet igénylő szoftver használatakor ajánlott a játékfókusz módot is használni."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Hol jelenjen meg a DMD. AUTO: 1 képernyőnél a játéktéren, 2 képernyőnél a backglass képernyő alján, 3 képernyőnél a saját képernyőjén. KÉPERNYŐ KONFIGURÁCIÓ szükséges."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Melyik RetroPad melyik Amiga portot vezérli. Hagyja Automatikus értéken, hacsak a játékosok nincsenek felcserélve."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Egy többlemezes játék melyik lemeze kerül behelyezésre indításkor. A POM2 egyszerre egy lemezt tölt be, a többit a játékbeli menüből lehet cserélni."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Egy többlemezes játék melyik lemeze kerül behelyezésre indításkor: mindig az első, vagy az, amelyik a legutóbbi kilépéskor a meghajtóban volt."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Melyik akciógomb erősít meg a PS3 rendszer párbeszédablakaiban. A japán játékok általában a Kört, a nyugatiak a Keresztet várják. Hagyja AUTO értéken a kiválasztott régió követéséhez."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Melyik floppymeghajtóra hat a lemezcsere menü."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Az emulátor által rajzolt fehér szegély, amelyre a Sinden pisztolyoknak a célzáshoz szükségük van."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "A Sinden pisztoly csatlakoztatásakor rajzolt fehér szegély szélessége. Alapértelmezetten 16 pixel."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "A Sinden pisztoly csatlakoztatásakor rajzolt fehér szegély szélessége. Alapértelmezetten 2 pixel."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Az XBOX folyamatot több CPU szálon futtatja, javíthatja a teljesítményt, de egyes játékokat elronthat."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Néhány homebrew-hoz és ROM hackhez szükséges kerülőmegoldás."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Egyes kormányok firmware-hibáit kerüli meg, amelyek rövid erőkimaradásokat okoznak. Hagyja kikapcsolva, hacsak nincs rá szükség."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Az Amiberry.log fájlt írja az emulátor mappájába. Csak hibajelentéshez hasznos, kissé lassít."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "A mélységpuffer értékeit a VM memóriába írja. Alapértelmezetten ki."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "A bemeneti eseményeket naplófájlba írja a mentési mappában. Csak hibajelentéshez hasznos."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "A Z80 SoftCard CP/M szoftvereket futtat. A hangkártyák itt másodikként adhatók hozzá. A módosítás újraindítja a gépet."

msgctxt "game_options"
msgid "Zooms in to hide black borders."
msgstr "Ráközelít a fekete szegélyek elrejtéséhez."

msgctxt "game_options"
msgid "Zooms in to hide black borders. Borders are different per game."
msgstr "Ráközelít a fekete szegélyek elrejtéséhez. A szegélyek játékonként eltérnek."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "Zorro II bővítő RAM. Sok WHDLoad címhez szükséges, de néhány eredeti floppys játék nem hajlandó elindulni vele."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "Zorro II bővítő RAM. Sok WHDLoad címhez szükséges."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Zorro III memória, csak gyorsított gép használhatja. Hagyja nincs értéken, hacsak egy adott cím nem kéri."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Zorro III memória. Workbench beállításokhoz és néhány demóhoz hasznos."

msgctxt "game_options"
msgid "use this to automatically start to a specified level."
msgstr "használja egy adott pályán történő automatikus indításhoz."
