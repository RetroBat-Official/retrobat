# FEATURES - DESCRIPTIONS
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' on aseman todellinen nopeus. 'Turbo' lataa lähes välittömästi, mutta muutama peli tunnistaa sen ja kieltäytyy käynnistymästä."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' on aseman todellinen nopeus. 'Turbo' poistaa levykkeen pyörimisen emuloinnin ja lataa lähes välittömästi, mutta muutama peli tunnistaa sen ja kieltäytyy käynnistymästä."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "'Tarkka' vastaa laitteistoa, mutta voi pudottaa kuvanopeutta pahasti tallennus- ja latausnäytöissä. Muuta tätä vain, jos jokin valikko on hidas."

msgctxt "game_options"
msgid "'Auto' defaults to the most compatible version for the model."
msgstr "'Auto' valitsee mallille yhteensopivimman version."

msgctxt "game_options"
msgid "'Auto' is the default floppy speed (300RPM). 'Turbo' removes disk rotation emulation."
msgstr "'Auto' on levykkeen oletusnopeus (300 RPM). 'Turbo' poistaa levykkeen pyörimisen emuloinnin."

msgctxt "game_options"
msgid "'Auto' will controls the half-screen fix detection on texture shuffling."
msgstr "'Auto' ohjaa puolinäytön korjauksen tunnistusta tekstuurien sekoittamisessa (texture shuffling)."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "'Yhteensopiva' sopii lähes kaikkiin peleihin. 'Syklintarkka' on tarkin, mutta vaatii nopean PC:n. 'Nopea' vapauttaa CPU:n nopeuden ja voi rikkoa ajoitusherkkiä pelejä."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "'Kaksinkertainen' antaa puhtaan modernin kuvan. Scanline-tilat jäljittelevät CRT-näytön ulkonäköä."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "'Dual Stick' määrittää pelaajan 2 joystickin pelaajan 1 oikeaan analogitikkuun, 'Swap Ports' korjaa porttien käänteisyyden pelissä 'Wizard of Wor'."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "'Tarkka' on uskollisin Paula-emulointi. Laske sitä vain, jos ääni pätkii hitaalla PC:llä."

msgctxt "game_options"
msgid "'Games Express' is needed for several unlicensed games."
msgstr "'Games Express' tarvitaan useisiin lisensoimattomiin peleihin."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "'Joystick' on klassinen 2 painikkeen sauva, jota kaikki pelit ymmärtävät. 'CD32-ohjain' lisää värilliset painikkeet ja valitaan automaattisesti CD32:lla."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "'PÄÄLLÄ' välittää kaikki fyysisen näppäimistön tapahtumat ytimelle. 'POIS' estää RetroPadin näppäimiä luomasta näppäimistötapahtumia."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "'ENNALTA MÄÄRITETYT' käyttää emulaattorin 'cfg'-kansiossa olevia määritystiedostoja, 'DYNAAMINEN' luo määrityksen 'OHJAUS'-lisäasetuksissa valitun profiilin perusteella."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "'Turvallinen' korjaa tekstuurivirheitä joissakin peleissä, mutta heikentää suorituskykyä paljon."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "'Mallit'-vaihtoehto kopioi kansiossa 'emulators\m2emulator\templatescfg' olevat tiedostot dynaamisen automaattisen määrityksen sijaan."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "'Kolmoispuskuri' ja 'sovita emuloituun sisältöön' ovat käytettävissä vain Vulkan-videoajurilla."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "'Turbo' poistaa hakuviiveen emuloinnin."

msgctxt "game_options"
msgid "'Weave' should only be used with 1x scaling factor and CRT shaders."
msgstr "'Weave'-tilaa tulee käyttää vain 1x-skaalauskertoimella ja CRT-varjostimilla."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "'XINPUT' pakottaa XInput-rajapinnan käyttöön yhteensopivilla ohjaimilla."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "'directx11' on oletus ja toimii lähes kaikilla laitteistoilla. 'vulkan' voi olla nopeampi uusilla näytönohjaimilla. Jotkin libretro-ytimet pakottavat oman ajurinsa."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8 Mt Fast RAM -muistia (CD32FR). Oletuksena pois päältä, kuten alkuperäisessä CD32:ssa."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "0 on matalin laatu, viive ja CPU-käyttö, 10 on korkein laatu, viive ja CPU-käyttö."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "Moderneille ohjaimille suositellaan 130–140 %."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 bittiä poistaa värien porrastumisen tummista alueista ja liukuväreistä. HDR vaatii HDR-näytön ja RetroArchissa käyttöön otetun HDR:n, muuten ydin palaa 24 bittiin."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x vastaa oikeaa asemaa. Suuremmat nopeudet lyhentävät latausaikoja, mutta voivat rikkoa pelejä."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "32k RAM-laajennuskortti asennettuna."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "Oletuksena 4/3 kuten arcade-näytössä. Kehys näytetään vain 4/3-tilassa. 16/9 levittää 3D-näkymää."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Muutama peli vaatii tämän vaihtoehdon pois käytöstä."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Muutama peli vaatii tämän. Maksaa noin 10 % suorituskyvystä."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Muutama hyvin varhainen peli vaatii CTIA-piirin näkyäkseen oikein."

msgctxt "game_options"
msgid "A shadows and colors fix needed for some games such as Tony Hawk Proving Ground."
msgstr "Varjojen ja värien korjaus, jota jotkin pelit kuten Tony Hawk Proving Ground tarvitsevat."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII yhdistää näppäimistösi sen tulostamiin merkkeihin. Alkuperäinen jäljittelee emuloidun koneen näppäimistöä tarkasti, mitä muutama ohjelma tarvitsee."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "AUTO (suositeltu) antaa ytimen valita NAND-tiedoston pelin alueen perusteella."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO näyttää tähtäimen, kun tähdätään hiirellä, ja piilottaa sen oikealla valopistoolilla."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO vaihtaa DSi-tilaan vain DSi-yksinoikeuspeleissä. Pakota DSI DSiWare-ohjelmille."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "AUTOMAATTINEN valitsee laajennuksen ohjelman koon perusteella. Voidaan pakottaa tiedostonimen tunnisteilla kuten (8k) tai [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMAATTINEN: Vita3K lataa tarvittavat laiteohjelmistomoduulit itse (suositeltu). EMULAATTORIN ASETUKSET: säilytä Vita3K:n käyttöliittymässä valitut moduulit."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Yli 60 fps:n nopeudella kuvat interpoloidaan pelin päivitysten välillä. AUTO seuraa näytön virkistystaajuutta."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Tarkka kehyspuskurin emulointi, erittäin hidas mutta joidenkin pelien vaatima."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Toimi pelaajana 1 ja isännöi peliä."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Ohjaimen toisen painikkeen toiminto: välilyönti (esim. Xenon 2) tai joystick ylös (hyppy tasohyppelyissä)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Ota tähtäysapu käyttöön."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Ota automaattinen tallennus käyttöön ja määritä tallennusten väli."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "Ota tämä käyttöön WiiZapperin kanssa vaihtaaksesi liipaisimen ja latauspainikkeen keskenään."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Sovita pelinäkymä laajakuvanäytöille."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Lisää tyhjä 2HD-tallennus-/käyttäjälevyke levykkeiden hallintaluetteloon."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Lisää kosketusvarjot, vaatii laitteistorenderöijän."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Säädä hiiren osoittimen nopeutta analogitikun herkkyyden mukaan."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "Säädä lähtövärejä jäljittelemään alkuperäisen konsolin näyttöä."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Säädä Wiimoten osoittimen pystykeskitystä."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Säätää musiikkiraidan äänenvoimakkuutta."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Säätää äänitehosteiden äänenvoimakkuutta."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Monien pelien käyttämä edistynyt äänikirjasto. Poista käytöstä vain, jos peli kaatuu tai siinä on ääniongelmia."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Tähtää esineitä ohjaimen gyroskoopilla (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Salli ADAMin kirjoittaa levykkeille ja datapakkauksiin. Kirjoitukset menevät saves-kansioon tallennettuun työkopioon, alkuperäistä tiedostoa ei koskaan muuteta. Vaatii ytimen uudelleenkäynnistyksen."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Salli DirectInput-ohjaimet (yleiset USB-ohjaimet, arcade-sauvat). Poista käytöstä vain, jos ohjain tunnistetaan kahdesti."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Salli XInput-ohjaimet (Xbox-ohjaimet ja kääreet). Poista käytöstä vain, jos ohjain tunnistetaan kahdesti."

msgctxt "game_options"
msgid "Allow bilinear scaling on scanout."
msgstr "Salli bilineaarinen skaalaus kuvan ulostulossa (scanout)."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Mahdollistaa tekstuurien toiston (texture wrapping) oikean emuloinnin suorituskyvyn kustannuksella."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Sallii eri resoluutioita tukevien pelien renderöinnin tietyllä resoluutiolla."

msgctxt "game_options"
msgid "Allow gamma dither."
msgstr "Salli gamman dithering."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Salli natiivi HID-tuki DualShock 4-, DualSense- ja Switch Pro -ohjaimille. Poista käytöstä palataksesi DirectInputiin."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Salli vasemman ja oikean tai ylös ja alas painaminen samanaikaisesti. Voi aiheuttaa liikevirheitä joissakin peleissä."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Salli vastakkaisten suuntien painaminen samanaikaisesti."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Sallii joidenkin 30 fps:n pelien toimia 60 fps:n nopeudella."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Salli virheellisen tyypin tekstuuri- ja verteksihakuvakiot, voidaan käyttää hakuvirheiden ohittamiseen tietyissä peleissä."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Salli muuttuvan virkistystaajuuden käyttö sitä tukevilla näytöillä. VRR:ää tukemattomilla näytöillä kuva voi repeillä tietyissä tilanteissa."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Salli kartan lähentäminen ja loitontaminen hiiren rullalla, kuten Enhanced Editions -versioissa."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Mahdollistaa arcade-sauvasi oman määrityksen 'arcade_sticks.json'-tiedoston perusteella."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Mahdollistaa hiiren syötteiden käytön, vaikka laitetyypiksi ei ole asetettu 'RetroKeyboard/Mouse'."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Aseta myös seuraava levyke asemaan 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Pura arkistot aina, vaikka dokanin avulla ne voitaisiin liittää asemakirjaimena."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Näytä aina maassa olevien esineiden nimet."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Emuloitava Amiga-malli. Jokainen tarvitsee oman Kickstart-ROMinsa bios-kansioon."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Emuloitava Amiga-malli. Vaatii ytimen uudelleenkäynnistyksen. Jokainen malli tarvitsee vastaavan Kickstart-ROMin kansioon bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Amigan portti, johon pistooli on kytketty. Portti 2 on oikea lähes kaikille koneille; vain A1000 lukee kynää portista 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Chip RAM -muistin määrä. Jotkin myöhemmät pelit tarvitsevat 1 Mt. Mallin tukemaa määrää suurempi voi rikkoa yhteensopivuuden."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "Käytetyn RAM-muistin määrä."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Ohitettavan pienen osoitinliikkeen määrä."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Lisävärinä, joka voimistuu ohjattaessa."

msgctxt "game_options"
msgid "Anti-aliased fetch filter, smooth polygons edges."
msgstr "Reunanpehmennetty hakusuodatin, tasoittaa polygonien reunoja."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Reunanpehmennyksen taso."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Reunanpehmennyksen menetelmä ja taso."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Emuloitava Apple II -malli. Muutos käynnistää koneen uudelleen."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Emuloitava Apple II -malli. PAL-mallit toimivat 50 Hz:llä, ja niille eurooppalaiset demot on tehty. Muutos käynnistää koneen uudelleen."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Käytetään tähtäinkuvaan, auttaa erottamaan pelaajat toisistaan."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Soveltaa potenssikäyrää ohjausarvoihin, vaimentaa pieniä liikkeitä."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Koskee lentotikun ja kaasuvivun akseleita peleissä After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Koskee kaasu- ja jarrupolkimia ajopeleissä."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Käytä Gouraud-varjostusta tasaisen varjostuksen sijaan, vain OpenGL:llä."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Käytä CRT-suodatinta (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Käytä ruskehtavaa värisuodatinta."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "Käytä ytimen tarjoamaa videosuodatinta."

msgctxt "game_options"
msgid "Apply a video filter to mimic various signals."
msgstr "Käytä videosuodatinta jäljittelemään eri signaaleja."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Käytä videosuodatinta lähtökuvaan."

msgctxt "game_options"
msgid "Apply an audio filter. 'Gaussian' reproduce the bass-heavy sound of the original hardware."
msgstr "Käytä äänisuodatinta. 'Gaussinen' jäljittelee alkuperäisen laitteiston bassopainotteista ääntä."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Käytä äänisuodatinta. Muuttaa äänen interpolointia."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Käytä ydinkohtaista suodatinta jäljittelemään vanhan signaalin renderöintiä."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Käytä korjausta joihinkin peleihin."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Käytä yllä olevaa aluetta, vaikka peli ilmoittaisi oman alueensa."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Jäljittelee konsolin analogista lähtöastetta: poistaa tasajännitesiirtymän ja pehmentää korkeita taajuuksia."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Arcade-näytön ulkonäkö."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Arcade-näytön ulkonäkö: scanlinet, varjomaski ja hehku."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Ytimen tarjoama kuvasuhde, jota käytetään, kun PELIN KUVASUHDE on AUTO."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Konsolin järjestelmäasetuksissa määritetty kuvasuhde."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Atari-näppäimistö: F2, F4 ja F8 jätetään pelille, tilatallennukset ja kuvakaappaukset käyttävät silloin AltGr+K, AltGr+L ja AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Yritä tehdä uudelleenskaalaus natiiviresoluutiolla."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Äänipuskurin kynnys manuaaliselle frameskipille."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Ääni antaa pienimmän viiveen. Video on tasaisempi, kun näytön virkistystaajuus on lähellä konsolin taajuutta."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Äänen lähtötaajuus."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (oletus) seuraa näytön virkistystaajuutta liikeinterpoloinnilla. Alkuperäinen ja 57,524 Hz:n monikerrat vaativat G-SYNC / FreeSync -näytön ja pystytahdistuksen."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Keskitä tähtäysakseli automaattisesti. Hyödyllinen pelattaessa pistoolipelejä gamepadilla valopistoolin sijaan."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Automaattisen tulituksen nopeus. Nopeampi ei aina ole parempi: jotkin pelit ohittavat liian nopeat syötteet."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: länsi hyökkäys, etelä hyppy, itä erikoisliike, pohjoinen hyökkäys 2, L1/R1 hyökkäys 3/4. OpenBOR standalone: samat painikkeet kuin erillisessä OpenBOR-emulaattorissa."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automaattinen käyttää XInputia, kun kaikki ohjaimet ovat XInput-laitteita, muuten DirectInputia."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automaattinen: käynnistä kiintolevyltä, kun pelillä on kiintolevy eikä levykettä."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automaattinen: näytetään vain, kun pelillä ei ole omaa tähtäintä."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Käytä automaattisesti pelin parannuksia, jos ne löytyvät ytimen tietokannasta (LOD, piirtoetäisyys, FMV:n ohitus)."

msgctxt "game_options"
msgid "Automatically decrease frame delay temporarily to prevent frame drops. Turn off if this worsens audio/video stuttering."
msgstr "Vähennä kuvaviivettä automaattisesti tilapäisesti kuvien pudotusten estämiseksi. Poista käytöstä, jos tämä pahentaa äänen/kuvan pätkimistä."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Kelaa FDS-peliä automaattisesti nopeasti eteenpäin levykkeen latauksen aikana."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Lataa lomituksenpoistopäivitykset automaattisesti pelin käynnistyessä."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Lataa laajakuvapäivitykset automaattisesti pelin käynnistyessä."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Lataa ja käyttää huijaukset automaattisesti pelin käynnistyessä."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Poistaa automaattisesti Amigan kuvan ympärillä olevat mustat reunat, jotta kuva täyttää enemmän näyttöä."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Kierrä näyttöä automaattisesti pystypeleissä."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Vaihda Port0 ja Port1 automaattisesti syötteen aktiivisuuden perusteella."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Vaihda levykkeen puolta automaattisesti, kun peli pyytää sitä."

msgctxt "game_options"
msgid "Avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Estä pikselien väliset raot ylösskaalauksessa. Korjaa Wild Armsin tekstin ja SoulCaliburin haamukuvat."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "BIOSin kieli voi vaikuttaa joidenkin pelien kieleen."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Kehykset näytetään vain 4/3-tilassa."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "Bilateraalista CAS:ia suositellaan, mutta se heikentää suorituskykyä; CAS on vähemmän aggressiivinen mutta hienovaraisempi."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Kuvan mustan taso. Oletuksena 50 % arcade-kaappauksen mukaan: pienempi on tummempi, suurempi kirkkaampi."

msgctxt "game_options"
msgid "Blend pixel together when in hires mode. Higher values will blur the picture more."
msgstr "Sekoita pikselit yhteen hires-tilassa. Suuremmat arvot sumentavat kuvaa enemmän."

msgctxt "game_options"
msgid "Blend pixels from multiple successive frames to simulate LCD ghosting."
msgstr "Sekoita pikseleitä useista peräkkäisistä kuvista jäljittelemään LCD-näytön haamukuvaa."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "Sekoitettu piirtää läpinäkyvät polygonit pehmeänä sekoituksena arcaden shakkilautakuvion sijaan. Vain Model 1 ja Model 2, Vulkan- ja OpenGL-renderöijät."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Sumenna emuloitua näyttöä."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "Sumentaa vierekkäisiä pikseleitä läpikuultavuustehosteita varten."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "Sumentaa vierekkäisiä pikseleitä jäljittelemään SDTV-resoluutiota, jotkin pelit voivat vaatia sitä läpinäkyvyyden emulointiin."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Nopeuta emulointia käynnistyksen aikana."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Käynnistä suoraan DS:n BIOS-valikkoon, vaatii ulkoisen BIOSin käyttöönoton."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Käynnistä Game Genie -koodien syöttönäyttöön. Vaatii 'gamegenie.nes'-tiedoston bios-kansioon. Uudelleenkäynnistys vaaditaan."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Käynnistä konsolin BIOS-valikkoon."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Käynnistä oikealla Jaguar-BIOSilla ja sen aloitusanimaatiolla. Jotkin pelit vaativat tämän."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Pysähdy isännän vianetsintäohjelmaan (tai kaadu, jos sitä ei ole liitetty), kun kohdataan toteuttamaton PowerPC-käsky."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "Avaa järjestelmä-ROMin valikko arcade-järjestelmien käynnistyksessä."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Lähetä syötepalaute TCP-porttiin 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Rakenna välimuistitetut varjostimet ennen pelin alkua."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Painikeyhdistelmä TV:n ja GamePadin välillä vaihtamiseen, käytetään vain VAIHDETTAVA-näyttöasettelussa."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Ytimen painikeasettelu, sama kaikille peleille. Jätä AUTO-tilaan käyttääksesi RetroBatin pelikohtaista määritystä ja OHJAIMEN ASETTELU -asetusta."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Painike, jolla vahvistetaan järjestelmän valintaikkunoissa ja järjestelmäasetusta noudattavissa peleissä. YMPYRÄ on japanilainen käytäntö."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Oletuksena Hellfire käynnistetään, kun pelin nimessä on sana hellfire, muuten Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Oletuksena RetroBat määrittää yhtä monta pelaajaa kuin ohjaimia on liitetty, käytä tätä ohittaaksesi sen."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Oletuksena RetroBat luo oman määritystiedostonsa, ota tämä käyttöön käyttääksesi omaa pelin asetustiedostoasi kansiossa 'emulators\ssf\Setting'."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Oletuksena toista gamepadia käytetään, kun toinen ohjain on liitetty."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Oletuksena jokainen ohjain liikuttaa sankaria. Ota käyttöön, jos jokin toinen liitetty ohjain häiritsee liikkumista."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "Oletuksena zinc määrittää vasemman tikun liikkumiseen, käytä tätä vaihtaaksesi ristiohjaimeen."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Oletuksena RPCS3 vaatii GunConin pelaajaporttiin 3, käytä tätä pakottaaksesi sen porttiin 1."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Oletuksena RetroBat hylkää ydinkohtaiset asetustiedostot."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Oletuksena RetroBat pitää asennetut pelit ja roms-kansion synkronoituna."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "Oletuksena kalibrointi tehdään hiiren keskipainikkeella, tällä asetuksella voi määrittää vaihtoehtoisen painikkeen kalibrointilaukaukselle."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Oletuksena muutokset tallennetaan levykeasemaan, 'hylkää' ei tallenna muutoksia."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Oletuksena ravistamiseen käytetään liipaisinta, ota tämä käyttöön simuloidaksesi heilautusta sen sijaan."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Ohita mip-kartoitus ja käytä aina terävintä tekstuuritasoa. Parempi kuvanlaatu, muutamassa pelissä ilmenee renderöintiongelmia."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "CD32-kokoonpano. Tarvitsee sekä CD32-Kickstartin että sen laajennus-ROMin bios-kansioon."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "KLASSINEN on alkuperäinen ohjelmistorenderöijä. POLYMOST ja POLYMER käyttävät OpenGL:ää ja tukevat HD-paketteja."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "CPC:n fyysisen RAM-muistin koko kilotavuina."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "CPU:n kellotaajuus. Auto käyttää mallin kelloa tai pelitietokantaa. Jotkin pelit (SSF2, Alltynex) hyötyvät nopeammasta CPU:sta."

msgctxt "game_options"
msgid "CPU frequency multiplier. Applies only with Cycle-exact."
msgstr "CPU:n taajuuskerroin. Koskee vain syklintarkkaa tilaa."

msgctxt "game_options"
msgid "Cache custom textures to system RAM on startup."
msgstr "Tallenna mukautetut tekstuurit järjestelmän RAM-muistiin käynnistyksessä."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Kameran nopeus oikealla analogitikulla tai hiirellä."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Voi vaikuttaa suorituskykyyn odottamattomilla tavoilla."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Voidaan käyttää BIOSin md5-tarkistuksen poistamiseen, jos käytetään mukautettua BIOSia."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "Voidaan käyttää kuvanopeuden parantamiseen, mutta voi rikkoa joidenkin pelien nopeuden."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Voidaan käyttää 3D-renderöinnin suorituskyvyn parantamiseen joissakin peleissä."

msgctxt "game_options"
msgid "Can be used to simulate colors of particular displays."
msgstr "Voidaan käyttää tiettyjen näyttöjen värien simulointiin."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Voi olla hyödyllinen Gran Turismossa, liipaisimet määritetään eri painikkeisiin."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Voi olla hyödyllinen Gran Turismossa, liipaisimet määritetään oikeaan analogitikkuun."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Voi olla hyödyllinen Metal Gearissa painenherkkyyden simulointiin."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Voi hyödyttää joitakin pelejä."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Voi aiheuttaa erilaisia virheitä."

msgctxt "game_options"
msgid "Can fix bad memory access error with some games."
msgstr "Voi korjata virheellisen muistinkäytön virheen joissakin peleissä."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Voi korjata väärin kohdistettuja 2D-kuvia, kuten Mario Kartin hahmovalinnan."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Voi korjata joitakin virheitä, joita esiintyi jopa alkuperäisellä laitteistolla."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Voi korjata joitakin pelejä ei-natiivilla resoluutiolla pyöristämällä 2D-reunoja."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Voi korjata joitakin XBOX-ohjainten ongelmia."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Voi parantaa tarkkuutta pienellä suorituskyvyn kustannuksella."

msgctxt "game_options"
msgid "Can improve framerate or cause timing error."
msgstr "Voi parantaa kuvanopeutta tai aiheuttaa ajoitusvirheitä."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Voi parantaa suorituskykyä tehokkaammilla näytönohjaimilla, joilla on ylimääräistä kapasiteettia. Toimii vain Vulkan-renderöijällä."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Voi parantaa suorituskykyä joillakin heikommilla järjestelmillä."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Voi parantaa suorituskykyä tehokkaalla näytönohjaimella."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Voidaan käyttää vain, jos ohjain tukee liikeohjausta."

msgctxt "game_options"
msgid "Can reduce input latency, but will inscrease CPU requirements."
msgstr "Voi vähentää syöteviivettä, mutta lisää CPU-vaatimuksia."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Voi vähentää nykimistä varjostimia käännettäessä, mutta voi myös aiheuttaa artefakteja."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Voi vähentää viivettä tai poistaa alimman rivin Wiillä grafiikkaongelmien kustannuksella."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Rajoita kuvanopeus alkuperäiseen 35 fps:ään."

msgctxt "game_options"
msgid "Certain games require an external cartridge to run."
msgstr "Tietyt pelit vaativat ulkoisen kasetin toimiakseen."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Vaihda ristiohjaimen ohjaus joystickin ja hiiren välillä."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Muuta alanäytön kuvasuhdetta."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "Muuta ylänäytön kuvasuhdetta."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Muuta purettujen pelien polkua (oletus on '\roms\.uncompressed')."

msgctxt "game_options"
msgid "Change the emulated audio chip model."
msgstr "Muuta emuloitavan äänipiirin mallia."

msgctxt "game_options"
msgid "Change the renderer used by the core."
msgstr "Muuta ytimen käyttämää renderöijää."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Muuta ytimen käyttämää renderöijää. Pistoolipelit toimivat vain OHJELMISTO-tilassa."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Muuta analogitikun herkkyyttä."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Muuta hiiren herkkyyttä."

msgctxt "game_options"
msgid "Change this only if multiple GPU are used by your system."
msgstr "Muuta tätä vain, jos järjestelmässäsi on käytössä useita näytönohjaimia."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Muuta tätä asetusta pelin ohjauksen mukaan: /-merkin vasemmalla puolella on pelin alkuperäinen painike kiihdytykselle ja jarrulle, oikealla vaihteille."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Muuta tätä asetusta pelin ohjauksen mukaan."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Muuta tätä asetusta epävakaiden pelien kanssa. Mitä suurempi arvo, sitä parempaa vakautta se voi tarjota. 200 μs ja 400 μs ovat yleensä hyviä useimmille peleille."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Muuttaa, miten emulaattorin säikeet jaetaan CPU-ytimille. RPCS3-ajoittimet voivat auttaa suorittimilla, joissa on useita CCX/CCD-klustereita tai SMT, mutta käyttöjärjestelmä on turvallisin useimmilla koneilla."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Muuttaa, miten aseet näytetään Rambossa."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Muuttaa äänipiirin, TMSS-käynnistysnäytön ja muutaman laitteiston erikoisuuden."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Merkkigeneraattoripiiri. Automaattinen valitsee valittua konetta vastaavan."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "Huijaukset on sijoitettava kansioon \bios\pcsx2\cheats."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "Huijaukset on sijoitettava kansioon 'cheats\mame'."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "Huijaukset on sijoitettava kansioon 'cheats\psxmame'."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Tarkista jokainen ROM pelitietokantaa vasten. Poista käytöstä vain testataksesi romsettiä, joka ei lataudu: väärät ROMit voivat kaataa pelin tai vioittaa tallennuksia. Oletuksena käytössä."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Tarkistaa vioittuneet tiedostot peliä käynnistettäessä."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Piirisarja, jota käytetään, kun AGA-malli on valittu. Laske AGA:n alapuolelle vain testataksesi peliä, joka toimii väärin A1200:lla."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Valitse 'Trojan Phazer' tälle pistoolille tehdyille peleille. 'Valokynä' sopii kaikkeen muuhun, myös piirto-ohjelmiin."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "Valitse toiseen kasettipaikkaan lisättävä MSX-laajennus."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Valitse englantilainen, ranskalainen tai espanjalainen näppäimistöasettelu."

msgctxt "game_options"
msgid "Choose between various texture enhancement filters."
msgstr "Valitse eri tekstuurinparannussuodattimista."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Valitse painike, joka ottaa IR:n käyttöön oikeassa tikussa."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Valitse painike, joka simuloi oikean tikun heilautusta."

msgctxt "game_options"
msgid "Choose if the mouse input is active or not."
msgstr "Valitse, onko hiiren syöte aktiivinen vai ei."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Valitse, vaihtaako näytönvaihdon pikanäppäin näytöt pysyvästi vai vain painiketta painettaessa."

msgctxt "game_options"
msgid "Choose the audio driver compatible with the hardware."
msgstr "Valitse laitteistoon sopiva ääniajuri."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Valitse väripaletti."

msgctxt "game_options"
msgid "Choose the disposition of the emulated screens."
msgstr "Valitse emuloitujen näyttöjen sijoittelu."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Valitse ohjaimeen liitetty lisälaite."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Valitse emuloitujen näyttöjen toinen sijoittelu."

msgctxt "game_options"
msgid "Choose which Atari system to emulate."
msgstr "Valitse emuloitava Atari-järjestelmä."

msgctxt "game_options"
msgid "Choose which color palette is going to be used"
msgstr "Valitse käytettävä väripaletti"

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Valitse käytettävä väripaletti."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Valitse asema, jota levykkeiden hallintavalikko käyttää. Muut asemat pysyvät liitettyinä. Ladattu media käyttää asemaa, johon peli ladattiin."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "Klassinen käyttää oikeaa ja vasenta olkapainiketta voimakkaaseen potkuun ja lyöntiin, moderni käyttää oikeaa olkapainiketta ja oikeaa liipaisinta."

msgctxt "game_options"
msgid "Cleans up stray black pixels."
msgstr "Siivoaa irralliset mustat pikselit."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Väripaletti alkuperäisille Game Boy -peleille."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Arcade-näytön värilämpötila."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "WonderSwan-pelien (mono) värit. WS-paletit jäljittelevät alkuperäisiä näyttöjä."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "Määritä näyttöjen välinen rako pikseleinä."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "Määritä näkökenttä (suurempi on laajempi)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Määritä fps."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Määritä tämä asetus, jos haluat vaihtaa stereo- ja surround-äänen välillä."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Määrittää, miten ohjaimia pyydetään isännältä tai asiakkaalta. Välttämätön paikalliselle moninpeliyhteydelle."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Kytke hiiri porttiin 1."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Valittua BIOS-kuvaa vastaava konsoliversio."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "Säätää GS-sekoitusyksikön tarkkuustasoa. Suuremmat arvot emuloivat sekoitusta tarkemmin varjostimessa."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Säätää emuloinnin tekstuurien trilineaarista suodatusta."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Säätää, miten ditheringiä käytetään."

msgctxt "game_options"
msgid "Controls the number of Auto-CRC fixes and hacks applied to games."
msgstr "Säätää peleihin sovellettavien Auto-CRC-korjausten ja hackien määrää."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Säätää tulosteen yksityiskohtaisuutta ennen ohjelman näyttämistä."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Muunna vaihde ylös/alas vaihteiksi 3/4 peräkkäisvaihteiston simuloimiseksi tavallisella vaihdekepillä."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Kopioi tekstuurit VRAM-muistiin, hitaampi mutta tarkempi. Poista käytöstä parantaaksesi suorituskykyä."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Kopioi väripuskuri N64:n muistiin. Tarvitaan joihinkin tehosteisiin (esim. taukonäytöt, kameran kuvat). POIS on nopein, mutta voi rikkoa ne. AUTO seuraa suorituskykytilaa."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Oikea mutta hitaampi."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Korjaa ei-neliömäisten pikselien kuvasuhde."

msgctxt "game_options"
msgid "Correct the sampling of 2D sprite textures when upscaling."
msgstr "Korjaa 2D-spritetekstuurien näytteistys ylösskaalauksessa."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Rajaa pois mahdollisesti satunnainen virheellinen videolähtö, jonka tavallisen SD-television kuvaruudun reunus olisi piilottanut."

msgctxt "game_options"
msgid "Crop out the potentially video output that would have been hidden by the bezel."
msgstr "Rajaa pois videolähdön osa, jonka kuvaruudun reunus olisi piilottanut."

msgctxt "game_options"
msgid "Crop pixels around edge of screen."
msgstr "Rajaa pikseleitä näytön reunoilta."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "Rajaa kuva natiivista kuvasuhteesta 4:3:een tai 16:9:ään"

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "Rajaa reunat näyttääksesi tai piilottaaksesi reunagrafiikat."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "Rajaa kuvan 256x240:stä 252x239:ään."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Konsolin äänilähdön suodattimen rajataajuus. 3390 Hz vastaa useimpia Mega Drive -malleja."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "Leikkaa 8 pikseliä reunoilta poistaakseen Master Systemin reunat."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "DIMM-kortin koko. Auto seuraa peliä, jätä Auto-tilaan, ellei peli valita."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Vaimentaa seurantakameran heilumista ajopeleissä. Oletuksena voimakas."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Tummenna joka toinen rivi jäljittelemään kuvaputkea."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "DeSmuMEssa on sisäinen BIOS, valitse tämä käyttääksesi BIOSia ja laiteohjelmistoa RetroBatin bios-kansiosta."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Pienennä, jos liian herkkä; liiallinen pienentäminen voi estää koko liikealueen käytön."

msgctxt "game_options"
msgid "Default ON."
msgstr "Oletuksena PÄÄLLÄ."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "Emuloitu oletusohjain on 6 painikkeen ohjain."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Oletuksena käytössä, voi olla ongelmallinen muutamissa peleissä."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Oletuksena seuraa EmulationStationin kieltä."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "Oletus on 'KORKEA', aseta 'NORMAALI' parantaaksesi suorituskykyä tarkkuuden kustannuksella."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "Oletus on 30 sekuntia; määritä, kuinka kauan odotetaan pelin käynnistymistä ennen paluuta RetroBatin pelilistaan."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "Oletuksena POIS, käytä tätä, jos nopeusongelmia ilmenee korkean virkistystaajuuden näytöillä."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Oletuksena PÄÄLLÄ (nopea). POIS suorittaa oikeat geometria-DSP-ohjelmat, tarkempi mutta hitaampi (vain Model 1- ja Model 2 2B -pelit)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Oletuksena PÄÄLLÄ, oikea nelikulmioiden renderöinti. POIS renderöi nelikulmiot kolmioina (nopeampi)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Oletuksena PÄÄLLÄ, POIS voi korjata yhteensopivuuden vanhemmilla näytönohjaimilla (vain Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "Oletuksena PÄÄLLÄ, käytä tätä asetusta 60 Hz:n rajan poistamiseen, voi rikkoa pelejä."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Oletuksena käytössä, poista käytöstä näyttääksesi käynnistysanimaation."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Oletuksena 10 bittiä DS:lle ja 16 bittiä DSi:lle."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Oletuksena Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "Oletuksena WIIU Gamepad, muuta tätä peleissä, jotka eivät hyväksy WIIU Gamepadia moninpelitilassa."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Oletus: kohdistin piilotettu."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Oletus: käytössä."

msgctxt "game_options"
msgid "Default: low."
msgstr "Oletus: matala."

msgctxt "game_options"
msgid "Default: true"
msgstr "Oletus: tosi"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Oletuksena 60, kun asetettu 0:ksi ja VSYNC on käytössä."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Määritä emuloinnissa käytettävä BIOS."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "Määritä gamepadin tyyppi, koskee molempia pelaajia."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "Määritä PET-tietokoneen malli."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "Määritä suoritettava Symbian-laite."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Määritä painike Gamepad-näytön näyttämiseen, oletus jos ei mitään."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Määritä, kuinka paljon RAM-muistia emuloidulla koneella on."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Määritä, miltä kohdistin näyttää alanäytöllä."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Määritä, miten peli sovitetaan tai skaalataan ikkunaan."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Määritä, miten Sinden-pistooli määritetään."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Määritä GunConin A- ja B-painikkeiden (Justifierin Start ja Back) määritys. Oletus: ristiohjain oikea/vasen DolphinBar-Wiimotella, hiiren painikkeet muilla pistooleilla."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "Määritä guncon2:n painikkeiden määritys."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Määritä, miten kosketusnäyttö emuloidaan."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Määritä, miten Wiimotesi on yhdistetty DolphinBariin."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Määritä, käytetäänkö patchia ja missä patch-tiedostot sijaitsevat; 'AUTO' käyttää patcheja, jos ne ovat romin vieressä samalla nimellä kuin rom-tiedosto."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Määritä hiiren painikkeiden (vasen/oikea/keski) määritys, oletus on a/lataus/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "Määritä mallityyppi ja alue."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Määritä malli, oletus BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Määritä malli, oletus CPC 6128+ GX4000:lle."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "Määritä malli, oletus Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Määritä pelaajalle 1 käytettävän hiiren indeksi."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "Määritä pelaajalle 2 käytettävän hiiren indeksi."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Määritä pelaajalle 3 käytettävän hiiren indeksi."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Määritä pelaajalle 4 käytettävän hiiren indeksi."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Määritä polku mukautettuun controls.ini-tiedostoon."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "Määritä alue, käytetään tallennuksissa."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Määritä painikeyhdistelmä, jota pidetään pohjassa DualShock-ohjaimen vaihtamiseksi analogisen ja digitaalisen tilan välillä."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Määritä väripaletti, Vanha NTSC jäljittelee vanhojen japanilaisten televisioiden rumia värejä."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "Määritä liitetty laite, joka emuloi säädinlaitetta (dial)."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Määritä liitetty laite, joka emuloi poljinta."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "Määritä liitetty laite, joka emuloi sijaintipohjaista laitetta."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "Määritä liitetty laite, joka emuloi trackballia."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "Määritä liitetty laite, joka emuloi valopistoolia."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Määritä liitetty laite, joka emuloi hiirtä."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "Määritä liitetty laite, joka emuloi melaa."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Määritä liitetty laite, joka emuloi analogista suuntatikkua."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Määritä emuloitavan joystickin tyyppi."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Määritä emuloitavan koneen tyyppi."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "Määritä oikean joystickin toiminto."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "Määritä näppäinyhdistelmä diagnostiikkavalikkoon siirtymiseksi."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Määritä tärinän ja näytön heilunnan taso, ota näytön heilunta käyttöön, jos ohjain ei tue tärinää. 'AUTO' ottaa molemmat käyttöön."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Määritä kädessä olevan aseen sijainti."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Määritä ristiohjaimen määritys."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Määritä emuloitavien muistikorttien määrä."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Määritä rajattavien pikselien määrä."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Määritä ääni, jonka emuloitu mikrofoni vastaanottaa."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "Määritä osoittimen liikuttamiseen käytettävän laitteen tyyppi."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Määritä näytön tyyppi, muuttaa värejä."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Määritä emuloitavan ohjaimen tyyppi."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "Määritä pistoolien tähtäimen tyyppi."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Määritä, missä kolikko- ja start-painikkeet sijaitsevat."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Määritä, toimiiko pikakelauksen pikanäppäin päälle/pois-kytkimenä vai pitääkö sitä pitää pohjassa."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Määritä, toimiiko hidastuksen pikanäppäin päälle/pois-kytkimenä vai pitääkö sitä pitää pohjassa."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Määritä, mikä Game Boyn ääni järjestelmästä lähtee."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Määritä, mikä analogitikku ohjaa hiiren osoitinta."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "Määritä painike, joka aktivoi turbotilan; tämä ei ole painike, josta tehdään turbo."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Ratin kiertoaste, jolla saavutetaan pelin täysi ohjauskulma. 270 vastaa arcade-kaappia."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Estä kirjoitukset varattuna."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "Kokoonpanosta riippuen voi lisätä tai vähentää viivettä."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Apple II:n peliporttiin kytketty laite. Analogitikku antaa portaattoman melaliikkeen, ristiohjain menee vain täysin vasemmalle tai oikealle."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Pelaajan 2 laitetyyppi."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Vain DirectInput: käytä tätä, jos ohjaimet eivät ohjaa oikeita pelaajia."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Poista XBE-allekirjoituksen tarkistus käytöstä homebrew-pelejä käytettäessä."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Poista Xenia Edgen pelikohtaiset asetukset käytöstä, jotta RetroBatin asetukset ovat voimassa."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Poista ytimen turvaominaisuudet käytöstä, jotta jotkin homebrew-pelit voivat käynnistyä."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Poista dithering käytöstä ja käytä täyttä 8 bitin värikanavatietoa."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Poista sumutehosteet käytöstä."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Poista laitteistorenderöijä käytöstä, voi parantaa yhteensopivuutta."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Poista pikanäppäimet käytöstä ja anna ytimelle täysi pääsy näppäimistöön. Vaihda 'Scroll Lock' -näppäimellä."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Poista varjojen renderöintiin käytetyt modifier volumet käytöstä."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "Pikselivarjostimien poistaminen käytöstä voi korjata joidenkin pelien kaatumisen, älä aktivoi, ellei peli sitä tarvitse."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Poista Master Systemin FM-piiri käytöstä."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Poista Visual Pinballin valikko käytöstä: poistumisnäppäin (X) sulkee pöydän suoraan."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Poista analoginen laukaisin (oikea tikku) ja analoginen tönäisy (vasen tikku) käytöstä."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Poista kaapin kameran tarkistus käytöstä."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "Poista 'saves\mame\artwork'-kansion taideteosten tarkistus käytöstä."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "Poista ohjainsovelma käytöstä, joka ilmestyy moninpeleissä liitettyjen ohjainten valitsemiseksi."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Poista pelinsisäinen valikko käytöstä, joka avataan HOTKEY + ITÄ tai F12."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Poista tämä käytöstä keskittääksesi IR-osoittimen, kun tikku vapautetaan."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Poista tämä käytöstä parantaaksesi suorituskykyä."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Poista tämä käytöstä suorittaaksesi .bat- tai .cmd-tiedoston suoraan ilman, että RetroBat yrittää löytää sen sisältä suoritettavaa tiedostoa."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Poista tämä käytöstä määrittääksesi R2:n ja L2:n L- ja R-painikkeisiin (ei-digitaalinen)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Poista X-akselin käyttö tönäisyyn, Y-akselin luotiin ja Z-akselin laukaisimeen."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Poista varoitus käytöstä, kun käynnistetään pelejä, joita ei tueta täysin."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Poistaa ohjaimen tärinän käytöstä; oletuksena tärinä on käytössä vain, kun peli ja ohjain ovat yhteensopivia."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Poistaa ytimen tietokannan automaattiset pelikohtaiset asetukset käytöstä ja ottaa alla olevat manuaaliset korjaukset käyttöön. Ei suositella."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Poistaa liikeinterpoloinnin käytöstä, yhden kuvan verran vähemmän viivettä."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Poistaa verteksivälimuistin käytöstä. Voi korjata puuttuvan tai välkkyvän grafiikan. Voi heikentää suorituskykyä."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "Ditheringin poistaminen käytöstä voi poistaa kohinaa ja pikselöitymistehosteita."

msgctxt "game_options"
msgid "Disabling safe features can help various games such as Xenosaga, Kingdom Hearts..."
msgstr "Turvaominaisuuksien poistaminen käytöstä voi auttaa erilaisia pelejä, kuten Xenosaga, Kingdom Hearts..."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "4 Mt:n RAM-laajennuspakkauksen poistaminen käytöstä voi olla tarpeen joissakin peleissä."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Tämän ominaisuuden poistaminen käytöstä vähentää värisyvyyttä."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "Näytä MAMEn valikkoliittymä peliä ladattaessa."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "Näytä SGB-kehykset Super Game Boyta emuloitaessa."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Näytä viesti, kun saavutus avautuu. Oletuksena käytössä."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Näytä pieni osoitin kosketusnäytöllä."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Näytä kokemuspalkki vyön yläpuolella."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "LaserActive-kuvan näyttösuhde, oletuksena 4:3."

msgctxt "game_options"
msgid "Display crosshair if a lightgun is used."
msgstr "Näytä tähtäin, jos valopistoolia käytetään."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Näytä nykyiset elämä- ja manapisteet palloissa."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Näytä vahinko ja kokemus leijuvina numeroina."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Näytä tason aika, löydetyt salaisuudet ja tapetut viholliset."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Primeval Huntin toisen näytön (kosketusnäytön) näyttäminen."

msgctxt "game_options"
msgid "Display or not on-screen notifications."
msgstr "Näytä tai piilota ilmoitukset näytöllä."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Näytä näytön reuna-alueet. Ei vaikutusta F18A-lähtöön."

msgctxt "game_options"
msgid "Display the emulated framebuffer at a widescreen aspect ratio. Get best results with full 3D games."
msgstr "Näytä emuloitu kehyspuskuri laajakuvasuhteessa. Parhaat tulokset täysin 3D-peleissä."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Näytä peli 16:9-muodossa. Paras, kun PELIN KUVASUHDE on 16/9."

msgctxt "game_options"
msgid "Display the overscan regions of the screen."
msgstr "Näytä näytön overscan-alueet."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Näytä pelaajan 1 VMU:n näyttö pelin päällä."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Käynnistyksessä käytetty näyttö. Voidaan vaihtaa pelissä F7-näppäimellä (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Näytä vokseliobjektit tasaisten spritejen sijaan, kun saatavilla. Oletuksena käytössä."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Dithering ylinäytteistetyille kehyspuskuritehosteille."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "RDRAM-kehyspuskurikuviin sovellettu dithering."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Jakaa sisäisen resoluution: korkealla sisäisellä resoluutiolla suuremmat arvot suurentavat peliä. Oletus: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 on hyvin tumma peli, kasvata kirkastaaksesi kuvaa."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Kaksinkertaistaa koetun vaakaresoluution, ei yhteensopiva ylinäytteistyksen kanssa."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Skaalaa ylösskaalattu kuva alas (SSAA). Vaatii ylösskaalauksen."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Piirrä maisema radan loppuun asti sitä tukevissa peleissä (Daytona USA). Vain Model 1 ja Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Levykkeen vaihdossa käytettävä asema."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick: Robotron 2084 ja Space Dungeon oikealla tikulla. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: monipainikkeiset joystickit."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Kuvien monistaminen vaatii Vulkan-renderöijän."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Dynaaminen uudelleenkäännös. Useimmat pelit toimivat nopeammin, jotkin hitaammin."

msgctxt "game_options"
msgid "Efficient graphics filters improving the rendering of games."
msgstr "Tehokkaat grafiikkasuodattimet, jotka parantavat pelien renderöintiä."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Poistaa tekstuurien vääristymät ylösskaalauksessa."

msgctxt "game_options"
msgid "Eliminates position-dependent distortion and warping of textures."
msgstr "Poistaa sijainnista riippuvat tekstuurien vääristymät."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Emuloi Buzz!-summereita gamepadiesi avulla. Yksi ohjain kattaa 4 summeria (pelaajat 1–4), kaksi ohjainta kattaa 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Emuloi PS3:n muistin tiilitystä (tiling). Korjaa grafiikkavirheitä joissakin peleissä pienellä suorituskyvyn kustannuksella."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Emuloi puheentunnistusyksikköä (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Emuloi DJ Hero -levysoitinta gamepadiesi avulla. Vaaditaan DJ Hero 1:een ja 2:een."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Emuloi Guitar Hero Live (GHLtar) -ohjainta gamepadiesi avulla. Vaaditaan Guitar Hero Liveen."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Emuloi New 3DS:ää tai alkuperäistä 3DS:ää."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Emuloi PlayStation TV:tä paikalliseen moninpeliin (enintään 4 ohjainta). Identtisiä ohjaimia ei tueta, kosketusnäyttöpelit eivät välttämättä toimi."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Emuloi tiettyä liikeohjausta. '/' tarkoittaa toimintoa vasemmalle/oikealle tikulle."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Emuloi hiiren liikkeellä ohjattavaa spinneriä. Hiiren painikkeet on määritetty vasempaan (keltainen) ja oikeaan (punainen) painikkeeseen."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Emuloi 59,94 Hz:n NTSC-vblank-taajuutta 60 Hz:n sijaan. Korjaa ajoituksen ja äänen ajautumisen joissakin NTSC-peleissä."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Emuloi Disney Infinityn perustelinelisälaitetta."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Emuloi Game Boy Playeria ottaaksesi tärinän käyttöön yhteensopivissa peleissä."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Emuloi LEGO Dimensionsin toypad-lisälaitetta."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Emuloi Skylandersin portaalilisälaitetta."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Emuloi Video CD -korttia, vaatii mpeg_card.bin-tiedoston bios-kansioon."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emuloi vanhempien moottoreiden käyttäytymistä, jota jotkin vanhemmat modit ja demot vaativat."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Emuloidun säikeen aikaviipale. Kasvattaminen voi auttaa muutamaa peliä, pienentäminen voi tasoittaa toisia."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Emuloi LCD:n läpikuultavuustehosteita, mutta lisää liike-epäterävyyttä."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Emuloi PS3:n moninäytteistyksen asettelua. Voi korjata joitakin visuaalisia artefakteja joissakin peleissä."

msgctxt "game_options"
msgid "Emulation method used. AUTO for mixed features with max performance and compatibility."
msgstr "Käytetty emulointitapa. AUTO yhdistää ominaisuudet parhaalla suorituskyvyllä ja yhteensopivuudella."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Emulaattorin scanlinet, näkyvät vain joissakin peleissä."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Ota Dreamcastin 32 Mt:n RAM-modi käyttöön, voi vaikuttaa yhteensopivuuteen."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "Ota BIOS-käynnistys käyttöön DSi-peleille."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Ota CMS-emulointi käyttöön."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Ota digitaalinen signaaliprosessori käyttöön. Parantaa äänen tarkkuutta suurempien suorituskykyvaatimusten kustannuksella."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Ota digitaalinen signaaliprosessori käyttöön. Parantaa äänen tarkkuutta suorituskyvyn kustannuksella."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Ota Discord Rich Presence -palvelu käyttöön, Discord-tilasi näyttää pelattavat pelit."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Ota Dolby Pro Logic II -dekooderi käyttöön yhteensopivissa peleissä ja 5.1-kaiuttimilla."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Ota FidelityFX:n kontrastiin mukautuva terävöinti käyttöön."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Ota liukulukuyksikkö käyttöön, yleensä hyödyllinen myöhemmissä 3D-peleissä."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Ota Gravis Ultrasound -emulointi käyttöön."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "Ota HDR käyttöön HDR-yhteensopivilla näytöillä."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Ota IBM PS/1 Audio -emulointi käyttöön (oletuksena pois käytöstä)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Ota Just In Time -emulointi käyttöön, nopeuttaa emulointia, ei yhteensopiva syklintarkan tilan kanssa."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "Ota MAMEn sisäinen ohjauksen uudelleenmääritys käyttöön."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "Ota käyttöön MAMEn vaihtoehto, joka määrittää painikeasettelun automaattisesti pelikohtaisesti sisäisen tietokantansa perusteella."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "Ota MelonDS:n emuloitu BIOS käyttöön bios-kansion laiteohjelmistojen sijaan."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "Ota OpenGL-renderöijä käyttöön, RetroArchin ajurina on oltava OpenGL."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "Ota PAL (50 Hz) NES-emulointi käyttöön."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Ota Sega CD:n RAM-kasetti käyttöön."

msgctxt "game_options"
msgid "Enable Service button to enter settings."
msgstr "Ota huoltopainike käyttöön asetuksiin siirtymiseksi."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Ota Tandy-ääniemulointi käyttöön."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Ota ylimääräinen kehittäjä-RAM käyttöön, voi rikkoa pelejä."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Ota reunanpehmennys käyttöön, tasoittaa polygonien reunoja."

msgctxt "game_options"
msgid "Enable blargg NTSC video filters"
msgstr "Ota blarggin NTSC-videosuodattimet käyttöön"

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Ota raa'an voiman ylös-/alasskaalaus käyttöön (vain 10.8.0)"

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Ota välimuistin liittäminen käyttöön"

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "Ota pelin objektien heittämät varjot käyttöön, yhteensopiva vain OpenGL:n kanssa."

msgctxt "game_options"
msgid "Enable certain games with support for the 3Dfx Voodoo accelerator."
msgstr "Ota käyttöön tietyt 3Dfx Voodoo -kiihdytintä tukevat pelit."

msgctxt "game_options"
msgid "Enable colorization of Game Boy games."
msgstr "Ota Game Boy -pelien väritys käyttöön."

msgctxt "game_options"
msgid "Enable controller's rumble effects."
msgstr "Ota ohjaimen tärinätehosteet käyttöön."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Ota ohjaimen tärinätehosteet käyttöön. Toimii vain ajopeleissä."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Ota tähtäimet käyttöön ammuntapeleissä, (DS)-vaihtoehdot ovat yhteensopivia vain DemulShooterin kanssa."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Ota tähtäimet käyttöön ammuntapeleissä."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Ota käyttöön videotilaan perustuva mukautettu resoluutio."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Ota dynaamiset uudelleenkääntäjät käyttöön suorituskyvyn parantamiseksi."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Ota DS4:n ja DualSensen parannetut ominaisuudet käyttöön; tämä rikkoo yhteensopivuuden dinputia käyttävien emulaattoreiden kanssa, kunnes se poistetaan käytöstä."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Ota voimapalaute käyttöön tuetuilla ohjaimilla."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Ota koko näytön reunanpehmennys käyttöön Direct3D:ssä, tasoittaa polygonien reunoja."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Ota vaakasekoitussuodatin (sumennus) käyttöön."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Ota käyttöön, jos ratti työntyy poispäin keskeltä sen sijaan, että se palaisi keskelle."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Ota pelinsisäinen tähtäin käyttöön tähtäämisen helpottamiseksi."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Ota älykäs zoomaustoiminto käyttöön."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Ota ips-patchit käyttöön."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "Ota käyttöön epätarkempi mutta paremmalta kuulostava Namco 106 (mapper 19) -ääniemulointi."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Ota alla olevat manuaaliset hackit käyttöön, muuten hackit otetaan käyttöön automaattisesti."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Ota liikeohjaus (gyro) käyttöön hiirellä tai yhteensopivalla ohjaimella."

msgctxt "game_options"
msgid "Enable multitap in port 1."
msgstr "Ota multitap käyttöön portissa 1."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Ota multitap käyttöön portissa 2."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Ota progressiivinen pyyhkäisy käyttöön yhteensopivissa peleissä."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Ota run-ahead-tila käyttöön syöteviiveen vähentämiseksi."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Ota IBM Music Feature Card käyttöön (oletuksena pois käytöstä)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "Ota Master Systemin FM-piiri käyttöön."

msgctxt "game_options"
msgid "Enable the Memory Management Unit. Required for some games."
msgstr "Ota muistinhallintayksikkö käyttöön. Joidenkin pelien vaatima."

msgctxt "game_options"
msgid "Enable the On Screen Keyboard feature which can be activated with the L3 button."
msgstr "Ota näyttönäppäimistö käyttöön, sen voi aktivoida L3-painikkeella."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Ota Vita3K:n käyttöliittymässä aktivoitujen huijausten vaikutukset käyttöön."

msgctxt "game_options"
msgid "Enable the effects of the chosen Action Replay and Gecko codes for a game."
msgstr "Ota pelille valittujen Action Replay- ja Gecko-koodien vaikutukset käyttöön."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Ota Atari STE:n parannettuihin joystick-portteihin kytkettyjen Jaguar-joypadien emulointi käyttöön."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Ota hiiren käyttö kosketusnäytölle käyttöön oikean tikun sijaan."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Ota tämä käyttöön, jos XInput-ohjainten indeksit ovat vaihtuneet."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Ota tämä käyttöön, jos ohjaimessa ei ole analogisia liipaisimia."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Ota tämä käyttöön, jos sinulla on G-Sync/FreeSync-näyttö, voi aiheuttaa äänihäiriöitä."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Ota tämä käyttöön, jos Intelin grafiikkapiirin kanssa ilmenee ongelmia."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Ota tämä käyttöön, jos pelistä puuttuu grafiikkaa tai valaistus on rikki."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Ota tämä käyttöön, kun käytät mamehookeria LEDien, solenoidien, tärinän... kanssa."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Ota tämä käyttöön varjostimien käyttämiseksi, vaikka RetroBatissa ei ole asetettu varjostinta."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Ota tämä käyttöön kytkeäksesi pelaajan 1 joystickin vasempaan porttiin oikean sijaan."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Ota tämä käyttöön käyttääksesi Duckstationin tarjoamia varjostimia."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Ota tämä käyttöön käyttääksesi omia Project64:n pelikohtaisia asetuksiasi."

msgctxt "game_options"
msgid "Enable verbose mode for debugging."
msgstr "Ota yksityiskohtainen tila käyttöön vianetsintää varten."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Oletuksena käytössä (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Oletuksena käytössä, parantaa emuloidun SIO-portin tiedonsiirtoa."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Oletuksena käytössä."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Oletuksena käytössä. Poistaa ditheringin käytöstä ja pakottaa 24-bittisen värilähdön."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Oletuksena käytössä. Poistaminen käytöstä voi parantaa suorituskykyä, mutta rikkoo joitakin pelejä."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Oletuksena käytössä. Nopeammat varjostimet, voi aiheuttaa harvinaisia grafiikkaongelmia."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Oletuksena käytössä. Korjaa grafiikkavirheitä joissakin peleissä pienellä suorituskyvyn kustannuksella."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Oletuksena käytössä. Poistaa sumennuksen joistakin peleistä, mutta vähentää tarkkuutta."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Oletuksena käytössä. Korvaa pelin spritet HD-paketilla, kun sellainen on saatavilla. Uudelleenkäynnistys vaaditaan."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Oletuksena käytössä. Näytä emulaattorin omat viestit."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Oletuksena käytössä. Kun pois käytöstä, kuvanopeus on rajoitettu 60 FPS:ään."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Oletuksena käytössä. Kun pois käytöstä, peli rajoittaa kuvanopeutta."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Ottaa 60 Hz:n tilan käyttöön vähentämään kuvan repeilyä näytöillä, jotka eivät tue yli 60 Hz:n taajuutta."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Ottaa Direct3D:n automaattisen mip-karttojen luonnin käyttöön."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Ottaa WRX:n korkean resoluution käyttöön."

msgctxt "game_options"
msgid "Enables a low pass audio filter to soften the harsh sound of some games."
msgstr "Ottaa alipäästöäänisuodattimen käyttöön pehmentämään joidenkin pelien karheaa ääntä."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Ottaa sumennuksenestohackin käyttöön, epätarkempi mutta tekee peleistä vähemmän sumeita."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Ottaa käyttöön nuolinäppäimet, CTRL- ja ALT-näppäimen joystickinä ja tulipainikkeina."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Ottaa mukautetun patchauksen käyttöön."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Ottaa korkean resoluution CEL-renderöinnin käyttöön."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Mahdollistaa vaihtamisen eri videosignaalien välillä."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Tämän käyttöönotto voi aiheuttaa ongelmia 8BitDo-ohjaimille."

msgctxt "game_options"
msgid "Enabling this will downsampling to native color depth. Disabling enable output at higher color depth."
msgstr "Tämän käyttöönotto alasnäytteistää natiiviin värisyvyyteen. Poistaminen käytöstä mahdollistaa lähdön suuremmalla värisyvyydellä."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Pakottaa API-määrittelyn tiukan noudattamisen. Voi heikentää suorituskykyä joissakin peleissä. Voi korjata harvinaisia puuttuvan grafiikan ja välkynnän tapauksia."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Parantaa grafiikan tarkkuutta suurempien suorituskykyvaatimusten kustannuksella."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "Paranna eri objektien varjoja."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "Paranna 2D-tekstuurien laatua."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface."
msgstr "Paranna pintojen tekstuurien laatua."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Paranna pintojen tekstuurien laatua. Vain OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Paranna pintojen tekstuurien laatua. Vain Vulkan ja OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Tekstuureihin sovellettu parannussuodatin."

msgctxt "game_options"
msgid "Enhancement. Reduces system slowdown. Causes issues in some games."
msgstr "Parannus. Vähentää järjestelmän hidastumista. Aiheuttaa ongelmia joissakin peleissä."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Syötä isännöintiin käytettävä paikallinen UDP-portti."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Syötä palvelimen osoite."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Syötä tiedonsiirtoon käytettävän pelin romin ensimmäiset merkit."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Syötä tiedonsiirtoon käytettävän tallennustiedoston ensimmäiset merkit."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Syötä ladattava kosketusprofiili."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Ympäristön jälkikaiunta (EFX), oletuksena käytössä."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Tarkka on lähimpänä konsolia ja raskain näytönohjaimelle. Nopea on paljon kevyempi. Auto valitsee nopean heikoilla tai epävakailla näytönohjaimilla."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "Suorittaa grafiikkataustaosan toisessa säikeessä, parantaa suorituskykyä, vähentää nykimistä ja nopeuttaa varjostinten kääntämistä."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Laajenna SAMS-muistikortti 4 Mt:iin."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Konsoliin asetettu laajennuskasetti. Pelit, joiden vaatimus tunnetaan, ohittavat tämän automaattisesti."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Kokeile tätä vaihtoehtoa, jos joystickisi ajelehtii (oletuksena käytössä)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Kokeellinen, vain Windows. Suojaa pelin pinomuistin tiedot, kun emulaattori käsittelee muistipoikkeuksia. Voi korjata kaatumisia joissakin peleissä. Jätä pois päältä, ellei peli sitä tarvitse."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Lisäohjain. Jätä tyhjäksi, ellei peli pyydä sellaista."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Lisämuistikortti, vain //e-mallit. Muutama ohjelma tarvitsee enemmän kuin vakiona olevat 64 kt."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "FM Townsin hiiren herkkyys."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Nopea likimääräinen reunanpehmennys, kevyempi kuin MSAA mutta sumeampi."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Nopea voi parantaa suorituskykyä, mutta voi olla epävakaa joillakin ajureilla."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "Nopean levykelatauksen ROM. Vaatii TÄYSI ASEMAEMULOINTI -asetuksen ja JiffyDOS-ROMit kansioon 'bios\vice'. Ei käytetä kasettinauhoilla eikä kaseteilla."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Nopea on epätarkempi, järjestetty ja atominen on tarkka mutta hitaampi."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Nopeampi DSP-emulointimoottori (kokeellinen). Käytetään vain, kun DSP-EMULOINTI on käytössä."

msgctxt "game_options"
msgid "Faster loading times but can cause issues with some games."
msgstr "Nopeammat latausajat, mutta voi aiheuttaa ongelmia joissakin peleissä."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Nopeammat sektorien luvut. Kaikki ohjelmat eivät välttämättä odota sitä."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Suodata kaikki tekstuurit, myös ne, jotka peli asettaa nimenomaisesti suodattamattomiksi. Oletuksena pois käytöstä."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Lopulliseen kuvaan sovellettu suodatin."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Suodatin, jolla kuva skaalataan näytölle."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Lopullisen kuvan skaalauksessa käytetty suodatin."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Suodatin, jota käytetään, kun renderöity kuva on näyttöä suurempi."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Suodatin, jota käytetään, kun renderöity kuva on näyttöä pienempi."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "3D-tekstuureihin sovellettu suodatus."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "3D-tekstuureihin sovellettu suodatus. Vain OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Spriteihin ja 2D-elementteihin sovellettu suodatus."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Ammu jatkuvasti niin kauan kuin painiketta painetaan."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Käynnistä pistoolin rekyylimoottori jokaisella laukauksella, jos pistoolissa sellainen on. Oletuksena käytössä."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Sovita korkearesoluutioiset tai laajakuvapelit 640x480-kehykseen mustin reunoin. Hyödyllinen vain 4:3-CRT-televisiossa."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Asenna Digital Video Cartridge (vmpega.rom bios-kansioon), FMV-pelien ja Video CD:iden vaatima."

msgctxt "game_options"
msgid "Fit to the original ratio of the game."
msgstr "Sovita pelin alkuperäiseen kuvasuhteeseen."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Korjaa Demulin virhe (koko näytön tilasta poistuminen ammuttaessa vasempaan yläkulmaan) estämällä kaikki hiiren syötteet Demulin käyttöliittymään."

msgctxt "game_options"
msgid "Fix issues with upscaling in Namco games (Ace Combat, Tekken, SoulCalibur...)."
msgstr "Korjaa ylösskaalausongelmat Namcon peleissä (Ace Combat, Tekken, SoulCalibur...)."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Korjaa hidastumiset tällä emulaattorilla."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Korjaa tekstuurien vioittumisen ja syvyysongelmat AMD:n ja joidenkin Intelin näytönohjaimilla."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Korjaa porrastumisen, jota voi esiintyä ylösskaalatuissa tekstuureissa."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Korjaa pelin jumiutumisen silmukkaan käynnistyksessä."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Korjaa samantasoista geometriaa ja tatuointeja (decals) joissakin peleissä, voi rikkoa toisia."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Korjaa 2D-elementtien väliset raot."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Korjaa varjo- ja syvyysartefakteja joissakin peleissä."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Korjaa joitakin viivoihin liittyviä grafiikkavirheitä."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Korjaa tekstivirheitä joissakin peleissä."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Liukulukuyksikkö, jota jotkin 3D-pelit tarvitsevat. Oletuksena käytössä 68040:llä (sisäänrakennettu), pois käytöstä 68030:lla."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Kansio Vita3K:n tiedoille (laiteohjelmisto, asennetut pelit, tallennukset). Ohitetaan, kun Vita3K on kannettavassa tilassa (ei-tyhjä 'portable'-kansio Vita3K.exe-tiedoston vieressä)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "Joidenkin japanilaisten pelien vaatima fontti-ROM."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "Bleach Blade Battlersille."

msgctxt "game_options"
msgid "For Goemon."
msgstr "Goemonille."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "Nintendo-järjestelmissä vaihda A ja B vastaamaan Xboxin painikkeiden nimiä."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "Run Behind- ja M-bit-peleille."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "SOCOM 2:n HUDille / Spy Hunterille."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "Peleille Scarface The World is Yours ja Crash Tag Team Racing."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "SegaScope 3-D -peleissä näytä vain yksi silmä välkkyvän parin sijaan."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "Superman Returnsille."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "Tales of Destinylle."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "Tri-Acen peleille."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "ASTC-tekstuureja käyttäville peleille: vaihda keskitasoon 6 Gt:n VRAM-näytönohjaimella ja matalaan 4–2 Gt:n VRAM-näytönohjaimella."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "N64-ohjaimille, joissa on 2 liipaisinta: käytä R2:ta L2:n sijaan Z-painikkeena."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "Nostalgiaa varten. Oletuksena se näyttää BG2:n kiihdytetyltä sotasumulta (FoW)"

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "Joissakin emulaattoreissa voidaan käyttää Wiimoten näppäimistö- ja hiiriliitoksen korjaamiseen kahta Wiimotea käytettäessä."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Pakota GBC-ohjelmat, jotka muuttavat toimintaansa GBA:lla ajettaessa."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "Pakota GameBoy-tila GameBoy Colorille."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Pakota P1:n ohjaimen indeksi, voi olla hyödyllinen, jos XInput-laitteet eivät ole oikeassa järjestyksessä."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "Pakota P1:n ohjaimen indeksi, voi olla hyödyllinen käytettäessä ohjainta arcade-koneessa."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "Pakota P2:n ohjaimen indeksi, voi olla hyödyllinen käytettäessä ohjainta arcade-koneessa."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Pakota Rawinput, tätä ei pitäisi tarvita pakottaa PÄÄLLE."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Pakota CPU-syklien määrä operaatiota kohden. AUTO käyttää pelikohtaista oletusta, muuta vain, jos peli on rikki."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Pakota liipaisimille painike akselin sijaan, voi auttaa Sonyn ohjaimilla."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Pakota emulaattori koko näytön tilaan, vaikka RetroBat olisi ikkunassa"

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Pakota kuvanopeuden rajoitin."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Pakota tekstuurien näytteistystapa. Lähin naapuri pitää pikselit terävinä, lineaarinen pehmentää niitä."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Pakota syöteajuri. Oletuksena 'sdl', 'dinput' jos useat pistoolit on otettu käyttöön."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Pakota resoluutio nykyiseen näytön resoluutioon peleissä, jotka sallivat mukautetun resoluution."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Pakota Saturnin laajennuskasetti, jos automaattinen tunnistus epäonnistuu."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Pakota Saturnin alue, jos automaattinen tunnistus epäonnistuu."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Pakota stereo kaikille ROMeille."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Pakota emuloitava Game Boy -malli, jos automaattinen tunnistus epäonnistuu."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Pakota VI-virkistystaajuus. AUTO on oikea lähes kaikille peleille."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Pakota todellinen lähtökanavien asettelu. ÄÄNIKANAVAT määrittää, mitä peli näkee, tämä päättää, miten se miksataan alas laitteellesi. Jätä AUTO-tilaan, ellei lähtölaitettasi tunnisteta väärin."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Pakota backglass päälle tai pois. AUTO seuraa NÄYTTÖKOKOONPANO-asetusta (käytössä, kun NÄYTTÖKOKOONPANO ei ole asetettu)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Pakota bilineaarinen suodatustila, jota käytetään likaisten suorakulmioiden (dirty rectangles) ylösskaalauksessa."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Pakota käynnistyslaite (vain 1F/2F ja myöhemmät mallit)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "Pakota konsolin alue."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Pakota konsolin alue. Oletuksena alue tunnistetaan pelistä."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Pakota emuloitu virkistystaajuus sen sijaan, että se tunnistettaisiin ladatusta pelistä. Vaatii ytimen uudelleenkäynnistyksen."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Pakota emulaattori käyttämään tiettyä BIOS-tiedostoa."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches."
msgstr "Pakota emuloidun CPU:n taajuus. Voi vähentää hidastumista, mutta voi aiheuttaa virheitä."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Pakota emuloidun CPU:n taajuus. Voi vähentää hidastumista, mutta voi aiheuttaa virheitä. Oletus on 57 %."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "Pakota pelin alueen taajuus emulointinopeuden ongelmien välttämiseksi, jätä 'Auto', ellet huomaa nopeusongelmia."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Pakota käytettävä näppäimistö, jos useita näppäimistöjä on liitetty."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Pakota muistipankkiohjain. Muuta tätä vain, jos peli ei toimi oikein. Vaatii ytimen uudelleenkäynnistyksen."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Pakota yksiväriset näyttötilat, kuten aikakauden vihreällä tai meripihkanvärisellä näytöllä."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Pakota Wiimotejen määrä, jonka peli tunnistaa. Aseta 1:ksi peleille, jotka siirtyvät moninpeliin heti, kun useita ohjaimia on liitetty."

msgctxt "game_options"
msgid "Force the region of the system."
msgstr "Pakota järjestelmän alue."

msgctxt "game_options"
msgid "Force the rendering and display of frames to progressive mode."
msgstr "Pakota kuvien renderöinti ja näyttö progressiiviseen tilaan."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "Pakota mediatiedoston tyyppi"

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Pakota SDL-ajurin käyttö ohjaimille, aseta tämä, jos käytetään yli 4 ohjainta, sillä XInput rajoittaa 4 pelaajaan."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Pakota SDL- tai DInput-ajurin käyttö ohjaimille, aseta tämä, jos käytetään yli 4 ohjainta, sillä XInput rajoittaa 4 pelaajaan."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Pakota tietyn softlistin käyttö, ohjelmistoluettelon on oltava kansiossa 'bios\mame\hash'."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Pakota korkean tason BIOS-emuloinnin käyttö."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Pakota puhekasetti paikkaan 1, vaatii 'voice.zip'-BIOS-tiedoston."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "Pakota ratin indeksi, voi olla hyödyllinen, jos RetroBat asettaa väärän indeksin."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "Pakottaa 60 Hz:n virkistystaajuuden."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "Pakottaa konsolin PAL-tilaan NTSC:n sijaan, voi tuntua hitaalta."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Pakottaa blit- ja kuvankäsittelyn emuloinnin CPU:lla, tarkempi joissakin tapauksissa ja vaaditaan peleissä kuten GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Pakottaa raw input -ajurin käytettäessä laitteita, kuten trackballia ja spinnereitä."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Pakottaa moottorin yhteensopivuustason. Aseta MBF21 sitä vaativille WAD-tiedostoille."

msgctxt "game_options"
msgid "Full precision of 12-bit for the MCM5205 ADPCM can reduce whining noise during ADPCM playback."
msgstr "MCM5205 ADPCM:n täysi 12 bitin tarkkuus voi vähentää vinkunaa ADPCM-toiston aikana."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Koko näytön resoluutio. Oletuksena käytetään työpöydän resoluutiota."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Ohjaa kameraa täysin oikealla tikulla."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "Kega ja Gens voivat avata GST-tilatallennukset, mutta ne tallentavat vähemmän koneen tilaa."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Ajolaitekortin voimien vahvistus. Oletuksena 30 %, 200 % kaksinkertaistaa ne."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Pelin resoluutio. Suuremmat arvot näyttävät enemmän pelialuetta."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Gamepadin ohjausliikkeen laajuus ajopeleissä. Oletuksena 66 %, ei vaikutusta rattiin."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Gamepad: ohjain ja näppäimistö liikuttavat CD-i:n osoitinta. Hiiri: PC:n hiiri liikuttaa osoitinta (osoita ja napsauta -pelit ja pistoolipelit), ohjain säilyttää vain painikkeensa. Hotkey + L3 vaihtaa pelin aikana."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Gamepadeista tulee pelaaja 1, 2... ja arcade-sauvat määritetään seuraaville pelaajille."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Yleiskäyttöinen ajoitushack."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "Saksa ja ranska vaativat pelin PAL-version, japani NTSC-version."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Anna koko näppäimistö pelille (Scroll Lock palauttaa sen pikanäppäimille) ja kaappaa hiiri. Gamepad toimii edelleen."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Hyvä välimuistin emulointiongelmiin."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Grafiikkapiirisarja muille kuin AGA-malleille. Automaattinen seuraa valittua mallia, mikä on lähes aina haluttu valinta."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Pelin renderöintiin käytetty grafiikkaliitännäinen."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Grafiikan laadun esiasetus (tekstuurit, suodatus). AUTO valitsee sen muistin määrän perusteella."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Vaikuttaa suuresti CPU-suorituskykyyn."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Parantaa huomattavasti render-to-texture-tehosteilla luotujen tekstuurien laatua. Oletuksena käytössä. Poistaminen käytöstä voi estää kaatumisia mukautettuja tekstuureja käyttävissä peleissä."

msgctxt "game_options"
msgid "Greatly inscrease the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Parantaa huomattavasti render-to-texture-tehosteilla luotujen tekstuurien laatua. Oletuksena käytössä. Poistaminen käytöstä voi estää kaatumisia mukautettuja tekstuureja käyttävissä peleissä."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Ohjaimella pelatut pistoolipelit (ei valopistoolia). Suhteellinen: tikku liikuttaa kohdistinta. Absoluuttinen: tikun asento on näytön sijainti, palaa keskelle vapautettaessa."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE on nopea, LLE on tarkempi mutta vaatii DSP ROM -tiedostot."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START lähettää poistumisnäppäimen (X) Visual Pinballille sen ikkunan sulkemisen sijaan."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START lähettää poistumisnäppäimen (X) Visual Pinballille sen ikkunan sulkemisen sijaan: sen valikko avautuu (pöytä sulkeutuu asetuksella POISTA VALIKKO KÄYTÖSTÄ)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 pikatallennus, START+L3 pikalataus, START+R3 kuvakaappaus. Oletuksena käytössä."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Joidenkin pelien tarvitsema hack (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Joidenkin pelien tarvitsema hack."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Puolikkaat scanlinet jäljittelevät CRT-näyttöä. 560 x 192 antaa puhtaamman kuvan litteällä näytöllä."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Kiintolevyohjain, jota tarvitaan .hdv- ja .2mg-kiintolevykuvien ajamiseen. Muutos käynnistää koneen uudelleen."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Oletuksena piilotettu, poista käytöstä, jos peli ei käynnisty oikein."

msgctxt "game_options"
msgid "Hide in-game crosshair (game dependant)."
msgstr "Piilota pelinsisäinen tähtäin (pelistä riippuen)."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Piilota pelinsisäinen asemalli (pelistä riippuen)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Piilota kosketusnäytön osoitin, kun se on passiivinen (aikakatkaisu)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Piilota varjostinten ja PPU:n kääntämisvihjeet."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Piilota tähtäin viiveen jälkeen, kun ei tähdätä eikä ammuta. Se palaa heti, kun tähtäät uudelleen."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Piilota kuvan reunat kuten televisio tekee, tai lisää reunus (negatiiviset arvot)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Piilota jokaisella laukauksella näkyvä valkoinen välähdys."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Joidenkin Portfolio OS -toimintojen korkean tason emulointi. Voi parantaa suorituskykyä joissakin peleissä."

msgctxt "game_options"
msgid "High sound quality for games using expansion audio"
msgstr "Korkea äänenlaatu laajennusääntä käyttäville peleille"

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "Suurempi tarkkuus korjaa virheitä joissakin peleissä suorituskyvyn kustannuksella. Käytetään vain, jos SPU-dekooderiksi on asetettu Dynaaminen tai LLVM."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "Suuremmat kuvanopeudet kuvainterpoloinnilla, pystytahdistuksen rajoittamina. Voi aiheuttaa pieniä visuaalisia tai animaatiovirheitä."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "Suurempi on tarkempi mutta hitaampi."

msgctxt "game_options"
msgid "Higher values give better signal noise ratio and preservation of higher frequencies."
msgstr "Suuremmat arvot antavat paremman signaali-kohinasuhteen ja säilyttävät korkeammat taajuudet."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "Suuremmat arvot käyttävät vähemmän muistia, pienemmät toimivat nopeammin."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "House of the Dead 4:n nopeuskorjaus: CPU:n taajuus gigahertseinä (esim. 4.3). Tunnistetaan automaattisesti, jos ei asetettu."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Kuinka paljon tikkua on liikutettava, ennen kuin Amiga huomaa sen. Kasvata, jos hahmo ajelehtii itsestään."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Kuinka nopeasti mela liikkuu."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Kuinka nopeasti melat liikkuvat, kun hiirtä käytetään peliportin laitteena."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Kuinka suuri osa näytön leveydestä liikuttaa melaa ääripäästä toiseen. Pienempi arvo tekee melasta nopeamman ja antaa sen saavuttaa ääriasentonsa siirtämättä osoitinta näytön ulkopuolelle, mitä jotkin kalibrointinäytöt tarvitsevat."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Kuinka voimakkaasti tikku reagoi."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Miten TV-näyttö ja GamePad-näyttö näytetään."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Miten ohjain esitetään Amigalle."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Miten ohjain esitetään Amigalle. 'Joystick' on klassinen 2 painikkeen sauva, jota kaikki pelit ymmärtävät. 'CD32-ohjain' lisää värilliset painikkeet ja valitaan automaattisesti CD32:lla."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Miten kuva renderöidään. RGB on terävin, komposiitti- ja TV-tilat jäljittelevät aikakauden näytön värivuotoa."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Miten kuva renderöidään. Komposiittitilat jäljittelevät aikakauden näytön värivuotoa, RGB on terävin."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Miten kuva skaalataan näytölle."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Hybridi piirtää uudet varjostimet heti niiden rakentuessa. Asynkroninen voi jättää objekteja hetkeksi näkymättömiin. Synkroninen saa pelin odottamaan jokaista varjostinta."

msgctxt "game_options"
msgid "If Custom is selected it will use MesenPalette.pal as custom palette in bios directory."
msgstr "Jos Mukautettu on valittu, bios-hakemiston MesenPalette.pal-tiedostoa käytetään mukautettuna palettina."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Jos Pois, poistaa käytöstä dithering-kuvion, jota PSX käyttää värien porrastumisen torjumiseen."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Jos pois käytöstä, DualShockin voi vaihtaa DIGITAALISEN/ANALOGISEN välillä vaihtoyhdistelmällä."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Jos pois käytöstä, nämä moduulit käännetään vain tarvittaessa. Pelistä riippuen tämä voi keskeyttää pelaamisen odottamatta ja mahdollisesti usein."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Jos useita pistoolilaitteita on liitetty, aseta tämä määrittääksesi vain yhden pistoolin."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Määritä tarvittaessa käytettävä GBA-rom."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Jos kansion nimessä on 'soniccd', RetroBat käynnistää automaattisesti Sonic CD RSDK:n, käytä tätä pakottaaksesi sen."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Jos joystick on tämän kuolleen alueen sisällä, kohdistin ei liiku."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Jos käytät liiketunnistimella varustettua gamepadia, kuten DualShockia tai Switch Prota, ota tämä käyttöön liikeanturin käyttämiseksi."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Jos käytät oikeita Wiimoteja Sensor Barin kanssa, aseta Sensor Barin oikea sijainti paremman tarkkuuden saavuttamiseksi."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "Ohita Horizon OS -palvelut, voi korjata kaatumisia joissakin peleissä."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Ohita tätä kynnystä pienemmät analogitikun liikkeet."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "Ohita kansiossa 'bios\mame\ini' olevat ini-tiedostot."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Ohita pienet tikun liikkeet keskikohdan ympärillä. Kasvata, kun näytön kohdistin ajelehtii itsestään."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Ohita pöytäkohtaiset backglass-asetukset (.res-tiedosto pöydän vieressä) pelin ajaksi. Tiedosto säilytetään ja palautetaan poistuttaessa."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Ohita shadPS4:ään tallennetut pelikohtaiset asetukset ja käytä aina RetroBatin asetuksia."

msgctxt "game_options"
msgid "Improve performance at the cost of accuracy and input lag."
msgstr "Paranna suorituskykyä tarkkuuden ja syöteviiveen kustannuksella."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Paranna suorituskykyä suorittimilla, joissa on yli 4 ydintä, oletuksena käytössä."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Parantaa suorituskykyä monissa peleissä. Poistaminen käytöstä voi estää grafiikkavirheitä joissakin muissa peleissä."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "Paranna polygonien renderöintiä OpenGL-renderöijää käytettäessä."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Paranna varjostimien tarkkuutta. Poistaminen käytöstä antaa pienen nopeushyödyn, mutta voi aiheuttaa grafiikkavirheitä joissakin peleissä."

msgctxt "game_options"
msgid "Improve the loading of discs of the emulated game."
msgstr "Paranna emuloidun pelin levyjen latautumista."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements."
msgstr "Paranna resoluutiota suurempien suorituskykyvaatimusten kustannuksella."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Paranna resoluutiota suurempien suorituskykyvaatimusten kustannuksella. Vain OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Paranna resoluutiota suurempien suorituskykyvaatimusten kustannuksella. Vaatii Redream-avaimen."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Paranna resoluutiota suurempien suorituskykyvaatimusten kustannuksella. Vain Vulkan ja OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Parantaa tarkkuutta joissakin peleissä, mutta voi heikentää suorituskykyä."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Parantaa värisyvyyttä."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Parantaa suorituskykyä joissakin peleissä, mutta ohittaa kaikki EFB-pohjaiset tehosteet."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Parantaa suorituskykyä."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Parantaa suorituskykyä. Kokeellinen useilla konsoleilla."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Parantaa vakautta joissakin peleissä, mutta heikentää suorituskykyä."

msgctxt "game_options"
msgid "Improves the data loading speed."
msgstr "Parantaa tietojen latausnopeutta."

msgctxt "game_options"
msgid "Improves the emulation performance at the cost of accuracy."
msgstr "Parantaa emuloinnin suorituskykyä tarkkuuden kustannuksella."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Vain OpenGL:ssä."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "Monilevyisissä peleissä .m3u-tiedostoa käytettäessä määritä käynnistettävän levyn numero."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "Paranna tarkkuutta, voi korjata joitakin ääni- ja nopeusongelmia."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Kasvata, jos laukaukset osuvat hieman maalin ohi."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Kasvata, jos näkymä tai pelaaja liikkuu itsestään."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Kasvata, jos näkymä tai pelaaja liikkuu itsestään. Oletus on 10 %."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Kasvata 3DFx Voodoon OpenGL-resoluutiota."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Kasvata näytölle samanaikaisesti piirrettävien spritejen määrää."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Lisää RAM-muistin käyttöä ja ensimmäisen käynnistyksen aikaa, mutta vähentää levyltä lukemista käynnistyksen jälkeen."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "Arvon kasvattaminen voi aiheuttaa virheitä."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Alustaa värien renderöintikohteet emuloidusta muistista. Jotkin pelit tarvitsevat tätä renderöityäkseen oikein, voi heikentää suorituskykyä. Oletuksena pois."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Alustaa syvyyden renderöintikohteet emuloidusta muistista. Jotkin pelit tarvitsevat tätä renderöityäkseen oikein, voi heikentää suorituskykyä. Oletuksena pois."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Syötä käytettävä palvelin muodossa 'x.x.x.x:y'."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Aseta MoonSound-laajennus I/O-paikkaan."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Aseta Video9000-laajennus I/O-paikkaan."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Aseta levyke levykeasemaan, käytetään usein CD-ROM-peleissä."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Asennettu videopiiri. Automaattinen käyttää TMS9918A:ta, ellei peli vaadi F18A-päivitystä. Vaatii ytimen uudelleenkäynnistyksen."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Interpoloi äänilähdön laadun parantamiseksi."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "Tulkilla on parempi yhteensopivuus kuin JIT-dynaamisella uudelleenkääntäjällä, JIT on nopeampi."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Vaihda A/B- ja X/Y-painikkeet."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Käännä Zapperin valoanturin signaali. Joidenkin pistoolilaitteiden tarvitsema."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Käännä Zapperin liipaisimen signaali. Joidenkin pistoolilaitteiden tarvitsema."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Käännä gamepadin oikean analogitikun pystyakseli."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "Käännä tähtäimen ylös- ja alas-ohjaus."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Kääntää ylös ja alas katsomisen (gamepad ja hiiri)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Kääntää ylös ja alas katsomisen gamepadilla."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Kääntää ylös ja alas katsomisen oikealla tikulla."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Kääntää pystyakselin lennettäessä."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT on nopein, tulkki on tarkempi."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Just In Time -käännös. Nopeuttaa huomattavasti 68020- ja myöhempiä malleja. Ohitetaan 68000-koneilla ja poistetaan automaattisesti käytöstä syklintarkassa tilassa."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Pidä DOS-komentotulkki aktiivisena, kun pelistä poistutaan tai käynnistys epäonnistuu."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Säilytä tai poista pelitiedostot purkamisen jälkeen (squashfs, 7z)"

msgctxt "game_options"
msgid "Keep the CD image in memory."
msgstr "Pidä CD-kuva muistissa."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Säilytä alkuperäinen kuvasuhde kuvan venyttämisen sijaan."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Näppäin, joka avaa Amiberryn oman valikon. F12 on ainoa toimintonäppäin, jota Amigassa ei koskaan ollut, joten se on ainoa, joka jää vapaaksi."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Näppäin, joka vaihtaa ikkunan ja koko näytön välillä emuloinnin aikana."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Joystickinä käytettävät näppäimet, kun ohjainta ei ole liitetty. Nuolinäppäimillä ammutaan oikealla Ctrl:llä. Numeronäppäimistöllä ammutaan 0:lla tai 5:llä. WASD:llä ammutaan vasemmalla Altilla."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 ja R3 tekevät nykyisen hahmon erikoisliikkeet, kun peli listaa ne. Oletuksena käytössä."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = huolto, R3 = testi pelien operaattorivalikon avaamiseen. Oletuksena käytössä."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "LLVM on nopein, käytä tulkin asetuksia, jos ongelmia ilmenee."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "LLVM on nopein vaihtoehto erittäin hyvällä yhteensopivuudella. Jos ilmenee ongelmia, käytä ASMJIT-uudelleenkääntäjää."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "Kieli, jolla pelien tulee näyttää teksti."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Valikoiden ja pelin tekstien kieli. Pelissä saatavilla olematon kieli ohitetaan ja pelin asetus säilytetään."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Tekstitysten kieli. Pelissä saatavilla olematon kieli ohitetaan ja pelin asetus säilytetään."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Äänien kieli. Pelissä saatavilla olematon kieli ohitetaan ja pelin asetus säilytetään."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Suuri nopeutus moniytimisillä suorittimilla, mutta pieni määrä pelejä jumiutuu sen kanssa."

msgctxt "game_options"
msgid "Launch DemulShooter for gun games."
msgstr "Käynnistä DemulShooter pistoolipeleille."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Käynnistä MameHooker lähtöjen hallintaan."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Jätä 'Auto', ellei tunnistus epäonnistu."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Jätä oletukseksi AUTO, ellei peli vaadi tiettyä asetusta."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Jätä AUTO automaattista tunnistusta varten."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Jätä auto mukautumaan automaattisesti pelin suuntaan, käytä tätä asetusta pakottamiseen tarvittaessa."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Jätä pois päältä, ellei synkronoinnin lähteeksi ole asetettu video: vsync ja äänen synkronointi toimivat huonosti yhdessä."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Jätä AUTO-tilaan, jotta emulaattori valitsee ensimmäisen kelvollisen BIOSin kansiosta '\bios\pcsx2\bios'."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Jätä Automaattinen säilyttääksesi suorittimen, joka valitussa mallissa todella oli. Nopeampi CPU voi rikkoa pelejä, jotka perustuvat tarkkaan ajoitukseen."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Jätä Automaattinen, ellei peli tarvitse tiettyä ROMia. Tiedoston on oltava bios-kansiossa. Vaatii ytimen uudelleenkäynnistyksen."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Jätä tämä oletuksena PÄÄLLE ottaaksesi CPU:n JIT-optimoinnit käyttöön."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Jätä tämä 16:9-asentoon, ellei sinulla ole 4:3-näyttöä."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Jätä tämä oletuksena päälle, renderöinnissä käytetään useita säikeitä."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "MANUAALINEN ei muuta käyttäjän määrittämää arvoa, AUTO on 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "Vasemmasta tulee oikea ja ylhäältä alas."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Anna ALTIRRAn valita profiili pelin perusteella."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Anna RetroArchin määrittää ohjaimet omilla automaattisen määrityksen profiileillaan RetroBatin määrityksen sijaan. Ohittaa RetroBatin automaattisen määrityksen."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Anna RetroBatin yrittää hakea käynnistysjakso MAMEn hash-tiedostosta tai tiedostonimestä (sulkeet)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Anna RetroBatin yrittää hakea käynnistysjakso MAMEn hash-tiedostosta."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Anna Visual Pinballin vaihtaa itse valittuun videotilaan työpöydän resoluution muuttamisen sijaan."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Antaa MegaWiFi-kasetti-ROMin päästä verkkoosi ja internetiin. Ota käyttöön vain luotettaville ROMeille."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Antaa ytimen tahdistaa itsensä RetroArchin sijaan. Kokeile 'standard 50 Hz', jos PAL-peli toimii epätasaisesti."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Antaa emulaattorin lukea GS-muistia takaisin. Oletuksena käytössä. Poistaminen käytöstä on nopeampaa, mutta voi rikkoa joitakin grafiikkatehosteita."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Antaa vasemman tikun toimia joystickinä ristiohjaimen lisäksi."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Poista pelin kuvanopeusrajoitus, jos peli sen sallii. Mikä tahansa muu kuin alkuperäinen voi rikkoa pelin."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Yhdistä 2–4 Lynxiä ComLynx-kaapelilla yhdellä näytöllä, kullakin oma ohjain. Poistaa tilatallennukset ja saavutukset käytöstä."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Lataa mukautettu profiili ratin määritykselle."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Lataa modit (.dusk-tiedostot) pelin nimiseltä kansiolta sen vierestä tai dusklight\data\mods-kansiosta, jos sellaista ei ole."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Lataa modit kansiosta User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Lataa pelin mods-kansioon sijoitetut modit (yksi kansio ja mod.ini kutakin modia kohden). Oletuksena käytössä."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Lataa grafiikan laadun esiasetuksen (tekstuurit, suodatus, pehmeät partikkelit). Jätä AUTO-tilaan säilyttääksesi pelin asetukset."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Lataa monilevykepelin kaksi ensimmäistä levykettä asemiin 1 ja 2 kerralla pelkän aseman 1 sijaan. Tarvitaan niihin harvoihin peleihin, jotka pyytävät kahta asemaa."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Lataa korvaavat tekstuurit kansiosta Data\Assets\HDTextures\<rom> emulaattorin kansiossa."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Lataa koko levykuvan muistiin. Nopeampi lataus, suurempi RAM-käyttö."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Matala varjostinlaatu voi parantaa suorituskykyä, mutta aiheuttaa virheitä."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Pienempi tarkoittaa vähemmän viivettä, liian pieni aiheuttaa katkoksia."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Laske GS-tarkkuutta pikselien välisten rakojen välttämiseksi ylösskaalauksessa. Korjaa Wild Armsin tekstin ja SoulCaliburin haamukuvat."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Pienemmät arvot vähentävät ääniviivettä, suuremmat arvot vähentävät rätinää."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "MSAA- tai SSAA-taso."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Koneen ajoitus. 60 Hz on amerikkalainen kone, 50 Hz eurooppalainen. Muutama eurooppalainen ohjelma tarvitsee 50 Hz toimiakseen oikealla nopeudella. Muutos käynnistää koneen uudelleen."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Päämuisti. Auto käyttää mallin RAM-muistia tai pelitietokantaa. Tukemattomat koot pyöristetään ylöspäin mallin seuraavaan kokoon."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "Nopeuta warp-tilaa huomattavasti vaihtamalla SID-emulointi 'FastSID'-tilaan warpin ajaksi."

msgctxt "game_options"
msgid "Makes the emulator auto fast forward CD loading sequences."
msgstr "Saa emulaattorin kelaamaan automaattisesti nopeasti eteenpäin CD-latausjaksot."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Määritä pelaajan käyttämä ohjain manuaalisesti. Tarvitaan vain, kun RetroBat ei pysty erottamaan kahta identtistä ohjainta, esimerkiksi 2 pelaajan arcade-enkooderin kanssa, jonka Windows näkee yhtenä laitteena. Jätä muuten AUTO-tilaan."

msgctxt "game_options"
msgid "Manually select a 4 Player Adapter for some games"
msgstr "Valitse 4 pelaajan sovitin manuaalisesti joihinkin peleihin"

msgctxt "game_options"
msgid "Manually specify your choice of Neo Geo BIOS."
msgstr "Määritä valitsemasi Neo Geo -BIOS manuaalisesti."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Monet pelit tarvitsevat vain kopiot tekstuureihin, mutta jos näet mustattua tai puuttuvaa grafiikkaa, saatat joutua valitsemaan kopiot RAM-muistiin."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Määritä 8BitDo M30:n tai vastaavan ohjaimen painikkeet yksi yhteen mdControllers.json-tiedostosta."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Määritä ohjain Racing Controlleriksi, ajorattiin yhteensopimattomat pelit eivät toimi."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Määritä select lisäpainikkeeseen, hyödyllinen Zelda-pelissä, jotta tallennettaessa ei poistuta."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Määrittää liipaisimet analogitikun pystyakseliin. Hyödyllinen Gran Turismossa ja muissa ajopeleissä."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Sovittaa värit siihen, miltä ne näyttävät oikealla laitteistolla."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Matematiikkasuoritin. Vain kourallinen Amiga-pelejä käyttää sitä, ja sen lisääminen koneeseen, jossa sitä ei koskaan ollut, voi sekoittaa muutaman pelin."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Joystickin kosketuskohdistimen enimmäisnopeus."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "Tekstuurien ylösskaalaukseen käytettävien CPU-säikeiden enimmäismäärä. Käytä säikeiden kokonaismäärää miinus 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Voi aiheuttaa artefakteja joissakin peleissä."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Voi parantaa suorituskykyä joillakin moniytimisillä suorittimilla. Voi aiheuttaa hidastumista joissakin tilanteissa ylimääräisen työsäikeen kuormituksen vuoksi."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Voi vähentää nykimistä pidemmän pelin käynnistysviiveen kustannuksella."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Lomitettujen videotilojen käsittelytapa (ei koske Nintendo 64:ää)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Lomitettujen videotilojen käsittelytapa."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "Tapa, jolla levyltä luetaan tietoja: synkroninen jäljittelee alkuperäistä laitteistoa, asynkroninen voi vähentää nykimistä, esivälimuisti lataa koko kuvan alkuviiveen kustannuksella."

msgctxt "game_options"
msgid "Might fix some misaligned fog, bloom or blend effect."
msgstr "Voi korjata väärin kohdistettuja sumu-, bloom- tai sekoitustehosteita."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Jäljittelee joitakin Famicom-klooneja, jotka vaihtavat kanttiaaltokanavien duty cyclet keskenään."

msgctxt "game_options"
msgid "Mimics the display characteristics of the Game Gear and Nomad LCD panels."
msgstr "Jäljittelee Game Gearin ja Nomadin LCD-paneelien näyttöominaisuuksia."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "Mip-kartoitus on välttämätön joissakin peleissä."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Peilaa maailma vaakasuunnassa, kuten pelin Wii-versiossa."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C on useimpien pelien tukema äänikortti. Valitse Mouse Card vain ohjelmille, jotka tarvitsevat oikean Apple-hiiren, se korvaa äänikortin. Muutos käynnistää koneen uudelleen."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard on useimpien pelien tukema äänikortti. Ohitetaan //c-malleissa, joissa ei ole laajennuspaikkoja."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Pelaajavalintanäytössä esivalittu tila. Latauspeli (Download Play) vaatii alkuperäisen BIOSin ja laiteohjelmiston."

msgctxt "game_options"
msgid "Modify the coin setting to Free Play."
msgstr "Muuta kolikkoasetus ilmaispeliksi (Free Play)."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "Yksivärinen tila vaaditaan korkean resoluution peleissä (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Tarkempi CD-lohkon emulointi. Vaatii CD-lohkon ROMin ja poistaa lukunopeusasetuksen käytöstä."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "Tarkempi toiminta, mutta voi heikentää suorituskykyä. Oletuksena PÄÄLLÄ."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "Useimmat pelit käyttävät porttia 2, käytä tätä asetusta vanhoille peleille, jotka vaativat joystickin porttiin 1."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Liitä asema C: automaattisesti käynnistyksessä."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Hiiri: pelit kuten Elansar tai Defender of the Crown. Analogitikku: BattleSphere, valitse se myös pelin asetuksista."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Liikuta hiirtä ohjaimen 1 analogitikulla (L2/R2 = painikkeet). Jonkin portin on oltava asetettu hiireksi."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Liiku vasemmalla analogitikulla sekä ristiohjaimella. Oletuksena käytössä."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level."
msgstr "Moninäytteistyksen reunanpehmennyksen (MSAA) taso."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Moninäytteistyksen reunanpehmennyksen (MSAA) taso. Vain OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Moninäytteistyksen reunanpehmennyksen (MSAA) taso. Vain Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Kerroin, jota käytetään joystick-kohdistimen nopeuteen, kun osoittimen nopeutuspainiketta (oletuksena L2) pidetään pohjassa."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "Multitap on asetettava, jos pelaajia on enemmän kuin 2."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Mykistä levykeasemien mekaaninen ääni."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "EI näyttää vain vasemman silmän kuvan. Anaglyfi vaatii samanväriset 3D-lasit, rinnakkain on VR-laseille ja 3D-näytöille."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC käyttää cdi200.rom-tiedostoa, PAL käyttää cdi220b.rom-tiedostoa."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Pelin natiiviresoluutio. Oletuksena pelissä asetettu."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Tarvitaan muutamaan peliin, mukaan lukien useat osoita ja napsauta -pelit."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "Pelin aloittamiseen ei tarvita kolikkoa."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Emuloitujen levykeasemien määrä. Oikeassa Amiga 500:ssa oli vain yksi. Kaksi asemaa nopeuttaa monilevykepelejä, mutta muutama peli odottaa vain yhtä."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Kuvien määrä kunkin turbopainalluksen välillä."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Oletuksena pois. Mukautuva ei odota näyttöä, kun kuva myöhästyy."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Oletuksena pois: emulaattori toimii itsestään arcaden nopeudella (57,5 Hz). Ota käyttöön, jos kuva repeilee."

msgctxt "game_options"
msgid "Offset for the ST/UV texture coordinates."
msgstr "ST/UV-tekstuurikoordinaattien siirtymä."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "120 Hz:n tai nopeammalla näytöllä ilman G-Synciä tai FreeSynciä käytä sen suurinta virkistystaajuutta, joka on 60 Hz:n monikerta."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Oletuksena käytössä, poista käytöstä käyttääksesi 11 kHz:n äänenlaatua."

msgctxt "game_options"
msgid "On by default."
msgstr "Oletuksena käytössä."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Oletuksena käytössä. Poista käytöstä nopeuden lisäämiseksi integroiduilla näytönohjaimilla."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Oletuksena käytössä. Poista käytöstä, kun pistoolissa on oma tähtäyksensä (laser, Sinden-tähtäin)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Yksi pikseli pelin pikseliä kohden (suositeltu varjostimille)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Koskee vain, kun tekstuurien ylösskaalaus (xBRZ) on käytössä. Tätä suurempia tekstuureja ei skaalata ylös."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Yhteensopiva vain AASIA/JAPANI MVS -järjestelmän kanssa."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Yhteensopiva vain OpenGL:n kanssa, synkronoi GPU:n ja CPU:n tiukasti. Vähentää viivettä suurempien suorituskykyvaatimusten kustannuksella."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Yhteensopiva vain ohjelmistovideoajurin kanssa."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Vaikuttaa vain, kun RAJOITA FPS on käytössä. Oletus: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Vain pelien aasialaisille versioille."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Vain uusille Ikemen GO -versioille. Vulkan on kokeellinen."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Vain tätä kokoa suuremmat kehyspuskurit skaalataan ylös, voi korjata joitakin ongelmia tietyissä peleissä."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Käytä kuvanopeuden rajoitinta vain, jos peli toimii ilman sitä liian nopeasti. Jotkin pelit voivat kaatua, jos kuvanopeus on liian suuri. Jos niin käy, aseta arvoksi mikä tahansa muu kuin Pois."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Käytä tätä vain, jos sinulla on kaksi identtistä ohjainta, joita ei tunnisteta oikein. Sitoo ohjaimet sijainnin eikä nimen mukaan, mikä on epäluotettavampaa."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Käytä tätä vain ikkunan pienentämiseen, kun Windowsin asetuksissa käytetään skaalausta."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Käytetään vain, jos asetettu — P2:lle ei oleteta oletustähtäinkuvaa."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Käytetään vain, kun MIDI-lähtölaite on valittu."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Pelin ajamiseen käytetty OpenBOR-moottorin versio. Auto tunnistaa sen pelin tiedoista tai tiedostonimen [XXXX]-koontinumerosta kuten erillisessä OpenBORissa."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "OpenGL vaaditaan varjostimille ja sisäiselle resoluutiolle."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Vain OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Vain OpenGL. Korjaa mustan näytön joillakin AMD:n integroiduilla näytönohjaimilla, muutama peli renderöityy väärin."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Avaa toisen ikkunan Gamepad-näkymälle."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Valinnainen äänikortti (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) tai bassokaiutin (Gaelcon pelit). Oletuksena sekoitus, vain emolevy Star Wars Racer Arcadelle."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "Ylikellota CPU, SA-1-piiri ja Super-FX-piiri, voi vähentää hidastumista, mutta voi aiheuttaa ongelmia joissakin peleissä."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Yli- tai alikellota molemmat SH-2-suorittimet. 100 on vakionopeus."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Yli- tai alikellota emuloitu pää-CPU. Voi auttaa vakauttamaan kuvanopeutta, mutta rikkoo joitakin pelejä."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Ylikellota emuloitu 68k-piiri paremman kuvanopeuden saavuttamiseksi."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "Ohita RetroBatin gamepad-määritys käyttäjän omalla määrityksellä, joka on sijoitettu emulaattorin script-kansioon."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Ohita pöydän oletusvalaistus."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL toimii 50 Hz:llä ja on oikea lähes kaikille eurooppalaisille Amiga-peleille. NTSC toimii 60 Hz:llä ja sopii kourallisille amerikkalaisia julkaisuja."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 tunnistaa ohjaimet oman paikkanumeronsa perusteella, joka ei noudata RetroBatin pelaajajärjestystä. Automaattinen ottaa ensimmäisen löytämänsä, muuta sitä, jos väärä ohjain vastaa."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "Patchaa TOS-tiedosto käynnistymään nopeammin."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Polku kansioon, jossa AGS WinUAE sijaitsee; jos täytetty, RetroBat lisää ags-käynnistimen amiga-järjestelmään."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Polku kansioon, jossa ExoDos sijaitsee, pakollinen, jotta RetroBat voi hakea ExoDOS-pelit."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Polku kansioon, jossa ExoWin3x sijaitsee, pakollinen, jotta RetroBat voi hakea ExoWin3x-pelit."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Polku kansioon, jossa ExoWin9x sijaitsee, pakollinen, jotta RetroBat voi hakea ExoWin9x-pelit."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Pelikohtainen: jokaisella pelillä on oma 8 kt:n konsolimuistinsa, joten se ei voi koskaan täyttyä. Jaettu: yksi muisti kaikille peleille, kuten oikeassa soittimessa."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Pikselikohtainen valaistus verteksikohtaisen sijaan. Parantaa laatua joissakin peleissä."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Suorituskyvyn parannus, voi myös tuoda vakautta joihinkin peleihin kuten GT6."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Sijoita mukautettu tähtäinkuva ja valitse se alta."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Sijoita mukautettu 'crosshair.png'-tiedosto emulaattorin 'cross'-alikansioon tai valitse tiedosto alta."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Sijoita mukautettu 'crosshair.png'-tiedosto emulaattorin 'cross'-alikansioon."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: työnnä tikkua ylös noustaksesi (kaapissa noustaan tikku taaksepäin vedettynä)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "Pelaa MVS-pelejä ilman kolikoiden syöttämistä."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Soita varoitusääni, kun terveys on vähissä."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Soita VMU:n piippaukset."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Pelaa vain oikeilla Wiimoteilla, muut ohjaimet eivät toimi."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Käynnistyksessä näytettävällä pelaajavalintanäytöllä esivalittu pelaajamäärä."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Kytke RetroPadit eri portteihin, hyödyllinen 4 pelaajan sovittimille."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Kytke hiiri joystick-porttiin, tämä irrottaa kytketyt joystickit."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "Kytke lisäjoystickit portteihin 2, 3 ja 4."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "Kytke GunCon porttiin 2 käytettäväksi Die Hard Trilogyssä."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Kytkee MIDI-kortin ja lähettää sen lähdön tähän Windowsin MIDI-laitteeseen, numeroituna kuten emulaattorin MIDI-asetuksissa. EI MITÄÄN säilyttää tavallisen FM-äänen."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Osoita RetroArchin 'system'-hakemisto toiseen kansioon."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Portti 1 on aina Wii U GamePad. Wii Remote voidaan lisätä sen päälle peleille, jotka tarvitsevat sellaisen."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Light Phaserin portti. Oletuksena portti 1."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Super Scopen portti. Oletuksena portti 2."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Zapperin portti. Oletuksena portti 2."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Voi lyhentää latausaikaa pidemmän käynnistysajan kustannuksella."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "PowerPC-uudelleenkääntäjä, oletuksena käytössä ja paljon nopeampi. Poista käytöstä käyttääksesi tulkkia."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Esikäännä varjostinvälimuisti pelin käynnistyessä, jätä PÄÄLLE vähentääksesi nykimistä pelissä."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "Tarkka on tarkin, ja rento voi parantaa suorituskykyä, mutta rikkoo joitakin pelejä."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Ensisijainen alue. Peli, joka ei hyväksy sitä, palaa alueeseen, jonka se hyväksyy."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Esilataa kaikki CD-raidat RAM-muistiin."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Esilataa mukautetut tekstuurit käynnistyksessä."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Painetaan Amiberryn valikon avaamiseksi."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Painetaan Amigan nollaamiseksi."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Painetaan näyttönäppäimistön näyttämiseksi."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Estää joitakin artefakteja, mutta voi johtaa teräviin reunoihin."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Estää useiden pelaajien yhdistettyä ääntä säröytymästä."

msgctxt "game_options"
msgid "Processor model."
msgstr "Suorittimen malli."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Suorittimen malli. Oikeaa konetta nopeampi CPU voi rikkoa pelejä, jotka perustuvat tarkkaan ajoitukseen."

msgctxt "game_options"
msgid "Provider for the Adlib emulation. DEFAULT has good quality and low perf requirements."
msgstr "Adlib-emuloinnin tarjoaja. OLETUS tarjoaa hyvän laadun ja matalat suorituskykyvaatimukset."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Asettaa pelaajan 1 ohjaimen porttiin 1 portin 2 sijaan. Tarvitaan muutamaan peliin, mukaan lukien useat osoita ja napsauta -pelit."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Elämänlaatuparannukset: nopea muodonmuutos, suuremmat lompakot, nopea kiipeily, välittömät tallennukset, automaattinen tallennus, parannetut karttavalikot... Klassinen vastaa GameCube-peliä. Ei asetettu: Dusklightin valikkoasetukset säilytetään."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD NÄPPÄIMISTÖNÄ: ristiohjain lähettää nuolinäppäimet ja painikkeet SPACE / RETURN peleille, joissa ei ole joystick-tukea."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "Oletuksena juoksu, käytä juoksupainiketta kävelemiseen."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "RetroBat käyttää ReShadea kehysten ja varjostimien näyttämiseen joissakin erillisissä emulaattoreissa. POIS KÄYTÖSTÄ: kehykset näytetään sen sijaan peittoikkunalla. KÄYTÄ OMAA: RetroBat ei koskaan asenna, muokkaa tai poista ReShade-tiedostoja emulaattorikansioissa."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Lue render-to-texture-tulokset CPU:lla. Tämä voi olla tarpeen joissakin peleissä, mutta aiheuttaa synkronoinnin kesken kuvan, joten sillä on valtava vaikutus suorituskykyyn."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Lue levyä konsolin asemaa nopeammin. Kaikki pelit eivät välttämättä odota sitä."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Lue ini-tiedosto 'bios'-alikansiosta."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Lue ini-tiedosto kansiosta 'bios\mame\ini'."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "Oikean Amigan nopeus on turvallinen oletus. Turbo lataa nopeammin, mutta voi rikkoa muutamia lataajia ja kopiosuojauksia."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Reality Signal Processor -liitännäinen, pakotetaan LLE:hen, kun videoajuriksi on asetettu Parallel."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Reality Signal Processor -liitännäinen."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Suositus: lineaarinen, kun toissijaisen näytön skaala on alle 100 %."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "Uudelleenkääntäjä on nopein, tulkki on tarkempi."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "Uudelleenkääntäjä on paljon nopeampi, tulkki on hyödyllinen vain vianetsinnässä. Vaatii uudelleenkäynnistyksen."

msgctxt "game_options"
msgid "Recover significant color depth."
msgstr "Palauta merkittävästi värisyvyyttä."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "Vähennä tarkkuutta paremman suorituskyvyn saavuttamiseksi, grafiikan laatu heikkenee."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Vähennä analogisen ohjauksen nopeutta, jotkin pelit vaativat pieniä arvoja ollakseen pelattavia."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Lyhennä latausaikoja. Voi rikkoa muutaman pelin, joka perustuu levyn todellisiin ajoituksiin."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Vähennä nykimistä huomattavasti pidemmän pelin käynnistysviiveen ja suuren GPU-käytön kustannuksella."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Vähentää VRAM-käyttöä laadun kustannuksella, voi lisätä nykimistä."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Vähentää DMC-kanavaan tehtyjen suurten kirjoitusten aiheuttamia naksahduksia. Epätarkka, voi pehmentää joitakin näytteistettyjä ääniä."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Vähentää rätinää ja pätkimistä, mutta voi heikentää äänenlaatua huomattavasti hitaammilla suorittimilla, jätä AUTO poistaaksesi käytöstä."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Vähentää välkyntää."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Vähentää nykimistä ja nopeuttaa käynnistystä ensimmäisen käynnistyksen jälkeen."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Vähentää huojuvia polygoneja ja tekstuurien vääristymiä 3D-peleissä."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "ReelMagic MPEG -toiston tuki."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Täydennä vyö juomilla tavaraluettelosta."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "Päivitä muistisivujen tila GPU:n kirjoittamien tietojen käyttöönottamiseksi. (Käytä 'Team Ninja' -peleissä puuttuvien hahmomallien korjaamiseen.)"

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "NEC PAC -laiteohjelmiston alue. Japani: pac-n1.bin tai pce-lp1.bin. US: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Ensisijaisesti valittu alue monialuelevyillä."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 1."
msgstr "Määritä pelaajan 1 sivupainikkeiden asettelu uudelleen."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 2."
msgstr "Määritä pelaajan 2 sivupainikkeiden asettelu uudelleen."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Poista n pikselin reunat näytön ylä- ja alaosasta."

msgctxt "game_options"
msgid "Remove odd composite green/blue artifacting that appears on real hardware."
msgstr "Poista oikealla laitteistolla esiintyvä outo komposiitin vihreä/sininen artefaktointi."

msgctxt "game_options"
msgid "Remove the original sprites-per-scanline hardware limit."
msgstr "Poista alkuperäinen laitteiston spritejen raja pyyhkäisyjuovaa kohden."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Poista sivujen mustat palkit joistakin välianimaatioista (ultralaajat näytöt). Alkuperäisen rajauksen ulkopuoliset alueet voivat näyttää virheellisiltä."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Poista ylä- ja alaosan mustat palkit kohdistuksen, tähtäämisen, välianimaatioiden ja dialogien aikana."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Poista ammuttaessa näkyvä valkoinen välähdys."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Poistaa yhden kuvan syöteviiveen, mutta kaksinkertaistaa järjestelmävaatimukset."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Poistaa Amigan kuvan ympärillä olevat mustat reunat. Voimakkaammat asetukset leikkaavat enemmän ja voivat rajata muutaman pelin reunoja."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Poistaa kuvan välkynnän Hummerissa."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Poistaa valkoisen välähdyksen, joka näkyy, kun pelit poistavat 3D-renderöinnin käytöstä."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Renderöi N64:n natiiviresoluution monikertana. Ohittaa sisäisen resoluution asetuksen, kun ei POIS."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Renderöi Gouraud-varjostus täydellä tarkkuudella värien porrastumisen vähentämiseksi 3D-peleissä."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "Käytettävä render target -emuloinnin polku. rtv/fbo tarjoaa paremman suorituskyvyn, rov/fsi suurimman tarkkuuden."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Vektoripelien renderöintiresoluutio."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Renderöi 24-bittisillä väreillä ja poistaa ditheringin."

msgctxt "game_options"
msgid "Replace meshed transparency by real transparency."
msgstr "Korvaa verkkomainen läpinäkyvyys todellisella läpinäkyvyydellä."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Korvaa alkuperäiset tekstuurit mukautetulla tekstuuripaketilla (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack in 'bios\dc\textures'."
msgstr "Korvaa alkuperäiset tekstuurit mukautetulla tekstuuripaketilla kansiossa 'bios\dc\textures'."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack."
msgstr "Korvaa alkuperäiset tekstuurit mukautetulla tekstuuripaketilla."

msgctxt "game_options"
msgid "Replaces game's sprites by HD pack available in HdPacks bios directory."
msgstr "Korvaa pelin spritet HdPacks-bios-hakemistossa saatavilla olevalla HD-paketilla."

msgctxt "game_options"
msgid "Replaces post-processing multiple paving sprites by a single fat sprite."
msgstr "Korvaa jälkikäsittelyn useat laatoittavat spritet yhdellä suurella spritellä."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Jäljittelee oikean laitteiston alipäästösuodatinta. 'Emuloitu' seuraa koneen oman suodatinkytkimen asentoa."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Pyydä tiettyjä paikkoja, valitse yllä vaihtoehto TIETTY PAIKKA."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "BASIC-ohjelmien vaatima. Käyttää ATARIBAS.ROM-tiedostoa, jos se on olemassa, muuten sisäänrakennettua Altirra BASICia."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Vaaditaan Formula One -peleihin."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Vaaditaan peliin Paper Mario: The Thousand-Year Door."

msgctxt "game_options"
msgid "Required for certain games that use hi-res mode to produce transparency effects."
msgstr "Vaaditaan tietyissä peleissä, jotka käyttävät hi-res-tilaa läpinäkyvyystehosteiden luomiseen."

msgctxt "game_options"
msgid "Required for certain visual effects."
msgstr "Vaaditaan tiettyihin visuaalisiin tehosteisiin."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Vaaditaan, jotta taaksepäinkelauksen pikanäppäin tekee jotain."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Vaaditaan pelin käynnistämiseen ilman Cycraft-liikekaappia."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Vaaditaan Def Jam Iconin korjaamiseen."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Vaaditaan joidenkin vanhojen rom-hackien ajamiseen, jätä pois päältä kaupallisille peleille."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Vaatii vähintään '4X SSAA (JÄRJESTETTY)'. 4x-tilat vaativat '16X SSAA (JÄRJESTETTY)'."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Emuloidun videolähdön resoluutio."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "Noudata Non-Java Mode -bitin arvoja vektorioperaatioissa PPU-taustaosissa. Jos olet epävarma, älä muuta tätä asetusta. Oletuksena pois."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Joystickin kosketuskohdistimen vastekäyrä."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "RetroBat määrittää vain pelaajan 1 ohjaimen."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "RetroBat synkronoi dolphinin ja libretro-dolphinin tallennuskansiot."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "RetroBat käyttää oletuksena psxonpsp-BIOSia, ota tämä käyttöön pakottaaksesi vanhan SCPH550X-BIOS-tiedoston käytön."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Käytä uudelleen pelille rakennettua varjostinvälimuistia. Auto antaa emulaattorin päättää."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Oikean tikun vaihteenvalinta 4-vaihteisissa ajopeleissä. H-gate: viistot suunnat, kuten oikeassa vaihteistossa. Suunnat: ylös 1, alas 2, vasen 3, oikea 4. L1/R1 vaihtavat aina alas/ylös."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Kierrä näyttöä ja ohjausta. Oletuksena tunnetut pelit kierretään automaattisesti. MANUAALINEN: SELECT vaihtaa kiertoa."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "Kierrä näyttöä pystypeleissä, otetaan käyttöön mega-bezel-kehysten kanssa."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Kierrä näyttöä pystypeleissä."

msgctxt "game_options"
msgid "Rotate display for vertical screen."
msgstr "Kierrä näyttöä pystynäyttöä varten."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "Kierrä näyttöä, tämä voi olla hyödyllinen tietyissä peleissä, jotka tarvitsevat pystynäytön."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Kierrä etupainikkeita asettelun muuttamiseksi."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Kierrä pelikenttänäytön Windows-näyttöä pelaamisen ajaksi, palautetaan poistuttaessa (Visual Pinball 10.8 ja uudemmat)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Kierrä lähtöä pystyammuntapeleille."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Heilautuksen ääripäissä sovellettava kierto."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Toimi enimmäisnopeudella, kun CD-ROM-peli latautuu pysähtyneellä, äänettömällä näytöllä."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Toimi enimmäisnopeudella, kun levykettä tai kasettinauhaa ladataan eikä ääntä toisteta. TÄYSI ASEMAEMULOINTI vaaditaan levykkeille."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Toimi alkuperäisellä 57,524 Hz:n taajuudella 60 Hz:n sijaan. Voi nykiä 60 Hz:n näytöllä."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Juoksu oletuksena, juoksupainike kävelee. Oletuksena käytössä."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Juoksu oletuksena, juoksupainike kävelee. Kuluttaa kestävyyttä yksinpelissä."

msgctxt "game_options"
msgid "Run games faster. A powerful option for gaining performance that has no downsides some of the time. May cause various random issues caused by splitting the CPU and GPU threads onto different cores."
msgstr "Aja pelejä nopeammin. Tehokas vaihtoehto suorituskyvyn parantamiseen, jolla ei usein ole haittoja. Voi aiheuttaa erilaisia satunnaisia ongelmia, jotka johtuvat CPU- ja GPU-säikeiden jakamisesta eri ytimille."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "Aja järjestelmää G7400-BIOSilla ja -ominaisuuksilla."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Aja GPU:ta ja DSP:tä nopeammin. Voi nostaa 3D-pelien kuvanopeutta, mutta voi aiheuttaa virheitä."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Aja kahta yhdistettyä Game Gearia rinnakkain. Pelaajat 1 ja 2 ohjaavat näyttöjä 1 ja 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Juokse pitämättä juoksupainiketta pohjassa."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "Suorittaa 'jgenesis-gui.exe'-tiedoston cli-version sijaan."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "Oletuksena SDL-gamepad: se lukee gamepadit vakioasettelulla ja muut laitteet (ratit, vaihteenvaihtajat, arcade-enkooderit) raakapainikkeillaan. SDL lukee kaikki laitteet raakana."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT käyttää RetroBatin mukana toimitettua Roland SC-55 -soundfontia."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "SSAA tarjoaa paremman laadun suorituskyvyn kustannuksella."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "VENYTÄ täyttää koko näytön ja poistaa kehykset käytöstä."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Tallenna pelin tila poistuttaessa ja palauta se seuraavalla käynnistyskerralla (yksi tiedosto peliä kohden)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "Tallennukset menevät saves-kansiossa olevaan kopioon, alkuperäistä kuvaa ei koskaan muuteta. Nollaus aloittaa alkuperäiseltä levykkeeltä (vanha kopio säilytetään .bak-tiedostona)."

msgctxt "game_options"
msgid "Saves the hiscores in supported games."
msgstr "Tallentaa ennätyspisteet tuetuissa peleissä."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Näytön tilarivin skaala."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Skaalaa kuvaa vain kokonaisluvuilla terävien pikselien saavuttamiseksi."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Skaalaa kuvaa vain kokonaisluvuilla terävien pikselien saavuttamiseksi. Vain koko näytön 1080p tai 4K 16:9-näytöllä, pienellä rajauksella ylhäältä ja alhaalta."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Skaalaa X-koordinaatit suhteessa näytön keskikohtaan. Pienennä tätä, jos laukaukset osuvat reunoilla liian kauas tähtäimestä."

msgctxt "game_options"
msgid "Scales the dithern pattern to the resolution scale of the emulated GPU."
msgstr "Skaalaa dithering-kuvion emuloidun GPU:n resoluutioskaalaan."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "Scanlinet eivät ole yhteensopivia HQ- tai xBRZ-varjostimien kanssa."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Kuvaputken scanlinet, varjomaski ja fosforin hehku."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "Näytön kierto ei ole yhteensopiva vaaka-asettelun kanssa."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Omalla näytöllä olevaan DMD:hen käytettävä näyttö, sama numerointi kuin NÄYTÖN INDEKSI. AUTO käyttää pienintä jäljellä olevaa näyttöä. Vaatii NÄYTTÖKOKOONPANO-asetuksen 3 näytöllä."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Backglassiin käytettävä näyttö, sama numerointi kuin NÄYTÖN INDEKSI. AUTO käyttää suurinta muuta näyttöä kuin pelikenttää. Vaatii NÄYTTÖKOKOONPANO-asetuksen."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Pelien näyttämiseen käytettävä näyttö (0 = ensisijainen näyttö). AUTO antaa emulaattorin valita näyttönsä."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Flipperin käyttämät näytöt (Visual Pinball 10.8 ja uudemmat). Backglassin ja DMD:n sijainnit lasketaan sitten automaattisesti. Ei asetettu: käytetään SCREENRES-arvoja."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Flipperin käyttämät näytöt. Backglassin ja DMD:n sijainnit lasketaan sitten automaattisesti. Ei asetettu: 1 näyttö."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "Kirjoita arvo 0xCD kaikkeen varattuun keon muistiin."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "Toinen joystick voi olla ristiriidassa hiiren kanssa."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Valitse 'PELIKOHTAINEN' käyttääksesi pelikohtaista cfg-tiedostoa kansiossa emulators\psxmame\ctrlr."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Valitse Amstradin kuvaputkiohjaimen (CRTC) tyyppi."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Valitse emuloitava Amstrad-malli."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Valitse hiiri tai joypad pelin virtuaalisen osoittimen ohjaamiseen."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Valitse EI poistaaksesi tekstuurivälimuistin käytöstä."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "Valitse BigPemu-varjostin, mahdollista vain, kun RetroBatin varjostimiksi on asetettu 'EI MITÄÄN'."

msgctxt "game_options"
msgid "Select a bilinear filtering method."
msgstr "Valitse bilineaarinen suodatustapa."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Valitse käytettävä suodatin."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Valitse käytettävä varjostin."

msgctxt "game_options"
msgid "Select a video format for output."
msgstr "Valitse lähdön videomuoto."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Valitse eri ohjainasettelujen välillä."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "Valitse käytettävä ohjainasettelu, kun käytetään 'DYNAAMINEN PROFIILI' -vaihtoehtoa."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Valitse näytön kulma, johon tatuointi ilmestyy."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Valitse käytettävä tehoste, tällä ei ole vaikutusta varjostimia käytettäessä."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Valitse etupainikkeiden asettelu."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Valitse portti, johon GBA-rom asetetaan, oletus 2."

msgctxt "game_options"
msgid "Select method used to emulate the FM synthetiser."
msgstr "Valitse FM-syntetisaattorin emulointitapa."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Valitse emuloitava malli."

msgctxt "game_options"
msgid "Select palette for colorizing GB games when COLORIZATION is set to 'internal'."
msgstr "Valitse paletti GB-pelien väritykseen, kun VÄRITYS on asetettu tilaan 'SISÄINEN'."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Valitse käytettävä varjostin, yhteensopiva vain 'bgfx'-videoajurin kanssa."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Valitse käytettävä varjostin, yhteensopiva vain 'openGL'-videoajurin kanssa."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Valitse vaihteenvaihtotila BattleGear4Tunedille."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "Valitse GPU-liitännäinen; RetroBatin asetukset eivät toimi muilla kuin oletusliitännäisellä, ne voidaan määrittää emulaattorikansiosta config.exe-ohjelmalla."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Valitse IPL-BIOS pelin käynnistämiseen sen alueen mukaan. Vaatii tiedostot 'IPL_JAP.n64', 'IPL_USA.n64' ja 'IPL_DEV.n64' kansioon bios\Mupen64plus."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Valitse laite, josta X- ja Y-koordinaatit luetaan."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "Valitse varjostimille käytettävä ajuri bgfx-videoajuria käytettäessä."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "Valitse ohjaimeen lisättävä lisälaite."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Valitse kuvien esitystila."

msgctxt "game_options"
msgid "Select the graphics plugin used by the emulator. Depends on hardware compatibility."
msgstr "Valitse emulaattorin käyttämä grafiikkaliitännäinen. Riippuu laitteiston yhteensopivuudesta."

msgctxt "game_options"
msgid "Select the keyboard layout."
msgstr "Valitse näppäimistöasettelu."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Valitse valaistusmalli, vanha tila on vähiten vaativa näytönohjaimelle."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Valitse emuloitava kone."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Valitse pelaajalle määritettävä profiili."

msgctxt "game_options"
msgid "Select the soundfont file or interface used for MIDI output."
msgstr "Valitse MIDI-lähtöön käytettävä soundfont-tiedosto tai liitäntä."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "Valitse Transfer Pakin lähdejärjestelmä GB:n ja GBC:n välillä."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "Valitse konsolin tyyppi."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "Valitse näytön rajauksen tyyppi. Käytä EMUSCV-arvoa alkuperäisen konsolin näyttövirheiden korjaamiseen."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "Valitse pistoolin tyyppi pelin mukaan."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Valitse videotila (kaapelin tyyppi)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Valitse, mihin kolikko- ja start-painikkeet määritetään rattia käytettäessä."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Valitse, mihin testi- ja huoltopainikkeet määritetään rattia käytettäessä."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Valitse, onko vahvistuspainike risti vai ympyrä."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "Valitse sisäisesti käytettävä äänimoottori."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Valitse käytettävä värisuodatin."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Valitse käytettävä grafiikkarajapinta tekstuurirenderöijää käytettäessä."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Valitse emuloitava joystick (ei yhteensopiva MASTER COMPACTin kanssa)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Valitse emuloitava joystick."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "Valitse näyttö, joka näytetään hybridiasettelua käytettäessä."

msgctxt "game_options"
msgid "Selecting GBA unlocks extra features in certain GBA enhanced GBC games."
msgstr "GBA:n valitseminen avaa lisäominaisuuksia tietyissä GBA-parannetuissa GBC-peleissä."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Lähetä MAMElle romin koko polku pelkän ROMin nimen sijaan."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Lähetä lamppujen ja ajolaitekortin lähdöt ulkoisille työkaluille (MAMEHooker...) Windows-viesteillä."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Lähetä lamppujen ja pistoolin rekyylin lähdöt ulkoisille työkaluille (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Lähetä lamppujen, pistoolin tärinän ja ajolaitekortin lähdöt ulkoisille työkaluille (Hook Of The Reaper, QMamehook...) MAMEn verkkoprotokollalla."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Emuloidun spinneriohjaimen herkkyys."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Aseta oletus-ISO käytettäväksi joidenkin homebrew-pelien kanssa."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Aseta pelaajan 1 ohjaimen oletusmääritys."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Aseta pelaajan 2 ohjaimen oletusmääritys."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Aseta ohjaimen oletusmääritys."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Aseta aktivoidun sisällön lisenssimaski (KAIKKI LISENSSIT on yleensä huono ajatus, voi johtaa määrittelemättömään toimintaan)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content."
msgstr "Aseta renderöidyn sisällön skaalaussuodatin."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Aseta renderöidyn sisällön skaalaussuodatin. FSR vaatii Vulkanin."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Aseta renderöidyn sisällön skaalaussuodatin. Vain OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Aseta Atari 2600:n vaikeustasokytkin."

msgctxt "game_options"
msgid "Set the adress, interrupt, low 8 bit and high 16 bit DMA."
msgstr "Aseta osoite, keskeytys, matala 8 bitin ja korkea 16 bitin DMA."

msgctxt "game_options"
msgid "Set the amount of extra columns to draw for widescreen."
msgstr "Aseta laajakuvaa varten piirrettävien lisäsarakkeiden määrä."

msgctxt "game_options"
msgid "Set the aspect ratio of the FMV cinematics."
msgstr "Aseta FMV-välianimaatioiden kuvasuhde."

msgctxt "game_options"
msgid "Set the behavior of the start menu when autostarted game exit."
msgstr "Aseta käynnistysvalikon toiminta, kun automaattisesti käynnistetty peli suljetaan."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Aseta mikrofonipainikkeen toiminta."

msgctxt "game_options"
msgid "Set the bottom screen as prominent."
msgstr "Aseta alanäyttö hallitsevaksi."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Aseta konsoli laajakuvaan peleille, jotka tukevat sitä."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Aseta isännän virkistystaajuus."

msgctxt "game_options"
msgid "Set the volume of the emulated floppy sound."
msgstr "Aseta emuloidun levykeäänen äänenvoimakkuus."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Aseta tämä peleille, jotka vaativat ohjaimen porttiin 2."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Ota tämä käyttöön käytettäessä useita pistooleja. Oletuksena käytössä, jos useita pistooleja löytyy eikä syöteajuriksi ole asetettu 'sdl'."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Aseta tämä vain käytettäessä oikeaa Balance Boardia."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Aseta tämä sijoittaaksesi mikrofonin paikkaan B."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Aseta tämä 'PÄÄLLÄ'-tilaan sulkeaksesi Steamin tai Epic Games Launcherin, kun pelistä poistutaan."

msgctxt "game_options"
msgid "Set this to effectively halve monitor refresh rate."
msgstr "Aseta tämä puolittaaksesi näytön virkistystaajuuden käytännössä."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Aseta tämä kytkeäksesi GunConin porttiin 2, käytetään tietyissä Die Hard -versioissa."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Aseta tämä käyttääksesi alkuperäistä PSX-gamepadia DualShockin sijaan."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Aseta KYLLÄ palataksesi vapaalle ajopeleissä, kun vaihteenvaihtonäppäin vapautetaan."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Asettaa emuloidun nestekidenäytön kirkkauden siirtymän."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Asettaa emuloidun nestekidenäytön kontrastitason."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Asettaa PowerPC:n taajuuden megahertseinä. 0 (oletus) käyttää pelikortin taajuutta."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Asettaa PowerPC:n taajuuden megahertseinä. AUTO käyttää pelilaitteiston taajuutta (vain Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "Asettaa PowerPC:n taajuuden megahertseinä. Oletus on 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Asettaa gamepadin analogitikkujen kuolleen alueen, kun syötelaitteen tyypiksi on asetettu 'GAMEPAD KLASSINEN' tai 'GAMEPAD MODERNI'."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Asettaa gamepadin analogitikkujen kuolleen alueen."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Asettaa gamepadin analogisten liipaisimien kuolleen alueen."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Asettaa analogitikkujen kuolleen alueen. Käytetään vain 'GAMEPAD MODERNI' -ohjaintyypin kanssa."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Asettaa pelaajan ohjaintyypin."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Asettaa analogitikkujen herkkyyden."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "Asetus 0 tarkoittaa, että kaikki raportoidaan peitetyksi, vaaditaan Forza Motorsport 4:ään."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Asetus 1 voi parantaa suorituskykyä."

msgctxt "game_options"
msgid "Setting this too high may cause sample clipping."
msgstr "Liian suuri arvo voi aiheuttaa näytteiden leikkautumista."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Pikselien muoto: neliö tai kuten alkuperäisellä näytöllä."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "CRT-varjostimen piirtämän varjomaskin muoto. Käytetään vain, kun varjostimeksi on asetettu CRT-maski."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Oletuksena jaettu CMOS kaikelle sisällölle tai yksi peliä kohden (parempi verkkopeliin)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "FidelityFX CAS:n soveltama terävöinnin voimakkuus. Käytetään vain, kun skaalaussuodattimeksi on asetettu FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Lyhyet viestit näytöllä (tila tallennettu...). Oletuksena käytössä."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Näytä Dolphinin käyttöliittymä pelinäytön lisäksi."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "Näytä FPS-peittokuva pelissä."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Näytä Ryujinxin vianetsintäkonsoli."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Näytä ohjauskuva kehyksen päällä."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Näytä ilmoitus, kun ohjain liitetään tai irrotetaan."

msgctxt "game_options"
msgid "Show core specific notifications."
msgstr "Näytä ydinkohtaiset ilmoitukset."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Näytä emulaattorin käyttöliittymä."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Näytä emulaattorin ilmoitukset, oletuksena käytössä (AUTO)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Näytä emulaattorin ilmoitukset."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Näytä pelin tiedot Craftin vasemmassa yläkulmassa."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Näytä tietoja varjostinten kääntämisestä."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Näytä nykyisen näyttöasettelun tiedot oikeassa yläkulmassa."

msgctxt "game_options"
msgid "Show notifications."
msgstr "Näytä ilmoitukset."

msgctxt "game_options"
msgid "Show or crop overscan. 'Auto' will try to adapt to game, cropping empty areas."
msgstr "Näytä tai rajaa overscan. 'Auto' yrittää mukautua peliin rajaamalla tyhjät alueet."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "Näytä tai piilota RetroArchin asetukset. 'Auto' on suositeltu asetus."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Näytä suorituskykytilastojen peittokuva pelissä."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Näytä varjostinten kääntämisen ilmoitukset."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Näytä vaakareunat. AUTO rajaa ne pelin käyttämään alueeseen, paras yhdessä PISTEKELLON PAR -asetuksen kanssa."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Näyttää Amigan näppäimistön näytön alaosassa ohjaimella kirjoittamista varten. Vaihda sitä määritetyllä painikkeella, liiku ristiohjaimella tai tikulla ja paina toista painiketta kirjoittaaksesi näppäimen."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Näyttää luodinjäljet seinissä, joihin laukaukset osuvat."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Näyttää aseman toiminnan ja suorituskykytiedot kuvan päällä."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "Näyttää laajennetut PAL CRT -rivit, mutta ne ovat yleensä tyhjiä useimmissa peleissä."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Näyttää levykkeiden nimet, asemien merkkivalot ja nopeuden ikkunassa ja koko näytön tilassa."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Näyttää WHDLoadin määritysnäytön, kun peli tukee sitä."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Näyttää WHDLoadin kehotteen ja odottaa painikkeen painallusta ennen pelin alkua. Oletuksena pois, jotta peli käynnistyy suoraan."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Kutista/laajenna tatuointi sopimaan kehyksen reunan sisään."

msgctxt "game_options"
msgid "Significantly improves performances for CPU with 3+ cores."
msgstr "Parantaa merkittävästi suorituskykyä suorittimilla, joissa on 3 tai useampia ytimiä."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "Simuloi CRT-fosforin haamukuvatehosteita. 'Yksinkertainen' sekoittaa nykyisen ja edellisen kuvan suhteessa 50:50."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "Simuloi LCD-näytön haamukuvatehosteita."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Simuloi PowerVR2-näytönohjaimelle ja analogisille videosignaaleille ominaisia tehosteita."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simuloi Game Boy Colorin LCD-näytön värejä."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "Simuloi CRT-haamukuvatehostetta, voidaan käyttää välkynnän välttämiseen."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Simuloi haamukuvaa, voi auttaa vähentämään välkyntää."

msgctxt "game_options"
msgid "Simulates stereo output."
msgstr "Simuloi stereolähtöä."

msgctxt "game_options"
msgid "Single Field applies a de-interlacing filter, Double Field mimics the original hardware."
msgstr "Yksi kenttä käyttää lomituksenpoistosuodatinta, kaksoiskenttä jäljittelee alkuperäistä laitteistoa."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Valikoiden ja paneelien koko. Peli rajoittaa sen suurimpaan sisäiseen resoluutioon mahtuvaan skaalaan."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Pelin pikselien koko: suuremmat arvot lähentävät ja näyttävät pienemmän osan kartasta. Oletus: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "Suurimman näytön koko hybridinäyttöasettelua käytettäessä."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Toissijaisen näytön koko suhteessa ensisijaiseen näyttöön (vain ylä/ala-asettelut)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Ikkunan koko, kun ei olla koko näytön tilassa."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Kahden emuloidun näytön kokosuhde."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "Ohita VBI, kun viivettä havaitaan, auttaa äänen pätkimiseen, kun emulointinopeus laskee."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Ohita edellisen kanssa identtisen kuvan piirtäminen. Voi parantaa suorituskykyä."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Ohita kuvia äänen rätinän välttämiseksi hitailla laitteilla."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Ohita kuvia suorituskyvyn parantamiseksi nykivän liikkeen kustannuksella."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Ohita käynnistyksessä 60 sekunnin odotus muille kaapeille. Poista käytöstä usean kaapin peliä varten."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "Ohita BIOSin käynnistyslogo."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Ohita käynnistystarkistus, joka estää pelin käynnistymisen."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Ohita laitteistotarkistukset käynnistyksessä (kamera, ohjauspyörä, kortinlukija)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Ohita pitkä ohjausmoottorin alustus käynnistyksessä. Valitse pelisi revisio."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Ohita levykeaseman mekaaninen odotusaika. Lataus on paljon nopeampaa, itse levyke luetaan edelleen täsmälleen kuten alkuperäinen."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Ohita aloitusvideot ja logo."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Ohita aloitusvideot."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Ohita ohjausmoottorin alustus käynnistyksessä."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Ohita videot/FMV:t."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "Ohittaa pintojen piirtämisen vasemmalle ja oikealle määritetyllä alueella."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Ohittaa sisältöä ladattaessa näytettävän BIOSin käynnistysanimaation."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Ohittaa sisältöä ladattaessa näytettävän BIOSin käynnistysanimaation. Poista käytöstä päästäksesi PS2:n järjestelmäasetuksiin ja muistikorttien hallintaan."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Ohittaa BIOSin käynnistysanimaation sisältöä ladattaessa."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Paikka, johon levykuvat liitetään. AUTO valitsee sen kuvan tyypin perusteella. Muuta vain, jos peli kieltäytyy käynnistymästä."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Hitaampi, mutta vaaditaan muutamassa pelissä, jotka riippuvat välimuistin toiminnasta."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Pehmennä 3D-tekstuureja."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Tasoittaa ohjauksen muutoksia. Tarvitaan gamepadia tai näppäimistöä käytettäessä."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Tasoittaa reunat varjostimella, pehmentää kuvaa hieman."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Tasoittaa Paula-piirin tuottamaa ääntä. 'Sinc' on hienostunein ja vaativin."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Pehmentää gamepadin ohjausta ajopeleissä. Oletuksena voimakas, ei vaikutusta rattiin."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Jotkin SPU-vaiheet ovat herkkiä kilpatilanteille, ja rajoitetun määrän salliminen kerrallaan auttaa lievittämään suorituskyvyn pysähdyksiä. Pienempi arvo voi parantaa suorituskykyä ja vähentää nykimistä joissakin peleissä."

msgctxt "game_options"
msgid "Some games accept input from port 2 instead of port 1."
msgstr "Jotkin pelit hyväksyvät syötteen portista 2 portin 1 sijaan."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Jotkin pelit eivät lataudu, jos järjestelmä käynnistetään CD asetettuna. 'KYLLÄ' asettaa CD:n käynnistysanimaation aikana."

msgctxt "game_options"
msgid "Some games have graphic and/or speed issues without Cycle-exact."
msgstr "Joissakin peleissä on grafiikka- ja/tai nopeusongelmia ilman syklintarkkaa tilaa."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Jotkin pelit tarvitsevat tietyn näppäimistön näppäimen joihinkin toimintoihin; määritä näppäin, joka määritetään pelaajan 1 ohjaimen SELECT-painikkeeseen."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Jotkin pelit vaativat käännetyn akselin pistooleille."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Jotkin pelit vaativat Game Drive -laajennuksen."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Jotkin pelit vaativat ohjaimen toisessa portissa kranaattien heittämiseen."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Jotkin vaihdekepit liitetään tietokoneeseen eri laitetunnuksella kuin ratti, esimerkiksi Thrustmasterin kepit."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Jotkin homebrew-ohjelmat ja ROM-hackit vaativat tietyn käynnistyksen RAM-kuvion. Uudelleenkäynnistys vaaditaan."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be disabled."
msgstr "Jotkin homebrew-ohjelmat tai rom-hackit vaativat tämän vaihtoehdon pois käytöstä."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Jotkin homebrew-ohjelmat tai rom-hackit vaativat tämän vaihtoehdon käyttöön."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "MIDI-musiikin äänilähde. MT-32-vaihtoehdot vaativat vastaavat Rolandin ROMit bios-kansioon."

msgctxt "game_options"
msgid "Space/Enter/Fire works as WHDLoad start button."
msgstr "Välilyönti/Enter/Tuli toimii WHDLoadin aloituspainikkeena."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Määrittää, miten reaaliaikakellon emuloinnin tulee toimia tietyissä peleissä."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Määrittää, mitä lisälaitetta käytetään ääni-CD:n toistoon patchatuissa MD-peleissä."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Määritä käyttöön otettava IPS-patch; jos ei asetettu, käytetään kaikkia ips .ini -tiedostossa määritettyjä patcheja."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Määritä ylösskaalauksessa käytettävä suodatin."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Määritä kehyksen polku."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Määritä laiteohjelmistotiedoston polku."

msgctxt "game_options"
msgid "Specify the Amiga system model to emulate."
msgstr "Määritä emuloitava Amiga-järjestelmämalli."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Määritä emuloitava tietokonemalli."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "Määritä videon renderöintitapa. Tarkka on täsmällisin mutta hitaampi, hyvä ja nopea ovat nopeampia, mutta voivat epäonnistua joissakin peleissä."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Puhemoduuli asennettuna."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Nopeushack, mutta ei välttämättä yhteensopiva joidenkin pelien kanssa."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Nopeushack, voi auttaa hitaita pelejä virheiden kustannuksella."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Nopeushack."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Analogitikkuhiiren nopeus."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Emuloidun Amiga-hiiren nopeus."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Vasemmalla tikulla liikutettavan hiiren osoittimen nopeus."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Nopeuta GD-ROMin latausta, voi rikkoa joitakin pelejä."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Nopeuta levykkeen latausta. Voi rikkoa joitakin kopiosuojattuja pelejä."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Nopeuttaa levykkeen käyttöä latausaikojen lyhentämiseksi."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Jakaa renderöinnin useille CPU-säikeille. Hyödyllinen vain korkeilla sisäisillä resoluutioilla."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Palauta ratti jousella keskelle, kun peli ei ohjaa voimapalautetta, kuten arcade-kaapin mekaaninen jousi."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Vakiolevykeohjainkortti."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Käynnistä suoraan Commodore 64 -tilaan."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Käynnistä ohjain tikut valmiiksi käytössä sen sijaan, että pelissä pitäisi painaa ANALOG-painiketta."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Käynnistä levy suoraan PLAY CD-I -valikossa odottamisen sijaan. Oletuksena käytössä."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Käynnistä peli testitilassa. Testi: näppäin 0 tai R3, huolto: näppäin 9 tai L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Käynnistää Outrun 2 SP SDX:n ilman kaapin tarkistuksia (ajolaitekortti ja torni)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Käynnistää Wii-valikon (valikon on oltava asennettuna Dolphiniin)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Ohjausakselin kuollut alue ohjaimille tai itsestään keskittymättömille rateille."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Tallenna BC1-tekstuurit 16-bittisinä. Säästää videomuistia pienellä laadun kustannuksella."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Ohjaimen tärinän voimakkuus. Oletuksena 60 %."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Pistoolin rekyylimoottorin voimakkuus. Oletuksena 60 %."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Venytä valikot ja 2D-näytöt näytön koko leveydelle."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Venytä pikseleitä pystysuunnassa kuten alkuperäisessä DOS-pelissä 4:3-näytöllä. Oletus: käytössä."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Venytä kuva täyttämään näyttö kuvasuhteesta välittämättä."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Venytä kuva koko näytölle sen sijaan, että säilytettäisiin aikakauden näytön muoto."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Studio: oikean soittimen TV-tasot, musta näyttää tummanharmaalta PC:n näytöllä. Täysi alue: syvä musta."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Ylinäytteistä kehyspuskuritehosteet, voi aiheuttaa artefakteja."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Surround toistaa neljän kaiuttimen Model 3 -kaappien (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) takakaiuttimet takakaiuttimista. Muut pelit pysyvät stereona."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Vaihda mela 1 ja mela 2 keskenään, tarvitaan muutamaan peliin, jotka odottavat akselien olevan toisin päin."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Vaihda ohjaimen A- ja B-painikkeet keskenään."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Vaihda ohjaimen A/B- ja X/Y-painikkeet keskenään."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Vaihda TV- ja GamePad-näytöt keskenään rinnakkain-, ylä/ala- ja kuva kuvassa -asetteluissa."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Vaihtaa Amigan kaksi porttia keskenään. Tarvitaan muutamaan peliin, mukaan lukien useat osoita ja napsauta -pelit."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Vaihda pistoolien indeksit pelaajan 1 ja pelaajan 2 välillä."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Ota käyttöön käyttääksesi RetroBatin 'saves\switch'-kansiota Citronin ja Edenin tallennuksille (emulaattorikansion sijaan)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Vaihda pelaajan 1 ohjaintyypiksi ei mitään, jos oikeita näppäimistösyötteitä ei lueta."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Ota tämä käyttöön aktivoidaksesi huoltovalikon R3- ja L3-painikkeilla."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Ota tämä käyttöön aktivoidaksesi huoltovalikon."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Ota tämä käyttöön käyttääksesi ristiohjainta vasemman analogitikun sijaan."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Ota tämä käyttöön poistaaksesi koko näytön tilan käytöstä ja ajaaksesi emulaattoria ikkunassa."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Ota tämä käyttöön käyttääksesi valopistoolia 1 pelaajalle 2 ja valopistoolia 2 pelaajalle 1."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Tämän ottaminen käyttöön erillisen lomituksenpoistotilan kanssa voi auttaa vähentämään sumennusta."

msgctxt "game_options"
msgid "Sync to exact content framerate. Only for G-Sync/FreeSync/HDMI-2.1-VRR compatible monitors."
msgstr "Synkronoi sisällön tarkkaan kuvanopeuteen. Vain G-Sync/FreeSync/HDMI-2.1-VRR-yhteensopiville näytöille."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "LD-ROM2-pelien tarvitsema System Card. Oletus: SYSTEM CARD 1, jos syscard1.pce on bios-kansiossa."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "TI-99-puhesyntetisaattorin liitinsovitin."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "TOS 1.06 on vain STE:lle: jos konetyyppiä ei ole asetettu, STE valitaan automaattisesti."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Tavoittele 60 fps:ää natiivin 59,73 fps:n sijaan."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3–4 pelaajaa peleissä White Men Can't Jump ja NBA Jam T.E. Rotary: Tempest 2000, ohjataan hiirellä."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "Amiga lähettää kanavansa täysin vasemmalle ja täysin oikealle. Tämän pienentäminen sekoittaa ne ja on paljon miellyttävämpää kuulokkeilla. 10 on alkuperäisen laitteiston toiminta."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "Amiga lähettää kanavansa täysin vasemmalle ja täysin oikealle. Tämän pienentäminen sekoittaa ne ja on paljon miellyttävämpää kuulokkeilla. 100 % on alkuperäisen laitteiston toiminta."

msgctxt "game_options"
msgid "The CGA variation that is being emulated."
msgstr "Emuloitava CGA-muunnelma."

msgctxt "game_options"
msgid "The Neo Geo CD bios used by the emulator."
msgstr "Emulaattorin käyttämä Neo Geo CD -BIOS."

msgctxt "game_options"
msgid "The Neo Geo bios used by the emulator. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Emulaattorin käyttämä Neo Geo -BIOS. UNIVERSE BIOS tarjoaa yleensä parhaan yhteensopivuuden."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Neo Geo -tila. UNIVERSE BIOS tarjoaa yleensä parhaan yhteensopivuuden."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "RetroBat-tiimi on valmistellut profiileja joillekin yleisille ohjaimille, ne sijaitsevat kansiossa 'saves\mame\ctrlr'. MUKAUTETTU-vaihtoehtoa voi käyttää omien määritysten tallentamiseen."

msgctxt "game_options"
msgid "The SVGA variation that is being emulated."
msgstr "Emuloitava SVGA-muunnelma."

msgctxt "game_options"
msgid "The SoundBlaster emulated FM synth mode."
msgstr "SoundBlasterin emuloitu FM-syntetisaattoritila."

msgctxt "game_options"
msgid "The amount of high memory size the emulated machine has."
msgstr "Emuloidun koneen ylämuistin (high memory) määrä."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "Videomuistin määrä."

msgctxt "game_options"
msgid "The aspect ratio that's used by the Widescreen Hack."
msgstr "Laajakuva-hackin käyttämä kuvasuhde."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "Emulaattorin käyttämä BIOS."

msgctxt "game_options"
msgid "The color scheme for Hercules emulation."
msgstr "Hercules-emuloinnin värimaailma."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "Ajuri 'xinput' ottaa käyttöön ominaisuuksia kuten tärinätehosteet. Valitse 'sdl' yhteensopivuuteen laajan ohjainvalikoiman kanssa."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "Pelin alueen on vastattava Wii-valikon aluetta, muuten peliä ei tunnisteta."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Mitä suurempi arvo, sitä kauempana olevat objektit näytetään."

msgctxt "game_options"
msgid "The maximum RAM memory available for the system."
msgstr "Järjestelmän käytettävissä oleva RAM-muistin enimmäismäärä."

msgctxt "game_options"
msgid "The normal core can be more stable when running installed OS."
msgstr "Normaali ydin voi olla vakaampi asennettua käyttöjärjestelmää ajettaessa."

msgctxt "game_options"
msgid "The raw performance to emulate."
msgstr "Emuloitava raaka suorituskyky."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "Pelaajan 1 oikea analogitikku ohjaa toista joystickia kahden tikun peleissä (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "Oikeaa tikkua käytetään oikeana ristiohjaimena (myös L2:ssa, R2:ssa, L3:ssa ja R3:ssa)."

msgctxt "game_options"
msgid "The type of emulated graphic chip."
msgstr "Emuloitavan grafiikkapiirin tyyppi."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "Joissakin peleissä on virhe, jossa useampi kuin 1 aktiivinen laite kaataa emulaattorin."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Sinden-pistoolin ollessa liitettynä piirrettävän valkoisen reunuksen paksuus. Oletuksena normaali (12 pikseliä)."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Tämä on hyödyllinen ajopeleissä, jotta ohjaus olisi vähemmän 'nykivä', kun ohjataan ohjaimella."

msgctxt "game_options"
msgid "This option can be used to override PAL timings to run games with NTSC timings."
msgstr "Tällä vaihtoehdolla voidaan ohittaa PAL-ajoitukset ja ajaa pelejä NTSC-ajoituksilla."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Tämä vaihtoehto vaihtaa emuloidun PC:n Yamaha-äänikortin. OPN on oletusvaihtoehto. OPNA-ääni tukee useampia FM-kanavia ja PCM-näytteitä."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Tämä vaihtoehto ohjaa SPU-analysaattoria, erityisesti käännettyjen yksiköiden kokoa. Käytä turvallista tilaa parhaan yhteensopivuuden saavuttamiseksi."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "Tämän vaihtoehdon on oltava pois käytöstä SIGILin pelaamiseksi."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Tämä vaihtoehto koskee vain GameCube-ohjainta."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Tämä vaihtoehto valitsee, emuloidaanko PCG-8100:aa. Tätä voidaan tarvita joissakin PC-8000-sarjan ohjelmissa."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Tämä vaihtoehto asettaa emuloidun PC:n CPU:n kellotaajuuden."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Tämä vaihtoehto asettaa emuloidun PC:n CPU:n kellotaajuuden. Ylikellotusvaihtoehdot saavat useimmat ohjelmat toimimaan normaalia nopeammin."

msgctxt "game_options"
msgid "This option specifies which lock-on cartridge to emulate."
msgstr "Tämä vaihtoehto määrittää, mikä lock-on-kasetti emuloidaan."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "Tätä asetusta voidaan käyttää vain 'scanlines'-suodattimen kanssa."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Tämä asetus estää emuloinnin keskeytymisen, kun kohdistus menetetään."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Tämä asetus kiertää Windowsin työpöytää, sitä ei palauteta pelistä poistuttaessa."

msgctxt "game_options"
msgid "This should only be disabled when playing ROM hacks."
msgstr "Tämä tulee poistaa käytöstä vain ROM-hackeja pelattaessa."

msgctxt "game_options"
msgid "This should only be disabled when playing certain demos and homebrews for correct operation."
msgstr "Tämä tulee poistaa käytöstä vain tiettyjä demoja ja homebrew-ohjelmia ajettaessa, jotta ne toimivat oikein."

msgctxt "game_options"
msgid "This will replace the BIOS CD-ROM busy loop with a STOP instruction."
msgstr "Tämä korvaa BIOSin CD-ROM-odotussilmukan STOP-käskyllä."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Tämä ajaa pelin ilman valittuja grafiikka- tai CPU-parannuksia."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "Tämä ajaa konsolin BIOSin pelin sijaan."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Kynnys, jolla analogitikun liike lasketaan digitaaliseksi suunnaksi."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Vähennä emuloitujen CPU-syklien määrää dynaamisesti, jos isännän CPU ei pysy mukana (oletuksena pois käytöstä)"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Kallistussyöte peliin Kirby Tilt 'n' Tumble ja muihin MBC7-peleihin. Oletuksena analogitikku."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "Trapdoor-laajennusmuisti, kuten klassisessa A501-laajennuksessa."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Yritä suorittaa pelin asennus."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Yritä tunnistaa silmukkaehtoja SPU-ytimissä ja käyttää niitä ajoitusvihjeinä. Oletuksena pois"

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "Yritä tunnistaa peli ja käyttää ohjainmääritystä."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Yritä valita ROMille paras virkistystaajuus."

msgctxt "game_options"
msgid "Try to use legacy dosbox.conf config file instead of core options."
msgstr "Yritä käyttää vanhaa dosbox.conf-määritystiedostoa ytimen asetusten sijaan."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "TurboTap tarvitaan pelaamiseen useammalla kuin yhdellä pelaajalla. Otetaan automaattisesti käyttöön, kun toinen ohjain liitetään."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Ota emulaattorin ilmoitukset käyttöön: liitetyt ohjaimet ja varjostinten kääntämisen viestit."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Kääntymisnopeus hiirellä. Oletus: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Ota tämä käyttöön määrittääksesi suunnat vain ristiohjaimeen."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Ota tämä käyttöön käytettäessä valopistoolia, joka ei tue latausta ruudun ulkopuolelle ampumalla."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "Tämän vaihtoehdon käyttöönotto antaa MAMEn raportoida eri hiirien liikkeet ja painikkeiden painallukset toisistaan riippumatta."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Muuttaa oikean tikun Amiga-hiireksi, hyödyllinen valikkopohjaisissa ja osoita ja napsauta -peleissä ohjainta irrottamatta."

msgctxt "game_options"
msgid "Tweak the behavior of the 3Dfx Voodoo emulation."
msgstr "Säädä 3Dfx Voodoo -emuloinnin toimintaa."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Oletuksena kaksi kerrosta (bittitarkka). Lajiteltu korjaa päällekkäisen savun ja lasin, shakkilauta jäljittelee arcade-korttia (Sega Rally 2:n lumi ja sumu)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Emuloitavan APPLE II:n tyyppi."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Emuloitavan Archimedes-tietokoneen tyyppi."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Emuloitavan BBC Micron tyyppi, oletuksena MALLI B."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Käytettävän CPU-emulointiytimen tyyppi."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Emuloitavan Color Computerin tyyppi, oletuksena coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Emuloitavan tietokoneen tyyppi."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Emuloitavan FM Townsin tyyppi, oletuksena FM TOWNS (MALLI 1/2)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Emuloitavan FM-7:n tyyppi, oletuksena FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "Kuvien ohituksen tyyppi."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Emuloitavan LYNXin tyyppi, oletuksena 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "ROM-tiedoston tyyppi"

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Emuloitavan V.Smilen tyyppi."

msgctxt "game_options"
msgid "Type of emulated SoundBlaster card."
msgstr "Emuloidun SoundBlaster-kortin tyyppi."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "Peliporttiin kytketyn joystickin tyyppi."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Poistaa pelin kuvanopeusrajoituksen, jos sisäisestä tietokannasta löytyy patch."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Avaa lisäkieliä joissakin peleissä, jos ytimen tietokannassa on niille merkintä."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Nosta CPU:n taajuus 93,75:stä 125 MHz:iin. Voi nopeuttaa joitakin CPU-riippuvaisia pelejä."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Skaalaa pelin tekstuurit ylös pikseligrafiikkasuodattimella."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "2D-kerrosten (HUD, taustat) ylösskaalaussuodatin."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "2D-kerrosten (HUD, taustat) ylösskaalaussuodatin. Vain Vulkan ja OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Käytä 'ETELÄ'-painiketta A-painikkeena ja 'LÄNSI'-painiketta B-painikkeena."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Käytä 'cfg64'-kansiota erilliselle MAMElle."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Käytä 'MUKAUTETTU'-tähtäintä ottaaksesi valitun tähtäintiedoston käyttöön."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Käytä 'MUKAUTETTU'-tähtäintä ottaaksesi tässä valitun tiedoston käyttöön."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Käytä 'PELIKOHTAINEN', jos olet tallentanut pelille profiilin kansioon capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Käytä 50 eurooppalaiselle konsolille ja 60 japanilaiselle konsolille."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Käytä 8 MHz:ä paremman yhteensopivuuden saavuttamiseksi."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Käytä analogitikkua ristiohjaimena."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Käytä DSI:tä DSi-peleille, kuten DSiWare."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Käytä VAIN JOYSTICK -asetusta joystick-peleille ja VAIN NÄPPÄIMISTÖ -asetusta näppäimistöpeleille."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Käytä vasenta analogitikkua ristiohjaimen sijaan ohjaukseen."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Käytä R1:tä ja L1:tä kiihdyttämiseen ja jarruttamiseen ajopeleissä, yhteensopiva vain 'auto'-vaihteenvaihdon kanssa."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Käytä Resizable BAR -tekniikkaa GPU-siirtoihin, kun saatavilla. Poista käytöstä, jos ajurisi kanssa ilmenee nykimistä tai epävakautta."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Käytä SDL:ää kaikille ohjaimille XInputin sijaan Xbox-ohjaimille."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Käytä SGB2:n ajoituksia ja toimintaa."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Käytä SSE4:ää AVX2:n sijaan vanhemmille suorittimille."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Käytä korkearesoluutioista suodatinta renderöinnin parantamiseen."

msgctxt "game_options"
msgid "Use a mouse-controlled Lightgun or Touchscreen input."
msgstr "Käytä hiirellä ohjattua valopistooli- tai kosketusnäyttösyötettä."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Käytä ennalta määritettyä väripalettia emulaattorin laskeman sijaan."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Käytä vaihtoehtoista syvyyskäsittelyä, ota käyttöön, jos ilmenee grafiikkaongelmia tai tietty virheilmoitus."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Käytä et-merkkiä (&) ja vasenta sulkua startille ja kolikoille."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Käytä ulkoista laiteohjelmistoa (oletus on bios-kansiossa oleva 'firmware.bin')."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Käytä analogitikkua ristiohjaimen sijaan."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Käytä bilineaarista suodatusta koko kuvan pehmentämiseen."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Käytä BIOSia tietyille järjestelmille, kuten Neo Geo ja Sega ST-V"

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Käytä painiketta lataamiseen ruudun ulkopuolelle ampumisen sijaan pistooleilla, jotka eivät tue sitä."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Käytä painikkeita analogisen akselin sijaan ratille."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Käytä tietokoneen oletusäänitulolaitetta mikrofonina."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Käytä hattua liikkumiseen joystickin lisäksi."

msgctxt "game_options"
msgid "Use input directly sends by keyboard to the core."
msgstr "Käytä näppäimistön suoraan ytimelle lähettämää syötettä."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Käytä tulkkia parhaan yhteensopivuuden saavuttamiseksi, dynarecia suorituskyvyn vuoksi."

msgctxt "game_options"
msgid "Use interpreter for best compatibility."
msgstr "Käytä tulkkia parhaan yhteensopivuuden saavuttamiseksi."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Käytä vasenta analogitikkua ristiohjaimen lisäksi."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Käytä vasenta analogitikkua ristiohjaimen sijaan."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "Käytä vasenta tikkua ristiohjaimena."

msgctxt "game_options"
msgid "Use native texture LOD computation when upscaling."
msgstr "Käytä natiivia tekstuurien LOD-laskentaa ylösskaalauksessa."

msgctxt "game_options"
msgid "Use official BIOS and bootloader for emulated hardware."
msgstr "Käytä emuloidulle laitteistolle virallista BIOSia ja käynnistyslatainta."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Käytä yhtä jaettua muistikorttia kaikille peleille yhden pelikohtaisen kortin sijaan. Kortit tallennetaan kansioon '\bios\pcsx2\memcards'."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Käytä pikselintarkkaa emulointia, kun saatavilla."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Käytä portteja 5–8 GameCube-ohjaimille Wii-tilassa."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Käytä ennakoivia kuvia run-aheadin sijaan, run-ahead-kuvien määrä on voimassa."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Käytä oikeita GameCube-ohjaimia GameCube-sovittimen kautta. Vain oikeiden Wiimotejen kanssa."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Käytä olkapainikkeita L:lle ja R:lle liipaisimien sijaan."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "Käytä olkapainikkeita liipaisimien sijaan."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Käytä HD-pakettien 3D-malleja spritejen sijaan (OpenGL-renderöijät). Oletuksena käytössä."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "Käytä RetroBatin 'bios'-kansiossa olevaa BIOSia, vaaditaan BIOSiin käynnistämiseen."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Käytä RetroBatin 'bios'-kansiossa olevaa BIOSia."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Käytä KORKEA TAAJUUS -arvoa näytöille, joilla on korkeampi virkistystaajuus."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Käytä Odin-taidepaketin kehyksiä (emulaattorin artwork-kansio) RetroBatin koristeiden sijaan."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Käytä laskentavarjostinrenderöijää klassisen OpenGL-renderöijän sijaan. Nopeampi korkeilla sisäisillä resoluutioilla, vaatii OpenGL 4.3:n."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Käytä emulaattorin sisäänrakennettua BIOSia bios-kansion tiedostojen sijaan. DS:n latauspeli (Download Play) vaatii alkuperäisen BIOSin ja laiteohjelmiston."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Käytä HD-pakettien korkearesoluutioisia tekstuureja (OpenGL-renderöijät). Oletuksena käytössä."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Käytä hiirtä Apple II:n meloina, tarvitaan Arkanoidiin, Breakoutiin ja muihin säädinnupilla ohjattaviin peleihin. Osoittimen sijainti näytöllä on melan sijainti. Korvaa ohjaimen tikun meloille 1 ja 2, jätä pois päältä joystick-peleissä."

msgctxt "game_options"
msgid "Use the older and less compatible faster blitter"
msgstr "Käytä vanhempaa ja vähemmän yhteensopivaa nopeampaa blitteriä"

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Käytä Vita3K:n käyttöliittymään tallennettuja pelikohtaisia asetuksia. Ne ohittavat RetroBatin asetukset tälle pelille."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Käytä yksinkertaista double hi-res -värikarttaa. Muutama Apple II -ohjelma näyttää sen kanssa lähempänä oikeaa konetta."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Käytä tätä, jos emulaattori kaatuu latauksen jälkeen tai ei näytä mitään."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Käytä tätä vain, jos analogitikku ajelehtii."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Käytä tätä vaihtoehtoa, jos ArcadeDuck ei näy oikealla näytöllä."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Käytä tätä vaihtoehtoa, jos Keisho ei näy oikealla näytöllä."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Käytä tätä vaihtoehtoa, jos Odin ei näy oikealla näytöllä."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Käytä tätä vaihtoehtoa, jos PCSX2 ei näy oikealla näytöllä."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Käytä tätä vaihtoehtoa, jos duckstation ei näy oikealla näytöllä."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Käytä tätä vaihtoehtoa, jos p1 ja p2 ovat vaihtuneet keskenään."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Käytä tätä vaihtoehtoa käytettäessä näppäimistöksi tunnistettua ohjainta (ipac jne.)."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Käytä tätä vaihtoehtoa käytettäessä rattia ilman manuaalista vaihdekeppiä."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Käytä tätä asetusta lentopeleissä."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Käytä tätä asetusta kirkkauden vähentämiseen tai lisäämiseen, ei yhteensopiva 'gdi'-videoajurin kanssa."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Käytä tätä asetusta kontrastin vähentämiseen tai lisäämiseen, ei yhteensopiva 'gdi'-videoajurin kanssa."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Käytä tätä asetusta gamman vähentämiseen tai lisäämiseen, ei yhteensopiva 'gdi'-videoajurin kanssa."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Käytä tätä asetusta oletusturbopainikkeen määrittämiseen."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Käytä tätä asetusta ohittaaksesi run.bat-, autoexec.bat- tai dosbox.bat-tiedostot pelikansiossa."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Käytä tätä asetusta syöteviiveen vähentämiseen."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Käytä tätä sisällön, kuten HD-pakettien, automaattiseen lataamiseen."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Käytä winkeytä näppäimistölle, xinputia, jos sinulla on XBOX-ohjain, sdl:ää muun tyyppisille ohjaimille."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Käytä omaa .cfg-tiedostoasi kansiossa saves\mame\cfg. Pelin aikana TAB-valikossa tehdyt uudelleenmääritykset säilytetään. Ensimmäisellä käyttöönottokerralla edellisen istunnon määritys tuodaan automaattisesti. Ohjaimen asetteluvaihtoehto ei enää koske tätä peliä."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Hyödyllinen peleissä, joissa on näytön heiluntatehosteita, kuten Wipeout Fusion, voi tehdä kuvasta sumean."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Hyödyllinen yksisäikeisille suorittimille."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Hyödyllinen joillakin korkean virkistystaajuuden näytöillä haamukuvan poistamiseksi."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Hyödyllinen käytettäessä näyttöä suurempaa resoluutiota. Estää moiré-ilmiön."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Käyttää 60 Hz:ä (480i) 50 Hz:n (576i) sijaan."

msgctxt "game_options"
msgid "Uses the proper mipmap levels. Enhance graphics accuracy."
msgstr "Käyttää oikeita mip-karttatasoja. Parantaa grafiikan tarkkuutta."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "VI-jälkikäsittelysuodattimen emulointi."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Yli 1,00:n arvot suurentavat kokoa, sitä pienemmät pienentävät."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "Pystypelit näytetään valittua indeksiä vastaavalla näytöllä."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD on parannettu näytönohjainkortti, jota kourallinen moderneja demoja käyttää. Muutos käynnistää koneen uudelleen."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Videotilat, jotka konsoli tarjoaa peleille. HD-tilat vaativat HDTV-videosignaalin."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Pöydän käyttämä näkymäasetus. AUTO seuraa NÄYTTÖKOKOONPANO-asetusta: työpöytä yhdelle vaakanäytölle, täysi yksi näyttö yhdelle pystynäytölle, kaappi useille näytöille (työpöytä, kun NÄYTTÖKOKOONPANO ei ole asetettu)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Kierrä ristiohjainta virtuaalisesti, kun näyttöä kierretään."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Emuloidun levykeaseman naksahdusäänen äänenvoimakkuus."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Musiikkikortin äänenvoimakkuus peleissä, joissa sellainen on (Daytona USA, Sega Rally). Oletuksena 100 %."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Vain Vulkan, hitaampi mutta vähemmän viivettä."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Vain Vulkan. Parantaa suorituskykyä ja korjaa monia grafiikkaongelmia, mutta voi olla epävakaa joillakin näytönohjaimilla. Tukemattomat menetelmät palaavat varavaihtoehtoon automaattisesti."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Vain Vulkan: käskee videoajuria käyttämään määritettyä puskurointitilaa."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Mitä Amigan ensimmäiseen porttiin on kytketty. Useimmat pelit käyttävät joystickia portissa 2 ja hiirtä portissa 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Mitä Amigan toiseen porttiin on kytketty."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Mitä Amigan toiseen porttiin on kytketty. Oletus on joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Mitä toinen portti vastaanottaa, kun toinen ohjain liitetään."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Kun osoite syötetään, tilaksi asetetaan automaattisesti 'MANUAALINEN'."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "Kun automaattinen tunnistus epäonnistuu."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Suosi emulaattoreille yksinomaista koko näytön tilaa, kun saatavilla."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "Kun käytössä, jokaisella pelillä on oma VMU portissa 1."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "Kun valitset 'MANUAALINEN', määritä osoite seuraavassa asetuksessa."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "Kun nopeusrajoitus on pois käytöstä, MAME ajaa emulointia niin nopeasti kuin mahdollista."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Käytettäessä .m3u-tiedostoa valitse käynnistettävän levyn indeksi."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Kohdistinjoystickia käytettäessä painikkeet on määritettävä näppäimiin RetroArchissa."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "XInputia käytettäessä tämä vaihtoehto vaihtaa gamepadit 1 ja 2 keskenään."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Sinden-pistoolia käytettäessä sulje Lightgun-ohjelmisto, kun peli päättyy."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Käytettäessä tiedostosta luettavaa määritystä arcade-järjestelmille määritä käytettävä asettelu."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "Oikeita Wiimoteja käytettäessä määritä Wiimoten tyyppi."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "Käytettäessä ohjelmistoa, joka vaatii täyden näppäimistösyötteen, on suositeltavaa käyttää myös pelin kohdistustilaa (game focus)."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Missä DMD näytetään. AUTO: pelikentällä 1 näytöllä, backglass-näytön alaosassa 2 näytöllä, omalla näytöllään 3 näytöllä. Vaatii NÄYTTÖKOKOONPANO-asetuksen."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Mikä RetroPad ohjaa mitäkin Amigan porttia. Jätä Automaattinen, elleivät pelaajat ole vaihtuneet keskenään."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Mikä monilevykepelin levyke asetetaan käynnistyksessä. POM2 lataa yhden levykkeen kerrallaan, muut vaihdetaan pelin valikosta."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Mikä monilevykepelin levyke asetetaan käynnistyksessä: aina ensimmäinen tai se, joka oli asemassa, kun viimeksi lopetit."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Mikä etupainike vahvistaa PS3:n järjestelmän valintaikkunoissa. Japanilaiset pelit odottavat yleensä ympyrää, länsimaiset ristiä. Jätä AUTO-tilaan seurataksesi valittua aluetta."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Levykeasema, johon levykkeen vaihtovalikko vaikuttaa."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Emulaattorin piirtämä valkoinen reunus, jota Sinden-pistoolit tarvitsevat tähtäämiseen."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Sinden-pistoolin ollessa liitettynä piirrettävän valkoisen reunuksen leveys. Oletuksena 16 pikseliä."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Sinden-pistoolin ollessa liitettynä piirrettävän valkoisen reunuksen leveys. Oletuksena 2 pikseliä."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Ajaa XBOX-prosessia useilla CPU-säikeillä, voi parantaa suorituskykyä, mutta voi rikkoa joitakin pelejä."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Kiertotie, jota muutama homebrew-ohjelma ja ROM-hack tarvitsee."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Kiertää joidenkin rattien laiteohjelmistovirheitä, jotka aiheuttavat lyhyitä voimakatkoksia. Jätä pois päältä, ellei tarvita."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Kirjoittaa Amiberry.log-tiedoston emulaattorin kansioon. Hyödyllinen vain ongelmasta raportoitaessa, se hidastaa hieman."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Kirjoittaa syvyyspuskurin arvot VM-muistiin. Oletuksena pois."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Kirjoittaa syötetapahtumat lokitiedostoon tallennuskansiossa. Hyödyllinen vain ongelmasta raportoitaessa."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "Z80 SoftCard ajaa CP/M-ohjelmia. Äänikortit voidaan lisätä tähän toiseksi kortiksi. Muutos käynnistää koneen uudelleen."

msgctxt "game_options"
msgid "Zooms in to hide black borders."
msgstr "Lähentää mustien reunojen piilottamiseksi."

msgctxt "game_options"
msgid "Zooms in to hide black borders. Borders are different per game."
msgstr "Lähentää mustien reunojen piilottamiseksi. Reunat ovat erilaiset jokaisessa pelissä."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "Zorro II -laajennusmuisti. Monet WHDLoad-pelit vaativat sen, mutta muutama alkuperäinen levykepeli kieltäytyy käynnistymästä sen kanssa."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "Zorro II -laajennusmuisti. Monet WHDLoad-pelit vaativat sen."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Zorro III -muisti, vain kiihdytetyn koneen käytettävissä. Jätä arvoon ei mitään, ellei jokin peli sitä pyydä."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Zorro III -muisti. Hyödyllinen Workbench-kokoonpanoissa ja muutamissa demoissa."

msgctxt "game_options"
msgid "use this to automatically start to a specified level."
msgstr "käytä tätä käynnistääksesi automaattisesti tiettyyn tasoon."
