# FEATURES - DESCRIPTIONS
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "„1x“ е реалната скорост на устройството. „Турбо“ зарежда почти мигновено, но някои игри го откриват и отказват да работят."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "„1x“ е реалната скорост на устройството. „Турбо“ премахва емулацията на въртенето на диска и зарежда почти мигновено, но някои игри го откриват и отказват да работят."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "„Точно“ съответства на хардуера, но може силно да намали кадровата честота на екраните за запис/зареждане. Променете само ако някое меню е бавно."

msgctxt "game_options"
msgid "'Auto' defaults to the most compatible version for the model."
msgstr "„Автоматично“ по подразбиране избира най-съвместимата версия за модела."

msgctxt "game_options"
msgid "'Auto' is the default floppy speed (300RPM). 'Turbo' removes disk rotation emulation."
msgstr "„Автоматично“ е скоростта на флопито по подразбиране (300 RPM). „Турбо“ премахва емулацията на въртенето на диска."

msgctxt "game_options"
msgid "'Auto' will controls the half-screen fix detection on texture shuffling."
msgstr "„Автоматично“ управлява откриването на корекцията за половин екран при разбъркване на текстурите (texture shuffling)."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "„Съвместим“ подхожда на почти всяка игра. „Cycle exact“ е най-точният, но изисква бърз компютър. „Бърз“ отключва скоростта на CPU и може да счупи игри, чувствителни към тайминга."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "„Двойно“ дава чиста модерна картина. Режимите със сканиращи линии пресъздават вида на CRT монитор."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "„Dual Stick“ присвоява джойстика на Играч 2 към десния аналогов стик на Играч 1, „Swap Ports“ коригира разменените портове за „Wizard of Wor“."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "„Прецизен“ е най-вярната емулация на Paula. Намалете само ако звукът накъсва на бавен компютър."

msgctxt "game_options"
msgid "'Games Express' is needed for several unlicensed games."
msgstr "„Games Express“ е необходим за няколко нелицензирани игри."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "„Joystick“ е класическият стик с 2 бутона, който всяка игра разбира. „CD32 pad“ добавя цветните бутони и се избира автоматично на CD32."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "„ВКЛ.“ предава всички събития от физическата клавиатура към ядрото. „ИЗКЛ.“ не позволява клавишите на RetroPad да генерират клавиатурни събития."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "„ПРЕДВАРИТЕЛНО ЗАДАДЕНИ“ използва конфигурационните файлове в папката „cfg“ на емулатора, „ДИНАМИЧЕН“ генерира конфигурацията според профила, избран в разширените настройки на „УПРАВЛЕНИЕ“."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "„Безопасно“ коригира грешките в текстурите в някои игри с голяма загуба на производителност."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "Опцията „Шаблони“ копира файловете от папката „emulators\m2emulator\templatescfg“ вместо да прави динамична автоматична конфигурация."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "„Троен буфер“ и „съответствие с емулираното съдържание“ са налични само с видео драйвера Vulkan."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "„Турбо“ премахва емулацията на закъснението при търсене (seek)."

msgctxt "game_options"
msgid "'Weave' should only be used with 1x scaling factor and CRT shaders."
msgstr "„Weave“ трябва да се използва само с мащаб 1x и CRT шейдъри."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "„XINPUT“ принуждава използването на XInput API за съвместимите контролери."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "„directx11“ е по подразбиране и работи на почти всеки хардуер. „vulkan“ може да е по-бърз на нови GPU. Някои libretro ядра налагат собствения си драйвер."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8MB Fast RAM (CD32FR). Изключено по подразбиране, както на оригиналния CD32."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "0 е най-ниско качество, закъснение и натоварване на CPU, 10 е най-високо качество, закъснение и натоварване на CPU."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "При модерни контролери се препоръчва 130-140%."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 бита премахва цветовите ленти в тъмните зони и преливанията. HDR изисква HDR дисплей с включен HDR в RetroArch, иначе ядрото се връща към 24 бита."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x съответства на реалното устройство. По-високите скорости съкращават зареждането, но могат да счупят игрите."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "Поставена карта за разширение на RAM 32k."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "4/3 по подразбиране, като аркадния монитор. Рамката се показва само в 4/3. 16/9 разширява 3D изгледа."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Няколко игри изискват тази опция да е изключена."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Няколко игри изискват това. Струва около 10% производителност."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Няколко много ранни игри изискват чипа CTIA, за да се показват правилно."

msgctxt "game_options"
msgid "A shadows and colors fix needed for some games such as Tony Hawk Proving Ground."
msgstr "Корекция на сенките и цветовете, нужна за някои игри като Tony Hawk Proving Ground."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII присвоява клавиатурата ви според символите, които отпечатва. Оригинал възпроизвежда точно клавиатурата на емулираната машина, нужно за някои програми."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "АВТОМАТИЧНО (препоръчително) оставя ядрото да избере NAND файла според региона на играта."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "АВТОМАТИЧНО показва прицела при прицелване с мишка и го скрива с истински светлинен пистолет."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "АВТОМАТИЧНО превключва на DSi само за изключителните за DSi игри. Принудете DSI за DSiWare."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "АВТОМАТИЧНО избира разширението според размера на програмата. Може да се наложи с етикети в името на файла като (8k) или [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "АВТОМАТИЧНО: Vita3K сам зарежда нужните модули на фърмуера (препоръчително). НАСТРОЙКИ НА ЕМУЛАТОРА: запазва модулите, избрани в интерфейса на Vita3K."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Над 60 fps кадрите се интерполират между обновяванията на играта. АВТОМАТИЧНО следва честотата на опресняване на дисплея."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Точна емулация на framebuffer, много бавна, но необходима за някои игри."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Играете като играч 1 и сте домакин на играта."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Действие на втория бутон на контролера: клавиш интервал (напр. Xenon 2) или джойстик нагоре (скок в платформените игри)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Включва помощта при прицелване."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Включва автоматичния запис и задава интервала между автоматичните записи."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "Включете при използване на WiiZapper, за да размените бутоните на спусъка и презареждането."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Адаптира изгледа на играта към широки екрани."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Добавя празен 2HD диск за записи/потребителски диск към списъка за управление на дисковете."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Добавя контактни сенки, изисква хардуерния рендерер."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Нагажда скоростта на показалеца на мишката според чувствителността на аналоговия стик."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "Нагажда изходните цветове, за да имитират оригиналния екран на конзолата."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Нагажда вертикалния център на показалеца на Wiimote."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Нагажда силата на музиката."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Нагажда силата на звуковите ефекти."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Разширена аудио библиотека, използвана от много игри. Изключете само ако някоя игра забива или има проблеми със звука."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Прицелване с жироскопа на контролера (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Позволява на ADAM да записва върху дискове и пакети с данни. Записите отиват в работно копие в папката saves, оригиналният файл никога не се променя. Изисква рестарт на ядрото."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Разрешава контролерите DirectInput (общи USB геймпадове, аркадни стикове). Изключете само ако някой геймпад се открива два пъти."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Разрешава контролерите XInput (геймпадове Xbox и обвивки). Изключете само ако някой геймпад се открива два пъти."

msgctxt "game_options"
msgid "Allow bilinear scaling on scanout."
msgstr "Разрешава билинейно мащабиране при scanout."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Позволява правилна емулация на обвиването на текстурите (texture wrapping), но струва производителност."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Позволява игрите, поддържащи различни резолюции, да се рендират в определена резолюция."

msgctxt "game_options"
msgid "Allow gamma dither."
msgstr "Разрешава гама дизеринг."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Разрешава родната HID поддръжка за геймпадовете DualShock 4, DualSense и Switch Pro. Изключете, за да се върнете към DirectInput."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Позволява едновременно натискане на ляво и дясно или горе и долу. Може да причини грешки в движението в някои игри."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Позволява едновременно натискане на противоположни посоки."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Позволява на някои игри с 30 fps да работят на 60 fps."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Разрешава fetch константи за текстури и вертекси с невалиден тип; може да се използва за заобикаляне на fetch грешки в някои игри."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Разрешава променлива честота на опресняване на дисплеите, които я поддържат. На дисплеи без VRR в някои случаи може да има разкъсване на картината."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Позволява мащабиране на картата с колелцето на мишката, както в Enhanced Editions."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Позволява специално присвояване за аркадния ви стик според файла „arcade_sticks.json“."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Позволява използването на входовете от мишката, дори когато типът устройство не е „RetroKeyboard/Mouse“."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Поставя и следващата дискета в устройство 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Винаги разархивира архивите, дори ако dokan може да ги монтира като буква на устройство."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Винаги показва имената на предметите на земята."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Модел Amiga за емулиране. Всеки изисква собствен Kickstart ROM в папката bios."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Модел Amiga за емулиране. Изисква рестарт на ядрото. Всеки модел изисква съответен Kickstart ROM в папката bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Порт на Amiga, към който е включен пистолетът. Порт 2 е правилният за почти всяка машина; само A1000 чете писалката от порт 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Количество Chip RAM. Някои по-късни игри изискват 1 MB. Надхвърлянето на поддържаното от модела може да наруши съвместимостта."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "Количество използвана RAM."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Количество малки движения на показалеца, които да се игнорират."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Допълнителна вибрация, която се засилва при завиване."

msgctxt "game_options"
msgid "Anti-aliased fetch filter, smooth polygons edges."
msgstr "Fetch филтър с изглаждане, изглажда ръбовете на полигоните."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Ниво на изглаждане."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Метод и ниво на изглаждане."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Модел Apple II за емулиране. Промяната рестартира машината."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Модел Apple II за емулиране. Моделите PAL работят на 50Hz и за тях са писани европейските демота. Промяната рестартира машината."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Прилага се към изображението на прицела, полезно за различаване на играчите."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Прилага степенна крива към стойностите на волана, омекотява малките движения."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Прилага се към осите на летателния лост и газта в After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Прилага се към педалите за газ и спирачка в състезателните игри."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Прилага Gouraud засенчване вместо плоско засенчване, само с OpenGL."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Прилага CRT филтър (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Прилага кафеникав цветови (chroma) филтър."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "Прилага видео филтър, предоставен от ядрото."

msgctxt "game_options"
msgid "Apply a video filter to mimic various signals."
msgstr "Прилага видео филтър, имитиращ различни сигнали."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Прилага видео филтър към изходното изображение."

msgctxt "game_options"
msgid "Apply an audio filter. 'Gaussian' reproduce the bass-heavy sound of the original hardware."
msgstr "Прилага аудио филтър. „Гаусов“ възпроизвежда басовия звук на оригиналния хардуер."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Прилага аудио филтър. Променя интерполацията на звука."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Прилага специфичен за ядрото филтър, имитиращ изображението на стари сигнали."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Прилага корекция за някои игри."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Прилага горния регион, дори когато играта декларира собствен."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Приблизително възпроизвежда аналоговото изходно стъпало на конзолата: премахва DC отместването и омекотява високите честоти."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Вид на аркаден монитор."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Вид на аркаден монитор: сканиращи линии, shadow mask и сияние."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Пропорции, предоставени от ядрото, използвани когато ПРОПОРЦИИ НА ИГРАТА е на АВТОМАТИЧНО."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Пропорции, зададени в системните настройки на конзолата."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Клавиатура Atari: F2, F4 и F8 остават за играта, а записите на състоянието и екранните снимки тогава използват AltGr+K, AltGr+L и AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Опитва да мащабира в родната резолюция."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Праг на аудио буфера за ръчно пропускане на кадри."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Аудио дава най-ниско закъснение. Видео е по-плавно, когато честотата на опресняване на екрана е близка до тази на конзолата."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Честота на аудио изхода."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Автоматично (по подразбиране) следва честотата на опресняване на екрана с интерполация на движението. Оригинал и кратните на 57,524 Hz изискват G-SYNC / FreeSync екран и вертикална синхронизация."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Автоматично центрира оста на прицелване. Полезно при игра на стрелби с геймпад вместо светлинен пистолет."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Скорост на автоматичната стрелба. По-бързо не винаги е по-добре: някои игри игнорират твърде бързите натискания."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Автоматично: ляв атака, долен скок, десен специален, горен атака 2, L1/R1 атака 3/4. OpenBOR standalone: същите бутони като самостоятелния емулатор OpenBOR."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Автоматично използва XInput, когато всички контролери са XInput устройства, иначе DirectInput."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Автоматично: зарежда от твърдия диск, когато играта има твърд диск и няма дискета."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Автоматично: показва се само когато играта няма собствен прицел."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Автоматично прилага подобрения на играта, ако съществуват в базата данни на ядрото (LOD, разстояние на видимост, пропускане на FMV)."

msgctxt "game_options"
msgid "Automatically decrease frame delay temporarily to prevent frame drops. Turn off if this worsens audio/video stuttering."
msgstr "Автоматично временно намалява забавянето на кадъра, за да предотврати изпуснати кадри. Изключете, ако това влошава накъсването на звука/видеото."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Автоматично превърта напред FDS играта, докато дискът се зарежда."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Автоматично зарежда кръпките, премахващи презредовото, при стартиране на играта."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Автоматично зарежда кръпките за широк екран при стартиране на играта."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Автоматично зарежда и прилага чийтовете при стартиране на играта."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Автоматично премахва черните рамки около картината на Amiga, така че изображението да запълва повече от екрана."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Автоматично завърта картината за вертикалните игри."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Автоматично превключва Port0 и Port1 според активността на входа."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Автоматично обръща страната на диска, когато играта го поиска."

msgctxt "game_options"
msgid "Avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Избягва празнините между пикселите при мащабиране. Коригира текста в Wild Arms и двойния образ в SoulCalibur."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "Езикът на BIOS може да повлияе на езика на някои игри."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Рамките се показват само в 4/3."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "Препоръчва се двустранен CAS, но той намалява производителността; CAS е по-малко агресивен и по-деликатен."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Ниво на черното в картината. 50% по подразбиране, настроено по аркаден запис: по-ниско е по-тъмно, по-високо е по-светло."

msgctxt "game_options"
msgid "Blend pixel together when in hires mode. Higher values will blur the picture more."
msgstr "Смесва пикселите в режим hires. По-високите стойности размазват картината повече."

msgctxt "game_options"
msgid "Blend pixels from multiple successive frames to simulate LCD ghosting."
msgstr "Смесва пикселите от няколко последователни кадъра, за да симулира остатъчния образ на LCD."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "„Смесено“ чертае прозрачните полигони като плавно смесване вместо аркадната шахматна дъска. Само Model 1 и Model 2, рендерери Vulkan и OpenGL."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Размазва емулирания дисплей."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "Размазва съседните пиксели за ефекти на полупрозрачност."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "Размазва съседните пиксели, за да симулира SDTV резолюция; някои игри може да се нуждаят от това за емулиране на прозрачност."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Ускорява емулацията по време на стартиране."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Стартира директно в менюто на DS BIOS, изисква включен външен BIOS."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Стартира в екрана за въвеждане на кодове на Game Genie. Изисква „gamegenie.nes“ в папката bios. Изисква рестарт."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Стартира в менюто на BIOS на конзолата."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Стартира с истинския BIOS на Jaguar и неговата начална анимация. Необходимо за някои игри."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Спира в дебъгера на хоста (или забива, ако няма дебъгер), когато срещне нереализирана инструкция на PowerPC."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "Показва менюто на системния ROM при стартиране на аркадните системи."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Излъчва обратната връзка от входа на TCP порт 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Изгражда кеша на шейдърите преди стартиране на играта."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Комбинация от бутони за превключване между телевизора и GamePad, използва се само от подредбата на екраните ПРЕВКЛЮЧВАЕМО."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Подредба на бутоните на ядрото, еднаква за всички игри. Оставете АВТОМАТИЧНО, за да използвате присвояването на RetroBat за всяка игра и ПОДРЕДБА НА КОНТРОЛЕРА."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Бутон за потвърждение в системните диалози и в игрите, които следват системната настройка. КРЪГ е японската конвенция."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "По подразбиране се стартира Hellfire, ако името на играта съдържа hellfire, иначе Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "По подразбиране RetroBat конфигурира толкова играчи, колкото са свързаните контролери; използвайте това, за да го промените."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "По подразбиране RetroBat генерира собствен конфигурационен файл; включете тази опция, за да използвате собствения си файл с настройки на играта в папката „emulators\ssf\Setting“."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "По подразбиране се използва втори геймпад, когато е свързан втори контролер."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "По подразбиране всеки контролер движи героя. Включете, ако друг свързан контролер пречи на движението."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "По подразбиране zinc присвоява левия стик за движение; използвайте тази опция, за да превключите на кръстачката."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "По подразбиране RPCS3 изисква GunCon в порт 3 на играч; използвайте това, за да го наложите в порт 1."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "По подразбиране RetroBat пренебрегва специфичните за ядрото файлове с опции."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "По подразбиране RetroBat поддържа синхронизация между инсталираните игри и папката roms."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "По подразбиране калибрирането се прави със средния бутон на мишката; тази настройка позволява друг бутон за калибриращия изстрел."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "По подразбиране промените се записват върху дисковото устройство, „отхвърляне“ не записва никакви промени."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "По подразбиране за разклащане се използва спусъкът; включете, за да симулирате замах вместо това."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Заобикаля mipmapping и винаги използва най-острото ниво на текстурите. По-добро качество на образа; някои игри имат проблеми с рендирането."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "Конфигурация CD32. Изисква в папката bios както Kickstart за CD32, така и неговия разширен ROM."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "КЛАСИЧЕСКИ е оригиналният софтуерен рендерер. POLYMOST и POLYMER използват OpenGL и поддържат HD пакети."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "Физически размер на RAM на CPC в kB."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "Такт на CPU. Автоматично използва такта на модела или базата данни на игрите. Някои игри (SSF2, Alltynex) печелят от по-бърз CPU."

msgctxt "game_options"
msgid "CPU frequency multiplier. Applies only with Cycle-exact."
msgstr "Множител на честотата на CPU. Прилага се само с Cycle-exact."

msgctxt "game_options"
msgid "Cache custom textures to system RAM on startup."
msgstr "Кешира потребителските текстури в системната RAM при стартиране."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Скорост на камерата с десния аналогов стик или мишката."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Може да повлияе на производителността по неочаквани начини."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Може да се използва за изключване на md5 проверката на BIOS при използване на потребителски BIOS."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "Може да подобри кадровата честота, но може да наруши скоростта на някои игри."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Може да подобри производителността на 3D рендирането в някои игри."

msgctxt "game_options"
msgid "Can be used to simulate colors of particular displays."
msgstr "Може да се използва за симулиране на цветовете на определени дисплеи."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Може да е полезно за Gran Turismo; тригерите ще бъдат присвоени на други бутони."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Може да е полезно за Gran Turismo; тригерите ще бъдат присвоени на десния аналогов стик."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Може да е полезно за Metal Gear, за симулиране на чувствителността към натиск."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Може да е от полза за някои игри."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Може да причини различни грешки."

msgctxt "game_options"
msgid "Can fix bad memory access error with some games."
msgstr "Може да коригира грешката за лош достъп до паметта в някои игри."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Може да коригира разместени 2D изображения като избора на герой в Mario Kart."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Може да коригира някои грешки, които се случват дори на оригиналния хардуер."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Може да коригира някои игри при неродна резолюция чрез закръгляне на 2D ръбовете."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Може да коригира някои проблеми с контролерите XBOX."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Може да подобри точността с малка загуба на производителност."

msgctxt "game_options"
msgid "Can improve framerate or cause timing error."
msgstr "Може да подобри кадровата честота или да причини грешки в тайминга."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Може да подобри производителността на мощни GPU със свободен капацитет. Работи само с рендерера Vulkan."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Може да увеличи производителността на някои по-слаби системи."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Може да увеличи производителността при мощен GPU."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Може да се използва само ако контролерът поддържа управление с движение."

msgctxt "game_options"
msgid "Can reduce input latency, but will inscrease CPU requirements."
msgstr "Може да намали закъснението на входа, но увеличава изискванията към CPU."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Може да намали накъсването при компилиране на шейдърите, но може и да създаде артефакти."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Може да намали закъснението или да премахне долната линия на Wii с цената на графични проблеми."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Ограничава кадровата честота до оригиналните 35 fps."

msgctxt "game_options"
msgid "Certain games require an external cartridge to run."
msgstr "Някои игри изискват външен картридж, за да работят."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Превключва управлението с кръстачката между джойстик и мишка."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Променя пропорциите на долния екран."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "Променя пропорциите на горния екран."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Променя пътя за разархивираните игри (по подразбиране „\roms\.uncompressed“)."

msgctxt "game_options"
msgid "Change the emulated audio chip model."
msgstr "Променя модела на емулирания аудио чип."

msgctxt "game_options"
msgid "Change the renderer used by the core."
msgstr "Променя рендерера, използван от ядрото."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Променя рендерера, използван от ядрото. Игрите със стрелба работят само със СОФТУЕРЕН."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Променя чувствителността на аналоговия стик."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Променя чувствителността на мишката."

msgctxt "game_options"
msgid "Change this only if multiple GPU are used by your system."
msgstr "Променете само ако системата ви използва няколко GPU."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Променете тази настройка според управлението на играта; вляво от знака / е оригиналният бутон на играта за ускорение и спиране, вдясно – за скоростите."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Променете тази настройка според управлението на играта."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Променете тази настройка при нестабилни игри. Колкото по-висока е стойността, толкова по-добра стабилност може да осигури. 200μs и 400μs обикновено са добри за повечето игри."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Променя разпределението на нишките на емулатора по ядрата на CPU. Планировчиците на RPCS3 може да помогнат на CPU с няколко CCX/CCD клъстера или SMT, но Операционна система е най-безопасният избор на повечето машини."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Променя показването на оръжията в Rambo."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Променя звуковия чип, началния екран TMSS и няколко хардуерни особености."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Чип за генериране на символи. Автоматично избира съответстващия на избраната машина."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "Чийтовете трябва да се поставят в папката \bios\pcsx2\cheats."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "Чийтовете трябва да се поставят в папката „cheats\mame“."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "Чийтовете трябва да се поставят в папката „cheats\psxmame“."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Проверява всеки ROM срещу базата данни на игрите. Изключете само за тестване на romset, който не се зарежда: грешни ROM могат да причинят забиване или повреда на записите. Включено по подразбиране."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Проверява за повредени файлове при стартиране на игра."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Чипсет, използван при избран AGA модел. Намалете под AGA само за тестване на игра, която не работи правилно на A1200."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Изберете „Trojan Phazer“ за игрите, писани за този пистолет. „Светлинна писалка“ подхожда на всичко останало, включително програмите за рисуване."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "Изберете MSX разширение, което да се добави във втория слот за картридж."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Изберете между английска, френска или испанска клавиатурна подредба."

msgctxt "game_options"
msgid "Choose between various texture enhancement filters."
msgstr "Изберете между различни филтри за подобряване на текстурите."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Изберете бутон за включване на IR на десния стик."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Изберете бутон за симулиране на замах с десния стик."

msgctxt "game_options"
msgid "Choose if the mouse input is active or not."
msgstr "Изберете дали входът от мишката да е активен."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Изберете дали комбинацията за размяна на екраните ги разменя трайно или само докато бутонът е задържан."

msgctxt "game_options"
msgid "Choose the audio driver compatible with the hardware."
msgstr "Изберете аудио драйвера, съвместим с хардуера."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Изберете цветовата палитра."

msgctxt "game_options"
msgid "Choose the disposition of the emulated screens."
msgstr "Изберете разположението на емулираните екрани."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Изберете разширението, свързано към контролера."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Изберете второто разположение на емулираните екрани."

msgctxt "game_options"
msgid "Choose which Atari system to emulate."
msgstr "Изберете коя система Atari да се емулира."

msgctxt "game_options"
msgid "Choose which color palette is going to be used"
msgstr "Изберете коя цветова палитра да се използва"

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Изберете коя цветова палитра да се използва."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Изберете кое устройство управлява менюто за управление на дисковете. Другите устройства остават монтирани. Зареденият носител използва устройството, в което е заредена играта."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "Класически използва десния и левия раменен бутон за силен ритник и удар, модерен използва десния раменен бутон и десния тригер."

msgctxt "game_options"
msgid "Cleans up stray black pixels."
msgstr "Почиства случайните черни пиксели."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Цветова палитра за оригиналните игри за Game Boy."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Цветова температура на аркадния монитор."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Цветове на игрите за WonderSwan (моно). Палитрите WS имитират оригиналните екрани."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "Задава разстоянието между двата екрана в пиксели."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "Задава зрителното поле (по-високо е по-широко)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Задава FPS."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Задайте тази настройка, ако искате да превключвате между стерео и съраунд звук."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Задава как се заявяват контролерите от хоста или клиента. Задължително за локална връзка с много играчи."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Свързва мишката към порт 1."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Вариант на конзолата, съответстващ на избрания BIOS."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "Управлява нивото на точност на модула за смесване на GS. По-високите стойности емулират смесването по-точно в шейдъра."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Управлява трилинейното филтриране на текстурите в емулацията."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Управлява начина на прилагане на дизеринга."

msgctxt "game_options"
msgid "Controls the number of Auto-CRC fixes and hacks applied to games."
msgstr "Управлява броя на корекциите и хаковете Auto-CRC, прилагани към игрите."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Управлява подробността преди показване на програмата."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Преобразува gearup/geardown в gear3/gear4 за симулация на последователни скорости със стандартен скоростен лост."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Копира текстурите във VRAM, по-бавно, но по-точно. Изключете, за да спестите производителност."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Копира цветовия буфер в паметта на N64. Нужно за някои ефекти (напр. екрани за пауза, снимки от камерата). ИЗКЛ. е най-бързо, но може да ги счупи. АВТОМАТИЧНО следва режима на производителност."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Правилно, но по-бавно."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Коригира пропорциите на неквадратните пиксели."

msgctxt "game_options"
msgid "Correct the sampling of 2D sprite textures when upscaling."
msgstr "Коригира семплирането на текстурите на 2D спрайтовете при мащабиране."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Изрязва потенциално случайния дефектен видео изход, който би бил скрит от рамката около екрана на телевизор със стандартна резолюция."

msgctxt "game_options"
msgid "Crop out the potentially video output that would have been hidden by the bezel."
msgstr "Изрязва видео изхода, който би бил скрит от рамката на телевизора."

msgctxt "game_options"
msgid "Crop pixels around edge of screen."
msgstr "Изрязва пикселите по краищата на екрана."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "Изрязва картината от родните ѝ пропорции до 4:3 или 16:9"

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "Изрязва рамките, за да покаже или скрие графиката в тях."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "Изрязва изображението от 256x240 до 252x239."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Гранична честота на филтъра на аудио изхода на конзолата. 3390 Hz съответства на повечето модели Mega Drive."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "Изрязва 8 пиксела по краищата, за да премахне рамките на Master System."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "Размер на DIMM платката. Автоматично следва играта; оставете Автоматично, освен ако игра не се оплаква."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Намалява люлеенето на преследващата камера в състезателните игри. Силно по подразбиране."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Затъмнява всеки втори ред, за да имитира катодна тръба."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "DeSmuME има вграден BIOS; изберете тази опция, за да използвате BIOS и фърмуера от папката bios на RetroBat."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Намалете, ако е твърде чувствително; прекаленото намаляване може да попречи на пълния обхват."

msgctxt "game_options"
msgid "Default ON."
msgstr "ВКЛ. по подразбиране."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "Емулираният геймпад по подразбиране е с 6 бутона."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Включено по подразбиране, може да създава проблеми в някои игри."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "По подразбиране следва езика на EmulationStation."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "По подразбиране е „ВИСОКО“; задайте „НОРМАЛНО“ за по-висока производителност с цената на точността."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "По подразбиране 30 секунди; задава времето за изчакване на стартирането на играта преди връщане към списъка с игри на RetroBat."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "ИЗКЛ. по подразбиране; използвайте при проблем със скоростта на дисплеи с висока честота на опресняване."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "ВКЛ. по подразбиране (бързо). ИЗКЛ. изпълнява истинските DSP програми за геометрия – по-точно, но по-бавно (само игри за Model 1, Model 2 2B)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "ВКЛ. по подразбиране – правилно рендиране на четириъгълниците. ИЗКЛ. ги рендира като триъгълници (по-бързо)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "ВКЛ. по подразбиране; ИЗКЛ. може да подобри съвместимостта на по-стари GPU (само Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "ВКЛ. по подразбиране; използвайте тази настройка, за да премахнете ограничението от 60hz, може да счупи игрите."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Включено по подразбиране; изключете, за да видите началната анимация."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "По подразбиране 10 бита за DS и 16 бита за DSi."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "По подразбиране Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "По подразбиране WIIU Gamepad; променете за игрите, които не приемат WIIU Gamepad в режим за много играчи."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "По подразбиране: скрит курсор."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "По подразбиране: включено."

msgctxt "game_options"
msgid "Default: low."
msgstr "По подразбиране: ниско."

msgctxt "game_options"
msgid "Default: true"
msgstr "По подразбиране: true"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "По подразбиране 60, когато е 0 и VSYNC е включен."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Задава BIOS за емулацията."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "Задава типа геймпад, прилага се за двамата играчи."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "Задава модела на компютъра PET."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "Задава устройството Symbian за стартиране."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Задава бутона за показване на екрана на Gamepad, по подразбиране няма."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Задава колко RAM ще има емулираната машина."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Задава как да изглежда курсорът на долния екран."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Задава как играта се побира или мащабира в прозореца."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Задава как да се конфигурира Sinden Gun."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Задава присвояването на бутоните A и B на GunCon (Start и Back на Justifier). По подразбиране: кръстачка дясно/ляво с Wiimote на DolphinBar, бутоните на мишката с другите пистолети."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "Задава присвояването на бутоните на GunCon2."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Задава как се емулира сензорният екран."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Задава как е свързан Wiimote към DolphinBar."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Задава дали да се прилага кръпка и къде са файловете с кръпки; „АВТОМАТИЧНО“ прилага кръпките, ако са до ROM със същото име като ROM файла."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Задава присвояването на бутоните на мишката (ляв/десен/среден), по подразбиране a/презареждане/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "Задава типа модел и региона."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Задава модела, по подразбиране BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Задава модела, по подразбиране CPC 6128+ за GX4000."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "Задава модела, по подразбиране Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Задава индекса на мишката за играч 1."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "Задава индекса на мишката за играч 2."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Задава индекса на мишката за играч 3."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Задава индекса на мишката за играч 4."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Задава пътя до потребителския файл controls.ini."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "Задава региона, използван за записите."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Задава комбинацията от бутони, която се задържа за превключване на контролера DualShock между аналогов и цифров режим."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Задава цветовата палитра; Стар NTSC възпроизвежда старите грозни цветове на японските телевизори."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "Задава свързаното устройство, което емулира Dial."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Задава свързаното устройство, което емулира педал."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "Задава свързаното устройство, което емулира позиционно устройство."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "Задава свързаното устройство, което емулира trackball."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "Задава свързаното устройство, което емулира светлинен пистолет."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Задава свързаното устройство, което емулира мишка."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "Задава свързаното устройство, което емулира paddle."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Задава свързаното устройство, което емулира аналогов стик за посоки."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Задава типа на емулирания джойстик."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Задава типа на емулираната машина."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "Задава функцията на десния джойстик."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "Задава клавишната комбинация за влизане в диагностичното меню."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Задава нивото на вибрацията и разклащането на екрана; включете разклащането на екрана, ако контролерът не поддържа вибрация. „АВТОМАТИЧНО“ включва и двете."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Задава мястото на държаното оръжие."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Задава присвояването на КРЪСТАЧКАТА."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Задава броя на емулираните карти с памет."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Задава броя на пикселите за изрязване."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Задава звука, който ще получава емулираният микрофон."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "Задава типа устройство за движение на показалеца."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Задава типа монитор, променя цветовете."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Задава типа на емулирания контролер."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "Задава типа прицел за пистолетите."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Задава къде се намират бутоните за монета и start."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Задава дали комбинацията за „превъртане напред“ действа като превключвател или трябва да се задържа."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Задава дали комбинацията за „забавен кадър“ действа като превключвател или трябва да се задържа."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Задава кой звук на Game Boy се извежда от системата."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Задава кой аналогов стик управлява показалеца на мишката."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "Задава кой бутон включва турбо режима; това не е бутонът, който става турбо."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Градуси на завъртане на волана, достигащи пълния завой в играта. 270 е аркадната кабина."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Отказва записите при заетост."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "В зависимост от конфигурацията може да увеличи или намали закъснението."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Устройство, включено в игровия порт на Apple II. Аналоговият стик дава плавно движение на paddle, кръстачката отива само изцяло вляво или вдясно."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Тип устройство за играч 2."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Само DirectInput: използвайте, ако контролерите не управляват правилните играчи."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Изключва проверката на подписа на XBE при homebrew игри."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Изключва настройките за всяка игра на Xenia Edge, за да се прилагат настройките на RetroBat."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Изключва защитните функции на ядрото, за да могат някои homebrew игри да стартират."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Изключва дизеринга и използва пълната цветова информация от 8 бита на канал."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Изключва ефектите на мъглата."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Изключва хардуерния рендерер, може да подобри съвместимостта."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Изключва клавишните комбинации и дава пълен достъп до клавиатурата на ядрото. Превключва се с клавиша „Scroll Lock“."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Изключва modifier volumes, използвани за рендиране на сенките."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "Изключването на пикселните шейдъри може да спре забиването на някои игри; не включвайте, освен ако играта не го изисква."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Изключва FM чипа на Master System."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Изключва менюто на Visual Pinball: клавишът за изход (X) затваря масата директно."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Изключва аналоговото бутало (десен стик) и аналоговото побутване (ляв стик)."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Изключва проверката на камерата на кабината."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "Изключва проверката на artwork в папката „saves\mame\artwork“."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "Изключва аплета за контролери, който се появява в игрите за много играчи за избор на свързаните контролери."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Изключва менюто в играта, отваряно с HOTKEY + ДЕСЕН или F12."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Изключете тази опция, за да се центрира IR показалецът при отпускане на стика."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Изключете тази опция за по-добра производителност."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Изключете тази опция, за да стартирате директно .bat или .cmd файл, без RetroBat да търси изпълнимия файл в него."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Изключете, за да присвоите R2 и L2 на бутоните L и R (нецифрово)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Изключва използването на оста X за побутване, оста Y за наклон и оста Z за буталото."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Изключва предупреждението при стартиране на игри, които не се поддържат напълно."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Изключва вибрацията на геймпада; по подразбиране вибрацията е включена само ако играта и контролерът са съвместими."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Изключва автоматичните настройки за всяка игра от базата данни на ядрото и включва ръчните корекции по-долу. Не се препоръчва."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Изключва интерполацията на движението, с един кадър по-малко закъснение."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Изключва vertex кеша. Може да реши проблеми с липсваща или трептяща графика. Може да намали производителността."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "Изключването на дизеринга може да премахне част от шума и пикселизацията."

msgctxt "game_options"
msgid "Disabling safe features can help various games such as Xenosaga, Kingdom Hearts..."
msgstr "Изключването на безопасните функции може да помогне на различни игри като Xenosaga, Kingdom Hearts..."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "Изключването на разширението 4MB RAM pack може да е необходимо за някои игри."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Изключването на тази функция намалява цветовата дълбочина."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "Показва менюто на MAME при зареждане на игра."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "Показва рамките на SGB при емулиране на Super Game Boy."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Показва съобщение при отключване на постижение. Включено по подразбиране."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Показва малък показалец на сензорния екран."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Показва лента за опит над колана."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Пропорции на картината на LaserActive, 4:3 по подразбиране."

msgctxt "game_options"
msgid "Display crosshair if a lightgun is used."
msgstr "Показва прицела, ако се използва светлинен пистолет."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Показва текущите стойности на живот и мана върху сферите."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Показва щетите и опита като плаващи числа."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Показва времето в нивото, намерените тайни и убитите врагове."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Показване на втория екран (сензорния) на Primeval Hunt."

msgctxt "game_options"
msgid "Display or not on-screen notifications."
msgstr "Показва или скрива екранните известия."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Показва граничните области на екрана. Не влияе на изхода на F18A."

msgctxt "game_options"
msgid "Display the emulated framebuffer at a widescreen aspect ratio. Get best results with full 3D games."
msgstr "Показва емулирания framebuffer в широкоекранни пропорции. Най-добри резултати с изцяло 3D игри."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Показва играта в 16:9. Най-добре с ПРОПОРЦИИ НА ИГРАТА на 16/9."

msgctxt "game_options"
msgid "Display the overscan regions of the screen."
msgstr "Показва областите на overscan на екрана."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Показва екрана на VMU на играч 1 върху играта."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Дисплей при стартиране. Може да се сменя в играта с клавиша F7 (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Показва воксели вместо плоски спрайтове, когато са налични. Включено по подразбиране."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Дизеринг на суперсемплираните ефекти във framebuffer."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Дизеринг, прилаган към изображенията на framebuffer в RDRAM."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Дели вътрешната резолюция: при висока вътрешна резолюция по-високите стойности уголемяват играта. По подразбиране: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 е много тъмна игра, увеличете, за да изсветлите картината."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Удвоява възприеманата хоризонтална резолюция, несъвместимо със суперсемплирането."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Намалява увеличеното изображение (SSAA). Изисква увеличаване."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Чертае пейзажа до края на трасето в игрите, които го поддържат (Daytona USA). Само Model 1 и Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Устройство, използвано при смяната на дискове."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick: Robotron 2084 и Space Dungeon на десния стик. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: джойстици с много бутони."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Дублирането на кадрите изисква рендерера Vulkan."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Динамична рекомпилация. Повечето игри работят по-бързо, някои по-бавно."

msgctxt "game_options"
msgid "Efficient graphics filters improving the rendering of games."
msgstr "Ефективни графични филтри, подобряващи изображението на игрите."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Премахва изкривяването и деформацията на текстурите при мащабиране."

msgctxt "game_options"
msgid "Eliminates position-dependent distortion and warping of textures."
msgstr "Премахва зависещите от позицията изкривяване и деформация на текстурите."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Емулира бузерите Buzz! върху геймпадовете ви. Един контролер покрива 4 бузера (играчи 1-4), два контролера покриват 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Емулира tiling на паметта на PS3. Коригира графичните грешки в някои игри с малка загуба на производителност."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Емулира модула за гласово разпознаване (VRU) (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Емулира грамофон DJ Hero върху геймпадовете ви. Необходимо за DJ Hero 1 и 2."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Емулира контролер Guitar Hero Live (GHLtar) върху геймпадовете ви. Необходимо за Guitar Hero Live."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Емулира New 3DS или оригинален 3DS."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Емулира PlayStation TV за локална игра с много играчи (до 4 контролера). Еднакви контролери не се поддържат, игрите със сензорен екран може да не работят."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Емулира конкретно управление с движение. „/“ означава действието за левия/десния стик."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Емулира контролер spinner, управляван с движението на мишката. Бутоните на мишката са присвоени на левия (жълт) и десния (червен) бутон."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Емулира честотата на vblank за NTSC от 59,94Hz вместо 60Hz. Коригира тайминга и разминаването на звука в някои NTSC игри."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Емулира базата Disney Infinity."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Емулира Game Boy Player, за да включи вибрацията в съвместимите игри."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Емулира аксесоара toypad на LEGO Dimensions."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Емулира портала Skylanders."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Емулира картата Video CD, изисква mpeg_card.bin в папката bios."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Емулира поведението на по-стари двигатели, необходимо за някои стари модове и демота."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Квант от време за емулираните нишки. Увеличаването може да помогне на някои игри, намаляването може да направи други по-плавни."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Емулира ефектите на полупрозрачност на LCD, но увеличава размазването при движение."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Емулира подредбата на мултисемплирането на PS3. Може да коригира някои визуални артефакти в някои игри."

msgctxt "game_options"
msgid "Emulation method used. AUTO for mixed features with max performance and compatibility."
msgstr "Използван метод на емулация. АВТОМАТИЧНО за смесени функции с максимална производителност и съвместимост."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Сканиращи линии на емулатора, видими само в някои игри."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Включва мода 32MB RAM за Dreamcast, може да повлияе на съвместимостта."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "Включва стартирането в BIOS за игрите за DSi."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Включва емулацията на CMS."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Включва цифровия звуков процесор (DSP). Подобрява точността на звука с цената на по-високи изисквания към производителността."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Включва цифровия звуков процесор (DSP). Подобрява точността на звука с цената на производителността."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Включва услугата Discord Rich Presence; статусът ви в Discord ще показва играната игра."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Включва декодера Dolby Pro Logic II в съвместимите игри и високоговорители 5.1."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Включва адаптивното контрастно изостряне FidelityFX (CAS)."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Включва модула за плаваща запетая (FPU), обикновено полезен за по-късните 3D игри."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Включва емулацията на Gravis Ultrasound."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "Включва HDR за HDR съвместими дисплеи."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Включва емулацията на IBM PS/1 Audio (изключено по подразбиране)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Включва емулацията Just In Time, увеличава скоростта на емулацията, несъвместима с cycle exact."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "Включва вътрешното пренастройване на управлението в MAME."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "Включва опцията на MAME за автоматична конфигурация на подредбата на бутоните за всяка игра според вътрешната ѝ база данни."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "Включва емулирания BIOS на MelonDS вместо фърмуерите в папката bios."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "Включва рендерера OpenGL, драйверът на RetroArch трябва да е OpenGL."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "Включва емулацията на PAL (50Hz) NES."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Включва RAM картриджа на Sega CD."

msgctxt "game_options"
msgid "Enable Service button to enter settings."
msgstr "Включва бутона Service за влизане в настройките."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Включва емулацията на Tandy Sound."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Включва допълнителна RAM за разработчици, може да счупи игрите."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Включва изглаждането, изглажда ръбовете на полигоните."

msgctxt "game_options"
msgid "Enable blargg NTSC video filters"
msgstr "Включва видео филтрите blargg NTSC"

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Включва увеличаване/намаляване с груба сила (само 10.8.0)"

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Включва монтирането на кеша"

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "Включва хвърлянето на сенки от обектите в играта, съвместимо само с OpenGL."

msgctxt "game_options"
msgid "Enable certain games with support for the 3Dfx Voodoo accelerator."
msgstr "Включва някои игри с поддръжка на ускорителя 3Dfx Voodoo."

msgctxt "game_options"
msgid "Enable colorization of Game Boy games."
msgstr "Включва оцветяването на игрите за Game Boy."

msgctxt "game_options"
msgid "Enable controller's rumble effects."
msgstr "Включва ефектите на вибрация на контролера."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Включва ефектите на вибрация на контролера. Работи само в състезателните игри."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Включва прицелите в игрите със стрелба; опциите (DS) са съвместими само с DemulShooter."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Включва прицелите в игрите със стрелба."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Включва потребителска резолюция според видео режима."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Включва динамичните рекомпилатори, които подобряват производителността."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Включва разширените функции за DS4 и DualSense; това нарушава съвместимостта с емулаторите, използващи dinput, докато не се изключи."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Включва force feedback за поддържаните контролери."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Включва изглаждането на цял екран в Direct3D, изглажда ръбовете на полигоните."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Включва филтъра за хоризонтално смесване (размазване)."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Включете, ако воланът се избутва навън от центъра, вместо към него."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Включва прицела в играта за по-лесно прицелване."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Включва функцията за интелигентно мащабиране."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Включва IPS кръпките."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "Включва по-малко точната, но по-добре звучаща емулация на звука на Namco 106 (mapper 19)."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Включва ръчните хакове по-долу, иначе хаковете се прилагат автоматично."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Включва управлението с движение (жироскоп) с мишка или със съвместим контролер."

msgctxt "game_options"
msgid "Enable multitap in port 1."
msgstr "Включва multitap в порт 1."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Включва multitap в порт 2."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Включва прогресивното сканиране за съвместимите игри."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Включва режима run-ahead за намаляване на закъснението на входа."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Включва IBM Music Feature Card (изключено по подразбиране)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "Включва FM чипа на Master System."

msgctxt "game_options"
msgid "Enable the Memory Management Unit. Required for some games."
msgstr "Включва устройството за управление на паметта (MMU). Необходимо за някои игри."

msgctxt "game_options"
msgid "Enable the On Screen Keyboard feature which can be activated with the L3 button."
msgstr "Включва екранната клавиатура, която се активира с бутона L3."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Включва ефектите на чийтовете, активирани в интерфейса на Vita3K."

msgctxt "game_options"
msgid "Enable the effects of the chosen Action Replay and Gecko codes for a game."
msgstr "Включва ефектите на избраните кодове Action Replay и Gecko за игра."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Включва емулацията на геймпадовете Jaguar, включени в разширените портове за джойстик на Atari STE."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Включва използването на мишката за сензорния екран вместо десния стик."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Включете, ако индексите на контролерите XInput са разменени."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Включете, ако контролерът няма аналогови тригери."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Включете, ако имате монитор с G-Sync/FreeSync, може да причини аудио грешки."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Включете тази опция при проблеми с графичен чип Intel."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Включете тази опция при липсваща графика или грешно осветяване в играта."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Включете тази опция, когато използвате mamehooker с LED, соленоиди, вибрация..."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Включете, за да разрешите шейдърите, дори когато в RetroBat не е зададен шейдър."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Включете, за да включите джойстика на Играч 1 в левия порт вместо в десния."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Включете, за да използвате шейдърите на Duckstation."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Включете, за да използвате собствените си настройки за всяка игра от Project64."

msgctxt "game_options"
msgid "Enable verbose mode for debugging."
msgstr "Включва подробния режим за дебъг."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Включено по подразбиране (АВТОМАТИЧНО)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Включено по подразбиране, подобрява преноса на данни през емулирания SIO порт."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Включено по подразбиране."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Включено по подразбиране. Изключва дизеринга и налага 24-битов цветови изход."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Включено по подразбиране. Изключването може да подобри производителността, но чупи някои игри."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Включено по подразбиране. По-бързи шейдъри, рядко могат да причинят графични проблеми."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Включено по подразбиране. Коригира графичните грешки в някои игри с малка загуба на производителност."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Включено по подразбиране. Премахва размазването в някои игри, но намалява точността."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Включено по подразбиране. Заменя спрайтовете на играта с HD пакет, когато има такъв. Изисква рестарт."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Включено по подразбиране. Показва съобщенията от самия емулатор."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Включено по подразбиране. Когато е изключено, кадровата честота е ограничена до 60 FPS."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Включено по подразбиране. Когато е изключено, кадровата честота се ограничава от играта."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Включва режим 60HZ за намаляване на разкъсването на дисплеи, които не поддържат работа над 60HZ."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Включва автоматичното генериране на mipmap в Direct3D."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Включва високата резолюция на WRX."

msgctxt "game_options"
msgid "Enables a low pass audio filter to soften the harsh sound of some games."
msgstr "Включва нискочестотен аудио филтър, омекотяващ острия звук на някои игри."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Включва хака против размазване – по-малко точно, но игрите са по-малко размазани."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Стрелките, CTRL и ALT действат като джойстик и бутони за стрелба."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Включва функцията за потребителски кръпки."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Включва рендиране на CEL във висока резолюция."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Включва превключването между различни видео сигнали."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Включването може да създаде проблеми с контролерите 8BitDo."

msgctxt "game_options"
msgid "Enabling this will downsampling to native color depth. Disabling enable output at higher color depth."
msgstr "Включването намалява до родната цветова дълбочина. Изключването позволява изход с по-висока цветова дълбочина."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Налага стриктно спазване на спецификацията на API. Може да намали производителността в някои игри. Може да реши редки случаи на липсваща графика и трептене."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Подобрява точността на графиката с цената на по-високи изисквания към производителността."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "Подобрява сенките на различните обекти."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "Подобрява качеството на 2D текстурите."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface."
msgstr "Подобрява качеството на текстурите по повърхностите."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Подобрява качеството на текстурите по повърхностите. Само OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Подобрява качеството на текстурите по повърхностите. Само Vulkan и OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Филтър за подобрение, прилаган към текстурите."

msgctxt "game_options"
msgid "Enhancement. Reduces system slowdown. Causes issues in some games."
msgstr "Подобрение. Намалява забавянията на системата. Създава проблеми в някои игри."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Въведете локалния UDP порт за хостване."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Въведете адреса на сървъра."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Въведете първите символи на ROM на играта, използван за пренос на данни."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Въведете първите символи на файла със записи, използван за пренос на данни."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Въведете сензорния профил за зареждане."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Реверберация на средата (EFX), включено по подразбиране."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Прецизен е най-близо до конзолата и най-тежък за GPU. Бърз е много по-лек. Автоматично избира бърз при слаби или нестабилни GPU."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "Изпълнява графичния бекенд във втора нишка; подобрява производителността, намалява накъсването и ускорява компилирането на шейдърите."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Разширява картата с памет SAMS до 4M."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Картридж за разширение, поставен в конзолата. Игрите с известно изискване налагат това автоматично."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Експериментирайте с тази опция, ако джойстикът ви се отклонява (включено по подразбиране)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Експериментално, само за Windows. Защитава данните в стека на играта, когато емулаторът обработва изключения в паметта. Може да спре забиванията в някои игри. Оставете изключено, освен ако игра не го изисква."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Допълнителен контролер. Оставете празно, освен ако играта не изисква такъв."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Допълнителна карта с памет, само за моделите //e. Няколко програми изискват повече от стандартните 64KB."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "Чувствителност на мишката на FM Towns."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Бързо приблизително изглаждане (FXAA), по-леко от MSAA, но по-размазано."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Бърз може да подобри производителността, но може да е нестабилен с някои драйвери."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "ROM за бързо зареждане от диск. Изисква ИСТИНСКА ЕМУЛАЦИЯ НА УСТРОЙСТВОТО и ROM на JiffyDOS в „bios\vice“. Не се използва с касети и картриджи."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Бърз е по-малко точен, подреден и атомарен е точен, но по-бавен."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "По-бърз двигател за емулация на DSP (експериментален). Използва се само когато ЕМУЛАЦИЯ НА DSP е включена."

msgctxt "game_options"
msgid "Faster loading times but can cause issues with some games."
msgstr "По-бързо зареждане, но може да създаде проблеми в някои игри."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "По-бързо четене на секторите. Някои програми може да не го очакват."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Филтрира всички текстури, включително тези, които играта изрично задава като нефилтрирани. Изключено по подразбиране."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Филтър, прилаган към крайното изображение."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Филтър за мащабиране на картината към екрана."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Филтър при мащабиране на крайното изображение."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Филтър, когато рендираното изображение е по-голямо от екрана."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Филтър, когато рендираното изображение е по-малко от екрана."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Филтриране, прилагано към 3D текстурите."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Филтриране, прилагано към 3D текстурите. Само OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Филтриране, прилагано към спрайтовете и 2D елементите."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Стреля непрекъснато, докато бутонът е натиснат."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Задейства мотора за откат на пистолета при всеки изстрел, при пистолетите, които имат такъв. Включено по подразбиране."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Побира игрите във висока резолюция или широк екран в кадър 640x480 с черни рамки. Полезно само на 4:3 CRT телевизор."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Поставя цифровия видео картридж (vmpega.rom в папката bios), необходим за FMV игрите и Video CD."

msgctxt "game_options"
msgid "Fit to the original ratio of the game."
msgstr "Побира в оригиналните пропорции на играта."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Коригира грешка на Demul (излизане от цял екран при стрелба в горния ляв ъгъл), като блокира всички входове от мишката към интерфейса на Demul."

msgctxt "game_options"
msgid "Fix issues with upscaling in Namco games (Ace Combat, Tekken, SoulCalibur...)."
msgstr "Коригира проблемите с мащабирането в игрите на Namco (Ace Combat, Tekken, SoulCalibur...)."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Коригира забавянията с този емулатор."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Коригира повредата на текстурите и проблемите с дълбочината на AMD и някои Intel GPU."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Коригира цветовите ленти, които може да се появят в увеличените текстури."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Коригира зацикляне на играта при стартиране."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Коригира копланарната геометрия и декалите в някои игри, може да счупи други."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Коригира празнините между 2D елементите."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Коригира артефактите на сенките и дълбочината в някои игри."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Коригира някои графични грешки, свързани с линиите."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Коригира грешки в текста в някои игри."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Модул за плаваща запетая (FPU), нужен за някои 3D игри. Включен по подразбиране с 68040 (вграден), изключен с 68030."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Папка за данните на Vita3K (фърмуер, инсталирани игри, записи). Игнорира се, когато Vita3K е в преносим режим (непразна папка „portable“ до Vita3K.exe)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "ROM с шрифт, нужен за някои японски игри."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "За Bleach Blade Battlers."

msgctxt "game_options"
msgid "For Goemon."
msgstr "За Goemon."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "За системите на Nintendo разменя A и B, за да съответстват на имената на бутоните на Xbox."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "За Run Behind и игрите на M-bit."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "За HUD на SOCOM 2/Spy Hunter."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "За Scarface The World is Yours и Crash Tag Team Racing."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "За игрите за SegaScope 3-D показва само едното око вместо трептящата двойка."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "За Superman Returns."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "За Tales of Destiny."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "За игрите на Tri-Ace."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "За игрите с ASTC текстури изберете средно при GPU с 6GB VRAM и ниско при GPU с 4GB-2GB VRAM."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "За контролерите N64 с 2 тригера използва R2 вместо L2 като бутон Z."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "За носталгия. По подразбиране изглежда като ускорената мъгла на войната в BG2"

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "При някои емулатори може да се използва за коригиране на асоциирането на клавиатура и мишка с Wiimote при използване на 2 Wiimote."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Налага софтуер за GBC, който променя поведението си при работа на GBA."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "Налага режим Game Boy за Game Boy Color."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Налага индекса на геймпада на P1; може да е полезно, ако устройствата XInput не са подредени правилно."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "Налага индекса на геймпада на P1; може да е полезно при използване на контролер на аркадна машина."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "Налага индекса на геймпада на P2; може да е полезно при използване на контролер на аркадна машина."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Налага Raw Input; не би трябвало да е нужно да се включва."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Налага броя на CPU циклите за операция. АВТОМАТИЧНО използва стойността по подразбиране за играта; променете само ако някоя игра не работи."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Налага бутон вместо ос за тригерите, може да помогне с контролерите на Sony."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Налага емулатора на цял екран, дори ако RetroBat е в прозорец"

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Налага ограничителя на кадрите."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Налага начина на семплиране на текстурите. Най-близък съсед запазва пикселите остри, линейно ги изглажда."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Налага входния драйвер. По подразбиране „sdl“, „dinput“ ако са включени няколко пистолета."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Налага резолюцията на текущата резолюция на екрана за игрите, които позволяват потребителска резолюция."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Налага картриджа за разширение на Saturn, ако автоматичното откриване не успее."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Налага региона на Saturn, ако автоматичното откриване не успее."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Налага стерео за всички ROM."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Налага модела Game Boy за емулиране, ако автоматичното откриване не успее."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Налага честотата на опресняване на VI. АВТОМАТИЧНО е правилно за почти всяка игра."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Налага действителното разположение на изходните канали. АУДИО КАНАЛИ задава какво вижда играта, а това определя как се смесва надолу към устройството ви. Оставете АВТОМАТИЧНО, освен ако изходното устройство не се разпознава грешно."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Налага включване или изключване на backglass. АВТОМАТИЧНО следва КОНФИГУРАЦИЯ НА ЕКРАНИТЕ (включено, когато КОНФИГУРАЦИЯ НА ЕКРАНИТЕ не е зададена)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Налага режима на билинейно филтриране при увеличаване на dirty правоъгълниците."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Налага устройството за зареждане (само модели 1F/2F и по-нови)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "Налага региона на конзолата."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Налага региона на конзолата. По подразбиране регионът се открива от играта."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Налага емулираната честота на опресняване вместо откриването ѝ от заредената игра. Изисква рестарт на ядрото."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Принуждава емулатора да използва конкретен BIOS файл."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches."
msgstr "Налага честотата на емулирания CPU. Може да намали забавянията, но може да причини грешки."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Налага честотата на емулирания CPU. Може да намали забавянията, но може да причини грешки. По подразбиране е 57%."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "Налага честотата на региона на играта, за да избегнете проблеми със скоростта на емулацията; оставете „Автоматично“, освен ако не забележите проблеми със скоростта."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Налага клавиатурата, ако са свързани няколко клавиатури."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Налага контролера на банките памет (MBC). Променете само ако някоя игра не работи правилно. Изисква рестарт на ядрото."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Налага монохромните режими на показване, като на зелен или кехлибарен монитор от епохата."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Налага броя Wiimote, които играта ще открие. Задайте 1 за игрите, които преминават в режим за много играчи веднага щом са свързани няколко контролера."

msgctxt "game_options"
msgid "Force the region of the system."
msgstr "Налага региона на системата."

msgctxt "game_options"
msgid "Force the rendering and display of frames to progressive mode."
msgstr "Налага рендирането и показването на кадрите в прогресивен режим."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "Налага типа на медийния файл"

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Налага SDL драйвера за контролерите; задайте при повече от 4 контролера, тъй като XInput е ограничен до 4 играчи."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Налага драйвера SDL или DInput за контролерите; задайте при повече от 4 контролера, тъй като XInput е ограничен до 4 играчи."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Налага използването на конкретен softlist; списъкът със софтуер трябва да е в папката „bios\mame\hash“."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Налага емулация на BIOS на високо ниво (HLE)."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Налага гласовия картридж в слот 1, изисква BIOS файла „voice.zip“."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "Налага индекса на волана; може да е полезно, ако RetroBat зададе грешен индекс."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "Налага честота на опресняване 60Hz."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "Налага конзолата в режим PAL вместо NTSC, може да изглежда тромаво."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Налага емулацията на blit и обработката на изображенията на CPU – по-точно в някои случаи и необходимо за игри като GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Налага драйвера Raw Input при използване на устройства като trackball и spinner."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Налага нивото на съвместимост на двигателя. Задайте MBF21 за WAD, които го изискват."

msgctxt "game_options"
msgid "Full precision of 12-bit for the MCM5205 ADPCM can reduce whining noise during ADPCM playback."
msgstr "Пълната 12-битова прецизност на ADPCM на MCM5205 може да намали свиренето при възпроизвеждане на ADPCM."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Резолюция на цял екран. По подразбиране се използва резолюцията на работния плот."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Пълно управление на камерата с десния стик."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "Записите на състоянието GST могат да се отварят от Kega и Gens, но съхраняват по-малко от състоянието на машината."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Усилване на силите на драйвер платката. 30% по подразбиране, 200% ги удвоява."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Резолюция на играта. По-високите стойности показват повече от игровата зона."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Ход на волана с геймпад в състезателните игри. 66% по подразбиране, не влияе на волан."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Геймпад: геймпадът и клавиатурата движат показалеца на CD-i. Мишка: мишката на компютъра движи показалеца (point and click и игри със стрелба), геймпадът запазва само бутоните си. Hotkey + L3 превключва по време на игра."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Геймпадовете стават играч 1, 2..., а аркадните стикове се присвояват на следващите играчи."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Хак за тайминга с общо предназначение."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "Немският и френският изискват PAL версия на играта, японският – NTSC версия."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Дава цялата клавиатура на играта (Scroll Lock я връща на клавишните комбинации) и захваща мишката. Геймпадът продължава да работи."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Добро при проблеми с емулацията на кеша."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Графичен чипсет за моделите без AGA. Автоматично следва избрания модел, което почти винаги е желаното."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Графичен плъгин за рендиране на играта."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Предварителна настройка на графичното качество (текстури, филтриране). АВТОМАТИЧНО я избира според количеството памет."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Силно влияе на производителността на CPU."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Значително подобрява качеството на текстурите, генерирани с ефекти render-to-texture. Включено по подразбиране. Изключването може да предотврати забиванията в игри с потребителски текстури."

msgctxt "game_options"
msgid "Greatly inscrease the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Значително подобрява качеството на текстурите, генерирани с ефекти render-to-texture. Включено по подразбиране. Изключването може да предотврати забиванията в игри с потребителски текстури."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Игри със стрелба с контролер (без светлинен пистолет). Относителен: стикът движи курсора. Абсолютен: позицията на стика е позицията на екрана, връща се в центъра при отпускане."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE е бърз, LLE е по-точен, но изисква ROM файловете на DSP."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START изпраща клавиша за изход (X) към Visual Pinball, вместо да затваря прозореца му."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START изпраща клавиша за изход (X) към Visual Pinball, вместо да затваря прозореца му: отваря се менюто му (масата се затваря с ИЗКЛЮЧВАНЕ НА МЕНЮТО)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 бърз запис, START+L3 бързо зареждане, START+R3 екранна снимка. Включено по подразбиране."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Хак, нужен за някои игри (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Хак, нужен за някои игри."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Половин сканиращи линии имитират CRT дисплей. 560 x 192 дава по-чиста картина на плосък панел."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Контролер за твърд диск, нужен за стартиране на образи на твърди дискове .hdv и .2mg. Промяната рестартира машината."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Скрито по подразбиране; изключете, ако някоя игра не стартира правилно."

msgctxt "game_options"
msgid "Hide in-game crosshair (game dependant)."
msgstr "Скрива прицела в играта (зависи от играта)."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Скрива модела на оръжието в играта (зависи от играта)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Скрива показалеца на сензорния екран при неактивност (изтичане на време)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Скрива подсказките за компилацията на шейдърите и PPU."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Скрива прицела след известно време без прицелване или стрелба. Връща се веднага щом прицелите отново."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Скрива краищата на картината както телевизор или добавя рамка (отрицателни стойности)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Скрива белия блясък при всеки изстрел."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Емулация на високо ниво на някои функции на Portfolio OS. Може да подобри производителността в някои игри."

msgctxt "game_options"
msgid "High sound quality for games using expansion audio"
msgstr "Високо качество на звука за игрите с разширено аудио"

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "По-високата точност коригира грешки в някои игри с цената на производителността. Използва се само ако декодерът на SPU е Динамичен или LLVM."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "По-висока кадрова честота чрез интерполация на кадрите, ограничена от вертикалната синхронизация. Може да причини малки визуални грешки или грешки в анимацията."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "По-високото е по-точно, но по-бавно."

msgctxt "game_options"
msgid "Higher values give better signal noise ratio and preservation of higher frequencies."
msgstr "По-високите стойности дават по-добро съотношение сигнал/шум и запазване на високите честоти."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "По-високите стойности използват по-малко памет, по-ниските работят по-бързо."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Корекция на скоростта на House of the Dead 4: честота на CPU в GHz (напр. 4.3). Открива се автоматично, когато не е зададена."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Колко трябва да се премести стикът, преди Amiga да го отчете. Увеличете, ако героят се движи сам."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Колко бързо се движи paddle."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Колко бързо се движат paddle, когато мишката се използва като устройство за игровия порт."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Каква част от ширината на екрана преминава paddle от край до край. По-малка стойност прави paddle по-бърз и му позволява да достигне крайните си точки, без показалецът да излезе от екрана, което е нужно за някои екрани за калибриране."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Колко силно реагира стикът."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Как се показват екранът на телевизора и екранът на GamePad."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Как геймпадът се представя на Amiga."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Как геймпадът се представя на Amiga. „Joystick“ е класическият стик с 2 бутона, който всяка игра разбира. „CD32 pad“ добавя цветните бутони и се избира автоматично на CD32."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Как се рендира картината. RGB е най-остро, композитните и телевизионните режими възпроизвеждат преливането на цветовете на дисплеите от епохата."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Как се рендира картината. Композитните режими възпроизвеждат преливането на цветовете на дисплеите от епохата, RGB е най-остро."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Как се мащабира картината към екрана."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Хибриден чертае новите шейдъри веднага, докато се изграждат. Асинхронен може да остави обекти липсващи за момент. Синхронен кара играта да чака всеки шейдър."

msgctxt "game_options"
msgid "If Custom is selected it will use MesenPalette.pal as custom palette in bios directory."
msgstr "Ако е избрано Потребителски, ще се използва MesenPalette.pal в папката bios като потребителска палитра."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Ако е изключено, изключва шаблона за дизеринг, който PSX прилага срещу цветовите ленти."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Ако е изключено, DualShock може да се превключва между ЦИФРОВ/АНАЛОГОВ с комбинация."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Ако е изключено, тези модули ще се компилират само при нужда. В зависимост от играта това може да прекъсва играта неочаквано и вероятно често."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Ако са свързани няколко пистолета, задайте тази опция, за да се конфигурира само един пистолет."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Ако е нужно, задайте GBA ROM за използване."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Ако името на папката съдържа „soniccd“, RetroBat автоматично стартира Sonic CD RSDK; използвайте това, за да го наложите."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Ако джойстикът е в тази мъртва зона, курсорът няма да се движи."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Ако използвате геймпад със сензор за движение като DualShock или Switch Pro, включете, за да използвате сензора."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Ако използвате истински Wiimote със Sensor Bar, задайте правилната позиция на Sensor Bar за по-добра прецизност."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "Игнорира услугите на Horizon OS, може да реши забиванията в някои игри."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Игнорира движенията на аналоговия стик под този праг."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "Игнорира съществуващите ini файлове в папката „bios\mame\ini“."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Игнорира малките движения на стика около центъра. Увеличете, когато курсорът на екрана се движи сам."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Игнорира специфичните за масата настройки на backglass (.res файл до масата) по време на играта. Файлът се запазва и се възстановява при изход."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Игнорира настройките за всяка игра, записани в shadPS4, и винаги използва настройките на RetroBat."

msgctxt "game_options"
msgid "Improve performance at the cost of accuracy and input lag."
msgstr "Подобрява производителността с цената на точността и закъснението на входа."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Подобрява производителността при CPU с повече от 4 ядра, включено по подразбиране."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Подобрява производителността в много игри. Изключването може да предотврати графични дефекти в някои други игри."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "Подобрява рендирането на полигоните с рендерера OpenGL."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Подобрява точността на шейдърите. Изключването дава малка печалба на скорост, но може да причини графични грешки в някои игри."

msgctxt "game_options"
msgid "Improve the loading of discs of the emulated game."
msgstr "Подобрява зареждането на дисковете на емулираната игра."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements."
msgstr "Подобрява резолюцията с цената на по-високи изисквания към производителността."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Подобрява резолюцията с цената на по-високи изисквания към производителността. Само OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Подобрява резолюцията с цената на по-високи изисквания към производителността. Изисква ключ за Redream."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Подобрява резолюцията с цената на по-високи изисквания към производителността. Само Vulkan и OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Подобрява точността в някои игри, но може да намали производителността."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Подобрява цветовата дълбочина."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Подобрява производителността в някои игри, но пропуска всички ефекти, базирани на EFB."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Подобрява производителността."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Подобрява производителността. Експериментално при няколко конзоли."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Подобрява стабилността в някои игри, но намалява производителността."

msgctxt "game_options"
msgid "Improves the data loading speed."
msgstr "Подобрява скоростта на зареждане на данните."

msgctxt "game_options"
msgid "Improves the emulation performance at the cost of accuracy."
msgstr "Подобрява производителността на емулацията с цената на точността."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Само в OpenGL."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "При игри с няколко диска, когато използвате .m3u файл, задайте номера на диска за стартиране."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "Увеличава точността, може да коригира някои проблеми със звука и скоростта."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Увеличете, ако изстрелите се регистрират леко встрани от целта."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Увеличете, ако изгледът или играчът се движат сами."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Увеличете, ако изгледът или играчът се движат сами. По подразбиране е 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Увеличава резолюцията на 3DFx Voodoo OpenGL."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Увеличава броя спрайтове, които могат да се чертаят едновременно на екрана."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Увеличава използването на RAM и времето за първоначално стартиране, но намалява четенето от диска след стартиране."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "Увеличаването на стойността може да причини грешки."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Инициализира цветовите render target от емулираната памет. Нужно за правилното рендиране на някои игри, може да намали производителността. Изключено по подразбиране."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Инициализира render target за дълбочина от емулираната памет. Нужно за правилното рендиране на някои игри, може да намали производителността. Изключено по подразбиране."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Въведете сървъра за използване във формат „x.x.x.x:y“."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Поставя разширението MoonSound в I/O слота."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Поставя разширението Video9000 в I/O слота."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Поставя диск във флопи устройството, често се използва за CD-ROM игрите."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Инсталиран видео чип. Автоматично използва TMS9918A, освен ако играта не изисква подобрението F18A. Изисква рестарт на ядрото."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Интерполира аудио изхода за по-добро качество."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "Интерпретаторът е по-съвместим от динамичния рекомпилатор JIT, JIT е по-бърз."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Разменя бутоните A/B и X/Y."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Обръща сигнала на светлинния сензор на Zapper. Нужно за някои хардуерни пистолети."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Обръща сигнала на спусъка на Zapper. Нужно за някои хардуерни пистолети."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Обръща вертикалната ос на десния аналогов стик на геймпада."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "Обръща управлението на прицела нагоре и надолу."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Обръща гледането нагоре и надолу (геймпад и мишка)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Обръща гледането нагоре и надолу с геймпада."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Обръща гледането нагоре и надолу с десния стик."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Обръща вертикалната ос при летене."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT е най-бърз, интерпретаторът е по-точен."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Компилация Just In Time. Силно ускорява моделите 68020 и по-новите. Игнорира се на машините 68000 и автоматично се изключва в режим cycle exact."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Запазва DOS обвивката активна при излизане от играта или при неуспешно стартиране."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Запазва или изтрива файловете на игрите след разархивиране (squashfs, 7z)"

msgctxt "game_options"
msgid "Keep the CD image in memory."
msgstr "Запазва образа на CD в паметта."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Запазва оригиналните пропорции, вместо да разтяга картината."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Клавиш, отварящ собственото меню на Amiberry. F12 е единственият функционален клавиш, който Amiga никога не е имала, затова е единственият, който остава свободен."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Клавиш за превключване между прозорец и цял екран по време на емулацията."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Клавиши, използвани като джойстик, когато няма свързан контролер. Стрелките стрелят с десен Ctrl. Цифровата клавиатура стреля с 0 или 5. WASD стреля с ляв Alt."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 и R3 изпълняват специалните удари на текущия герой, когато играта ги изброява. Включено по подразбиране."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = Service, R3 = Test, за отваряне на операторското меню на игрите. Включено по подразбиране."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "LLVM е най-бързият, използвайте настройките на интерпретатора при проблеми."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "LLVM е най-бързата опция с много добра съвместимост. При проблеми използвайте рекомпилатора ASMJIT."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "Език, на който игрите да показват текста."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Език на менютата и текста в играта. Език, който не е наличен в играта, се игнорира и настройката в играта се запазва."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Език на субтитрите. Език, който не е наличен в играта, се игнорира и настройката в играта се запазва."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Език на гласовете. Език, който не е наличен в играта, се игнорира и настройката в играта се запазва."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Голямо ускорение при многоядрени CPU, но малко на брой игри блокират с него."

msgctxt "game_options"
msgid "Launch DemulShooter for gun games."
msgstr "Стартира DemulShooter за игрите със стрелба."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Стартира MameHooker за управление на изходите."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Оставете „Автоматично“, освен ако откриването не се провали."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Оставете АВТОМАТИЧНО по подразбиране, освен ако играта не изисква специфична настройка."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Оставете АВТОМАТИЧНО за автоматично откриване."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Оставете автоматично за автоматично адаптиране към ориентацията на играта; използвайте тази настройка, за да наложите при нужда."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Оставете изключено, освен ако източникът на синхронизация не е видео: vsync и аудио синхронизацията работят зле заедно."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Оставете АВТОМАТИЧНО, за да избере емулаторът първия валиден BIOS в „\bios\pcsx2\bios“."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Оставете Автоматично, за да запазите процесора, който избраният модел действително е имал. По-бърз CPU може да счупи игри, разчитащи на точен тайминг."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Оставете Автоматично, освен ако игра не изисква конкретен ROM. Файлът трябва да е в папката bios. Изисква рестарт на ядрото."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Оставете ВКЛ. по подразбиране, за да включите оптимизациите на CPU JIT."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Оставете на 16:9, освен ако нямате 4:3 монитор."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Оставете включено по подразбиране, ще използва няколко нишки за рендиране."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "РЪЧНО не променя зададената от потребителя стойност, АВТОМАТИЧНО е 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "Лявото става дясно, а горе става долу."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Оставя ALTIRRA да избере профила според играта."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Оставя RetroArch да присвоява контролерите със собствените си профили за автоматична конфигурация вместо присвояването на RetroBat. Презаписва автоматичната конфигурация на RetroBat."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Оставя RetroBat да опита да извлече последователността за стартиране от hash файла на MAME или от името на файла (в скоби)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Оставя RetroBat да опита да извлече последователността за стартиране от hash файла на MAME."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Оставя Visual Pinball сам да превключи на избрания видео режим, вместо да променя резолюцията на работния плот."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Позволява на ROM на картридж MegaWiFi да достъпва мрежата ви и интернет. Включвайте само за ROM, на които имате доверие."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Оставя ядрото само да определя темпото си, вместо да разчита на RetroArch. Опитайте „стандартни 50 Hz“, ако PAL игра работи неравномерно."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Позволява на емулатора да чете обратно паметта на GS. Включено по подразбиране. Изключването е по-бързо, но може да счупи някои графични ефекти."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Левият стик действа като джойстик в допълнение към кръстачката."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Премахва ограничението на кадровата честота на играта, където играта го позволява. Всичко различно от оригинала може да счупи игра."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Свързва 2 до 4 Lynx с кабела ComLynx на един екран, по един контролер за всеки. Изключва записите на състоянието и постиженията."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Зарежда потребителски профил за присвояването на волана."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Зарежда модовете (.dusk файлове) от папка със същото име като играта до нея или от dusklight\data\mods, когато такава няма."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Зарежда модовете от папката User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Зарежда модовете в папката mods на играта (по една папка с mod.ini за всеки мод). Включено по подразбиране."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Зарежда предварителна настройка на графичното качество (текстури, филтриране, меки частици). Оставете АВТОМАТИЧНО, за да запазите настройките в играта."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Зарежда първите два диска на игра с няколко диска едновременно в устройство 1 и устройство 2, вместо само в устройство 1. Нужно за малкото игри, които изискват две устройства."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Зарежда заместващите текстури от Data\Assets\HDTextures\<rom> в папката на емулатора."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Зарежда целия образ на диска в паметта. По-бързо зареждане, по-голямо използване на RAM."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Ниското качество на шейдърите може да подобри производителността, но да причини грешки."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "По-ниско означава по-малко закъснение, твърде ниско причинява прекъсвания на звука."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Намалява прецизността на GS, за да избегне празнините между пикселите при мащабиране. Коригира текста в Wild Arms и двойния образ в SoulCalibur."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "По-ниските стойности намаляват аудио закъснението, по-високите намаляват пукането."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "Ниво на MSAA или SSAA."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Тайминг на машината. 60Hz е американската машина, 50Hz европейската. Няколко европейски програми изискват 50Hz, за да работят с правилната скорост. Промяната рестартира машината."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Основна памет. Автоматично използва RAM на модела или базата данни на игрите. Неподдържаните размери се закръглят до следващия размер на модела."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "Прави режима warp много по-бърз, като превключва емулацията на SID на „FastSID“ по време на warp."

msgctxt "game_options"
msgid "Makes the emulator auto fast forward CD loading sequences."
msgstr "Емулаторът автоматично превърта напред последователностите за зареждане от CD."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Ръчно задава геймпада, използван от играча. Нужно само когато RetroBat не може да различи два еднакви геймпада, например аркаден енкодер за 2 играчи, който Windows вижда като едно устройство. Иначе оставете АВТОМАТИЧНО."

msgctxt "game_options"
msgid "Manually select a 4 Player Adapter for some games"
msgstr "Ръчно избиране на адаптер за 4 играча за някои игри"

msgctxt "game_options"
msgid "Manually specify your choice of Neo Geo BIOS."
msgstr "Ръчно задайте избрания от вас BIOS на Neo Geo."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Много игри изискват само копиране в текстура, но ако виждате почерняла или липсваща графика, може да се наложи да изберете копиране в RAM."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Присвоява бутон по бутон геймпад 8BitDo M30 или подобен, от mdControllers.json."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Присвоява контролера като Racing Controller; игрите, несъвместими с Racing Wheel, няма да работят."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Присвоява select на допълнителен бутон, полезно за играта Zelda, за да не излизате при запис."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Присвоява тригерите на вертикалната ос на аналоговия стик. Полезно за Gran Turismo и други състезателни игри."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Нагажда цветовете към вида им на истинския хардуер."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Математически копроцесор. Само шепа игри за Amiga използват такъв и добавянето му към машина, която никога не го е имала, може да обърка някои игри."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Максимална скорост на сензорния курсор с джойстик."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "Максимален брой нишки на CPU за увеличаване на текстурите. Използвайте общия брой нишки минус 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Може да причини артефакти в някои игри."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Може да подобри производителността на някои процесори с много ядра. Може да причини забавяне в някои ситуации заради допълнителното натоварване от работната нишка."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Може да намали накъсването с цената на по-дълго изчакване при стартиране на игра."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Метод за презредовите видео режими (не се прилага за Nintendo 64)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Метод за презредовите видео режими."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "Метод за четене на данни от диска: синхронно имитира оригиналния хардуер, асинхронно може да намали накъсването, предварителният кеш зарежда целия образ с цената на първоначално забавяне."

msgctxt "game_options"
msgid "Might fix some misaligned fog, bloom or blend effect."
msgstr "Може да коригира някои разместени ефекти на мъгла, bloom или смесване."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Имитира някои фамиклонинги, които разменят работните цикли на правоъгълните канали."

msgctxt "game_options"
msgid "Mimics the display characteristics of the Game Gear and Nomad LCD panels."
msgstr "Имитира характеристиките на LCD панелите на Game Gear и Nomad."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "Mipmapping е необходим за някои игри."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Огледално обръща света хоризонтално, както във версията на играта за Wii."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C е звуковата карта, поддържана от повечето игри. Изберете Mouse Card само за софтуер, който изисква истинска мишка Apple; тя заменя звуковата карта. Промяната рестартира машината."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard е звуковата карта, поддържана от повечето игри. Игнорира се на моделите //c, които нямат слотове за разширение."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Режим, предварително избран на екрана за избор на играч. Download Play изисква оригиналния BIOS и фърмуер."

msgctxt "game_options"
msgid "Modify the coin setting to Free Play."
msgstr "Променя настройката за монети на Free Play."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "Монохромният режим е необходим за игрите във висока резолюция (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "По-точна емулация на CD блока. Изисква ROM на CD блока и изключва настройката за скорост на четене."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "По-точно поведение, но може да намали производителността. ВКЛ. по подразбиране."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "Повечето игри използват порт 2; използвайте тази настройка за старите игри, които изискват джойстикът да е в порт 1."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Автоматично монтира устройство C: при стартиране."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Мишка: игри като Elansar или Defender of the Crown. Аналогов стик: BattleSphere, изберете го и в опциите на играта."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Движи мишката с аналогов стик на контролер 1 (L2/R2 = бутони). Някой порт трябва да е зададен като Мишка."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Движение с левия аналогов стик, както и с кръстачката. Включено по подразбиране."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level."
msgstr "Ниво на мултисемплиращото изглаждане (MSAA)."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Ниво на мултисемплиращото изглаждане (MSAA). Само OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Ниво на мултисемплиращото изглаждане (MSAA). Само Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Множител, прилаган към скоростта на курсора с джойстик, докато е задържан бутонът за ускоряване на показалеца (по подразбиране L2)."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "Multitap трябва да е зададен, ако ще играят повече от 2 играчи."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Заглушава механичния шум на флопи устройствата."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "НЕ показва само изображението за лявото око. Анаглифът изисква 3D очила в същите цветове, един до друг е за VR очила и 3D дисплеи."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC използва cdi200.rom, PAL използва cdi220b.rom."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Родна резолюция на играта. По подразбиране зададената в играта."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Нужно за няколко игри, включително някои point and click заглавия."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "Не е нужна монета за стартиране на игра."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Брой емулирани флопи устройства. Истинската Amiga 500 е имала само едно. Две устройства ускоряват игрите с няколко диска, но някои заглавия очакват само едно."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Брой кадри между всяко турбо натискане."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Изключено по подразбиране. Адаптивно не чака дисплея, когато кадър закъснява."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Изключено по подразбиране: емулаторът сам работи с аркадната скорост (57,5 Hz). Включете, ако картината се разкъсва."

msgctxt "game_options"
msgid "Offset for the ST/UV texture coordinates."
msgstr "Отместване за текстурните координати ST/UV."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "На монитор със 120Hz или повече без G-Sync или FreeSync използвайте най-високата честота на опресняване, кратна на 60Hz."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Включено по подразбиране; изключете, за да използвате качество на звука 11khz."

msgctxt "game_options"
msgid "On by default."
msgstr "Включено по подразбиране."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Включено по подразбиране. Изключете за по-висока скорост на интегрираните графични карти."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Включено по подразбиране. Изключете, когато пистолетът има собствено прицелване (лазер, прицел на Sinden)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Един пиксел за всеки пиксел на играта (препоръчително за шейдърите)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Прилага се само когато е включено увеличаването на текстурите (xBRZ). По-големите текстури няма да се увеличават."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Съвместимо само със системата ASIA/JAPAN MVS."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Съвместимо само с OpenGL, твърда синхронизация между GPU и CPU. Намалява закъснението с цената на по-високи изисквания към производителността."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Съвместимо само със софтуерния видео драйвер."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Действа само когато ОГРАНИЧАВАНЕ НА FPS е включено. По подразбиране: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Само за азиатските версии на игрите."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Само за новите версии на Ikemen GO. Vulkan е експериментален."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Само framebuffer, по-големи от този размер, ще се увеличават; може да коригира някои проблеми в определени игри."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Използвайте ограничителя на кадрите само ако играта работи твърде бързо без него. Някои игри може да забият, ако кадровата честота е твърде висока. Ако това стане, задайте стойност, различна от Изкл."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Използвайте това само ако имате два еднакви контролера и те не се разпознават правилно. Свързва геймпадовете по позиция вместо по име, което е по-малко надеждно."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Използвайте само за намаляване на прозореца при мащабиране в настройките на Windows."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Използва се само ако е зададено – за P2 не се приема изображение на прицела по подразбиране."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Използва се само когато е избрано MIDI изходно устройство."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Версия на двигателя OpenBOR за стартиране на играта. Автоматично я открива от данните на играта или от номер на компилацията [XXXX] в името на файла, както при OpenBOR standalone."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "OpenGL е необходим за шейдърите и вътрешната резолюция."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Само OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Само OpenGL. Коригира черния екран на някои интегрирани GPU на AMD, няколко игри ще се рендират неправилно."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Отваря втори прозорец за изгледа на Gamepad."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Допълнителна звукова платка (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) или субуфер (игрите на Gaelco). Смесване по подразбиране, само основната платка за Star Wars Racer Arcade."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "Овърклок на CPU, чипа SA-1 и чипа Super-FX; може да намали забавянията, но да причини проблеми с някои игри."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Овърклок или понижаване на честотата на двата SH-2 процесора. 100 е стандартната скорост."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Овърклок или понижаване на честотата на емулирания основен CPU. Може да помогне за стабилизиране на кадровата честота, но чупи някои игри."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Овърклок на емулирания чип 68k за по-добра кадрова честота."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "Презаписва присвояването на геймпада от RetroBat със собственото присвояване на потребителя в папката със скриптове на емулатора."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Презаписва осветяването на масата по подразбиране."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL работи на 50 Hz и е правилен за почти всяко европейско заглавие за Amiga. NTSC работи на 60 Hz и подхожда на шепа американски издания."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 идентифицира контролерите по собствен номер на слота, който не следва реда на играчите в RetroBat. Автоматично взима първия намерен; променете, ако реагира грешният контролер."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "Закърпва TOS файла за по-бързо стартиране."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Път до папката с AGS WinUAE; ако е попълнен, RetroBat ще добави стартера ags към системата amiga."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Път до папката с ExoDos, задължителен, за да може RetroBat да сканира игрите от ExoDOS."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Път до папката с ExoWin3x, задължителен, за да може RetroBat да сканира игрите от ExoWin3x."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Път до папката с ExoWin9x, задължителен, за да може RetroBat да сканира игрите от ExoWin9x."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "За всяка игра: всяка игра има собствена конзолна памет от 8 KB, така че никога не се запълва. Обща: една памет за всички игри, като на истинско устройство."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Осветяване по пиксели вместо по вертекси. Подобрява качеството в някои игри."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Повишава производителността, може да внесе и стабилност в някои игри като GT6."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Поставете потребителско изображение на прицел и го изберете по-долу."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Поставете потребителския файл „crosshair.png“ в подпапката „cross“ на емулатора или изберете файл по-долу."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Поставете потребителския файл „crosshair.png“ в подпапката „cross“ на емулатора."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: бутнете стика нагоре за изкачване (в кабината се изкачва с издърпан назад стик)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "Играйте игрите за MVS без нужда от поставяне на монети."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Пуска предупредителен сигнал при ниско здраве."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Пуска звуковите сигнали на VMU."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Играйте само с истински Wiimote, другите контролери няма да работят."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Брой играчи, предварително избран на екрана за избор на играчи при стартиране."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Включва RetroPad в различни портове, полезно за адаптерите за 4 играча."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Включва мишка в joyport; това ще премахне включените джойстици."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "Включва допълнителни джойстици в портове 2, 3 и 4."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "Включва GunCon в порт 2, за използване в Die Hard Trilogy."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Включва MIDI платка и изпраща изхода ѝ към това MIDI устройство на Windows, номерирано както в MIDI опциите на емулатора. НЯМА запазва стандартния FM звук."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Насочва директорията „system“ на RetroArch към друга папка."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Порт 1 винаги е Wii U GamePad. Може да се добави Wii Remote върху него за игрите, които изискват такъв."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Порт на Light Phaser. Порт 1 по подразбиране."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Порт на Super Scope. Порт 2 по подразбиране."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Порт на Zapper. Порт 2 по подразбиране."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Може да намали времето за зареждане с цената на по-дълго стартиране."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "PowerPC рекомпилатор, включен по подразбиране и много по-бърз. Изключете за интерпретатора."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Предварително компилира кеша на шейдърите при стартиране на играта; оставете ВКЛ. за по-малко накъсване в играта."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "Прецизен е най-точният, а отпуснат може да увеличи производителността, но да счупи някои игри."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Предпочитан регион. Игра, която не го приема, се връща към такъв, който приема."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Предварително зарежда всички CD пътеки в RAM."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Предварително зарежда потребителските текстури при стартиране."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Натиска се за отваряне на менюто на Amiberry."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Натиска се за рестарт на Amiga."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Натиска се за показване на екранната клавиатура."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Предотвратява някои артефакти, но може да доведе до остри ръбове."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Предотвратява насищането на смесения звук от няколко играчи."

msgctxt "game_options"
msgid "Processor model."
msgstr "Модел на процесора."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Модел на процесора. CPU, по-бърз от истинската машина, може да счупи игри, разчитащи на точен тайминг."

msgctxt "game_options"
msgid "Provider for the Adlib emulation. DEFAULT has good quality and low perf requirements."
msgstr "Доставчик на емулацията на Adlib. ПО ПОДРАЗБИРАНЕ има добро качество и ниски изисквания."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Поставя геймпада на играч 1 в порт 1 вместо в порт 2. Нужно за няколко игри, включително някои point and click заглавия."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Удобства в играта: бърза трансформация, по-големи портфейли, бързо катерене, мигновени записи, автоматичен запис, подобрени менюта на картата... Класически съответства на играта за GameCube. Незададено: настройките от менюто на Dusklight се запазват."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD КАТО КЛАВИАТУРА: кръстачката изпраща стрелките, а бутоните INTERVAL / ENTER, за игрите без поддръжка на джойстик."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "ТИЧАНЕ по подразбиране, използвайте бутона за тичане за ходене."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "ReShade се използва от RetroBat за показване на рамки и шейдъри в някои самостоятелни емулатори. ИЗКЛЮЧЕНО: рамките се показват вместо това с overlay прозорец. ИЗПОЛЗВАНЕ НА МОИТЕ: RetroBat никога не инсталира, не променя и не изтрива файловете на ReShade в папките на емулаторите."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Чете резултатите от render-to-texture на CPU. Може да е нужно в някои игри, но причинява синхронизация в средата на кадъра, затова има огромно влияние върху производителността."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Чете диска по-бързо от устройството на конзолата. Някои игри може да не го очакват."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Чете ini файла в подпапката „bios“."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Чете ini файла в папката „bios\mame\ini“."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "Реалната скорост на Amiga е безопасната стойност по подразбиране. Турбо зарежда по-бързо, но може да счупи някои зареждащи програми и защити срещу копиране."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Плъгин за Reality Signal Processor, налага се LLE, когато видео драйверът е Parallel."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Плъгин за Reality Signal Processor."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Препоръчително: Линейно, когато мащабът на вторичния екран е под 100%."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "Рекомпилаторът е най-бърз, интерпретаторът е по-точен."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "Рекомпилаторът е много по-бърз, интерпретаторът е полезен само за дебъг. Изисква рестарт."

msgctxt "game_options"
msgid "Recover significant color depth."
msgstr "Възстановява значителна цветова дълбочина."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "Намалява точността за по-добра производителност, качеството на графиката ще е по-ниско."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Намалява скоростта на аналоговото управление; някои игри изискват ниски стойности, за да са играеми."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Намалява времето за зареждане. Може да счупи няколко игри, разчитащи на реалния тайминг на диска."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Намалява накъсването с цената на много по-дълго изчакване при стартиране на игра и високо натоварване на GPU."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Намалява използването на VRAM с цената на качеството, може да увеличи накъсването."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Намалява прещракванията, причинени от големи записи в канала DMC. Неточно, може да омекоти някои семплирани звуци."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Намалява пукането и накъсването, но може да причини много забележимо влошаване на качеството на звука на по-бавни CPU; оставете АВТОМАТИЧНО, за да изключите."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Намалява трептенето."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Намалява накъсването и ускорява стартирането след първото стартиране."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Намалява трептящите полигони и деформацията на текстурите в 3D игрите."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "Поддръжка на възпроизвеждане на ReelMagic MPEG."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Пълни колана с отвари от инвентара."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "Опреснява състоянието на страниците в паметта, за да разреши данните, записани от GPU (използвайте за игрите на „Team Ninja“ за коригиране на липсващите модели на героите)."

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Регион на фърмуера NEC PAC. Япония: pac-n1.bin или pce-lp1.bin. САЩ: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Регион, избиран първо при многорегионалните дискове."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 1."
msgstr "Пренастройва схемата на страничните бутони за играч 1."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 2."
msgstr "Пренастройва схемата на страничните бутони за играч 2."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Премахва рамки от n пиксела в горната и долната част на екрана."

msgctxt "game_options"
msgid "Remove odd composite green/blue artifacting that appears on real hardware."
msgstr "Премахва странните зелено-сини композитни артефакти, които се появяват на истинския хардуер."

msgctxt "game_options"
msgid "Remove the original sprites-per-scanline hardware limit."
msgstr "Премахва оригиналното хардуерно ограничение на спрайтовете на сканираща линия."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Премахва страничните черни ленти в някои кинематики (ултрашироки екрани). Областите извън оригиналния кадър може да изглеждат дефектни."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Премахва горните и долните черни ленти при насочване, прицелване, кинематики и диалози."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Премахва белия блясък, показван при стрелба."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Премахва един кадър закъснение на входа, но удвоява системните изисквания."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Премахва черните рамки около картината на Amiga. По-силните настройки изрязват повече и могат да отрежат краищата на някои игри."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Премахва трептенето на картината в Hummer."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Премахва белия блясък, показван, когато игрите изключват 3D рендирането."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Рендира в кратно на родната резолюция на N64. Презаписва настройката за вътрешна резолюция, когато не е ИЗКЛ."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Рендира засенчването Gouraud с пълна прецизност, за да намали цветовите ленти в 3D игрите."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "Път за емулация на render target. rtv/fbo дава по-добра производителност, rov/fsi най-висока точност."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Резолюция на рендиране за векторните игри."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Рендира в 24-битови цветове и премахва дизеринга."

msgctxt "game_options"
msgid "Replace meshed transparency by real transparency."
msgstr "Заменя мрежестата прозрачност с истинска прозрачност."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Заменя оригиналните текстури с потребителски пакет текстури (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack in 'bios\dc\textures'."
msgstr "Заменя оригиналните текстури с потребителски пакет текстури в „bios\dc\textures“."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack."
msgstr "Заменя оригиналните текстури с потребителски пакет текстури."

msgctxt "game_options"
msgid "Replaces game's sprites by HD pack available in HdPacks bios directory."
msgstr "Заменя спрайтовете на играта с HD пакета от bios директорията HdPacks."

msgctxt "game_options"
msgid "Replaces post-processing multiple paving sprites by a single fat sprite."
msgstr "Заменя множеството паважни спрайтове при постобработката с един широк спрайт."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Възпроизвежда нискочестотния филтър на истинския хардуер. „Емулирано“ следва собствения превключвател на филтъра на машината."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Заявка за конкретен слот(ове), изберете опцията КОНКРЕТЕН СЛОТ по-горе."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "Необходимо за програмите на BASIC. Използва ATARIBAS.ROM, ако е наличен, иначе вградения Altirra BASIC."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Необходимо за игрите Formula One."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Необходимо за Paper Mario: The Thousand-Year Door."

msgctxt "game_options"
msgid "Required for certain games that use hi-res mode to produce transparency effects."
msgstr "Необходимо за някои игри, които използват режим hi-res за ефекти на прозрачност."

msgctxt "game_options"
msgid "Required for certain visual effects."
msgstr "Необходимо за някои визуални ефекти."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Необходимо, за да работи комбинацията за превъртане назад."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Необходимо за стартиране на играта без подвижна кабина Cycraft."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Необходимо за коригиране на Def Jam Icon."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Необходимо за стартиране на някои стари ROM хакове, оставете изключено за търговските игри."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Изисква поне „4X SSAA (ПОДРЕДЕН)“. Режимите 4x изискват „16X SSAA (ПОДРЕДЕН)“."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Резолюция на емулирания видео изход."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "Спазва стойностите на бита Non-Java Mode за векторните операции в бекендите на PPU. Ако не сте сигурни, не променяйте тази настройка. Изключено по подразбиране."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Крива на реакция на сензорния курсор с джойстик."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "RetroBat ще конфигурира само контролера на играч 1."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "RetroBat ще синхронизира папките със записи на dolphin и libretro-dolphin."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "RetroBat по подразбиране използва BIOS psxonpsp; включете тази опция, за да наложите стария BIOS файл SCPH550X."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Използва повторно кеша на шейдърите, изграден за играта. Автоматично оставя емулатора да реши."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Избор на скоростите с десния стик в състезателните игри с 4 скорости. H-образна решетка: диагонали, като истинска скоростна кутия. Посоки: горе 1, долу 2, ляво 3, дясно 4. L1/R1 винаги намаляват/увеличават скоростта."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Завърта картината и управлението. По подразбиране познатите игри се завъртат автоматично. РЪЧНО: SELECT променя завъртането."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "Завърта картината за вертикалните игри, включете за използване с mega-bezels."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Завърта картината за вертикалните игри."

msgctxt "game_options"
msgid "Rotate display for vertical screen."
msgstr "Завърта картината за вертикален екран."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "Завърта картината, може да е полезно за определени игри, които изискват вертикален дисплей."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Завърта лицевите бутони за смяна на подредбата."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Завърта изображението на Windows на екрана на игралното поле по време на игра, възстановява се при изход (Visual Pinball 10.8 и по-нови)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Завърта изхода, за вертикалните стрелби."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Завъртане, прилагано в крайните точки на замаха."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Работи с максимална скорост, докато CD-ROM игра се зарежда на неподвижен, безшумен екран."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Работи с максимална скорост, докато се зарежда диск или касета, когато не се възпроизвежда звук. За дисковете е нужна ИСТИНСКА ЕМУЛАЦИЯ НА УСТРОЙСТВОТО."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Работи на оригиналните 57,524 Hz вместо 60 Hz. Може да накъсва на 60 Hz екран."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Тичане по подразбиране, бутонът за тичане е за ходене. Включено по подразбиране."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Тичане по подразбиране, бутонът за тичане е за ходене. Използва издръжливост при игра за един играч."

msgctxt "game_options"
msgid "Run games faster. A powerful option for gaining performance that has no downsides some of the time. May cause various random issues caused by splitting the CPU and GPU threads onto different cores."
msgstr "Игрите работят по-бързо. Мощна опция за производителност, която често няма недостатъци. Може да причини различни случайни проблеми заради разделянето на нишките на CPU и GPU на различни ядра."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "Стартира системата с BIOS и функциите на G7400."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Ускорява GPU и DSP. Може да повиши кадровата честота на 3D игрите, но може да причини грешки."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Стартира два свързани Game Gear един до друг. Играчи 1 и 2 управляват екрани 1 и 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Тичане без задържане на бутона за тичане."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "Стартира „jgenesis-gui.exe“ вместо версията за командния ред."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "SDL геймпад по подразбиране – чете геймпадовете със стандартната подредба, а другите устройства (волани, скоростни лостове, аркадни енкодери) със суровите им бутони. SDL чете всяко устройство сурово."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT използва soundfont на Roland SC-55, доставен с RetroBat."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "SSAA предлага по-добро качество с цената на производителността."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "РАЗТЯГАНЕ запълва целия екран и изключва рамките."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Записва състоянието на играта при излизане и го възстановява при следващото стартиране (по един файл за всяка игра)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "Записите отиват в копие в папката saves, оригиналният образ никога не се променя. Нулиране рестартира от оригиналния диск (старото копие се запазва като .bak)."

msgctxt "game_options"
msgid "Saves the hiscores in supported games."
msgstr "Записва рекордите в поддържаните игри."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Мащаб на екранния ред за състояние."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Мащабира картината само с цели числа, за остри пиксели."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Мащабира картината само с цели числа, за остри пиксели. Само цял екран 1080p или 4K на 16:9 екран, с леко изрязване горе и долу."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Мащабира координатите X спрямо центъра на екрана. Намалете, ако изстрелите падат твърде далеч от прицела по краищата."

msgctxt "game_options"
msgid "Scales the dithern pattern to the resolution scale of the emulated GPU."
msgstr "Мащабира шаблона за дизеринг според мащаба на резолюцията на емулирания GPU."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "Сканиращите линии не са съвместими с шейдърите HQ или xBRZ."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Сканиращи линии, shadow mask и сияние на луминофора на катодна тръба."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "Завъртането на екрана не е съвместимо с хоризонталната подредба."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Екран за DMD на отделен екран, същата номерация като ИНДЕКС НА МОНИТОРА. АВТОМАТИЧНО използва най-малкия оставащ екран. Изисква КОНФИГУРАЦИЯ НА ЕКРАНИТЕ с 3 екрана."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Екран за backglass, същата номерация като ИНДЕКС НА МОНИТОРА. АВТОМАТИЧНО използва най-големия екран освен игралното поле. Изисква КОНФИГУРАЦИЯ НА ЕКРАНИТЕ."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Екран за показване на игрите (0 = основен екран). АВТОМАТИЧНО оставя емулатора да избере екрана си."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Екрани, използвани от пинбола (Visual Pinball 10.8 и по-нови). Позициите на backglass и DMD се изчисляват автоматично. Незададено: използват се стойностите на SCREENRES."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Екрани, използвани от пинбола. Позициите на backglass и DMD се изчисляват автоматично. Незададено: 1 екран."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "Записва 0xCD във цялата заделена heap памет."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "Вторият джойстик може да влезе в конфликт с мишката."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Изберете „специфично за играта“, за да използвате cfg файла за играта в папката emulators\psxmame\ctrlr."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Изберете типа на CRT контролера (CRTC) на Amstrad."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Изберете модела Amstrad за емулиране."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Изберете мишка или геймпад за управление на виртуалния показалец в играта."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Изберете НЕ, за да изключите кеша на текстурите."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "Изберете шейдър на BigPEmu, възможно само когато шейдърите на RetroBat са „няма“."

msgctxt "game_options"
msgid "Select a bilinear filtering method."
msgstr "Изберете метод за билинейно филтриране."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Изберете филтър за прилагане."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Изберете шейдър за прилагане."

msgctxt "game_options"
msgid "Select a video format for output."
msgstr "Изберете видео формат за изхода."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Изберете между различните подредби на контролера."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "Изберете подредбата на контролера, когато се използва опцията „Динамичен профил“."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Изберете ъгъла на екрана, в който ще се появи татуировката."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Изберете ефект за прилагане; няма ефект при използване на шейдъри."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Изберете подредбата на лицевите бутони."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Изберете в кой порт да се постави GBA ROM, по подразбиране 2."

msgctxt "game_options"
msgid "Select method used to emulate the FM synthetiser."
msgstr "Изберете метода за емулиране на FM синтезатора."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Изберете модела за емулиране."

msgctxt "game_options"
msgid "Select palette for colorizing GB games when COLORIZATION is set to 'internal'."
msgstr "Изберете палитра за оцветяване на GB игрите, когато ОЦВЕТЯВАНЕ е „вътрешна“."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Изберете шейдър за прилагане, съвместим само с видео драйвера „bgfx“."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Изберете шейдър за прилагане, съвместим само с видео драйвера „openGL“."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Изберете режима на скоростите за BattleGear4Tuned."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "Изберете GPU плъгина; опциите на RetroBat няма да работят с плъгин, различен от този по подразбиране, те могат да се конфигурират от папката на емулатора с config.exe."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Изберете IPL BIOS за стартиране на игра според региона ѝ. Изисква „IPL_JAP.n64“, „IPL_USA.n64“ и „IPL_DEV.n64“ в папката bios\Mupen64plus."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Изберете устройството за четене на координатите X и Y."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "Изберете драйвера за шейдърите при използване на видео драйвера bgfx."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "Изберете разширението, което да се добави към контролера."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Изберете режима на представяне на кадрите."

msgctxt "game_options"
msgid "Select the graphics plugin used by the emulator. Depends on hardware compatibility."
msgstr "Изберете графичния плъгин на емулатора. Зависи от хардуерната съвместимост."

msgctxt "game_options"
msgid "Select the keyboard layout."
msgstr "Изберете клавиатурната подредба."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Изберете модела на осветяване; старият режим е най-малко натоварващ за графичната карта."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Изберете машината за емулиране."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Изберете профила за присвояване на играча."

msgctxt "game_options"
msgid "Select the soundfont file or interface used for MIDI output."
msgstr "Изберете soundfont файла или интерфейса за MIDI изхода."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "Изберете системата източник за Transfer Pak между GB и GBC."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "Изберете типа конзола."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "Изберете типа на кадриране на дисплея. Използвайте стойността EMUSCV за коригиране на грешките в изображението на оригиналната конзола."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "Изберете типа пистолет според играта."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Изберете видео режима (тип кабел)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Изберете къде да се присвоят бутоните Coin и Start при игра с волан."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Изберете къде да се присвоят бутоните Test и Service при игра с волан."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Изберете дали кръстчето или кръгът е бутонът за потвърждение."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "Изберете вътрешния аудио двигател."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Изберете цветовия филтър за прилагане."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Изберете графичния API при използване на текстурния рендерер."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Изберете джойстика за емулиране (несъвместимо с MASTER COMPACT)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Изберете джойстика за емулиране."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "Изберете кой екран да се показва при хибридна подредба."

msgctxt "game_options"
msgid "Selecting GBA unlocks extra features in certain GBA enhanced GBC games."
msgstr "Изборът на GBA отключва допълнителни функции в някои GBC игри, подобрени за GBA."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Изпраща пълния път до ROM към MAME вместо само името на ROM."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Изпраща изходите за лампите и драйвер платката към външни инструменти (MAMEHooker...) със съобщения на Windows."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Изпраща изходите за лампите и отката на пистолета към външни инструменти (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Изпраща изходите за лампите, вибрацията на пистолета и драйвер платката към външни инструменти (Hook Of The Reaper, QMamehook...) с мрежовия протокол на MAME."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Чувствителност на емулирания контролер spinner."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Задава ISO по подразбиране, за използване с някои homebrew игри."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Задава присвояването на контролера по подразбиране за играч 1."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Задава присвояването на контролера по подразбиране за играч 2."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Задава присвояването на контролера по подразбиране."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Задава маската на лицензите за активираното съдържание (ВСИЧКИ ЛИЦЕНЗИ обикновено е лоша идея, може да доведе до неопределено поведение)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content."
msgstr "Задава филтъра за мащабиране на рендираното съдържание."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Задава филтъра за мащабиране на рендираното съдържание. FSR изисква Vulkan."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Задава филтъра за мащабиране на рендираното съдържание. Само OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Задава превключвателя за трудност на Atari 2600."

msgctxt "game_options"
msgid "Set the adress, interrupt, low 8 bit and high 16 bit DMA."
msgstr "Задава адреса, прекъсването (IRQ), долния 8-битов и горния 16-битов DMA."

msgctxt "game_options"
msgid "Set the amount of extra columns to draw for widescreen."
msgstr "Задава броя допълнителни колони за чертане за широк екран."

msgctxt "game_options"
msgid "Set the aspect ratio of the FMV cinematics."
msgstr "Задава пропорциите на FMV кинематиките."

msgctxt "game_options"
msgid "Set the behavior of the start menu when autostarted game exit."
msgstr "Задава поведението на стартовото меню, когато автоматично стартираната игра приключи."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Задава поведението на бутона на микрофона."

msgctxt "game_options"
msgid "Set the bottom screen as prominent."
msgstr "Задава долния екран като основен."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Задава конзолата в широк екран за игрите, които го поддържат."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Задава честотата на опресняване на хоста."

msgctxt "game_options"
msgid "Set the volume of the emulated floppy sound."
msgstr "Задава силата на емулирания звук на флопито."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Задайте за игрите, които изискват контролер в порт 2."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Включете при използване на няколко пистолета. Включено по подразбиране, ако са открити няколко пистолета и входният драйвер не е „sdl“."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Задайте тази опция само при използване на истински Balance Board."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Задайте тази опция, за да поставите микрофона в слот B."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Задайте „ВКЛ.“, за да затворите Steam или Epic Games Launcher при излизане от играта."

msgctxt "game_options"
msgid "Set this to effectively halve monitor refresh rate."
msgstr "Задайте, за да намалите фактически наполовина честотата на опресняване на монитора."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Задайте, за да включите GunCon в порт 2, използва се за някои версии на Die Hard."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Задайте, за да използвате оригиналния PSX Gamepad вместо DualShock."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Задайте ДА, за да се връща на неутрална в състезателните игри, когато клавишът за скорост е отпуснат."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Задава отместването на яркостта на емулирания течнокристален дисплей."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Задава нивото на контраста на емулирания течнокристален дисплей."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Задава честотата на PowerPC в MHz. 0 (по подразбиране) използва честотата на игровата платка."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Задава честотата на PowerPC в MHz. АВТОМАТИЧНО използва честотата на хардуера на играта (само Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "Задава честотата на PowerPC в MHz. По подразбиране е 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Задава мъртвата зона на аналоговите стикове на геймпада, когато типът входно устройство е „Gamepad Classic“ или „Gamepad Modern“."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Задава мъртвата зона на аналоговите стикове на геймпада."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Задава мъртвата зона на аналоговите тригери на геймпада."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Задава мъртвата зона на аналоговите стикове. Използва се само с типа контролер „Gamepad Modern“."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Задава типа контролер на играча."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Задава чувствителността на аналоговите стикове."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "Стойност 0 означава, че всичко се отчита като закрито (occluded), необходимо за Forza Motorsport 4."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Стойност 1 може да увеличи производителността."

msgctxt "game_options"
msgid "Setting this too high may cause sample clipping."
msgstr "Твърде висока стойност може да причини изрязване (clipping) на семплите."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Форма на пикселите: квадратни или като на оригиналния дисплей."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Форма на маската, чертана от CRT шейдъра. Използва се само когато шейдърът е CRT маска."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Обща CMOS за цялото съдържание по подразбиране или по една за всяка игра (по-добре за netplay)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "Интензитет на изостряне, прилаган от FidelityFX CAS. Използва се само когато филтърът за мащабиране е FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Кратки екранни съобщения (състоянието е записано...). Включено по подразбиране."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Показва интерфейса на Dolphin в допълнение към екрана на играта."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "Показва FPS в играта."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Показва конзолата за дебъг на Ryujinx."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Показва изображение на управлението върху рамката."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Показва известие при свързване или изключване на контролер."

msgctxt "game_options"
msgid "Show core specific notifications."
msgstr "Показва специфичните за ядрото известия."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Показва интерфейса на емулатора."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Показва известията на емулатора, включено по подразбиране (АВТОМАТИЧНО)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Показва известията на емулатора."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Показва информация за играта в горния ляв ъгъл на Craft."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Показва информация за компилацията на шейдърите."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Показва информация за текущата подредба на екраните в горния десен ъгъл."

msgctxt "game_options"
msgid "Show notifications."
msgstr "Показва известия."

msgctxt "game_options"
msgid "Show or crop overscan. 'Auto' will try to adapt to game, cropping empty areas."
msgstr "Показва или изрязва overscan. „Автоматично“ опитва да се адаптира към играта, като изрязва празните области."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "Показва или скрива настройките на RetroArch. „Автоматично“ е препоръчителната настройка."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Показва статистиките за производителността в играта."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Показва известията за компилацията на шейдърите."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Показва хоризонталните рамки. АВТОМАТИЧНО ги изрязва до областта, използвана от играта, най-добре с DOT CLOCK PAR."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Показва клавиатура на Amiga в долната част на екрана за писане с геймпада. Превключва се с присвоен бутон, движение с кръстачката или стика, натиснете друг бутон, за да въведете клавиша."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Показва следи от куршуми по стените, където попадат изстрелите."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Показва активността на устройствата и информация за производителността върху картината."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "Показва разширените PAL CRT редове, но в повечето игри те обикновено са празни."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Показва имената на флопи дисковете, лампите на устройствата и скоростта, в прозорец и на цял екран."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Показва конфигурационния екран на WHDLoad, когато играта го поддържа."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Показва подканата на WHDLoad и чака натискане на бутон преди стартиране на играта. Изключено по подразбиране, за да стартира играта веднага."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Свива/разширява татуировката, за да се побере в рамката."

msgctxt "game_options"
msgid "Significantly improves performances for CPU with 3+ cores."
msgstr "Значително подобрява производителността при CPU с 3+ ядра."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "Симулира ефектите на остатъчен образ на CRT луминофора. „Прост“ смесва 50:50 текущия и предишния кадър."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "Симулира ефектите на остатъчен образ на LCD екран."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Симулира ефектите, специфични за GPU PowerVR2 и аналоговите видео сигнали."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Симулира цветовете на LCD екрана на Game Boy Color."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "Симулира ефекта на остатъчен образ на CRT, може да се използва за избягване на трептенето."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Симулира остатъчния образ, може да помогне за намаляване на трептенето."

msgctxt "game_options"
msgid "Simulates stereo output."
msgstr "Симулира стерео изход."

msgctxt "game_options"
msgid "Single Field applies a de-interlacing filter, Double Field mimics the original hardware."
msgstr "Единично поле прилага филтър за премахване на презредовото, Двойно поле имитира оригиналния хардуер."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Размер на менютата и панелите. Ограничава се от играта до най-големия мащаб, който се побира във вътрешната резолюция."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Размер на пикселите на играта: по-високите стойности приближават и показват по-малка част от картата. По подразбиране: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "Размер на най-големия екран при хибридна подредба на екраните."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Размер на вторичния екран спрямо основния (само подредбите Горе/Долу)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Размер на прозореца, когато не е на цял екран."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Съотношение на размерите на 2-та емулирани екрана."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "Пропуска VBI при откриване на забавяне, помага срещу накъсването на звука при спадане на скоростта на емулацията."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Пропуска чертането на кадър, идентичен на предишния. Може да подобри производителността."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Пропуска кадри, за да избегне пукането на звука на бавни устройства."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Пропуска кадри за по-добра производителност, с цената на накъсано движение."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Пропуска 60-секундното чакане на другите кабини при стартиране. Изключете за игра с няколко кабини."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "Пропуска логото при стартиране на BIOS."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Пропуска проверката при стартиране, която пречи на играта да стартира."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Пропуска хардуерните проверки при стартиране (камера, волан, четец на карти)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Пропуска дългата инициализация на мотора на волана при стартиране. Изберете ревизията на играта си."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Пропуска механичното време за изчакване на флопи устройството. Зареждането е много по-бързо, а самият диск пак се чете точно като оригинала."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Пропуска началните видеа и логото."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Пропуска началните видеа."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Пропуска инициализацията на мотора на волана при стартиране."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Пропуска видеата/FMV."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "Пропуска чертането на повърхностите за областта, зададена вляво и вдясно."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Пропуска началната анимация на BIOS при зареждане на съдържание."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Пропуска началната анимация на BIOS при зареждане на съдържание. Изключете, за да достигнете системните настройки на PS2 и мениджъра на картите с памет."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Пропуска началната анимация на BIOS при зареждане на съдържание."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Слот, в който се монтират образите на дисковете. АВТОМАТИЧНО го избира според типа на образа. Променете само ако игра отказва да стартира."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "По-бавно, но необходимо за няколко игри, които зависят от поведението на кеша."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Изглажда 3D текстурите."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Изглажда промените в завиването. Необходимо при използване на геймпад или клавиатура."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Изглажда ръбовете с шейдър, леко омекотява картината."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Изглажда звука, който произвежда чипът Paula. „Sinc“ е най-изтънченият и най-взискателният."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Омекотява завиването с геймпад в състезателните игри. Силно по подразбиране, не влияе на волан."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Някои етапи на SPU са чувствителни към състезателни условия (race conditions) и разрешаването на ограничен брой едновременно помага да се облекчат забавянията. По-малка стойност може да подобри производителността и да намали накъсването в някои игри."

msgctxt "game_options"
msgid "Some games accept input from port 2 instead of port 1."
msgstr "Някои игри приемат входа от порт 2 вместо от порт 1."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Някои игри не се зареждат, ако системата е включена с поставен CD. „ДА“ поставя CD по време на началната анимация."

msgctxt "game_options"
msgid "Some games have graphic and/or speed issues without Cycle-exact."
msgstr "Някои игри имат графични и/или проблеми със скоростта без Cycle-exact."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Някои игри изискват определен клавиш за някои действия; задайте клавиша, който да се присвои на бутона SELECT на контролера на играч 1."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Някои игри изискват обърната ос за пистолетите."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Някои игри изискват разширението Game Drive."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Някои игри изискват контролер във втория порт за хвърляне на гранати."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Някои скоростни лостове се свързват към компютъра с различно ID на устройството от волана, например лостовете на Thrustmaster."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Някои homebrew и ROM хакове изискват конкретен шаблон на RAM при включване. Изисква рестарт."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be disabled."
msgstr "Някои homebrew или ROM хакове изискват тази опция да е изключена."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Някои homebrew или ROM хакове изискват тази опция да е включена."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "Източник на звука за MIDI музиката. Опциите MT-32 изискват съответните ROM на Roland в папката bios."

msgctxt "game_options"
msgid "Space/Enter/Fire works as WHDLoad start button."
msgstr "Интервал/Enter/Стрелба работят като бутон за старт на WHDLoad."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Задава как да работи емулацията на часовника в реално време в някои игри."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Задава коя добавка да се използва за възпроизвеждане на аудио CD с кръпнатите MD игри."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Задайте IPS кръпката за включване; ако не е зададена, ще се използват всички кръпки от ips .ini."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Задайте филтъра за увеличаване."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Задайте пътя до рамката."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Задайте пътя до файла на фърмуера."

msgctxt "game_options"
msgid "Specify the Amiga system model to emulate."
msgstr "Задайте модела на системата Amiga за емулиране."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Задайте модела на компютъра за емулиране."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "Задайте метода за видео рендиране. Точен е най-прецизен, но по-бавен; добър и бърз са по-бързи, но могат да се провалят при някои игри."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Поставен речев модул."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Хак за скорост, но може да е несъвместим с някои игри."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Хак за скорост, може да помогне на бавните игри с цената на грешки."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Хак за скорост."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Скорост на мишката с аналоговия стик."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Скорост на емулираната мишка на Amiga."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Скорост на показалеца на мишката, движен с левия стик."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Ускорява зареждането на GD-ROM, може да счупи някои игри."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Ускорява зареждането от диска. Може да счупи някои игри със защита срещу копиране."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Ускорява достъпа до флопи диска за по-кратко зареждане."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Разделя рендирането на няколко нишки на CPU. Полезно само при високи вътрешни резолюции."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Връща волана в центъра, докато играта не управлява force feedback, като механичната пружина на аркадна кабина."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Стандартна карта за контролер на флопи дискове."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Стартира директно в режим Commodore 64."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Стартира контролера с вече включени стикове, вместо да се натиска бутонът ANALOG в играта."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Стартира диска директно, вместо да чака в менюто PLAY CD-I. Включено по подразбиране."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Стартира играта в тестов режим. Test: клавиш 0 или R3, Service: клавиш 9 или L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Стартира Outrun 2 SP SDX без проверките на кабината (драйвер платка и кула)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Стартира менюто на Wii (менюто трябва да е инсталирано в Dolphin)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Мъртва зона на оста на волана, за геймпадове или волани без самоцентриране."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Съхранява текстурите BC1 в 16 бита. Спестява видео памет с малка загуба на качество."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Сила на вибрацията на контролера. 60% по подразбиране."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Сила на мотора за откат на пистолета. 60% по подразбиране."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Разтяга менютата и 2D екраните на цялата ширина на екрана."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Разтяга пикселите вертикално като оригиналната DOS игра на 4:3 екран. По подразбиране: включено."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Разтяга картината, за да запълни екрана, без да спазва пропорциите."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Разтяга картината на целия екран, вместо да запазва формата на монитор от епохата."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Студио: телевизионните нива на истинско устройство, черното изглежда тъмносиво на компютърен екран. Пълен обхват: дълбоко черно."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Суперсемплира ефектите във framebuffer, може да внесе артефакти."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Surround възпроизвежда задните високоговорители на кабините Model 3 с четири високоговорителя (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) на задните високоговорители. Другите игри остават в стерео."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Разменя paddle 1 и paddle 2, нужно за няколко игри, които очакват осите обратно."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Разменя бутоните A и B на контролера."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Разменя бутоните A/B и X/Y на контролера."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Разменя екраните на телевизора и GamePad в подредбите един до друг, горе/долу и картина в картината."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Разменя двата порта на Amiga. Нужно за няколко игри, включително някои point and click заглавия."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Разменя индексите на пистолетите между играч 1 и играч 2."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Включете, за да използвате папката „saves\switch“ на RetroBat за записите на Citron и Eden (вместо папката на емулатора)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Задайте типа контролер на играч 1 на няма, ако правилните клавиатурни входове не се четат."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Включете, за да активирате сервизното меню с бутоните R3 и L3."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Включете, за да активирате сервизното меню."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Включете, за да използвате кръстачката вместо левия аналогов стик."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Включете тази опция, за да изключите цял екран и да стартирате емулатора в прозорец."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Включете, за да използвате светлинен пистолет 1 за играч 2 и светлинен пистолет 2 за играч 1."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Включването при използване на специален режим за премахване на презредовото може да намали размазването."

msgctxt "game_options"
msgid "Sync to exact content framerate. Only for G-Sync/FreeSync/HDMI-2.1-VRR compatible monitors."
msgstr "Синхронизира с точната кадрова честота на съдържанието. Само за монитори, съвместими с G-Sync/FreeSync/HDMI-2.1-VRR."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "System Card, използвана от игрите LD-ROM2, които се нуждаят от нея. По подразбиране: SYSTEM CARD 1, ако syscard1.pce е в папката bios."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "Адаптер за конектора на TI-99 Speech Synthesizer."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "TOS 1.06 е само за STE: ако типът машина не е зададен, STE се избира автоматично."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Цел 60fps вместо родните 59,73fps."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 играчи в White Men Can't Jump и NBA Jam T.E. Rotary: Tempest 2000, управлявана с мишката."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "Amiga изпраща каналите си изцяло вляво и изцяло вдясно. Намаляването ги смесва и е много по-удобно със слушалки. 10 е поведението на оригиналния хардуер."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "Amiga изпраща каналите си изцяло вляво и изцяло вдясно. Намаляването ги смесва и е много по-удобно със слушалки. 100% е поведението на оригиналния хардуер."

msgctxt "game_options"
msgid "The CGA variation that is being emulated."
msgstr "Емулираният вариант на CGA."

msgctxt "game_options"
msgid "The Neo Geo CD bios used by the emulator."
msgstr "BIOS на Neo Geo CD, използван от емулатора."

msgctxt "game_options"
msgid "The Neo Geo bios used by the emulator. UNIVERSE BIOS generally offer the best compatibility."
msgstr "BIOS на Neo Geo, използван от емулатора. UNIVERSE BIOS обикновено предлага най-добра съвместимост."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Режим на Neo Geo. UNIVERSE BIOS обикновено предлага най-добра съвместимост."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "Екипът на RetroBat е подготвил профили за някои често срещани контролери, те са в папката „saves\mame\ctrlr“. ПОТРЕБИТЕЛСКИ може да се използва за записване на собствените ви присвоявания."

msgctxt "game_options"
msgid "The SVGA variation that is being emulated."
msgstr "Емулираният вариант на SVGA."

msgctxt "game_options"
msgid "The SoundBlaster emulated FM synth mode."
msgstr "Режим на емулирания FM синтезатор на SoundBlaster."

msgctxt "game_options"
msgid "The amount of high memory size the emulated machine has."
msgstr "Размер на горната памет на емулираната машина."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "Количество видео памет."

msgctxt "game_options"
msgid "The aspect ratio that's used by the Widescreen Hack."
msgstr "Пропорции, използвани от хака за широк екран."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "BIOS, използван от емулатора."

msgctxt "game_options"
msgid "The color scheme for Hercules emulation."
msgstr "Цветова схема за емулацията на Hercules."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "Драйверът „xinput“ включва функции като ефектите на вибрация. Изберете „sdl“ за съвместимост с широк набор контролери."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "Регионът на играта трябва да съвпада с региона на менюто на Wii, иначе играта няма да бъде разпозната."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Колкото по-висока е стойността, толкова по-далеч се показват обектите."

msgctxt "game_options"
msgid "The maximum RAM memory available for the system."
msgstr "Максималната налична RAM памет за системата."

msgctxt "game_options"
msgid "The normal core can be more stable when running installed OS."
msgstr "Нормалното ядро може да е по-стабилно при работа с инсталирана ОС."

msgctxt "game_options"
msgid "The raw performance to emulate."
msgstr "Суровата производителност за емулиране."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "Десният аналогов стик на играч 1 управлява втория джойстик, за игрите с два стика (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "Десният стик се използва като дясна кръстачка (също и на L2, R2, L3 и R3)."

msgctxt "game_options"
msgid "The type of emulated graphic chip."
msgstr "Тип на емулирания графичен чип."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "В някои игри има грешка, при която повече от 1 активно устройство кара емулатора да забие."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Дебелина на бялата рамка, чертана при свързан пистолет Sinden. Нормална (12 пиксела) по подразбиране."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Полезно в състезателните игри, за да е управлението по-малко „нервно“ при завиване с контролер."

msgctxt "game_options"
msgid "This option can be used to override PAL timings to run games with NTSC timings."
msgstr "Тази опция може да се използва за презаписване на PAL таймингите, за да работят игрите с NTSC тайминги."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Тази опция променя звуковата платка Yamaha на емулирания компютър. OPN е опцията по подразбиране. Звукът OPNA поддържа повече FM канали и PCM семпли."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Тази опция управлява анализатора на SPU, по-специално размера на компилираните единици. Използвайте безопасния режим за максимална съвместимост."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "Тази опция трябва да е изключена, за да се играе SIGIL."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Тази опция влияе само на контролера GameCube."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Тази опция избира дали да се емулира PCG-8100. Може да е необходима за някои програми от серията PC-8000."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Тази опция задава тактовата честота на CPU на емулирания компютър."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Тази опция задава тактовата честота на CPU на емулирания компютър. Опциите за овърклок карат повечето програми да работят по-бързо от нормалното."

msgctxt "game_options"
msgid "This option specifies which lock-on cartridge to emulate."
msgstr "Тази опция задава кой lock-on картридж да се емулира."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "Тази настройка може да се използва само с филтъра „сканиращи линии“."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Тази настройка предотвратява паузата на емулацията при загуба на фокуса."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Тази настройка завърта работния плот на Windows; няма да се върне обратно при излизане от играта."

msgctxt "game_options"
msgid "This should only be disabled when playing ROM hacks."
msgstr "Това трябва да се изключва само при игра на ROM хакове."

msgctxt "game_options"
msgid "This should only be disabled when playing certain demos and homebrews for correct operation."
msgstr "Това трябва да се изключва само за правилната работа на някои демота и homebrew."

msgctxt "game_options"
msgid "This will replace the BIOS CD-ROM busy loop with a STOP instruction."
msgstr "Заменя цикъла на изчакване на CD-ROM в BIOS с инструкция STOP."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Стартира играта без избрани графични или CPU подобрения."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "Стартира BIOS на конзолата вместо игра."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Праг, при който движението на аналоговия стик се отчита като цифрова посока."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Динамично намалява броя на емулираните CPU цикли, ако CPU на хоста не смогва (изключено по подразбиране)"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Вход за накланяне за Kirby Tilt 'n' Tumble и другите игри с MBC7. Аналогов стик по подразбиране."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "Разширение на RAM през Trapdoor, като в класическото разширение A501."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Опитва да стартира инсталацията на играта."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Опитва да открива условия на цикъл в ядрата на SPU и да ги използва като подсказки за планиране. Изключено по подразбиране"

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "Опитва да открие играта и да приложи присвояване на контролера."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Опитва да избере най-добрата честота на опресняване за ROM."

msgctxt "game_options"
msgid "Try to use legacy dosbox.conf config file instead of core options."
msgstr "Опитва да използва стария конфигурационен файл dosbox.conf вместо опциите на ядрото."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "TurboTap е необходим за игра с повече от един играч. Включва се автоматично при свързване на втори контролер."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Включва известията на емулатора: свързани контролери и съобщения за компилацията на шейдърите."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Скорост на завъртане с мишката. По подразбиране: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Включете, за да присвоите само КРЪСТАЧКАТА за посоките."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Включете при използване на светлинен пистолет, който не поддържа презареждане извън екрана."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "Включването на тази опция позволява на MAME да отчита движенията и натисканията на бутони на различните мишки поотделно."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Превръща десния стик в мишка на Amiga, полезно за игрите с менюта и point and click, без да пускате геймпада."

msgctxt "game_options"
msgid "Tweak the behavior of the 3Dfx Voodoo emulation."
msgstr "Фина настройка на поведението на емулацията на 3Dfx Voodoo."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Два слоя по подразбиране (побитово точно). Сортирано коригира наслоения дим и стъклото, шахматната дъска възпроизвежда аркадната платка (снега и мъглата в Sega Rally 2)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Тип APPLE II за емулиране."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Тип компютър Archimedes за емулиране."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Тип BBC Micro за емулиране, по подразбиране MODEL B."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Тип ядро за емулация на CPU."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Тип Color Computer за емулиране, по подразбиране coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Тип компютър за емулиране."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Тип FM Towns за емулиране, по подразбиране FM TOWNS (MODEL 1/2)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Тип FM-7 за емулиране, по подразбиране FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "Тип пропускане на кадри."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Тип LYNX за емулиране, по подразбиране 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "Тип ROM файл"

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Тип V.Smile за емулиране."

msgctxt "game_options"
msgid "Type of emulated SoundBlaster card."
msgstr "Тип на емулираната карта SoundBlaster."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "Тип джойстик, свързан към игровия порт."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Премахва ограничението на кадровата честота на играта, ако във вътрешната база данни има кръпка."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Отключва допълнителни езици в някои игри, ако базата данни на ядрото има запис за тях."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Повишава честотата на CPU от 93,75 на 125 MHz. Може да увеличи скоростта на някои игри, зависещи от CPU."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Увеличава текстурите на играта с пикселарт филтър."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Филтър за увеличаване на 2D слоевете (HUD, фонове)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Филтър за увеличаване на 2D слоевете (HUD, фонове). Само Vulkan и OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Използва „ДОЛЕН“ за бутона A и „ЛЯВ“ за бутона B."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Използва папката „cfg64“ за MAME standalone."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Използвайте „потребителски“ прицел, за да включите избрания файл с прицел."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Използвайте „потребителски“ прицел, за да включите избрания тук файл."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Използвайте „за всяка игра“, ако сте записали профил за играта в папката capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Използвайте 50 за европейска конзола и 60 за японска конзола."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Използвайте 8mhz за по-добра съвместимост."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Използва аналоговия стик като КРЪСТАЧКА."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Използвайте DSI за DSi игрите като DSiWare."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Използвайте САМО ДЖОЙСТИК за игрите с джойстик и САМО КЛАВИАТУРА за игрите с клавиатура."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Използва левия аналогов стик вместо КРЪСТАЧКАТА за управление."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Използва R1 и L1 за ускоряване и спиране в състезателните игри, съвместимо само с „автоматичните“ скорости."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Използва Resizable BAR за качване в GPU, когато е наличен. Изключете, ако срещнете накъсване или нестабилност с драйвера си."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Използва SDL за всички контролери вместо XInput за контролерите Xbox."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Използва таймингите и поведението на SGB2."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Използва SSE4 вместо AVX2 за по-стари CPU."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Използва филтър за висока резолюция за подобряване на изображението."

msgctxt "game_options"
msgid "Use a mouse-controlled Lightgun or Touchscreen input."
msgstr "Използва светлинен пистолет или сензорен вход, управляван с мишката."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Използва предварително зададена цветова палитра вместо изчислената от емулатора."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Използва алтернативна обработка на дълбочината, включете при графични проблеми или конкретно съобщение за грешка."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Използва амперсанд и лява скоба за start и монети."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Използва външен фърмуер (по подразбиране „firmware.bin“ в папката bios)."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Използва аналоговия стик вместо кръстачката."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Използва билинейно филтриране за изглаждане на цялата картина."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Използва BIOS за някои системи като Neo Geo и Sega ST-V"

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Използва бутон за презареждане вместо изстрел извън екрана за пистолетите, които не поддържат изстрел извън екрана."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Използва бутони вместо аналогова ос за волана."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Използва аудио входното устройство на компютъра по подразбиране като микрофон."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Използва hat за движение в допълнение към джойстика."

msgctxt "game_options"
msgid "Use input directly sends by keyboard to the core."
msgstr "Използва входа, изпращан директно от клавиатурата към ядрото."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Използвайте интерпретатора за най-добра съвместимост, dynarec за производителност."

msgctxt "game_options"
msgid "Use interpreter for best compatibility."
msgstr "Използвайте интерпретатора за най-добра съвместимост."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Използва левия аналогов стик в допълнение към кръстачката."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Използва левия аналогов стик вместо КРЪСТАЧКАТА."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "Използва левия стик като кръстачка."

msgctxt "game_options"
msgid "Use native texture LOD computation when upscaling."
msgstr "Използва родното изчисляване на LOD на текстурите при мащабиране."

msgctxt "game_options"
msgid "Use official BIOS and bootloader for emulated hardware."
msgstr "Използва официалния BIOS и зареждащата програма за емулирания хардуер."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Използва една обща карта с памет за всички игри вместо по една карта за всяка игра. Картите се съхраняват в „\bios\pcsx2\memcards“."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Използва пикселно точна емулация, където е налична."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Използва портове 5-8 за контролерите GameCube в режим Wii."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Използва изпреварващи кадри вместо run-ahead, прилага се броят кадри за run-ahead."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Използва истински контролери GameCube чрез адаптер GameCube. Само с истински Wiimote."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Използва раменните бутони за L и R вместо тригерите."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "Използва раменните бутони вместо тригерите."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Използва 3D моделите от HD пакетите вместо спрайтове (рендерери OpenGL). Включено по подразбиране."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "Използва BIOS от папката „bios“ на RetroBat, необходимо за стартиране в BIOS."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Използва BIOS от папката „bios“ на RetroBat."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Използвайте стойността ВИСОКА ЧЕСТОТА за екрани с по-висока честота на опресняване."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Използва рамките от artwork пакета на Odin (папка artwork на емулатора) вместо декорациите на RetroBat."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Използва рендерера с compute шейдъри вместо класическия OpenGL. По-бърз при високи вътрешни резолюции, изисква OpenGL 4.3."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Използва вградения BIOS на емулатора вместо файловете в папката bios. DS Download Play изисква оригиналния BIOS и фърмуер."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Използва текстурите във висока резолюция от HD пакетите (рендерери OpenGL). Включено по подразбиране."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Използва мишката като paddle на Apple II, нужно за Arkanoid, Breakout и другите игри с въртящ се регулатор. Позицията на показалеца над екрана е позицията на paddle. Заменя стика на контролера за paddle 1 и 2, оставете изключено за игрите с джойстик."

msgctxt "game_options"
msgid "Use the older and less compatible faster blitter"
msgstr "Използва по-стария и по-малко съвместим, по-бърз blitter"

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Използва настройките за всяка игра, записани в интерфейса на Vita3K. Те презаписват настройките на RetroBat за тази игра."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Използва простата цветова карта за double hi-res. Няколко програми за Apple II изглеждат по-близо до истинската машина с нея."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Използвайте, ако емулаторът забива след зареждане или не показва нищо."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Използвайте само ако аналоговият стик се отклонява."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Използвайте тази опция, ако ArcadeDuck не се показва на правилния монитор."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Използвайте тази опция, ако Keisho не се показва на правилния монитор."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Използвайте тази опция, ако Odin не се показва на правилния монитор."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Използвайте тази опция, ако PCSX2 не се показва на правилния монитор."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Използвайте тази опция, ако duckstation не се показва на правилния монитор."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Използвайте тази опция, ако p1 и p2 са разменени."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Използвайте тази опция с геймпад, разпознат като клавиатура (ipac и др.)."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Използвайте тази опция с волан без ръчен скоростен лост."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Използвайте тази настройка за летателните игри."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Използвайте тази настройка за намаляване или увеличаване на яркостта, несъвместима с видео драйвера „gdi“."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Използвайте тази настройка за намаляване или увеличаване на контраста, несъвместима с видео драйвера „gdi“."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Използвайте тази настройка за намаляване или увеличаване на гамата, несъвместима с видео драйвера „gdi“."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Използвайте тази настройка, за да зададете целевия турбо бутон по подразбиране."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Използвайте тази настройка, за да игнорирате файловете run.bat, autoexec.bat или dosbox.bat в папката на играта."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Използвайте тази настройка за намаляване на закъснението на входа."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Използвайте за автоматично зареждане на съдържание като HD пакети."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Използвайте winkey за клавиатура, xinput ако имате контролер XBOX, sdl за другите типове контролери."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Използва собствения ви .cfg файл в saves\mame\cfg. Пренастройванията в играта с TAB се запазват. При първото включване присвояването от последната сесия се импортира автоматично. Опцията за подредба на контролера вече не се прилага за тази игра."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Полезно за игрите с ефекти на разклащане на екрана като Wipeout Fusion, може да размаже картината."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Полезно за еднонишкови процесори."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Полезно на някои екрани с висока честота на опресняване за премахване на остатъчния образ."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Полезно при резолюция, по-висока от тази на екрана. Избягва ефекта моаре."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Използва 60hz (480i) вместо 50hz (576i)."

msgctxt "game_options"
msgid "Uses the proper mipmap levels. Enhance graphics accuracy."
msgstr "Използва правилните нива на mipmap. Подобрява точността на графиката."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "Емулация на филтъра за постобработка на VI."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Стойностите над 1.00 увеличават размера, а под – го намаляват."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "Вертикалните игри ще се показват на монитора, съответстващ на избрания индекс."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD е подобрена видео карта, използвана от шепа модерни демота. Промяната рестартира машината."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Видео режими, които конзолата предлага на игрите. HD режимите изискват HDTV видео сигнал."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Подредба на изгледа на масата. АВТОМАТИЧНО следва КОНФИГУРАЦИЯ НА ЕКРАНИТЕ: настолен за един хоризонтален екран, цял единичен екран за един вертикален екран, кабина за няколко екрана (настолен, когато КОНФИГУРАЦИЯ НА ЕКРАНИТЕ не е зададена)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Виртуално завърта кръстачката, когато екранът е завъртян."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Сила на звука от щракането на емулираното флопи устройство."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Сила на музикалната платка в игрите, които имат такава (Daytona USA, Sega Rally). 100% по подразбиране."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Само Vulkan, по-бавно, но с по-малко закъснение."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Само Vulkan. Подобрява производителността и коригира много графични проблеми, но може да е нестабилно на някои GPU. Неподдържаните методи автоматично се връщат към резервен вариант."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Само Vulkan: казва на видео драйвера да използва зададен режим на буфериране."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Какво е включено в първия порт на Amiga. Повечето игри използват джойстика в порт 2 и мишката в порт 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Какво е включено във втория порт на Amiga."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Какво е включено във втория порт на Amiga. По подразбиране е Joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Какво получава вторият порт, когато е свързан втори геймпад."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Когато се въведе адрес, режимът автоматично се задава на „РЪЧНО“."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "Когато автоматичното откриване не успее."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Когато е налично, предпочита ексклузивен цял екран за емулаторите."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "Когато е включено, всяка игра ще има собствен VMU в порт 1."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "Когато изберете „РЪЧНО“, задайте адрес в следващата настройка."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "Когато ограничаването е изключено, MAME изпълнява емулацията възможно най-бързо."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Когато използвате .m3u файл, изберете индекса на диска за стартиране."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Когато използвате Cursor Joystick, бутоните трябва да са присвоени на клавиши в RetroArch."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "При използване на XInput тази опция разменя геймпадове 1 и 2."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "При използване на пистолет Sinden затваря софтуера Lightgun, когато играта свърши."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "При използване на присвояване от файл за аркадните системи задайте подредбата за използване."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "При използване на истински Wiimote задайте типа на Wiimote."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "При софтуер, който изисква пълен клавиатурен вход, се препоръчва да използвате и режима за фокус върху играта."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Къде да се показва DMD. АВТОМАТИЧНО: на игралното поле с 1 екран, в долната част на екрана на backglass с 2 екрана, на собствен екран с 3 екрана. Изисква КОНФИГУРАЦИЯ НА ЕКРАНИТЕ."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Кой RetroPad управлява кой порт на Amiga. Оставете Автоматично, освен ако играчите не са разменени."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Кой диск от игра с няколко диска е поставен при стартиране. POM2 зарежда един диск наведнъж, другите се сменят от менюто в играта."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Кой диск от игра с няколко диска е поставен при стартиране: винаги първият или този, който е бил в устройството при последното излизане."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Кой лицев бутон потвърждава в системните диалози на PS3. Японските игри обикновено очакват кръг, западните игри – кръстче. Оставете АВТОМАТИЧНО, за да следва избрания регион."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Върху кое флопи устройство действа менюто за смяна на дискове."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Бяла рамка, чертана от емулатора, нужна на пистолетите Sinden за прицелване."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Ширина на бялата рамка, чертана при свързан пистолет Sinden. 16 пиксела по подразбиране."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Ширина на бялата рамка, чертана при свързан пистолет Sinden. 2 пиксела по подразбиране."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Изпълнява процеса на XBOX в няколко нишки на CPU, може да подобри производителността, но може да счупи някои игри."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Заобикаляне, нужно за няколко homebrew и ROM хакове."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Заобикаля грешки във фърмуера на някои волани, които причиняват кратки прекъсвания на силата. Оставете изключено, освен ако не е нужно."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Записва Amiberry.log в папката на емулатора. Полезно само при докладване на проблем, леко забавя работата."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Записва стойностите от буфера за дълбочина в паметта на vm. Изключено по подразбиране."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Записва входните събития в лог файл в папката със записи. Полезно само при докладване на проблем."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "Z80 SoftCard стартира софтуер за CP/M. Звуковите карти могат да се добавят тук като втора. Промяната рестартира машината."

msgctxt "game_options"
msgid "Zooms in to hide black borders."
msgstr "Приближава, за да скрие черните рамки."

msgctxt "game_options"
msgid "Zooms in to hide black borders. Borders are different per game."
msgstr "Приближава, за да скрие черните рамки. Рамките са различни за всяка игра."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "Разширение на RAM Zorro II. Необходимо за много заглавия за WHDLoad, но някои оригинални игри на дискети отказват да стартират с него."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "Разширение на RAM Zorro II. Необходимо за много заглавия за WHDLoad."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Памет Zorro III, използваема само от ускорена машина. Оставете на няма, освен ако конкретно заглавие не я изисква."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Памет Zorro III. Полезна за конфигурации с Workbench и няколко демота."

msgctxt "game_options"
msgid "use this to automatically start to a specified level."
msgstr "Използвайте за автоматично стартиране на определено ниво."
