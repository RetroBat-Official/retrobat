# FEATURES - DESCRIPTIONS (added 2026-11)
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' is de echte stationsnelheid. 'Turbo' laadt bijna direct, maar enkele spellen detecteren dit en weigeren te starten."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' is de echte stationsnelheid. 'Turbo' schakelt de emulatie van de schijfrotatie uit en laadt bijna direct, maar enkele spellen detecteren dit en weigeren te starten."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "'Nauwkeurig' komt overeen met de hardware, maar kan de framesnelheid sterk laten dalen op opslag-/laadschermen. Wijzig dit alleen als een menu traag is."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "'Compatibel' past bij bijna elk spel. 'Cycle exact' is het nauwkeurigst maar vereist een snelle pc. 'Snel' ontgrendelt de CPU-snelheid en kan timinggevoelige spellen breken."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "'Dubbel' geeft een strak modern beeld. Scanlinemodi bootsen het uiterlijk van een CRT-monitor na."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "'Dual Stick' wijst de joystick van speler 2 toe aan de rechter analoge stick van speler 1, 'Swap Ports' corrigeert de omgewisselde poorten voor 'Wizard of Wor'."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "'Exact' is de meest getrouwe emulatie van de Paula-chip. Verlaag dit alleen als het geluid hapert op een trage pc."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "'Joystick' is de klassieke stick met 2 knoppen die elk spel begrijpt. 'CD32-pad' voegt de gekleurde knoppen toe en wordt automatisch gekozen op de CD32."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "'AAN' geeft alle fysieke toetsenbordgebeurtenissen door aan de core. 'UIT' voorkomt dat RetroPad-toetsen toetsenbordgebeurtenissen genereren."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "'VOORGEDEFINIEERD' gebruikt de configuratiebestanden in de map 'cfg' van de emulator, 'DYNAMISCH' maakt de configuratie op basis van het profiel gekozen in de geavanceerde instellingen van 'BESTURING'."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "'Veilig' herstelt texturefouten in sommige spellen ten koste van veel prestaties."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "De optie 'Sjablonen' kopieert de bestanden uit de map 'emulators\m2emulator\templatescfg' in plaats van dynamische autoconfiguratie."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "'Drievoudige buffering' en 'afstemmen op geëmuleerde inhoud' zijn alleen beschikbaar met de Vulkan-videodriver."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "'Turbo' schakelt de emulatie van de zoekvertraging uit."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "'XINPUT' forceert het gebruik van de XInput-API voor compatibele controllers."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "'directx11' is de standaard en werkt op bijna alle hardware. 'vulkan' kan sneller zijn op recente GPU's. Sommige libretro-cores forceren hun eigen driver."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8MB Fast RAM (CD32FR). Standaard uit, zoals bij de originele CD32."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "0 is de laagste kwaliteit, vertraging en CPU-belasting, 10 de hoogste kwaliteit, vertraging en CPU-belasting."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "130-140% wordt aanbevolen met moderne controllers."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 bits verwijdert kleurbanding in donkere delen en verlopen. HDR vereist een HDR-scherm met HDR ingeschakeld in RetroArch, anders valt de core terug op 24 bits."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x komt overeen met het echte station. Hogere snelheden verkorten laadtijden maar kunnen spellen breken."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "32k RAM-uitbreidingskaart geïnstalleerd."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "Standaard 4/3, zoals de arcademonitor. De bezel wordt alleen in 4/3 getoond. 16/9 verbreedt het 3D-beeld."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Enkele spellen vereisen dat deze optie uitgeschakeld is."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Enkele spellen vereisen dit. Kost ongeveer 10% prestaties."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Enkele zeer vroege spellen vereisen de CTIA-chip voor een correcte weergave."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII wijst het toetsenbord toe aan de tekens die het afdrukt. Origineel reproduceert het exacte toetsenbord van de geëmuleerde machine, nodig voor enkele programma's."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "AUTO (aanbevolen) laat de core het NAND-bestand kiezen op basis van de regio van het spel."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO toont het richtkruis bij richten met een muis en verbergt het met een echt lichtpistool."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO schakelt alleen naar DSi voor DSi-exclusieve spellen. Forceer DSI voor DSiWare."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "AUTOMATISCH kiest de uitbreiding op basis van de programmagrootte. Kan geforceerd worden met tags in de bestandsnaam, zoals (8k) of [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMATISCH: Vita3K laadt zelf de benodigde firmwaremodules (aanbevolen). EMULATORINSTELLINGEN: behoudt de modules die in de Vita3K-interface gekozen zijn."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Boven 60 fps worden frames tussen spelupdates geïnterpoleerd. AUTO volgt de verversingssnelheid van het scherm."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Nauwkeurige framebuffer-emulatie, zeer traag maar vereist voor sommige spellen."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Speel als speler 1 en host het spel."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Actie van de tweede controllerknop: spatiebalk (bijv. Xenon 2) of joystick omhoog (springen in platformspellen)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Schakelt het richthulpmechanisme in."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Schakelt automatisch opslaan in en bepaalt de tijd tussen opslagen."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "Inschakelen bij gebruik van een WiiZapper om de trekker- en herlaadknop om te wisselen."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Past het spelbeeld aan voor breedbeeldschermen."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Voegt een lege 2HD-opslag-/gebruikersdiskette toe aan de schijfbeheerlijst."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Voegt contactschaduwen toe, vereist de hardware-renderer."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Past de snelheid van de muisaanwijzer aan op basis van de gevoeligheid van de analoge stick."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "Past de uitvoerkleuren aan om het scherm van de originele console na te bootsen."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Past het verticale midden van de Wiimote-aanwijzer aan."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Past het volume van het muziekspoor aan."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Past het volume van de geluidseffecten aan."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Geavanceerde audiobibliotheek die door veel spellen wordt gebruikt. Alleen uitschakelen als een spel crasht of audioproblemen heeft."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Richt voorwerpen met de gyroscoop van de controller (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Laat de ADAM naar schijven en datapacks schrijven. Schrijfacties gaan naar een werkkopie in de saves-map, het originele bestand wordt nooit gewijzigd. Vereist een herstart van de core."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Staat DirectInput-controllers toe (algemene USB-pads, arcadesticks). Alleen uitschakelen als een pad dubbel wordt gedetecteerd."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Staat XInput-controllers toe (Xbox-pads en wrappers). Alleen uitschakelen als een pad dubbel wordt gedetecteerd."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Maakt correcte emulatie van texture wrapping mogelijk, maar kost prestaties."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Laat spellen die verschillende resoluties ondersteunen in een specifieke resolutie renderen."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Staat native HID-ondersteuning toe voor DualShock 4-, DualSense- en Switch Pro-pads. Uitschakelen om terug te vallen op DirectInput."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Staat toe dat links en rechts, of omhoog en omlaag, tegelijk worden ingedrukt. Kan bewegingsfouten veroorzaken in sommige spellen."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Staat toe dat tegengestelde richtingen tegelijk worden ingedrukt."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Laat sommige spellen van 30 fps op 60 fps draaien."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Staat texture- en vertex-fetchconstanten met een ongeldig type toe, kan fetchfouten in bepaalde spellen omzeilen."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Staat variabele verversingssnelheid toe op schermen die dit ondersteunen. Op schermen zonder VRR kan in sommige gevallen tearing optreden."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Staat in- en uitzoomen op de kaart met het muiswiel toe, zoals in de Enhanced Editions."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Maakt een eigen toewijzing voor je arcadestick mogelijk op basis van het bestand 'arcade_sticks.json'."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Maakt muisinvoer mogelijk, ook als het apparaattype niet op 'RetroKeyboard/Mouse' staat."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Plaatst ook de volgende diskette in station 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Archieven altijd uitpakken, ook als dokan gebruikt kan worden om ze als stationsletter te koppelen."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Toont altijd de namen van voorwerpen op de grond."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Te emuleren Amiga-model. Elk model heeft een eigen Kickstart-ROM in de bios-map nodig."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Te emuleren Amiga-model. Vereist een herstart van de core. Elk model heeft een bijbehorende Kickstart-ROM nodig in de map bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Amiga-poort waarop het lichtpistool is aangesloten. Poort 2 is correct voor bijna elke machine; alleen de A1000 leest de pen op poort 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Hoeveelheid Chip RAM. Sommige latere spellen hebben 1 MB nodig. Meer dan het model ondersteunt kan de compatibiliteit breken."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "Hoeveelheid gebruikt RAM."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Hoeveelheid kleine aanwijzerbewegingen die genegeerd worden."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Een extra trilling die toeneemt tijdens het sturen."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Anti-aliasingniveau."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Anti-aliasingmethode en -niveau."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Te emuleren Apple II-model. Wijzigen herstart de machine."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Te emuleren Apple II-model. De PAL-modellen draaien op 50Hz en zijn degene waarvoor Europese demo's werden geschreven. Wijzigen herstart de machine."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Toegepast op de afbeelding van het richtkruis, handig om spelers te onderscheiden."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Past een machtscurve toe op de stuurwaarden, dempt kleine bewegingen."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Geldt voor de assen van vliegstick en gashendel in After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Geldt voor gas- en rempedaal in racespellen."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Past Gouraud-shading toe in plaats van flat shading, alleen met OpenGL."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Past een CRT-filter toe (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Past een bruinig chromafilter toe."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "Past een door de core geleverd videofilter toe."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Past een videofilter toe op het uitvoerbeeld."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Past een audiofilter toe. Wijzigt de geluidsinterpolatie."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Past een corefilter toe dat de weergave van oude signalen nabootst."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Past een fix toe voor sommige spellen."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Past bovenstaande regio toe, zelfs als het spel een eigen regio aangeeft."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Benadert de analoge uitgangstrap van de console: verwijdert de DC-offset en verzacht hoge frequenties."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Uiterlijk van een arcademonitor."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Uiterlijk van een arcademonitor: scanlines, schaduwmasker en gloed."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Beeldverhouding geleverd door de core, gebruikt wanneer BEELDVERHOUDING SPEL op AUTO staat."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Beeldverhouding ingesteld in de systeeminstellingen van de console."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Atari-toetsenbord: F2, F4 en F8 blijven voor het spel, savestates en schermafbeeldingen gebruiken dan AltGr+K, AltGr+L en AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Probeert te herschalen in de natieve resolutie."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Drempel van de audiobuffer voor handmatig frames overslaan."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Audio geeft de laagste vertraging. Video is vloeiender wanneer de verversingssnelheid van het scherm dicht bij die van de console ligt."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Uitvoerfrequentie van de audio."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (standaard) volgt de verversingssnelheid van het scherm met bewegingsinterpolatie. Origineel en de veelvouden van 57,524 Hz vereisen een G-SYNC- / FreeSync-scherm en verticale synchronisatie."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Centreert de richtas automatisch. Handig bij lichtpistoolspellen met een gamepad in plaats van een lichtpistool."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Snelheid van autovuur. Sneller is niet altijd beter: sommige spellen negeren te snelle invoer."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: west aanval, zuid springen, oost speciaal, noord aanval 2, L1/R1 aanval 3/4. OpenBOR standalone: dezelfde knoppen als de standalone OpenBOR-emulator."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automatisch gebruikt XInput wanneer alle controllers XInput-apparaten zijn, anders DirectInput."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automatisch: start van de harde schijf wanneer het spel een harde schijf en geen diskette heeft."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automatisch: alleen getoond als het spel geen eigen richtkruis heeft."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Past automatisch spelverbeteringen toe als ze in de database van de core staan (LOD, zichtafstand, FMV overslaan)."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Spoelt een FDS-spel automatisch vooruit tijdens het laden van de schijf."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Laadt automatisch patches zonder interlacing bij het starten van het spel."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Laadt automatisch breedbeeldpatches bij het starten van het spel."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Laadt en past automatisch cheats toe bij het starten van het spel."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Verwijdert automatisch de zwarte randen rond het Amiga-beeld zodat het beeld meer van het scherm vult."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Draait het beeld automatisch voor verticale spellen."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Wisselt Port0 en Port1 automatisch op basis van invoeractiviteit."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Wisselt automatisch van schijfkant wanneer het spel erom vraagt."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "De BIOS-taal kan de taal van sommige spellen beïnvloeden."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "Bezels worden alleen in 4/3 getoond."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "Bilaterale CAS wordt aanbevolen maar kost prestaties, CAS is minder agressief en subtieler."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Zwartniveau van het beeld. Standaard 50%, afgestemd op een arcade-opname: lager is donkerder, hoger is lichter."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "Gemengd tekent transparante polygonen als vloeiende menging in plaats van het arcade-dambord. Alleen Model 1 en Model 2, Vulkan- en OpenGL-renderers."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Vervaagt het geëmuleerde beeld."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "Vervaagt aangrenzende pixels voor transparantie-effecten."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "Vervaagt aangrenzende pixels om SDTV-resolutie te simuleren, kan nodig zijn voor sommige spellen om transparantie te emuleren."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Versnelt de emulatie tijdens het opstarten."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Start direct in het DS BIOS-menu, vereist dat de externe BIOS is ingeschakeld."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Start in het invoerscherm voor Game Genie-codes. Vereist 'gamegenie.nes' in de bios-map. Herstart vereist."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Start in het BIOS-menu van de console."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Start met de echte Jaguar-BIOS en de bijbehorende opstartanimatie. Vereist voor sommige spellen."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Breekt in op de debugger van de host (of crasht als er geen debugger is) wanneer een niet-geïmplementeerde PowerPC-instructie wordt aangetroffen."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "Toont het systeem-ROM-menu bij het opstarten van arcadesystemen."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Zendt invoerfeedback uit op TCP-poort 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Bouwt de shadercache voordat het spel start."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Knopcombinatie om te wisselen tussen tv en GamePad, alleen gebruikt door de schermindeling WISSELBAAR."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Knopindeling van de core, gelijk voor alle spellen. Laat op AUTO om de RetroBat-toewijzing per spel en de optie CONTROLLERINDELING te gebruiken."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Knop om te bevestigen in systeemdialogen en in spellen die de systeeminstelling volgen. CIRKEL is de Japanse conventie."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Standaard wordt Hellfire gestart als de spelnaam hellfire bevat, anders Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Standaard configureert RetroBat zoveel spelers als er controllers zijn aangesloten; gebruik dit om dat te overschrijven."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Standaard maakt RetroBat een eigen configuratiebestand; schakel deze optie in om je eigen spelinstellingenbestand uit de map 'emulators\ssf\Setting' te gebruiken."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Standaard wordt een tweede gamepad gebruikt wanneer een tweede controller is aangesloten."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Standaard beweegt elke controller de held. Inschakelen als een andere aangesloten controller de beweging verstoort."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "Standaard wijst zinc de linkerstick toe voor beweging; gebruik deze optie om naar de D-pad over te schakelen."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Standaard vereist RPCS3 de GunCon in spelerpoort 3; gebruik dit om hem in poort 1 te forceren."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Standaard negeert RetroBat core-specifieke optiebestanden."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Standaard houdt RetroBat geïnstalleerde spellen en de roms-map gesynchroniseerd."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "Standaard wordt gekalibreerd met de middelste muisknop; met deze instelling kies je een andere knop voor het kalibratieschot."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Standaard worden wijzigingen op de schijf opgeslagen, 'verwerpen' slaat geen wijzigingen op."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Standaard wordt de trekkerknop gebruikt om te schudden; inschakelen om in plaats daarvan een zwaai te simuleren."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Omzeilt mipmapping en gebruikt altijd het scherpste textureniveau. Betere beeldkwaliteit, enkele spellen hebben er weergaveproblemen mee."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "CD32-configuratie. Vereist zowel de CD32-Kickstart als de uitgebreide ROM in de bios-map."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "KLASSIEK is de originele softwarerenderer. POLYMOST en POLYMER gebruiken OpenGL en ondersteunen HD-pakketten."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "Grootte van het fysieke CPC-RAM in kB."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "CPU-klok. Auto gebruikt de klok van het model of de spellendatabase. Sommige spellen (SSF2, Alltynex) hebben baat bij een snellere CPU."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Camerasnelheid met de rechter analoge stick of de muis."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Kan de prestaties op onverwachte manieren beïnvloeden."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Kan gebruikt worden om de md5-controle van de BIOS uit te schakelen bij gebruik van een eigen BIOS."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "Kan de framesnelheid verbeteren maar de snelheid van sommige spellen verstoren."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Kan de prestaties van 3D-weergave in sommige spellen verbeteren."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Handig voor Gran Turismo: de triggers worden aan andere knoppen toegewezen."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Handig voor Gran Turismo: de triggers worden aan de rechter analoge stick toegewezen."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Handig voor Metal Gear, om drukgevoeligheid te simuleren."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Kan sommige spellen ten goede komen."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Kan diverse fouten veroorzaken."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Kan verschoven 2D-afbeeldingen herstellen, zoals de personagekeuze in Mario Kart."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Kan sommige bugs herstellen die zelfs op de originele hardware voorkwamen."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Kan sommige spellen in niet-natieve resolutie herstellen door 2D-randen af te ronden."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Kan sommige problemen met XBOX-controllers verhelpen."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Kan de nauwkeurigheid verbeteren ten koste van een beetje prestaties."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Kan de prestaties verbeteren op krachtigere GPU's met reserve. Werkt alleen met de Vulkan-renderer."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Kan de prestaties verbeteren op minder krachtige systemen."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Kan de prestaties verbeteren met een krachtige GPU."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Kan alleen gebruikt worden als de controller bewegingsbesturing ondersteunt."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Kan haperingen bij het compileren van shaders verminderen, maar kan ook artefacten veroorzaken."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Kan de vertraging verminderen of de onderste lijn op de Wii verwijderen, ten koste van grafische problemen."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Beperkt de framesnelheid tot de originele 35 fps."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Wisselt de D-padbesturing tussen joystick en muis."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Wijzigt de beeldverhouding van het onderste scherm."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "Wijzigt de beeldverhouding van het bovenste scherm."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Wijzigt het pad voor uitgepakte spellen (standaard '\roms\.uncompressed')."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Wijzigt de renderer die de core gebruikt. Lichtpistoolspellen werken alleen met SOFTWARE."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Wijzigt de gevoeligheid van de analoge stick."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Wijzigt de gevoeligheid van de muis."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Wijzig deze instelling afhankelijk van de besturing van het spel: links van het / -teken staat de originele spelknop voor gas en remmen, rechts die voor het schakelen."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Wijzig deze instelling afhankelijk van de besturing van het spel."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Wijzig deze instelling bij instabiele spellen. Hoe hoger de waarde, hoe beter de stabiliteit kan zijn. 200μs en 400μs zijn doorgaans goed voor de meeste spellen."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Wijzigt hoe emulatorthreads over de CPU-cores worden verdeeld. De RPCS3-planners kunnen helpen op CPU's met meerdere CCX/CCD-clusters of met SMT, maar het besturingssysteem is op de meeste machines het veiligst."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Wijzigt hoe de pistolen in Rambo worden getoond."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Wijzigt de geluidschip, het TMSS-opstartscherm en enkele hardware-eigenaardigheden."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Karaktergeneratorchip. Automatisch kiest de chip die bij de gekozen machine past."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "Cheats moeten in de map \bios\pcsx2\cheats staan."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "Cheats moeten in de map 'cheats\mame' staan."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "Cheats moeten in de map 'cheats\psxmame' staan."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Controleert elke ROM tegen de spellendatabase. Alleen uitschakelen om een romset te testen die niet laadt: verkeerde ROM's kunnen crashen of opslag beschadigen. Standaard aan."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Controleert op beschadigde bestanden bij het opstarten van een spel."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Chipset gebruikt wanneer een AGA-model is gekozen. Alleen onder AGA zetten om een spel te testen dat op een A1200 misgaat."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Kies 'Trojan Phazer' voor spellen die voor dat pistool zijn geschreven. 'Lichtpen' past bij al het andere, inclusief tekenprogramma's."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "Kies een MSX-uitbreiding die aan de tweede cartridgesleuf wordt toegevoegd."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Kies tussen een Engelse, Franse of Spaanse toetsenbordindeling."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Kies de knop om IR op de rechterstick in te schakelen."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Kies de knop om een zwaai met de rechterstick te simuleren."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Bepaalt of de sneltoets voor schermwissel de schermen permanent wisselt of alleen zolang de knop wordt vastgehouden."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Kies het kleurenpalet."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Kies de uitbreiding die op de controller is aangesloten."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Kies de tweede indeling van de geëmuleerde schermen."

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Kies welk kleurenpalet gebruikt wordt."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Kies op welk station het schijfbeheermenu werkt. De andere stations blijven gekoppeld. Geladen medium gebruikt het station waarin het spel is geladen."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "Klassiek gebruikt de rechter en linker schouderknop voor harde trap en stoot, modern gebruikt de rechter schouderknop en de rechter trigger."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Kleurenpalet voor originele Game Boy-spellen."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Kleurtemperatuur van de arcademonitor."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Kleuren van WonderSwan-spellen (mono). WS-paletten bootsen de originele schermen na."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "Stelt de ruimte tussen beide schermen in pixels in."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "Stelt het gezichtsveld in (hoger is breder)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Stelt het aantal fps in."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Stel dit in als je wilt wisselen tussen stereo en surroundgeluid."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Bepaalt hoe controllers worden aangevraagd bij host of client. Essentieel voor een lokale multiplayerverbinding."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Sluit de muis aan op poort 1."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Consolevariant die bij de gekozen BIOS-image hoort."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "Regelt de nauwkeurigheid van de GS-mengeenheid. Hogere waarden emuleren het mengen nauwkeuriger in de shader."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Regelt de trilineaire texturefiltering van de emulatie."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Bepaalt hoe dithering wordt toegepast."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Bepaalt de uitgebreidheid voordat het programma wordt getoond."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Zet opschakelen/terugschakelen om naar versnelling 3/4 voor simulatie van sequentieel schakelen met een gewone versnellingspook."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Kopieert textures naar VRAM, trager maar nauwkeuriger. Uitschakelen om prestaties te sparen."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Kopieert de kleurbuffer naar het N64-geheugen. Nodig voor sommige effecten (bijv. pauzeschermen, camerafoto's). UIT is het snelst maar kan ze breken. AUTO volgt de prestatiemodus."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Correct maar trager."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Corrigeert de beeldverhouding van niet-vierkante pixels."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Snijdt het mogelijk willekeurige, foutieve beeld aan de randen weg dat door de rand van een standaard-tv verborgen zou zijn."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "Snijdt het beeld bij van de natieve beeldverhouding naar 4:3 of 16:9"

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "Snijdt de randen bij om randgraphics te tonen of te verbergen."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "Snijdt het beeld bij van 256x240 naar 252x239."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Afsnijfrequentie van het audio-uitgangsfilter van de console. 3390 Hz komt overeen met de meeste Mega Drive-modellen."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "Snijdt 8 pixels aan de randen af om de Master System-randen te verwijderen."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "Grootte van de DIMM-kaart. Auto volgt het spel, laat op Auto tenzij een spel klaagt."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Dempt het slingeren van de achtervolgcamera in racespellen. Standaard sterk."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Maakt om de andere lijn donkerder om een beeldbuis na te bootsen."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "DeSmuME heeft een interne BIOS; kies deze optie om de BIOS en firmware uit de bios-map van RetroBat te gebruiken."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Verlagen als het te gevoelig is; te ver verlagen kan voorkomen dat het volledige bereik bereikt wordt."

msgctxt "game_options"
msgid "Default ON."
msgstr "Standaard AAN."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "De standaard geëmuleerde pad is een pad met 6 knoppen."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Standaard ingeschakeld, kan bij enkele spellen problemen geven."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Volgt standaard de taal van EmulationStation."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "Standaard 'HOOG'; zet op 'NORMAL' voor betere prestaties ten koste van nauwkeurigheid."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "Standaard 30 seconden; bepaalt hoe lang gewacht wordt tot het spel start voordat wordt teruggekeerd naar de spellijst van RetroBat."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "Standaard UIT; gebruik dit bij snelheidsproblemen op schermen met een hoge verversingssnelheid."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "Standaard AAN (snel). UIT draait de echte geometrie-DSP-programma's, nauwkeuriger maar trager (alleen Model 1- en Model 2 2B-spellen)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "Standaard AAN, correcte weergave van quads. Op UIT worden quads als driehoeken weergegeven (sneller)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "Standaard AAN; op UIT kan de compatibiliteit met oudere GPU's verbeteren (alleen Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "Standaard AAN; gebruik deze instelling om de limiet van 60Hz op te heffen, kan spellen breken."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Standaard aan; uitschakelen om de opstartanimatie te tonen."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Standaard 10-bits voor DS en 16-bits voor DSi."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Standaard Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "Standaard WIIU Gamepad; wijzig dit voor spellen die de WIIU Gamepad in multiplayer niet accepteren."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Standaard: cursor verborgen."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Standaard: ingeschakeld."

msgctxt "game_options"
msgid "Default: low."
msgstr "Standaard: laag."

msgctxt "game_options"
msgid "Default: true"
msgstr "Standaard: true"

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Standaard 60 wanneer op 0 gezet en VSYNC ingeschakeld is."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Bepaalt welke BIOS voor de emulatie gebruikt wordt."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "Bepaalt het gamepadtype, geldt voor beide spelers."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "Bepaalt het PET-computermodel."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "Bepaalt welk Symbian-apparaat gestart wordt."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Bepaalt de knop om het Gamepad-scherm te tonen, standaard als er geen is."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Bepaalt hoeveel RAM de geëmuleerde machine heeft."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Bepaalt hoe de cursor op het onderste scherm verschijnt."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Bepaalt hoe het spel in het venster past of geschaald wordt."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Bepaalt hoe het Sinden-pistool geconfigureerd wordt."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Bepaalt de toewijzing van de A- en B-knoppen van de GunCon (Start en Back van de Justifier). Standaard: D-pad rechts/links met een Wiimote op DolphinBar, muisknoppen met andere pistolen."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "Bepaalt de toewijzing van de knoppen van de GunCon2."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Bepaalt hoe het aanraakscherm geëmuleerd wordt."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Bepaalt hoe je Wiimote met de DolphinBar verbonden is."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Bepaalt of patches worden toegepast en waar de patchbestanden staan; 'AUTO' past patches toe als ze naast de rom staan met dezelfde naam als het rombestand."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Bepaalt de toewijzing van de muisknoppen (links/rechts/midden), standaard a/herladen/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "Bepaalt het modeltype en de regio."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Bepaalt het model, standaard BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Bepaalt het model, standaard CPC 6128+ voor de GX4000."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "Bepaalt het model, standaard Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Bepaalt de muisindex voor speler 1."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "Bepaalt de muisindex voor speler 2."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Bepaalt de muisindex voor speler 3."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Bepaalt de muisindex voor speler 4."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Bepaalt het pad naar een eigen controls.ini-bestand."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "Bepaalt de regio, gebruikt voor opslagbestanden."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Bepaalt de knopcombinatie die vastgehouden moet worden om de DualShock-controller tussen analoge en digitale modus te wisselen."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Bepaalt het kleurenpalet; Old NTSC reproduceert de oude, lelijke kleuren van Japanse tv's."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "Bepaalt welk aangesloten apparaat een draaiknop (dial) emuleert."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Bepaalt welk aangesloten apparaat een pedaal emuleert."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "Bepaalt welk aangesloten apparaat een positioneel apparaat emuleert."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "Bepaalt welk aangesloten apparaat een trackball emuleert."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "Bepaalt welk aangesloten apparaat een lichtpistool emuleert."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Bepaalt welk aangesloten apparaat een muis emuleert."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "Bepaalt welk aangesloten apparaat een paddle emuleert."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Bepaalt welk aangesloten apparaat een analoge richtingsstick emuleert."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Bepaalt het geëmuleerde joysticktype."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Bepaalt het geëmuleerde machinetype."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "Bepaalt de functie van de rechter joystick."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "Bepaalt de toetscombinatie om het diagnosemenu te openen."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Bepaalt het niveau van trilling en schermschudden; schakel schermschudden in als de controller geen trilling ondersteunt. 'AUTO' schakelt beide in."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Bepaalt de positie van het wapen dat je vasthoudt."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Bepaalt de toewijzing van de D-PAD."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Bepaalt het aantal te emuleren geheugenkaarten."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Bepaalt het aantal af te snijden pixels."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Bepaalt het geluid dat de geëmuleerde microfoon ontvangt."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "Bepaalt het type apparaat voor de aanwijzerbeweging."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Bepaalt het monitortype, wijzigt de kleuren."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Bepaalt het type geëmuleerde controller."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "Bepaalt het type richtkruis voor pistolen."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Bepaalt waar de knoppen voor munt en start zich bevinden."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Bepaalt of de sneltoetsen voor 'vooruitspoelen' als schakelaar werken of vastgehouden moeten worden."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Bepaalt of de sneltoetsen voor 'slow motion' als schakelaar werken of vastgehouden moeten worden."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Bepaalt welk Game Boy-geluid door het systeem wordt uitgevoerd."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Bepaalt welke analoge stick de muisaanwijzer bestuurt."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "Bepaalt welke knop de turbomodus activeert; dit is niet de knop die turbo wordt."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Aantal graden stuuruitslag dat de volledige uitslag in het spel bereikt. 270 is de arcadekast."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Weigert schrijfacties wanneer bezet."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "Kan afhankelijk van de configuratie de vertraging verhogen of verlagen."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Apparaat aangesloten op de gamepoort van de Apple II. De analoge stick geeft een geleidelijke paddlebeweging, de D-pad gaat alleen volledig naar links of rechts."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Apparaattype voor speler 2."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Alleen DirectInput: gebruik dit als de controllers niet de juiste spelers besturen."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Schakelt de XBE-handtekeningcontrole uit bij gebruik van homebrewspellen."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Schakelt de instellingen per spel van Xenia Edge uit, zodat de RetroBat-instellingen gelden."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Schakelt de veiligheidsfuncties van de core uit om sommige homebrewspellen te kunnen starten."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Schakelt dithering uit en gebruikt de volledige 8 bits kleurinformatie per kanaal."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Schakelt misteffecten uit."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Schakelt de hardware-renderer uit, kan de compatibiliteit verbeteren."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Schakelt de toetsenbordsneltoetsen uit en geeft de core volledige toegang tot het toetsenbord. Wisselen met de toets 'Scroll Lock'."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Schakelt de modifier volumes uit die voor schaduwen worden gebruikt."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "Pixel shaders uitschakelen kan crashes in sommige spellen verhelpen; niet activeren tenzij het spel het nodig heeft."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Schakelt de FM-chip van de Master System uit."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Schakelt het Visual Pinball-menu uit: de afsluittoets (X) sluit de tafel direct af."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Schakelt de analoge plunjer (rechterstick) en het analoge duwen (linkerstick) uit."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Schakelt de controle van de kastcamera uit."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "Schakelt de controle van artwork in de map 'saves\mame\artwork' uit."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "Schakelt de controller-applet uit die in multiplayerspellen verschijnt om de aangesloten controllers te kiezen."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Schakelt het in-game menu uit dat met HOTKEY + OOST of F12 geopend wordt."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Schakel deze optie uit om de IR-aanwijzer te centreren wanneer de stick wordt losgelaten."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Schakel deze optie uit om de prestaties te verbeteren."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Schakel deze optie uit om een .bat- of .cmd-bestand direct te starten zonder dat RetroBat het uitvoerbare bestand erin probeert te vinden."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Uitschakelen om R2 en L2 aan de knoppen L en R toe te wijzen (niet-digitaal)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Schakelt het gebruik van de X-as voor duwen, de Y-as voor kantelen en de Z-as voor de plunjer uit."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Schakelt de waarschuwing uit bij het starten van spellen die niet volledig ondersteund worden."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Schakelt de trilling van de joypad uit; standaard is trilling alleen ingeschakeld wanneer spel en controller compatibel zijn."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Schakelt de automatische instellingen per spel uit de coredatabase uit en schakelt de handmatige fixes hieronder in. Niet aanbevolen."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Schakelt de bewegingsinterpolatie uit, één frame minder vertraging."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Schakelt de vertexcache uit. Kan ontbrekende of flikkerende graphics verhelpen. Kan de prestaties verlagen."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "Dithering uitschakelen kan wat ruis en pixeleffecten verwijderen."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "Het uitschakelen van het 4MB-uitbreidings-RAM-pakket kan nodig zijn voor sommige spellen."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Deze functie uitschakelen verlaagt de kleurdiepte."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "Toont de MAME-menu-interface bij het laden van een spel."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "Toont SGB-randen bij emulatie van de Super Game Boy."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Toont een bericht wanneer een prestatie ontgrendeld wordt. Standaard ingeschakeld."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Toont een kleine aanwijzer op het aanraakscherm."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Toont een ervaringsbalk boven de riem."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Beeldverhouding van het LaserActive-beeld, standaard 4:3."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Toont de huidige levens- en manawaarden op de bollen."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Toont schade en ervaring als zwevende getallen."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Toont leveltijd, gevonden geheimen en gedode vijanden."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Weergave van het tweede scherm (aanraakscherm) van Primeval Hunt."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Toont de randgebieden van het scherm. Heeft geen effect op F18A-uitvoer."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Toont het spel in 16:9. Het best met BEELDVERHOUDING SPEL op 16/9."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Toont het scherm van de VMU van speler 1 over het spel."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Weergave bij het opstarten. Kan in het spel gewisseld worden met de toets F7 (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Toont voxelobjecten in plaats van platte sprites indien beschikbaar. Standaard ingeschakeld."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Dithering voor supersampled framebuffereffecten."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Dithering toegepast op RDRAM-framebufferbeelden."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Deelt de interne resolutie: bij een hoge interne resolutie maken hogere waarden het spel groter. Standaard: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 is een zeer donker spel; verhogen om het beeld lichter te maken."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Verdubbelt de waargenomen horizontale resolutie, niet compatibel met supersampling."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Schaalt het opgeschaalde beeld terug (SSAA). Vereist upscaling."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Tekent het landschap tot het einde van het parcours in spellen die het ondersteunen (Daytona USA). Alleen Model 1 en Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Station dat gebruikt wordt bij het wisselen van schijven."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick: Robotron 2084 en Space Dungeon op de rechterstick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: joysticks met meerdere knoppen."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Dubbele frames vereisen de Vulkan-renderer."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Dynamische recompilatie. De meeste spellen draaien sneller, sommige trager."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Verwijdert vervorming en kromtrekken van textures bij upscaling."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Emuleert Buzz!-buzzers op je gamepads. Eén controller dekt 4 buzzers (spelers 1-4), twee controllers dekken er 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Emuleert de geheugentiling van de PS3. Verhelpt grafische fouten in sommige spellen tegen een kleine prestatiekost."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Emuleert de Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Emuleert een DJ Hero-draaitafel op je gamepads. Vereist voor DJ Hero 1 en 2."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Emuleert een Guitar Hero Live-controller (GHLtar) op je gamepads. Vereist voor Guitar Hero Live."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Emuleert een New 3DS of een originele 3DS."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Emuleert een PlayStation TV voor lokale multiplayer (tot 4 controllers). Identieke controllers worden niet ondersteund, spellen met aanraakscherm werken mogelijk niet."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Emuleert een specifieke bewegingsbesturing. De '/' geeft de actie voor linkerstick/rechterstick aan."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Emuleert een spinnercontroller, aangestuurd door muisbeweging. De muisknoppen zijn toegewezen aan de linker (gele) en rechter (rode) knop."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Emuleert de NTSC-vblankfrequentie van 59,94Hz in plaats van 60Hz. Verhelpt timing- en audioverloop in sommige NTSC-spellen."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Emuleert het accessoire Disney Infinity Base."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Emuleert de Game Boy Player om trilling in compatibele spellen in te schakelen."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Emuleert het accessoire LEGO Dimensions Toy Pad."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Emuleert het accessoire Skylanders Portal."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Emuleert de Video CD Card, vereist mpeg_card.bin in de bios-map."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emuleert het gedrag van oudere engines, vereist door sommige oudere mods en demo's."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Tijdsegment van geëmuleerde threads. Verhogen kan enkele spellen helpen, verlagen kan andere vloeiender maken."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Emuleert LCD-doorschijnendheidseffecten, maar verhoogt bewegingsonscherpte."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Emuleert de multisampling-indeling van de PS3. Kan enkele visuele artefacten in sommige spellen verhelpen."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Scanlines van de emulator, alleen zichtbaar in sommige spellen."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Schakelt de 32MB RAM-mod voor de Dreamcast in, kan de compatibiliteit beïnvloeden."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "Schakelt opstarten in de BIOS in voor DSi-spellen."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Schakelt de CMS-emulatie in."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Schakelt de Digital Sound Processor in. Verbetert de geluidsnauwkeurigheid, maar verhoogt de prestatievereisten."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Schakelt de Digital Sound Processor in. Verbetert de geluidsnauwkeurigheid ten koste van prestaties."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Schakelt de dienst Discord Rich Presence in; je Discord-status toont dan de spellen die je speelt."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Schakelt de Dolby Pro Logic II-decoder in voor compatibele spellen en 5.1-luidsprekers."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Schakelt FidelityFX Contrast Adaptive Sharpening in."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Schakelt de Floating Point Unit in, meestal nuttig voor latere 3D-spellen."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Schakelt de Gravis Ultrasound-emulatie in."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "Schakelt HDR in voor HDR-compatibele schermen."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Schakelt de IBM PS/1 Audio-emulatie in (standaard uitgeschakeld)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Schakelt Just In Time-emulatie in, verhoogt de emulatiesnelheid, niet compatibel met cycle exact."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "Schakelt de interne MAME-hertoewijzing van de besturing in."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "Schakelt de MAME-optie in om de knopindeling per spel automatisch te configureren op basis van de interne database."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "Gebruikt de geëmuleerde BIOS van melonDS in plaats van de firmware in de bios-map."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "Schakelt de OpenGL-renderer in; de RetroArch-driver moet op OpenGL staan."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "Schakelt PAL-emulatie (50Hz) van de NES in."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Schakelt de RAM-cartridge van de Sega CD in."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Schakelt de Tandy Sound-emulatie in."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Schakelt extra ontwikkelaars-RAM in, kan spellen breken."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Schakelt anti-aliasing in, maakt polygoonranden gladder."

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Schakelt brute-force op-/terugschalen in (alleen 10.8.0)"

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Schakelt het koppelen van de cache in"

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "Laat objecten in het spel schaduwen werpen, alleen compatibel met OpenGL."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Schakelt de trileffecten van de controller in. Werkt alleen in racespellen."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Schakelt richtkruizen in schietspellen in; de opties (DS) zijn alleen compatibel met DemulShooter."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Schakelt richtkruizen in schietspellen in."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Schakelt een eigen resolutie in op basis van de videomodus."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Schakelt dynamische recompilers in die de prestaties helpen verbeteren."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Schakelt uitgebreide functies voor DS4 en DualSense in; dit breekt de compatibiliteit met emulators die DInput gebruiken totdat het weer wordt uitgeschakeld."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Schakelt force feedback in voor ondersteunde controllers."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Schakelt volledige anti-aliasing in Direct3D in, maakt polygoonranden gladder."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Schakelt het filter voor horizontale menging (vervaging) in."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Inschakelen als het stuur van het midden af wordt geduwd in plaats van ernaartoe."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Schakelt het richtkruis in het spel in om het richten te vergemakkelijken."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Schakelt de intelligente zoomfunctie in."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Schakelt IPS-patches in."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "Schakelt een minder nauwkeurige, maar beter klinkende geluidsemulatie van de Namco 106 (mapper 19) in."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Schakelt de handmatige hacks hieronder in, anders worden de hacks automatisch toegepast."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Schakelt bewegingsbesturing (gyroscoop) in, met de muis of met een compatibele controller."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Schakelt de multitap in poort 2 in."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Schakelt progressive scan in voor compatibele spellen."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Schakelt de run-ahead-modus in om de invoervertraging te verminderen."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Schakelt de IBM Music Feature Card in (standaard uitgeschakeld)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "Schakelt de FM-chip van de Master System in."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Activeert de effecten van de cheats die in de Vita3K-interface zijn ingeschakeld."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Schakelt de emulatie in van Jaguar-joypads die op de uitgebreide joystickpoorten van de Atari STE zijn aangesloten."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Gebruikt de muis voor het aanraakscherm in plaats van de rechterstick."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Inschakelen als de index van XInput-controllers omgewisseld is."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Inschakelen als de controller geen analoge triggers heeft."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Inschakelen als je een G-SYNC-/FreeSync-monitor hebt, kan audiofouten veroorzaken."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Schakel deze optie in bij problemen met een grafische chip van Intel."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Schakel deze optie in bij ontbrekende graphics of foutieve belichting in het spel."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Schakel deze optie in bij gebruik van mamehooker met leds, solenoïdes, trilling..."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Inschakelen om shaders toe te staan, ook als RetroBat geen shader heeft ingesteld."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Inschakelen om de joystick van speler 1 op de linkerpoort aan te sluiten in plaats van de rechterpoort."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Inschakelen om de shaders van DuckStation te gebruiken."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Inschakelen om je eigen Project64-instellingen per spel te gebruiken."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Standaard ingeschakeld (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Standaard ingeschakeld, verbetert de gegevensoverdracht van de geëmuleerde SIO-poort."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Standaard ingeschakeld."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Standaard ingeschakeld. Schakelt dithering uit en forceert 24-bits kleuruitvoer."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Standaard ingeschakeld. Uitschakelen kan de prestaties verbeteren, maar breekt sommige spellen."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Standaard ingeschakeld. Snellere shaders, kan zeldzame grafische problemen veroorzaken."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Standaard ingeschakeld. Verhelpt grafische fouten in sommige spellen tegen een kleine prestatiekost."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Standaard ingeschakeld. Verwijdert vervaging in sommige spellen, maar vermindert de nauwkeurigheid."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Standaard ingeschakeld. Vervangt de sprites van het spel door een HD-pakket als er een beschikbaar is. Herstart vereist."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Standaard ingeschakeld. Toont berichten van de emulator zelf."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Standaard ingeschakeld. Wanneer uitgeschakeld, is de framesnelheid beperkt tot 60 FPS."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Standaard ingeschakeld. Wanneer uitgeschakeld, wordt de framesnelheid door het spel beperkt."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Schakelt de 60HZ-modus in om tearing te verminderen op schermen die niet boven 60HZ werken."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Schakelt het automatisch genereren van mipmaps in Direct3D in."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Schakelt de WRX-hoge resolutie in."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Schakelt de anti-blurhack in, minder nauwkeurig maar spellen worden minder wazig."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Laat de pijltoetsen, CTRL en ALT als joystick en vuurknoppen werken."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Schakelt de functie voor eigen patches in."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Schakelt CEL-weergave in hoge resolutie in."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Maakt wisselen tussen verschillende videosignalen mogelijk."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Inschakelen kan problemen geven met 8BitDo-controllers."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Dwingt strikte naleving van de API-specificatie af. Kan in sommige spellen de prestaties verlagen. Kan zeldzame gevallen van ontbrekende graphics en flikkering verhelpen."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Verbetert de grafische nauwkeurigheid, maar verhoogt de prestatievereisten."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "Verbetert de schaduwen van de verschillende objecten."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "Verbetert de kwaliteit van 2D-textures."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Verbetert de kwaliteit van textures op oppervlakken. Alleen OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Verbetert de kwaliteit van textures op oppervlakken. Alleen Vulkan en OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Verbeteringsfilter toegepast op textures."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Voer de lokale UDP-poort in die voor het hosten gebruikt wordt."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Voer het serveradres in."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Voer de eerste tekens in van de spelrom die gebruikt wordt om gegevens over te zetten."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Voer de eerste tekens in van het opslagbestand dat gebruikt wordt om gegevens over te zetten."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Voer het aanraakprofiel in dat geladen moet worden."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Omgevingsgalm (EFX), standaard ingeschakeld."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Exact komt het dichtst bij de console en is het zwaarst voor de GPU. Snel is veel lichter. Auto kiest snel op zwakke of instabiele GPU's."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "Voert de grafische backend uit op een tweede thread, verbetert de prestaties, vermindert haperingen en versnelt het compileren van shaders."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Breidt de SAMS-geheugenkaart uit tot 4M."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Uitbreidingscartridge in de console. Spellen met een bekende vereiste overschrijven dit automatisch."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Experimenteer met deze optie als je joystick wegdrijft (standaard ingeschakeld)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Experimenteel, alleen Windows. Beschermt de stackgegevens van het spel wanneer de emulator geheugenuitzonderingen afhandelt. Kan crashes in sommige spellen verhelpen. Uit laten tenzij een spel het nodig heeft."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Extra controller. Leeg laten tenzij het spel erom vraagt."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Extra geheugenkaart, alleen //e-modellen. Enkele programma's hebben meer nodig dan de standaard 64KB."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "Muisgevoeligheid van de FM Towns."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Fast approximate anti-aliasing, lichter dan MSAA maar waziger."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Snel kan de prestaties verbeteren, maar kan met sommige drivers instabiel zijn."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "ROM voor snel laden van diskettes. Vereist VOLLEDIGE STATIONEMULATIE en de JiffyDOS-ROM's in 'bios\vice'. Niet gebruikt met cassettes en cartridges."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Snel is minder nauwkeurig, ordered en atomic zijn nauwkeurig maar trager."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Snellere DSP-emulatie-engine (experimenteel). Alleen gebruikt wanneer DSP-EMULATIE ingeschakeld is."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Sneller lezen van sectoren. Sommige software verwacht dit mogelijk niet."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Filtert alle textures, ook die het spel uitdrukkelijk als ongefilterd instelt. Standaard uitgeschakeld."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Filter toegepast op het eindbeeld."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Filter dat gebruikt wordt om het beeld naar het scherm te schalen."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Filter dat gebruikt wordt bij het schalen van het eindbeeld."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Filter dat gebruikt wordt wanneer het gerenderde beeld groter is dan het scherm."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Filter dat gebruikt wordt wanneer het gerenderde beeld kleiner is dan het scherm."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Filtering toegepast op 3D-textures."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Filtering toegepast op 3D-textures. Alleen OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Filtering toegepast op sprites en 2D-elementen."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Blijft vuren zolang de knop ingedrukt is."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Activeert bij elk schot de terugslagmotor van het pistool, voor pistolen die er een hebben. Standaard aan."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Past spellen in hoge resolutie of breedbeeld in een frame van 640x480 met zwarte randen. Alleen nuttig op een 4:3-CRT-tv."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Plaatst de Digital Video Cartridge (vmpega.rom in de bios-map), vereist voor FMV-spellen en Video CD's."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Verhelpt een Demul-bug (verlaten van volledig scherm bij schieten in de linkerbovenhoek) door alle muisinvoer naar de Demul-interface te blokkeren."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Verhelpt vertragingen met deze emulator."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Verhelpt texturecorruptie en diepteproblemen op GPU's van AMD en sommige van Intel."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Verwijdert de banding die in opgeschaalde textures kan verschijnen."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Voorkomt dat het spel bij het opstarten in een lus blijft hangen."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Herstelt coplanaire geometrie en decals in sommige spellen, kan andere breken."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Herstelt openingen tussen 2D-elementen."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Verhelpt schaduw- en diepteartefacten in sommige spellen."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Verhelpt enkele grafische bugs met lijnen."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Verhelpt tekstbugs in sommige spellen."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Floating Point Unit, nodig voor sommige 3D-spellen. Standaard aan met de 68040 (ingebouwd), uit met de 68030."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Map voor de gegevens van Vita3K (firmware, geïnstalleerde spellen, opslagbestanden). Genegeerd wanneer Vita3K in draagbare modus staat (niet-lege map 'portable' naast Vita3K.exe)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "Lettertype-ROM vereist voor sommige Japanse spellen."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "Voor Bleach Blade Battlers."

msgctxt "game_options"
msgid "For Goemon."
msgstr "Voor Goemon."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "Wisselt A en B om bij Nintendo-systemen, zodat ze overeenkomen met de knopnamen van Xbox."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "Voor Run Behind- en M-bit-spellen."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "Voor SOCOM 2 HUD/Spy Hunter."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "Voor Scarface The World is Yours en Crash Tag Team Racing."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "Voor SegaScope 3-D-spellen: toont slechts één oog in plaats van het flikkerende paar."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "Voor Superman Returns."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "Voor Tales of Destiny."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "Voor Tri-Ace-spellen."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "Voor spellen met ASTC-textures: kies gemiddeld bij een GPU met 6GB VRAM en laag bij een GPU met 4GB-2GB VRAM."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "Voor N64-controllers met 2 triggers: gebruikt R2 in plaats van L2 als Z-knop."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "Voor de nostalgie. Standaard lijkt het op de versnelde FoW van BG2"

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "Kan bij sommige emulators de koppeling van toetsenbord en muis aan de Wiimote herstellen bij gebruik van 2 Wiimotes."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Forceert GBC-software die zich anders gedraagt wanneer ze op een GBA draait."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "Forceert de Game Boy-modus voor de Game Boy Color."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Forceert de padindex van S1, kan handig zijn als XInput-apparaten niet in de juiste volgorde staan."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "Forceert de padindex van S1, kan handig zijn bij gebruik van een controller op een arcademachine."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "Forceert de padindex van S2, kan handig zijn bij gebruik van een controller op een arcademachine."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Forceert Rawinput; het zou niet nodig moeten zijn dit op AAN te forceren."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Forceert een aantal CPU-cycli per bewerking. AUTO gebruikt de standaardwaarde per spel; alleen wijzigen als een spel niet werkt."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Forceert knoppen in plaats van assen voor de triggers, kan helpen bij Sony-controllers."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Forceert de emulator in volledig scherm, ook als RetroBat in een venster draait"

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Forceert de framebegrenzer."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Forceert hoe textures gesampled worden. Dichtstbijzijnde buur houdt pixels scherp, lineair maakt ze gladder."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Forceert de invoerdriver. Standaard 'sdl', 'dinput' als multiguns ingeschakeld is."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Forceert de resolutie naar de huidige schermresolutie voor spellen die een eigen resolutie toestaan."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Forceert de uitbreidingscartridge van de Saturn als de automatische detectie mislukt."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Forceert de regio van de Saturn als de automatische detectie mislukt."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Forceert stereo op alle ROM's."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Forceert het te emuleren Game Boy-model als de automatische detectie mislukt."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Forceert de VI-verversingssnelheid. AUTO is correct voor bijna elk spel."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Forceert de werkelijke kanaalindeling van de uitvoer. AUDIOKANALEN bepaalt wat het spel ziet, dit bepaalt hoe het naar je apparaat wordt teruggemengd. Op AUTO laten tenzij je uitvoerapparaat verkeerd gedetecteerd wordt."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Forceert de backglass aan of uit. AUTO volgt SCHERMCONFIGURATIE (ingeschakeld wanneer SCHERMCONFIGURATIE niet ingesteld is)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Forceert de bilineaire filtermodus die gebruikt wordt bij het opschalen van dirty rectangles."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Forceert het opstartapparaat (alleen 1F/2F en latere modellen)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "Forceert de regio van de console."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Forceert de regio van de console. Standaard wordt de regio uit het spel gedetecteerd."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Forceert de geëmuleerde verversingssnelheid in plaats van deze uit het geladen spel te detecteren. Vereist een herstart van de core."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Dwingt de emulator een specifiek BIOS-bestand te gebruiken."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Forceert de frequentie van de geëmuleerde CPU. Kan vertragingen verminderen, maar kan fouten veroorzaken. Standaard 57%."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "Forceert de regiofrequentie van het spel om snelheidsproblemen bij de emulatie te voorkomen; laat op 'Auto' tenzij je snelheidsproblemen opmerkt."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Forceert het te gebruiken toetsenbord als er meerdere toetsenborden zijn aangesloten."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Forceert de memory bank controller. Alleen wijzigen als een spel niet correct draait. Vereist een herstart van de core."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Forceert de monochrome weergavemodi, zoals op een groene of amberkleurige monitor uit die tijd."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Forceert het aantal Wiimotes dat het spel detecteert. Zet op 1 voor spellen die naar multiplayer schakelen zodra er meerdere controllers zijn aangesloten."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "Forceert het type mediabestand"

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Forceert het gebruik van de SDL-driver voor controllers; stel dit in bij meer dan 4 controllers, want XInput is beperkt tot 4 spelers."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Forceert het gebruik van de SDL- of DInput-driver voor controllers; stel dit in bij meer dan 4 controllers, want XInput is beperkt tot 4 spelers."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Forceert het gebruik van een specifieke softlist; de softwarelijst moet in de map 'bios\mame\hash' staan."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Forceert het gebruik van high-level BIOS-emulatie."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Forceert de spraakcartridge in sleuf 1, vereist het biosbestand 'voice.zip'."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "Forceert de stuurindex, kan handig zijn als RetroBat de verkeerde index instelt."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "Forceert een verversingssnelheid van 60Hz."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "Forceert de console in PAL-modus in plaats van NTSC, kan traag aanvoelen."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Forceert de emulatie van blit en beeldbewerking op de CPU, in sommige gevallen nauwkeuriger en vereist voor spellen als GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Forceert de raw-input-driver bij gebruik van apparaten zoals trackballs en spinners."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Forceert het compatibiliteitsniveau van de engine. Kies MBF21 voor WAD's die dit vereisen."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Resolutie in volledig scherm. Standaard wordt de bureaubladresolutie gebruikt."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Volledige controle over de camera met de rechterstick."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "GST-savestates kunnen door Kega en Gens geopend worden, maar bewaren minder van de machinetoestand."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Versterking van de krachten van het drive board. Standaard 30%, 200% verdubbelt ze."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Spelresolutie. Hogere waarden tonen meer van het speelveld."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Stuuruitslag van de gamepad in racespellen. Standaard 66%, geen effect op een stuur."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Gamepad: de pad en het toetsenbord bewegen de CD-i-aanwijzer. Muis: de pc-muis beweegt de aanwijzer (point-and-click- en lichtpistoolspellen), de pad behoudt alleen zijn knoppen. Hotkey + L3 wisselt tijdens het spel."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Gamepads worden speler 1, 2... en arcadesticks worden aan de volgende spelers toegewezen."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Algemene timinghack."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "Duits en Frans vereisen een PAL-versie van het spel, Japans een NTSC-versie."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Geeft het hele toetsenbord aan het spel (Scroll Lock geeft het terug aan de sneltoetsen) en vangt de muis. De gamepad blijft werken."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Goed voor problemen met cache-emulatie."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Grafische chipset voor de niet-AGA-modellen. Automatisch volgt het gekozen model, wat bijna altijd gewenst is."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Grafische plugin die gebruikt wordt om het spel te renderen."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Voorinstelling grafische kwaliteit (textures, filtering). AUTO kiest deze op basis van de hoeveelheid geheugen."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Heeft grote invloed op de CPU-prestaties."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Verhoogt de kwaliteit van textures die met render-to-texture-effecten gemaakt worden sterk. Standaard ingeschakeld. Uitschakelen kan crashes voorkomen in spellen met eigen textures."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Lichtpistoolspellen gespeeld met een controller (zonder lichtpistool). Relatief: de stick beweegt de cursor. Absoluut: de stickpositie is de schermpositie, terug naar het midden bij loslaten."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE is snel, LLE is nauwkeuriger maar vereist de DSP-ROM-bestanden."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START stuurt de afsluittoets (X) naar Visual Pinball in plaats van het venster te sluiten."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START stuurt de afsluittoets (X) naar Visual Pinball in plaats van het venster te sluiten: het menu opent (de tafel sluit af met MENU UITSCHAKELEN)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 snel opslaan, START+L3 snel laden, START+R3 schermafbeelding. Standaard ingeschakeld."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Hack die nodig is voor sommige spellen (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Hack die nodig is voor sommige spellen."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Halve scanlines bootsen een CRT-scherm na. 560 x 192 geeft een schoner beeld op een plat scherm."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Harde-schijfcontroller, vereist om .hdv- en .2mg-harde-schijfimages te starten. Wijzigen herstart de machine."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Standaard verborgen; uitschakelen als een spel niet correct start."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Verbergt het wapenmodel in het spel (afhankelijk van het spel)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Verbergt de aanwijzer op het aanraakscherm wanneer deze inactief is (time-out)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Verbergt de meldingen over het compileren van shaders en PPU."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Verbergt het richtkruis na een tijd zonder richten of schieten. Het komt terug zodra je weer richt."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Verbergt de randen van het beeld zoals een tv doet, of voegt een rand toe (negatieve waarden)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Verbergt de witte flits die bij elk schot verschijnt."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "High-level emulatie van enkele functies van Portfolio OS. Kan de prestaties in sommige spellen verbeteren."

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "Hogere nauwkeurigheid verhelpt bugs in sommige spellen ten koste van prestaties. Alleen gebruikt als de SPU-decoder op Dynamic of LLVM staat."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "Hogere framesnelheden via frame-interpolatie, beperkt door verticale synchronisatie. Kan kleine visuele of animatiefouten veroorzaken."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "Hoger is nauwkeuriger maar trager."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "Hogere waarden gebruiken minder geheugen, lagere waarden draaien sneller."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Snelheidsfix voor House of the Dead 4: CPU-frequentie in GHz (bijv. 4.3). Automatisch gedetecteerd als niet ingesteld."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Hoe ver een stick moet bewegen voordat de Amiga het opmerkt. Verhogen als het personage vanzelf wegdrijft."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Hoe snel de paddle beweegt."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Hoe snel de paddles bewegen wanneer de muis als apparaat op de gamepoort gebruikt wordt."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Welk deel van de schermbreedte de paddle van uiterste tot uiterste laat bewegen. Een kleinere waarde maakt de paddle sneller en laat hem zijn aanslagen bereiken zonder dat de aanwijzer het scherm verlaat, wat sommige kalibratieschermen nodig hebben."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Hoe sterk de stick reageert."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Hoe het tv-scherm en het GamePad-scherm worden weergegeven."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Hoe de pad aan de Amiga wordt aangeboden."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Hoe de pad aan de Amiga wordt aangeboden. 'Joystick' is de klassieke stick met 2 knoppen die elk spel begrijpt. 'CD32-pad' voegt de gekleurde knoppen toe en wordt automatisch gekozen op de CD32."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Hoe het beeld wordt weergegeven. RGB is het scherpst, de composiet- en tv-modi reproduceren het kleurverloop van een scherm uit die tijd."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Hoe het beeld wordt weergegeven. De composietmodi reproduceren het kleurverloop van een scherm uit die tijd, RGB is het scherpst."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Hoe het beeld naar het scherm geschaald wordt."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Hybride tekent nieuwe shaders direct terwijl ze gebouwd worden. Asynchroon kan objecten even laten ontbreken. Synchroon laat het spel op elke shader wachten."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Op Uit wordt het ditheringpatroon uitgeschakeld dat de PSX toepast tegen kleurbanding."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Indien uitgeschakeld kan de DualShock met een knopcombinatie tussen DIGITAAL/ANALOOG gewisseld worden."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Indien uitgeschakeld worden deze modules pas gecompileerd wanneer nodig. Afhankelijk van het spel kan dit het spelen onverwacht en mogelijk vaak onderbreken."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Als er meerdere pistolen zijn aangesloten, stel deze optie in om slechts één pistool te configureren."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Bepaalt indien nodig welke GBA-rom gebruikt wordt."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Als de mapnaam 'soniccd' bevat, start RetroBat automatisch Sonic CD RSDK; gebruik dit om het te forceren."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Zolang de joystick binnen deze dode zone blijft, beweegt de cursor niet."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Gebruik je een gamepad met bewegingssensor zoals een DualShock of Switch Pro, schakel dit dan in om de bewegingssensor te gebruiken."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Gebruik je echte Wiimotes met een Sensor Bar, stel dan de juiste positie van de Sensor Bar in voor een betere precisie."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "Negeert de services van Horizon OS, kan crashes in sommige spellen verhelpen."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Negeert bewegingen van de analoge stick onder deze drempel."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "Negeert bestaande ini-bestanden in de map 'bios\mame\ini'."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Negeert kleine stickbewegingen rond het midden. Verhogen wanneer de cursor op het scherm vanzelf wegdrijft."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Negeert de tafelspecifieke backglass-instellingen (.res-bestand naast de tafel) tijdens het spel. Het bestand blijft behouden en wordt bij afsluiten hersteld."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Negeert de in shadPS4 opgeslagen instellingen per spel en gebruikt altijd de RetroBat-instellingen."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Verbetert de prestaties voor CPU's met meer dan 4 cores, standaard ingeschakeld."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Verbetert de prestaties in veel spellen. Uitschakelen kan grafische fouten in sommige andere spellen voorkomen."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "Verbetert de weergave van polygonen bij gebruik van de OpenGL-renderer."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Verbetert de nauwkeurigheid van shaders. Uitschakelen geeft een kleine snelheidswinst, maar kan grafische fouten in sommige spellen veroorzaken."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Verhoogt de resolutie, maar verhoogt de prestatievereisten. Alleen OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Verhoogt de resolutie, maar verhoogt de prestatievereisten. Vereist een Redream-sleutel."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Verhoogt de resolutie, maar verhoogt de prestatievereisten. Alleen Vulkan en OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Verbetert de nauwkeurigheid in sommige spellen, maar kan de prestaties verlagen."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Verbetert de kleurdiepte."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Verbetert de prestaties in sommige spellen, maar slaat alle effecten op basis van de EFB over."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Verbetert de prestaties."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Verbetert de prestaties. Experimenteel met meerdere consoles."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Verbetert de stabiliteit in sommige spellen, maar verlaagt de prestaties."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Alleen in OpenGL."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "Bij spellen met meerdere schijven en een .m3u-bestand: geef het nummer van de te starten schijf op."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "Verhoogt de nauwkeurigheid, kan enkele geluids- en snelheidsproblemen verhelpen."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Verhogen als schoten net naast het doel worden geregistreerd."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Verhogen als het beeld of de speler vanzelf beweegt."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Verhogen als het beeld of de speler vanzelf beweegt. Standaard 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Verhoogt de OpenGL-resolutie van de 3DFx Voodoo."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Verhoogt het aantal sprites dat tegelijk op het scherm getekend kan worden."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Verhoogt het RAM-gebruik en de eerste starttijd, maar vermindert het lezen van de schijf na het opstarten."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "Een hogere waarde kan fouten veroorzaken."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initialiseert kleur-rendertargets vanuit het geëmuleerde geheugen. Nodig voor een correcte weergave in sommige spellen, kan de prestaties verlagen. Standaard uit."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Initialiseert diepte-rendertargets vanuit het geëmuleerde geheugen. Nodig voor een correcte weergave in sommige spellen, kan de prestaties verlagen. Standaard uit."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Voer de te gebruiken server in, in de vorm 'x.x.x.x:y'."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Plaatst de MoonSound-uitbreiding in de I/O-sleuf."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Plaatst de Video9000-uitbreiding in de I/O-sleuf."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Plaatst een diskette in het diskettestation, wordt vaak gebruikt voor cd-rom-spellen."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Geïnstalleerde videochip. Automatisch gebruikt de TMS9918A, tenzij het spel de F18A-upgrade vereist. Vereist een herstart van de core."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Interpoleert de audio-uitvoer voor een betere kwaliteit."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "De interpreter is beter compatibel dan de JIT dynamische recompiler, JIT is sneller."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Wisselt de knoppen A/B en X/Y om."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Keert het signaal van de lichtsensor van de Zapper om. Nodig voor sommige pistoolhardware."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Keert het trekkersignaal van de Zapper om. Nodig voor sommige pistoolhardware."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Keert de verticale as van de rechter analoge stick van de gamepad om."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "Keert de besturing omhoog en omlaag van het richtkruis om."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Keert omhoog en omlaag kijken om (gamepad en muis)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Keert omhoog en omlaag kijken met de gamepad om."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Keert omhoog en omlaag kijken met de rechterstick om."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Keert de verticale as tijdens het vliegen om."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT is het snelst, de interpreter is nauwkeuriger."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Just In Time-compilatie. Versnelt 68020- en latere modellen sterk. Genegeerd op 68000-machines en automatisch uitgeschakeld in cycle exact-modus."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Houdt de DOS-shell actief bij het afsluiten van het spel of als het starten mislukt."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Spelbestanden behouden of verwijderen na het uitpakken (squashfs, 7z)"

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Behoudt de originele beeldverhouding in plaats van het beeld uit te rekken."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Toets die het eigen menu van Amiberry opent. F12 is de enige functietoets die een Amiga nooit had, dus de enige die vrij blijft."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Toets die tijdens de emulatie wisselt tussen venster en volledig scherm."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Toetsen die als joystick worden gebruikt wanneer er geen controller is aangesloten. Pijltoetsen vuren met rechter Ctrl. Numeriek toetsenblok vuurt met 0 of 5. WASD vuurt met linker Alt."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 en R3 voeren de speciale aanvallen van het huidige personage uit, wanneer het spel ze opsomt. Standaard aan."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = Service, R3 = Test, om het operatormenu van de spellen te openen. Standaard aan."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "LLVM is het snelst; gebruik de interpreterinstellingen als er problemen zijn."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "LLVM is de snelste optie met zeer goede compatibiliteit. Gebruik bij problemen de ASMJIT-recompiler."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "Taal waarin spellen tekst moeten tonen."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Taal van de menu's en de tekst in het spel. Een taal die niet in het spel beschikbaar is, wordt genegeerd en de spelinstelling blijft behouden."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Taal van de ondertitels. Een taal die niet in het spel beschikbaar is, wordt genegeerd en de spelinstelling blijft behouden."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Taal van de stemmen. Een taal die niet in het spel beschikbaar is, wordt genegeerd en de spelinstelling blijft behouden."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Grote snelheidswinst op CPU's met meerdere cores, maar een klein aantal spellen loopt er vast mee."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Start MameHooker voor het beheer van uitgangen."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Laat op 'Auto' tenzij de detectie mislukt."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Laat standaard op AUTO, tenzij het spel een specifieke instelling vereist."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Laat op AUTO voor automatische detectie."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Laat op auto om automatisch aan de oriëntatie van het spel aan te passen; gebruik deze instelling om het indien nodig te forceren."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Uit laten tenzij de synchronisatiebron op video staat: vsync en audiosynchronisatie werken slecht samen."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Laat op AUTO zodat de emulator de eerste geldige BIOS kiest die in '\bios\pcsx2\bios' gevonden wordt."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Laat op Automatisch om de processor te behouden die het gekozen model echt had. Een snellere CPU kan spellen breken die op precieze timing vertrouwen."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Laat op Automatisch tenzij een spel een specifieke ROM nodig heeft. Het bestand moet in de bios-map staan. Vereist een herstart van de core."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Laat dit standaard AAN om de JIT-optimalisaties van de CPU in te schakelen."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Laat dit op 16:9 tenzij je een 4:3-monitor hebt."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Laat dit standaard aan; gebruikt meerdere threads voor de weergave."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "Op HANDMATIG blijft de door de gebruiker ingestelde waarde ongewijzigd, AUTO is 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "Links wordt rechts en omhoog wordt omlaag."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Laat ALTIRRA het profiel kiezen op basis van het spel."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Laat RetroArch de controllers toewijzen met zijn eigen autoconfiguratieprofielen in plaats van de RetroBat-toewijzing. Overschrijft de autoconfiguratie van RetroBat."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Laat RetroBat proberen de opstartvolgorde op te halen uit het hash-bestand van MAME of uit de bestandsnaam (haakjes)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Laat RetroBat proberen de opstartvolgorde op te halen uit het hash-bestand van MAME."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Laat Visual Pinball zelf naar de gekozen videomodus schakelen in plaats van de bureaubladresolutie te wijzigen."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Laat een MegaWiFi-cartridgerom je netwerk en internet bereiken. Alleen inschakelen voor ROM's die je vertrouwt."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Laat de core zijn eigen tempo bepalen in plaats van op RetroArch te vertrouwen. Probeer 'standaard 50 Hz' als een PAL-spel ongelijkmatig loopt."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Laat de emulator het GS-geheugen teruglezen. Standaard aan. Uitschakelen is sneller, maar kan sommige grafische effecten breken."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Laat de linkerstick naast de D-pad als joystick werken."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Heft de framesnelheidslimiet van het spel op waar het spel dat toelaat. Alles behalve origineel kan een spel breken."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Verbindt 2 tot 4 Lynx-consoles met de ComLynx-kabel op één scherm, elk met een eigen controller. Schakelt savestates en prestaties uit."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Laadt een eigen profiel voor de stuurtoewijzing."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Laadt mods (.dusk-bestanden) uit een map met dezelfde naam als het spel, ernaast, of uit dusklight\data\mods als die er niet is."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Laadt mods uit de map User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Laadt de mods in de modsmap van het spel (één map met een mod.ini per mod). Standaard aan."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Laadt een voorinstelling voor grafische kwaliteit (textures, filtering, zachte deeltjes). Laat op AUTO om de spelinstellingen te behouden."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Laadt de eerste twee schijven van een spel met meerdere schijven tegelijk in station 1 en station 2, in plaats van alleen station 1. Nodig voor de enkele spellen die om twee stations vragen."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Laadt de vervangende textures van Data\Assets\HDTextures\<rom> in de emulatormap."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Laadt de volledige schijfimage in het geheugen. Sneller laden, hoger RAM-gebruik."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Lage shaderkwaliteit kan de prestaties verbeteren, maar fouten veroorzaken."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Lager betekent minder vertraging, te laag veroorzaakt onderbrekingen."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Verlaagt de GS-precisie om openingen tussen pixels bij upscaling te voorkomen. Herstelt tekst in Wild Arms, ghosting in SoulCalibur."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Lagere waarden verminderen de audiovertraging, hogere waarden verminderen gekraak."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "MSAA- of SSAA-niveau."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Timing van de machine. 60Hz is de Amerikaanse machine, 50Hz de Europese. Enkele Europese programma's hebben 50Hz nodig om op de juiste snelheid te draaien. Wijzigen herstart de machine."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Hoofdgeheugen. Auto gebruikt het RAM van het model of de spellendatabase. Niet-ondersteunde groottes worden afgerond naar de volgende grootte van het model."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "Maakt de warpmodus veel sneller door de SID-emulatie tijdens het warpen op 'FastSID' te zetten."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Wijst handmatig de pad toe die de speler gebruikt. Alleen nodig wanneer RetroBat twee identieke pads niet uit elkaar kan houden, bijvoorbeeld een arcade-encoder voor 2 spelers die Windows als één apparaat ziet. Laat anders op AUTO."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Veel spellen hebben alleen kopieën naar textures nodig, maar zie je zwarte of ontbrekende graphics, dan moet je mogelijk kopieën naar RAM kiezen."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Wijst knop voor knop een 8BitDo M30 of een vergelijkbare pad toe, op basis van mdControllers.json."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Wijst de controller toe als Racing Controller; spellen die niet compatibel waren met het racestuur werken niet."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Wijst select toe aan een extra knop, handig voor Zelda-spellen om te voorkomen dat je bij het opslaan afsluit."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Wijst de triggers toe aan de verticale as van de analoge stick. Handig voor Gran Turismo en andere racespellen."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Stemt de kleuren af op hoe ze er op de echte hardware uitzien."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Wiskundige coprocessor. Slechts een handvol Amiga-titels gebruikt er een, en hem toevoegen aan een machine die hem nooit had kan enkele spellen in de war brengen."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Maximale snelheid van de aanraakcursor met de joystick."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "Maximaal aantal CPU-threads voor het opschalen van textures. Gebruik het totale aantal threads min 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Kan artefacten veroorzaken in sommige spellen."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Kan de prestaties verbeteren op sommige processors met veel cores. Kan in sommige situaties vertraging veroorzaken door de extra belasting van de werkthread."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Kan haperingen verminderen, maar het starten van een spel duurt langer."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Methode voor interlaced videomodi (niet toegepast op de Nintendo 64)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Methode voor interlaced videomodi."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "Methode om gegevens van de schijf te lezen: sync bootst de originele hardware na, async kan haperingen verminderen, pre-cache laadt de volledige image ten koste van een vertraging bij het starten."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Bootst sommige famiclones na die de duty cycles van de blokgolfkanalen omwisselen."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "Mipmapping is nodig voor sommige spellen."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Spiegelt de wereld horizontaal, zoals in de Wii-versie van het spel."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C is de geluidskaart die de meeste spellen ondersteunen. Kies Mouse Card alleen voor software die een echte Apple-muis nodig heeft; deze vervangt de geluidskaart. Wijzigen herstart de machine."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard is de geluidskaart die de meeste spellen ondersteunen. Genegeerd op de //c-modellen, die geen uitbreidingssleuven hebben."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Vooraf gekozen modus op het spelerkeuzescherm. Download Play vereist de originele BIOS en firmware."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "Monochroom is vereist voor spellen in hoge resolutie (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Nauwkeurigere emulatie van het CD-blok. Vereist een CD-blok-ROM en schakelt de instelling voor leessnelheid uit."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "Nauwkeuriger gedrag, maar kan de prestaties verlagen. Standaard AAN."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "De meeste spellen gebruiken poort 2; gebruik deze instelling voor oude spellen waarbij de joystick op poort 1 moet zitten."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Koppelt station C: automatisch bij het opstarten."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Muis: spellen als Elansar of Defender of the Crown. Analoge stick: BattleSphere, kies dit ook in de spelopties."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Beweegt de muis met een analoge stick van controller 1 (L2/R2 = knoppen). Een poort moet op Muis staan."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Bewegen met de linker analoge stick naast de D-pad. Standaard aan."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Niveau van multi-sampling anti-aliasing. Alleen OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Niveau van multi-sampling anti-aliasing. Alleen Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Vermenigvuldiger voor de snelheid van de joystickcursor zolang de knop Speedup Pointer (standaard L2) ingedrukt wordt."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "De multitap moet ingesteld worden als meer dan 2 spelers willen spelen."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Dempt het mechanische geluid van de diskettestations."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "NEE toont alleen het beeld van het linkeroog. Anaglief vereist een 3D-bril in dezelfde kleuren, naast elkaar is voor VR-headsets en 3D-schermen."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC gebruikt cdi200.rom, PAL gebruikt cdi220b.rom."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Natieve resolutie van het spel. Standaard die welke in het spel is ingesteld."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Nodig voor enkele spellen, waaronder diverse point-and-clicktitels."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "Geen munt nodig om een spel te starten."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Aantal geëmuleerde diskettestations. Een echte Amiga 500 had er maar één. Twee stations versnellen spellen met meerdere diskettes, maar enkele titels verwachten er maar één."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Aantal frames tussen elke turbodruk."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Standaard uit. Adaptief wacht niet op het scherm wanneer een frame te laat is."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Standaard uit: de emulator draait zelf op arcadesnelheid (57,5 Hz). Inschakelen als het beeld scheurt."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "Gebruik op een monitor van 120Hz of sneller zonder G-Sync of FreeSync de hoogste verversingssnelheid die een veelvoud van 60Hz is."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Standaard aan; uitschakelen voor geluidskwaliteit van 11khz."

msgctxt "game_options"
msgid "On by default."
msgstr "Standaard aan."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Standaard aan. Uitschakelen voor snelheidswinst op geïntegreerde grafische kaarten."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Standaard aan. Uitschakelen wanneer het pistool een eigen richthulp heeft (laser, Sinden-richtkruis)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Eén pixel per spelpixel (aanbevolen voor shaders)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Geldt alleen wanneer het opschalen van textures (xBRZ) ingeschakeld is. Textures groter dan dit worden niet opgeschaald."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Alleen compatibel met het ASIA/JAPAN MVS-systeem."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Alleen compatibel met OpenGL, synchroniseert GPU en CPU hard. Vermindert de vertraging, maar verhoogt de prestatievereisten."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Alleen compatibel met de software-videodriver."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Alleen werkzaam wanneer FPS BEPERKEN ingeschakeld is. Standaard: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Alleen voor Aziatische versies van de spellen."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Alleen voor recente versies van Ikemen GO. Vulkan is experimenteel."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Alleen framebuffers groter dan deze grootte worden opgeschaald; kan enkele problemen in bepaalde spellen verhelpen."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Gebruik de framebegrenzer alleen als een spel zonder te snel draait. Sommige spellen kunnen crashen als de framesnelheid te hoog is. Stel in dat geval een andere waarde dan Uit in."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Gebruik dit alleen als je twee identieke controllers hebt die niet correct gedetecteerd worden. Koppelt pads op positie in plaats van op naam, wat minder betrouwbaar is."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Gebruik dit alleen om het venster te verkleinen bij gebruik van schaling in de Windows-instellingen."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Alleen gebruikt indien ingesteld; er wordt geen standaardafbeelding voor het richtkruis van S2 aangenomen."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Alleen gebruikt wanneer een MIDI-uitvoerapparaat gekozen is."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Versie van de OpenBOR-engine waarmee het spel draait. Auto detecteert deze uit de spelgegevens, of uit een buildnummer [XXXX] in de bestandsnaam, zoals bij de standalone OpenBOR."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "OpenGL is vereist voor shaders en interne resolutie."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Alleen OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Alleen OpenGL. Verhelpt een zwart scherm op sommige geïntegreerde GPU's van AMD; enkele spellen worden onjuist weergegeven."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Opent een tweede venster voor de Gamepad-weergave."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Optioneel geluidsbord (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) of woofer (Gaelco-spellen). Standaard gemengd, alleen het hoofdbord voor Star Wars Racer Arcade."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "Overklokt de CPU, de SA-1-chip en de Super-FX-chip; kan vertragingen verminderen, maar kan problemen geven in sommige spellen."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Overklokt of onderklokt beide SH-2-CPU's. 100 is de standaardsnelheid."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Overklokt of onderklokt de geëmuleerde hoofd-CPU. Kan de framesnelheid helpen stabiliseren, maar breekt sommige spellen."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Overklokt de geëmuleerde 68k-chip voor een betere framesnelheid."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "Overschrijft de gamepadtoewijzing van RetroBat met de eigen toewijzing van de gebruiker in de scriptmap van de emulator."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Overschrijft de standaardbelichting van de tafel."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL draait op 50 Hz en is correct voor bijna elke Europese Amiga-titel. NTSC draait op 60 Hz en past bij een handvol Amerikaanse uitgaven."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "POM2 herkent controllers aan zijn eigen slotnummer, dat niet de spelersvolgorde van RetroBat volgt. Automatisch neemt de eerste die gevonden wordt; wijzig dit als de verkeerde controller reageert."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "Patcht het TOS-bestand om sneller op te starten."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Pad naar de map met AGS WinUAE; indien ingevuld voegt RetroBat de AGS-launcher toe aan het Amiga-systeem."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Pad naar de map met ExoDOS; vereist zodat RetroBat ExoDOS-spellen kan scannen."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Pad naar de map met ExoWin3x; vereist zodat RetroBat ExoWin3x-spellen kan scannen."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Pad naar de map met ExoWin9x; vereist zodat RetroBat ExoWin9x-spellen kan scannen."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Per spel: elk spel heeft een eigen consolegeheugen van 8 KB, dat dus nooit vol kan raken. Gedeeld: één geheugen voor alle spellen, zoals op een echte speler."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Belichting per pixel in plaats van per vertex. Verbetert de kwaliteit in sommige spellen."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Prestatiewinst, kan ook stabiliteit brengen in sommige spellen zoals GT6."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Plaats een eigen afbeelding voor het richtkruis en kies deze hieronder."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Plaats een eigen bestand 'crosshair.png' in de submap 'cross' van de emulator of kies hieronder een bestand."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Plaats een eigen bestand 'crosshair.png' in de submap 'cross' van de emulator."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: duw de stick omhoog om te stijgen (in de kast stijg je met de stick naar achteren getrokken)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "Speelt MVS-spellen zonder munten in te werpen."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Speelt een waarschuwingspiep af wanneer de gezondheid laag is."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Speelt de piepjes van de VMU af."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Speelt alleen met echte Wiimotes; andere controllers werken niet."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Vooraf gekozen aantal spelers op het spelerkeuzescherm dat bij het starten verschijnt."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Sluit RetroPads op andere poorten aan, handig voor adapters voor 4 spelers."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Sluit een muis aan op de joypoort; dit verwijdert aangesloten joysticks."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "Sluit extra joysticks aan op de poorten 2, 3 en 4."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "Sluit de GunCon aan op poort 2, te gebruiken voor Die Hard Trilogy."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Sluit een MIDI-kaart aan en stuurt de uitvoer naar dit MIDI-apparaat van Windows, genummerd zoals in de MIDI-opties van de emulator. GEEN behoudt het standaard FM-geluid."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Laat de map 'system' van RetroArch naar een andere map wijzen."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "Poort 1 is altijd de Wii U GamePad. Daarbovenop kan een Wii Remote worden toegevoegd voor spellen die er een nodig hebben."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Poort van de Light Phaser. Standaard poort 1."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Poort van de Super Scope. Standaard poort 2."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Poort van de Zapper. Standaard poort 2."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Kan de laadtijd verkorten, maar het opstarten duurt langer."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "PowerPC-recompiler, standaard aan en veel sneller. Uitschakelen voor de interpreter."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Compileert de shadercache vooraf bij het starten van het spel; laat AAN voor minder haperingen in het spel."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "Precise is het nauwkeurigst, relaxed kan de prestaties verbeteren maar sommige spellen breken."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Voorkeursregio. Een spel dat deze niet accepteert, valt terug op een regio die het wel accepteert."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Laadt alle cd-sporen vooraf in het RAM."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Laadt eigen textures vooraf bij het opstarten."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Indrukken om het menu van Amiberry te openen."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Indrukken om de Amiga te resetten."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Indrukken om het schermtoetsenbord te tonen."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Voorkomt sommige artefacten, maar kan harde randen geven."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Voorkomt dat het gemengde geluid van meerdere spelers oversturt."

msgctxt "game_options"
msgid "Processor model."
msgstr "Processormodel."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Processormodel. Een snellere CPU dan de echte machine kan spellen breken die op precieze timing vertrouwen."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Plaatst de pad van speler 1 op poort 1 in plaats van poort 2. Nodig voor enkele spellen, waaronder diverse point-and-clicktitels."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Gemaksaanpassingen: snel transformeren, grotere portemonnees, snel klimmen, direct opslaan, automatisch opslaan, verbeterde kaartmenu's... Klassiek komt overeen met het GameCube-spel. Niet ingesteld: de instellingen in het Dusklight-menu blijven behouden."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD ALS TOETSENBORD: de D-pad stuurt de pijltoetsen en de knoppen SPATIE / ENTER, voor spellen zonder joystickondersteuning."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "Standaard RENNEN; gebruik de renknop om te lopen."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "ReShade wordt door RetroBat gebruikt om bezels en shaders in sommige standalone emulators te tonen. UITGESCHAKELD: bezels worden in plaats daarvan met een overlayvenster getoond. MIJN EIGEN GEBRUIKEN: RetroBat installeert, wijzigt of verwijdert nooit ReShade-bestanden in emulatormappen."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Leest de resultaten van render-to-texture op de CPU. Kan in sommige spellen nodig zijn, maar veroorzaakt synchronisatie midden in het frame en heeft dus een enorme invloed op de prestaties."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Leest de schijf sneller dan het station van de console. Sommige spellen verwachten dit mogelijk niet."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Leest het ini-bestand in de submap 'bios'."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Leest het ini-bestand in de map 'bios\mame\ini'."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "De echte Amiga-snelheid is de veilige standaard. Turbo laadt sneller, maar kan enkele loaders en kopieerbeveiligingen breken."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Plugin voor de Reality Signal Processor, geforceerd op LLE wanneer de videodriver op Parallel staat."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Plugin voor de Reality Signal Processor."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Aanbevolen: Lineair wanneer de schaal van het tweede scherm onder 100% ligt."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "De recompiler is het snelst, de interpreter is nauwkeuriger."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "De recompiler is veel sneller, de interpreter is alleen nuttig voor foutopsporing. Vereist een herstart."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "Verlaagt de nauwkeurigheid voor betere prestaties; de grafische kwaliteit is lager."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Verlaagt de snelheid van de analoge besturing; sommige spellen vereisen lage waarden om speelbaar te zijn."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Verkort laadtijden. Kan enkele spellen breken die op echte schijftimings vertrouwen."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Vermindert haperingen, maar het starten van een spel duurt veel langer en de GPU wordt zwaar belast."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Vermindert het VRAM-gebruik ten koste van kwaliteit, kan haperingen verergeren."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Vermindert klikken door grote schrijfacties naar het DMC-kanaal. Onnauwkeurig, kan sommige gesamplede geluiden verzachten."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Vermindert gekraak en haperingen, maar kan op tragere CPU's de audiokwaliteit merkbaar verlagen; laat op AUTO om het uit te schakelen."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Vermindert flikkering."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Vermindert haperingen en versnelt het opstarten na de eerste keer."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Vermindert wiebelende polygonen en kromtrekkende textures in 3D-spellen."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "Ondersteuning voor MPEG-weergave van ReelMagic."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Vult de riem bij met drankjes uit de inventaris."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "Ververst de status van geheugenpagina's zodat door de GPU geschreven gegevens beschikbaar zijn. (Gebruik voor spellen van 'Team Ninja' om ontbrekende personagemodellen te herstellen)."

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Regio van de NEC PAC-firmware. Japan: pac-n1.bin of pce-lp1.bin. VS: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Regio die als eerste gekozen wordt op schijven met meerdere regio's."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Verwijdert randen van n pixels boven en onder in het scherm."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Verwijdert de zwarte zijbalken in sommige tussenfilmpjes (ultrabrede schermen). Gebieden buiten de originele kadrering kunnen fouten tonen."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Verwijdert de zwarte balken boven en onder tijdens het viseren, richten, tussenfilmpjes en dialogen."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Verwijdert de witte flits die bij het schieten wordt getoond."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Verwijdert één frame invoervertraging, maar verdubbelt de systeemvereisten."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Verwijdert de zwarte randen rond het Amiga-beeld. Sterkere instellingen snijden meer weg en kunnen de randen van enkele spellen afknippen."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Verwijdert de beeldflikkering in Hummer."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Verwijdert de witte flits die verschijnt wanneer de spellen 3D-weergave uitschakelen."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Rendert op een veelvoud van de natieve N64-resolutie. Overschrijft de instelling voor interne resolutie wanneer niet UIT."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Rendert Gouraud-shading met volledige precisie om kleurbanding in 3D-spellen te verminderen."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "Te gebruiken emulatiepad voor render targets. rtv/fbo biedt betere prestaties, rov/fsi de hoogste nauwkeurigheid."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Weergaveresolutie voor vectorspellen."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Rendert in 24-bits kleuren en verwijdert dithering."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Vervangt de originele textures door een eigen texturepakket (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Reproduceert het laagdoorlaatfilter van de echte hardware. 'Geëmuleerd' volgt de filterschakelaar van de machine zelf."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Vraag specifieke slot(s) aan; kies hierboven de optie SPECIFIEK SLOT."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "Vereist voor BASIC-programma's. Gebruikt ATARIBAS.ROM als die aanwezig is, anders de ingebouwde Altirra BASIC."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Vereist voor Formula One-spellen."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Vereist voor Paper Mario: The Thousand-Year Door."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Vereist om de terugspoelsneltoets te laten werken."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Vereist om het spel zonder Cycraft-bewegingskast te starten."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Vereist om Def Jam Icon te herstellen."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Vereist om sommige oude romhacks te draaien; uit laten voor commerciële spellen."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Vereist minimaal '4X SSAA (GEORDEND)'. De 4x-modi vereisen '16X SSAA (GEORDEND)'."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Resolutie van de geëmuleerde video-uitvoer."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "Respecteert de waarden van de Non-Java Mode-bit voor vectorbewerkingen in de PPU-backends. Wijzig deze instelling niet als je twijfelt. Standaard uit."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Responscurve van de aanraakcursor met de joystick."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "RetroBat configureert alleen de controller voor speler 1."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "RetroBat synchroniseert de opslagmappen van Dolphin en libretro-dolphin."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "RetroBat gebruikt standaard de psxonpsp-BIOS; schakel deze optie in om het gebruik van het oude SCPH550X-biosbestand te forceren."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Hergebruikt de shadercache die voor het spel is opgebouwd. Auto laat de emulator beslissen."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Versnellingskeuze met de rechterstick in racespellen met 4 versnellingen. H-schakeling: diagonalen, zoals een echte versnellingsbak. Richtingen: omhoog 1, omlaag 2, links 3, rechts 4. L1/R1 schakelen altijd terug/op."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Draait beeld en besturing. Standaard worden bekende spellen automatisch gedraaid. HANDMATIG: SELECT wijzigt de rotatie."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "Draait het beeld voor verticale spellen, inschakelen voor gebruik met mega-bezels."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Draait het beeld voor verticale spellen."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "Draait het beeld, kan handig zijn voor specifieke spellen die een verticaal beeld nodig hebben."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Draait de actieknoppen om de indeling te wijzigen."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Draait de Windows-weergave van het speelveldscherm tijdens het spelen, hersteld bij afsluiten (Visual Pinball 10.8 en later)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Draait de uitvoer, voor verticale shooters."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Rotatie toegepast aan de uiteinden van een zwaai."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Draait op maximale snelheid terwijl een cd-rom-spel laadt op een stilstaand, stil scherm."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Draait op maximale snelheid terwijl een diskette of cassette laadt, zolang er geen geluid speelt. VOLLEDIGE STATIONEMULATIE is vereist voor diskettes."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Draait op de originele 57,524 Hz in plaats van 60 Hz. Kan haperen op een 60 Hz-scherm."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Standaard rennen, de renknop laat lopen. Standaard ingeschakeld."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Standaard rennen, de renknop laat lopen. Verbruikt uithoudingsvermogen in singleplayer."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "Start het systeem met de BIOS en functies van de G7400."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Laat de GPU en DSP sneller draaien. Kan de framesnelheid van 3D-spellen verhogen, maar kan fouten veroorzaken."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Draait twee verbonden Game Gears naast elkaar. Spelers 1 en 2 besturen scherm 1 en 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Rennen zonder de renknop vast te houden."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "Start 'jgenesis-gui.exe' in plaats van de cli-versie."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "Standaard SDL-gamepad: leest gamepads met de standaardindeling en de andere apparaten (sturen, schakelpoken, arcade-encoders) met hun ruwe knoppen. SDL leest elk apparaat ruw."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT gebruikt de Roland SC-55-soundfont die met RetroBat wordt meegeleverd."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "SSAA biedt een betere kwaliteit ten koste van prestaties."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "UITREKKEN vult het hele scherm en schakelt bezels uit."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Slaat de spelstatus op bij het afsluiten en herstelt deze bij de volgende start (één bestand per spel)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "Opslagen gaan naar een kopie in de saves-map, de originele image wordt nooit gewijzigd. Resetten begint opnieuw vanaf de originele schijf (oude kopie bewaard als .bak)."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Schaal van de statusregel op het scherm."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Schaalt het beeld alleen met hele getallen, voor scherpe pixels."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Schaalt het beeld alleen met hele getallen, voor scherpe pixels. Alleen volledig scherm in 1080p of 4K op een 16:9-scherm, met een kleine afsnijding boven en onder."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Schaalt de X-coördinaten ten opzichte van het midden van het scherm. Verlagen als schoten aan de randen te ver van het richtkruis terechtkomen."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "Scanlines zijn niet compatibel met HQ- of xBRZ-shaders."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Scanlines, schaduwmasker en fosforgloed van een beeldbuis."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "Schermrotatie is niet compatibel met de horizontale indeling."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Scherm voor de DMD op een apart scherm, met dezelfde nummering als MONITORINDEX. AUTO gebruikt het kleinste resterende scherm. Vereist SCHERMCONFIGURATIE met 3 schermen."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Scherm voor de backglass, met dezelfde nummering als MONITORINDEX. AUTO gebruikt het grootste scherm naast het speelveld. Vereist SCHERMCONFIGURATIE."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Scherm waarop spellen worden getoond (0 = hoofdscherm). AUTO laat de emulator zijn scherm kiezen."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Schermen die de flipperkast gebruikt (Visual Pinball 10.8 en later). De posities van backglass en DMD worden dan automatisch berekend. Niet ingesteld: de SCREENRES-waarden worden gebruikt."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Schermen die de flipperkast gebruikt. De posities van backglass en DMD worden dan automatisch berekend. Niet ingesteld: 1 scherm."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "Schrijft 0xCD in al het toegewezen heapgeheugen."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "Een tweede joystick kan conflicteren met de muis."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Kies 'game specific' om het spelspecifieke cfg-bestand in de map emulators\psxmame\ctrlr te gebruiken."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Kies het type Cathode Ray Tube Controller van de Amstrad."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Kies het te emuleren Amstrad-model."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Kies muis of joypad om de virtuele aanwijzer in het spel te besturen."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Kies NEE om de texturecache uit te schakelen."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "Kies een BigPEmu-shader, alleen mogelijk wanneer de RetroBat-shaders op 'geen' staan."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Kies een toe te passen filter."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Kies een toe te passen shader."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Kies tussen de verschillende controllerindelingen."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "Kies de controllerindeling bij gebruik van de optie 'Dynamic Profile'."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Kies de schermhoek waarin de tatoeage verschijnt."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Kies een toe te passen effect; heeft geen effect bij gebruik van shaders."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Kies de indeling van de actieknoppen."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Kies in welke poort de GBA-rom geplaatst wordt, standaard 2."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Kies het te emuleren model."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Kies een toe te passen shader, alleen compatibel met de videodriver 'bgfx'."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Kies een toe te passen shader, alleen compatibel met de videodriver 'openGL'."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Kies de schakelmodus voor BattleGear4Tuned."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "Kies de GPU-plugin; RetroBat-opties werken niet met een niet-standaardplugin, die kan geconfigureerd worden vanuit de emulatormap met config.exe."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Kies de IPL-BIOS om een spel volgens zijn regio te starten. Vereist 'IPL_JAP.n64', 'IPL_USA.n64' en 'IPL_DEV.n64' in de map bios\Mupen64plus."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Kies het apparaat dat de X- en Y-coördinaten leest."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "Kies de driver voor shaders bij gebruik van de videodriver bgfx."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "Kies de uitbreiding die aan de controller wordt toegevoegd."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Kies de presentatiemodus van frames."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Kies het belichtingsmodel; de oude modus is het minst veeleisend voor de grafische kaart."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Kies de te emuleren machine."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Kies het profiel dat aan de speler wordt toegewezen."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "Kies het bronsysteem voor de transfer pack tussen GB en GBC."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "Kies het type console."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "Kies het type beeldkader. Gebruik de waarde EMUSCV om weergavefouten van de originele console te corrigeren."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "Kies het type pistool afhankelijk van het spel."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Kies de videomodus (type kabel)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Kies waar de knoppen voor munt en start worden toegewezen bij spelen met een stuur."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Kies waar de knoppen voor test en service worden toegewezen bij spelen met een stuur."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Kies of de kruis- of de cirkelknop de bevestigingsknop is."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "Kies welke audio-engine intern gebruikt wordt."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Kies welk kleurfilter wordt toegepast."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Kies welke grafische API gebruikt wordt met de texture-renderer."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Kies welke joystick geëmuleerd wordt (niet compatibel met MASTER COMPACT)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Kies welke joystick geëmuleerd wordt."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "Kies welk scherm getoond wordt bij de hybride indeling."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Stuurt het volledige rompad naar MAME in plaats van alleen de romnaam."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Stuurt de uitgangen van lampen en het drive board naar externe tools (MAMEHooker...) via Windows-berichten."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Stuurt de uitgangen van lampen en pistoolterugslag naar externe tools (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Stuurt de uitgangen van lampen, pistooltrilling en het drive board naar externe tools (Hook Of The Reaper, QMamehook...) via het netwerkprotocol van MAME."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Gevoeligheid van de geëmuleerde spinnercontroller."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Stelt een standaard-ISO in, te gebruiken met sommige homebrewspellen."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Stelt de standaard controllertoewijzing voor speler 1 in."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Stelt de standaard controllertoewijzing voor speler 2 in."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Stelt de standaard controllertoewijzing in."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Stelt het licentiemasker in voor geactiveerde inhoud (ALLE LICENTIES is meestal een slecht idee en kan tot ongedefinieerd gedrag leiden)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Stelt het schalingsfilter in voor de gerenderde inhoud. FSR vereist Vulkan."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Stelt het schalingsfilter in voor de gerenderde inhoud. Alleen OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Stelt de moeilijkheidsschakelaar van de Atari 2600 in."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Stelt het gedrag van de microfoonknop in."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Zet de console op breedbeeld, voor de spellen die dit ondersteunen."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Stelt de verversingssnelheid van de host in."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Stel dit in voor spellen die een controller in poort 2 vereisen."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Zet dit aan bij gebruik van meerdere pistolen. Standaard aan als er meerdere pistolen gevonden worden en de invoerdriver niet op 'sdl' staat."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Stel deze optie alleen in bij gebruik van een echte Balance Board."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Stel deze optie in om de microfoon in sleuf B te plaatsen."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Zet dit op 'AAN' om Steam of de Epic Games Launcher af te sluiten bij het afsluiten van het spel."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Stel dit in om de GunCon op poort 2 aan te sluiten, gebruikt voor bepaalde versies van Die Hard."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Stel dit in om de originele PSX-gamepad te gebruiken in plaats van de DualShock."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Zet op JA om in racespellen terug te keren naar neutraal wanneer de schakeltoets wordt losgelaten."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Stelt de helderheidsverschuiving van het geëmuleerde LCD-scherm in."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Stelt het contrastniveau van het geëmuleerde LCD-scherm in."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Stelt de PowerPC-frequentie in MHz in. 0 (standaard) gebruikt de frequentie van het spelbord."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Stelt de PowerPC-frequentie in MHz in. AUTO gebruikt de frequentie van de spelhardware (alleen Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "Stelt de PowerPC-frequentie in MHz in. De standaardwaarde is 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Stelt de dode zone van de analoge sticks van de gamepad in wanneer het invoerapparaattype op 'Gamepad Classic' of 'Gamepad Modern' staat."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Stelt de dode zone van de analoge sticks van de gamepad in."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Stelt de dode zone van de analoge triggers van de gamepad in."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Stelt de dode zone van de analoge sticks in. Alleen gebruikt met het controllertype 'Gamepad Modern'."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Stelt het controllertype van de speler in."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Stelt de gevoeligheid van de analoge sticks in."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "Op 0 wordt alles als afgedekt gemeld; vereist voor Forza Motorsport 4."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Op 1 kan de prestaties verbeteren."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Vorm van de pixels: vierkant of zoals op het originele scherm."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Vorm van het schaduwmasker dat de CRT-shader tekent. Alleen gebruikt wanneer de shader op CRT-masker staat."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "Standaard één gedeelde CMOS voor alle inhoud, of één per spel (beter voor netplay)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "Intensiteit van de verscherping door FidelityFX CAS. Alleen gebruikt wanneer het schalingsfilter op FSR staat."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Korte berichten op het scherm (status opgeslagen...). Standaard aan."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Toont de Dolphin-interface naast het spelscherm."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "Toont een FPS-overlay in het spel."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Toont de debugconsole van Ryujinx."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Toont een besturingsafbeelding over de bezel heen."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Toont een melding wanneer een controller wordt aangesloten of losgekoppeld."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Toont de interface van de emulator."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Toont meldingen van de emulator, standaard ingeschakeld (AUTO)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Toont meldingen van de emulator."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Toont spelinformatie in de linkerbovenhoek van Craft."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Toont informatie over het compileren van shaders."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Toont informatie over de huidige schermindeling in de rechterbovenhoek."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "Toont of verbergt de RetroArch-instellingen. 'Auto' is de aanbevolen instelling."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Toont een overlay met prestatiestatistieken in het spel."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Toont meldingen over het compileren van shaders."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Toont de horizontale randen. AUTO snijdt ze bij tot het gebied dat het spel gebruikt, het best met PAR VOLGENS DOT CLOCK."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Toont een Amiga-toetsenbord onder in het scherm om met de pad te typen. Wissel het met een toegewezen knop, beweeg met de D-pad of stick en druk op een andere knop om de toets te typen."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Toont kogelgaten op muren waar schoten inslaan."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Toont stationsactiviteit en prestatie-informatie over het beeld."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "Toont de uitgebreide PAL-CRT-lijnen, maar deze zijn in de meeste spellen meestal leeg."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Toont namen van diskettes, stationslampjes en snelheid, in venster en volledig scherm."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Toont het configuratiescherm van WHDLoad wanneer een spel dit ondersteunt."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Toont de WHDLoad-prompt en wacht op een knopdruk voordat het spel start. Standaard uit, zodat het spel direct opstart."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Verkleint/vergroot de tatoeage zodat deze binnen de rand van de bezel past."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "Simuleert nagloei-effecten van CRT-fosfor. 'Simple' mengt het huidige en het vorige frame 50:50."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "Simuleert nagloei-effecten van een LCD-scherm."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Simuleert effecten die specifiek zijn voor de PowerVR2-GPU en analoge videosignalen."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simuleert de kleuren van het LCD-scherm van de Game Boy Color."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "Simuleert het CRT-nagloei-effect, kan gebruikt worden om flikkering te voorkomen."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Simuleert nagloei, kan helpen flikkering te verminderen."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Grootte van menu's en panelen. Door het spel begrensd tot de grootste schaal die in de interne resolutie past."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Grootte van de spelpixels: hogere waarden zoomen in en tonen een kleiner deel van de kaart. Standaard: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "Grootte van het grootste scherm bij een hybride schermindeling."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Grootte van het tweede scherm ten opzichte van het hoofdscherm (alleen indelingen boven/onder)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Grootte van het venster wanneer niet in volledig scherm."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Grootteverhouding van de 2 geëmuleerde schermen."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "Slaat VBI over wanneer vertraging gedetecteerd wordt; helpt bij haperend geluid wanneer de emulatiesnelheid daalt."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Slaat het tekenen over van een frame dat identiek is aan het vorige. Kan de prestaties verbeteren."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Slaat frames over om audiogekraak op trage apparaten te voorkomen."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Slaat frames over om de prestaties te verbeteren, ten koste van schokkerige beweging."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Slaat bij het opstarten de 60 seconden wachttijd op andere kasten over. Uitschakelen voor spelen met meerdere kasten."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "Slaat het opstartlogo van de BIOS over."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Slaat de opstartcontrole over die verhindert dat het spel start."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Slaat de hardwarecontroles bij het opstarten over (camera, stuur, kaartlezer)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Slaat de lange initialisatie van de stuurmotor bij het opstarten over. Kies de revisie van je spel."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Slaat de mechanische wachttijd van het diskettestation over. Laden gaat veel sneller, de diskette zelf wordt nog precies als het origineel gelezen."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Slaat de opstartvideo's en het logo over."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Slaat de opstartvideo's over."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Slaat de initialisatie van de stuurmotor bij het opstarten over."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Slaat video's/FMV's over."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "Slaat het tekenen van oppervlakken over voor het links en rechts bepaalde gebied."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Slaat de opstartanimatie van de BIOS over die bij het laden van inhoud verschijnt."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Slaat de opstartanimatie van de BIOS over die bij het laden van inhoud verschijnt. Uitschakelen om bij de systeeminstellingen van de PS2 en het geheugenkaartbeheer te komen."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Slaat de opstartanimatie van de BIOS over bij het laden van inhoud."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Sleuf waarin de schijfimages gekoppeld worden. AUTO kiest deze op basis van het imagetype. Alleen wijzigen als een spel weigert op te starten."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Trager, maar vereist voor enkele spellen die van het cachegedrag afhangen."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Maakt 3D-textures gladder."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Vlakt veranderingen in het sturen af. Nodig bij gebruik van een gamepad of toetsenbord."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Maakt de randen gladder met een shader, verzacht het beeld licht."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Maakt het geluid van de Paula-chip gladder. 'Sinc' is het meest verfijnd en het meest veeleisend."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Verzacht het sturen met de gamepad in racespellen. Standaard sterk, geen effect op een stuur."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Sommige SPU-fasen zijn gevoelig voor race conditions; er een beperkt aantal tegelijk toestaan helpt prestatiehaperingen te verminderen. Een lagere waarde kan de prestaties verbeteren en haperingen in sommige spellen verminderen."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Sommige spellen laden niet als het systeem wordt aangezet met een cd in het station. 'JA' plaatst de cd tijdens de opstartanimatie."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Sommige spellen hebben een specifieke toetsenbordtoets nodig voor bepaalde acties; bepaal de toets die aan de SELECT-knop van de controller van speler 1 wordt toegewezen."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Sommige spellen vereisen omgekeerde assen voor pistolen."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Sommige spellen vereisen de uitbreiding Game Drive."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Sommige spellen vereisen de controller in de tweede poort om granaten te gooien."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Sommige versnellingspoken zijn met een andere apparaat-id dan het stuur op de computer aangesloten, bijvoorbeeld de poken van Thrustmaster."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Sommige homebrew en romhacks vereisen een specifiek RAM-patroon bij het inschakelen. Herstart vereist."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Sommige homebrew of romhacks vereisen dat deze optie ingeschakeld is."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "Geluidsbron voor MIDI-muziek. De MT-32-opties vereisen de bijbehorende Roland-ROM's in de bios-map."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Bepaalt hoe de emulatie van de realtimeklok in bepaalde spellen moet werken."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Bepaalt welke uitbreiding gebruikt wordt voor het afspelen van audio-cd's met gepatchte MD-spellen."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Geef de te activeren IPS-patch op; indien niet ingesteld worden alle patches uit de ips-.ini gebruikt."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Geef het filter op dat voor upscaling gebruikt wordt."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Geef het pad naar de bezel op."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Geef het pad naar het firmwarebestand op."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Geef het te emuleren computermodel op."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "Geef de videoweergavemethode op. Accurate is het nauwkeurigst maar trager, good en fast zijn sneller maar kunnen bij sommige spellen falen."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Geïnstalleerde spraakmodule."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Snelheidshack, maar is mogelijk niet compatibel met sommige spellen."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Snelheidshack, kan trage spellen helpen ten koste van fouten."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Snelheidshack."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Snelheid van de muis met de analoge stick."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Snelheid van de geëmuleerde Amiga-muis."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Snelheid van de muisaanwijzer die met de linkerstick bewogen wordt."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Versnelt het laden van de GD-ROM, kan sommige spellen breken."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Versnelt het laden van diskettes. Kan sommige spellen met kopieerbeveiliging breken."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Versnelt de toegang tot diskettes om laadtijden te verkorten."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Verdeelt de weergave over meerdere CPU-threads. Alleen nuttig bij hoge interne resoluties."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Laat het stuur terugveren naar het midden zolang het spel geen force feedback aanstuurt, zoals de mechanische veer van een arcadekast."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Standaard diskettecontrollerkaart."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Start direct in Commodore 64-modus."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Start de controller met de sticks al ingeschakeld, in plaats van in het spel op de ANALOG-knop te moeten drukken."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Start de schijf direct in plaats van te wachten op het menu PLAY CD-I. Standaard aan."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Start het spel in testmodus. Test: toets 0 of R3, service: toets 9 of L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Start Outrun 2 SP SDX zonder de kastcontroles (drive board en toren)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Start het Wii-menu (het menu moet in Dolphin geïnstalleerd zijn)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Dode zone van de stuuras, voor pads of sturen zonder zelfcentrering."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Slaat BC1-textures op in 16-bits. Bespaart videogeheugen tegen een klein kwaliteitsverlies."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Sterkte van de trilling van de controller. Standaard 60%."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Sterkte van de terugslagmotor van het pistool. Standaard 60%."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Rekt menu's en 2D-schermen uit tot de volledige schermbreedte."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Rekt pixels verticaal uit zoals het originele DOS-spel op een 4:3-scherm. Standaard: ingeschakeld."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Rekt het beeld uit om het scherm te vullen, zonder rekening te houden met de beeldverhouding."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Rekt het beeld uit over het hele scherm in plaats van de vorm van een monitor uit die tijd te behouden."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Studio: tv-niveaus van een echte speler, zwart ziet er op een pc-scherm donkergrijs uit. Volledig bereik: diep zwart."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Supersampling van framebuffereffecten, kan artefacten veroorzaken."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Surround speelt de achterluidsprekers van de Model 3-kasten met vier luidsprekers (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) af op de achterluidsprekers. Andere spellen blijven in stereo."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Wisselt paddle 1 en paddle 2 om, nodig voor enkele spellen die de assen andersom verwachten."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Wisselt de knoppen A en B van de controller om."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Wisselt de knoppen A/B en X/Y van de controller om."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Wisselt het tv- en GamePad-scherm om in de indelingen naast elkaar, boven/onder en beeld-in-beeld."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Wisselt de twee Amiga-poorten om. Nodig voor enkele spellen, waaronder diverse point-and-clicktitels."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Wisselt de pistoolindexen tussen speler 1 en speler 2."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Inschakelen om de RetroBat-map 'saves\switch' te gebruiken voor de opslagbestanden van Citron en Eden (in plaats van de emulatormap)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Zet het controllertype van speler 1 op geen als de juiste toetsenbordinvoer niet gelezen wordt."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Inschakelen om het servicemenu via de knoppen R3 en L3 te activeren."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Inschakelen om het servicemenu te activeren."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Inschakelen om de D-pad te gebruiken in plaats van de linker analoge stick."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Schakel deze optie in om volledig scherm uit te schakelen en de emulator in een venster te draaien."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Inschakelen om lichtpistool 1 voor speler 2 en lichtpistool 2 voor speler 1 te gebruiken."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Inschakelen bij gebruik van een specifieke de-interlacemodus kan vervaging helpen verminderen."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "System Card gebruikt door de LD-ROM2-spellen die er een nodig hebben. Standaard: SYSTEM CARD 1 als syscard1.pce in de bios-map staat."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "Adapter voor de aansluiting van de TI-99 Speech Synthesizer."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "TOS 1.06 is alleen voor de STE: als het machinetype niet ingesteld is, wordt automatisch STE gekozen."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Mikt op 60fps in plaats van de natieve 59,73fps."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 spelers in White Men Can't Jump en NBA Jam T.E. Rotary: Tempest 2000, bestuurd met de muis."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "De Amiga stuurt zijn kanalen volledig naar links en volledig naar rechts. Verlagen mengt ze en is veel aangenamer met een koptelefoon. 10 is het gedrag van de originele hardware."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "De Amiga stuurt zijn kanalen volledig naar links en volledig naar rechts. Verlagen mengt ze en is veel aangenamer met een koptelefoon. 100% is het gedrag van de originele hardware."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "De Neo Geo-modus. UNIVERSE BIOS biedt meestal de beste compatibiliteit."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "Het RetroBat-team heeft profielen gemaakt voor enkele gangbare controllers; ze staan in de map 'saves\mame\ctrlr'. AANGEPAST kan gebruikt worden om je eigen toewijzingen op te slaan."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "De hoeveelheid videogeheugen."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "De BIOS die de emulator gebruikt."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "De driver 'xinput' schakelt functies zoals trileffecten in. Kies 'sdl' voor compatibiliteit met een breed scala aan controllers."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "De regio van het spel moet overeenkomen met de regio van het Wii-menu, anders wordt het spel niet herkend."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Hoe hoger de waarde, hoe verder weg objecten worden getoond."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "De rechter analoge stick van speler 1 bestuurt de tweede joystick, voor spellen met twee sticks (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "De rechterstick wordt als rechter D-pad gebruikt (ook op L2, R2, L3 en R3)."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "In sommige spellen zit een bug waardoor de emulator crasht als er meer dan 1 apparaat actief is."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Dikte van de witte rand die getekend wordt wanneer een Sinden-pistool aangesloten is. Standaard normaal (12 pixels)."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Handig in racespellen om het sturen met een controller minder 'zenuwachtig' te maken."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Deze optie wijzigt het geluidsbord van Yamaha op de geëmuleerde pc. OPN is de standaardoptie. OPNA-geluid ondersteunt meer FM-kanalen en PCM-samples."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Deze optie regelt de SPU-analyser, met name de grootte van de gecompileerde eenheden. Gebruik de veilige modus voor maximale compatibiliteit."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "Deze optie moet uitgeschakeld zijn om SIGIL te spelen."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Deze optie geldt alleen voor de GameCube-controller."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Deze optie bepaalt of de PCG-8100 al dan niet geëmuleerd wordt. Kan nodig zijn voor sommige software van de PC-8000-serie."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Deze optie stelt de CPU-kloksnelheid van de geëmuleerde pc in."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Deze optie stelt de CPU-kloksnelheid van de geëmuleerde pc in. Met overklokopties draait de meeste software sneller dan normaal."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "Deze instelling kan alleen gebruikt worden met het filter 'scanlines'."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Deze instelling voorkomt dat de emulatie pauzeert wanneer de focus verloren gaat."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Deze instelling draait je Windows-bureaublad; dit wordt bij het afsluiten van het spel niet teruggezet."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Start het spel zonder enige gekozen grafische of CPU-verbetering."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "Start de BIOS van de console in plaats van een spel."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Drempel vanaf welke beweging van de analoge stick als digitale richting telt."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Verlaagt het aantal geëmuleerde CPU-cycli dynamisch als je CPU het niet bijhoudt (standaard uitgeschakeld)"

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Kantelinvoer voor Kirby Tilt 'n' Tumble en andere MBC7-spellen. Standaard analoge stick."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "Trapdoor-uitbreidings-RAM, zoals in de klassieke A501-uitbreiding."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Probeert de setup van het spel te starten."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Probeert lusvoorwaarden in SPU-kernels te detecteren en gebruikt ze als planningshints. Standaard uit"

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "Probeert het spel te detecteren en een controllertoewijzing toe te passen."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Probeert de beste verversingssnelheid voor de ROM te kiezen."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "TurboTap is nodig om met meer dan één speler te spelen. Wordt automatisch ingeschakeld wanneer een tweede controller is aangesloten."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Schakelt meldingen van de emulator in: aangesloten controllers en berichten over het compileren van shaders."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Draaisnelheid met de muis. Standaard: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Inschakelen om alleen de D-PAD voor richtingen toe te wijzen."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Inschakelen bij gebruik van een lichtpistool dat herladen buiten het scherm niet ondersteunt."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "Met deze optie meldt MAME muisbewegingen en knopdrukken van verschillende muizen onafhankelijk van elkaar."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Maakt van de rechterstick een Amiga-muis, handig voor menugestuurde en point-and-clickspellen zonder de pad los te laten."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Standaard twee lagen (bit-exact). Gesorteerd herstelt gestapelde rook en glas, dambord reproduceert het arcadebord (sneeuw en mist van Sega Rally 2)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Type APPLE II om te emuleren."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Type Archimedes-computer om te emuleren."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Type BBC Micro om te emuleren, standaard MODEL B."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Type CPU-emulatiecore om te gebruiken."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Type Color Computer om te emuleren, standaard coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Type computer om te emuleren."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Type FM Towns om te emuleren, standaard FM TOWNS (MODEL 1/2)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Type FM-7 om te emuleren, standaard FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "Type frame skipping."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Type LYNX om te emuleren, standaard 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "Type ROM-bestand"

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Type V.Smile om te emuleren."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "Type joystick aangesloten op de gamepoort."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Heft de framesnelheidslimiet van het spel op als er een patch in de interne database gevonden wordt."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Ontgrendelt extra talen in sommige spellen als de coredatabase er een vermelding voor heeft."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Verhoogt de CPU-frequentie van 93,75 naar 125 MHz. Kan sommige CPU-afhankelijke spellen versnellen."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Schaalt de textures van het spel op met een pixelartfilter."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Upscalingfilter voor de 2D-lagen (HUD, achtergronden)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Upscalingfilter voor de 2D-lagen (HUD, achtergronden). Alleen Vulkan en OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Gebruik 'ZUID' voor de A-knop en 'WEST' voor de B-knop."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Gebruikt de map 'cfg64' voor de standalone MAME."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Gebruik het richtkruis 'custom' om het gekozen richtkruisbestand in te schakelen."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Gebruik het richtkruis 'custom' om het hier gekozen bestand in te schakelen."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Gebruik 'per game' als je een profiel voor het spel hebt opgeslagen in de map capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Gebruik 50 voor de Europese console en 60 voor de Japanse console."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Gebruik 8mhz voor een betere compatibiliteit."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Gebruikt de analoge stick als D-PAD."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Gebruik DSI voor DSi-spellen zoals DSiWare."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Gebruik Alleen joystick voor joystickspellen en Alleen toetsenbord voor toetsenbordspellen."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Gebruikt de linker analoge stick in plaats van de D-PAD voor de besturing."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Gebruikt R1 en L1 om te accelereren en te remmen in racespellen, alleen compatibel met automatisch schakelen."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Gebruikt Resizable BAR voor GPU-uploads indien beschikbaar. Uitschakelen bij haperingen of instabiliteit met je driver."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Gebruikt SDL voor alle controllers in plaats van XInput voor Xbox-controllers."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Gebruikt de timings en het gedrag van de SGB2."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Gebruikt SSE4 in plaats van AVX2 voor oudere CPU's."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Gebruikt een hires-filter om de weergave te verbeteren."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Gebruikt een voorgedefinieerd kleurenpalet in plaats van het palet dat de emulator berekent."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Gebruikt een alternatieve diepteverwerking; inschakelen bij grafische problemen of een specifieke foutmelding."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Gebruikt ampersand en parentleft voor start en munten."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Gebruikt een externe firmware (standaard 'firmware.bin' in de bios-map)."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Gebruikt de analoge stick in plaats van de D-pad."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Gebruikt bilineaire filtering om het hele beeld gladder te maken."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Gebruikt de BIOS voor bepaalde systemen zoals Neo Geo en Sega ST-V"

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Herladen met een knop in plaats van een schot buiten het scherm, voor pistolen die schieten buiten het scherm niet ondersteunen."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Gebruikt knoppen in plaats van een analoge as voor het stuur."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Gebruikt het standaard audio-invoerapparaat van de computer als microfoon."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Gebruikt de hat naast de joystick om te bewegen."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Gebruik de interpreter voor de beste compatibiliteit, dynarec voor prestaties."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Gebruikt de linker analoge stick naast de D-pad."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Gebruikt de linker analoge stick in plaats van de D-PAD."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "Gebruikt de linkerstick als D-pad."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Gebruikt één gedeelde geheugenkaart voor alle spellen in plaats van één kaart per spel. De kaarten staan in '\bios\pcsx2\memcards'."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Gebruikt pixelnauwkeurige emulatie waar beschikbaar."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Gebruikt de poorten 5-8 voor GameCube-controllers in Wii-modus."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Gebruikt preemptive frames in plaats van run-ahead; het aantal run-ahead-frames is van toepassing."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Gebruikt echte GameCube-controllers via een GameCube-adapter. Alleen met echte Wiimotes."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Gebruikt de schouderknoppen voor L en R in plaats van de triggers."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "Gebruikt de schouderknoppen in plaats van de triggers."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Gebruikt de 3D-modellen van HD-pakketten in plaats van sprites (OpenGL-renderers). Standaard ingeschakeld."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "Gebruikt de BIOS in de RetroBat-map 'bios'. Vereist om in de BIOS op te starten."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Gebruikt de BIOS in de RetroBat-map 'bios'."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Gebruik de waarde HOGE FREQUENTIE voor schermen met een hogere verversingssnelheid."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Gebruikt de bezels van het Odin-artworkpakket (artwork-map van de emulator) in plaats van de RetroBat-decoraties."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Gebruikt de compute-shader-renderer in plaats van de klassieke OpenGL-renderer. Sneller bij hoge interne resoluties, vereist OpenGL 4.3."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Gebruikt de ingebouwde BIOS van de emulator in plaats van de bestanden in de bios-map. DS Download Play vereist de originele BIOS en firmware."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Gebruikt de textures in hoge resolutie van HD-pakketten (OpenGL-renderers). Standaard ingeschakeld."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Gebruikt de muis als paddles van de Apple II, nodig voor Arkanoid, Breakout en de andere spellen met draaiknop. De positie van de aanwijzer op het scherm is de positie van de paddle. Vervangt de controllerstick voor paddle 1 en 2; uit laten voor joystickspellen."

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Gebruikt de instellingen per spel die in de Vita3K-interface zijn opgeslagen. Ze overschrijven de RetroBat-instellingen voor dit spel."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Gebruikt de eenvoudige double hi-res-kleurtabel. Enkele Apple II-programma's lijken er meer op de echte machine."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Gebruik dit als de emulator na het laden crasht of niets toont."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Gebruik dit alleen als de analoge stick wegdrijft."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Gebruik deze optie als ArcadeDuck niet op de juiste monitor getoond wordt."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Gebruik deze optie als Keisho niet op de juiste monitor getoond wordt."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Gebruik deze optie als Odin niet op de juiste monitor getoond wordt."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Gebruik deze optie als PCSX2 niet op de juiste monitor getoond wordt."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Gebruik deze optie als DuckStation niet op de juiste monitor getoond wordt."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Gebruik deze optie als S1 en S2 omgewisseld zijn."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Gebruik deze optie bij een pad die als toetsenbord herkend wordt (ipac, enz.)."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Gebruik deze optie bij een stuur zonder handmatige versnellingspook."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Gebruik deze instelling voor vliegspellen."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Gebruik deze instelling om de helderheid te verlagen of te verhogen, niet compatibel met de videodriver 'gdi'."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Gebruik deze instelling om het contrast te verlagen of te verhogen, niet compatibel met de videodriver 'gdi'."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Gebruik deze instelling om de gamma te verlagen of te verhogen, niet compatibel met de videodriver 'gdi'."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Gebruik deze instelling om een standaard doelknop voor turbo te bepalen."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Gebruik deze instelling om de bestanden run.bat, autoexec.bat of dosbox.bat in de spelmap te negeren."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Gebruik deze instelling om de invoervertraging te verminderen."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Gebruik dit om inhoud zoals HD-pakketten automatisch te laden."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Gebruik winkey voor het toetsenbord, xinput als je een XBOX-controller hebt, sdl voor andere soorten controllers."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Gebruikt je eigen .cfg-bestand in saves\mame\cfg. Hertoewijzingen met TAB in het spel blijven behouden. Bij de eerste activering wordt de toewijzing van de laatste sessie automatisch geïmporteerd. De optie controllerindeling geldt niet meer voor dit spel."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Handig voor spellen met schermschudeffecten zoals Wipeout Fusion, kan het beeld wazig maken."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Handig voor processors met één thread."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Handig op sommige schermen met een hoge verversingssnelheid om ghosting te verwijderen."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Handig bij een resolutie die hoger is dan die van het scherm. Voorkomt moiré-effecten."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Gebruikt 60hz (480i) in plaats van 50hz (576i)."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "Emulatie van het VI-post-processingfilter."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Waarden boven 1,00 vergroten, waarden eronder verkleinen."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "Verticale spellen worden getoond op de monitor die overeenkomt met de gekozen index."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD is een verbeterde videokaart die door een handvol moderne demo's gebruikt wordt. Wijzigen herstart de machine."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Videomodi die de console aan de spellen aanbiedt. HD-modi vereisen het HDTV-videosignaal."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Weergave-instelling die de tafel gebruikt. AUTO volgt SCHERMCONFIGURATIE: desktop voor één liggend scherm, volledig enkel scherm voor één verticaal scherm, kast voor meerdere schermen (desktop wanneer SCHERMCONFIGURATIE niet ingesteld is)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Draait de D-pad virtueel mee wanneer het scherm gedraaid wordt."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Volume van het klikgeluid van het geëmuleerde diskettestation."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Volume van het muziekbord in de spellen die er een hebben (Daytona USA, Sega Rally). Standaard 100%."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Alleen Vulkan, trager maar minder vertraging."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Alleen Vulkan. Verbetert de prestaties en verhelpt veel grafische problemen, maar kan op sommige GPU's instabiel zijn. Niet-ondersteunde methoden vallen automatisch terug."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Alleen Vulkan: laat de videodriver een opgegeven buffermodus gebruiken."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "Wat op de eerste poort van de Amiga is aangesloten. De meeste spellen gebruiken de joystick op poort 2 en de muis op poort 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "Wat op de tweede poort van de Amiga is aangesloten."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "Wat op de tweede poort van de Amiga is aangesloten. Standaard joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "Wat de tweede poort ontvangt wanneer een tweede pad is aangesloten."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Wanneer een adres wordt ingevoerd, wordt de modus automatisch op 'HANDMATIG' gezet."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "Wanneer de automatische detectie mislukt."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Geeft, indien beschikbaar, de voorkeur aan exclusief volledig scherm voor emulators."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "Indien ingeschakeld heeft elk spel een eigen VMU in poort 1."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "Geef bij keuze voor 'HANDMATIG' een adres op in de volgende instelling."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "Wanneer de snelheidsbegrenzing uitgeschakeld is, draait MAME de emulatie zo snel mogelijk."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Kies bij gebruik van een .m3u-bestand de index van de te starten schijf."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Bij gebruik van Cursor Joystick moeten de knoppen in RetroArch aan toetsen worden toegewezen."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "Bij gebruik van XInput wisselt deze optie de gamepads 1 en 2 om."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Sluit bij gebruik van een Sinden-pistool de Lightgun-software af wanneer het spel eindigt."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Bepaalt de te gebruiken indeling bij toewijzing vanuit een bestand voor arcadesystemen."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "Bepaalt bij gebruik van echte Wiimotes het type Wiimote."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "Bij software die volledige toetsenbordinvoer vereist, wordt aanbevolen ook de spelfocusmodus te gebruiken."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Waar de DMD getoond wordt. AUTO: op het speelveld met 1 scherm, onder in het backglass-scherm met 2 schermen, op een eigen scherm met 3 schermen. Vereist SCHERMCONFIGURATIE."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Welke RetroPad welke Amiga-poort aanstuurt. Laat op Automatisch tenzij de spelers omgewisseld zijn."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Welke schijf van een spel met meerdere schijven bij het opstarten geplaatst wordt. POM2 laadt één schijf tegelijk, de andere worden via het menu in het spel gewisseld."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Welke schijf van een spel met meerdere schijven bij het opstarten geplaatst wordt: altijd de eerste, of de schijf die bij het laatste afsluiten in het station zat."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Welke actieknop bevestigt in de systeemdialogen van de PS3. Japanse spellen verwachten meestal Cirkel, westerse spellen Kruis. Laat op AUTO om de gekozen regio te volgen."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Op welk diskettestation het menu voor schijfwissel werkt."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Witte rand getekend door de emulator, nodig voor Sinden-pistolen om te richten."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Breedte van de witte rand die getekend wordt wanneer een Sinden-pistool aangesloten is. Standaard 16 pixels."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Breedte van de witte rand die getekend wordt wanneer een Sinden-pistool aangesloten is. Standaard 2 pixels."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Draait het XBOX-proces op meerdere CPU-threads, kan de prestaties verbeteren maar sommige spellen breken."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Omweg die nodig is voor enkele homebrew en romhacks."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Omzeilt firmwarebugs op sommige sturen die korte onderbrekingen van de force feedback veroorzaken. Uit laten tenzij nodig."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Schrijft Amiberry.log in de emulatormap. Alleen nuttig bij het melden van een probleem, het vertraagt alles een beetje."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Schrijft de waarden van de dieptebuffer naar het vm-geheugen. Standaard uit."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Schrijft invoergebeurtenissen naar een logbestand in de opslagmap. Alleen nuttig bij het melden van een probleem."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "De Z80 SoftCard draait CP/M-software. De geluidskaarten kunnen hier als tweede kaart worden toegevoegd. Wijzigen herstart de machine."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "Zorro II-uitbreidings-RAM. Vereist door veel WHDLoad-titels, maar enkele originele diskettespellen weigeren ermee te starten."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "Zorro II-uitbreidings-RAM. Vereist door veel WHDLoad-titels."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
