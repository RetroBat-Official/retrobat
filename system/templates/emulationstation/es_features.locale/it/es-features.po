msgstr ""

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Consente ai giochi che supportano risoluzioni diverse di essere renderizzati con una risoluzione specifica."

msgctxt "game_options"
msgid "1280x720 (default)"
msgstr "1280x720 (predefinito)"

