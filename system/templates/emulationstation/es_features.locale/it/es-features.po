msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Consente l'uso della frequenza di aggiornamento variabile sugli schermi che la supportano. Sui display che non supportano il VRR, in alcuni casi si può verificare lo screen tearing."

msgctxt "game_options"
msgid "LICENCE MASK"
msgstr "MASCHERA DI LICENZA"

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Imposta la maschera delle licenze per i contenuti attivati (TUTTE LE LICENZE è in genere una cattiva idea e può causare un comportamento indefinito)."

msgctxt "game_options"
