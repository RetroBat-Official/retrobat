msgstr "OTTIMIZZAZIONI CPU"

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Lascialo attivo per abilitare le ottimizzazioni JIT della CPU."

msgctxt "game_options"
