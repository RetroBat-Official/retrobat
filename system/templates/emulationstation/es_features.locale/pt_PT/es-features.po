# FEATURES - DESCRIPTIONS
msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' é a velocidade real da unidade. 'Turbo' carrega quase instantaneamente, mas alguns jogos detetam isso e recusam-se a arrancar."

msgctxt "game_options"
msgid "'1x' is the real drive speed. 'Turbo' removes disk rotation emulation and loads almost instantly, but a few games detect it and refuse to run."
msgstr "'1x' é a velocidade real da unidade. 'Turbo' remove a emulação da rotação do disco e carrega quase instantaneamente, mas alguns jogos detetam isso e recusam-se a arrancar."

msgctxt "game_options"
msgid "'Accurate' matches the hardware but can drop the framerate badly on save/load screens. Change this only if a menu is slow."
msgstr "'Preciso' corresponde ao hardware, mas pode baixar bastante a taxa de fotogramas nos ecrãs de guardar/carregar. Altere apenas se um menu estiver lento."

msgctxt "game_options"
msgid "'Auto' defaults to the most compatible version for the model."
msgstr "'Auto' usa por predefinição a versão mais compatível com o modelo."

msgctxt "game_options"
msgid "'Auto' is the default floppy speed (300RPM). 'Turbo' removes disk rotation emulation."
msgstr "'Auto' é a velocidade predefinida do disquete (300 RPM). 'Turbo' remove a emulação da rotação do disco."

msgctxt "game_options"
msgid "'Auto' will controls the half-screen fix detection on texture shuffling."
msgstr "'Auto' controla a deteção da correção de meio ecrã no embaralhamento de texturas."

msgctxt "game_options"
msgid "'Compatible' suits almost every game. 'Cycle exact' is the most accurate but needs a fast PC. 'Fast' unlocks the CPU speed and can break timing sensitive games."
msgstr "'Compatível' serve para quase todos os jogos. 'Ciclo exato' é o mais preciso, mas exige um PC rápido. 'Rápido' desbloqueia a velocidade da CPU e pode quebrar jogos sensíveis à temporização."

msgctxt "game_options"
msgid "'Double' gives a clean modern picture. Scanline modes recreate the look of a CRT monitor."
msgstr "'Duplo' oferece uma imagem limpa e moderna. Os modos com scanlines recriam a aparência de um monitor CRT."

msgctxt "game_options"
msgid "'Dual Stick' maps Player 2 joystick to the right analog stick of Player 1, 'Swap Ports' fixes port inversion for 'Wizard of Wor'."
msgstr "'Dual Stick' mapeia o joystick do jogador 2 no analógico direito do jogador 1; 'Trocar portas' corrige a inversão de portas de 'Wizard of Wor'."

msgctxt "game_options"
msgid "'Exact' is the most faithful Paula emulation. Lower it only if the sound stutters on a slow PC."
msgstr "'Exato' é a emulação mais fiel do Paula. Reduza apenas se o som tiver soluços num PC lento."

msgctxt "game_options"
msgid "'Games Express' is needed for several unlicensed games."
msgstr "'Games Express' é necessário para vários jogos não licenciados."

msgctxt "game_options"
msgid "'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons and is selected automatically on CD32."
msgstr "'Joystick' é o joystick clássico de 2 botões que qualquer jogo entende. 'Comando CD32' adiciona os botões coloridos e é selecionado automaticamente no CD32."

msgctxt "game_options"
msgid "'ON' passes all physical keyboard events to the core. 'OFF' prevents RetroPad keys from generating keyboard events."
msgstr "'LIGADO' repassa todos os eventos do teclado físico ao núcleo. 'DESLIGADO' impede que as teclas do RetroPad gerem eventos de teclado."

msgctxt "game_options"
msgid "'PRE-DEFINED' uses the config files located in the emulator 'cfg' folder, 'DYNAMIC' generates configuration based on profile selected in 'CONTROLS' advanced settings."
msgstr "'PREDEFINIDO' usa os ficheiros de configuração da pasta 'cfg' do emulador; 'DINÂMICO' gera a configuração com base no perfil selecionado nas configurações avançadas de 'CONTROLOS'."

msgctxt "game_options"
msgid "'Safe' fixes texture glitches in some games at a heavy performance cost."
msgstr "'Seguro' corrige falhas de textura em alguns jogos com grande custo de desempenho."

msgctxt "game_options"
msgid "'Templates' option copies files located in 'emulators\m2emulator\templatescfg' folder instead of performing dynamic autoconfiguration."
msgstr "A opção 'Modelos' copia os ficheiros da pasta 'emulators\m2emulator\templatescfg' em vez de fazer a configuração automática dinâmica."

msgctxt "game_options"
msgid "'Triple-buffer' and 'match emulated content' are only available with Vulkan video driver."
msgstr "'Buffer triplo' e 'Igualar ao conteúdo emulado' só estão disponíveis com o driver de vídeo Vulkan."

msgctxt "game_options"
msgid "'Turbo' removes seek delay emulation."
msgstr "'Turbo' remove a emulação do atraso de busca."

msgctxt "game_options"
msgid "'Weave' should only be used with 1x scaling factor and CRT shaders."
msgstr "'Weave' só deve ser usado com fator de escala 1x e shaders CRT."

msgctxt "game_options"
msgid "'XINPUT' will force usage of XInput api for compatible controllers."
msgstr "'XINPUT' força o uso da API XInput para comandos compatíveis."

msgctxt "game_options"
msgid "'directx11' is the default and works on nearly all hardware. 'vulkan' can be faster on recent GPUs. Some libretro cores will force their own driver."
msgstr "'directx11' é a predefinição e funciona em quase todo o hardware. 'vulkan' pode ser mais rápido em GPUs recentes. Alguns núcleos libretro forçam o próprio driver."

msgctxt "game_options"
msgid "+8MB Fast RAM (CD32FR). Off by default, matching the original CD32."
msgstr "+8MB de Fast RAM (CD32FR). Desligado por predefinição, como no CD32 original."

msgctxt "game_options"
msgid "0 is lowest quality and latency and CPU usage, 10 is highest quality and latency and CPU usage."
msgstr "0 é a menor qualidade, latência e uso de CPU; 10 é a maior qualidade, latência e uso de CPU."

msgctxt "game_options"
msgid "130-140% is recommended with modern controllers."
msgstr "130-140% é recomendado com comandos modernos."

msgctxt "game_options"
msgid "24 bits removes the color banding in dark areas and gradients. HDR requires an HDR display with HDR enabled in RetroArch, otherwise the core falls back to 24 bits."
msgstr "24 bits remove as faixas de cor em áreas escuras e degradês. HDR exige um ecrã HDR com HDR ativado no RetroArch; caso contrário, o núcleo volta para 24 bits."

msgctxt "game_options"
msgid "2x matches the real drive. Higher speeds cut load times but may break games."
msgstr "2x corresponde à unidade real. Velocidades maiores reduzem os carregamentos, mas podem quebrar jogos."

msgctxt "game_options"
msgid "32k RAM expansion card installed."
msgstr "Placa de expansão de RAM de 32K instalada."

msgctxt "game_options"
msgid "4/3 by default, like the arcade monitor. The bezel is only displayed in 4/3. 16/9 widens the 3D view."
msgstr "4/3 por predefinição, como o monitor arcade. A moldura só é exibida em 4/3. 16/9 amplia a visão 3D."

msgctxt "game_options"
msgid "A few games need this option disabled."
msgstr "Alguns jogos precisam desta opção desativada."

msgctxt "game_options"
msgid "A few games require this. Costs around 10% performance."
msgstr "Necessário para alguns jogos. Custa cerca de 10% de desempenho."

msgctxt "game_options"
msgid "A few very early games require CTIA chip to display properly."
msgstr "Alguns jogos muito antigos precisam do chip CTIA para serem exibidos corretamente."

msgctxt "game_options"
msgid "A shadows and colors fix needed for some games such as Tony Hawk Proving Ground."
msgstr "Correção de sombras e cores necessária para alguns jogos como Tony Hawk's Proving Ground."

msgctxt "game_options"
msgid "ASCII maps your keyboard to the characters it prints. Original reproduces the exact keyboard of the emulated machine, needed by a few programs."
msgstr "ASCII mapeia o teclado para os caracteres que imprime. Original reproduz o teclado exato da máquina emulada, necessário para alguns programas."

msgctxt "game_options"
msgid "AUTO (recommanded) lets the core define the NAND file based on the game region."
msgstr "AUTO (recomendado) deixa o núcleo definir o ficheiro NAND com base na região do jogo."

msgctxt "game_options"
msgid "AUTO shows the crosshair when aiming with a mouse, and hides it with a real lightgun."
msgstr "AUTO mostra a mira ao mirar com um rato e a oculta com uma pistola real."

msgctxt "game_options"
msgid "AUTO switches to DSi only for DSi-exclusive games. Force DSI for DSiWare."
msgstr "AUTO muda para DSi apenas nos jogos exclusivos de DSi. Force DSI para DSiWare."

msgctxt "game_options"
msgid "AUTOMATIC selects the expansion from the program size. Can be forced with file name tags such as (8k) or [16k]."
msgstr "AUTOMÁTICO escolhe a expansão pelo tamanho do programa. Pode ser forçado com tags no nome do ficheiro como (8k) ou [16k]."

msgctxt "game_options"
msgid "AUTOMATIC: Vita3K loads the required firmware modules by itself (recommended). EMULATOR SETTINGS: keep the modules selected in the Vita3K interface."
msgstr "AUTOMÁTICO: o Vita3K carrega sozinho os módulos de firmware necessários (recomendado). CONFIGURAÇÕES DO EMULADOR: mantém os módulos selecionados na interface do Vita3K."

msgctxt "game_options"
msgid "Above 60 fps, frames are interpolated between game updates. AUTO follows the display refresh rate."
msgstr "Acima de 60 FPS, os fotogramas são interpolados entre as atualizações do jogo. AUTO segue a taxa de atualização do ecrã."

msgctxt "game_options"
msgid "Accurate framebuffer emulation, very slow but required by some games."
msgstr "Emulação precisa do framebuffer, muito lenta, mas necessária para alguns jogos."

msgctxt "game_options"
msgid "Act as player 1 and host the game."
msgstr "Atua como jogador 1 e aloja o jogo."

msgctxt "game_options"
msgid "Action of the second controller button: space bar (e.g. Xenon 2) or joystick up (jump in platform games)."
msgstr "Ação do segundo botão do comando: barra de espaço (ex.: Xenon 2) ou joystick para cima (saltar em jogos de plataforma)."

msgctxt "game_options"
msgid "Activate aim help mechanism."
msgstr "Ativa o mecanismo de ajuda de mira."

msgctxt "game_options"
msgid "Activate autosave feature and define delay between autosaves."
msgstr "Ativa a gravação automática e define o intervalo entre gravações."

msgctxt "game_options"
msgid "Activate this when using WiiZapper to invert trigger and reload buttons."
msgstr "Ative ao usar o WiiZapper para inverter os botões de gatilho e recarga."

msgctxt "game_options"
msgid "Adapt the game view to widescreen screens."
msgstr "Adapta a visão do jogo para ecrãs widescreen."

msgctxt "game_options"
msgid "Add a blank 2HD save/user disk to the disk control list."
msgstr "Adiciona um disco 2HD de gravação/utilizador em branco à lista de controlo de disco."

msgctxt "game_options"
msgid "Add contact shadows, requires the hardware renderer."
msgstr "Adiciona sombras de contacto; requer o renderizador por hardware."

msgctxt "game_options"
msgid "Adjust mouse pointer speed based on the analog stick sensitivity."
msgstr "Ajusta a velocidade do ponteiro do rato conforme a sensibilidade do analógico."

msgctxt "game_options"
msgid "Adjust output colors to mimic original console screen."
msgstr "Ajusta as cores de saída para imitar o ecrã da consola original."

msgctxt "game_options"
msgid "Adjust the vertical center of the Wiimote pointer."
msgstr "Ajusta o centro vertical do ponteiro do Wiimote."

msgctxt "game_options"
msgid "Adjusts the volume of the music track."
msgstr "Ajusta o volume da faixa musical."

msgctxt "game_options"
msgid "Adjusts the volume of the sound effects."
msgstr "Ajusta o volume dos efeitos sonoros."

msgctxt "game_options"
msgid "Advanced audio library used by many games. Disable only if a game crashes or has audio issues."
msgstr "Biblioteca de áudio avançada usada por muitos jogos. Desative apenas se um jogo bloquear ou tiver problemas de áudio."

msgctxt "game_options"
msgid "Aim items with the controller gyroscope (DualSense, DualShock 4, Switch Pro...)."
msgstr "Aponta com o giroscópio do comando (DualSense, DualShock 4, Switch Pro...)."

msgctxt "game_options"
msgid "Allow ADAM to write to disks and data packs. Writes go to a working copy stored in the saves folder, the original file is never modified. Requires a core restart."
msgstr "Permite que o ADAM grave em disquetes e data packs. As gravações vão para uma cópia de trabalho na pasta saves; o ficheiro original nunca é modificado. Requer reiniciar o núcleo."

msgctxt "game_options"
msgid "Allow DirectInput controllers (generic USB pads, arcade sticks). Turn off only if a pad is detected twice."
msgstr "Permite comandos DirectInput (comandos USB genéricos, arcade sticks). Desative apenas se um comando for detetado duas vezes."

msgctxt "game_options"
msgid "Allow XInput controllers (Xbox pads and wrappers). Turn off only if a pad is detected twice."
msgstr "Permite comandos XInput (comandos Xbox e wrappers). Desative apenas se um comando for detetado duas vezes."

msgctxt "game_options"
msgid "Allow bilinear scaling on scanout."
msgstr "Permite escala bilinear no scanout."

msgctxt "game_options"
msgid "Allow for correct emulation of texture wrapping, but comes at a cost of performance."
msgstr "Permite a emulação correta do texture wrapping, mas custa desempenho."

msgctxt "game_options"
msgid "Allow game that support different resolutions to be rendered in specific resolution."
msgstr "Permite que jogos com várias resoluções sejam renderizados numa resolução específica."

msgctxt "game_options"
msgid "Allow gamma dither."
msgstr "Permite dithering de gama."

msgctxt "game_options"
msgid "Allow native HID support for DualShock 4, DualSense and Switch Pro pads. Turn off to fall back to DirectInput."
msgstr "Permite suporte HID nativo para DualShock 4, DualSense e Switch Pro. Desative para voltar ao DirectInput."

msgctxt "game_options"
msgid "Allow pressing left and right, or up and down, at the same time. May cause movement glitches in some games."
msgstr "Permite premir esquerda e direita, ou cima e baixo, ao mesmo tempo. Pode causar falhas de movimento em alguns jogos."

msgctxt "game_options"
msgid "Allow pressing opposite directions simultaneously."
msgstr "Permite premir direções opostas simultaneamente."

msgctxt "game_options"
msgid "Allow some 30fps games to run at 60fps."
msgstr "Permite que alguns jogos de 30 FPS corram a 60 FPS."

msgctxt "game_options"
msgid "Allow texture and vertex fetch constants with invalid type, can be used to bypass fetch errors in certain games."
msgstr "Permite constantes de fetch de textura e vértice com tipo inválido, para contornar erros de fetch em certos jogos."

msgctxt "game_options"
msgid "Allow using variable refresh rate on displays supporting it. On displays not supporting VRR, screen tearing may occur in certain cases."
msgstr "Permite usar taxa de atualização variável em ecrãs compatíveis. Em ecrãs sem VRR, pode ocorrer tearing em alguns casos."

msgctxt "game_options"
msgid "Allow zooming in and out of the map with the mouse wheel, like the Enhanced Editions."
msgstr "Permite aproximar e afastar o mapa com a roda do rato, como nas Enhanced Editions."

msgctxt "game_options"
msgid "Allows you to perform a dedicated mapping for your arcade stick based on 'arcade_sticks.json' file."
msgstr "Permite um mapeamento dedicado para o seu arcade stick com base no ficheiro 'arcade_sticks.json'."

msgctxt "game_options"
msgid "Allows you to use mouse inputs even when device type isn't set to 'RetroKeyboard/Mouse'."
msgstr "Permite usar entradas do rato mesmo quando o tipo de dispositivo não está em 'RetroKeyboard/Mouse'."

msgctxt "game_options"
msgid "Also insert the next floppy into drive 2."
msgstr "Insere também o disquete seguinte na unidade 2."

msgctxt "game_options"
msgid "Always decompress archives, even if dokan could be used to mount as a drive letter."
msgstr "Descomprime sempre os ficheiros, mesmo que o dokan os possa montar como letra de unidade."

msgctxt "game_options"
msgid "Always display the names of items on the ground."
msgstr "Mostra sempre os nomes dos itens no chão."

msgctxt "game_options"
msgid "Amiga model to emulate. Each one needs its own Kickstart ROM in the bios folder."
msgstr "Modelo de Amiga a emular. Cada um precisa da própria ROM Kickstart na pasta bios."

msgctxt "game_options"
msgid "Amiga model to emulate. Requires a core restart to take effect. Each model needs a matching Kickstart ROM in the bios\amiberry folder."
msgstr "Modelo de Amiga a emular. Só tem efeito após reiniciar o núcleo. Cada modelo precisa da ROM Kickstart correspondente na pasta bios\amiberry."

msgctxt "game_options"
msgid "Amiga port the gun is plugged into. Port 2 is correct for almost every machine; only the A1000 reads the pen on port 1."
msgstr "Porta do Amiga onde a pistola está conectada. A porta 2 é a correta para quase todas as máquinas; apenas o A1000 lê a caneta na porta 1."

msgctxt "game_options"
msgid "Amount of Chip RAM. Some later games need 1 MB. Going above what the model supports can break compatibility."
msgstr "Quantidade de Chip RAM. Alguns jogos mais recentes precisam de 1 MB. Ultrapassar o suportado pelo modelo pode quebrar a compatibilidade."

msgctxt "game_options"
msgid "Amount of RAM used."
msgstr "Quantidade de RAM usada."

msgctxt "game_options"
msgid "Amount of small pointer movement to ignore."
msgstr "Quantidade de pequenos movimentos do ponteiro a ignorar."

msgctxt "game_options"
msgid "An added vibration that increases as you steer."
msgstr "Vibração adicional que aumenta conforme se vira."

msgctxt "game_options"
msgid "Anti-aliased fetch filter, smooth polygons edges."
msgstr "Filtro de fetch com anti-aliasing, suaviza as bordas dos polígonos."

msgctxt "game_options"
msgid "Anti-aliasing level."
msgstr "Nível de anti-aliasing."

msgctxt "game_options"
msgid "Anti-aliasing method and level."
msgstr "Método e nível de anti-aliasing."

msgctxt "game_options"
msgid "Apple II model to emulate. Changing this reboots the machine."
msgstr "Modelo de Apple II a emular. Alterar isto reinicia a máquina."

msgctxt "game_options"
msgid "Apple II model to emulate. The PAL models run at 50Hz and are the ones European demos were written for. Changing this reboots the machine."
msgstr "Modelo de Apple II a emular. Os modelos PAL correm a 50Hz e são aqueles para os quais as demos europeias foram escritas. Alterar isto reinicia a máquina."

msgctxt "game_options"
msgid "Applied to the crosshair image, useful to tell players apart."
msgstr "Aplicado à imagem da mira, útil para distinguir os jogadores."

msgctxt "game_options"
msgid "Applies a power curve to steering values, dampens small inputs."
msgstr "Aplica uma curva de potência aos valores de direção, amortecendo pequenas entradas."

msgctxt "game_options"
msgid "Applies to flight stick and throttle axes in After Burner Climax / Let's Go Jungle."
msgstr "Aplica-se aos eixos do manche e do acelerador em After Burner Climax / Let's Go Jungle."

msgctxt "game_options"
msgid "Applies to gas and brake pedals in driving games."
msgstr "Aplica-se aos pedais de acelerador e travão em jogos de corrida."

msgctxt "game_options"
msgid "Apply Gouraud shading instead on flat shading, only with OpenGL."
msgstr "Aplica sombreamento Gouraud em vez de sombreamento plano, apenas com OpenGL."

msgctxt "game_options"
msgid "Apply a CRT filter(crt-aperture)."
msgstr "Aplica um filtro CRT (crt-aperture)."

msgctxt "game_options"
msgid "Apply a brownish chroma filter."
msgstr "Aplica um filtro de croma acastanhado."

msgctxt "game_options"
msgid "Apply a core-provided video filter."
msgstr "Aplica um filtro de vídeo fornecido pelo núcleo."

msgctxt "game_options"
msgid "Apply a video filter to mimic various signals."
msgstr "Aplica um filtro de vídeo que imita vários sinais."

msgctxt "game_options"
msgid "Apply a video filter to the output image."
msgstr "Aplica um filtro de vídeo à imagem de saída."

msgctxt "game_options"
msgid "Apply an audio filter. 'Gaussian' reproduce the bass-heavy sound of the original hardware."
msgstr "Aplica um filtro de áudio. 'Gaussiano' reproduz o som com graves fortes do hardware original."

msgctxt "game_options"
msgid "Apply an audio filter. Modify sound interpolation."
msgstr "Aplica um filtro de áudio. Modifica a interpolação do som."

msgctxt "game_options"
msgid "Apply core-specific filter to mimic old signal specific rendering."
msgstr "Aplica um filtro específico do núcleo que imita a renderização de sinais antigos."

msgctxt "game_options"
msgid "Apply fix for some games."
msgstr "Aplica correção para alguns jogos."

msgctxt "game_options"
msgid "Apply the region above even when the game declares its own."
msgstr "Aplica a região acima mesmo quando o jogo declara a sua própria."

msgctxt "game_options"
msgid "Approximates the analog output stage of the console: removes the DC offset and softens high frequencies."
msgstr "Aproxima o estágio de saída analógica da consola: remove o deslocamento DC e suaviza as altas frequências."

msgctxt "game_options"
msgid "Arcade monitor look."
msgstr "Aparência de monitor arcade."

msgctxt "game_options"
msgid "Arcade monitor look: scanlines, shadow mask and glow."
msgstr "Aparência de monitor arcade: scanlines, máscara de sombra e brilho."

msgctxt "game_options"
msgid "Aspect ratio provided by the core, used when GAME ASPECT RATIO is on AUTO."
msgstr "Proporção fornecida pelo núcleo, usada quando PROPORÇÃO DE ECRÃ DO JOGO está em AUTO."

msgctxt "game_options"
msgid "Aspect ratio set in the console system settings."
msgstr "Proporção definida nas configurações de sistema da consola."

msgctxt "game_options"
msgid "Atari keyboard: F2, F4 and F8 are left to the game, states and screenshots then use AltGr+K, AltGr+L and AltGr+G."
msgstr "Teclado Atari: F2, F4 e F8 ficam para o jogo; save states e capturas de ecrã passam a usar AltGr+K, AltGr+L e AltGr+G."

msgctxt "game_options"
msgid "Attempt to do rescaling at native resolution."
msgstr "Tenta fazer o redimensionamento na resolução nativa."

msgctxt "game_options"
msgid "Audio buffer threshold for Manual frameskip."
msgstr "Limiar do buffer de áudio para o salto de fotogramas manual."

msgctxt "game_options"
msgid "Audio gives the lowest latency. Video is smoother when the screen refresh rate is close to the console one."
msgstr "Áudio oferece a menor latência. Vídeo fica mais fluido quando a taxa de atualização do ecrã é próxima à da consola."

msgctxt "game_options"
msgid "Audio output frequency."
msgstr "Frequência de saída de áudio."

msgctxt "game_options"
msgid "Auto (default) follows the screen refresh rate with motion interpolation. Original and the multiples of 57.524 Hz need a G-SYNC / FreeSync screen and the vertical sync."
msgstr "Auto (predefinição) segue a taxa de atualização do ecrã com interpolação de movimento. Original e os múltiplos de 57,524 Hz precisam de um ecrã G-SYNC / FreeSync e da sincronização vertical."

msgctxt "game_options"
msgid "Auto-center the aiming axis. Useful when playing gun games with a gamepad instead of a lightgun."
msgstr "Centraliza automaticamente o eixo de mira. Útil ao jogar jogos de pistola com um gamepad em vez de uma pistola."

msgctxt "game_options"
msgid "Auto-fire rate. Faster is not always better: some games ignore inputs that are too fast."
msgstr "Cadência do tiro automático. Mais rápido nem sempre é melhor: alguns jogos ignoram entradas rápidas demais."

msgctxt "game_options"
msgid "Auto: west attack, south jump, east special, north attack 2, L1/R1 attack 3/4. OpenBOR standalone: same buttons as the OpenBOR standalone emulator."
msgstr "Auto: oeste ataque, sul salto, leste especial, norte ataque 2, L1/R1 ataque 3/4. OpenBOR standalone: os mesmos botões do emulador OpenBOR standalone."

msgctxt "game_options"
msgid "Automatic uses XInput when all controllers are XInput devices, DirectInput otherwise."
msgstr "Automático usa XInput quando todos os comandos são dispositivos XInput; caso contrário, DirectInput."

msgctxt "game_options"
msgid "Automatic: boot from hard disk when the game has a hard disk and no floppy."
msgstr "Automático: iniciar pelo disco rígido quando o jogo tem disco rígido e nenhum disquete."

msgctxt "game_options"
msgid "Automatic: shown only when the game has no reticle of its own."
msgstr "Automático: mostrada apenas quando o jogo não tem mira própria."

msgctxt "game_options"
msgid "Automatically apply game enhancements if they exist in the core database (LOD, draw distance, FMV skip)."
msgstr "Aplica automaticamente melhorias do jogo se existirem na base de dados do núcleo (LOD, distância de visão, saltar FMV)."

msgctxt "game_options"
msgid "Automatically decrease frame delay temporarily to prevent frame drops. Turn off if this worsens audio/video stuttering."
msgstr "Reduz temporariamente o atraso de fotogramas de forma automática para evitar quedas de fotogramas. Desative se isso piorar os soluços de áudio/vídeo."

msgctxt "game_options"
msgid "Automatically fast forward FDS game when disk is loading."
msgstr "Avança rapidamente os jogos FDS automaticamente durante o carregamento do disco."

msgctxt "game_options"
msgid "Automatically load no-interlacing patches on game start-up."
msgstr "Carrega automaticamente patches sem entrelaçamento ao iniciar o jogo."

msgctxt "game_options"
msgid "Automatically load widescreen patches on game start-up."
msgstr "Carrega automaticamente patches widescreen ao iniciar o jogo."

msgctxt "game_options"
msgid "Automatically loads and applies cheats on game start."
msgstr "Carrega e aplica cheats automaticamente ao iniciar o jogo."

msgctxt "game_options"
msgid "Automatically removes the black borders around the Amiga picture so the image fills more of the screen."
msgstr "Remove automaticamente as bordas pretas ao redor da imagem do Amiga para que ocupe mais do ecrã."

msgctxt "game_options"
msgid "Automatically rotate display for vertical games."
msgstr "Roda automaticamente o ecrã em jogos verticais."

msgctxt "game_options"
msgid "Automatically switch Port0 and Port1 based on input activity."
msgstr "Alterna automaticamente Port0 e Port1 conforme a atividade de entrada."

msgctxt "game_options"
msgid "Automatically switch the disk side when the game asks for it."
msgstr "Troca automaticamente o lado do disco quando o jogo pede."

msgctxt "game_options"
msgid "Avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Evita espaços entre pixels no upscaling. Corrige o texto do Wild Arms e o fantasma do SoulCalibur."

msgctxt "game_options"
msgid "BIOS language can affect the language of some games."
msgstr "O idioma da BIOS pode afetar o idioma de alguns jogos."

msgctxt "game_options"
msgid "Bezels are only displayed with 4/3."
msgstr "As molduras só são mostradas em 4/3."

msgctxt "game_options"
msgid "Bilateral CAS is recommended but will harm performance, CAS is less aggressive but more subtle."
msgstr "CAS bilateral é recomendado, mas prejudica o desempenho; CAS é menos agressivo e mais subtil."

msgctxt "game_options"
msgid "Black level of the picture. 50% by default, matched to an arcade capture: lower is darker, higher is brighter."
msgstr "Nível de preto da imagem. 50% por predefinição, ajustado a uma captura do arcade: menor é mais escuro, maior é mais claro."

msgctxt "game_options"
msgid "Blend pixel together when in hires mode. Higher values will blur the picture more."
msgstr "Mistura os pixels no modo hires. Valores maiores desfocam mais a imagem."

msgctxt "game_options"
msgid "Blend pixels from multiple successive frames to simulate LCD ghosting."
msgstr "Mistura pixels de vários fotogramas sucessivos para simular o fantasma do LCD."

msgctxt "game_options"
msgid "Blended draws the transparent polygons as a smooth blend instead of the arcade checkerboard. Model 1 and Model 2 only, Vulkan and OpenGL renderers."
msgstr "Misturado desenha os polígonos transparentes como uma mistura suave em vez do xadrez do arcade. Apenas Model 1 e Model 2, renderizadores Vulkan e OpenGL."

msgctxt "game_options"
msgid "Blur emulated display."
msgstr "Desfoca o ecrã emulado."

msgctxt "game_options"
msgid "Blurs adjacent pixels for translucency effects."
msgstr "Desfoca pixels adjacentes para efeitos de translucidez."

msgctxt "game_options"
msgid "Blurs adjacent pixels to simulate SDTV resolution, can be required by some games to emulate transparency."
msgstr "Desfoca pixels adjacentes para simular a resolução SDTV; alguns jogos precisam disso para emular transparência."

msgctxt "game_options"
msgid "Boost emulation during boot."
msgstr "Acelera a emulação durante o arranque."

msgctxt "game_options"
msgid "Boot directly into the DS BIOS menu, needs external bios to be activated."
msgstr "Inicia diretamente no menu da BIOS do DS; requer a BIOS externa ativada."

msgctxt "game_options"
msgid "Boot to the Game Genie code entry screen. Requires 'gamegenie.nes' in the bios folder. Restart required."
msgstr "Inicia no ecrã de entrada de códigos do Game Genie. Requer 'gamegenie.nes' na pasta bios. Requer reinício."

msgctxt "game_options"
msgid "Boot to the console BIOS menu."
msgstr "Inicia no menu da BIOS da consola."

msgctxt "game_options"
msgid "Boot with the real Jaguar BIOS and its startup animation. Required by some games."
msgstr "Inicia com a BIOS real do Jaguar e sua animação de abertura. Necessário para alguns jogos."

msgctxt "game_options"
msgid "Break to the host debugger (or crash if no debugger attached) if an unimplemented PowerPC instruction is encountered."
msgstr "Para no depurador do host (ou bloqueia se nenhum depurador estiver conectado) quando uma instrução PowerPC não implementada é encontrada."

msgctxt "game_options"
msgid "Bring up the system ROM menu at boot of arcade systems."
msgstr "Abre o menu da ROM do sistema ao iniciar sistemas arcade."

msgctxt "game_options"
msgid "Broadcast input feedback on TCP port 8000."
msgstr "Transmite o feedback de entrada pela porta TCP 8000."

msgctxt "game_options"
msgid "Build the cached shaders before the game starts."
msgstr "Gera os shaders em cache antes de o jogo iniciar."

msgctxt "game_options"
msgid "Button combination to switch between TV and GamePad, only used by the SWITCHABLE screen layout."
msgstr "Combinação de botões para alternar entre TV e GamePad; usada apenas pela disposição de ecrãs ALTERNÁVEL."

msgctxt "game_options"
msgid "Button layout of the core, the same for all games. Leave on AUTO to use RetroBat per-game mapping and CONTROLLER LAYOUT."
msgstr "Layout de botões do núcleo, igual para todos os jogos. Deixe em AUTO para usar o mapeamento por jogo do RetroBat e o LAYOUT DO COMANDO."

msgctxt "game_options"
msgid "Button used to confirm in system dialogs and in games following the system setting. CIRCLE is the Japanese convention."
msgstr "Botão usado para confirmar nas caixas de diálogo do sistema e nos jogos que seguem a configuração do sistema. CÍRCULO é a convenção japonesa."

msgctxt "game_options"
msgid "By default Hellfire is started when the game name contains hellfire, otherwise Diablo."
msgstr "Por predefinição, o Hellfire é iniciado quando o nome do jogo contém hellfire; caso contrário, o Diablo."

msgctxt "game_options"
msgid "By default RetroBat configures as many players as connected controllers, use this to override."
msgstr "Por predefinição, o RetroBat configura tantos jogadores quanto comandos conectados; use isto para substituir."

msgctxt "game_options"
msgid "By default RetroBat will generate its own config file, enable this option to use your own game setting file located in 'emulators\ssf\Setting' folder."
msgstr "Por predefinição, o RetroBat gera o próprio ficheiro de configuração; ative esta opção para usar o seu ficheiro de configuração do jogo localizado na pasta 'emulators\ssf\Setting'."

msgctxt "game_options"
msgid "By default a second gamepad is used when a second controller is connected."
msgstr "Por predefinição, um segundo gamepad é usado quando um segundo comando é conectado."

msgctxt "game_options"
msgid "By default every controller moves the hero. Enable if another connected controller disturbs the movement."
msgstr "Por predefinição, todos os comandos movem o herói. Ative se outro comando conectado atrapalhar o movimento."

msgctxt "game_options"
msgid "By default zinc maps the left stick for movement, use this option to switch to d-pad."
msgstr "Por predefinição, o zinc mapeia o analógico esquerdo para o movimento; use esta opção para mudar para o direcional."

msgctxt "game_options"
msgid "By default, RPCS3 requires guncon in player port 3, use this to force it in port 1."
msgstr "Por predefinição, o RPCS3 exige a GunCon na porta do jogador 3; use isto para forçá-la na porta 1."

msgctxt "game_options"
msgid "By default, RetroBat discards core specific option files."
msgstr "Por predefinição, o RetroBat descarta os ficheiros de opções específicos do núcleo."

msgctxt "game_options"
msgid "By default, RetroBat keeps sync between installed games and roms folder."
msgstr "Por predefinição, o RetroBat mantém sincronizados os jogos instalados e a pasta roms."

msgctxt "game_options"
msgid "By default, calibration is done with middle mouse button, this setting allows to set an alternative button for the calibration shot."
msgstr "Por predefinição, a calibração é feita com o botão do meio do rato; esta configuração permite definir outro botão para o tiro de calibração."

msgctxt "game_options"
msgid "By default, modifications will be saved to disk drive, 'discard' will not save any modification."
msgstr "Por predefinição, as modificações são guardadas na unidade de disco; 'Descartar' não guarda nenhuma modificação."

msgctxt "game_options"
msgid "By default, trigger button is used to shake, enable this to simulate swing instead."
msgstr "Por predefinição, o gatilho é usado para sacudir; ative para simular um balanço."

msgctxt "game_options"
msgid "Bypass mipmapping and always use the sharpest texture level. Better image quality, a few games have rendering issues with it."
msgstr "Ignora o mipmapping e usa sempre o nível de textura mais nítido. Melhor qualidade de imagem; alguns jogos têm problemas de renderização com isso."

msgctxt "game_options"
msgid "CD32 configuration. Needs both the CD32 Kickstart and its extended ROM in the bios folder."
msgstr "Configuração CD32. Requer o Kickstart do CD32 e sua ROM estendida na pasta bios."

msgctxt "game_options"
msgid "CLASSIC is the original software renderer. POLYMOST and POLYMER use OpenGL and support HD packs."
msgstr "CLÁSSICO é o renderizador por software original. POLYMOST e POLYMER usam OpenGL e suportam pacotes HD."

msgctxt "game_options"
msgid "CPC physical RAM size in kB."
msgstr "Tamanho da RAM física do CPC em kB."

msgctxt "game_options"
msgid "CPU clock. Auto uses the model clock or the game database. Some games (SSF2, Alltynex) benefit from a faster CPU."
msgstr "Clock da CPU. Auto usa o clock do modelo ou a base de dados de jogos. Alguns jogos (SSF2, Alltynex) beneficiam de uma CPU mais rápida."

msgctxt "game_options"
msgid "CPU frequency multiplier. Applies only with Cycle-exact."
msgstr "Multiplicador de frequência da CPU. Aplica-se apenas com Ciclo exato."

msgctxt "game_options"
msgid "Cache custom textures to system RAM on startup."
msgstr "Armazena em cache as texturas personalizadas na RAM do sistema ao iniciar."

msgctxt "game_options"
msgid "Camera speed with the right analog stick or the mouse."
msgstr "Velocidade da câmara com o analógico direito ou o rato."

msgctxt "game_options"
msgid "Can affect performance in unexpected ways."
msgstr "Pode afetar o desempenho de formas inesperadas."

msgctxt "game_options"
msgid "Can be used to disable BIOS md5 check in case a custom bios is used."
msgstr "Pode desativar a verificação MD5 da BIOS caso uma BIOS personalizada seja usada."

msgctxt "game_options"
msgid "Can be used to improve framerate but might break speed for some games."
msgstr "Pode melhorar a taxa de fotogramas, mas pode prejudicar a velocidade de alguns jogos."

msgctxt "game_options"
msgid "Can be used to improve performance of 3D rendering on some games."
msgstr "Pode melhorar o desempenho da renderização 3D em alguns jogos."

msgctxt "game_options"
msgid "Can be used to simulate colors of particular displays."
msgstr "Pode ser usado para simular as cores de ecrãs específicos."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to different buttons."
msgstr "Pode ser útil para Gran Turismo; os gatilhos são mapeados em outros botões."

msgctxt "game_options"
msgid "Can be useful for Gran Turismo, triggers will be mapped to right analog stick."
msgstr "Pode ser útil para Gran Turismo; os gatilhos são mapeados no analógico direito."

msgctxt "game_options"
msgid "Can be useful for Metal Gear, to simulate pressure sensitivity."
msgstr "Pode ser útil para Metal Gear, para simular a sensibilidade à pressão."

msgctxt "game_options"
msgid "Can benefit some games."
msgstr "Pode beneficiar alguns jogos."

msgctxt "game_options"
msgid "Can cause various glitches."
msgstr "Pode causar diversas falhas."

msgctxt "game_options"
msgid "Can fix bad memory access error with some games."
msgstr "Pode corrigir erros de acesso inválido à memória em alguns jogos."

msgctxt "game_options"
msgid "Can fix misaligned 2D images like mario kart character selection."
msgstr "Pode corrigir imagens 2D desalinhadas, como a seleção de personagens do Mario Kart."

msgctxt "game_options"
msgid "Can fix some bugs that happened even on original hardware."
msgstr "Pode corrigir alguns bugs que aconteciam até no hardware original."

msgctxt "game_options"
msgid "Can fix some games when using a non-native resolution by rounding 2D edges."
msgstr "Pode corrigir alguns jogos em resolução não nativa arredondando as bordas 2D."

msgctxt "game_options"
msgid "Can fix some issues with XBOX controllers."
msgstr "Pode corrigir alguns problemas com comandos XBOX."

msgctxt "game_options"
msgid "Can improve accuracy at a small performance cost."
msgstr "Pode melhorar a precisão com pequeno custo de desempenho."

msgctxt "game_options"
msgid "Can improve framerate or cause timing error."
msgstr "Pode melhorar a taxa de fotogramas ou causar erros de temporização."

msgctxt "game_options"
msgid "Can improve performance on more powerful GPUs that have spare headroom. Only works with Vulkan renderer."
msgstr "Pode melhorar o desempenho em GPUs mais potentes com folga. Funciona apenas com o renderizador Vulkan."

msgctxt "game_options"
msgid "Can increase performance on some lower-end systems."
msgstr "Pode aumentar o desempenho em sistemas mais fracos."

msgctxt "game_options"
msgid "Can increase performance when using powerful GPU."
msgstr "Pode aumentar o desempenho com uma GPU potente."

msgctxt "game_options"
msgid "Can only be used if the controller is compatible with motion control."
msgstr "Só pode ser usado se o comando for compatível com controlo de movimento."

msgctxt "game_options"
msgid "Can reduce input latency, but will inscrease CPU requirements."
msgstr "Pode reduzir a latência de entrada, mas aumenta os requisitos de CPU."

msgctxt "game_options"
msgid "Can reduce lags when compiling shaders but also can create artifacts."
msgstr "Pode reduzir soluços ao compilar shaders, mas também pode gerar artefactos."

msgctxt "game_options"
msgid "Can reduce latency or remove bottom line on wii at the cost of graphical issues."
msgstr "Pode reduzir a latência ou remover a linha inferior no Wii, ao custo de falhas gráficas."

msgctxt "game_options"
msgid "Cap the framerate to the original 35 fps."
msgstr "Limita a taxa de fotogramas aos 35 FPS originais."

msgctxt "game_options"
msgid "Certain games require an external cartridge to run."
msgstr "Certos jogos precisam de um cartucho externo para correr."

msgctxt "game_options"
msgid "Change D-Pad controls between joystick and mouse."
msgstr "Alterna os controlos do direcional entre joystick e rato."

msgctxt "game_options"
msgid "Change aspect ratio for bottom screen."
msgstr "Altera a proporção do ecrã inferior."

msgctxt "game_options"
msgid "Change aspect ratio for top screen."
msgstr "Altera a proporção do ecrã superior."

msgctxt "game_options"
msgid "Change path for decompressed games (default is '\roms\.uncompressed')."
msgstr "Altera o caminho dos jogos descomprimidos (a predefinição é '\roms\.uncompressed')."

msgctxt "game_options"
msgid "Change the emulated audio chip model."
msgstr "Altera o modelo do chip de áudio emulado."

msgctxt "game_options"
msgid "Change the renderer used by the core."
msgstr "Altera o renderizador usado pelo núcleo."

msgctxt "game_options"
msgid "Change the renderer used by the core. Gun games only work with SOFTWARE."
msgstr "Altera o renderizador usado pelo núcleo. Jogos de pistola só funcionam com SOFTWARE."

msgctxt "game_options"
msgid "Change the sensitivity of the analog stick."
msgstr "Altera a sensibilidade do analógico."

msgctxt "game_options"
msgid "Change the sensitivity of the mouse."
msgstr "Altera a sensibilidade do rato."

msgctxt "game_options"
msgid "Change this only if multiple GPU are used by your system."
msgstr "Altere apenas se o sistema usar várias GPUs."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls, left of the / sign is the original game button for acceleration and brakes, right for gears."
msgstr "Ajuste conforme os controlos do jogo: à esquerda do sinal / fica o botão original do jogo para acelerar e travar, à direita o das mudanças."

msgctxt "game_options"
msgid "Change this setting depending on the game's controls."
msgstr "Ajuste conforme os controlos do jogo."

msgctxt "game_options"
msgid "Change this setting when encountering unstable games. The higher value, the better stability it may provide. 200μs and 400μs are generally good for most games."
msgstr "Altere ao encontrar jogos instáveis. Quanto maior o valor, melhor a estabilidade possível. 200μs e 400μs costumam ser bons para a maioria dos jogos."

msgctxt "game_options"
msgid "Changes how emulator threads are distributed across CPU cores. The RPCS3 schedulers can help on CPUs with multiple CCX/CCD clusters or with SMT, but Operating System is safest on most machines."
msgstr "Altera como as threads do emulador são distribuídas entre os núcleos da CPU. Os agendadores do RPCS3 podem ajudar em CPUs com vários clusters CCX/CCD ou com SMT, mas Sistema operativo é o mais seguro na maioria das máquinas."

msgctxt "game_options"
msgid "Changes how the guns are shown in Rambo."
msgstr "Altera como as pistolas são mostradas no Rambo."

msgctxt "game_options"
msgid "Changes the sound chip, the TMSS boot screen and a few hardware quirks."
msgstr "Altera o chip de som, o ecrã de arranque TMSS e algumas particularidades do hardware."

msgctxt "game_options"
msgid "Character generator chip. Automatic picks the one that matches the selected machine."
msgstr "Chip gerador de caracteres. Automático escolhe o que corresponde à máquina selecionada."

msgctxt "game_options"
msgid "Cheats must be placed in the \bios\pcsx2\cheats folder."
msgstr "As cheats devem ser colocadas na pasta \bios\pcsx2\cheats."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\mame' folder."
msgstr "As cheats devem ser colocadas na pasta 'cheats\mame'."

msgctxt "game_options"
msgid "Cheats need to be placed in 'cheats\psxmame' folder."
msgstr "As cheats devem ser colocadas na pasta 'cheats\psxmame'."

msgctxt "game_options"
msgid "Check every ROM against the game database. Turn off only to test a romset that fails to load: wrong ROMs can crash or corrupt saves. On by default."
msgstr "Verifica cada ROM na base de dados de jogos. Desative apenas para testar um romset que não carrega: ROMs erradas podem bloquear ou corromper gravações. Ligado por predefinição."

msgctxt "game_options"
msgid "Checks for corrupt files when booting a game."
msgstr "Verifica ficheiros corrompidos ao iniciar um jogo."

msgctxt "game_options"
msgid "Chipset used when an AGA model is selected. Only lower it below AGA to test a game that misbehaves on an A1200."
msgstr "Chipset usado quando um modelo AGA é selecionado. Só reduza abaixo de AGA para testar um jogo que se comporta mal no A1200."

msgctxt "game_options"
msgid "Choose 'Trojan Phazer' for games written for that gun. 'Light pen' suits everything else, including drawing programs."
msgstr "Escolha 'Trojan Phazer' para jogos feitos para essa pistola. 'Caneta óptica' serve para todo o resto, incluindo programas de desenho."

msgctxt "game_options"
msgid "Choose a MSX extension to be added to the second cartridge slot."
msgstr "Escolha uma extensão MSX a adicionar ao segundo slot de cartucho."

msgctxt "game_options"
msgid "Choose between english, french or spanish keyboard layout."
msgstr "Escolha entre os layouts de teclado inglês, francês ou espanhol."

msgctxt "game_options"
msgid "Choose between various texture enhancement filters."
msgstr "Escolha entre vários filtros de melhoria de texturas."

msgctxt "game_options"
msgid "Choose button to enable IR on rightstick."
msgstr "Escolha o botão para ativar o IR no analógico direito."

msgctxt "game_options"
msgid "Choose button to simulate rightstick swing action."
msgstr "Escolha o botão para simular o balanço com o analógico direito."

msgctxt "game_options"
msgid "Choose if the mouse input is active or not."
msgstr "Escolha se a entrada do rato fica ativa ou não."

msgctxt "game_options"
msgid "Choose if the swap screen hotkey switches the screens permanently or only while the button is held."
msgstr "Escolha se o atalho de troca de ecrã troca os ecrãs permanentemente ou apenas enquanto o botão é segurado."

msgctxt "game_options"
msgid "Choose the audio driver compatible with the hardware."
msgstr "Escolha o driver de áudio compatível com o hardware."

msgctxt "game_options"
msgid "Choose the color palette."
msgstr "Escolha a paleta de cores."

msgctxt "game_options"
msgid "Choose the disposition of the emulated screens."
msgstr "Escolha a disposição dos ecrãs emulados."

msgctxt "game_options"
msgid "Choose the extension attached to the controller."
msgstr "Escolha a extensão conectada ao comando."

msgctxt "game_options"
msgid "Choose the second disposition of the emulated screens."
msgstr "Escolha a segunda disposição dos ecrãs emulados."

msgctxt "game_options"
msgid "Choose which Atari system to emulate."
msgstr "Escolha qual sistema Atari emular."

msgctxt "game_options"
msgid "Choose which color palette is going to be used"
msgstr "Escolha qual paleta de cores será usada."

msgctxt "game_options"
msgid "Choose which color palette is going to be used."
msgstr "Escolha qual paleta de cores será usada."

msgctxt "game_options"
msgid "Choose which drive the Disk Control menu operates. The other drives stay mounted. Loaded media uses the drive the game was loaded into."
msgstr "Escolha em qual unidade o menu de Controlo de Disco atua. As outras unidades continuam montadas. Suporte carregado usa a unidade na qual o jogo foi carregado."

msgctxt "game_options"
msgid "Classic uses right and left shoulder for strong kick and punch, modern uses right shoulder and right trigger."
msgstr "Clássico usa os botões de ombro direito e esquerdo para pontapé e soco fortes; Moderno usa o botão de ombro direito e o gatilho direito."

msgctxt "game_options"
msgid "Cleans up stray black pixels."
msgstr "Remove pixels pretos perdidos."

msgctxt "game_options"
msgid "Color palette for original Game Boy games."
msgstr "Paleta de cores para os jogos do Game Boy original."

msgctxt "game_options"
msgid "Color temperature of the arcade monitor."
msgstr "Temperatura de cor do monitor arcade."

msgctxt "game_options"
msgid "Colors of WonderSwan (mono) games. WS palettes mimic the original screens."
msgstr "Cores dos jogos de WonderSwan (mono). As paletas WS imitam os ecrãs originais."

msgctxt "game_options"
msgid "Configure gap between both screens in pixels."
msgstr "Configura o espaço entre os dois ecrãs, em pixels."

msgctxt "game_options"
msgid "Configure the field of view (higher is wider)."
msgstr "Configura o campo de visão (maior é mais amplo)."

msgctxt "game_options"
msgid "Configure the fps."
msgstr "Configura o FPS."

msgctxt "game_options"
msgid "Configure this setting if you want to switch between stereo and surround sound."
msgstr "Configure isto para alternar entre som estéreo e surround."

msgctxt "game_options"
msgid "Configures how controllers are requested from the host or client. Essential for local multi-player connection."
msgstr "Configura como os comandos são solicitados ao host ou ao cliente. Essencial para conexões multijogador locais."

msgctxt "game_options"
msgid "Connect mouse to port 1."
msgstr "Liga o rato à porta 1."

msgctxt "game_options"
msgid "Console variant matching the selected BIOS image."
msgstr "Variante da consola correspondente à imagem da BIOS selecionada."

msgctxt "game_options"
msgid "Control the accuracy level of GS blending unit. Higher values will emulate blending more accurately in the shader."
msgstr "Controla o nível de precisão da unidade de blending do GS. Valores maiores emulam o blending com mais precisão no shader."

msgctxt "game_options"
msgid "Control the texture tri-filtering of the emulation."
msgstr "Controla a filtragem trilinear de texturas da emulação."

msgctxt "game_options"
msgid "Controls how dithering is applied."
msgstr "Controla como o dithering é aplicado."

msgctxt "game_options"
msgid "Controls the number of Auto-CRC fixes and hacks applied to games."
msgstr "Controla o número de correções e hacks Auto-CRC aplicados aos jogos."

msgctxt "game_options"
msgid "Controls verbosity prior to displaying the program."
msgstr "Controla o nível de detalhamento antes de exibir o programa."

msgctxt "game_options"
msgid "Convert gearup/geardown to gear3/gear4 for sequential shift simulation on standard gear stick."
msgstr "Converte subir/descer mudança em mudança 3/mudança 4 para simular uma caixa sequencial com uma alavanca padrão."

msgctxt "game_options"
msgid "Copy textures to VRAM, slower but more accurate. Disable this to save performance."
msgstr "Copia as texturas para a VRAM, mais lento porém mais preciso. Desative para economizar desempenho."

msgctxt "game_options"
msgid "Copy the color buffer to N64 memory. Needed for some effects (e.g. pause screens, camera photos). OFF is fastest but may break them. AUTO follows the performance mode."
msgstr "Copia o buffer de cor para a memória do N64. Necessário para alguns efeitos (ex.: ecrãs de pausa, fotos da câmara). DESLIGADO é o mais rápido, mas pode quebrá-los. AUTO segue o modo de desempenho."

msgctxt "game_options"
msgid "Correct but slower."
msgstr "Correto, porém mais lento."

msgctxt "game_options"
msgid "Correct the aspect ratio of non-square pixels."
msgstr "Corrige a proporção de pixels não quadrados."

msgctxt "game_options"
msgid "Correct the sampling of 2D sprite textures when upscaling."
msgstr "Corrige a amostragem das texturas de sprites 2D no upscaling."

msgctxt "game_options"
msgid "Crop out the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Corta a saída de vídeo possivelmente aleatória e com falhas que ficaria escondida pela moldura nas bordas de uma TV de definição padrão."

msgctxt "game_options"
msgid "Crop out the potentially video output that would have been hidden by the bezel."
msgstr "Corta a saída de vídeo que ficaria escondida pela moldura do ecrã."

msgctxt "game_options"
msgid "Crop pixels around edge of screen."
msgstr "Corta pixels ao redor da borda do ecrã."

msgctxt "game_options"
msgid "Crop the picture from its native aspect ratio to 4:3 or 16:9"
msgstr "Corta a imagem da proporção nativa para 4:3 ou 16:9."

msgctxt "game_options"
msgid "Crops the borders to show or hide border graphics."
msgstr "Corta as bordas para mostrar ou ocultar os gráficos de borda."

msgctxt "game_options"
msgid "Crops the image from 256x240 to 252x239."
msgstr "Corta a imagem de 256x240 para 252x239."

msgctxt "game_options"
msgid "Cutoff frequency of the console audio output filter. 3390 Hz matches most Mega Drive models."
msgstr "Frequência de corte do filtro de saída de áudio da consola. 3390 Hz corresponde à maioria dos modelos de Mega Drive."

msgctxt "game_options"
msgid "Cuts off 8 pixels on borders to remove Master System borders."
msgstr "Corta 8 pixels nas bordas para remover as bordas do Master System."

msgctxt "game_options"
msgid "DIMM board size. Auto follows the game, leave on Auto unless a game complains."
msgstr "Tamanho da placa DIMM. Auto segue o jogo; deixe em Auto a menos que um jogo reclame."

msgctxt "game_options"
msgid "Damps the chase camera swing in the driving games. Strong by default."
msgstr "Amortece o balanço da câmara de perseguição nos jogos de corrida. Forte por predefinição."

msgctxt "game_options"
msgid "Darken every other line to mimic a cathode ray tube."
msgstr "Escurece uma linha a cada duas para imitar um tubo de raios catódicos."

msgctxt "game_options"
msgid "DeSmuME has an internal BIOS, select this option to use the BIOS and firmware from the RetroBat bios folder."
msgstr "O DeSmuME tem uma BIOS interna; selecione esta opção para usar a BIOS e o firmware da pasta bios do RetroBat."

msgctxt "game_options"
msgid "Decrease if too sensitive, decreasing too much might prevent from going full range."
msgstr "Reduza se estiver sensível demais; reduzir demais pode impedir de alcançar o curso total."

msgctxt "game_options"
msgid "Default ON."
msgstr "LIGADO por predefinição."

msgctxt "game_options"
msgid "Default emulated pad is a 6-button pad."
msgstr "Por predefinição, o comando emulado é um comando de 6 botões."

msgctxt "game_options"
msgid "Default enabled, can be problematic for few games."
msgstr "Ativado por predefinição; pode causar problemas em alguns jogos."

msgctxt "game_options"
msgid "Default follows EmulationStation language."
msgstr "Por predefinição, segue o idioma do EmulationStation."

msgctxt "game_options"
msgid "Default is 'HIGH', set to 'NORMAL' to increase performance at the cost of accuracy."
msgstr "A predefinição é 'ALTO'; defina 'NORMAL' para aumentar o desempenho em troca de precisão."

msgctxt "game_options"
msgid "Default is 30 seconds, define time to wait for the game to launch before returning to RetroBat game list."
msgstr "A predefinição é 30 segundos; define o tempo de espera pelo início do jogo antes de voltar à lista de jogos do RetroBat."

msgctxt "game_options"
msgid "Default is OFF, use this in case of speed issue on displays with high refresh rate."
msgstr "DESLIGADO por predefinição; use em caso de problemas de velocidade em ecrãs com alta taxa de atualização."

msgctxt "game_options"
msgid "Default is ON (fast). OFF runs the real geometry DSP programs, more accurate but slower (Model 1, Model 2 2B games only)."
msgstr "LIGADO por predefinição (rápido). DESLIGADO executa os programas reais do DSP de geometria, mais preciso porém mais lento (apenas jogos Model 1 e Model 2 2B)."

msgctxt "game_options"
msgid "Default is ON, proper quad rendering. Setting to OFF renders quads as triangles (faster)."
msgstr "LIGADO por predefinição, renderização correta de quads. DESLIGADO renderiza os quads como triângulos (mais rápido)."

msgctxt "game_options"
msgid "Default is ON, setting to OFF might fix compatibility for older GPU (Model 3 only)."
msgstr "LIGADO por predefinição; DESLIGADO pode melhorar a compatibilidade com GPUs antigas (apenas Model 3)."

msgctxt "game_options"
msgid "Default is ON, use this setting to remove the 60hz limit, might break games."
msgstr "LIGADO por predefinição; use para remover o limite de 60Hz, pode quebrar jogos."

msgctxt "game_options"
msgid "Default is on, disable to show the boot animation."
msgstr "Ligado por predefinição; desative para mostrar a animação de arranque."

msgctxt "game_options"
msgid "Default to 10-bits for DS and 16-bits for DSi."
msgstr "Por predefinição, 10 bits para DS e 16 bits para DSi."

msgctxt "game_options"
msgid "Default to Pro Controller."
msgstr "Por predefinição, Pro Controller."

msgctxt "game_options"
msgid "Default to WIIU Gamepad, change this for games that do not accept WIIU Gamepad in multiplayer mode."
msgstr "Por predefinição, Wii U GamePad; altere para jogos que não aceitam o Wii U GamePad no modo multijogador."

msgctxt "game_options"
msgid "Default: cursor hidden."
msgstr "Predefinição: cursor oculto."

msgctxt "game_options"
msgid "Default: enabled."
msgstr "Predefinição: ativado."

msgctxt "game_options"
msgid "Default: low."
msgstr "Predefinição: baixo."

msgctxt "game_options"
msgid "Default: true"
msgstr "Predefinição: ligado."

msgctxt "game_options"
msgid "Defaults to 60, when set to 0, and VSYNC is enabled."
msgstr "Predefinição: 60, quando definido como 0 e o VSYNC estiver ativado."

msgctxt "game_options"
msgid "Define BIOS to use for emulation."
msgstr "Define a BIOS a usar na emulação."

msgctxt "game_options"
msgid "Define Gamepad type, applies to both players."
msgstr "Define o tipo de gamepad, aplica-se aos dois jogadores."

msgctxt "game_options"
msgid "Define PET computer model."
msgstr "Define o modelo de computador PET."

msgctxt "game_options"
msgid "Define Symbian device to run."
msgstr "Define o dispositivo Symbian a executar."

msgctxt "game_options"
msgid "Define button to display Gamepad screen, default if none."
msgstr "Define o botão para exibir o ecrã do GamePad: predefinição se nenhum."

msgctxt "game_options"
msgid "Define how much RAM the emulated will have."
msgstr "Define quanta RAM a máquina emulada terá."

msgctxt "game_options"
msgid "Define how the cursor should appear on bottom screen."
msgstr "Define como o cursor aparece no ecrã inferior."

msgctxt "game_options"
msgid "Define how the game fits or scales into the window."
msgstr "Define como o jogo se ajusta ou é escalado na janela."

msgctxt "game_options"
msgid "Define how to configure Sinden Gun."
msgstr "Define como configurar a pistola Sinden."

msgctxt "game_options"
msgid "Define how to map A and B buttons of the GunCon (Start and Back of the Justifier). Default: D-pad Right/Left with a DolphinBar Wiimote, mouse buttons with other guns."
msgstr "Define o mapeamento dos botões A e B da GunCon (Start e Back do Justifier). Predefinição: direcional direita/esquerda com um Wiimote na DolphinBar, botões do rato com outras pistolas."

msgctxt "game_options"
msgid "Define how to map the guncon2 buttons."
msgstr "Define o mapeamento dos botões da GunCon2."

msgctxt "game_options"
msgid "Define how touchscreen is emulated."
msgstr "Define como o ecrã tátil é emulado."

msgctxt "game_options"
msgid "Define how you wiimote is connected to the DolphinBar."
msgstr "Define como o Wiimote está conectado à DolphinBar."

msgctxt "game_options"
msgid "Define if patch should be applied and where patch files are located, 'AUTO' will apply patches if they are located near rom with same name as rom file."
msgstr "Define se o patch deve ser aplicado e onde ficam os ficheiros de patch; 'AUTO' aplica os patches localizados junto à ROM com o mesmo nome do ficheiro da ROM."

msgctxt "game_options"
msgid "Define mapping for mouse buttons (left/right/middle), defaut is a/reload/start."
msgstr "Define o mapeamento dos botões do rato (esquerdo/direito/meio); a predefinição é A/recarregar/start."

msgctxt "game_options"
msgid "Define model type and region."
msgstr "Define o tipo de modelo e a região."

msgctxt "game_options"
msgid "Define model, default to BK-0010."
msgstr "Define o modelo; predefinição: BK-0010."

msgctxt "game_options"
msgid "Define model, default to CPC 6128+ for GX4000."
msgstr "Define o modelo; predefinição: CPC 6128+ para GX4000."

msgctxt "game_options"
msgid "Define model, default to Spectrum 128K."
msgstr "Define o modelo; predefinição: Spectrum 128K."

msgctxt "game_options"
msgid "Define mouse index to use for player 1."
msgstr "Define o índice do rato do jogador 1."

msgctxt "game_options"
msgid "Define mouse index to use for player 2."
msgstr "Define o índice do rato do jogador 2."

msgctxt "game_options"
msgid "Define mouse index to use for player 3."
msgstr "Define o índice do rato do jogador 3."

msgctxt "game_options"
msgid "Define mouse index to use for player 4."
msgstr "Define o índice do rato do jogador 4."

msgctxt "game_options"
msgid "Define path to custom controls.ini file."
msgstr "Define o caminho do ficheiro controls.ini personalizado."

msgctxt "game_options"
msgid "Define region, used for saves."
msgstr "Define a região, usada para as gravações."

msgctxt "game_options"
msgid "Define the button combo to hold to toggle dualshock controller between analog and digital mode."
msgstr "Define a combinação de botões a segurar para alternar o DualShock entre os modos analógico e digital."

msgctxt "game_options"
msgid "Define the color palette, Old NTSC reproduces the old ugly japanese TV colors."
msgstr "Define a paleta de cores; NTSC antigo reproduz as cores feias das antigas TVs japonesas."

msgctxt "game_options"
msgid "Define the connected device that emulates a Dial device."
msgstr "Define o dispositivo conectado que emula um dial."

msgctxt "game_options"
msgid "Define the connected device that emulates a Pedal."
msgstr "Define o dispositivo conectado que emula um pedal."

msgctxt "game_options"
msgid "Define the connected device that emulates a Positional device."
msgstr "Define o dispositivo conectado que emula um dispositivo posicional."

msgctxt "game_options"
msgid "Define the connected device that emulates a Trackball."
msgstr "Define o dispositivo conectado que emula um trackball."

msgctxt "game_options"
msgid "Define the connected device that emulates a lightgun."
msgstr "Define o dispositivo conectado que emula uma pistola."

msgctxt "game_options"
msgid "Define the connected device that emulates a mouse."
msgstr "Define o dispositivo conectado que emula um rato."

msgctxt "game_options"
msgid "Define the connected device that emulates a paddle."
msgstr "Define o dispositivo conectado que emula um paddle."

msgctxt "game_options"
msgid "Define the connected device that emulates an Analog Directional Stick."
msgstr "Define o dispositivo conectado que emula um analógico direcional."

msgctxt "game_options"
msgid "Define the emulated joystick type."
msgstr "Define o tipo de joystick emulado."

msgctxt "game_options"
msgid "Define the emulated machine type."
msgstr "Define o tipo de máquina emulada."

msgctxt "game_options"
msgid "Define the function of the right joystick."
msgstr "Define a função do joystick direito."

msgctxt "game_options"
msgid "Define the key combination to enter the diagnostic menu."
msgstr "Define a combinação de teclas para entrar no menu de diagnóstico."

msgctxt "game_options"
msgid "Define the level of rumble and screen shaking, enable screenshake if the controller does not support rumble. 'AUTO' enables both."
msgstr "Define o nível de vibração e de tremor de ecrã; ative o tremor de ecrã se o comando não suportar vibração. 'AUTO' ativa os dois."

msgctxt "game_options"
msgid "Define the location of the currently held weapon."
msgstr "Define a posição da arma empunhada."

msgctxt "game_options"
msgid "Define the mapping of the D-PAD."
msgstr "Define o mapeamento do direcional."

msgctxt "game_options"
msgid "Define the number of memory cards to emulate."
msgstr "Define o número de cartões de memória a emular."

msgctxt "game_options"
msgid "Define the number of pixels to crop."
msgstr "Define o número de pixels a cortar."

msgctxt "game_options"
msgid "Define the sound that the emulated microphone will receive ."
msgstr "Define o som que o microfone emulado vai receber."

msgctxt "game_options"
msgid "Define the type of device used for pointer movement."
msgstr "Define o tipo de dispositivo usado para mover o ponteiro."

msgctxt "game_options"
msgid "Define the type of monitor, will change colors."
msgstr "Define o tipo de monitor; altera as cores."

msgctxt "game_options"
msgid "Define type of controller emulated."
msgstr "Define o tipo de comando emulado."

msgctxt "game_options"
msgid "Define type of crosshair for guns."
msgstr "Define o tipo de mira para as pistolas."

msgctxt "game_options"
msgid "Define where the coin and start buttons are located."
msgstr "Define onde ficam os botões de ficha e start."

msgctxt "game_options"
msgid "Define whether the 'fast-forward' shortcuts acts as a toggle or needs to be held."
msgstr "Define se os atalhos de 'avanço rápido' alternam ou precisam ser segurados."

msgctxt "game_options"
msgid "Define whether the 'slow-motion' shortcuts acts as a toggle or needs to be held."
msgstr "Define se os atalhos de 'câmara lenta' alternam ou precisam ser segurados."

msgctxt "game_options"
msgid "Define which Gameboy sound is output from the system."
msgstr "Define qual som do Game Boy é emitido pelo sistema."

msgctxt "game_options"
msgid "Define which analog stick controls the mouse pointer."
msgstr "Define qual analógico controla o ponteiro do rato."

msgctxt "game_options"
msgid "Define which button activates the turbo mode, this is not the button that is made turbo."
msgstr "Define qual botão ativa o modo turbo; este não é o botão que recebe o turbo."

msgctxt "game_options"
msgid "Degrees of wheel rotation that reach full in-game lock. 270 is the arcade cabinet."
msgstr "Graus de rotação do volante para chegar à viragem máxima no jogo. 270 é o da cabine arcade."

msgctxt "game_options"
msgid "Deny writes when busy."
msgstr "Recusa gravações quando ocupado."

msgctxt "game_options"
msgid "Depending on the configuration, can increase or decrease latency."
msgstr "Dependendo da configuração, pode aumentar ou diminuir a latência."

msgctxt "game_options"
msgid "Device plugged into the Apple II game port. The analog stick gives progressive paddle movement, the d-pad only goes fully left or right."
msgstr "Dispositivo conectado à porta de jogos do Apple II. O analógico move o paddle progressivamente; o direcional só vai totalmente à esquerda ou à direita."

msgctxt "game_options"
msgid "Device type for player 2."
msgstr "Tipo de dispositivo do jogador 2."

msgctxt "game_options"
msgid "DirectInput only: use it if the controllers do not control the right players."
msgstr "Apenas DirectInput: use se os comandos não controlarem os jogadores certos."

msgctxt "game_options"
msgid "Disable XBE signature check when using homebrew games."
msgstr "Desativa a verificação de assinatura XBE ao usar jogos homebrew."

msgctxt "game_options"
msgid "Disable Xenia Edge per-game settings so that RetroBat settings apply."
msgstr "Desativa as configurações por jogo do Xenia Edge para que as configurações do RetroBat sejam aplicadas."

msgctxt "game_options"
msgid "Disable core safety features in order to enable some homebrew games to launch."
msgstr "Desativa os recursos de segurança do núcleo para permitir que alguns jogos homebrew iniciem."

msgctxt "game_options"
msgid "Disable dithering and use the full 8 bits per channel color information."
msgstr "Desativa o dithering e usa a informação completa de cor de 8 bits por canal."

msgctxt "game_options"
msgid "Disable fog effects."
msgstr "Desativa os efeitos de nevoeiro."

msgctxt "game_options"
msgid "Disable hardware renderer, can increase compatibility."
msgstr "Desativa o renderizador por hardware; pode aumentar a compatibilidade."

msgctxt "game_options"
msgid "Disable keyboard shortcuts and give full access of Keyboard to the core. Toggle with 'Scroll Lock' key."
msgstr "Desativa os atalhos de teclado e dá acesso total ao teclado para o núcleo. Alterne com a tecla 'Scroll Lock'."

msgctxt "game_options"
msgid "Disable modifier volumes used to render shadows."
msgstr "Desativa os modifier volumes usados para renderizar sombras."

msgctxt "game_options"
msgid "Disable pixel shaders can fix some games crashing, do not activate unless the game needs it."
msgstr "Desativar os pixel shaders pode corrigir bloqueios de alguns jogos; não ative a menos que o jogo precise."

msgctxt "game_options"
msgid "Disable the Master System FM chip."
msgstr "Desativa o chip FM do Master System."

msgctxt "game_options"
msgid "Disable the Visual Pinball menu: the exit key (X) quits the table directly."
msgstr "Desativa o menu do Visual Pinball: a tecla de saída (X) sai da mesa diretamente."

msgctxt "game_options"
msgid "Disable the analog plunger (right stick) and the analog nudge (left stick)."
msgstr "Desativa o plunger analógico (analógico direito) e o empurrão analógico (analógico esquerdo)."

msgctxt "game_options"
msgid "Disable the cabinet camera check."
msgstr "Desativa a verificação da câmara da cabine."

msgctxt "game_options"
msgid "Disable the check of artworks in 'saves\mame\artwork' folder."
msgstr "Desativa a verificação dos artworks na pasta 'saves\mame\artwork'."

msgctxt "game_options"
msgid "Disable the controller applet that appears in multiplayer games to select the connected controllers."
msgstr "Desativa o applet de comandos que aparece em jogos multijogador para selecionar os comandos conectados."

msgctxt "game_options"
msgid "Disable the in-game menu opened with HOTKEY + EAST or F12."
msgstr "Desativa o menu do jogo aberto com HOTKEY + LESTE ou F12."

msgctxt "game_options"
msgid "Disable this option to center the IR pointer when the stick is released."
msgstr "Desative esta opção para centralizar o ponteiro IR quando o analógico for solto."

msgctxt "game_options"
msgid "Disable this option to improve performance."
msgstr "Desative esta opção para melhorar o desempenho."

msgctxt "game_options"
msgid "Disable this option to run directly a .bat or .cmd file without RetroBat trying to find the executable inside."
msgstr "Desative esta opção para executar diretamente um ficheiro .bat ou .cmd sem que o RetroBat tente encontrar o executável dentro dele."

msgctxt "game_options"
msgid "Disable this to map R2 and L2 with L and R buttons (non-digital)."
msgstr "Desative para mapear R2 e L2 nos botões L e R (não digitais)."

msgctxt "game_options"
msgid "Disable use of X-axis to nudge, Y-axis to plumb and Z-axis for plunger."
msgstr "Desativa o uso do eixo X para empurrar, do eixo Y para o prumo e do eixo Z para o plunger."

msgctxt "game_options"
msgid "Disable warning when running games that are not fully supported."
msgstr "Desativa o aviso ao executar jogos que não são totalmente suportados."

msgctxt "game_options"
msgid "Disables joypad rumble, by default rumble is only enabled when game and controller are compatible."
msgstr "Desativa a vibração do comando; por predefinição, a vibração só fica ativa quando o jogo e o comando são compatíveis."

msgctxt "game_options"
msgid "Disables the automatic per-game settings from the core database and enables the manual fixes below. Not recommended."
msgstr "Desativa as configurações automáticas por jogo da base de dados do núcleo e ativa as correções manuais abaixo. Não recomendado."

msgctxt "game_options"
msgid "Disables the motion interpolation, one frame of latency less."
msgstr "Desativa a interpolação de movimento; um fotograma de latência a menos."

msgctxt "game_options"
msgid "Disables the vertex cache. Might resolve missing or flickering graphics output. May degrade performance."
msgstr "Desativa o cache de vértices. Pode resolver gráficos ausentes ou intermitentes. Pode reduzir o desempenho."

msgctxt "game_options"
msgid "Disabling dithering can remove some noise and pixelate effects."
msgstr "Desativar o dithering pode remover ruído e efeitos de pixelização."

msgctxt "game_options"
msgid "Disabling safe features can help various games such as Xenosaga, Kingdom Hearts..."
msgstr "Desativar os recursos seguros pode ajudar vários jogos como Xenosaga, Kingdom Hearts..."

msgctxt "game_options"
msgid "Disabling the 4MB expansion RAM pack may be necessary for some games."
msgstr "Pode ser necessário desativar o RAM pack de expansão de 4MB para alguns jogos."

msgctxt "game_options"
msgid "Disabling this feature will reduce color depth."
msgstr "Desativar este recurso reduz a profundidade de cor."

msgctxt "game_options"
msgid "Display MAME menu interface when loading a game."
msgstr "Exibe a interface do menu do MAME ao carregar um jogo."

msgctxt "game_options"
msgid "Display SGB borders when emulating Super Game Boy."
msgstr "Exibe as bordas do SGB ao emular o Super Game Boy."

msgctxt "game_options"
msgid "Display a message when an achievement is unlocked. Enabled by default."
msgstr "Exibe uma mensagem quando uma conquista é desbloqueada. Ativado por predefinição."

msgctxt "game_options"
msgid "Display a small pointer on touchscreen."
msgstr "Exibe um pequeno ponteiro no ecrã tátil."

msgctxt "game_options"
msgid "Display an experience bar above the belt."
msgstr "Exibe uma barra de experiência acima do cinto."

msgctxt "game_options"
msgid "Display aspect of the LaserActive picture, 4:3 by default."
msgstr "Proporção de exibição da imagem do LaserActive, 4:3 por predefinição."

msgctxt "game_options"
msgid "Display crosshair if a lightgun is used."
msgstr "Exibe a mira quando uma pistola é usada."

msgctxt "game_options"
msgid "Display current life and mana values on the globes."
msgstr "Exibe os valores atuais de vida e mana nos globos."

msgctxt "game_options"
msgid "Display damage and experience as floating numbers."
msgstr "Exibe dano e experiência como números flutuantes."

msgctxt "game_options"
msgid "Display level time, secrets found and enemies killed."
msgstr "Exibe o tempo da fase, os segredos encontrados e os inimigos mortos."

msgctxt "game_options"
msgid "Display of the second screen (touch screen) of Primeval Hunt."
msgstr "Mostra o segundo ecrã (ecrã tátil) do Primeval Hunt."

msgctxt "game_options"
msgid "Display or not on-screen notifications."
msgstr "Mostra ou não as notificações no ecrã."

msgctxt "game_options"
msgid "Display the border regions of the screen. Has no effect on F18A output."
msgstr "Exibe as regiões de borda do ecrã. Sem efeito na saída do F18A."

msgctxt "game_options"
msgid "Display the emulated framebuffer at a widescreen aspect ratio. Get best results with full 3D games."
msgstr "Exibe o framebuffer emulado em proporção widescreen. Melhores resultados com jogos totalmente 3D."

msgctxt "game_options"
msgid "Display the game in 16:9. Best with GAME ASPECT RATIO set to 16/9."
msgstr "Exibe o jogo em 16:9. Melhor com PROPORÇÃO DE ECRÃ DO JOGO em 16/9."

msgctxt "game_options"
msgid "Display the overscan regions of the screen."
msgstr "Exibe as regiões de overscan do ecrã."

msgctxt "game_options"
msgid "Display the screen of the player 1 VMU over the game."
msgstr "Exibe o ecrã da VMU do jogador 1 sobre o jogo."

msgctxt "game_options"
msgid "Display used at startup. Can be switched in game with the F7 key (40/80 DISPLAY)."
msgstr "Ecrã usado no arranque. Pode ser alternado no jogo com a tecla F7 (40/80 DISPLAY)."

msgctxt "game_options"
msgid "Display voxel objects instead of flat sprites when available. Enabled by default."
msgstr "Exibe objetos em voxel em vez de sprites planos quando disponíveis. Ativado por predefinição."

msgctxt "game_options"
msgid "Dither supersampled framebuffer effects."
msgstr "Dithering nos efeitos de framebuffer superamostrados."

msgctxt "game_options"
msgid "Dithering applied to RDRAM framebuffer images."
msgstr "Dithering aplicado às imagens do framebuffer RDRAM."

msgctxt "game_options"
msgid "Divides the internal resolution: with a high internal resolution, higher values make the game bigger. Default: 1."
msgstr "Divide a resolução interna: com uma resolução interna alta, valores maiores deixam o jogo maior. Predefinição: 1."

msgctxt "game_options"
msgid "Doom 3 is a very dark game, increase to brighten the picture."
msgstr "Doom 3 é um jogo muito escuro; aumente para clarear a imagem."

msgctxt "game_options"
msgid "Doubles the perceived horizontal resolution, incompatible with supersampling."
msgstr "Dobra a resolução horizontal percebida; incompatível com superamostragem."

msgctxt "game_options"
msgid "Downscale the upscaled image (SSAA). Requires upscaling."
msgstr "Reduz a imagem ampliada (SSAA). Requer upscaling."

msgctxt "game_options"
msgid "Draw the scenery up to the end of the course in the games that support it (Daytona USA). Model 1 and Model 2 only."
msgstr "Desenha o cenário até ao fim do percurso nos jogos compatíveis (Daytona USA). Apenas Model 1 e Model 2."

msgctxt "game_options"
msgid "Drive used by disk swapping."
msgstr "Unidade usada pela troca de disco."

msgctxt "game_options"
msgid "Dual Stick: Robotron 2084 and Space Dungeon on the right stick. Swap Ports: Wizard of Wor, Apple Panic. Joy 2B+: multi-button joysticks."
msgstr "Dual Stick: Robotron 2084 e Space Dungeon no analógico direito. Trocar portas: Wizard of Wor, Apple Panic. Joy 2B+: joysticks com vários botões."

msgctxt "game_options"
msgid "Duplicate frames requires the Vulkan renderer."
msgstr "Os fotogramas duplicados requerem o renderizador Vulkan."

msgctxt "game_options"
msgid "Dynamic recompilation. Most games run faster, some slower."
msgstr "Recompilação dinâmica. A maioria dos jogos corre mais rápido, alguns mais devagar."

msgctxt "game_options"
msgid "Efficient graphics filters improving the rendering of games."
msgstr "Filtros gráficos eficientes que melhoram a renderização dos jogos."

msgctxt "game_options"
msgid "Eliminates distortion and warping of textures when upscaling."
msgstr "Elimina a distorção e a deformação das texturas no upscaling."

msgctxt "game_options"
msgid "Eliminates position-dependent distortion and warping of textures."
msgstr "Elimina a distorção e a deformação das texturas dependentes da posição."

msgctxt "game_options"
msgid "Emulate Buzz! buzzers on top of your gamepads. One controller covers 4 buzzers (players 1-4), two controllers cover 7."
msgstr "Emula buzzers do Buzz! nos seus gamepads. Um comando cobre 4 buzzers (jogadores 1-4), dois comandos cobrem 7."

msgctxt "game_options"
msgid "Emulate PS3 memory tiling. Fixes graphical glitches in some games at a small performance cost."
msgstr "Emula o tiling de memória da PS3. Corrige falhas gráficas em alguns jogos com pequeno custo de desempenho."

msgctxt "game_options"
msgid "Emulate Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."
msgstr "Emula a Voice Recognition Unit (Hey You, Pikachu!, Densha de GO!)."

msgctxt "game_options"
msgid "Emulate a DJ Hero turntable on top of your gamepads. Required for DJ Hero 1 and 2."
msgstr "Emula um gira-discos do DJ Hero nos seus gamepads. Necessário para DJ Hero 1 e 2."

msgctxt "game_options"
msgid "Emulate a Guitar Hero Live (GHLtar) controller on top of your gamepads. Required for Guitar Hero Live."
msgstr "Emula um comando do Guitar Hero Live (GHLtar) nos seus gamepads. Necessário para Guitar Hero Live."

msgctxt "game_options"
msgid "Emulate a New 3DS or an original 3DS."
msgstr "Emula um New 3DS ou um 3DS original."

msgctxt "game_options"
msgid "Emulate a PlayStation TV for local multiplayer (up to 4 controllers). Identical controllers are not supported, touchscreen games may not work."
msgstr "Emula uma PlayStation TV para multijogador local (até 4 comandos). Comandos idênticos não são suportados; jogos de ecrã tátil podem não funcionar."

msgctxt "game_options"
msgid "Emulate a specific motion control. The '/' means the action for L-stick/R-stick."
msgstr "Emula um controlo de movimento específico. O '/' indica a ação para analógico esquerdo/analógico direito."

msgctxt "game_options"
msgid "Emulate a spinner controller, driven by mouse movement. Mouse buttons are mapped to the Left (Yellow) and Right (Red) buttons."
msgstr "Emula um spinner, controlado pelo movimento do rato. Os botões do rato são mapeados nos botões Esquerdo (amarelo) e Direito (vermelho)."

msgctxt "game_options"
msgid "Emulate the 59.94Hz NTSC vblank rate instead of 60Hz. Fixes timing and audio drift in some NTSC games."
msgstr "Emula a taxa de vblank NTSC de 59,94Hz em vez de 60Hz. Corrige deriva de temporização e de áudio em alguns jogos NTSC."

msgctxt "game_options"
msgid "Emulate the Disney Infinity base accessory."
msgstr "Emula o acessório Disney Infinity Base."

msgctxt "game_options"
msgid "Emulate the Game Boy Player to enable rumble in compatible games."
msgstr "Emula o Game Boy Player para ativar a vibração nos jogos compatíveis."

msgctxt "game_options"
msgid "Emulate the LEGO Dimensions toypad accessory."
msgstr "Emula o acessório toypad do LEGO Dimensions."

msgctxt "game_options"
msgid "Emulate the Skylanders portal accessory."
msgstr "Emula o acessório portal do Skylanders."

msgctxt "game_options"
msgid "Emulate the Video CD Card, requires mpeg_card.bin in the bios folder."
msgstr "Emula a placa Video CD; requer mpeg_card.bin na pasta bios."

msgctxt "game_options"
msgid "Emulate the behavior of older engines, required by some older mods and demos."
msgstr "Emula o comportamento de motores mais antigos, necessário para alguns mods e demos antigos."

msgctxt "game_options"
msgid "Emulated thread time slice. Raising it can help a few games, lowering it can smooth others."
msgstr "Fatia de tempo das threads emuladas. Aumentar pode ajudar alguns jogos; diminuir pode deixar outros mais fluidos."

msgctxt "game_options"
msgid "Emulates LCD translucency effects, but increase motion blur."
msgstr "Emula os efeitos de translucidez do LCD, mas aumenta o desfoque de movimento."

msgctxt "game_options"
msgid "Emulates PS3 multisampling layout. Can fix some visual artifacts in some games."
msgstr "Emula o layout de multiamostragem da PS3. Pode corrigir artefactos visuais em alguns jogos."

msgctxt "game_options"
msgid "Emulation method used. AUTO for mixed features with max performance and compatibility."
msgstr "Método de emulação usado. AUTO para recursos mistos com máximo desempenho e compatibilidade."

msgctxt "game_options"
msgid "Emulator scanlines, only visible with some games."
msgstr "Scanlines do emulador, visíveis apenas em alguns jogos."

msgctxt "game_options"
msgid "Enable 32MB Ram mod for dreamcast, may affect compatibility."
msgstr "Ativa o mod de RAM de 32MB do Dreamcast; pode afetar a compatibilidade."

msgctxt "game_options"
msgid "Enable Boot to BIOS for DSI Games."
msgstr "Ativa iniciar na BIOS para jogos DSi."

msgctxt "game_options"
msgid "Enable CMS emulation."
msgstr "Ativa a emulação CMS."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhance sound accuracy at the cost of increased performance requirements."
msgstr "Ativa o processador de sinal digital. Melhora a precisão do som com maiores requisitos de desempenho."

msgctxt "game_options"
msgid "Enable Digital Sound Processor. Enhances sound accuracy at the cost of performance."
msgstr "Ativa o processador de sinal digital. Melhora a precisão do som em troca de desempenho."

msgctxt "game_options"
msgid "Enable Discord Rich Presence service, this will update Discord status to show the games being played."
msgstr "Ativa o Discord Rich Presence, que atualiza o estado do Discord para mostrar os jogos em execução."

msgctxt "game_options"
msgid "Enable Dolby Pro Logic II decoder in compatible games and 5.1 speakers."
msgstr "Ativa o descodificador Dolby Pro Logic II em jogos compatíveis e com altifalantes 5.1."

msgctxt "game_options"
msgid "Enable FidelityFX contrast adaptative sharpening."
msgstr "Ativa a nitidez adaptativa ao contraste do FidelityFX."

msgctxt "game_options"
msgid "Enable Floating Point Unit, usually useful for later 3D games."
msgstr "Ativa a unidade de ponto flutuante, geralmente útil para jogos 3D mais recentes."

msgctxt "game_options"
msgid "Enable Gravis Ultrasound emulation."
msgstr "Ativa a emulação da Gravis Ultrasound."

msgctxt "game_options"
msgid "Enable HDR for HDR-compatible displays."
msgstr "Ativa HDR para ecrãs compatíveis com HDR."

msgctxt "game_options"
msgid "Enable IBM PS/1 Audio emulation (disabled by default)."
msgstr "Ativa a emulação de áudio IBM PS/1 (desativada por predefinição)."

msgctxt "game_options"
msgid "Enable Just In Time emilation, increases emulation speed, not compatible with cycle exact."
msgstr "Ativa a emulação Just In Time; aumenta a velocidade da emulação, não é compatível com ciclo exato."

msgctxt "game_options"
msgid "Enable MAME internal remapping of controls."
msgstr "Ativa o remapeamento interno de controlos do MAME."

msgctxt "game_options"
msgid "Enable MAME option to automatically configure button layout per-game based on its internal database."
msgstr "Ativa a opção do MAME que configura automaticamente o layout de botões por jogo com base no seu base de dados interno."

msgctxt "game_options"
msgid "Enable MelonDS emulated bios instead of firmwares available in bios folder."
msgstr "Ativa a BIOS emulada do MelonDS em vez dos firmwares disponíveis na pasta bios."

msgctxt "game_options"
msgid "Enable OpenGL renderer, RetroArch driver must be set to OpenGL."
msgstr "Ativa o renderizador OpenGL; o driver do RetroArch deve estar em OpenGL."

msgctxt "game_options"
msgid "Enable PAL(50Hz) NES emulation."
msgstr "Ativa a emulação do NES PAL (50Hz)."

msgctxt "game_options"
msgid "Enable Sega CD RAM cartridge."
msgstr "Ativa o cartucho de RAM do Sega CD."

msgctxt "game_options"
msgid "Enable Service button to enter settings."
msgstr "Ativa o botão de serviço para entrar nas configurações."

msgctxt "game_options"
msgid "Enable Tandy Sound emulation."
msgstr "Ativa a emulação do Tandy Sound."

msgctxt "game_options"
msgid "Enable additional developer ram, might break games."
msgstr "Ativa RAM adicional de programador; pode quebrar jogos."

msgctxt "game_options"
msgid "Enable antialiasing, smooth polygons edges."
msgstr "Ativa o anti-aliasing, suaviza as bordas dos polígonos."

msgctxt "game_options"
msgid "Enable blargg NTSC video filters"
msgstr "Ativa os filtros de vídeo NTSC do blargg."

msgctxt "game_options"
msgid "Enable brute force up/downscaling (10.8.0 only)"
msgstr "Ativa o aumento/redução de escala por força bruta (apenas 10.8.0)."

msgctxt "game_options"
msgid "Enable cache mount"
msgstr "Ativa a montagem do cache."

msgctxt "game_options"
msgid "Enable casting shadows from in-game objects, only compatible with OpenGL."
msgstr "Ativa a projeção de sombras pelos objetos do jogo; compatível apenas com OpenGL."

msgctxt "game_options"
msgid "Enable certain games with support for the 3Dfx Voodoo accelerator."
msgstr "Ativa certos jogos com suporte ao acelerador 3Dfx Voodoo."

msgctxt "game_options"
msgid "Enable colorization of Game Boy games."
msgstr "Ativa a colorização dos jogos de Game Boy."

msgctxt "game_options"
msgid "Enable controller's rumble effects."
msgstr "Ativa os efeitos de vibração do comando."

msgctxt "game_options"
msgid "Enable controller's rumble effects. Only works in driving games."
msgstr "Ativa os efeitos de vibração do comando. Funciona apenas em jogos de corrida."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games, options (DS) are only compatible with DemulShooter."
msgstr "Ativa as miras nos jogos de tiro; as opções (DS) são compatíveis apenas com o DemulShooter."

msgctxt "game_options"
msgid "Enable crosshairs in shooting games."
msgstr "Ativa as miras nos jogos de tiro."

msgctxt "game_options"
msgid "Enable custom resolution based on video mode."
msgstr "Ativa uma resolução personalizada com base no modo de vídeo."

msgctxt "game_options"
msgid "Enable dynamic recompilers which help to improve performance."
msgstr "Ativa os recompiladores dinâmicos, que ajudam a melhorar o desempenho."

msgctxt "game_options"
msgid "Enable enhanced features for DS4 and DualSense, this will break compatibility with emulators using dinput until switch off."
msgstr "Ativa recursos avançados para DS4 e DualSense; isso quebra a compatibilidade com emuladores que usam dinput até ser desligado."

msgctxt "game_options"
msgid "Enable force feedback for supported controllers."
msgstr "Ativa o force feedback para os comandos compatíveis."

msgctxt "game_options"
msgid "Enable full screen antialiasing in Direct3D, smooth polygons edges."
msgstr "Ativa o anti-aliasing em ecrã inteiro no Direct3D, suaviza as bordas dos polígonos."

msgctxt "game_options"
msgid "Enable horizontal blend (blur) filter."
msgstr "Ativa o filtro de mistura horizontal (desfoque)."

msgctxt "game_options"
msgid "Enable if the wheel is pushed away from center instead of toward it."
msgstr "Ative se o volante for empurrado para longe do centro em vez de em direção a ele."

msgctxt "game_options"
msgid "Enable in-game crosshair to facilitate aiming."
msgstr "Ativa a mira no jogo para facilitar a pontaria."

msgctxt "game_options"
msgid "Enable intelligent zoom function."
msgstr "Ativa a função de zoom inteligente."

msgctxt "game_options"
msgid "Enable ips patches."
msgstr "Ativa os patches IPS."

msgctxt "game_options"
msgid "Enable less-accurate, but better sounding, Namco 106(mapper 19) sound emulation."
msgstr "Ativa uma emulação de som do Namco 106 (mapper 19) menos precisa, mas que soa melhor."

msgctxt "game_options"
msgid "Enable manual hacks below, otherwise hacks will be apllied automatically."
msgstr "Ativa os hacks manuais abaixo; caso contrário, os hacks são aplicados automaticamente."

msgctxt "game_options"
msgid "Enable motion control (gyro) either with mouse or with compatible controller."
msgstr "Ativa o controlo de movimento (giroscópio) com o rato ou com um comando compatível."

msgctxt "game_options"
msgid "Enable multitap in port 1."
msgstr "Ativa o multitap na porta 1."

msgctxt "game_options"
msgid "Enable multitap in port 2."
msgstr "Ativa o multitap na porta 2."

msgctxt "game_options"
msgid "Enable progressive scan for compatible games."
msgstr "Ativa o varrimento progressivo nos jogos compatíveis."

msgctxt "game_options"
msgid "Enable run-ahead mode for the reduction of input lag."
msgstr "Ativa o modo run-ahead para reduzir o atraso de entrada."

msgctxt "game_options"
msgid "Enable the IBM Music Feature Card (disabled by default)."
msgstr "Ativa a IBM Music Feature Card (desativada por predefinição)."

msgctxt "game_options"
msgid "Enable the Master System FM chip."
msgstr "Ativa o chip FM do Master System."

msgctxt "game_options"
msgid "Enable the Memory Management Unit. Required for some games."
msgstr "Ativa a unidade de gestão de memória. Necessário para alguns jogos."

msgctxt "game_options"
msgid "Enable the On Screen Keyboard feature which can be activated with the L3 button."
msgstr "Ativa o teclado no ecrã, que pode ser chamado com o botão L3."

msgctxt "game_options"
msgid "Enable the effects of the cheats activated in the Vita3K interface."
msgstr "Ativa o efeito das cheats ativadas na interface do Vita3K."

msgctxt "game_options"
msgid "Enable the effects of the chosen Action Replay and Gecko codes for a game."
msgstr "Ativa o efeito dos códigos Action Replay e Gecko escolhidos para um jogo."

msgctxt "game_options"
msgid "Enable the emulation of Jaguar joypads which are plugged in the enhanced joystick ports of the Atari STE."
msgstr "Ativa a emulação dos comandos Jaguar conectados às portas de joystick avançadas do Atari STE."

msgctxt "game_options"
msgid "Enable the use of the mouse for touchscreen instead of right stick."
msgstr "Ativa o uso do rato para o ecrã tátil em vez do analógico direito."

msgctxt "game_options"
msgid "Enable this if XInput controllers index are switched."
msgstr "Ative se os índices dos comandos XInput estiverem trocados."

msgctxt "game_options"
msgid "Enable this if the controller does not have analog triggers."
msgstr "Ative se o comando não tiver gatilhos analógicos."

msgctxt "game_options"
msgid "Enable this if you have a gsync/freesync monitor, can cause audio glitches."
msgstr "Ative se tiver um monitor G-SYNC/FreeSync; pode causar falhas de áudio."

msgctxt "game_options"
msgid "Enable this option if encountering issues with an Intel graphics chip."
msgstr "Ative esta opção se houver problemas com um chip gráfico Intel."

msgctxt "game_options"
msgid "Enable this option if you get missing graphics or broken lighting ingame."
msgstr "Ative esta opção se faltarem gráficos ou a iluminação estiver quebrada no jogo."

msgctxt "game_options"
msgid "Enable this option when using mamehooker with LEDs, solenoids, rumble..."
msgstr "Ative esta opção ao usar o MameHooker com LEDs, solenoides, vibração..."

msgctxt "game_options"
msgid "Enable this to enable shaders even when RetroBat has no shader set."
msgstr "Ative para ativar os shaders mesmo quando o RetroBat não tem um conjunto de shaders definido."

msgctxt "game_options"
msgid "Enable this to plus Player 1 joystick in left port instead of right port."
msgstr "Ative para conectar o joystick do jogador 1 na porta esquerda em vez da direita."

msgctxt "game_options"
msgid "Enable this to use Duckstation's provided shaders."
msgstr "Ative para usar os shaders fornecidos pelo Duckstation."

msgctxt "game_options"
msgid "Enable this to use your owned Project64 per-game settings."
msgstr "Ative para usar as suas próprias configurações por jogo do Project64."

msgctxt "game_options"
msgid "Enable verbose mode for debugging."
msgstr "Ativa o modo detalhado para depuração."

msgctxt "game_options"
msgid "Enabled by default (AUTO)."
msgstr "Ativado por predefinição (AUTO)."

msgctxt "game_options"
msgid "Enabled by default, improve data transfer of emulated SIO port."
msgstr "Ativado por predefinição; melhora a transferência de dados da porta SIO emulada."

msgctxt "game_options"
msgid "Enabled by default."
msgstr "Ativado por predefinição."

msgctxt "game_options"
msgid "Enabled by default. Disables dithering and forces 24-bit color output."
msgstr "Ativado por predefinição. Desativa o dithering e força a saída de cor em 24 bits."

msgctxt "game_options"
msgid "Enabled by default. Disabling it can improve performance but breaks some games."
msgstr "Ativado por predefinição. Desativar pode melhorar o desempenho, mas quebra alguns jogos."

msgctxt "game_options"
msgid "Enabled by default. Faster shaders, can cause rare graphical issues."
msgstr "Ativado por predefinição. Shaders mais rápidos, podem causar raros problemas gráficos."

msgctxt "game_options"
msgid "Enabled by default. Fixes graphical glitches in some games at a small performance cost."
msgstr "Ativado por predefinição. Corrige falhas gráficas em alguns jogos com pequeno custo de desempenho."

msgctxt "game_options"
msgid "Enabled by default. Removes blur from some games but reduces accuracy."
msgstr "Ativado por predefinição. Remove o desfoque de alguns jogos, mas reduz a precisão."

msgctxt "game_options"
msgid "Enabled by default. Replaces game sprites with an HD pack when one is available. Restart required."
msgstr "Ativado por predefinição. Substitui os sprites do jogo por um pacote HD quando disponível. Requer reinício."

msgctxt "game_options"
msgid "Enabled by default. Show messages coming from the emulator itself."
msgstr "Ativado por predefinição. Mostra as mensagens vindas do próprio emulador."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is capped at 60 FPS."
msgstr "Ativado por predefinição. Quando desativado, a taxa de fotogramas é limitada a 60 FPS."

msgctxt "game_options"
msgid "Enabled by default. When disabled, the frame rate is limited by the game."
msgstr "Ativado por predefinição. Quando desativado, a taxa de fotogramas é limitada pelo jogo."

msgctxt "game_options"
msgid "Enables 60HZ mode to reduce tearing on displays that do not support operation above 60HZ."
msgstr "Ativa o modo 60HZ para reduzir o tearing em ecrãs que não suportam mais de 60HZ."

msgctxt "game_options"
msgid "Enables Direct3D Automipmap generation."
msgstr "Ativa a geração automática de mipmaps do Direct3D."

msgctxt "game_options"
msgid "Enables WRX high resolution."
msgstr "Ativa a alta resolução WRX."

msgctxt "game_options"
msgid "Enables a low pass audio filter to soften the harsh sound of some games."
msgstr "Ativa um filtro de áudio passa-baixa para suavizar o som áspero de alguns jogos."

msgctxt "game_options"
msgid "Enables anti blur hack, less accurate but makes games less blurry."
msgstr "Ativa o hack anti-desfoque; menos preciso, mas deixa os jogos menos desfocados."

msgctxt "game_options"
msgid "Enables arrows, CTRL and ALT key to act as joystick and fire buttons."
msgstr "Faz as setas, CTRL e ALT funcionarem como joystick e botões de tiro."

msgctxt "game_options"
msgid "Enables custom patching functionality."
msgstr "Ativa a função de patches personalizados."

msgctxt "game_options"
msgid "Enables high resolution CEL rendering."
msgstr "Ativa a renderização CEL em alta resolução."

msgctxt "game_options"
msgid "Enables switching between different video signals."
msgstr "Permite alternar entre diferentes sinais de vídeo."

msgctxt "game_options"
msgid "Enabling this might cause some issues for 8BitDo controllers."
msgstr "Ativar isto pode causar problemas com comandos 8BitDo."

msgctxt "game_options"
msgid "Enabling this will downsampling to native color depth. Disabling enable output at higher color depth."
msgstr "Ativado, reduz para a profundidade de cor nativa. Desativado, permite saída com maior profundidade de cor."

msgctxt "game_options"
msgid "Enforces strict compliance to the API specification. Might result in degraded performance in some games. Can resolve rare cases of missing graphics and flickering."
msgstr "Impõe a conformidade estrita com a especificação da API. Pode reduzir o desempenho em alguns jogos. Pode resolver casos raros de gráficos ausentes e cintilação."

msgctxt "game_options"
msgid "Enhance graphics accuracy at the cost of increased performance requirements."
msgstr "Melhora a precisão gráfica com maiores requisitos de desempenho."

msgctxt "game_options"
msgid "Enhance shadows of the different objects."
msgstr "Melhora as sombras dos diferentes objetos."

msgctxt "game_options"
msgid "Enhance the quality of 2D textures."
msgstr "Melhora a qualidade das texturas 2D."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface."
msgstr "Melhora a qualidade das texturas das superfícies."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. OpenGL only."
msgstr "Melhora a qualidade das texturas das superfícies. Apenas OpenGL."

msgctxt "game_options"
msgid "Enhance the quality of textures on surface. Vulkan and OpenGL only."
msgstr "Melhora a qualidade das texturas das superfícies. Apenas Vulkan e OpenGL."

msgctxt "game_options"
msgid "Enhancement filter applied to textures."
msgstr "Filtro de melhoria aplicado às texturas."

msgctxt "game_options"
msgid "Enhancement. Reduces system slowdown. Causes issues in some games."
msgstr "Melhoria. Reduz a lentidão do sistema. Causa problemas em alguns jogos."

msgctxt "game_options"
msgid "Enter local UDP port to use for hosting."
msgstr "Introduza a porta UDP local a usar para alojar."

msgctxt "game_options"
msgid "Enter server address."
msgstr "Introduza o endereço do servidor."

msgctxt "game_options"
msgid "Enter the first characters of the game rom used to transfer data."
msgstr "Introduza os primeiros caracteres da ROM do jogo usada para transferir os dados."

msgctxt "game_options"
msgid "Enter the first characters of the save file used to transfer data."
msgstr "Introduza os primeiros caracteres do ficheiro de gravação usado para transferir os dados."

msgctxt "game_options"
msgid "Enter touch profile to load."
msgstr "Introduza o perfil de toque a carregar."

msgctxt "game_options"
msgid "Environmental reverb (EFX), enabled by default."
msgstr "Reverberação ambiente (EFX), ativada por predefinição."

msgctxt "game_options"
msgid "Exact is the closest to the console and the heaviest on the GPU. Fast is much lighter. Auto picks fast on weak or unstable GPUs."
msgstr "Exato é o mais próximo da consola e o mais pesado para a GPU. Rápido é muito mais leve. Auto escolhe Rápido em GPUs fracas ou instáveis."

msgctxt "game_options"
msgid "Executes Graphics backend on second thread, improves performance, reduces stutter and speeds up shader compilation."
msgstr "Executa o backend gráfico numa segunda thread; melhora o desempenho, reduz soluços e acelera a compilação de shaders."

msgctxt "game_options"
msgid "Expand SAMS memory card to 4M."
msgstr "Expande o cartão de memória SAMS para 4M."

msgctxt "game_options"
msgid "Expansion cartridge inserted in the console. Games with a known requirement override this automatically."
msgstr "Cartucho de expansão inserido na consola. Jogos com requisito conhecido substituem isto automaticamente."

msgctxt "game_options"
msgid "Experiment with this option, if your joystick drifts away (enabled by default)."
msgstr "Experimente esta opção se o seu joystick ficar com drift (ativado por predefinição)."

msgctxt "game_options"
msgid "Experimental, Windows only. Protects game stack data when the emulator handles memory exceptions. Can fix crashes in some games. Leave off unless a game needs it."
msgstr "Experimental, apenas Windows. Protege os dados de pilha do jogo quando o emulador trata exceções de memória. Pode corrigir bloqueios em alguns jogos. Deixe desligado a menos que um jogo precise."

msgctxt "game_options"
msgid "Extra controller. Leave empty unless the game asks for one."
msgstr "Comando extra. Deixe vazio a menos que o jogo peça um."

msgctxt "game_options"
msgid "Extra memory card, //e models only. A few programs need more than the stock 64KB."
msgstr "Placa de memória extra, apenas modelos //e. Alguns programas precisam de mais que os 64KB de fábrica."

msgctxt "game_options"
msgid "FM Towns mouse sensitivity."
msgstr "Sensibilidade do rato do FM Towns."

msgctxt "game_options"
msgid "Fast approximate anti-aliasing, cheaper than MSAA but blurrier."
msgstr "Anti-aliasing aproximado rápido, mais leve que o MSAA, mas mais desfocado."

msgctxt "game_options"
msgid "Fast can improve performance but may be unstable on some drivers."
msgstr "Rápido pode melhorar o desempenho, mas pode ser instável com alguns drivers."

msgctxt "game_options"
msgid "Fast disk loading ROM. Needs TRUE DRIVE EMULATION and the JiffyDOS ROMs in 'bios\vice'. Not used with tapes and cartridges."
msgstr "ROM de carregamento rápido de disco. Requer EMULAÇÃO REAL DA UNIDADE e as ROMs JiffyDOS em 'bios\vice'. Não usado com cassetes e cartuchos."

msgctxt "game_options"
msgid "Fast is less accurate, ordered and atomic is accurate but slower."
msgstr "Rápido é menos preciso; Ordenado e atómico é preciso, porém mais lento."

msgctxt "game_options"
msgid "Faster DSP emulation engine (experimental). Only used when DSP EMULATION is enabled."
msgstr "Motor de emulação do DSP mais rápido (experimental). Usado apenas quando EMULAÇÃO DO DSP está ativada."

msgctxt "game_options"
msgid "Faster loading times but can cause issues with some games."
msgstr "Carregamentos mais rápidos, mas pode causar problemas em alguns jogos."

msgctxt "game_options"
msgid "Faster sector reads. Some software may not expect it."
msgstr "Leituras de setor mais rápidas. Algum software pode não contar com isso."

msgctxt "game_options"
msgid "Filter all textures. Including any that the game explicitly sets as unfiltered. Disabled by default."
msgstr "Filtra todas as texturas, incluindo as que o jogo define explicitamente como sem filtro. Desativado por predefinição."

msgctxt "game_options"
msgid "Filter applied to the final image."
msgstr "Filtro aplicado à imagem final."

msgctxt "game_options"
msgid "Filter used to scale the picture to the screen."
msgstr "Filtro usado para escalar a imagem no ecrã."

msgctxt "game_options"
msgid "Filter used when scaling the final image."
msgstr "Filtro usado ao escalar a imagem final."

msgctxt "game_options"
msgid "Filter used when the rendered image is larger than the screen."
msgstr "Filtro usado quando a imagem renderizada é maior que o ecrã."

msgctxt "game_options"
msgid "Filter used when the rendered image is smaller than the screen."
msgstr "Filtro usado quando a imagem renderizada é menor que o ecrã."

msgctxt "game_options"
msgid "Filtering applied to 3D textures."
msgstr "Filtragem aplicada às texturas 3D."

msgctxt "game_options"
msgid "Filtering applied to 3D textures. OpenGL only."
msgstr "Filtragem aplicada às texturas 3D. Apenas OpenGL."

msgctxt "game_options"
msgid "Filtering applied to sprites and 2D elements."
msgstr "Filtragem aplicada aos sprites e elementos 2D."

msgctxt "game_options"
msgid "Fire continuously as long as the button is pressed."
msgstr "Atira continuamente enquanto o botão estiver premido."

msgctxt "game_options"
msgid "Fire the gun's recoil motor on each shot, for guns that have one. On by default."
msgstr "Aciona o motor de recuo da pistola a cada tiro, nas pistolas que o têm. Ligado por predefinição."

msgctxt "game_options"
msgid "Fit high resolution or widescreen games inside a 640x480 frame with black borders. Only useful on a 4:3 CRT TV."
msgstr "Encaixa jogos em alta resolução ou widescreen num fotograma de 640x480 com bordas pretas. Útil apenas numa TV CRT 4:3."

msgctxt "game_options"
msgid "Fit the Digital Video Cartridge (vmpega.rom in the bios folder), required by FMV games and Video CDs."
msgstr "Encaixa o cartucho de vídeo digital (vmpega.rom na pasta bios), necessário para jogos FMV e Video CDs."

msgctxt "game_options"
msgid "Fit to the original ratio of the game."
msgstr "Ajusta à proporção original do jogo."

msgctxt "game_options"
msgid "Fix Demul bug (exiting fullscreen when shooting upper left corner), blocking all mouse inputs to Demul GUI."
msgstr "Corrige um bug do Demul (sair do ecrã inteiro ao atirar no canto superior esquerdo) bloqueando todas as entradas do rato para a interface do Demul."

msgctxt "game_options"
msgid "Fix issues with upscaling in Namco games (Ace Combat, Tekken, SoulCalibur...)."
msgstr "Corrige problemas de upscaling nos jogos da Namco (Ace Combat, Tekken, SoulCalibur...)."

msgctxt "game_options"
msgid "Fix slowdowns with this emulator."
msgstr "Corrige lentidões com este emulador."

msgctxt "game_options"
msgid "Fix texture corruption and depth issues on AMD and some Intel GPUs."
msgstr "Corrige corrupção de texturas e problemas de profundidade em GPUs AMD e algumas Intel."

msgctxt "game_options"
msgid "Fix the banding that might appear in upscaled textures."
msgstr "Corrige as faixas de cor que podem aparecer em texturas ampliadas."

msgctxt "game_options"
msgid "Fix the game getting stuck in a loop at boot."
msgstr "Corrige o jogo bloqueado num loop no arranque."

msgctxt "game_options"
msgid "Fixes coplanar geometry and decals in some games, may break others."
msgstr "Corrige geometria coplanar e decalques em alguns jogos; pode quebrar outros."

msgctxt "game_options"
msgid "Fixes gaps between 2D elements."
msgstr "Corrige espaços entre elementos 2D."

msgctxt "game_options"
msgid "Fixes shadow and depth artifacts in some games."
msgstr "Corrige artefactos de sombra e profundidade em alguns jogos."

msgctxt "game_options"
msgid "Fixes some graphical bugs involving lines."
msgstr "Corrige alguns bugs gráficos envolvendo linhas."

msgctxt "game_options"
msgid "Fixes text bugs in some games."
msgstr "Corrige bugs de texto em alguns jogos."

msgctxt "game_options"
msgid "Floating Point Unit, needed by some 3D games. On by default with the 68040 (built in), off with the 68030."
msgstr "Unidade de ponto flutuante, necessária para alguns jogos 3D. Ligada por predefinição com o 68040 (integrada), desligada com o 68030."

msgctxt "game_options"
msgid "Folder for Vita3K data (firmware, installed games, saves). Ignored when Vita3K is in portable mode (non-empty 'portable' folder next to Vita3K.exe)."
msgstr "Pasta dos dados do Vita3K (firmware, jogos instalados, gravações). Ignorada quando o Vita3K está em modo portátil (pasta 'portable' não vazia ao lado do Vita3K.exe)."

msgctxt "game_options"
msgid "Font ROM required by some Japanese games."
msgstr "ROM de fonte exigida por alguns jogos japoneses."

msgctxt "game_options"
msgid "For Bleach Blade Battlers."
msgstr "Para Bleach Blade Battlers."

msgctxt "game_options"
msgid "For Goemon."
msgstr "Para Goemon."

msgctxt "game_options"
msgid "For Nintendo systems, invert A and B to match Xbox button names."
msgstr "Nos sistemas Nintendo, inverte A e B para corresponder aos nomes dos botões do Xbox."

msgctxt "game_options"
msgid "For Run Behind and M-bit Games."
msgstr "Para jogos Run Behind e M-bit."

msgctxt "game_options"
msgid "For SOCOM 2 HUD/Spy Hunter."
msgstr "Para o HUD do SOCOM 2/Spy Hunter."

msgctxt "game_options"
msgid "For Scarface The World is Yours and Crash Tag Team Racing."
msgstr "Para Scarface: The World is Yours e Crash Tag Team Racing."

msgctxt "game_options"
msgid "For SegaScope 3-D games, show one eye only instead of the flickering pair."
msgstr "Nos jogos SegaScope 3-D, mostra apenas um olho em vez do par a piscar."

msgctxt "game_options"
msgid "For Superman Returns."
msgstr "Para Superman Returns."

msgctxt "game_options"
msgid "For Tales of Destiny."
msgstr "Para Tales of Destiny."

msgctxt "game_options"
msgid "For Tri-Ace Games."
msgstr "Para jogos da Tri-Ace."

msgctxt "game_options"
msgid "For games using ASTC textures, switch to medium when using 6GB VRAM GPU and low when using 4GB-2GB VRAM GPU."
msgstr "Para jogos com texturas ASTC, mude para médio com GPU de 6GB de VRAM e baixo com GPU de 4GB-2GB de VRAM."

msgctxt "game_options"
msgid "For n64 controllers with 2 triggers, use R2 instead of L2 as Z button."
msgstr "Em comandos de N64 com 2 gatilhos, usa R2 em vez de L2 como botão Z."

msgctxt "game_options"
msgid "For nostalgia. By default it looks like accelerated FoW in BG2"
msgstr "Para matar a saudade. Por predefinição, parece a névoa de guerra acelerada do BG2."

msgctxt "game_options"
msgid "For some emulators, can be used to fix wiimote keyboard and mouse association when using 2 wiimotes."
msgstr "Em alguns emuladores, pode corrigir a associação de teclado e rato dos Wiimotes ao usar 2 Wiimotes."

msgctxt "game_options"
msgid "Force GBC software that alters behavior when run on GBA."
msgstr "Força o software de GBC que muda de comportamento quando executado no GBA."

msgctxt "game_options"
msgid "Force GameBoy mode for GameBoy Color."
msgstr "Força o modo Game Boy para o Game Boy Color."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful if XInput devices are not ordered right."
msgstr "Força o índice do comando do J1; útil se os dispositivos XInput não estiverem na ordem certa."

msgctxt "game_options"
msgid "Force P1 pad index, can be useful when using a controller on an arcade machine."
msgstr "Força o índice do comando do J1; útil ao usar um comando numa máquina arcade."

msgctxt "game_options"
msgid "Force P2 pad index, can be useful when using a controller on an arcade machine."
msgstr "Força o índice do comando do J2; útil ao usar um comando numa máquina arcade."

msgctxt "game_options"
msgid "Force Rawinput, there should be no need to force this to ON."
msgstr "Força o Raw Input; não deveria ser necessário ativar isto."

msgctxt "game_options"
msgid "Force a CPU cycle count per operation. AUTO uses the per-game default, only change it if a game is broken."
msgstr "Força uma contagem de ciclos de CPU por operação. AUTO usa a predefinição por jogo; altere apenas se um jogo não funcionar corretamente."

msgctxt "game_options"
msgid "Force button instead of axis for triggers, can help with Sony controllers."
msgstr "Força botões em vez de eixos para os gatilhos; pode ajudar com comandos Sony."

msgctxt "game_options"
msgid "Force emulator in fullscreen even if RetroBat is windowed"
msgstr "Força o emulador em ecrã inteiro mesmo se o RetroBat estiver em janela."

msgctxt "game_options"
msgid "Force frame limiter."
msgstr "Força o limitador de fotogramas."

msgctxt "game_options"
msgid "Force how textures are sampled. Nearest neighbor keeps pixels sharp, linear smooths them."
msgstr "Força como as texturas são amostradas. Vizinho mais próximo mantém os pixels nítidos; linear suaviza-os."

msgctxt "game_options"
msgid "Force input driver. Defaults to 'sdl', 'dinput' if multiguns is enabled."
msgstr "Força o driver de entrada. Predefinição: 'sdl'; 'dinput' se várias pistolas estiverem ativadas."

msgctxt "game_options"
msgid "Force resolution to current screen resolution for games that allow custom resolution."
msgstr "Força a resolução do ecrã atual em jogos que permitem resolução personalizada."

msgctxt "game_options"
msgid "Force saturn expansion cart if autodetect fails."
msgstr "Força o cartucho de expansão do Saturn se a deteção automática falhar."

msgctxt "game_options"
msgid "Force saturn region if autodetect fails."
msgstr "Força a região do Saturn se a deteção automática falhar."

msgctxt "game_options"
msgid "Force stereo on all ROMs."
msgstr "Força o estéreo em todas as ROMs."

msgctxt "game_options"
msgid "Force the Game Boy model to emulate if autodetect fails."
msgstr "Força o modelo de Game Boy a emular se a deteção automática falhar."

msgctxt "game_options"
msgid "Force the VI refresh rate. AUTO is correct for almost every game."
msgstr "Força a taxa de atualização VI. AUTO é correto para quase todos os jogos."

msgctxt "game_options"
msgid "Force the actual output channel layout. AUDIO CHANNELS declares what the game sees, this decides how it is downmixed to your device. Leave on AUTO unless your output device is misdetected."
msgstr "Força o layout real dos canais de saída. CANAIS DE ÁUDIO declara o que o jogo vê; esta opção decide como é feito o downmix para o seu dispositivo. Deixe em AUTO a menos que o dispositivo de saída seja detetado incorretamente."

msgctxt "game_options"
msgid "Force the backglass on or off. AUTO follows SCREEN SETUP (enabled when SCREEN SETUP is not set)."
msgstr "Força o backglass ligado ou desligado. AUTO segue CONFIGURAÇÃO DOS ECRÃS (ativado quando CONFIGURAÇÃO DOS ECRÃS não está definida)."

msgctxt "game_options"
msgid "Force the bilinear filtering mode used when upscaling dirty rectangles."
msgstr "Força o modo de filtragem bilinear usado no upscaling dos retângulos sujos."

msgctxt "game_options"
msgid "Force the boot device (1F/2F and later models only)."
msgstr "Força o dispositivo de arranque (apenas modelos 1F/2F e posteriores)."

msgctxt "game_options"
msgid "Force the console region."
msgstr "Força a região da consola."

msgctxt "game_options"
msgid "Force the console region. By default the region is detected from the game."
msgstr "Força a região da consola. Por predefinição, a região é detetada pelo jogo."

msgctxt "game_options"
msgid "Force the emulated refresh rate instead of detecting it from the loaded game. Requires a core restart."
msgstr "Força a taxa de atualização emulada em vez de detetá-la pelo jogo carregado. Requer reiniciar o núcleo."

msgctxt "game_options"
msgid "Force the emulator to use a specific BIOS file."
msgstr "Força o emulador a usar um ficheiro de BIOS específico."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches."
msgstr "Força a frequência da CPU emulada. Pode reduzir a lentidão, mas pode causar falhas."

msgctxt "game_options"
msgid "Force the frequency of the emulated CPU. Can reduce slowdown, but may cause glitches. Default is 57%."
msgstr "Força a frequência da CPU emulada. Pode reduzir a lentidão, mas pode causar falhas. A predefinição é 57%."

msgctxt "game_options"
msgid "Force the game region frequency to avoid emulated speed issues, leave 'Auto' unless you notice speed issues."
msgstr "Força a frequência da região do jogo para evitar problemas de velocidade na emulação; deixe em 'Auto' a menos que perceba problemas de velocidade."

msgctxt "game_options"
msgid "Force the keyboard to use if multiple keyboards are connected."
msgstr "Força o teclado a usar se houver vários teclados conectados."

msgctxt "game_options"
msgid "Force the memory bank controller. Only change this if a game does not run correctly. Requires a core restart."
msgstr "Força o controlador de bancos de memória (mapper). Altere apenas se um jogo não correr corretamente. Requer reiniciar o núcleo."

msgctxt "game_options"
msgid "Force the monochrome display modes, as on a period green or amber monitor."
msgstr "Força os modos de exibição monocromáticos, como num monitor verde ou âmbar da época."

msgctxt "game_options"
msgid "Force the number of Wiimotes the game will detect. Set to 1 for games that switch to multiplayer as soon as several controllers are connected."
msgstr "Força o número de Wiimotes que o jogo detetará. Defina 1 para jogos que passam para multijogador assim que vários comandos são conectados."

msgctxt "game_options"
msgid "Force the region of the system."
msgstr "Força a região do sistema."

msgctxt "game_options"
msgid "Force the rendering and display of frames to progressive mode."
msgstr "Força a renderização e a exibição dos fotogramas em modo progressivo."

msgctxt "game_options"
msgid "Force the type of media file"
msgstr "Força o tipo de ficheiro de suporte."

msgctxt "game_options"
msgid "Force usage of SDL driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Força o uso do driver SDL para os comandos; defina se usar mais de 4 comandos, pois o XInput é limitado a 4 jogadores."

msgctxt "game_options"
msgid "Force usage of SDL or DInput driver for controllers, set this if more than 4 controllers are used, as XInput limits to 4 players."
msgstr "Força o uso do driver SDL ou DInput para os comandos; defina se usar mais de 4 comandos, pois o XInput é limitado a 4 jogadores."

msgctxt "game_options"
msgid "Force usage of a specific softlist, software list needs to be in 'bios\mame\hash' folder."
msgstr "Força o uso de uma softlist específica; a lista de software deve estar na pasta 'bios\mame\hash'."

msgctxt "game_options"
msgid "Force use of high-level BIOS emulation."
msgstr "Força o uso da emulação de BIOS de alto nível (HLE)."

msgctxt "game_options"
msgid "Force voice cart in slot 1, needs 'voice.zip' bios file."
msgstr "Força o cartucho de voz no slot 1; requer o ficheiro de BIOS 'voice.zip'."

msgctxt "game_options"
msgid "Force wheel index, can be useful if RetroBat sets wrong index."
msgstr "Força o índice do volante; útil se o RetroBat definir o índice errado."

msgctxt "game_options"
msgid "Forces 60Hz refresh rate."
msgstr "Força a taxa de atualização de 60Hz."

msgctxt "game_options"
msgid "Forces console to PAL mode instead of NTSC, might feel sluggish."
msgstr "Força a consola no modo PAL em vez de NTSC; pode parecer mais lento."

msgctxt "game_options"
msgid "Forces emulation of blit and image manipulation on the CPU, more accurate in some cases and required for games like GT6."
msgstr "Força a emulação de blit e manipulação de imagem na CPU; mais preciso em alguns casos e necessário para jogos como GT6."

msgctxt "game_options"
msgid "Forces raw input driver when using devices such as trackball and spinners."
msgstr "Força o driver raw input ao usar dispositivos como trackballs e spinners."

msgctxt "game_options"
msgid "Forces the engine compatibility level. Set MBF21 for WADs that require it."
msgstr "Força o nível de compatibilidade do motor. Defina MBF21 para WADs que o exigem."

msgctxt "game_options"
msgid "Full precision of 12-bit for the MCM5205 ADPCM can reduce whining noise during ADPCM playback."
msgstr "A precisão total de 12 bits do ADPCM MSM5205 pode reduzir o chiado durante a reprodução ADPCM."

msgctxt "game_options"
msgid "Fullscreen resolution. By default the desktop resolution is used."
msgstr "Resolução do ecrã inteiro. Por predefinição, é usada a resolução da área de trabalho."

msgctxt "game_options"
msgid "Fully control the camera with the right stick."
msgstr "Controlo total da câmara com o analógico direito."

msgctxt "game_options"
msgid "GST states can be opened by Kega and Gens, but store less of the machine state."
msgstr "Os estados GST podem ser abertos pelo Kega e pelo Gens, mas armazenam menos do estado da máquina."

msgctxt "game_options"
msgid "Gain on the drive board's forces. 30% by default, 200% doubles them."
msgstr "Ganho das forças da drive board. 30% por predefinição; 200% duplica-as."

msgctxt "game_options"
msgid "Game resolution. Higher values show more of the game area."
msgstr "Resolução do jogo. Valores maiores mostram mais da área de jogo."

msgctxt "game_options"
msgid "Gamepad steering travel in driving games. 66% by default, no effect on a wheel."
msgstr "Curso da direção com o gamepad em jogos de corrida. 66% por predefinição; sem efeito com volante."

msgctxt "game_options"
msgid "Gamepad: the pad and the keyboard move the CD-i pointer. Mouse: the PC mouse moves the pointer (point and click and gun games), the pad only keeps its buttons. Hotkey + L3 switches during the game."
msgstr "Gamepad: o comando e o teclado movem o ponteiro do CD-i. Rato: o rato do PC move o ponteiro (jogos de apontar e clicar e de pistola); o comando mantém só os botões. Hotkey + L3 alterna durante o jogo."

msgctxt "game_options"
msgid "Gamepads become player 1, 2... and arcade sticks are assigned to the next players."
msgstr "Os gamepads tornam-se jogador 1, 2... e os arcade sticks são atribuídos aos jogadores seguintes."

msgctxt "game_options"
msgid "General purpose timing hack."
msgstr "Hack de temporização de uso geral."

msgctxt "game_options"
msgid "German and French need a PAL version of the game, Japanese an NTSC version."
msgstr "Alemão e francês exigem uma versão PAL do jogo; japonês, uma versão NTSC."

msgctxt "game_options"
msgid "Give the whole keyboard to the game (Scroll Lock gives it back to the hotkeys) and grab the mouse. The gamepad still works."
msgstr "Entrega o teclado inteiro ao jogo (o Scroll Lock devolve-o às hotkeys) e captura o rato. O gamepad continua a funcionar."

msgctxt "game_options"
msgid "Good for cache emulation problems."
msgstr "Bom para problemas de emulação de cache."

msgctxt "game_options"
msgid "Graphics chipset for the non-AGA models. Automatic follows the selected model, which is almost always what you want."
msgstr "Chipset gráfico dos modelos não AGA. Automático segue o modelo selecionado, o que quase sempre é o desejado."

msgctxt "game_options"
msgid "Graphics plugin used to render the game."
msgstr "Plugin gráfico usado para renderizar o jogo."

msgctxt "game_options"
msgid "Graphics quality preset (textures, filtering). AUTO selects it from the amount of memory."
msgstr "Predefinição de qualidade gráfica (texturas, filtragem). AUTO seleciona-a pela quantidade de memória."

msgctxt "game_options"
msgid "Greatly affects CPU performance."
msgstr "Afeta muito o desempenho da CPU."

msgctxt "game_options"
msgid "Greatly increase the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Aumenta muito a qualidade das texturas geradas com efeitos render-to-texture. Ativado por predefinição. Desativar pode evitar bloqueios em jogos com texturas personalizadas."

msgctxt "game_options"
msgid "Greatly inscrease the quality of textures generated using render-to-texture effects. Enabled by default. Disabling it may avoid crashes for games using custom textures."
msgstr "Aumenta muito a qualidade das texturas geradas com efeitos render-to-texture. Ativado por predefinição. Desativar pode evitar bloqueios em jogos com texturas personalizadas."

msgctxt "game_options"
msgid "Gun games played with a controller (no lightgun). Relative: the stick moves the cursor. Absolute: the stick position is the screen position, back to the center when released."
msgstr "Jogos de pistola jogados com um comando (sem pistola). Relativo: o analógico move o cursor. Absoluto: a posição do analógico é a posição no ecrã; volta ao centro ao ser solto."

msgctxt "game_options"
msgid "HLE is fast, LLE is more accurate but requires the DSP ROM files."
msgstr "HLE é rápido; LLE é mais preciso, mas requer os ficheiros de ROM do DSP."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window."
msgstr "HOTKEY + START envia a tecla de saída (X) ao Visual Pinball em vez de fechar a sua janela."

msgctxt "game_options"
msgid "HOTKEY + START sends the exit key (X) to Visual Pinball instead of closing its window: its menu opens (the table quits with DISABLE MENU)."
msgstr "HOTKEY + START envia a tecla de saída (X) ao Visual Pinball em vez de fechar a sua janela: abre o seu menu (a mesa sai com DESATIVAR MENU)."

msgctxt "game_options"
msgid "HOTKEY+L3 quick save, START+L3 quick load, START+R3 screenshot. Enabled by default."
msgstr "HOTKEY+L3 gravação rápida, START+L3 carregamento rápido, START+R3 captura de ecrã. Ativado por predefinição."

msgctxt "game_options"
msgid "Hack needed for some games (Too Human)."
msgstr "Hack necessário para alguns jogos (Too Human)."

msgctxt "game_options"
msgid "Hack needed for some games."
msgstr "Hack necessário para alguns jogos."

msgctxt "game_options"
msgid "Half scanlines mimics a CRT display. 560 x 192 gives a cleaner picture on a flat panel."
msgstr "Meias scanlines imitam um ecrã CRT. 560 x 192 dá uma imagem mais limpa num painel plano."

msgctxt "game_options"
msgid "Hard disk controller, required to run .hdv and .2mg hard disk images. Changing this reboots the machine."
msgstr "Controlador de disco rígido, necessário para executar imagens de disco rígido .hdv e .2mg. Alterar isto reinicia a máquina."

msgctxt "game_options"
msgid "Hidden by default, disable it if a game does not start correctly."
msgstr "Oculto por predefinição; desative se um jogo não iniciar corretamente."

msgctxt "game_options"
msgid "Hide in-game crosshair (game dependant)."
msgstr "Oculta a mira do jogo (depende do jogo)."

msgctxt "game_options"
msgid "Hide in-game weapon model (game dependant)."
msgstr "Oculta o modelo da arma no jogo (depende do jogo)."

msgctxt "game_options"
msgid "Hide pointer on touchscreen when inactive (timeout)."
msgstr "Oculta o ponteiro do ecrã tátil quando inativo (tempo limite)."

msgctxt "game_options"
msgid "Hide shader and PPU compilation hints."
msgstr "Oculta as dicas de compilação de shaders e da PPU."

msgctxt "game_options"
msgid "Hide the crosshair after a delay without aiming or shooting. It comes back as soon as you aim again."
msgstr "Oculta a mira após um tempo sem mirar ou atirar. Volta assim que voltar a mirar."

msgctxt "game_options"
msgid "Hide the edges of the picture as a TV does, or add a border (negative values)."
msgstr "Oculta as bordas da imagem como faz uma TV, ou adiciona uma borda (valores negativos)."

msgctxt "game_options"
msgid "Hide the white flash shown on each shot."
msgstr "Oculta o flash branco mostrado a cada tiro."

msgctxt "game_options"
msgid "High level emulation of some Portfolio OS functions. May improve performance in some games."
msgstr "Emulação de alto nível de algumas funções do Portfolio OS. Pode melhorar o desempenho em alguns jogos."

msgctxt "game_options"
msgid "High sound quality for games using expansion audio"
msgstr "Alta qualidade de som para jogos que usam áudio de expansão."

msgctxt "game_options"
msgid "Higher accuracy fixes bugs in some games at cost of performance. Only used if SPU decoder is set to Dynamic or LLVM."
msgstr "Maior precisão corrige bugs em alguns jogos em troca de desempenho. Usado apenas se o descodificador da SPU estiver em Dinâmico ou LLVM."

msgctxt "game_options"
msgid "Higher frame rates through frame interpolation, limited by vertical sync. May cause minor visual or animation glitches."
msgstr "Taxas de fotogramas maiores por interpolação de fotogramas, limitadas pela sincronização vertical. Pode causar pequenas falhas visuais ou de animação."

msgctxt "game_options"
msgid "Higher is more accurate but slower."
msgstr "Maior é mais preciso, porém mais lento."

msgctxt "game_options"
msgid "Higher values give better signal noise ratio and preservation of higher frequencies."
msgstr "Valores maiores dão melhor relação sinal-ruído e preservam melhor as altas frequências."

msgctxt "game_options"
msgid "Higher values use less memory, lower values run faster."
msgstr "Valores maiores usam menos memória; menores correm mais rápido."

msgctxt "game_options"
msgid "House of the Dead 4 speed fix: CPU frequency in GHz (e.g. 4.3). Auto-detected when not set."
msgstr "Correção de velocidade do House of the Dead 4: frequência da CPU em GHz (ex.: 4.3). Detetada automaticamente quando não definida."

msgctxt "game_options"
msgid "How far a stick must move before the Amiga sees it. Raise it if the character drifts on its own."
msgstr "Quanto um analógico precisa de se mover antes de o Amiga o detetar. Aumente se a personagem andar sozinha."

msgctxt "game_options"
msgid "How fast the paddle moves."
msgstr "Velocidade a que o paddle se move."

msgctxt "game_options"
msgid "How fast the paddles move when the mouse is used as the game port device."
msgstr "Velocidade a que os paddles se movem quando o rato é usado como dispositivo da porta de jogos."

msgctxt "game_options"
msgid "How much of the screen width sweeps the paddle from end to end. A smaller value makes the paddle faster and lets it reach its stops without moving the pointer off the screen, which some calibration screens need."
msgstr "Que parte da largura do ecrã leva o paddle de uma ponta à outra. Um valor menor torna o paddle mais rápido e permite-lhe alcançar os batentes sem tirar o ponteiro do ecrã, o que alguns ecrãs de calibração exigem."

msgctxt "game_options"
msgid "How strongly the stick responds."
msgstr "Intensidade da resposta do analógico."

msgctxt "game_options"
msgid "How the TV screen and the GamePad screen are displayed."
msgstr "Como o ecrã da TV e o ecrã do GamePad são mostrados."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga."
msgstr "Como o comando é apresentado ao Amiga."

msgctxt "game_options"
msgid "How the pad is presented to the Amiga. 'Joystick' is the classic 2-button stick every game understands. 'CD32 pad' adds the coloured buttons, and is selected automatically on CD32."
msgstr "Como o comando é apresentado ao Amiga. 'Joystick' é o clássico de 2 botões que qualquer jogo entende. 'Comando CD32' adiciona os botões coloridos e é selecionado automaticamente no CD32."

msgctxt "game_options"
msgid "How the picture is rendered. RGB is the sharpest, the composite and TV modes reproduce the colour bleeding of a period display."
msgstr "Como a imagem é renderizada. RGB é a mais nítida; os modos composto e TV reproduzem o sangramento de cor de um ecrã da época."

msgctxt "game_options"
msgid "How the picture is rendered. The composite modes reproduce the colour bleeding of a period display, RGB is the sharpest."
msgstr "Como a imagem é renderizada. Os modos composto reproduzem o sangramento de cor de um ecrã da época; RGB é a mais nítida."

msgctxt "game_options"
msgid "How the picture is scaled to the screen."
msgstr "Como a imagem é escalada no ecrã."

msgctxt "game_options"
msgid "Hybrid draws new shaders at once while they build. Asynchronous can leave objects missing for a moment. Synchronous makes the game wait for each shader."
msgstr "Híbrido desenha os novos shaders de imediato enquanto são gerados. Assíncrono pode deixar objetos em falta por um instante. Síncrono faz o jogo esperar por cada shader."

msgctxt "game_options"
msgid "If Custom is selected it will use MesenPalette.pal as custom palette in bios directory."
msgstr "Se Personalizado for selecionado, usa MesenPalette.pal na pasta bios como paleta personalizada."

msgctxt "game_options"
msgid "If Off, disables the dithering pattern the PSX applies to combat color banding."
msgstr "Se desligado, desativa o padrão de dithering que a PSX aplica para combater as faixas de cor."

msgctxt "game_options"
msgid "If disabled, DualShock can be toggled between DIGITAL/ANALOG with a toggle combo."
msgstr "Se desativado, o DualShock pode ser alternado entre DIGITAL/ANALÓGICO com uma combinação."

msgctxt "game_options"
msgid "If disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently."
msgstr "Se desativado, estes módulos só serão compilados quando necessário. Dependendo do jogo, isso pode interromper a sessão de jogo inesperadamente e talvez com frequência."

msgctxt "game_options"
msgid "If multiple gun devices are connected, set this option to setup only one gun."
msgstr "Se várias pistolas estiverem conectadas, defina esta opção para configurar apenas uma."

msgctxt "game_options"
msgid "If required, define GBA rom to use."
msgstr "Se necessário, define a ROM de GBA a usar."

msgctxt "game_options"
msgid "If the folder name contains 'soniccd', RetroBat will automatically run Sonic CD RSDK, use this to force it."
msgstr "Se o nome da pasta contiver 'soniccd', o RetroBat executará automaticamente o Sonic CD RSDK; use isto para forçá-lo."

msgctxt "game_options"
msgid "If the joystick is within this deadzone the cursor will not move."
msgstr "Se o joystick estiver dentro desta zona morta, o cursor não se move."

msgctxt "game_options"
msgid "If you are using a gamepad with motion such as a dualshock or switch pro, enable this to use the motion sensor."
msgstr "Se usar um comando com sensor de movimento, como DualShock ou Switch Pro, ative para usar o sensor de movimento."

msgctxt "game_options"
msgid "If you are using real Wiimotes with a Sensor Bar, set the right position of the Sensor Bar for better precision."
msgstr "Se usar Wiimotes reais com uma Sensor Bar, defina a posição correta da Sensor Bar para mais precisão."

msgctxt "game_options"
msgid "Ignore Horizon OS Services, can solve crashes on some games."
msgstr "Ignora os serviços do Horizon OS; pode resolver bloqueios em alguns jogos."

msgctxt "game_options"
msgid "Ignore analog stick movement below this threshold."
msgstr "Ignora movimentos do analógico abaixo deste limiar."

msgctxt "game_options"
msgid "Ignore existing ini files in 'bios\mame\ini' folder."
msgstr "Ignora os ficheiros ini existentes na pasta 'bios\mame\ini'."

msgctxt "game_options"
msgid "Ignore small stick movements around the centre. Increase it when the on-screen cursor drifts on its own."
msgstr "Ignora pequenos movimentos do analógico em torno do centro. Aumente quando o cursor no ecrã andar sozinho."

msgctxt "game_options"
msgid "Ignore table specific backglass settings (.res file next to the table) during the game. The file is kept and restored on exit."
msgstr "Ignora as configurações de backglass específicas da mesa (ficheiro .res ao lado da mesa) durante o jogo. O ficheiro é mantido e restaurado ao sair."

msgctxt "game_options"
msgid "Ignore the per-game settings saved in shadPS4 and always use RetroBat settings."
msgstr "Ignora as configurações por jogo guardadas no shadPS4 e usa sempre as configurações do RetroBat."

msgctxt "game_options"
msgid "Improve performance at the cost of accuracy and input lag."
msgstr "Melhora o desempenho em troca de precisão e atraso de entrada."

msgctxt "game_options"
msgid "Improve performance for cpu with more than 4 cores, default is enabled."
msgstr "Melhora o desempenho em CPUs com mais de 4 núcleos; ativado por predefinição."

msgctxt "game_options"
msgid "Improve performance in many game. Disabling this may avoid graphical defect in some other games."
msgstr "Melhora o desempenho em muitos jogos. Desativar pode evitar defeitos gráficos em alguns outros jogos."

msgctxt "game_options"
msgid "Improve polygon rendering when using OpenGL renderer."
msgstr "Melhora a renderização de polígonos com o renderizador OpenGL."

msgctxt "game_options"
msgid "Improve shader accuracy. Disabling gives a small speed gain but can cause graphical glitches in some games."
msgstr "Melhora a precisão dos shaders. Desativar dá um pequeno ganho de velocidade, mas pode causar falhas gráficas em alguns jogos."

msgctxt "game_options"
msgid "Improve the loading of discs of the emulated game."
msgstr "Melhora o carregamento dos discos do jogo emulado."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements."
msgstr "Melhora a resolução com maiores requisitos de desempenho."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. OpenGL only."
msgstr "Melhora a resolução com maiores requisitos de desempenho. Apenas OpenGL."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Requires a Redream key."
msgstr "Melhora a resolução com maiores requisitos de desempenho. Requer uma chave do Redream."

msgctxt "game_options"
msgid "Improve the resolution at the cost of increased performance requirements. Vulkan and OpenGL only."
msgstr "Melhora a resolução com maiores requisitos de desempenho. Apenas Vulkan e OpenGL."

msgctxt "game_options"
msgid "Improves accuracy in some games but may reduce performance."
msgstr "Melhora a precisão em alguns jogos, mas pode reduzir o desempenho."

msgctxt "game_options"
msgid "Improves color depth."
msgstr "Melhora a profundidade de cor."

msgctxt "game_options"
msgid "Improves performance in some games but will skip all EFB-based effects."
msgstr "Melhora o desempenho em alguns jogos, mas salta todos os efeitos baseados no EFB."

msgctxt "game_options"
msgid "Improves performance."
msgstr "Melhora o desempenho."

msgctxt "game_options"
msgid "Improves performance. Experimental with several consoles."
msgstr "Melhora o desempenho. Experimental em várias consolas."

msgctxt "game_options"
msgid "Improves stability in some games but reduces performance."
msgstr "Melhora a estabilidade em alguns jogos, mas reduz o desempenho."

msgctxt "game_options"
msgid "Improves the data loading speed."
msgstr "Melhora a velocidade de carregamento dos dados."

msgctxt "game_options"
msgid "Improves the emulation performance at the cost of accuracy."
msgstr "Melhora o desempenho da emulação em troca de precisão."

msgctxt "game_options"
msgid "In OpenGL only."
msgstr "Apenas em OpenGL."

msgctxt "game_options"
msgid "In case of multidisc games, when using .m3u file, specify the disc number to run."
msgstr "Em jogos com vários discos, ao usar um ficheiro .m3u, especifique o número do disco a iniciar."

msgctxt "game_options"
msgid "Increase accuracy, can fix some issues of sound and speed."
msgstr "Aumenta a precisão; pode corrigir alguns problemas de som e velocidade."

msgctxt "game_options"
msgid "Increase if shots register slightly off-target."
msgstr "Aumente se os tiros forem registados ligeiramente fora do alvo."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own."
msgstr "Aumente se a visão ou o jogador se mover sozinho."

msgctxt "game_options"
msgid "Increase if the view or the player moves on its own. Default is 10%."
msgstr "Aumente se a visão ou o jogador se mover sozinho. A predefinição é 10%."

msgctxt "game_options"
msgid "Increase the 3DFx Voodoo OpenGL resolution."
msgstr "Aumenta a resolução OpenGL da 3Dfx Voodoo."

msgctxt "game_options"
msgid "Increase the number of sprites that can be drawn simultaneously on screen."
msgstr "Aumenta o número de sprites que podem ser desenhados ao mesmo tempo no ecrã."

msgctxt "game_options"
msgid "Increases RAM usage and initial launch time but reduces reading from disk after startup."
msgstr "Aumenta o uso de RAM e o tempo do primeiro carregamento, mas reduz as leituras do disco após o arranque."

msgctxt "game_options"
msgid "Increasing the value can cause glitches."
msgstr "Aumentar o valor pode causar falhas."

msgctxt "game_options"
msgid "Initializes color render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Inicializa os render targets de cor a partir da memória emulada. Necessário para alguns jogos renderizarem corretamente; pode reduzir o desempenho. Desligado por predefinição."

msgctxt "game_options"
msgid "Initializes depth render targets from emulated memory. Needed by some games to render correctly, can reduce performance. Default off."
msgstr "Inicializa os render targets de profundidade a partir da memória emulada. Necessário para alguns jogos renderizarem corretamente; pode reduzir o desempenho. Desligado por predefinição."

msgctxt "game_options"
msgid "Input the server to use in this format 'x.x.x.x:y'."
msgstr "Introduza o servidor a usar no formato 'x.x.x.x:y'."

msgctxt "game_options"
msgid "Insert MoonSound extension in I/O slot."
msgstr "Insere a extensão MoonSound no slot de E/S."

msgctxt "game_options"
msgid "Insert Video9000 extension in I/O slot."
msgstr "Insere a extensão Video9000 no slot de E/S."

msgctxt "game_options"
msgid "Insert a disk in floppy drive, is often used for CDROM games."
msgstr "Insere um disco na unidade de disquete; usado com frequência em jogos de CD-ROM."

msgctxt "game_options"
msgid "Installed video chip. Automatic uses TMS9918A unless the game requires the F18A upgrade. Requires a core restart."
msgstr "Chip de vídeo instalado. Automático usa o TMS9918A, a menos que o jogo exija o upgrade F18A. Requer reiniciar o núcleo."

msgctxt "game_options"
msgid "Interpolates audio output for improved quality."
msgstr "Interpola a saída de áudio para melhorar a qualidade."

msgctxt "game_options"
msgid "Interpreter has better compatibility than JIT Dynamic Recompiler, JIT is faster."
msgstr "O interpretador tem melhor compatibilidade que o recompilador dinâmico JIT; o JIT é mais rápido."

msgctxt "game_options"
msgid "Invert A/B and X/Y buttons."
msgstr "Inverte os botões A/B e X/Y."

msgctxt "game_options"
msgid "Invert the Zapper light sensor signal. Needed by some gun hardware."
msgstr "Inverte o sinal do sensor de luz da Zapper. Necessário para alguns hardwares de pistola."

msgctxt "game_options"
msgid "Invert the Zapper trigger signal. Needed by some gun hardware."
msgstr "Inverte o sinal do gatilho da Zapper. Necessário para alguns hardwares de pistola."

msgctxt "game_options"
msgid "Invert the gamepad right analog stick's vertical axis."
msgstr "Inverte o eixo vertical do analógico direito do gamepad."

msgctxt "game_options"
msgid "Invert up and down crosshair aiming controls."
msgstr "Inverte os controlos de mira para cima e para baixo."

msgctxt "game_options"
msgid "Inverts looking up and down (gamepad and mouse)."
msgstr "Inverte o olhar para cima e para baixo (gamepad e rato)."

msgctxt "game_options"
msgid "Inverts looking up and down with the gamepad."
msgstr "Inverte o olhar para cima e para baixo com o gamepad."

msgctxt "game_options"
msgid "Inverts looking up and down with the right stick."
msgstr "Inverte o olhar para cima e para baixo com o analógico direito."

msgctxt "game_options"
msgid "Inverts the vertical axis when flying."
msgstr "Inverte o eixo vertical ao voar."

msgctxt "game_options"
msgid "JIT is fastest, Interpreter is more accurate."
msgstr "JIT é o mais rápido; Interpretador é mais preciso."

msgctxt "game_options"
msgid "Just In Time compilation. Greatly speeds up 68020 and later models. Ignored on 68000 machines and automatically disabled in cycle exact mode."
msgstr "Compilação Just In Time. Acelera muito os modelos 68020 e posteriores. Ignorada em máquinas 68000 e desativada automaticamente no modo ciclo exato."

msgctxt "game_options"
msgid "Keep DOS shell active if quitting game or when launch fails."
msgstr "Mantém o shell do DOS ativo ao sair do jogo ou quando o arranque falha."

msgctxt "game_options"
msgid "Keep or delete games files once extracted (squashfs, 7z)"
msgstr "Mantém ou elimina os ficheiros dos jogos após a extração (squashfs, 7z)."

msgctxt "game_options"
msgid "Keep the CD image in memory."
msgstr "Mantém a imagem do CD na memória."

msgctxt "game_options"
msgid "Keep the original aspect ratio instead of stretching the picture."
msgstr "Mantém a proporção original em vez de esticar a imagem."

msgctxt "game_options"
msgid "Key that opens Amiberry's own menu. F12 is the only function key an Amiga never had, so it is the only one that stays free."
msgstr "Tecla que abre o menu do próprio Amiberry. F12 é a única tecla de função que o Amiga nunca teve, por isso é a única que fica livre."

msgctxt "game_options"
msgid "Key that switches between windowed and fullscreen during emulation."
msgstr "Tecla que alterna entre janela e ecrã inteiro durante a emulação."

msgctxt "game_options"
msgid "Keys used as a joystick when no controller is connected. Arrow keys fire with Right Ctrl. Numeric keypad fires with 0 or 5. WASD fires with Left Alt."
msgstr "Teclas usadas como joystick quando nenhum comando está conectado. As setas atiram com Ctrl direito. O teclado numérico atira com 0 ou 5. WASD atira com Alt esquerdo."

msgctxt "game_options"
msgid "L2, R2, L3 and R3 perform the special moves of the current character, when the game lists them. On by default."
msgstr "L2, R2, L3 e R3 executam os golpes especiais do personagem atual, quando o jogo os lista. Ligado por predefinição."

msgctxt "game_options"
msgid "L3 = Service, R3 = Test, to open the operator menu of the games. On by default."
msgstr "L3 = Serviço, R3 = Teste, para abrir o menu do operador dos jogos. Ligado por predefinição."

msgctxt "game_options"
msgid "LLVM is fastest, use the Interpreter settings if there are issues."
msgstr "LLVM é o mais rápido; use as configurações do Interpretador se houver problemas."

msgctxt "game_options"
msgid "LLVM is the fastest option with very good compatibility. If you experience issues, use the ASMJIT Recompiler."
msgstr "LLVM é a opção mais rápida, com ótima compatibilidade. Se houver problemas, use o recompilador ASMJIT."

msgctxt "game_options"
msgid "Language games should display text in."
msgstr "Idioma em que os jogos devem exibir o texto."

msgctxt "game_options"
msgid "Language of menus and in-game text. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Idioma dos menus e textos do jogo. Um idioma não disponível no jogo é ignorado e a configuração do jogo é mantida."

msgctxt "game_options"
msgid "Language of subtitles. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Idioma das legendas. Um idioma não disponível no jogo é ignorado e a configuração do jogo é mantida."

msgctxt "game_options"
msgid "Language of voices. A language not available in the game is ignored and the in-game setting is kept."
msgstr "Idioma das vozes. Um idioma não disponível no jogo é ignorado e a configuração do jogo é mantida."

msgctxt "game_options"
msgid "Large speedup on multi-core CPUs, but a small number of games hang with it."
msgstr "Grande aceleração em CPUs multinúcleo, mas alguns poucos jogos bloqueiam com isso."

msgctxt "game_options"
msgid "Launch DemulShooter for gun games."
msgstr "Inicia o DemulShooter para jogos de pistola."

msgctxt "game_options"
msgid "Launch MameHooker for outputs management."
msgstr "Inicia o MameHooker para a gestão das saídas."

msgctxt "game_options"
msgid "Leave 'Auto' unless the detection fails."
msgstr "Deixe em 'Auto' a menos que a deteção falhe."

msgctxt "game_options"
msgid "Leave AUTO as default except the game requires specific setting."
msgstr "Deixe AUTO como predefinição, exceto se o jogo exigir uma configuração específica."

msgctxt "game_options"
msgid "Leave AUTO for Automatic detection."
msgstr "Deixe AUTO para a deteção automática."

msgctxt "game_options"
msgid "Leave auto to automatically adapt to the game orientation, use this setting to force if required."
msgstr "Deixe em auto para se adaptar automaticamente à orientação do jogo; use esta configuração para forçar, se necessário."

msgctxt "game_options"
msgid "Leave off unless the sync source is set to video: vsync and audio sync work poorly together."
msgstr "Deixe desligado a menos que a fonte de sincronização seja vídeo: vsync e sincronização de áudio funcionam mal juntos."

msgctxt "game_options"
msgid "Leave on AUTO to let the emulator pick the first valid BIOS found in '\bios\pcsx2\bios'."
msgstr "Deixe em AUTO para o emulador escolher a primeira BIOS válida encontrada em '\bios\pcsx2\bios'."

msgctxt "game_options"
msgid "Leave on Automatic to keep the processor the selected model really had. A faster CPU can break games that rely on precise timing."
msgstr "Deixe em Automático para manter o processador que o modelo selecionado realmente tinha. Uma CPU mais rápida pode quebrar jogos que dependem de temporização precisa."

msgctxt "game_options"
msgid "Leave on Automatic unless a game needs a specific ROM. The file must be in the bios folder. Requires a core restart."
msgstr "Deixe em Automático a menos que um jogo precise de uma ROM específica. O ficheiro deve estar na pasta bios. Requer reiniciar o núcleo."

msgctxt "game_options"
msgid "Leave this ON by default to enable CPU JIT Optimizations."
msgstr "Deixe LIGADO por predefinição para ativar as otimizações JIT da CPU."

msgctxt "game_options"
msgid "Leave this on 16:9 unless you have a 4:3 monitor."
msgstr "Deixe em 16:9 a menos que tenha um monitor 4:3."

msgctxt "game_options"
msgid "Leave this on by default, will use multiple threads for rendering."
msgstr "Deixe ligado por predefinição; usa várias threads para a renderização."

msgctxt "game_options"
msgid "Leaving MANUAL will not change user-defined value, AUTO is 60."
msgstr "MANUAL não altera o valor definido pelo utilizador; AUTO é 60."

msgctxt "game_options"
msgid "Left becomes right and up becomes down."
msgstr "A esquerda passa a direita e cima passa a baixo."

msgctxt "game_options"
msgid "Let ALTIRRA choose the profile based on the game."
msgstr "Deixa o ALTIRRA escolher o perfil com base no jogo."

msgctxt "game_options"
msgid "Let RetroArch map controllers with its own autoconfig profiles instead of RetroBat mapping. Will override RetroBat autoconfig."
msgstr "Deixa o RetroArch mapear os comandos com os próprios perfis de configuração automática em vez do mapeamento do RetroBat. Substitui a configuração automática do RetroBat."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file or filename (brackets)."
msgstr "Deixa o RetroBat tentar obter a sequência de arranque do ficheiro hash do MAME ou do nome do ficheiro (colchetes)."

msgctxt "game_options"
msgid "Let RetroBat try to retrieve the boot sequence from MAME hash file."
msgstr "Deixa o RetroBat tentar obter a sequência de arranque do ficheiro hash do MAME."

msgctxt "game_options"
msgid "Let Visual Pinball switch to the selected video mode itself instead of changing the desktop resolution."
msgstr "Deixa o Visual Pinball mudar sozinho para o modo de vídeo selecionado em vez de alterar a resolução da área de trabalho."

msgctxt "game_options"
msgid "Lets a MegaWiFi cartridge ROM reach your network and the internet. Only enable it for ROMs you trust."
msgstr "Permite que uma ROM de cartucho MegaWiFi aceda à sua rede e à internet. Ative apenas para ROMs fiáveis."

msgctxt "game_options"
msgid "Lets the core pace itself instead of relying on RetroArch. Try 'standard 50 Hz' if a PAL game runs unevenly."
msgstr "Deixa o núcleo controlar o próprio ritmo em vez de depender do RetroArch. Tente 'padrão 50 Hz' se um jogo PAL correr de forma irregular."

msgctxt "game_options"
msgid "Lets the emulator read back the GS memory. On by default. Turning it off is faster but can break some graphic effects."
msgstr "Permite que o emulador leia de volta a memória do GS. Ligado por predefinição. Desligar é mais rápido, mas pode quebrar alguns efeitos gráficos."

msgctxt "game_options"
msgid "Lets the left stick act as the joystick in addition to the d-pad."
msgstr "Permite que o analógico esquerdo funcione como joystick além do direcional."

msgctxt "game_options"
msgid "Lift the game's frame rate cap where the game allows it. Anything but original can break a game."
msgstr "Remove o limite de taxa de fotogramas do jogo onde o jogo permite. Qualquer valor diferente de original pode quebrar um jogo."

msgctxt "game_options"
msgid "Link 2 to 4 Lynx with the ComLynx cable on one screen, one controller each. Disables save states and achievements."
msgstr "Liga de 2 a 4 Lynx com o cabo ComLynx num único ecrã, um comando para cada. Desativa save states e conquistas."

msgctxt "game_options"
msgid "Load custom profile for wheel mapping."
msgstr "Carrega um perfil personalizado para o mapeamento do volante."

msgctxt "game_options"
msgid "Load mods (.dusk files) from a folder named like the game, next to it, or from dusklight\data\mods when there is none."
msgstr "Carrega mods (ficheiros .dusk) de uma pasta com o nome do jogo ao lado dele ou, se não houver, de dusklight\data\mods."

msgctxt "game_options"
msgid "Load mods from User\Load\GraphicsMods folder."
msgstr "Carrega mods da pasta User\Load\GraphicsMods."

msgctxt "game_options"
msgid "Load the mods placed in the mods folder of the game (one folder with a mod.ini per mod). On by default."
msgstr "Carrega os mods colocados na pasta mods do jogo (uma pasta com um mod.ini por mod). Ligado por predefinição."

msgctxt "game_options"
msgid "Loads a graphics quality preset (textures, filtering, soft particles). Leave on AUTO to keep the in-game settings."
msgstr "Carrega uma predefinição de qualidade gráfica (texturas, filtragem, partículas suaves). Deixe em AUTO para manter as configurações do jogo."

msgctxt "game_options"
msgid "Loads the first two disks of a multi-disk game into drive 1 and drive 2 at once, instead of drive 1 only. Needed by the few games that ask for two drives."
msgstr "Carrega os dois primeiros discos de um jogo com vários discos nas unidades 1 e 2 de uma vez, em vez de só na unidade 1. Necessário para os poucos jogos que pedem duas unidades."

msgctxt "game_options"
msgid "Loads the replacement textures of Data\Assets\HDTextures\<rom> in the emulator folder."
msgstr "Carrega as texturas de substituição de Data\Assets\HDTextures\<rom> na pasta do emulador."

msgctxt "game_options"
msgid "Loads the whole disc image into memory. Faster loading, higher RAM usage."
msgstr "Carrega a imagem inteira do disco na memória. Carregamento mais rápido, maior uso de RAM."

msgctxt "game_options"
msgid "Low shader quality can improve performance but cause glitches."
msgstr "Baixa qualidade de shaders pode melhorar o desempenho, mas causar falhas."

msgctxt "game_options"
msgid "Lower means less latency, too low causes dropouts."
msgstr "Menor significa menos latência; baixo demais causa cortes."

msgctxt "game_options"
msgid "Lower the GS precision to avoid gap between pixels when upscaling. Fix Wild Arms text, SoulCalibur ghosting."
msgstr "Reduz a precisão do GS para evitar espaços entre pixels no upscaling. Corrige o texto do Wild Arms e o fantasma do SoulCalibur."

msgctxt "game_options"
msgid "Lower values reduce audio delay, higher values reduce crackling."
msgstr "Valores menores reduzem o atraso de áudio; valores maiores reduzem os estalos."

msgctxt "game_options"
msgid "MSAA or SSAA level."
msgstr "Nível de MSAA ou SSAA."

msgctxt "game_options"
msgid "Machine timing. 60Hz is the American machine, 50Hz the European one. A few European programs need 50Hz to run at the right speed. Changing this reboots the machine."
msgstr "Temporização da máquina. 60Hz é a máquina americana, 50Hz a europeia. Alguns programas europeus precisam de 50Hz para correr na velocidade certa. Alterar isto reinicia a máquina."

msgctxt "game_options"
msgid "Main memory. Auto uses the model RAM or the game database. Unsupported sizes round up to the model's next size."
msgstr "Memória principal. Auto usa a RAM do modelo ou a base de dados de jogos. Tamanhos não suportados são arredondados para o próximo tamanho do modelo."

msgctxt "game_options"
msgid "Make warp mode much faster by changing SID emulation to 'FastSID' while warping."
msgstr "Torna o modo warp muito mais rápido ao trocar a emulação do SID para 'FastSID' durante o warp."

msgctxt "game_options"
msgid "Makes the emulator auto fast forward CD loading sequences."
msgstr "Faz o emulador avançar automaticamente as sequências de carregamento do CD."

msgctxt "game_options"
msgid "Manually assign the pad used by the player. Only needed when RetroBat cannot tell two identical pads apart, for example with a 2-players arcade encoder seen by Windows as a single device. Leave on AUTO otherwise."
msgstr "Atribui manualmente o comando usado pelo jogador. Necessário apenas quando o RetroBat não consegue distinguir dois comandos idênticos, por exemplo com um encoder arcade de 2 jogadores visto pelo Windows como um único dispositivo. Caso contrário, deixe em AUTO."

msgctxt "game_options"
msgid "Manually select a 4 Player Adapter for some games"
msgstr "Seleciona manualmente um adaptador para 4 jogadores em alguns jogos."

msgctxt "game_options"
msgid "Manually specify your choice of Neo Geo BIOS."
msgstr "Especifica manualmente a BIOS do Neo Geo."

msgctxt "game_options"
msgid "Many games need copies to textures only, but if you're seeing blacked out or missing graphics, you might need to choose copies to RAM."
msgstr "Muitos jogos precisam apenas de cópias para texturas, mas se aparecerem gráficos pretos ou ausentes, pode ser necessário escolher cópias para a RAM."

msgctxt "game_options"
msgid "Map an 8BitDo M30 or similar pad button for button, from mdControllers.json."
msgstr "Mapeia um 8BitDo M30 ou comando similar botão a botão, a partir do mdControllers.json."

msgctxt "game_options"
msgid "Map controller to Racing Controller, games that were not compatible with Racing Wheel will not work."
msgstr "Mapeia o comando como Racing Controller; jogos que não eram compatíveis com o Racing Wheel não funcionarão."

msgctxt "game_options"
msgid "Map select to an additional button, useful for Zelda game to avoid quitting when saving."
msgstr "Mapeia select num botão adicional; útil nos jogos de Zelda para não sair ao guardar."

msgctxt "game_options"
msgid "Maps the triggers to the analog stick vertical axis. Useful for Gran Turismo and other racing games."
msgstr "Mapeia os gatilhos no eixo vertical do analógico. Útil para Gran Turismo e outros jogos de corrida."

msgctxt "game_options"
msgid "Matches colors to how they look on real hardware."
msgstr "Reproduz as cores como aparecem no hardware real."

msgctxt "game_options"
msgid "Maths coprocessor. Only a handful of Amiga titles use one, and adding it to a machine that never had it can confuse a few games."
msgstr "Coprocessador matemático. Só alguns títulos de Amiga usam um, e adicioná-lo a uma máquina que nunca teve pode confundir alguns jogos."

msgctxt "game_options"
msgid "Max speed for the joystick touch cursor."
msgstr "Velocidade máxima do cursor de toque pelo joystick."

msgctxt "game_options"
msgid "Maximum number of CPU threads to use for texture upscaling. Use total number of threads minus 1."
msgstr "Número máximo de threads da CPU para o upscaling de texturas. Use o total de threads menos 1."

msgctxt "game_options"
msgid "May cause artifacts in some games."
msgstr "Pode causar artefactos em alguns jogos."

msgctxt "game_options"
msgid "May improve performance for some high-core processors. May cause slowdown in some situations due to the extra worker thread load."
msgstr "Pode melhorar o desempenho em alguns processadores com muitos núcleos. Pode causar lentidão em algumas situações devido à carga extra da thread de trabalho."

msgctxt "game_options"
msgid "May reduce stuttering at the cost of longer delay to start a game."
msgstr "Pode reduzir soluços em troca de uma espera maior ao iniciar um jogo."

msgctxt "game_options"
msgid "Method used for interlaced video modes (not applied to Nintendo 64)."
msgstr "Método usado para os modos de vídeo entrelaçados (não aplicado ao Nintendo 64)."

msgctxt "game_options"
msgid "Method used for interlaced video modes."
msgstr "Método usado para os modos de vídeo entrelaçados."

msgctxt "game_options"
msgid "Method used to read data from the disk, sync mimics original hardware, async can reduce stuttering, pre-cache loads full image at the cost of initial delay."
msgstr "Método usado para ler os dados do disco: síncrono imita o hardware original, assíncrono pode reduzir soluços, pré-cache carrega a imagem inteira em troca de um atraso inicial."

msgctxt "game_options"
msgid "Might fix some misaligned fog, bloom or blend effect."
msgstr "Pode corrigir alguns efeitos de nevoeiro, bloom ou mistura desalinhados."

msgctxt "game_options"
msgid "Mimics some famiclones that swap the duty cycles of the square channels."
msgstr "Imita alguns famiclones que trocam os ciclos de trabalho dos canais de onda quadrada."

msgctxt "game_options"
msgid "Mimics the display characteristics of the Game Gear and Nomad LCD panels."
msgstr "Imita as características de exibição dos ecrãs LCD do Game Gear e do Nomad."

msgctxt "game_options"
msgid "Mipmapping is necessary for some games."
msgstr "O mipmapping é necessário para alguns jogos."

msgctxt "game_options"
msgid "Mirror the world horizontally, like the Wii version of the game."
msgstr "Espelha o mundo horizontalmente, como na versão de Wii do jogo."

msgctxt "game_options"
msgid "Mockingboard C is the sound card supported by most games. Pick Mouse Card only for software that needs a real Apple mouse, it replaces the sound card. Changing this reboots the machine."
msgstr "Mockingboard C é a placa de som suportada pela maioria dos jogos. Escolha Mouse Card apenas para software que precise de um rato Apple real; substitui a placa de som. Alterar isto reinicia a máquina."

msgctxt "game_options"
msgid "Mockingboard is the sound card supported by most games. Ignored on the //c models, which have no expansion slots."
msgstr "Mockingboard é a placa de som suportada pela maioria dos jogos. Ignorada nos modelos //c, que não têm slots de expansão."

msgctxt "game_options"
msgid "Mode preselected on the player selection screen. Download Play needs the original BIOS and firmware."
msgstr "Modo pré-selecionado no ecrã de seleção de jogadores. O Download Play requer a BIOS e o firmware originais."

msgctxt "game_options"
msgid "Modify the coin setting to Free Play."
msgstr "Altera a configuração de fichas para Free Play."

msgctxt "game_options"
msgid "Monochrome is required by high resolution games (640x400)."
msgstr "O monocromático é exigido por jogos em alta resolução (640x400)."

msgctxt "game_options"
msgid "More accurate CD block emulation. Requires a CD block ROM and disables the read speed setting."
msgstr "Emulação mais precisa do CD block. Requer uma ROM do CD block e desativa a configuração de velocidade de leitura."

msgctxt "game_options"
msgid "More accurate behavior but may cause lower performance. ON by default."
msgstr "Comportamento mais preciso, mas pode reduzir o desempenho. LIGADO por predefinição."

msgctxt "game_options"
msgid "Most games use port 2, use this setting for the old games that require joystick to be plugged in port 1."
msgstr "A maioria dos jogos usa a porta 2; use esta configuração nos jogos antigos que exigem o joystick na porta 1."

msgctxt "game_options"
msgid "Mount automatically drive C: at startup."
msgstr "Monta a unidade C: automaticamente no arranque."

msgctxt "game_options"
msgid "Mouse: games such as Elansar or Defender of the Crown. Analog stick: BattleSphere, also select it in the game options."
msgstr "Rato: jogos como Elansar ou Defender of the Crown. Analógico: BattleSphere; selecione também nas opções do jogo."

msgctxt "game_options"
msgid "Move the mouse with an analog stick of controller 1 (L2/R2 = buttons). A port must be set to Mouse."
msgstr "Move o rato com um analógico do comando 1 (L2/R2 = botões). Uma porta deve estar em Rato."

msgctxt "game_options"
msgid "Move with the left analog stick as well as the D-pad. On by default."
msgstr "Movimento com o analógico esquerdo além do direcional. Ligado por predefinição."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level."
msgstr "Nível de anti-aliasing por multiamostragem (MSAA)."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. OpenGL only."
msgstr "Nível de anti-aliasing por multiamostragem (MSAA). Apenas OpenGL."

msgctxt "game_options"
msgid "Multi-Sampling Anti Aliasing level. Vulkan only."
msgstr "Nível de anti-aliasing por multiamostragem (MSAA). Apenas Vulkan."

msgctxt "game_options"
msgid "Multiplier applied to the joystick cursor speed while the Speedup Pointer button (L2 by default) is held."
msgstr "Multiplicador aplicado à velocidade do cursor pelo joystick enquanto o botão de acelerar ponteiro (L2 por predefinição) é segurado."

msgctxt "game_options"
msgid "Multitap must be set if more than 2 players intend to play."
msgstr "O multitap deve ser definido se mais de 2 jogadores forem jogar."

msgctxt "game_options"
msgid "Mute the mechanical noise of the floppy drives."
msgstr "Silencia o ruído mecânico das unidades de disquete."

msgctxt "game_options"
msgid "NO shows the left eye image only. Anaglyph needs 3D glasses of the same colors, side by side is for VR headsets and 3D displays."
msgstr "NÃO mostra apenas a imagem do olho esquerdo. Anáglifo requer óculos 3D das mesmas cores; lado a lado é para headsets VR e ecrãs 3D."

msgctxt "game_options"
msgid "NTSC uses cdi200.rom, PAL uses cdi220b.rom."
msgstr "NTSC usa cdi200.rom, PAL usa cdi220b.rom."

msgctxt "game_options"
msgid "Native resolution of the game. By default, the one set in the game."
msgstr "Resolução nativa do jogo. Por predefinição, a definida no jogo."

msgctxt "game_options"
msgid "Needed by a few games, including several point and click titles."
msgstr "Necessário para alguns jogos, incluindo vários de apontar e clicar."

msgctxt "game_options"
msgid "No coin needed to start a game."
msgstr "Não é preciso ficha para iniciar uma partida."

msgctxt "game_options"
msgid "Number of emulated floppy drives. A real Amiga 500 had only one. Two drives speed up multi-disk games but a few titles only expect one."
msgstr "Número de unidades de disquete emuladas. Um Amiga 500 real tinha apenas uma. Duas unidades aceleram jogos com vários discos, mas alguns títulos esperam apenas uma."

msgctxt "game_options"
msgid "Number of frames between each turbo press."
msgstr "Número de fotogramas entre cada acionamento do turbo."

msgctxt "game_options"
msgid "Off by default. Adaptive does not wait for the display when a frame is late."
msgstr "Desligado por predefinição. Adaptativo não espera pelo ecrã quando um fotograma atrasa."

msgctxt "game_options"
msgid "Off by default: the emulator runs at the arcade speed (57.5 Hz) by itself. Turn on if the picture tears."
msgstr "Desligado por predefinição: o emulador corre sozinho à velocidade do arcade (57,5 Hz). Ligue se a imagem apresentar tearing."

msgctxt "game_options"
msgid "Offset for the ST/UV texture coordinates."
msgstr "Deslocamento das coordenadas de textura ST/UV."

msgctxt "game_options"
msgid "On a 120Hz or faster monitor without G-Sync or FreeSync, use its highest refresh rate that is a multiple of 60Hz."
msgstr "Num monitor de 120Hz ou mais sem G-SYNC ou FreeSync, use a sua taxa de atualização mais alta que seja múltipla de 60Hz."

msgctxt "game_options"
msgid "On by default, switch off to use 11khz sound quality."
msgstr "Ligado por predefinição; desligue para usar qualidade de som de 11khz."

msgctxt "game_options"
msgid "On by default."
msgstr "Ligado por predefinição."

msgctxt "game_options"
msgid "On by default. Turn off to gain speed on integrated graphics cards."
msgstr "Ligado por predefinição. Desligue para ganhar velocidade em placas gráficas integradas."

msgctxt "game_options"
msgid "On by default. Turn off when the gun has its own aiming (laser, Sinden crosshair)."
msgstr "Ligado por predefinição. Desligue quando a pistola tiver mira própria (laser, mira Sinden)."

msgctxt "game_options"
msgid "One pixel per game pixel (recommended for shaders)."
msgstr "Um pixel por pixel do jogo (recomendado para shaders)."

msgctxt "game_options"
msgid "Only applies when texture upscaling (xBRZ) is enabled. Textures larger than this will not be upscaled."
msgstr "Aplica-se apenas quando o upscaling de texturas (xBRZ) está ativado. Texturas maiores que isto não serão ampliadas."

msgctxt "game_options"
msgid "Only compatible with ASIA/JAPAN MVS system."
msgstr "Compatível apenas com o sistema MVS ÁSIA/JAPÃO."

msgctxt "game_options"
msgid "Only compatible with OpenGL, hard-sync GPU and CPU. Reduce latency at the cost of increased performance requirements."
msgstr "Compatível apenas com OpenGL; sincroniza rigidamente GPU e CPU. Reduz a latência com maiores requisitos de desempenho."

msgctxt "game_options"
msgid "Only compatible with Software video driver."
msgstr "Compatível apenas com o driver de vídeo Software."

msgctxt "game_options"
msgid "Only effective when LIMIT FPS is enabled. Default: 60."
msgstr "Efetivo apenas quando LIMITAR FPS está ativado. Predefinição: 60."

msgctxt "game_options"
msgid "Only for Asian versions of the games."
msgstr "Apenas para as versões asiáticas dos jogos."

msgctxt "game_options"
msgid "Only for recent Ikemen GO versions. Vulkan is experimental."
msgstr "Apenas para versões recentes do Ikemen GO. Vulkan é experimental."

msgctxt "game_options"
msgid "Only framebuffer greater than this size will be upscaled, can fix some issues in certain games."
msgstr "Apenas framebuffers maiores que este tamanho serão ampliados; pode corrigir alguns problemas em certos jogos."

msgctxt "game_options"
msgid "Only use framelimiter if a game runs too fast without it. Some games may crash if the framerate is too high. If that happens, set value to anything other than Off."
msgstr "Use o limitador de fotogramas apenas se um jogo correr rápido demais sem ele. Alguns jogos podem bloquear se a taxa de fotogramas for alta demais; nesse caso, defina um valor diferente de Desligado."

msgctxt "game_options"
msgid "Only use this if you have two identical controllers and they are not detected correctly. Binds pads by position instead of by name, which is less reliable."
msgstr "Use apenas se tiver dois comandos idênticos que não são detetados corretamente. Associa os comandos pela posição em vez do nome, o que é menos fiável."

msgctxt "game_options"
msgid "Only use this to downscale the window when using upscale in Windows settings."
msgstr "Use apenas para reduzir a janela ao usar ampliação nas configurações do Windows."

msgctxt "game_options"
msgid "Only used if set — no default crosshair image is assumed for P2."
msgstr "Usado apenas se definido; nenhuma imagem de mira predefinida é assumida para o J2."

msgctxt "game_options"
msgid "Only used when a MIDI output device is selected."
msgstr "Usado apenas quando um dispositivo de saída MIDI é selecionado."

msgctxt "game_options"
msgid "OpenBOR engine version used to run the game. Auto detects it from the game data, or from a [XXXX] build number in the file name as for the OpenBOR standalone."
msgstr "Versão do motor OpenBOR usada para correr o jogo. Auto deteta-a pelos dados do jogo ou por um número de build [XXXX] no nome do ficheiro, como no OpenBOR standalone."

msgctxt "game_options"
msgid "OpenGL is required for shaders and internal resolution."
msgstr "OpenGL é necessário para shaders e resolução interna."

msgctxt "game_options"
msgid "OpenGL only."
msgstr "Apenas OpenGL."

msgctxt "game_options"
msgid "OpenGL only. Fixes a black screen on some AMD integrated GPUs, a few games will render incorrectly."
msgstr "Apenas OpenGL. Corrige um ecrã preto em algumas GPUs integradas AMD; alguns jogos serão renderizados incorretamente."

msgctxt "game_options"
msgid "Opens a second window for the Gamepad view."
msgstr "Abre uma segunda janela para a visão do GamePad."

msgctxt "game_options"
msgid "Optional sound board (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) or woofer (Gaelco games). Mix by default, main board only for Star Wars Racer Arcade."
msgstr "Placa de som opcional (Planet Harriers, NASCAR Arcade, Star Wars Racer Arcade) ou subwoofer (jogos Gaelco). Mistura por predefinição; apenas placa principal para Star Wars Racer Arcade."

msgctxt "game_options"
msgid "Overclock CPU, SA-1 chip and Super-FX chip, can reduce slowdowns but might generate issues with some games."
msgstr "Overclock da CPU e dos chips SA-1 e Super FX; pode reduzir lentidões, mas pode gerar problemas em alguns jogos."

msgctxt "game_options"
msgid "Overclock or underclock both SH-2 CPUs. 100 is stock speed."
msgstr "Overclock ou underclock das duas CPUs SH-2. 100 é a velocidade original."

msgctxt "game_options"
msgid "Overclock or underclock the emulated main CPU. Can help stabilize the framerate, but breaks some games."
msgstr "Overclock ou underclock da CPU principal emulada. Pode ajudar a estabilizar a taxa de fotogramas, mas quebra alguns jogos."

msgctxt "game_options"
msgid "Overclock the emulated 68k chip for better framerate."
msgstr "Overclock do chip 68k emulado para uma taxa de fotogramas melhor."

msgctxt "game_options"
msgid "Override RetroBat gamepad mapping with user own mapping placed in emulator script folder."
msgstr "Substitui o mapeamento de gamepad do RetroBat pelo mapeamento do próprio utilizador colocado na pasta de scripts do emulador."

msgctxt "game_options"
msgid "Override table default lighting."
msgstr "Substitui a iluminação predefinida da mesa."

msgctxt "game_options"
msgid "PAL runs at 50 Hz and is correct for almost every European Amiga title. NTSC runs at 60 Hz and suits a handful of American releases."
msgstr "PAL corre a 50 Hz e é o correto para quase todos os títulos europeus de Amiga. NTSC corre a 60 Hz e serve para alguns lançamentos americanos."

msgctxt "game_options"
msgid "POM2 identifies controllers by its own slot number, which does not follow the RetroBat player order. Automatic takes the first one it finds, change it if the wrong controller responds."
msgstr "O POM2 identifica os comandos pelo próprio número de slot, que não segue a ordem de jogadores do RetroBat. Automático apanha o primeiro que encontrar; altere se o comando errado responder."

msgctxt "game_options"
msgid "Patch TOS file to boot faster."
msgstr "Aplica patch no ficheiro TOS para iniciar mais rápido."

msgctxt "game_options"
msgid "Path to the folder where AGS WinUAE is located, if filled RetroBat will add ags launcher to amiga system."
msgstr "Caminho da pasta onde está o AGS WinUAE; se preenchido, o RetroBat adiciona o iniciador AGS ao sistema amiga."

msgctxt "game_options"
msgid "Path to the folder where ExoDos is located, mandatory for RetroBat to be able to scan ExoDOS games."
msgstr "Caminho da pasta onde está o ExoDOS; obrigatório para que o RetroBat possa procurar os jogos ExoDOS."

msgctxt "game_options"
msgid "Path to the folder where ExoWin3x is located, mandatory for RetroBat to be able to scan ExoWin3x games."
msgstr "Caminho da pasta onde está o ExoWin3x; obrigatório para que o RetroBat possa procurar os jogos ExoWin3x."

msgctxt "game_options"
msgid "Path to the folder where ExoWin9x is located, mandatory for RetroBat to be able to scan ExoWin9x games."
msgstr "Caminho da pasta onde está o ExoWin9x; obrigatório para que o RetroBat possa procurar os jogos ExoWin9x."

msgctxt "game_options"
msgid "Per game: each game has its own 8 KB console memory, so it can never be full. Shared: one memory for all the games, as on a real player."
msgstr "Por jogo: cada jogo tem a sua própria memória de consola de 8 KB, que nunca enche. Partilhada: uma memória para todos os jogos, como num aparelho real."

msgctxt "game_options"
msgid "Per-pixel instead of per-vertex lighting. Improves quality in some games."
msgstr "Iluminação por pixel em vez de por vértice. Melhora a qualidade em alguns jogos."

msgctxt "game_options"
msgid "Performance boost, can also bring stability for some games like GT6."
msgstr "Ganho de desempenho; também pode trazer estabilidade a alguns jogos como GT6."

msgctxt "game_options"
msgid "Place a custom crosshair image and select it below."
msgstr "Coloque uma imagem de mira personalizada e selecione-a abaixo."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator or select file below."
msgstr "Coloque um ficheiro 'crosshair.png' personalizado na subpasta 'cross' do emulador ou selecione um ficheiro abaixo."

msgctxt "game_options"
msgid "Place custom 'crosshair.png' file in 'cross' subfolder of the emulator."
msgstr "Coloque um ficheiro 'crosshair.png' personalizado na subpasta 'cross' do emulador."

msgctxt "game_options"
msgid "Planet Harriers: push the stick up to climb (the cabinet climbs with the stick pulled back)."
msgstr "Planet Harriers: empurre o analógico para cima para subir (na cabine, sobe-se a puxar o manche para trás)."

msgctxt "game_options"
msgid "Play MVS games without the need to insert coins."
msgstr "Joga jogos MVS sem precisar de inserir fichas."

msgctxt "game_options"
msgid "Play a warning beep when health is low."
msgstr "Toca um bip de aviso quando a vida está baixa."

msgctxt "game_options"
msgid "Play the VMU beeps."
msgstr "Toca os bips da VMU."

msgctxt "game_options"
msgid "Play with real wiimotes only, other controllers will not work."
msgstr "Joga apenas com Wiimotes reais; os outros comandos não funcionarão."

msgctxt "game_options"
msgid "Player count preselected on the player selection screen shown at launch."
msgstr "Número de jogadores pré-selecionado no ecrã de seleção de jogadores mostrado ao iniciar."

msgctxt "game_options"
msgid "Plug RetroPads in different ports, useful for 4-player adapters."
msgstr "Conecta RetroPads em portas diferentes; útil para adaptadores de 4 jogadores."

msgctxt "game_options"
msgid "Plug a mouse in joyport, this will remove plugged joysticks."
msgstr "Conecta um rato na porta de joystick; isso remove os joysticks conectados."

msgctxt "game_options"
msgid "Plug additional joysticks in ports 2, 3 and 4."
msgstr "Conecta joysticks adicionais nas portas 2, 3 e 4."

msgctxt "game_options"
msgid "Plug the GunCon in port 2, to use for Die Hard Trilogy."
msgstr "Conecta a GunCon na porta 2, para usar no Die Hard Trilogy."

msgctxt "game_options"
msgid "Plugs a MIDI board and sends its output to this Windows MIDI device, numbered as in the emulator MIDI options. NONE keeps the standard FM sound."
msgstr "Liga uma placa MIDI e envia a sua saída para este dispositivo MIDI do Windows, numerado como nas opções MIDI do emulador. NENHUM mantém o som FM padrão."

msgctxt "game_options"
msgid "Point RetroArch 'system' directory to a different folder."
msgstr "Aponta a pasta 'system' do RetroArch para outra pasta."

msgctxt "game_options"
msgid "Port 1 is always the Wii U GamePad. A Wii Remote can be added on top of it for games that need one."
msgstr "A porta 1 é sempre o Wii U GamePad. Pode ser adicionado um Wii Remote para os jogos que precisam de um."

msgctxt "game_options"
msgid "Port of the Light Phaser. Port 1 by default."
msgstr "Porta da Light Phaser. Porta 1 por predefinição."

msgctxt "game_options"
msgid "Port of the Super Scope. Port 2 by default."
msgstr "Porta do Super Scope. Porta 2 por predefinição."

msgctxt "game_options"
msgid "Port of the Zapper. Port 2 by default."
msgstr "Porta da Zapper. Porta 2 por predefinição."

msgctxt "game_options"
msgid "Potentially decrease loading time at the cost of increased startup time."
msgstr "Pode reduzir o tempo de carregamento em troca de um arranque mais longo."

msgctxt "game_options"
msgid "PowerPC recompiler, on by default and much faster. Turn off for the interpreter."
msgstr "Recompilador PowerPC, ligado por predefinição e muito mais rápido. Desligue para usar o interpretador."

msgctxt "game_options"
msgid "Pre-compile shader cache at game startup, leave ON for less stuttering in game."
msgstr "Pré-compila o cache de shaders ao iniciar o jogo; deixe LIGADO para menos soluços no jogo."

msgctxt "game_options"
msgid "Precise is the most accurate and relaxed can increase performance but break some games."
msgstr "Preciso é o mais exato; relaxado pode aumentar o desempenho, mas quebrar alguns jogos."

msgctxt "game_options"
msgid "Preferred region. A game that does not accept it falls back to one it does."
msgstr "Região preferida. Um jogo que não a aceita recorre a uma que aceite."

msgctxt "game_options"
msgid "Preload all CD tracks into RAM."
msgstr "Pré-carrega todas as faixas do CD na RAM."

msgctxt "game_options"
msgid "Preload custom textures on startup."
msgstr "Pré-carrega as texturas personalizadas ao iniciar."

msgctxt "game_options"
msgid "Pressed to open Amiberry's menu."
msgstr "Premido para abrir o menu do Amiberry."

msgctxt "game_options"
msgid "Pressed to reset the Amiga."
msgstr "Premido para reiniciar (reset) o Amiga."

msgctxt "game_options"
msgid "Pressed to show the on-screen keyboard."
msgstr "Premido para mostrar o teclado no ecrã."

msgctxt "game_options"
msgid "Prevents some artifacts but can result in hard edges."
msgstr "Evita alguns artefactos, mas pode gerar bordas duras."

msgctxt "game_options"
msgid "Prevents the mixed sound of several players from saturating."
msgstr "Evita que o som misturado de vários jogadores sature."

msgctxt "game_options"
msgid "Processor model."
msgstr "Modelo do processador."

msgctxt "game_options"
msgid "Processor model. A faster CPU than the real machine can break games that rely on precise timing."
msgstr "Modelo do processador. Uma CPU mais rápida que a da máquina real pode quebrar jogos que dependem de temporização precisa."

msgctxt "game_options"
msgid "Provider for the Adlib emulation. DEFAULT has good quality and low perf requirements."
msgstr "Provedor da emulação AdLib. PREDEFINIÇÃO tem boa qualidade e baixos requisitos de desempenho."

msgctxt "game_options"
msgid "Puts player 1's pad in port 1 instead of port 2. Needed by a few games, including several point and click titles."
msgstr "Coloca o comando do jogador 1 na porta 1 em vez da porta 2. Necessário para alguns jogos, incluindo vários de apontar e clicar."

msgctxt "game_options"
msgid "Quality of life tweaks: quick transform, bigger wallets, fast climbing, instant saves, autosave, improved map menus... Classic matches the GameCube game. Not set: Dusklight menu settings are kept."
msgstr "Ajustes de comodidade: transformação rápida, carteiras maiores, escalada rápida, gravação instantânea, gravação automática, menus de mapa melhorados... Clássico corresponde ao jogo de GameCube. Não definido: as configurações do menu do Dusklight são mantidas."

msgctxt "game_options"
msgid "RETROPAD AS KEYBOARD: the d-pad sends the arrow keys and the buttons SPACE / RETURN, for games without joystick support."
msgstr "RETROPAD COMO TECLADO: o direcional envia as setas e os botões ESPAÇO / ENTER, para jogos sem suporte a joystick."

msgctxt "game_options"
msgid "RUN by default, use run button to walk."
msgstr "CORRER por predefinição; use o botão de correr para andar."

msgctxt "game_options"
msgid "ReShade is used by RetroBat to display bezels and shaders in some standalone emulators. DISABLED: bezels are shown with an overlay window instead. USE MY OWN: RetroBat never installs, modifies or deletes ReShade files in emulator folders."
msgstr "O ReShade é usado pelo RetroBat para exibir molduras e shaders em alguns emuladores standalone. DESATIVADO: as molduras são mostrados com uma janela de sobreposição. USAR O MEU: o RetroBat nunca instala, modifica ou elimina os ficheiros do ReShade nas pastas dos emuladores."

msgctxt "game_options"
msgid "Read render-to-texture results on the CPU. This may be needed in some games but causes mid-frame synchronization, so it has a huge performance impact."
msgstr "Lê os resultados de render-to-texture na CPU. Pode ser necessário em alguns jogos, mas causa sincronização no meio do fotograma, com grande impacto no desempenho."

msgctxt "game_options"
msgid "Read the disc faster than the console's drive. Some games may not expect it."
msgstr "Lê o disco mais rápido que a unidade da consola. Alguns jogos podem não contar com isso."

msgctxt "game_options"
msgid "Read the ini file in 'bios' subfolder."
msgstr "Lê o ficheiro ini na subpasta 'bios'."

msgctxt "game_options"
msgid "Read the ini file in 'bios\mame\ini' folder."
msgstr "Lê o ficheiro ini na pasta 'bios\mame\ini'."

msgctxt "game_options"
msgid "Real Amiga speed is the safe default. Turbo loads faster but can break a few loaders and copy protections."
msgstr "A velocidade real do Amiga é a predefinição segura. Turbo carrega mais rápido, mas pode quebrar alguns loaders e proteções contra cópia."

msgctxt "game_options"
msgid "Reality Signal Processor plugin, forced to LLE when video driver is set to Parallel."
msgstr "Plugin do Reality Signal Processor, forçado para LLE quando o driver de vídeo está em Parallel."

msgctxt "game_options"
msgid "Reality Signal Processor plugin."
msgstr "Plugin do Reality Signal Processor."

msgctxt "game_options"
msgid "Recommended: Linear when Secondary Screen Scale is below 100%."
msgstr "Recomendado: Linear quando a escala do ecrã secundário estiver abaixo de 100%."

msgctxt "game_options"
msgid "Recompiler is fastest, Interpreter is more accurate."
msgstr "O recompilador é o mais rápido; o interpretador é mais preciso."

msgctxt "game_options"
msgid "Recompiler is much faster, interpreter is only useful for debugging. Requires a restart."
msgstr "O recompilador é muito mais rápido; o interpretador só é útil para depuração. Requer reinício."

msgctxt "game_options"
msgid "Recover significant color depth."
msgstr "Recupera uma profundidade de cor significativa."

msgctxt "game_options"
msgid "Reduce accuracy for better performance, graphics quality will be lower."
msgstr "Reduz a precisão para melhor desempenho; a qualidade gráfica será menor."

msgctxt "game_options"
msgid "Reduce analog controls speed, some games require low values to be playable."
msgstr "Reduz a velocidade dos controlos analógicos; alguns jogos precisam de valores baixos para serem jogáveis."

msgctxt "game_options"
msgid "Reduce loading times. Can break a few games that rely on real disc timings."
msgstr "Reduz os tempos de carregamento. Pode quebrar alguns jogos que dependem das temporizações reais do disco."

msgctxt "game_options"
msgid "Reduce stuttering at the cost of much longer delay to start a game and high GPU usage."
msgstr "Reduz os soluços em troca de uma espera muito maior para iniciar um jogo e alto uso da GPU."

msgctxt "game_options"
msgid "Reduces VRAM usage at the cost of quality, may increase stuttering."
msgstr "Reduz o uso de VRAM em troca de qualidade; pode aumentar os soluços."

msgctxt "game_options"
msgid "Reduces clicks caused by large writes to the DMC channel. Inaccurate, can soften some sampled sounds."
msgstr "Reduz os cliques causados por grandes gravações no canal DMC. Impreciso; pode suavizar alguns sons amostrados."

msgctxt "game_options"
msgid "Reduces crackle and stutter, but may cause a very noticeable reduction in audio quality on slower CPUs, leave AUTO to disable."
msgstr "Reduz estalos e soluços, mas pode reduzir muito a qualidade do áudio em CPUs mais lentas; deixe AUTO para desativar."

msgctxt "game_options"
msgid "Reduces flickering."
msgstr "Reduz a cintilação."

msgctxt "game_options"
msgid "Reduces stuttering and speeds up boot after first boot."
msgstr "Reduz os soluços e acelera o arranque após o primeiro arranque."

msgctxt "game_options"
msgid "Reduces wobbly polygons and texture warping in 3D games."
msgstr "Reduz polígonos tremidos e a deformação de texturas em jogos 3D."

msgctxt "game_options"
msgid "ReelMagic MPEG playback support."
msgstr "Suporte à reprodução MPEG ReelMagic."

msgctxt "game_options"
msgid "Refill the belt with potions from the inventory."
msgstr "Reabastece o cinto com poções do inventário."

msgctxt "game_options"
msgid "Refresh state of memory pages to enable gpu written data. (Use for 'Team Ninja' Games to fix missing character models)."
msgstr "Atualiza o estado das páginas de memória para considerar os dados gravados pela GPU (use nos jogos da Team Ninja para corrigir modelos de personagens ausentes)."

msgctxt "game_options"
msgid "Region of the NEC PAC firmware. Japan: pac-n1.bin or pce-lp1.bin. US: pac-n10.bin."
msgstr "Região do firmware NEC PAC. Japão: pac-n1.bin ou pce-lp1.bin. EUA: pac-n10.bin."

msgctxt "game_options"
msgid "Region picked first on multi-region discs."
msgstr "Região escolhida primeiro em discos multirregião."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 1."
msgstr "Remapeia o esquema dos botões laterais do jogador 1."

msgctxt "game_options"
msgid "Remap the lateral buttons scheme for player 2."
msgstr "Remapeia o esquema dos botões laterais do jogador 2."

msgctxt "game_options"
msgid "Remove n pixels borders at the top and bottom of the screen."
msgstr "Remove bordas de n pixels em cima e em baixo do ecrã."

msgctxt "game_options"
msgid "Remove odd composite green/blue artifacting that appears on real hardware."
msgstr "Remove os estranhos artefactos verdes/azuis do composto que aparecem no hardware real."

msgctxt "game_options"
msgid "Remove the original sprites-per-scanline hardware limit."
msgstr "Remove o limite original de hardware de sprites por scanline."

msgctxt "game_options"
msgid "Remove the side black bars in some cutscenes (ultra-wide screens). Areas outside the original framing may look glitchy."
msgstr "Remove as barras pretas laterais em algumas cenas (ecrãs ultra-panorâmicos). Áreas fora do enquadramento original podem apresentar falhas."

msgctxt "game_options"
msgid "Remove the top and bottom black bars during targeting, aiming, cutscenes and dialogues."
msgstr "Remove as barras pretas superior e inferior ao mirar, apontar, nas cenas e nos diálogos."

msgctxt "game_options"
msgid "Remove the white flash displayed when shooting."
msgstr "Remove o flash branco exibido ao atirar."

msgctxt "game_options"
msgid "Removes one frame of input lag, but doubles system requirements."
msgstr "Remove um fotograma de atraso de entrada, mas duplica os requisitos do sistema."

msgctxt "game_options"
msgid "Removes the black borders around the Amiga picture. Stronger settings cut more, and can clip the edges of a few games."
msgstr "Remove as bordas pretas ao redor da imagem do Amiga. Configurações mais fortes cortam mais e podem cortar as bordas de alguns jogos."

msgctxt "game_options"
msgid "Removes the picture flickering in Hummer."
msgstr "Remove a cintilação da imagem no Hummer."

msgctxt "game_options"
msgid "Removes the white flash shown when the games disable 3D rendering."
msgstr "Remove o flash branco mostrado quando os jogos desativam a renderização 3D."

msgctxt "game_options"
msgid "Render at a multiple of the native N64 resolution. Overrides the internal resolution setting when not OFF."
msgstr "Renderiza num múltiplo da resolução nativa do N64. Substitui a configuração de resolução interna quando não estiver DESLIGADO."

msgctxt "game_options"
msgid "Render gouraud shading at full precision to reduce color banding in 3D games."
msgstr "Renderiza o sombreamento Gouraud em precisão total para reduzir as faixas de cor em jogos 3D."

msgctxt "game_options"
msgid "Render target emulation path to use. rtv/fbo offers better performance, rov/fsi highest accuracy."
msgstr "Caminho de emulação dos render targets a usar. rtv/fbo oferece melhor desempenho; rov/fsi, a maior precisão."

msgctxt "game_options"
msgid "Rendering resolution for vector games."
msgstr "Resolução de renderização dos jogos vetoriais."

msgctxt "game_options"
msgid "Renders in 24-bit colors and removes dithering."
msgstr "Renderiza em cores de 24 bits e remove o dithering."

msgctxt "game_options"
msgid "Replace meshed transparency by real transparency."
msgstr "Substitui a transparência em malha por transparência real."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack (\saves\psp\TEXTURES\%GAMEID%)."
msgstr "Substitui as texturas originais por um pacote de texturas personalizadas (\saves\psp\TEXTURES\%GAMEID%)."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack in 'bios\dc\textures'."
msgstr "Substitui as texturas originais por um pacote de texturas personalizadas em 'bios\dc\textures'."

msgctxt "game_options"
msgid "Replace original textures with custom textures pack."
msgstr "Substitui as texturas originais por um pacote de texturas personalizadas."

msgctxt "game_options"
msgid "Replaces game's sprites by HD pack available in HdPacks bios directory."
msgstr "Substitui os sprites do jogo por um pacote HD disponível na pasta HdPacks da bios."

msgctxt "game_options"
msgid "Replaces post-processing multiple paving sprites by a single fat sprite."
msgstr "Substitui no pós-processamento vários sprites lado a lado por um único sprite grande."

msgctxt "game_options"
msgid "Reproduces the low-pass filter of the real hardware. 'Emulated' follows the machine's own filter switch."
msgstr "Reproduz o filtro passa-baixa do hardware real. 'Emulado' segue o interruptor de filtro da própria máquina."

msgctxt "game_options"
msgid "Request specific slot(s), choose SPECIFIC SLOT option above."
msgstr "Solicita slot(s) específico(s); escolha a opção SLOT ESPECÍFICO (ESCOLHA ABAIXO) acima."

msgctxt "game_options"
msgid "Required by BASIC programs. Uses ATARIBAS.ROM when present, the built-in Altirra BASIC otherwise."
msgstr "Necessário para programas em BASIC. Usa ATARIBAS.ROM quando presente; caso contrário, o Altirra BASIC integrado."

msgctxt "game_options"
msgid "Required for Formula One games."
msgstr "Necessário para jogos de Fórmula 1."

msgctxt "game_options"
msgid "Required for Paper Mario: The Thousand-Year Door."
msgstr "Necessário para Paper Mario: The Thousand-Year Door."

msgctxt "game_options"
msgid "Required for certain games that use hi-res mode to produce transparency effects."
msgstr "Necessário para certos jogos que usam o modo hires para produzir efeitos de transparência."

msgctxt "game_options"
msgid "Required for certain visual effects."
msgstr "Necessário para certos efeitos visuais."

msgctxt "game_options"
msgid "Required for the Rewind hotkey to do anything."
msgstr "Necessário para que a hotkey de rebobinar faça algo."

msgctxt "game_options"
msgid "Required to boot the game without a Cycraft motion cabinet."
msgstr "Necessário para iniciar o jogo sem uma cabine com movimento Cycraft."

msgctxt "game_options"
msgid "Required to fix Def Jam Icon."
msgstr "Necessário para corrigir o Def Jam: Icon."

msgctxt "game_options"
msgid "Required to run some old rom hacks, leave off for commercial games."
msgstr "Necessário para correr alguns rom hacks antigos; deixe desligado para jogos comerciais."

msgctxt "game_options"
msgid "Requires at least '4X SSAA (ORDERED)'. The 4x modes require '16X SSAA (ORDERED)'."
msgstr "Requer pelo menos '4X SSAA (ORDENADO)'. Os modos 4x requerem '16X SSAA (ORDENADO)'."

msgctxt "game_options"
msgid "Resolution of the emulated video output."
msgstr "Resolução da saída de vídeo emulada."

msgctxt "game_options"
msgid "Respect Non-Java Mode bit values for vector ops in PPU backends. If unsure, do not modify this setting. Default off."
msgstr "Respeita os valores do bit Non-Java Mode nas operações vetoriais dos backends da PPU. Em caso de dúvida, não altere. Desligado por predefinição."

msgctxt "game_options"
msgid "Response curve for the joystick touch cursor."
msgstr "Curva de resposta do cursor de toque pelo joystick."

msgctxt "game_options"
msgid "RetroBat will configure only the controller for player 1."
msgstr "O RetroBat configurará apenas o comando do jogador 1."

msgctxt "game_options"
msgid "RetroBat will sync dolphin and libretro-dolphin saves folders."
msgstr "O RetroBat sincronizará as pastas de gravações do dolphin e do libretro-dolphin."

msgctxt "game_options"
msgid "RetroBat will use by default psxonpsp BIOS, enable this option to force usage of legacy SCPH550X bios file."
msgstr "O RetroBat usa por predefinição a BIOS psxonpsp; ative esta opção para forçar o uso do antigo ficheiro de BIOS SCPH550X."

msgctxt "game_options"
msgid "Reuse the shader cache built for the game. Auto lets the emulator decide."
msgstr "Reutiliza o cache de shaders gerado para o jogo. Auto deixa o emulador decidir."

msgctxt "game_options"
msgid "Right stick gear selection in 4-speed racing games. H-gate: diagonals, like a real gearbox. Directions: up 1, down 2, left 3, right 4. L1/R1 always shift down/up."
msgstr "Seleção de mudanças com o analógico direito em jogos de corrida de 4 mudanças. Grelha em H: diagonais, como uma caixa de velocidades real. Direções: cima 1, baixo 2, esquerda 3, direita 4. L1/R1 sempre reduzem/sobem mudança."

msgctxt "game_options"
msgid "Rotate display and controls. By default, known games are rotated automatically. MANUAL: SELECT changes the rotation."
msgstr "Roda o ecrã e os controlos. Por predefinição, os jogos conhecidos são rodados automaticamente. MANUAL: SELECT muda a rotação."

msgctxt "game_options"
msgid "Rotate display for vertical games, to enable for use with mega-bezels."
msgstr "Roda o ecrã em jogos verticais; ativar para uso com mega-bezels."

msgctxt "game_options"
msgid "Rotate display for vertical games."
msgstr "Roda o ecrã em jogos verticais."

msgctxt "game_options"
msgid "Rotate display for vertical screen."
msgstr "Roda o ecrã para um monitor vertical."

msgctxt "game_options"
msgid "Rotate display, this can be useful for specific games that need vertical display."
msgstr "Roda o ecrã; pode ser útil para jogos específicos que precisam de ecrã vertical."

msgctxt "game_options"
msgid "Rotate face buttons to change layout."
msgstr "Roda os botões frontais para mudar o layout."

msgctxt "game_options"
msgid "Rotate the Windows display of the playfield screen while playing, restored on exit (Visual Pinball 10.8 and later)."
msgstr "Roda a exibição do Windows do ecrã do playfield durante o jogo; restaurada ao sair (Visual Pinball 10.8 e posteriores)."

msgctxt "game_options"
msgid "Rotate the output, for vertical shooters."
msgstr "Roda a saída, para jogos de tiro verticais."

msgctxt "game_options"
msgid "Rotation applied at the extremities of a swing."
msgstr "Rotação aplicada nos extremos de um balanço."

msgctxt "game_options"
msgid "Run at maximum speed while a CD-ROM game loads on a still, silent screen."
msgstr "Corre à velocidade máxima enquanto um jogo de CD-ROM carrega num ecrã parado e silencioso."

msgctxt "game_options"
msgid "Run at maximum speed while a disk or a tape is loading, when no sound is played. TRUE DRIVE EMULATION is required for disks."
msgstr "Corre à velocidade máxima enquanto um disco ou uma cassete carrega, quando nenhum som está a tocar. EMULAÇÃO REAL DA UNIDADE é necessária para discos."

msgctxt "game_options"
msgid "Run at the original 57.524 Hz instead of 60 Hz. Can stutter on a 60 Hz screen."
msgstr "Corre nos 57,524 Hz originais em vez de 60 Hz. Pode ter soluços num ecrã de 60 Hz."

msgctxt "game_options"
msgid "Run by default, the run button walks. Enabled by default."
msgstr "Corre por predefinição; o botão de correr faz andar. Ativado por predefinição."

msgctxt "game_options"
msgid "Run by default, the run button walks. Uses stamina in single player."
msgstr "Corre por predefinição; o botão de correr faz andar. Consome estamina no modo um jogador."

msgctxt "game_options"
msgid "Run games faster. A powerful option for gaining performance that has no downsides some of the time. May cause various random issues caused by splitting the CPU and GPU threads onto different cores."
msgstr "Faz os jogos correrem mais rápido. Uma opção poderosa para ganhar desempenho que muitas vezes não tem desvantagens. Pode causar vários problemas aleatórios por dividir as threads de CPU e GPU em núcleos diferentes."

msgctxt "game_options"
msgid "Run system with G7400 BIOS and features."
msgstr "Executa o sistema com a BIOS e os recursos do G7400."

msgctxt "game_options"
msgid "Run the GPU and DSP faster. Can raise the framerate of 3D games, but may cause glitches."
msgstr "Faz a GPU e o DSP correrem mais rápido. Pode aumentar a taxa de fotogramas dos jogos 3D, mas pode causar falhas."

msgctxt "game_options"
msgid "Run two linked Game Gears side by side. Players 1 and 2 control screens 1 and 2."
msgstr "Executa dois Game Gears conectados lado a lado. Os jogadores 1 e 2 controlam os ecrãs 1 e 2."

msgctxt "game_options"
msgid "Run without holding the run button."
msgstr "Corre sem segurar o botão de correr."

msgctxt "game_options"
msgid "Runs 'jgenesis-gui.exe' instead of cli version."
msgstr "Executa 'jgenesis-gui.exe' em vez da versão cli."

msgctxt "game_options"
msgid "SDL gamepad by default, it reads gamepads with the standard layout and the other devices (wheels, shifters, arcade encoders) with their raw buttons. SDL reads every device raw."
msgstr "SDL gamepad por predefinição: lê os gamepads com o layout padrão e os outros dispositivos (volantes, alavancas de mudanças, encoders arcade) com os seus botões brutos. SDL lê todos os dispositivos em modo bruto."

msgctxt "game_options"
msgid "SOUNDFONT uses the Roland SC-55 soundfont shipped with RetroBat."
msgstr "SOUNDFONT usa o soundfont Roland SC-55 incluído no RetroBat."

msgctxt "game_options"
msgid "SSAA offers better quality at the cost of performance."
msgstr "SSAA oferece melhor qualidade em troca de desempenho."

msgctxt "game_options"
msgid "STRETCH fills the whole screen and disables bezels."
msgstr "ESTICAR preenche o ecrã inteiro e desativa as molduras."

msgctxt "game_options"
msgid "Save the game state when leaving and restore it at next launch (one file per game)."
msgstr "Guarda o estado do jogo ao sair e restaura-o no próximo arranque (um ficheiro por jogo)."

msgctxt "game_options"
msgid "Saves go to a copy in the saves folder, the original image is never modified. Reset restarts from the original disk (old copy kept as .bak)."
msgstr "As gravações vão para uma cópia na pasta saves; a imagem original nunca é modificada. Reiniciar recomeça do disco original (a cópia antiga é mantida como .bak)."

msgctxt "game_options"
msgid "Saves the hiscores in supported games."
msgstr "Guarda os recordes nos jogos compatíveis."

msgctxt "game_options"
msgid "Scale of the on-screen status line."
msgstr "Escala da linha de estado no ecrã."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels."
msgstr "Escala a imagem apenas por números inteiros, para pixels nítidos."

msgctxt "game_options"
msgid "Scale the picture by whole numbers only, for sharp pixels. Fullscreen 1080p or 4K on a 16:9 screen only, with a slight crop at the top and the bottom."
msgstr "Escala a imagem apenas por números inteiros, para pixels nítidos. Apenas em ecrã inteiro 1080p ou 4K num ecrã 16:9, com um leve corte em cima e em baixo."

msgctxt "game_options"
msgid "Scales X coordinates relative to the center of the screen. Lower this if shots land too far from the crosshair on the edges."
msgstr "Escala as coordenadas X em relação ao centro do ecrã. Reduza se os tiros caírem longe demais da mira nas bordas."

msgctxt "game_options"
msgid "Scales the dithern pattern to the resolution scale of the emulated GPU."
msgstr "Escala o padrão de dithering para a escala de resolução da GPU emulada."

msgctxt "game_options"
msgid "Scanlines are not compatible with HQ or xBRZ shaders."
msgstr "As scanlines não são compatíveis com os shaders HQ ou xBRZ."

msgctxt "game_options"
msgid "Scanlines, shadow mask and phosphor glow of a cathode ray tube."
msgstr "Scanlines, máscara de sombra e brilho do fósforo de um tubo de raios catódicos."

msgctxt "game_options"
msgid "Screen rotation is not compatible with horizontal layout."
msgstr "A rotação do ecrã não é compatível com a disposição horizontal."

msgctxt "game_options"
msgid "Screen used for the DMD on a dedicated screen, same numbering as MONITOR INDEX. AUTO uses the smallest remaining screen. Requires SCREEN SETUP with 3 screens."
msgstr "Ecrã usado para o DMD num ecrã dedicado, mesma numeração do ÍNDICE DO MONITOR. AUTO usa o menor ecrã restante. Requer CONFIGURAÇÃO DOS ECRÃS com 3 ecrãs."

msgctxt "game_options"
msgid "Screen used for the backglass, same numbering as MONITOR INDEX. AUTO uses the largest screen other than the playfield. Requires SCREEN SETUP."
msgstr "Ecrã usado para o backglass, mesma numeração do ÍNDICE DO MONITOR. AUTO usa o maior ecrã além do playfield. Requer CONFIGURAÇÃO DOS ECRÃS."

msgctxt "game_options"
msgid "Screen used to display games (0 = primary screen). AUTO lets the emulator choose its screen."
msgstr "Ecrã usado para exibir os jogos (0 = ecrã principal). AUTO deixa o emulador escolher o ecrã."

msgctxt "game_options"
msgid "Screens used by the pinball (Visual Pinball 10.8 and later). Backglass and DMD positions are then computed automatically. Not set: SCREENRES values are used."
msgstr "Ecrãs usados pelo pinball (Visual Pinball 10.8 e posteriores). As posições do backglass e do DMD são então calculadas automaticamente. Não definido: são usados os valores do SCREENRES."

msgctxt "game_options"
msgid "Screens used by the pinball. Backglass and DMD positions are then computed automatically. Not set: 1 screen."
msgstr "Ecrãs usados pelo pinball. As posições do backglass e do DMD são então calculadas automaticamente. Não definido: 1 ecrã."

msgctxt "game_options"
msgid "Scribble 0xCD into all allocated heap memory."
msgstr "Escreve 0xCD em toda a memória heap alocada."

msgctxt "game_options"
msgid "Second joystick might conflict with mouse."
msgstr "O segundo joystick pode conflitar com o rato."

msgctxt "game_options"
msgid "Select 'game specific' to use game specific cfg file located in emulators\psxmame\ctrlr folder."
msgstr "Selecione 'específico do jogo' para usar o ficheiro cfg específico do jogo localizado na pasta emulators\psxmame\ctrlr."

msgctxt "game_options"
msgid "Select Amstrad Cathode Ray Tube Controller type."
msgstr "Seleciona o tipo de controlador de tubo de raios catódicos (CRTC) do Amstrad."

msgctxt "game_options"
msgid "Select Amstrad model to emulate."
msgstr "Seleciona o modelo Amstrad a emular."

msgctxt "game_options"
msgid "Select Mouse or Joypad to controls in-game virtual pointer."
msgstr "Selecione Rato ou Joypad para controlar o ponteiro virtual no jogo."

msgctxt "game_options"
msgid "Select NO to disable texture cache."
msgstr "Selecione NÃO para desativar o cache de texturas."

msgctxt "game_options"
msgid "Select a BigPemu shader, only possible when RetroBat shaders is set to 'none'."
msgstr "Seleciona um shader do BigPEmu; possível apenas quando os shaders do RetroBat estão em 'nenhum'."

msgctxt "game_options"
msgid "Select a bilinear filtering method."
msgstr "Seleciona um método de filtragem bilinear."

msgctxt "game_options"
msgid "Select a filter to apply."
msgstr "Seleciona um filtro a aplicar."

msgctxt "game_options"
msgid "Select a shader to apply."
msgstr "Seleciona um shader a aplicar."

msgctxt "game_options"
msgid "Select a video format for output."
msgstr "Seleciona um formato de vídeo de saída."

msgctxt "game_options"
msgid "Select between the different controller layouts."
msgstr "Seleciona entre os diferentes layouts de comando."

msgctxt "game_options"
msgid "Select controller layout to use when using 'Dynamic Profile' option."
msgstr "Seleciona o layout de comando a usar com a opção 'Perfil dinâmico'."

msgctxt "game_options"
msgid "Select corner of the screen where the tattoo will appear."
msgstr "Seleciona o canto do ecrã onde a tatuagem vai aparecer."

msgctxt "game_options"
msgid "Select effect to apply, this has no effect when using shaders."
msgstr "Seleciona o efeito a aplicar; não tem efeito ao usar shaders."

msgctxt "game_options"
msgid "Select face buttons layout."
msgstr "Seleciona o layout dos botões frontais."

msgctxt "game_options"
msgid "Select in which port to introduce the GBA rom, default 2."
msgstr "Seleciona em que porta inserir a ROM de GBA; predefinição: 2."

msgctxt "game_options"
msgid "Select method used to emulate the FM synthetiser."
msgstr "Seleciona o método usado para emular o sintetizador FM."

msgctxt "game_options"
msgid "Select model to emulate."
msgstr "Seleciona o modelo a emular."

msgctxt "game_options"
msgid "Select palette for colorizing GB games when COLORIZATION is set to 'internal'."
msgstr "Seleciona a paleta para colorir os jogos de GB quando COLORIZAÇÃO estiver em 'interna'."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'bgfx' video driver."
msgstr "Seleciona o shader a aplicar; compatível apenas com o driver de vídeo 'bgfx'."

msgctxt "game_options"
msgid "Select shader to apply, only compatible with 'openGL' video driver."
msgstr "Seleciona o shader a aplicar; compatível apenas com o driver de vídeo 'openGL'."

msgctxt "game_options"
msgid "Select shift mode for BattleGear4Tuned."
msgstr "Seleciona o modo de mudanças do BattleGear4Tuned."

msgctxt "game_options"
msgid "Select the GPU plugin, RetroBat options will not work on non-default plugin, they can be configured from emulators folder with config.exe."
msgstr "Seleciona o plugin de GPU; as opções do RetroBat não funcionam com um plugin diferente do predefinido, que pode ser configurado na pasta emulators com o config.exe."

msgctxt "game_options"
msgid "Select the IPL BIOS to run a game depending on its region. Needs 'IPL_JAP.n64', 'IPL_USA.n64' and 'IPL_DEV.n64' in bios\Mupen64plus folder."
msgstr "Seleciona a BIOS IPL para correr um jogo conforme a sua região. Requer 'IPL_JAP.n64', 'IPL_USA.n64' e 'IPL_DEV.n64' na pasta bios\Mupen64plus."

msgctxt "game_options"
msgid "Select the device to read X and Y coordinates."
msgstr "Seleciona o dispositivo que lê as coordenadas X e Y."

msgctxt "game_options"
msgid "Select the driver used for shaders when using bgfx video driver."
msgstr "Seleciona o driver usado para os shaders com o driver de vídeo bgfx."

msgctxt "game_options"
msgid "Select the extension to add to the controller."
msgstr "Seleciona a extensão a adicionar ao comando."

msgctxt "game_options"
msgid "Select the frame presentation mode."
msgstr "Seleciona o modo de apresentação de fotogramas."

msgctxt "game_options"
msgid "Select the graphics plugin used by the emulator. Depends on hardware compatibility."
msgstr "Seleciona o plugin gráfico usado pelo emulador. Depende da compatibilidade do hardware."

msgctxt "game_options"
msgid "Select the keyboard layout."
msgstr "Seleciona o layout do teclado."

msgctxt "game_options"
msgid "Select the lighting model, the legacy mode is the least demanding on the graphic card."
msgstr "Seleciona o modelo de iluminação; o modo legado é o menos exigente para a placa gráfica."

msgctxt "game_options"
msgid "Select the machine to emulate."
msgstr "Seleciona a máquina a emular."

msgctxt "game_options"
msgid "Select the profile to assign to the player."
msgstr "Seleciona o perfil a atribuir ao jogador."

msgctxt "game_options"
msgid "Select the soundfont file or interface used for MIDI output."
msgstr "Seleciona o ficheiro soundfont ou a interface usada para a saída MIDI."

msgctxt "game_options"
msgid "Select the source system for the transfer pack between GB and GBC."
msgstr "Seleciona o sistema de origem do Transfer Pak entre GB e GBC."

msgctxt "game_options"
msgid "Select the type of console."
msgstr "Seleciona o tipo de consola."

msgctxt "game_options"
msgid "Select the type of display framing. Use EMUSCV value to correct original console display bugs."
msgstr "Seleciona o tipo de enquadramento da imagem. Use o valor EMUSCV para corrigir bugs de exibição da consola original."

msgctxt "game_options"
msgid "Select the type of gun depending on the game."
msgstr "Seleciona o tipo de pistola conforme o jogo."

msgctxt "game_options"
msgid "Select video mode (type of cable)."
msgstr "Seleciona o modo de vídeo (tipo de cabo)."

msgctxt "game_options"
msgid "Select where Coin and Start buttons should be mapped when playing with a wheel."
msgstr "Seleciona onde os botões Ficha e Start devem ser mapeados ao jogar com volante."

msgctxt "game_options"
msgid "Select where Test and Service buttons should be mapped when playing with a wheel."
msgstr "Seleciona onde os botões Teste e Serviço devem ser mapeados ao jogar com volante."

msgctxt "game_options"
msgid "Select whether the cross input or the circle input is the confirmation button."
msgstr "Seleciona se o X ou o círculo é o botão de confirmação."

msgctxt "game_options"
msgid "Select which audio engine to use internally."
msgstr "Seleciona qual motor de áudio usar internamente."

msgctxt "game_options"
msgid "Select which color filter to apply."
msgstr "Seleciona qual filtro de cor aplicar."

msgctxt "game_options"
msgid "Select which graphics API to use when using texture renderer."
msgstr "Seleciona qual API gráfica usar com o renderizador de textura."

msgctxt "game_options"
msgid "Select which joystick to emulate (not compatible with MASTER COMPACT)."
msgstr "Seleciona qual joystick emular (não compatível com MASTER COMPACT)."

msgctxt "game_options"
msgid "Select which joystick to emulate."
msgstr "Seleciona qual joystick emular."

msgctxt "game_options"
msgid "Select which screen will be shown when using hybrid layout."
msgstr "Seleciona qual ecrã é mostrado com a disposição híbrida."

msgctxt "game_options"
msgid "Selecting GBA unlocks extra features in certain GBA enhanced GBC games."
msgstr "Selecionar GBA desbloqueia recursos extras em certos jogos de GBC melhorados para GBA."

msgctxt "game_options"
msgid "Send full rom path to MAME instead of just ROM name."
msgstr "Envia ao MAME o caminho completo da ROM em vez de apenas o nome."

msgctxt "game_options"
msgid "Send lamps and drive board outputs to external tools (MAMEHooker...) with Windows messages."
msgstr "Envia as saídas das lâmpadas e da drive board para ferramentas externas (MAMEHooker...) por mensagens do Windows."

msgctxt "game_options"
msgid "Send lamps and gun recoil outputs to external tools (MAMEHooker, DemulShooter...)."
msgstr "Envia as saídas das lâmpadas e do recuo da pistola para ferramentas externas (MAMEHooker, DemulShooter...)."

msgctxt "game_options"
msgid "Send lamps, gun vibration and drive board outputs to external tools (Hook Of The Reaper, QMamehook...) with the MAME network protocol."
msgstr "Envia as saídas das lâmpadas, da vibração da pistola e da drive board para ferramentas externas (Hook Of The Reaper, QMamehook...) pelo protocolo de rede do MAME."

msgctxt "game_options"
msgid "Sensitivity of the emulated spinner controller."
msgstr "Sensibilidade do spinner emulado."

msgctxt "game_options"
msgid "Set a default ISO, to use with some homebrew games."
msgstr "Define uma ISO predefinida, para usar com alguns jogos homebrew."

msgctxt "game_options"
msgid "Set default controller mapping for player 1."
msgstr "Define o mapeamento de comando predefinido do jogador 1."

msgctxt "game_options"
msgid "Set default controller mapping for player 2."
msgstr "Define o mapeamento de comando predefinido do jogador 2."

msgctxt "game_options"
msgid "Set default controller mapping."
msgstr "Define o mapeamento de comando predefinido."

msgctxt "game_options"
msgid "Set license mask for activated content (ALL LICENCES is Generally a bad idea, could lead to undefined behavior)."
msgstr "Define a máscara de licenças do conteúdo ativado (TODAS AS LICENÇAS ATIVADAS geralmente é má ideia; pode levar a comportamento indefinido)."

msgctxt "game_options"
msgid "Set scaling filter for rendered content."
msgstr "Define o filtro de escala do conteúdo renderizado."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. FSR requires Vulkan."
msgstr "Define o filtro de escala do conteúdo renderizado. FSR requer Vulkan."

msgctxt "game_options"
msgid "Set scaling filter for rendered content. OpenGL only."
msgstr "Define o filtro de escala do conteúdo renderizado. Apenas OpenGL."

msgctxt "game_options"
msgid "Set the Atari 2600 difficulty switch."
msgstr "Define a chave de dificuldade do Atari 2600."

msgctxt "game_options"
msgid "Set the adress, interrupt, low 8 bit and high 16 bit DMA."
msgstr "Define o endereço, a interrupção e o DMA de 8 bits baixo e de 16 bits alto."

msgctxt "game_options"
msgid "Set the amount of extra columns to draw for widescreen."
msgstr "Define a quantidade de colunas extras a desenhar no widescreen."

msgctxt "game_options"
msgid "Set the aspect ratio of the FMV cinematics."
msgstr "Define a proporção das cenas FMV."

msgctxt "game_options"
msgid "Set the behavior of the start menu when autostarted game exit."
msgstr "Define o comportamento do menu inicial quando o jogo iniciado automaticamente é encerrado."

msgctxt "game_options"
msgid "Set the behaviour of the microphone button."
msgstr "Define o comportamento do botão do microfone."

msgctxt "game_options"
msgid "Set the bottom screen as prominent."
msgstr "Define o ecrã inferior como principal."

msgctxt "game_options"
msgid "Set the console to widescreen, for the games that support it."
msgstr "Coloca a consola em widescreen, para os jogos que suportam."

msgctxt "game_options"
msgid "Set the host's refresh rate."
msgstr "Define a taxa de atualização do sistema anfitrião."

msgctxt "game_options"
msgid "Set the volume of the emulated floppy sound."
msgstr "Define o volume do som do disquete emulado."

msgctxt "game_options"
msgid "Set this for games that require controller in port 2."
msgstr "Defina para jogos que exigem o comando na porta 2."

msgctxt "game_options"
msgid "Set this on when using multiple guns. Defaults to on if multiple guns are found and input driver is not set to 'sdl'."
msgstr "Ative ao usar várias pistolas. Ligado por predefinição se várias pistolas forem encontradas e o driver de entrada não estiver em 'sdl'."

msgctxt "game_options"
msgid "Set this option only when using a real balance board."
msgstr "Defina esta opção apenas ao usar uma Balance Board real."

msgctxt "game_options"
msgid "Set this option to put microphone in slot B."
msgstr "Defina esta opção para colocar o microfone no slot B."

msgctxt "game_options"
msgid "Set this to 'ON' to quit steam or Epic Game Launcher when quitting game."
msgstr "Defina como 'LIGADO' para fechar o Steam ou o Epic Games Launcher ao sair do jogo."

msgctxt "game_options"
msgid "Set this to effectively halve monitor refresh rate."
msgstr "Defina para efetivamente reduzir pela metade a taxa de atualização do monitor."

msgctxt "game_options"
msgid "Set this to plug GunCon to port 2, used for certain versions of Die Hard."
msgstr "Defina para conectar a GunCon na porta 2; usado em certas versões de Die Hard."

msgctxt "game_options"
msgid "Set this to use original PSX Gamepad instead of Dualshock."
msgstr "Defina para usar o comando original da PSX em vez do DualShock."

msgctxt "game_options"
msgid "Set to YES to return to Neutral in driving games when the gear shift key is released."
msgstr "Defina como SIM para voltar ao ponto morto em jogos de corrida quando a tecla de mudança for solta."

msgctxt "game_options"
msgid "Sets brightness offset of emulated liquid crystal display."
msgstr "Define o deslocamento de brilho do ecrã de cristal líquido emulado."

msgctxt "game_options"
msgid "Sets contrast level of emulated liquid crystal display."
msgstr "Define o nível de contraste do ecrã de cristal líquido emulado."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. 0 (default) uses the frequency of the game board."
msgstr "Define a frequência do PowerPC em MHz. 0 (predefinição) usa a frequência da placa do jogo."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. AUTO uses the frequency of the game hardware (Model 3 only)."
msgstr "Define a frequência do PowerPC em MHz. AUTO usa a frequência do hardware do jogo (apenas Model 3)."

msgctxt "game_options"
msgid "Sets the PowerPC frequency in MHz. The default is 50."
msgstr "Define a frequência do PowerPC em MHz. A predefinição é 50."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks when the input device type is set to 'Gamepad Classic' or 'Gamepad Modern'."
msgstr "Define a zona morta dos analógicos do gamepad quando o tipo de dispositivo de entrada está em 'Gamepad Classic' ou 'Gamepad Modern'."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog sticks."
msgstr "Define a zona morta dos analógicos do gamepad."

msgctxt "game_options"
msgid "Sets the deadzone of the Gamepad analog triggers."
msgstr "Define a zona morta dos gatilhos analógicos do gamepad."

msgctxt "game_options"
msgid "Sets the deadzone of the analog sticks. Only used with the 'Gamepad Modern' controller type."
msgstr "Define a zona morta dos analógicos. Usado apenas com o tipo de comando 'Gamepad Modern'."

msgctxt "game_options"
msgid "Sets the player controller type."
msgstr "Define o tipo de comando do jogador."

msgctxt "game_options"
msgid "Sets the sensitivity of the analog sticks."
msgstr "Define a sensibilidade dos analógicos."

msgctxt "game_options"
msgid "Setting this to 0 means everything is reported as occluded, required for Forza Motorsport 4."
msgstr "Definir como 0 faz com que tudo seja reportado como oculto; necessário para Forza Motorsport 4."

msgctxt "game_options"
msgid "Setting this to 1 can increase performance."
msgstr "Definir como 1 pode aumentar o desempenho."

msgctxt "game_options"
msgid "Setting this too high may cause sample clipping."
msgstr "Um valor alto demais pode causar clipping das amostras."

msgctxt "game_options"
msgid "Shape of the pixels: square or as on the original display."
msgstr "Formato dos pixels: quadrado ou como no ecrã original."

msgctxt "game_options"
msgid "Shape of the shadow mask drawn by the CRT shader. Only used when the shader is set to CRT mask."
msgstr "Formato da máscara de sombra desenhada pelo shader CRT. Usado apenas quando o shader está em máscara CRT."

msgctxt "game_options"
msgid "Shared CMOS for all content by default, or one per game (better for netplay)."
msgstr "CMOS partilhada para todo o conteúdo por predefinição, ou uma por jogo (melhor para netplay)."

msgctxt "game_options"
msgid "Sharpening intensity applied by FidelityFX CAS. Only used when scaling filter is set to FSR."
msgstr "Intensidade da nitidez aplicada pelo FidelityFX CAS. Usado apenas quando o filtro de escala está em FSR."

msgctxt "game_options"
msgid "Short on-screen messages (state saved...). On by default."
msgstr "Mensagens curtas no ecrã (estado guardado...). Ligado por predefinição."

msgctxt "game_options"
msgid "Show Dolphin GUI in addition to game screen."
msgstr "Mostra a interface do Dolphin além do ecrã do jogo."

msgctxt "game_options"
msgid "Show FPS overlay in-game."
msgstr "Mostra o FPS sobreposto no jogo."

msgctxt "game_options"
msgid "Show Ryujinx debug console."
msgstr "Mostra a consola de depuração do Ryujinx."

msgctxt "game_options"
msgid "Show a control image overlaid on top of the bezel."
msgstr "Mostra uma imagem dos controlos sobreposta à moldura."

msgctxt "game_options"
msgid "Show a notification when a controller is connected or disconnected."
msgstr "Mostra uma notificação quando um comando é conectado ou desconectado."

msgctxt "game_options"
msgid "Show core specific notifications."
msgstr "Mostra as notificações específicas do núcleo."

msgctxt "game_options"
msgid "Show emulator GUI."
msgstr "Mostra a interface do emulador."

msgctxt "game_options"
msgid "Show emulator notifications, enabled by default (AUTO)."
msgstr "Mostra as notificações do emulador; ativado por predefinição (AUTO)."

msgctxt "game_options"
msgid "Show emulator notifications."
msgstr "Mostra as notificações do emulador."

msgctxt "game_options"
msgid "Show game information in the upper left corner of Craft."
msgstr "Mostra informações do jogo no canto superior esquerdo do Craft."

msgctxt "game_options"
msgid "Show information about shader compilation."
msgstr "Mostra informações sobre a compilação de shaders."

msgctxt "game_options"
msgid "Show information of current screen layout in the top right corner."
msgstr "Mostra informações da disposição atual dos ecrãs no canto superior direito."

msgctxt "game_options"
msgid "Show notifications."
msgstr "Mostra notificações."

msgctxt "game_options"
msgid "Show or crop overscan. 'Auto' will try to adapt to game, cropping empty areas."
msgstr "Mostra ou corta o overscan. 'Auto' tenta adaptar-se ao jogo, cortando as áreas vazias."

msgctxt "game_options"
msgid "Show or hide RetroArch settings. 'Auto' is the recommended setting."
msgstr "Mostra ou oculta as configurações do RetroArch. 'Auto' é a configuração recomendada."

msgctxt "game_options"
msgid "Show performance statistics overlay in-game."
msgstr "Mostra as estatísticas de desempenho sobrepostas no jogo."

msgctxt "game_options"
msgid "Show shader compilation notifications."
msgstr "Mostra as notificações de compilação de shaders."

msgctxt "game_options"
msgid "Show the horizontal borders. AUTO crops them to the area used by the game, best with DOT CLOCK PAR."
msgstr "Mostra as bordas horizontais. AUTO corta-as na área usada pelo jogo; melhor com PAR PELO DOT CLOCK."

msgctxt "game_options"
msgid "Shows an Amiga keyboard at the bottom of the screen for typing with the pad. Toggle it with a bound button, move with the d-pad or stick, press another button to type the key."
msgstr "Mostra um teclado de Amiga na parte inferior do ecrã para digitar com o comando. Ative com um botão mapeado, mova com o direcional ou o analógico e prima outro botão para digitar a tecla."

msgctxt "game_options"
msgid "Shows bullet marks on walls where shots land."
msgstr "Mostra marcas de bala nas paredes onde os tiros acertam."

msgctxt "game_options"
msgid "Shows drive activity and performance information over the picture."
msgstr "Mostra a atividade das unidades e informações de desempenho sobre a imagem."

msgctxt "game_options"
msgid "Shows extended PAL CRT lines, but these are usually blank in most games."
msgstr "Mostra as linhas CRT PAL estendidas, mas costumam ficar vazias na maioria dos jogos."

msgctxt "game_options"
msgid "Shows floppy disk names, drive lamps and speed, in window and full screen."
msgstr "Mostra os nomes dos disquetes, as luzes das unidades e a velocidade, em janela e em ecrã inteiro."

msgctxt "game_options"
msgid "Shows the WHDLoad configuration screen when a game supports it."
msgstr "Mostra o ecrã de configuração do WHDLoad quando um jogo o suporta."

msgctxt "game_options"
msgid "Shows the WHDLoad prompt and waits for a button press before the game starts. Off by default so the game boots straight away."
msgstr "Mostra o aviso do WHDLoad e espera que se prima um botão antes de o jogo iniciar. Desligado por predefinição, para o jogo arrancar diretamente."

msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Reduz/amplia a tatuagem para caber dentro da borda da moldura."

msgctxt "game_options"
msgid "Significantly improves performances for CPU with 3+ cores."
msgstr "Melhora significativamente o desempenho de CPUs com 3 ou mais núcleos."

msgctxt "game_options"
msgid "Simulate CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames."
msgstr "Simula os efeitos de fantasma do fósforo CRT. 'Simples' faz uma mistura 50:50 do fotograma atual com o anterior."

msgctxt "game_options"
msgid "Simulate LCD screen ghosting effects."
msgstr "Simula os efeitos de fantasma de um ecrã LCD."

msgctxt "game_options"
msgid "Simulate effects specific to the PowerVR2 GPU and analog video signals."
msgstr "Simula efeitos específicos da GPU PowerVR2 e dos sinais de vídeo analógicos."

msgctxt "game_options"
msgid "Simulate the colors of the Game Boy Color LCD screen."
msgstr "Simula as cores do ecrã LCD do Game Boy Color."

msgctxt "game_options"
msgid "Simulates CRT ghosting effect, can be used to avoid flickering."
msgstr "Simula o efeito fantasma do CRT; pode ser usado para evitar cintilação."

msgctxt "game_options"
msgid "Simulates ghosting, can help to reduce flickering."
msgstr "Simula o efeito fantasma; pode ajudar a reduzir a cintilação."

msgctxt "game_options"
msgid "Simulates stereo output."
msgstr "Simula uma saída estéreo."

msgctxt "game_options"
msgid "Single Field applies a de-interlacing filter, Double Field mimics the original hardware."
msgstr "Campo único aplica um filtro de desentrelaçamento; Campo duplo imita o hardware original."

msgctxt "game_options"
msgid "Size of menus and panels. Capped by the game to the largest scale fitting the internal resolution."
msgstr "Tamanho dos menus e painéis. Limitado pelo jogo à maior escala que caiba na resolução interna."

msgctxt "game_options"
msgid "Size of the game pixels: higher values zoom in and show a smaller part of the map. Default: 2."
msgstr "Tamanho dos pixels do jogo: valores maiores aproximam e mostram uma parte menor do mapa. Predefinição: 2."

msgctxt "game_options"
msgid "Size of the largest screen when using a hybrid screen layout."
msgstr "Tamanho do maior ecrã ao usar uma disposição híbrida dos ecrãs."

msgctxt "game_options"
msgid "Size of the secondary screen relative to the primary screen (Top/Bottom layouts only)."
msgstr "Tamanho do ecrã secundário em relação ao principal (apenas disposições Superior/Inferior)."

msgctxt "game_options"
msgid "Size of the window when not in fullscreen."
msgstr "Tamanho da janela fora do ecrã inteiro."

msgctxt "game_options"
msgid "Size ratio of the 2 emulated screens."
msgstr "Proporção de tamanho dos 2 ecrãs emulados."

msgctxt "game_options"
msgid "Skip VBI when lag is detected, helps with audio stuttering when emulation speed decreases."
msgstr "Salta o VBI quando é detetado atraso; ajuda com soluços de áudio quando a velocidade da emulação cai."

msgctxt "game_options"
msgid "Skip drawing a frame identical to the previous one. Can improve performance."
msgstr "Salta o desenho de um fotograma idêntico ao anterior. Pode melhorar o desempenho."

msgctxt "game_options"
msgid "Skip frames to avoid audio crackling on slow devices."
msgstr "Salta fotogramas para evitar estalos de áudio em dispositivos lentos."

msgctxt "game_options"
msgid "Skip frames to improve performance, at the cost of choppy motion."
msgstr "Salta fotogramas para melhorar o desempenho, em troca de movimentos menos fluidos."

msgctxt "game_options"
msgid "Skip the 60 seconds wait for other cabinets at boot. Disable it for multi-cabinet play."
msgstr "Salta a espera de 60 segundos por outras cabines no arranque. Desative para jogar com várias cabines."

msgctxt "game_options"
msgid "Skip the BIOS bootlogo."
msgstr "Salta o logótipo de arranque da BIOS."

msgctxt "game_options"
msgid "Skip the boot check that prevents the game from starting."
msgstr "Salta a verificação de arranque que impede o jogo de iniciar."

msgctxt "game_options"
msgid "Skip the hardware checks at boot (camera, steering wheel, card reader)."
msgstr "Salta as verificações de hardware no arranque (câmara, volante, leitor de cartão)."

msgctxt "game_options"
msgid "Skip the long steering motor initialization at boot. Select the revision of your game."
msgstr "Salta a longa inicialização do motor da direção no arranque. Selecione a revisão do seu jogo."

msgctxt "game_options"
msgid "Skip the mechanical waiting time of the floppy drive. Loading is much faster, the disk itself is still read exactly as the original."
msgstr "Salta o tempo de espera mecânico da unidade de disquete. O carregamento fica muito mais rápido; o disco continua a ser lido exatamente como o original."

msgctxt "game_options"
msgid "Skip the startup videos and logo."
msgstr "Salta os vídeos e o logótipo de abertura."

msgctxt "game_options"
msgid "Skip the startup videos."
msgstr "Salta os vídeos de abertura."

msgctxt "game_options"
msgid "Skip the steering motor initialization at boot."
msgstr "Salta a inicialização do motor da direção no arranque."

msgctxt "game_options"
msgid "Skip videos/FMVs."
msgstr "Salta vídeos/FMVs."

msgctxt "game_options"
msgid "Skips drawing surfaces for the area defined left and right."
msgstr "Salta o desenho das superfícies na área definida à esquerda e à direita."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content."
msgstr "Salta a animação de arranque da BIOS exibida ao carregar o conteúdo."

msgctxt "game_options"
msgid "Skips the BIOS boot animation displayed when loading content. Turn this off to reach the PS2 system settings and the memory card manager."
msgstr "Salta a animação de arranque da BIOS exibida ao carregar o conteúdo. Desative para aceder às configurações do sistema da PS2 e ao gestor de cartões de memória."

msgctxt "game_options"
msgid "Skips the BIOS boot animation when loading content."
msgstr "Salta a animação de arranque da BIOS ao carregar o conteúdo."

msgctxt "game_options"
msgid "Slot the disk images are mounted in. AUTO picks it from the image type. Only change it if a game refuses to boot."
msgstr "Slot em que as imagens de disco são montadas. AUTO escolhe-o pelo tipo de imagem. Altere apenas se um jogo se recusar a iniciar."

msgctxt "game_options"
msgid "Slower, but required by a few games that depend on cache behaviour."
msgstr "Mais lento, mas necessário para alguns jogos que dependem do comportamento do cache."

msgctxt "game_options"
msgid "Smooth 3D textures."
msgstr "Suaviza as texturas 3D."

msgctxt "game_options"
msgid "Smooths out changes in steering. Needed when using a gamepad or keyboard."
msgstr "Suaviza as mudanças de direção. Necessário ao usar gamepad ou teclado."

msgctxt "game_options"
msgid "Smooths the edges with a shader, slightly softens the picture."
msgstr "Suaviza as bordas com um shader; suaviza levemente a imagem."

msgctxt "game_options"
msgid "Smooths the sound the Paula chip produces. 'Sinc' is the most refined and the most demanding."
msgstr "Suaviza o som produzido pelo chip Paula. 'Sinc' é o mais refinado e o mais exigente."

msgctxt "game_options"
msgid "Softens the gamepad steering in driving games. Strong by default, no effect on a wheel."
msgstr "Suaviza a direção com o gamepad em jogos de corrida. Forte por predefinição; sem efeito com volante."

msgctxt "game_options"
msgid "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls. Setting this to a smaller value might improve performance and reduce stuttering in some games."
msgstr "Alguns estágios da SPU são sensíveis a condições de corrida, e permitir um número limitado por vez ajuda a aliviar quedas de desempenho. Um valor menor pode melhorar o desempenho e reduzir soluços em alguns jogos."

msgctxt "game_options"
msgid "Some games accept input from port 2 instead of port 1."
msgstr "Alguns jogos aceitam a entrada da porta 2 em vez da porta 1."

msgctxt "game_options"
msgid "Some games fail to load if the system is powered on with CD inserted. 'YES' inserts CD during boot animation."
msgstr "Alguns jogos não carregam se o sistema for ligado com o CD inserido. 'SIM' insere o CD durante a animação de arranque."

msgctxt "game_options"
msgid "Some games have graphic and/or speed issues without Cycle-exact."
msgstr "Alguns jogos têm problemas gráficos e/ou de velocidade sem o Ciclo exato."

msgctxt "game_options"
msgid "Some games need a specific keyboard key to perform some actions, define the key to map to the SELECT button of player 1 controller."
msgstr "Alguns jogos precisam de uma tecla específica do teclado para certas ações; defina a tecla a mapear no botão SELECT do comando do jogador 1."

msgctxt "game_options"
msgid "Some games require inverted axis for guns."
msgstr "Alguns jogos exigem eixos invertidos para as pistolas."

msgctxt "game_options"
msgid "Some games require the Game Drive extension."
msgstr "Alguns jogos exigem a extensão Game Drive."

msgctxt "game_options"
msgid "Some games require the controller in the second port to throw grenades."
msgstr "Alguns jogos exigem o comando na segunda porta para lançar granadas."

msgctxt "game_options"
msgid "Some gear stick are connected to computer with a different device id than the wheel, for example Thrustmaster sticks."
msgstr "Algumas alavancas das mudanças são conectadas ao computador com um ID de dispositivo diferente do volante, por exemplo as alavancas Thrustmaster."

msgctxt "game_options"
msgid "Some homebrew and ROM hacks require a specific power-on RAM pattern. Restart required."
msgstr "Alguns homebrews e rom hacks exigem um padrão específico de RAM ao ligar. Requer reinício."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be disabled."
msgstr "Alguns homebrews ou rom hacks precisam desta opção desativada."

msgctxt "game_options"
msgid "Some homebrew or roms hacks need this option to be enabled."
msgstr "Alguns homebrews ou rom hacks precisam desta opção ativada."

msgctxt "game_options"
msgid "Sound source for MIDI music. The MT-32 options need the matching Roland ROMs in the bios folder."
msgstr "Fonte de som para a música MIDI. As opções MT-32 requerem as ROMs Roland correspondentes na pasta bios."

msgctxt "game_options"
msgid "Space/Enter/Fire works as WHDLoad start button."
msgstr "Espaço/Enter/Tiro funcionam como botão de início do WHDLoad."

msgctxt "game_options"
msgid "Specifies how the emulation of the real-time clock in certain games should function."
msgstr "Especifica como deve funcionar a emulação do relógio em tempo real em certos jogos."

msgctxt "game_options"
msgid "Specifies which add-on to use for audio CD playback with patched MD games."
msgstr "Especifica qual add-on usar para a reprodução de CD de áudio com jogos de MD com patch."

msgctxt "game_options"
msgid "Specify IPS patch to enable, if not set all patches defined in ips .ini will be used."
msgstr "Especifica o patch IPS a ativar; se não definido, todos os patches definidos no .ini de ips serão usados."

msgctxt "game_options"
msgid "Specify filter to use for upscaling."
msgstr "Especifica o filtro a usar no upscaling."

msgctxt "game_options"
msgid "Specify path to bezel."
msgstr "Especifica o caminho da moldura."

msgctxt "game_options"
msgid "Specify path to firmware file."
msgstr "Especifica o caminho do ficheiro de firmware."

msgctxt "game_options"
msgid "Specify the Amiga system model to emulate."
msgstr "Especifica o modelo de sistema Amiga a emular."

msgctxt "game_options"
msgid "Specify the computer model to emulate."
msgstr "Especifica o modelo de computador a emular."

msgctxt "game_options"
msgid "Specify the video rendering method. Accurate is the more precise but is slower, good and fast are faster but can fail for some games."
msgstr "Especifica o método de renderização de vídeo. Preciso é o mais exato, porém mais lento; Bom e Rápido são mais rápidos, mas podem falhar em alguns jogos."

msgctxt "game_options"
msgid "Speech module installed."
msgstr "Módulo de voz instalado."

msgctxt "game_options"
msgid "Speed hack but might not be compatible with some games."
msgstr "Hack de velocidade, mas pode não ser compatível com alguns jogos."

msgctxt "game_options"
msgid "Speed hack, can help slow games at the cost of glitches."
msgstr "Hack de velocidade; pode ajudar jogos lentos em troca de falhas."

msgctxt "game_options"
msgid "Speed hack."
msgstr "Hack de velocidade."

msgctxt "game_options"
msgid "Speed of the analog-stick mouse."
msgstr "Velocidade do rato pelo analógico."

msgctxt "game_options"
msgid "Speed of the emulated Amiga mouse."
msgstr "Velocidade do rato do Amiga emulado."

msgctxt "game_options"
msgid "Speed of the mouse pointer moved with the left stick."
msgstr "Velocidade do ponteiro do rato movido com o analógico esquerdo."

msgctxt "game_options"
msgid "Speed up GD-ROM loading, may break some games."
msgstr "Acelera o carregamento do GD-ROM; pode quebrar alguns jogos."

msgctxt "game_options"
msgid "Speed up disk loading. Can break some copy protected games."
msgstr "Acelera o carregamento do disco. Pode quebrar alguns jogos protegidos contra cópia."

msgctxt "game_options"
msgid "Speeds up floppy disk access to reduce loading times."
msgstr "Acelera o acesso ao disquete para reduzir os tempos de carregamento."

msgctxt "game_options"
msgid "Splits the rendering across several CPU threads. Only useful with high internal resolutions."
msgstr "Divide a renderização entre várias threads da CPU. Útil apenas com resoluções internas altas."

msgctxt "game_options"
msgid "Spring the wheel back to center while the game is not driving force feedback, like the mechanical spring of an arcade cabinet."
msgstr "Faz o volante voltar ao centro como uma mola enquanto o jogo não estiver a enviar force feedback, como a mola mecânica de uma cabine arcade."

msgctxt "game_options"
msgid "Standard Floppy Disk Controller Card."
msgstr "Placa controladora de disquete padrão."

msgctxt "game_options"
msgid "Start directly in Commodore 64 mode."
msgstr "Inicia diretamente no modo Commodore 64."

msgctxt "game_options"
msgid "Start the controller with the sticks already enabled, instead of having to press the ANALOG button in-game."
msgstr "Inicia o comando com os analógicos já ativados, em vez de ter de premir o botão ANALOG no jogo."

msgctxt "game_options"
msgid "Start the disc directly instead of waiting on the PLAY CD-I menu. On by default."
msgstr "Inicia o disco diretamente em vez de esperar no menu PLAY CD-I. Ligado por predefinição."

msgctxt "game_options"
msgid "Start the game in test mode. Test: 0 key or R3, service: 9 key or L3."
msgstr "Inicia o jogo no modo de teste. Teste: tecla 0 ou R3; serviço: tecla 9 ou L3."

msgctxt "game_options"
msgid "Starts Outrun 2 SP SDX without the cabinet checks (drive board and tower)."
msgstr "Inicia o Outrun 2 SP SDX sem as verificações da cabine (drive board e torre)."

msgctxt "game_options"
msgid "Starts the Wii Menu (menu must be installed in Dolphin)."
msgstr "Inicia o Menu Wii (o menu deve estar instalado no Dolphin)."

msgctxt "game_options"
msgid "Steering axis deadzone, for pads or non self-centering wheels."
msgstr "Zona morta do eixo da direção, para comandos ou volantes sem centralização automática."

msgctxt "game_options"
msgid "Store BC1 textures in 16-bit. Saves video memory at a small quality cost."
msgstr "Armazena texturas BC1 em 16 bits. Economiza memória de vídeo com pequena perda de qualidade."

msgctxt "game_options"
msgid "Strength of the controller's rumble. 60% by default."
msgstr "Intensidade da vibração do comando. 60% por predefinição."

msgctxt "game_options"
msgid "Strength of the gun's recoil motor. 60% by default."
msgstr "Intensidade do motor de recuo da pistola. 60% por predefinição."

msgctxt "game_options"
msgid "Stretch menus and 2D screens to the full screen width."
msgstr "Estica os menus e os ecrãs 2D para a largura total do ecrã."

msgctxt "game_options"
msgid "Stretch pixels vertically like the original DOS game on a 4:3 screen. Default: enabled."
msgstr "Estica os pixels verticalmente como no jogo de DOS original num ecrã 4:3. Predefinição: ativado."

msgctxt "game_options"
msgid "Stretch the picture to fill the screen, ignoring the aspect ratio."
msgstr "Estica a imagem para preencher o ecrã, ignorando a proporção."

msgctxt "game_options"
msgid "Stretch the picture to the whole screen instead of keeping the shape of a period monitor."
msgstr "Estica a imagem para o ecrã inteiro em vez de manter o formato de um monitor da época."

msgctxt "game_options"
msgid "Studio: TV levels of a real player, black looks dark grey on a PC screen. Full range: deep black."
msgstr "Estúdio: níveis de TV de um aparelho real; o preto parece cinzento-escuro num ecrã de PC. Gama completa: preto profundo."

msgctxt "game_options"
msgid "Supersample framebuffer effects, can introduce artifacts."
msgstr "Superamostra os efeitos de framebuffer; pode introduzir artefactos."

msgctxt "game_options"
msgid "Surround plays the rear speakers of the four-speaker Model 3 cabinets (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) on rear speakers. Other games stay in stereo."
msgstr "Surround toca os canais traseiros das cabines Model 3 de quatro altifalantes (Scud Race, Daytona USA 2, Sega Rally 2, The Lost World) nos altifalantes traseiros. Os outros jogos ficam em estéreo."

msgctxt "game_options"
msgid "Swap paddle 1 and paddle 2, needed by a few games that expect the axes the other way round."
msgstr "Troca o paddle 1 e o paddle 2; necessário para alguns jogos que esperam os eixos ao contrário."

msgctxt "game_options"
msgid "Swap the A and B buttons of the controller."
msgstr "Troca os botões A e B do comando."

msgctxt "game_options"
msgid "Swap the A/B and X/Y buttons of the controller."
msgstr "Troca os botões A/B e X/Y do comando."

msgctxt "game_options"
msgid "Swap the TV and GamePad screens in the side by side, top/bottom and picture in picture layouts."
msgstr "Troca os ecrãs da TV e do GamePad nas disposições lado a lado, superior/inferior e imagem na imagem."

msgctxt "game_options"
msgid "Swaps the two Amiga ports. Needed by a few games, including several point and click titles."
msgstr "Troca as duas portas do Amiga. Necessário para alguns jogos, incluindo vários de apontar e clicar."

msgctxt "game_options"
msgid "Switch gun indexes between player 1 and player 2."
msgstr "Troca os índices das pistolas entre o jogador 1 e o jogador 2."

msgctxt "game_options"
msgid "Switch on to use RetroBat 'saves\switch' folder for Citron and Eden saves (instead of emulator folder)."
msgstr "Ative para usar a pasta 'saves\switch' do RetroBat para as gravações do Citron e do Eden (em vez da pasta do emulador)."

msgctxt "game_options"
msgid "Switch the Player 1 controller type to none if the correct keyboard inputs aren't being read."
msgstr "Mude o tipo de comando do jogador 1 para nenhum se as entradas corretas do teclado não estiverem a ser lidas."

msgctxt "game_options"
msgid "Switch this on to activate service menu via R3 and L3 buttons."
msgstr "Ative para abrir o menu de serviço com os botões R3 e L3."

msgctxt "game_options"
msgid "Switch this on to activate service menu."
msgstr "Ative para abrir o menu de serviço."

msgctxt "game_options"
msgid "Switch this on to use dpad instead of left analog stick."
msgstr "Ative para usar o direcional em vez do analógico esquerdo."

msgctxt "game_options"
msgid "Switch this option on to disable fullscreen and run emulator in a windowed mode."
msgstr "Ative esta opção para desativar o ecrã inteiro e correr o emulador em janela."

msgctxt "game_options"
msgid "Switch this to use lightgun 1 for player 2 and lightgun 2 for player 1."
msgstr "Ative para usar a pistola 1 para o jogador 2 e a pistola 2 para o jogador 1."

msgctxt "game_options"
msgid "Switching this on when using a dedicated deinterlace mode can help reduce blur."
msgstr "Ativar isto com um modo de desentrelaçamento dedicado pode ajudar a reduzir o desfoque."

msgctxt "game_options"
msgid "Sync to exact content framerate. Only for G-Sync/FreeSync/HDMI-2.1-VRR compatible monitors."
msgstr "Sincroniza com a taxa de fotogramas exata do conteúdo. Apenas para monitores compatíveis com G-SYNC/FreeSync/HDMI 2.1 VRR."

msgctxt "game_options"
msgid "System Card used by the LD-ROM2 games that need one. Default: SYSTEM CARD 1 if syscard1.pce is in the bios folder."
msgstr "System Card usado pelos jogos LD-ROM2 que precisam de um. Predefinição: SYSTEM CARD 1 se syscard1.pce estiver na pasta bios."

msgctxt "game_options"
msgid "TI-99 Speech Synthesizer connector adapter."
msgstr "Adaptador do conector do TI-99 Speech Synthesizer."

msgctxt "game_options"
msgid "TOS 1.06 is for STE only: if the machine type is not set, STE is selected automatically."
msgstr "O TOS 1.06 é apenas para STE: se o tipo de máquina não estiver definido, o STE é selecionado automaticamente."

msgctxt "game_options"
msgid "Target 60fps instead of native 59.73fps."
msgstr "Aponta para 60 FPS em vez dos 59,73 FPS nativos."

msgctxt "game_options"
msgid "Team Tap: 3-4 players in White Men Can't Jump and NBA Jam T.E. Rotary: Tempest 2000, controlled with the mouse."
msgstr "Team Tap: 3-4 jogadores em White Men Can't Jump e NBA Jam T.E. Rotary: Tempest 2000, controlado com o rato."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 10 is the original hardware behaviour."
msgstr "O Amiga envia os seus canais totalmente à esquerda e à direita. Reduzir isto mistura-os e é muito mais confortável com auscultadores. 10 é o comportamento do hardware original."

msgctxt "game_options"
msgid "The Amiga sends its channels hard left and hard right. Lowering this mixes them and is far more comfortable with headphones. 100% is the original hardware behaviour."
msgstr "O Amiga envia os seus canais totalmente à esquerda e à direita. Reduzir isto mistura-os e é muito mais confortável com auscultadores. 100% é o comportamento do hardware original."

msgctxt "game_options"
msgid "The CGA variation that is being emulated."
msgstr "Variante CGA emulada."

msgctxt "game_options"
msgid "The Neo Geo CD bios used by the emulator."
msgstr "BIOS do Neo Geo CD usada pelo emulador."

msgctxt "game_options"
msgid "The Neo Geo bios used by the emulator. UNIVERSE BIOS generally offer the best compatibility."
msgstr "BIOS do Neo Geo usada pelo emulador. A UNIVERSE BIOS geralmente oferece a melhor compatibilidade."

msgctxt "game_options"
msgid "The Neo Geo mode. UNIVERSE BIOS generally offer the best compatibility."
msgstr "Modo Neo Geo. A UNIVERSE BIOS geralmente oferece a melhor compatibilidade."

msgctxt "game_options"
msgid "The RetroBat team has prepared profiles for some common controllers, they are located in 'saves\mame\ctrlr' folder. CUSTOM can be used for saving one's own mappings."
msgstr "A equipa do RetroBat preparou perfis para alguns comandos comuns, localizados na pasta 'saves\mame\ctrlr'. PERSONALIZADO pode ser usado para guardar os próprios mapeamentos."

msgctxt "game_options"
msgid "The SVGA variation that is being emulated."
msgstr "Variante SVGA emulada."

msgctxt "game_options"
msgid "The SoundBlaster emulated FM synth mode."
msgstr "Modo do sintetizador FM emulado da SoundBlaster."

msgctxt "game_options"
msgid "The amount of high memory size the emulated machine has."
msgstr "Quantidade de memória alta da máquina emulada."

msgctxt "game_options"
msgid "The amount of video memory."
msgstr "Quantidade de memória de vídeo."

msgctxt "game_options"
msgid "The aspect ratio that's used by the Widescreen Hack."
msgstr "Proporção usada pelo hack widescreen."

msgctxt "game_options"
msgid "The bios used by the emulator."
msgstr "BIOS usada pelo emulador."

msgctxt "game_options"
msgid "The color scheme for Hercules emulation."
msgstr "Esquema de cores da emulação Hercules."

msgctxt "game_options"
msgid "The driver 'xinput' will enable features like rumble effects. Choose 'sdl' for compatibility with a wide range of controllers."
msgstr "O driver 'xinput' ativa recursos como os efeitos de vibração. Escolha 'sdl' para compatibilidade com uma grande variedade de comandos."

msgctxt "game_options"
msgid "The game region must match the Wii Menu region, otherwise the game will not be recognized."
msgstr "A região do jogo deve corresponder à região do Menu Wii; caso contrário, o jogo não será reconhecido."

msgctxt "game_options"
msgid "The higher the value the further away objects will be displayed."
msgstr "Quanto maior o valor, mais distantes os objetos serão exibidos."

msgctxt "game_options"
msgid "The maximum RAM memory available for the system."
msgstr "Memória RAM máxima disponível para o sistema."

msgctxt "game_options"
msgid "The normal core can be more stable when running installed OS."
msgstr "O núcleo normal pode ser mais estável ao correr um sistema operativo instalado."

msgctxt "game_options"
msgid "The raw performance to emulate."
msgstr "Desempenho bruto a emular."

msgctxt "game_options"
msgid "The right analog stick of player 1 controls the second joystick, for dual stick games (Robotron: 2084, T:ME Salvo)."
msgstr "O analógico direito do jogador 1 controla o segundo joystick, para jogos de dois analógicos (Robotron: 2084, T:ME Salvo)."

msgctxt "game_options"
msgid "The right stick is used as the right D-pad (also on L2, R2, L3 and R3)."
msgstr "O analógico direito é usado como direcional direito (também em L2, R2, L3 e R3)."

msgctxt "game_options"
msgid "The type of emulated graphic chip."
msgstr "Tipo de chip gráfico emulado."

msgctxt "game_options"
msgid "There is a bug in some games where having more than 1 active device crashes the emulator."
msgstr "Há um bug em alguns jogos em que ter mais de 1 dispositivo ativo bloqueia o emulador."

msgctxt "game_options"
msgid "Thickness of the white border drawn when a Sinden gun is connected. Normal (12 pixels) by default."
msgstr "Espessura da borda branca desenhada quando uma pistola Sinden está conectada. Normal (12 pixels) por predefinição."

msgctxt "game_options"
msgid "This is helpful in driving games to make it less 'twitchy' when using a controller to steer."
msgstr "Útil em jogos de corrida para tornar a direção menos 'nervosa' ao virar com um comando."

msgctxt "game_options"
msgid "This option can be used to override PAL timings to run games with NTSC timings."
msgstr "Esta opção pode substituir as temporizações PAL para correr jogos com temporizações NTSC."

msgctxt "game_options"
msgid "This option changes the Yamaha sound board on the emulated PC. OPN is the default option. OPNA sound supports more FM channels and PCM samples."
msgstr "Esta opção altera a placa de som Yamaha do PC emulado. OPN é a opção predefinida. O som OPNA suporta mais canais FM e amostras PCM."

msgctxt "game_options"
msgid "This option controls the SPU analyser, particularly the size of compiled units.Use the safe mode for maximum compatibility."
msgstr "Esta opção controla o analisador da SPU, em especial o tamanho das unidades compiladas. Use o modo seguro para máxima compatibilidade."

msgctxt "game_options"
msgid "This option must be disabled in order to play SIGIL."
msgstr "Esta opção deve estar desativada para jogar SIGIL."

msgctxt "game_options"
msgid "This option only affects Gamecube controller."
msgstr "Esta opção afeta apenas o comando de GameCube."

msgctxt "game_options"
msgid "This option selects whether or not to emulate the PCG-8100. This option may be required for some PC-8000 series software."
msgstr "Esta opção define se o PCG-8100 é emulado ou não. Pode ser necessária para algum software da série PC-8000."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC."
msgstr "Esta opção define a velocidade de clock da CPU do PC emulado."

msgctxt "game_options"
msgid "This option sets the CPU clock speed of the emulated PC. Overclocking options will make most software run faster than normal."
msgstr "Esta opção define a velocidade de clock da CPU do PC emulado. As opções de overclock fazem a maior parte do software correr mais rápido que o normal."

msgctxt "game_options"
msgid "This option specifies which lock-on cartridge to emulate."
msgstr "Esta opção especifica qual cartucho lock-on emular."

msgctxt "game_options"
msgid "This setting can only be used with the 'scanlines' filter."
msgstr "Esta configuração só pode ser usada com o filtro 'scanlines'."

msgctxt "game_options"
msgid "This setting will prevent pause in emulation when losing focus."
msgstr "Esta configuração impede a pausa da emulação ao perder o foco."

msgctxt "game_options"
msgid "This setting will rotate your windows desktop, it will not be set back when exiting game."
msgstr "Esta configuração roda a área de trabalho do Windows; não é restaurada ao sair do jogo."

msgctxt "game_options"
msgid "This should only be disabled when playing ROM hacks."
msgstr "Deve ser desativado apenas ao jogar rom hacks."

msgctxt "game_options"
msgid "This should only be disabled when playing certain demos and homebrews for correct operation."
msgstr "Deve ser desativado apenas em certas demos e homebrews, para funcionarem corretamente."

msgctxt "game_options"
msgid "This will replace the BIOS CD-ROM busy loop with a STOP instruction."
msgstr "Substitui o loop de espera do CD-ROM da BIOS por uma instrução STOP."

msgctxt "game_options"
msgid "This will run game without any selected graphical or cpu enhancement."
msgstr "Executa o jogo sem nenhuma melhoria gráfica ou de CPU selecionada."

msgctxt "game_options"
msgid "This will run the console BIOS instead of a game."
msgstr "Executa a BIOS da consola em vez de um jogo."

msgctxt "game_options"
msgid "Threshold at which analog stick movement counts as a digital direction."
msgstr "Limiar a partir do qual o movimento do analógico conta como direção digital."

msgctxt "game_options"
msgid "Throttle down the number of emulated CPU cycles dynamically if your host CPU cannot keep up (disabled by default)"
msgstr "Reduz dinamicamente o número de ciclos de CPU emulados se a CPU do sistema anfitrião não acompanhar (desativado por predefinição)."

msgctxt "game_options"
msgid "Tilt input for Kirby Tilt 'n' Tumble and other MBC7 games. Analog stick by default."
msgstr "Entrada de inclinação para Kirby Tilt 'n' Tumble e outros jogos MBC7. Analógico por predefinição."

msgctxt "game_options"
msgid "Trapdoor expansion RAM, as found in the classic A501 expansion."
msgstr "RAM de expansão trapdoor, como a da clássica expansão A501."

msgctxt "game_options"
msgid "Try and run the game setup."
msgstr "Tenta executar a configuração do jogo."

msgctxt "game_options"
msgid "Try to detect loop conditions in SPU kernels and use them as scheduling hints. Default off"
msgstr "Tenta detetar condições de loop nos kernels da SPU e usá-las como dicas de agendamento. Desligado por predefinição."

msgctxt "game_options"
msgid "Try to detect the game and apply a controller mapping."
msgstr "Tenta detetar o jogo e aplicar um mapeamento de comando."

msgctxt "game_options"
msgid "Try to select best refresh rate for the ROM."
msgstr "Tenta selecionar a melhor taxa de atualização para a ROM."

msgctxt "game_options"
msgid "Try to use legacy dosbox.conf config file instead of core options."
msgstr "Tenta usar o antigo ficheiro de configuração dosbox.conf em vez das opções do núcleo."

msgctxt "game_options"
msgid "TurboTap needed to play with more than one player. Enabled automatically when a second controller is connected."
msgstr "O TurboTap é necessário para jogar com mais de um jogador. Ativado automaticamente quando um segundo comando é conectado."

msgctxt "game_options"
msgid "Turn on emulator notifications : connected controllers and shader compilation messages."
msgstr "Ativa as notificações do emulador: comandos conectados e mensagens de compilação de shaders."

msgctxt "game_options"
msgid "Turn speed with the mouse. Default: 10."
msgstr "Velocidade de rotação com o rato. Predefinição: 10."

msgctxt "game_options"
msgid "Turn this on to map only the D-PAD for directions."
msgstr "Ative para mapear apenas o direcional para as direções."

msgctxt "game_options"
msgid "Turn this on when using a lightgun that does not support offscreen reload."
msgstr "Ative ao usar uma pistola que não suporta recarga fora do ecrã."

msgctxt "game_options"
msgid "Turning this option on will enable MAME to report mouse movement and button presses on different mice independently."
msgstr "Ativar esta opção faz o MAME reportar os movimentos e cliques de ratos diferentes de forma independente."

msgctxt "game_options"
msgid "Turns the right stick into an Amiga mouse, useful for menu-driven and point and click games without leaving the pad."
msgstr "Transforma o analógico direito num rato de Amiga; útil em jogos com menus e de apontar e clicar sem largar o comando."

msgctxt "game_options"
msgid "Tweak the behavior of the 3Dfx Voodoo emulation."
msgstr "Ajusta o comportamento da emulação 3Dfx Voodoo."

msgctxt "game_options"
msgid "Two layers by default (bit-exact). Sorted fixes stacked smoke and glass, checkerboard reproduces the arcade board (snow and fog of Sega Rally 2)."
msgstr "Duas camadas por predefinição (bit a bit). Ordenado corrige fumo e vidros sobrepostos; xadrez reproduz a placa arcade (neve e nevoeiro do Sega Rally 2)."

msgctxt "game_options"
msgid "Type of APPLE II to emulate."
msgstr "Tipo de APPLE II a emular."

msgctxt "game_options"
msgid "Type of Archimedes computer to emulate."
msgstr "Tipo de computador Archimedes a emular."

msgctxt "game_options"
msgid "Type of BBC micro to emulate, default to MODEL B."
msgstr "Tipo de BBC Micro a emular: predefinição MODEL B."

msgctxt "game_options"
msgid "Type of CPU emulation core to use."
msgstr "Tipo de núcleo de emulação de CPU a usar."

msgctxt "game_options"
msgid "Type of Color Computer to emulate, default to coco3."
msgstr "Tipo de Color Computer a emular: predefinição coco3."

msgctxt "game_options"
msgid "Type of Computer to emulate."
msgstr "Tipo de computador a emular."

msgctxt "game_options"
msgid "Type of FM Towns to emulate, default to FM TOWNS (MODEL 1/2)."
msgstr "Tipo de FM Towns a emular: predefinição FM TOWNS (MODEL 1/2)."

msgctxt "game_options"
msgid "Type of FM-7 to emulate, default to FM-7."
msgstr "Tipo de FM-7 a emular: predefinição FM-7."

msgctxt "game_options"
msgid "Type of Frame skipping."
msgstr "Tipo de salto de fotogramas."

msgctxt "game_options"
msgid "Type of LYNX to emulate, default to 48k."
msgstr "Tipo de LYNX a emular: predefinição 48k."

msgctxt "game_options"
msgid "Type of ROM file"
msgstr "Tipo de ficheiro ROM."

msgctxt "game_options"
msgid "Type of V.Smile to emulate."
msgstr "Tipo de V.Smile a emular."

msgctxt "game_options"
msgid "Type of emulated SoundBlaster card."
msgstr "Tipo de placa SoundBlaster emulada."

msgctxt "game_options"
msgid "Type of joystick connected to the game port."
msgstr "Tipo de joystick conectado à porta de jogos."

msgctxt "game_options"
msgid "Uncaps the framerate of the game if a patch can be found in the internal database."
msgstr "Remove o limite de taxa de fotogramas do jogo se houver um patch na base de dados interna."

msgctxt "game_options"
msgid "Unlock additional languages on some games if the core database has an entry for it."
msgstr "Desbloqueia idiomas adicionais em alguns jogos se a base de dados do núcleo tiver uma entrada para isso."

msgctxt "game_options"
msgid "Up CPU frequency from 93.75 to 125 MHz. Can increase speed of some games that are CPU-dependant."
msgstr "Aumenta a frequência da CPU de 93,75 para 125 MHz. Pode aumentar a velocidade de alguns jogos dependentes da CPU."

msgctxt "game_options"
msgid "Upscale the game textures with a pixel-art filter."
msgstr "Amplia as texturas do jogo com um filtro pixel art."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds)."
msgstr "Filtro de upscaling das camadas 2D (HUD, fundos)."

msgctxt "game_options"
msgid "Upscaling filter of the 2D layers (HUD, backgrounds). Vulkan and OpenGL only."
msgstr "Filtro de upscaling das camadas 2D (HUD, fundos). Apenas Vulkan e OpenGL."

msgctxt "game_options"
msgid "Use 'SOUTH' for A button and 'WEST' for B button."
msgstr "Use 'SUL' para o botão A e 'OESTE' para o botão B."

msgctxt "game_options"
msgid "Use 'cfg64' folder for MAME standalone."
msgstr "Usa a pasta 'cfg64' para o MAME standalone."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the crosshair file selected."
msgstr "Use a mira 'personalizada' para ativar o ficheiro de mira selecionado."

msgctxt "game_options"
msgid "Use 'custom' crosshair to enable the file selected here."
msgstr "Use a mira 'personalizada' para ativar o ficheiro selecionado aqui."

msgctxt "game_options"
msgid "Use 'per game' if you have saved a profile for the game in capriceforever\Profiles folder."
msgstr "Use 'por jogo' se tiver guardado um perfil para o jogo na pasta capriceforever\Profiles."

msgctxt "game_options"
msgid "Use 50 for European console and 60 for japanese console."
msgstr "Use 50 para a consola europeia e 60 para a consola japonesa."

msgctxt "game_options"
msgid "Use 8mhz for better compatibility."
msgstr "Use 8 MHz para melhor compatibilidade."

msgctxt "game_options"
msgid "Use Analog stick as D-PAD."
msgstr "Usa o analógico como direcional."

msgctxt "game_options"
msgid "Use DSI for DSI games like DSI Ware."
msgstr "Use DSi para jogos DSi como DSiWare."

msgctxt "game_options"
msgid "Use JOYSTICK ONLY for joystick games and KEYBOARD ONLY for keyboard games."
msgstr "Use APENAS JOYSTICK para jogos de joystick e APENAS TECLADO para jogos de teclado."

msgctxt "game_options"
msgid "Use Left analog stick instead of D-PAD for controls."
msgstr "Usa o analógico esquerdo em vez do direcional nos controlos."

msgctxt "game_options"
msgid "Use R1 and L1 to accelerate and brake in racing games, only compatible with 'auto' gear shifting."
msgstr "Usa R1 e L1 para acelerar e travar em jogos de corrida; compatível apenas com mudanças 'auto'."

msgctxt "game_options"
msgid "Use Resizable BAR for GPU uploads when available. Disable if you encounter stuttering or instability on your driver."
msgstr "Usa a Resizable BAR para envios à GPU quando disponível. Desative se houver soluços ou instabilidade com o seu driver."

msgctxt "game_options"
msgid "Use SDL for all controllers instead of XInput for Xbox controllers."
msgstr "Usa SDL para todos os comandos em vez de XInput para os comandos Xbox."

msgctxt "game_options"
msgid "Use SGB2 timings and behaviour."
msgstr "Usa as temporizações e o comportamento do SGB2."

msgctxt "game_options"
msgid "Use SSE4 instead of AVX2 for older CPUs."
msgstr "Usa SSE4 em vez de AVX2 para CPUs mais antigas."

msgctxt "game_options"
msgid "Use a high-res filter to improve rendering."
msgstr "Usa um filtro de alta resolução para melhorar a renderização."

msgctxt "game_options"
msgid "Use a mouse-controlled Lightgun or Touchscreen input."
msgstr "Usa uma pistola controlada pelo rato ou entrada de ecrã tátil."

msgctxt "game_options"
msgid "Use a predefined color palette instead of the one computed by the emulator."
msgstr "Usa uma paleta de cores predefinida em vez da calculada pelo emulador."

msgctxt "game_options"
msgid "Use alternative depth processing, to enable if there are graphics issues or a specific error message."
msgstr "Usa um processamento de profundidade alternativo; ative se houver problemas gráficos ou uma mensagem de erro específica."

msgctxt "game_options"
msgid "Use ampersand and parentleft for start and coins."
msgstr "Usa ampersand e parenleft para start e fichas."

msgctxt "game_options"
msgid "Use an external firwmare (default is 'firmware.bin' located in bios folder)."
msgstr "Usa um firmware externo (a predefinição é 'firmware.bin' na pasta bios)."

msgctxt "game_options"
msgid "Use analog stick instead of dpad."
msgstr "Usa o analógico em vez do direcional."

msgctxt "game_options"
msgid "Use bilinear filtering to smooth the overall picture."
msgstr "Usa a filtragem bilinear para suavizar a imagem como um todo."

msgctxt "game_options"
msgid "Use bios for certain systems like Neo Geo and Sega ST-V"
msgstr "Usa a BIOS para certos sistemas como Neo Geo e Sega ST-V."

msgctxt "game_options"
msgid "Use button to reload instead of offscreen-shot for guns that do not support offscreen shot."
msgstr "Usa um botão para recarregar em vez do tiro fora do ecrã, para pistolas que não suportam tiro fora do ecrã."

msgctxt "game_options"
msgid "Use buttons instead of an analog axis for the wheel."
msgstr "Usa botões em vez de um eixo analógico para o volante."

msgctxt "game_options"
msgid "Use default computer audio input device as microphone."
msgstr "Usa o dispositivo de entrada de áudio predefinido do computador como microfone."

msgctxt "game_options"
msgid "Use hat for movement in addition to joystick."
msgstr "Usa o hat para o movimento além do joystick."

msgctxt "game_options"
msgid "Use input directly sends by keyboard to the core."
msgstr "Usa a entrada enviada diretamente pelo teclado ao núcleo."

msgctxt "game_options"
msgid "Use interpreter for best compatibility, dynarec for performance."
msgstr "Use o interpretador para a melhor compatibilidade, o dynarec para desempenho."

msgctxt "game_options"
msgid "Use interpreter for best compatibility."
msgstr "Use o interpretador para a melhor compatibilidade."

msgctxt "game_options"
msgid "Use left analog stick in addition to dpad."
msgstr "Usa o analógico esquerdo além do direcional."

msgctxt "game_options"
msgid "Use left analog stick instead of D-PAD."
msgstr "Usa o analógico esquerdo em vez do direcional."

msgctxt "game_options"
msgid "Use left stick as d-pad."
msgstr "Usa o analógico esquerdo como direcional."

msgctxt "game_options"
msgid "Use native texture LOD computation when upscaling."
msgstr "Usa o cálculo de LOD de textura nativo no upscaling."

msgctxt "game_options"
msgid "Use official BIOS and bootloader for emulated hardware."
msgstr "Usa a BIOS e o bootloader oficiais para o hardware emulado."

msgctxt "game_options"
msgid "Use one shared memory card for all games instead of one card per game. Cards are stored in '\bios\pcsx2\memcards'."
msgstr "Usa um único cartão de memória partilhado para todos os jogos em vez de um por jogo. Os cartões ficam em '\bios\pcsx2\memcards'."

msgctxt "game_options"
msgid "Use pixel-accurate emulation where available."
msgstr "Usa emulação precisa ao pixel onde disponível."

msgctxt "game_options"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Usa as portas 5-8 para os comandos de GameCube no modo Wii."

msgctxt "game_options"
msgid "Use preemptive frames instead of run-ahead, the run-ahead frame number applies."
msgstr "Usa fotogramas preemptivos em vez de run-ahead; vale o número de fotogramas do run-ahead."

msgctxt "game_options"
msgid "Use real GameCube controllers through a GameCube adapter. Only with real Wiimotes."
msgstr "Usa comandos de GameCube reais por meio de um adaptador GameCube. Apenas com Wiimotes reais."

msgctxt "game_options"
msgid "Use shoulder buttons for L and R instead of triggers."
msgstr "Usa os botões de ombro para L e R em vez dos gatilhos."

msgctxt "game_options"
msgid "Use shoulder buttons instead of triggers."
msgstr "Usa os botões de ombro em vez dos gatilhos."

msgctxt "game_options"
msgid "Use the 3D models of HD packs instead of sprites (OpenGL renderers). Enabled by default."
msgstr "Usa os modelos 3D dos pacotes HD em vez dos sprites (renderizadores OpenGL). Ativado por predefinição."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder, Required to boot to BIOS."
msgstr "Usa a BIOS localizada na pasta 'bios' do RetroBat. Necessário para iniciar na BIOS."

msgctxt "game_options"
msgid "Use the BIOS located in RetroBat 'bios' folder."
msgstr "Usa a BIOS localizada na pasta 'bios' do RetroBat."

msgctxt "game_options"
msgid "Use the HGH FREQUENCY value for screens with higher refresh rate."
msgstr "Use o valor ALTA FREQUÊNCIA para ecrãs com taxa de atualização maior."

msgctxt "game_options"
msgid "Use the bezels of the Odin artwork pack (artwork folder of the emulator) instead of the RetroBat decorations."
msgstr "Usa as molduras do pacote de artwork do Odin (pasta artwork do emulador) em vez das molduras do RetroBat."

msgctxt "game_options"
msgid "Use the compute shader renderer instead of the classic OpenGL one. Faster at high internal resolutions, needs OpenGL 4.3."
msgstr "Usa o renderizador compute shader em vez do OpenGL clássico. Mais rápido em resoluções internas altas; requer OpenGL 4.3."

msgctxt "game_options"
msgid "Use the emulator built-in BIOS instead of the files in the bios folder. DS Download Play needs the original BIOS and firmware."
msgstr "Usa a BIOS integrada do emulador em vez dos ficheiros na pasta bios. O Download Play do DS requer a BIOS e o firmware originais."

msgctxt "game_options"
msgid "Use the high resolution textures of HD packs (OpenGL renderers). Enabled by default."
msgstr "Usa as texturas em alta resolução dos pacotes HD (renderizadores OpenGL). Ativado por predefinição."

msgctxt "game_options"
msgid "Use the mouse as the Apple II paddles, needed by Arkanoid, Breakout and the other knob-driven games. The pointer position over the screen is the paddle position. Replaces the controller stick for paddles 1 and 2, leave it off for joystick games."
msgstr "Usa o rato como os paddles do Apple II, necessário para Arkanoid, Breakout e outros jogos de botão rotativo. A posição do ponteiro no ecrã é a posição do paddle. Substitui o analógico do comando para os paddles 1 e 2; deixe desligado para jogos de joystick."

msgctxt "game_options"
msgid "Use the older and less compatible faster blitter"
msgstr "Usa o blitter mais antigo e rápido, porém menos compatível."

msgctxt "game_options"
msgid "Use the per-game settings saved in the Vita3K interface. They override the RetroBat settings for this game."
msgstr "Usa as configurações por jogo guardadas na interface do Vita3K. Substituem as configurações do RetroBat para este jogo."

msgctxt "game_options"
msgid "Use the simple double hi-res colour map. A few Apple II programs look closer to the real machine with it."
msgstr "Usa o mapa de cores double hi-res simples. Alguns programas de Apple II ficam mais próximos da máquina real com isto."

msgctxt "game_options"
msgid "Use this if the emulator crashes after loading or doesn't show anything."
msgstr "Use se o emulador bloquear após carregar ou não mostrar nada."

msgctxt "game_options"
msgid "Use this only if the analog stick is drifting."
msgstr "Use apenas se o analógico estiver com drift."

msgctxt "game_options"
msgid "Use this option if ArcadeDuck is not displayed on the correct monitor."
msgstr "Use esta opção se o ArcadeDuck não for exibido no monitor correto."

msgctxt "game_options"
msgid "Use this option if Keisho is not displayed on the correct monitor."
msgstr "Use esta opção se o Keisho não for exibido no monitor correto."

msgctxt "game_options"
msgid "Use this option if Odin is not displayed on the correct monitor."
msgstr "Use esta opção se o Odin não for exibido no monitor correto."

msgctxt "game_options"
msgid "Use this option if PCSX2 is not displaying on the correct monitor."
msgstr "Use esta opção se o PCSX2 não for exibido no monitor correto."

msgctxt "game_options"
msgid "Use this option if duckstation is not displaying on the correct monitor."
msgstr "Use esta opção se o DuckStation não for exibido no monitor correto."

msgctxt "game_options"
msgid "Use this option in case p1 and p2 are inverted."
msgstr "Use esta opção se J1 e J2 estiverem invertidos."

msgctxt "game_options"
msgid "Use this option when using a pad recognized as keyboard (ipac, etc.)."
msgstr "Use esta opção ao usar um comando reconhecido como teclado (I-PAC etc.)."

msgctxt "game_options"
msgid "Use this option when using a wheel without manual gear stick."
msgstr "Use esta opção ao usar um volante sem alavanca das mudanças manual."

msgctxt "game_options"
msgid "Use this setting for flight games."
msgstr "Use esta configuração para jogos de voo."

msgctxt "game_options"
msgid "Use this setting to decrease or increase brightness, not compatible with 'gdi' video driver."
msgstr "Use esta configuração para diminuir ou aumentar o brilho; não compatível com o driver de vídeo 'gdi'."

msgctxt "game_options"
msgid "Use this setting to decrease or increase contrast, not compatible with 'gdi' video driver."
msgstr "Use esta configuração para diminuir ou aumentar o contraste; não compatível com o driver de vídeo 'gdi'."

msgctxt "game_options"
msgid "Use this setting to decrease or increase gamma, not compatible with 'gdi' video driver."
msgstr "Use esta configuração para diminuir ou aumentar o gama; não compatível com o driver de vídeo 'gdi'."

msgctxt "game_options"
msgid "Use this setting to define a default target turbo button."
msgstr "Use esta configuração para definir um botão alvo predefinido do turbo."

msgctxt "game_options"
msgid "Use this setting to ignore run.bat, autoexec.bat or dosbox.bat files in game folder."
msgstr "Use esta configuração para ignorar os ficheiros run.bat, autoexec.bat ou dosbox.bat na pasta do jogo."

msgctxt "game_options"
msgid "Use this setting to reduce input lag."
msgstr "Use esta configuração para reduzir o atraso de entrada."

msgctxt "game_options"
msgid "Use this to autoload content like HD packs."
msgstr "Use para carregar automaticamente conteúdos como pacotes HD."

msgctxt "game_options"
msgid "Use winkey for keyboard, xinput if you have a XBOX controller, sdl for other type of controllers."
msgstr "Use winkey para teclado, xinput se tiver um comando XBOX, sdl para outros tipos de comandos."

msgctxt "game_options"
msgid "Use your own .cfg file in saves\mame\cfg. In-game TAB remaps are kept. On first activation, the last session's mapping is imported automatically. The controller layout option no longer applies to this game."
msgstr "Usa o seu próprio ficheiro .cfg em saves\mame\cfg. Os remapeamentos feitos no jogo com TAB são mantidos. Na primeira ativação, o mapeamento da última sessão é importado automaticamente. A opção de layout do comando deixa de valer para este jogo."

msgctxt "game_options"
msgid "Useful for games with screenshake effects such as Wipeout Fusion, can make the picture blury."
msgstr "Útil para jogos com efeitos de tremor de ecrã como Wipeout Fusion; pode deixar a imagem desfocada."

msgctxt "game_options"
msgid "Useful for single-threaded processors."
msgstr "Útil para processadores de uma só thread."

msgctxt "game_options"
msgid "Useful on some high refresh rate screen to eliminate ghosting."
msgstr "Útil em alguns ecrãs de alta taxa de atualização para eliminar o fantasma."

msgctxt "game_options"
msgid "Useful when using resolution higher than the screen. Avoid moiré effect."
msgstr "Útil ao usar uma resolução maior que a do ecrã. Evita o efeito moiré."

msgctxt "game_options"
msgid "Uses 60hz (480i) instead of 50hz (576i)."
msgstr "Usa 60hz (480i) em vez de 50hz (576i)."

msgctxt "game_options"
msgid "Uses the proper mipmap levels. Enhance graphics accuracy."
msgstr "Usa os níveis de mipmap corretos. Melhora a precisão gráfica."

msgctxt "game_options"
msgid "VI post-processing filter emulation."
msgstr "Emulação do filtro de pós-processamento VI."

msgctxt "game_options"
msgid "Values above 1.00 will increase size, values below will reduce."
msgstr "Valores acima de 1,00 aumentam o tamanho; abaixo, reduzem."

msgctxt "game_options"
msgid "Vertical games will be displayed on the monitor corresponding to the selected index."
msgstr "Os jogos verticais serão exibidos no monitor correspondente ao índice selecionado."

msgctxt "game_options"
msgid "Video HD is an enhanced video card used by a handful of modern demos. Changing this reboots the machine."
msgstr "Video HD é uma placa gráfica melhorada usada por algumas demos modernas. Alterar isto reinicia a máquina."

msgctxt "game_options"
msgid "Video modes the console offers to the games. HD modes need the HDTV video signal."
msgstr "Modos de vídeo que a consola oferece aos jogos. Os modos HD precisam do sinal de vídeo HDTV."

msgctxt "game_options"
msgid "View setup used by the table. AUTO follows SCREEN SETUP: desktop for one landscape screen, full single screen for one vertical screen, cabinet for multiple screens (desktop when SCREEN SETUP is not set)."
msgstr "Configuração de vista usada pela mesa. AUTO segue CONFIGURAÇÃO DOS ECRÃS: área de trabalho para um ecrã em paisagem, ecrã único completo para um ecrã vertical, cabine para vários ecrãs (área de trabalho quando CONFIGURAÇÃO DOS ECRÃS não está definida)."

msgctxt "game_options"
msgid "Virtually rotate the D-pad when the screen is rotated."
msgstr "Roda virtualmente o direcional quando o ecrã é rodado."

msgctxt "game_options"
msgid "Volume of the emulated floppy drive clicking sound."
msgstr "Volume do som de cliques da unidade de disquete emulada."

msgctxt "game_options"
msgid "Volume of the music board in the games that have one (Daytona USA, Sega Rally). 100% by default."
msgstr "Volume da placa de música nos jogos que têm uma (Daytona USA, Sega Rally). 100% por predefinição."

msgctxt "game_options"
msgid "Vulkan only, slower but less lag."
msgstr "Apenas Vulkan; mais lento, mas com menos atraso."

msgctxt "game_options"
msgid "Vulkan only. Improves performance and fixes many graphical issues, but may be unstable on some GPUs. Unsupported methods fall back automatically."
msgstr "Apenas Vulkan. Melhora o desempenho e corrige muitos problemas gráficos, mas pode ser instável em algumas GPUs. Métodos não suportados recorrem automaticamente à alternativa."

msgctxt "game_options"
msgid "Vulkan only: tells the video driver to use a specified buffering mode."
msgstr "Apenas Vulkan: indica ao driver de vídeo que use um modo de buffer específico."

msgctxt "game_options"
msgid "What is plugged into the Amiga's first port. Most games use the joystick in port 2 and the mouse in port 1."
msgstr "O que está conectado na primeira porta do Amiga. A maioria dos jogos usa o joystick na porta 2 e o rato na porta 1."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port."
msgstr "O que está conectado na segunda porta do Amiga."

msgctxt "game_options"
msgid "What is plugged into the Amiga's second port. Default is Joystick."
msgstr "O que está conectado na segunda porta do Amiga. A predefinição é Joystick."

msgctxt "game_options"
msgid "What the second port receives when a second pad is connected."
msgstr "O que a segunda porta recebe quando um segundo comando é conectado."

msgctxt "game_options"
msgid "When an address is entered, the mode will automatically be set as 'MANUAL'."
msgstr "Quando um endereço é introduzido, o modo é definido automaticamente como 'MANUAL'."

msgctxt "game_options"
msgid "When auto-detection fails."
msgstr "Quando a deteção automática falha."

msgctxt "game_options"
msgid "When available, prefer exclusive fullscreen for emulators."
msgstr "Quando disponível, preferir o ecrã inteiro exclusivo para os emuladores."

msgctxt "game_options"
msgid "When enabled, each game will have its own VMU in port 1."
msgstr "Quando ativado, cada jogo terá a sua própria VMU na porta 1."

msgctxt "game_options"
msgid "When selecting 'MANUAL', specify an address in the next setting."
msgstr "Ao selecionar 'MANUAL', especifique um endereço na configuração seguinte."

msgctxt "game_options"
msgid "When throttling is disabled, MAME runs the emulation as fast as possible."
msgstr "Quando o limite de velocidade está desativado, o MAME corre a emulação o mais rápido possível."

msgctxt "game_options"
msgid "When using .m3u file, select disc index to run."
msgstr "Ao usar um ficheiro .m3u, selecione o índice do disco a iniciar."

msgctxt "game_options"
msgid "When using Cursor Joystick, buttons must be mapped to keys in RetroArch."
msgstr "Ao usar o Cursor Joystick, os botões devem ser mapeados em teclas no RetroArch."

msgctxt "game_options"
msgid "When using XInput, this option will switch gamepads 1 and 2."
msgstr "Ao usar XInput, esta opção troca os gamepads 1 e 2."

msgctxt "game_options"
msgid "When using a Sinden gun, kill the Lightgun software when game ends."
msgstr "Ao usar uma pistola Sinden, encerra o software Lightgun quando o jogo termina."

msgctxt "game_options"
msgid "When using mapping from file for arcade systems, define the layout to use."
msgstr "Ao usar o mapeamento por ficheiro para sistemas arcade, define o layout a usar."

msgctxt "game_options"
msgid "When using real Wiimotes, define the type of Wiimote."
msgstr "Ao usar Wiimotes reais, define o tipo de Wiimote."

msgctxt "game_options"
msgid "When using software that requires full keyboard input, it's recommended to use game focus mode as well."
msgstr "Ao usar software que exija a entrada completa do teclado, recomenda-se usar também o modo de foco do jogo."

msgctxt "game_options"
msgid "Where to display the DMD. AUTO: on the playfield with 1 screen, at the bottom of the backglass screen with 2 screens, on its own screen with 3 screens. Requires SCREEN SETUP."
msgstr "Onde exibir o DMD. AUTO: no playfield com 1 ecrã, na parte inferior do ecrã do backglass com 2 ecrãs, num ecrã próprio com 3 ecrãs. Requer CONFIGURAÇÃO DOS ECRÃS."

msgctxt "game_options"
msgid "Which RetroPad drives which Amiga port. Leave on Automatic unless the players are reversed."
msgstr "Qual RetroPad controla qual porta do Amiga. Deixe em Automático a menos que os jogadores estejam invertidos."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup. POM2 loads one disk at a time, the others are swapped from the in-game menu."
msgstr "Qual disco de um jogo com vários discos é inserido no arranque. O POM2 carrega um disco de cada vez; os outros são trocados pelo menu do jogo."

msgctxt "game_options"
msgid "Which disk of a multi-disk game is inserted at startup: always the first one, or the one that was in the drive when you last quit."
msgstr "Qual disco de um jogo com vários discos é inserido no arranque: sempre o primeiro, ou o que estava na unidade quando saiu da última vez."

msgctxt "game_options"
msgid "Which face button validates in PS3 system dialogs. Japanese games generally expect Circle, western games Cross. Leave on AUTO to follow the selected region."
msgstr "Qual botão frontal confirma nas caixas de diálogo do sistema da PS3. Jogos japoneses geralmente esperam Círculo; jogos ocidentais, X. Deixe em AUTO para seguir a região selecionada."

msgctxt "game_options"
msgid "Which floppy drive the disk swap menu acts on."
msgstr "Em qual unidade de disquete o menu de troca de disco atua."

msgctxt "game_options"
msgid "White border drawn by the emulator, needed by Sinden guns to aim."
msgstr "Borda branca desenhada pelo emulador, necessária para as pistolas Sinden mirarem."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 16 pixels by default."
msgstr "Largura da borda branca desenhada quando uma pistola Sinden está conectada. 16 pixels por predefinição."

msgctxt "game_options"
msgid "Width of the white border drawn when a Sinden gun is connected. 2 pixels by default."
msgstr "Largura da borda branca desenhada quando uma pistola Sinden está conectada. 2 pixels por predefinição."

msgctxt "game_options"
msgid "Will run the XBOX process on multiple CPU threads, can improve performance but might break some games."
msgstr "Executa o processo do XBOX em várias threads da CPU; pode melhorar o desempenho, mas pode quebrar alguns jogos."

msgctxt "game_options"
msgid "Workaround needed by a few homebrew and ROM hacks."
msgstr "Contorno necessário para alguns homebrews e rom hacks."

msgctxt "game_options"
msgid "Works around firmware bugs on some wheels causing brief force interruptions. Leave off unless needed."
msgstr "Contorna bugs de firmware de alguns volantes que causam breves interrupções da força. Deixe desligado a menos que seja necessário."

msgctxt "game_options"
msgid "Writes Amiberry.log in the emulator folder. Only useful when reporting a problem, it slows things down slightly."
msgstr "Grava o Amiberry.log na pasta do emulador. Útil apenas ao reportar um problema; deixa tudo um pouco mais lento."

msgctxt "game_options"
msgid "Writes depth buffer values to vm memory. Default off."
msgstr "Grava os valores do buffer de profundidade na memória da VM. Desligado por predefinição."

msgctxt "game_options"
msgid "Writes input events to a log file in the save folder. Only useful when reporting a problem."
msgstr "Grava os eventos de entrada num ficheiro de log na pasta de gravações. Útil apenas ao reportar um problema."

msgctxt "game_options"
msgid "Z80 SoftCard runs CP/M software. The sound cards can be added here as a second one. Changing this reboots the machine."
msgstr "A Z80 SoftCard executa software CP/M. As placas de som podem ser adicionadas aqui como segunda placa. Alterar isto reinicia a máquina."

msgctxt "game_options"
msgid "Zooms in to hide black borders."
msgstr "Amplia para ocultar as bordas pretas."

msgctxt "game_options"
msgid "Zooms in to hide black borders. Borders are different per game."
msgstr "Amplia para ocultar as bordas pretas. As bordas são diferentes em cada jogo."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles, but a few original floppy games refuse to start with it."
msgstr "RAM de expansão Zorro II. Exigida por muitos títulos WHDLoad, mas alguns jogos originais em disquete recusam-se a iniciar com ela."

msgctxt "game_options"
msgid "Zorro II expansion RAM. Required by many WHDLoad titles."
msgstr "RAM de expansão Zorro II. Exigida por muitos títulos WHDLoad."

msgctxt "game_options"
msgid "Zorro III memory, only usable by an accelerated machine. Leave at none unless a specific title asks for it."
msgstr "Memória Zorro III, utilizável apenas por uma máquina acelerada. Deixe em nenhuma a menos que um título específico peça."

msgctxt "game_options"
msgid "Zorro III memory. Useful for Workbench setups and a few demos."
msgstr "Memória Zorro III. Útil para configurações do Workbench e algumas demos."

msgctxt "game_options"
msgid "use this to automatically start to a specified level."
msgstr "Use para iniciar automaticamente numa fase especificada."
